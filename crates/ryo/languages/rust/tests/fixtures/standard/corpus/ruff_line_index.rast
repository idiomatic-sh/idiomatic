      FN
        COMMENT "/// Returns the [UTF-8 byte offset](TextSize) at `line` and `character` where character is counted using the given encoding."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ## Examples"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ### ASCII only source text"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_source_file::{SourceLocation, LineIndex, OneIndexed, PositionEncoding};"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_text_size::TextSize;"
        WHITESPACE "\n    "
        COMMENT "/// let source = r#\"a = 4"
        WHITESPACE "\n    "
        COMMENT "/// c = \"some string\""
        WHITESPACE "\n    "
        COMMENT "/// x = b\"#;"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// let index = LineIndex::from_source_text(source);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // First line, first character"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(0),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(0)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(0)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(1),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(4)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(10)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Offset past the end of the first line"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(0),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(10)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(6)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Offset past the end of the file"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(3),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(0)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(29)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ### Non-ASCII source text"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "/// use ruff_source_file::{LineIndex, OneIndexed, SourceLocation, PositionEncoding};"
        WHITESPACE "\n    "
        COMMENT "/// use ruff_text_size::TextSize;"
        WHITESPACE "\n    "
        COMMENT "/// let source = format!(\"\\u{FEFF}{}\", r#\"a = 4"
        WHITESPACE "\n    "
        COMMENT "/// c = \"❤\u{fe0f}\""
        WHITESPACE "\n    "
        COMMENT "/// x = b\"#);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// let index = LineIndex::from_source_text(&source);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // First line, first character, points at the BOM"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(0),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(0)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(0)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // First line, after the BOM"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(0),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(1)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(3)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // second line, 7th character, after emoji, UTF32"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(1),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(7)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(20)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Second line, 7th character, after emoji, UTF 16"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(1),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(7)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf16,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(20)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Offset past the end of the second line"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(1),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(10)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(22)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Offset past the end of the file"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.offset("
        WHITESPACE "\n    "
        COMMENT "///         SourceLocation {"
        WHITESPACE "\n    "
        COMMENT "///             line: OneIndexed::from_zero_indexed(3),"
        WHITESPACE "\n    "
        COMMENT "///             character_offset: OneIndexed::from_zero_indexed(0)"
        WHITESPACE "\n    "
        COMMENT "///         },"
        WHITESPACE "\n    "
        COMMENT "///         &source,"
        WHITESPACE "\n    "
        COMMENT "///         PositionEncoding::Utf32,"
        WHITESPACE "\n    "
        COMMENT "///     ),"
        WHITESPACE "\n    "
        COMMENT "///     TextSize::new(27)"
        WHITESPACE "\n    "
        COMMENT "///  );"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        VISIBILITY
          PUB_KW "pub"
        WHITESPACE " "
        FN_KW "fn"
        WHITESPACE " "
        NAME
          IDENT "offset"
        PARAM_LIST
          L_PAREN "("
          WHITESPACE "\n        "
          SELF_PARAM
            AMP "&"
            NAME
              SELF_KW "self"
          COMMA ","
          WHITESPACE "\n        "
          PARAM
            IDENT_PAT
