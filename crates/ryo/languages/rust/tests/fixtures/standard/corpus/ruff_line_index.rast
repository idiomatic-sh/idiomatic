      FN
        COMMENT "/// Given a UTF-8 byte offset, returns the line and character offset according to the given encoding."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ### BOM handling"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// Unlike [`Self::line_column`], this method does not skip the BOM character at the start of the file."
        WHITESPACE "\n    "
        COMMENT "/// This allows for bidirectional mapping between [`SourceLocation`] and [`TextSize`] (see [`Self::offset`])."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ## Examples"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_text_size::TextSize;"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_source_file::{LineIndex, OneIndexed, LineColumn, SourceLocation, PositionEncoding, Line};"
        WHITESPACE "\n    "
        COMMENT "/// let source = format!(\"\\u{FEFF}{}\", \"def a():\\n    pass\");"
        WHITESPACE "\n    "
        COMMENT "/// let index = LineIndex::from_source_text(&source);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Before BOM, maps to character 0"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.source_location(TextSize::from(0), &source, PositionEncoding::Utf32),"
        WHITESPACE "\n    "
        COMMENT "///     SourceLocation { line: OneIndexed::from_zero_indexed(0), character_offset: OneIndexed::from_zero_indexed(0) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // After BOM, maps to after BOM"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.source_location(TextSize::from(3), &source, PositionEncoding::Utf32),"
        WHITESPACE "\n    "
        COMMENT "///     SourceLocation { line: OneIndexed::from_zero_indexed(0), character_offset: OneIndexed::from_zero_indexed(1) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.source_location(TextSize::from(7), &source, PositionEncoding::Utf32),"
        WHITESPACE "\n    "
        COMMENT "///     SourceLocation { line: OneIndexed::from_zero_indexed(0), character_offset: OneIndexed::from_zero_indexed(5) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.source_location(TextSize::from(16), &source, PositionEncoding::Utf32),"
        WHITESPACE "\n    "
        COMMENT "///     SourceLocation { line: OneIndexed::from_zero_indexed(1), character_offset: OneIndexed::from_zero_indexed(4) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ## Panics"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// If the UTF-8 byte offset is out of bounds of `text`."
