      FN
        COMMENT "/// Returns the line and column number for an UTF-8 byte offset."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// The `column` number is the nth-character of the line, except for the first line"
        WHITESPACE "\n    "
        COMMENT "/// where it doesn't include the UTF-8 BOM marker at the start of the file."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ### BOM handling"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// For files starting with a UTF-8 BOM marker, the byte offsets"
        WHITESPACE "\n    "
        COMMENT "/// in the range `0...3` are all mapped to line 0 and column 0."
        WHITESPACE "\n    "
        COMMENT "/// Because of this, the conversion isn't lossless."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ## Examples"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_text_size::TextSize;"
        WHITESPACE "\n    "
        COMMENT "/// # use ruff_source_file::{LineIndex, OneIndexed, LineColumn};"
        WHITESPACE "\n    "
        COMMENT "/// let source = format!(\"\\u{FEFF}{}\", \"def a():\\n    pass\");"
        WHITESPACE "\n    "
        COMMENT "/// let index = LineIndex::from_source_text(&source);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // Before BOM, maps to after BOM"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.line_column(TextSize::from(0), &source),"
        WHITESPACE "\n    "
        COMMENT "///     LineColumn { line: OneIndexed::from_zero_indexed(0), column: OneIndexed::from_zero_indexed(0) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// // After BOM, maps to after BOM"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.line_column(TextSize::from(3), &source),"
        WHITESPACE "\n    "
        COMMENT "///     LineColumn { line: OneIndexed::from_zero_indexed(0), column: OneIndexed::from_zero_indexed(0) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.line_column(TextSize::from(7), &source),"
        WHITESPACE "\n    "
        COMMENT "///     LineColumn { line: OneIndexed::from_zero_indexed(0), column: OneIndexed::from_zero_indexed(4) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!("
        WHITESPACE "\n    "
        COMMENT "///     index.line_column(TextSize::from(16), &source),"
        WHITESPACE "\n    "
        COMMENT "///     LineColumn { line: OneIndexed::from_zero_indexed(1), column: OneIndexed::from_zero_indexed(4) }"
        WHITESPACE "\n    "
        COMMENT "/// );"
        WHITESPACE "\n    "
        COMMENT "/// ```"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// ## Panics"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// If the byte offset isn't within the bounds of `content`."
        WHITESPACE "\n    "
