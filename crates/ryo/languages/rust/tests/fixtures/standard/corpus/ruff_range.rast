        COMMENT "/// # use std::cmp::Ordering;"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// let a = TextRange::new(0.into(), 3.into());"
        WHITESPACE "\n    "
        COMMENT "/// let b = TextRange::new(4.into(), 5.into());"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!(a.ordering(b), Ordering::Less);"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// let a = TextRange::new(0.into(), 3.into());"
        WHITESPACE "\n    "
        COMMENT "/// let b = TextRange::new(3.into(), 5.into());"
        WHITESPACE "\n    "
        COMMENT "/// assert_eq!(a.ordering(b), Ordering::Less);"
