        COMMENT "/// Relative order of the two ranges (overlapping ranges are considered"
        WHITESPACE "\n    "
        COMMENT "/// equal)."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// This is useful when, for example, binary searching an array of disjoint"
        WHITESPACE "\n    "
        COMMENT "/// ranges."
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
        COMMENT "/// # Examples"
        WHITESPACE "\n    "
        COMMENT "///"
        WHITESPACE "\n    "
