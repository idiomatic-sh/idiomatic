        WHITESPACE " "
        BLOCK_EXPR
          STMT_LIST
            L_CURLY "{"
            WHITESPACE "\n        "
            COMMENT "// The first `\\` has 4 spaces before it which matches the indentation level at that point,"
            WHITESPACE "\n        "
            COMMENT "// so the whitespace before `2` is irrelevant and shouldn't produce an indentation error."
            WHITESPACE "\n        "
            COMMENT "// Similarly, the second `\\` is also at the same indentation level, so the `3` line is also"
            WHITESPACE "\n        "
            COMMENT "// valid."
            WHITESPACE "\n        "
            LET_STMT
              LET_KW "let"
              WHITESPACE " "
              IDENT_PAT
                NAME
                  IDENT "source"
              WHITESPACE " "
              EQ "="
              WHITESPACE " "
              METHOD_CALL_EXPR
                LITERAL
                  STRING "r\"if True:\n    1\n    \\\n        2\n    \\\n3\nelse:\n    pass\n\""
                WHITESPACE "\n        "
                DOT "."
                NAME_REF
                  IDENT "to_string"
                ARG_LIST
                  L_PAREN "("
                  R_PAREN ")"
              SEMICOLON ";"
            WHITESPACE "\n        "
            EXPR_STMT
              MACRO_EXPR
                MACRO_CALL
                  PATH
                    PATH_SEGMENT
                      NAME_REF
                        IDENT "assert_snapshot"
                  BANG "!"
                  TOKEN_TREE
                    L_PAREN "("
                    IDENT "lex_source"
                    TOKEN_TREE
                      L_PAREN "("
                      AMP "&"
                      IDENT "source"
                      R_PAREN ")"
                    R_PAREN ")"
              SEMICOLON ";"
            WHITESPACE "\n    "
            R_CURLY "}"
