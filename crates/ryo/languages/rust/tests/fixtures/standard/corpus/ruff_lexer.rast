                      COMMENT "// The lexer might've eaten some whitespaces to calculate the `indentation`. For"
                      WHITESPACE "\n                "
                      COMMENT "// example:"
                      WHITESPACE "\n                "
                      COMMENT "//"
                      WHITESPACE "\n                "
                      COMMENT "// ```py"
                      WHITESPACE "\n                "
                      COMMENT "// if first:"
                      WHITESPACE "\n                "
                      COMMENT "//     if second:"
                      WHITESPACE "\n                "
                      COMMENT "//         pass"
                      WHITESPACE "\n                "
                      COMMENT "//     foo"
                      WHITESPACE "\n                "
                      COMMENT "// #   ^"
                      WHITESPACE "\n                "
                      COMMENT "// ```"
                      WHITESPACE "\n                "
                      COMMENT "//"
                      WHITESPACE "\n                "
                      COMMENT "// Here, the cursor is at `^` and the `indentation` contains the whitespaces before"
