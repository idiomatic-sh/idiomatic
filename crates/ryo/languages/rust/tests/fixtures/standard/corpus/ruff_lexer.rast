                              WHITESPACE "\n                    "
                              COMMENT "// if True:"
                              WHITESPACE "\n                    "
                              COMMENT "//     \\"
                              WHITESPACE "\n                    "
                              COMMENT "//         1"
                              WHITESPACE "\n                    "
                              COMMENT "//     \\"
                              WHITESPACE "\n                    "
                              COMMENT "// 2"
                              WHITESPACE "\n                    "
                              COMMENT "// else:\\"
                              WHITESPACE "\n                    "
                              COMMENT "//     3"
                              WHITESPACE "\n\n                    "
                              COMMENT "// test_err backslash_continuation_indentation_error"
                              WHITESPACE "\n                    "
                              COMMENT "// if True:"
                              WHITESPACE "\n                    "
                              COMMENT "//     1"
                              WHITESPACE "\n                    "
                              COMMENT "//       \\"
                              WHITESPACE "\n                    "
                              COMMENT "//     2"
                              WHITESPACE "\n\n                    "
                              COMMENT "// > Indentation cannot be split over multiple physical lines using backslashes;"
                              WHITESPACE "\n                    "
                              COMMENT "// > the whitespace up to the first backslash determines the indentation."
                              WHITESPACE "\n                    "
                              COMMENT "// >"
                              WHITESPACE "\n                    "
                              COMMENT "// > https://docs.python.org/3/reference/lexical_analysis.html#indentation"
                              WHITESPACE "\n                    "
                              COMMENT "//"
                              WHITESPACE "\n                    "
                              COMMENT "// Skip whitespace after the continuation-line without accumulating it into"
                              WHITESPACE "\n                    "
                              COMMENT "// `indentation`. However, if the backslash is at column 0 (no prior"
                              WHITESPACE "\n                    "
                              COMMENT "// indentation), let the loop continue so the next line's whitespace is"
                              WHITESPACE "\n                    "
                              COMMENT "// accumulated normally."
                              WHITESPACE "\n                    "
                              COMMENT "//"
                              WHITESPACE "\n                    "
                              COMMENT "// See also: https://github.com/python/cpython/issues/90249"
