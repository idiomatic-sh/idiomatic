              MACRO_EXPR
                MACRO_CALL
                  PATH
                    PATH_SEGMENT
                      NAME_REF
                        IDENT "assert_snapshot"
                  BANG "!"
                  TOKEN_TREE
                    L_PAREN "("
                    IDENT "lex_source"
                    TOKEN_TREE
                      L_PAREN "("
                      AMP "&"
                      IDENT "source"
                      R_PAREN ")"
                    R_PAREN ")"
              SEMICOLON ";"
            WHITESPACE "\n    "
            R_CURLY "}"
