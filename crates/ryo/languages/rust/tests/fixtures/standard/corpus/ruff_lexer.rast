                NAME
                  IDENT "source"
              WHITESPACE " "
              EQ "="
              WHITESPACE " "
              METHOD_CALL_EXPR
                LITERAL
                  STRING "r\"if True:\n\\\n    1\n    if True:\n\\\n        2\nelse:\\\n    3\n\""
                WHITESPACE "\n        "
                DOT "."
                NAME_REF
                  IDENT "to_string"
                ARG_LIST
                  L_PAREN "("
                  R_PAREN ")"
              SEMICOLON ";"
            WHITESPACE "\n        "
