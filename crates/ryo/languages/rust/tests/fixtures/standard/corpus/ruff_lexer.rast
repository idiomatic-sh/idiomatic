        WHITESPACE " "
        BLOCK_EXPR
          STMT_LIST
            L_CURLY "{"
            WHITESPACE "\n        "
            COMMENT "// But, it's a different when the backslash character itself is at the root indentation"
            WHITESPACE "\n        "
            COMMENT "// level. Then, the whitespaces following it determines the indentation level of the next"
            WHITESPACE "\n        "
            COMMENT "// line, so `1` is indented with 4 spaces and `2` is indented with 8 spaces, and `3` is"
            WHITESPACE "\n        "
            COMMENT "// indented with 4 spaces, all of which are valid."
            WHITESPACE "\n        "
            LET_STMT
              LET_KW "let"
              WHITESPACE " "
