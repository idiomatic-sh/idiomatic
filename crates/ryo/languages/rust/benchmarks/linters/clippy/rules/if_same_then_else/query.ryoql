import spanless_eq from "rust/clippy/spanless-eq";
import lint_attributes from "rust/clippy/lint-attributes";
let ifs = select id, file from "syntax-tree" where kind = "if-expr";
let roles = select l.parent as parent, l.child as child, l.field as field, l.file as file from "syntax-child" as l join ifs as r on l.parent = r.id;
let thens = select parent as id, child as block, file from roles where field = "then-branch";
let conditions = select parent as id, child as condition, file from roles where field = "condition";
let elses = select parent as id, child as other, file from roles where field = "else-branch";
let lets = select id, file from "syntax-tree" where kind = "let-expr";
let condition_nodes = select condition as id, file from conditions;
let nested_lets = axis(from=lets, relation="syntax-child", direction=ancestor, domain=condition_nodes);
let let_conditions = select related as id, file from nested_lets;
let direct_lets = select l.condition as id, l.file as file from conditions as l join lets as r on l.condition = r.id;
let binding_conditions = union(left=let_conditions, right=direct_lets);
let binding_ifs = select l.id as id, l.file as file from conditions as l join binding_conditions as r on l.condition = r.id;
let blocks = select id, file from "syntax-tree" where kind = "block-expr";
let else_blocks = select l.id as id, l.other as other, l.file as file from elses as l join blocks as r on l.other = r.id;
let block_pairs = select l.id as id, l.block as left, r.other as right, l.file as file from thens as l join else_blocks as r on l.id = r.id;
let else_ifs = select l.id as id, l.other as other, l.file as file from elses as l join ifs as r on l.other = r.id;
let plain_else_ifs = antijoin(left=else_ifs, right=binding_ifs, left-on=["other"], right-on=["id"]);
let else_if_thens = select l.id as id, r.block as right, l.file as file from plain_else_ifs as l join thens as r on l.other = r.id;
let chain_pairs = select l.id as id, l.block as left, r.right as right, l.file as file from thens as l join else_if_thens as r on l.id = r.id;
let all_pairs = union(left=block_pairs, right=chain_pairs);
let pairs = antijoin(left=all_pairs, right=binding_ifs, left-on=["id"], right-on=["id"]);
let spanned = select l.left as id, l.left as left, l.right as right, l.file as file, r.span as span from pairs as l join "syntax-tree" as r on l.left = r.id;
let same = spanless_eq(pairs=spanned);
let lists = select l.parent as block, l.child as list, l.file as file from "syntax-child" as l join blocks as r on l.parent = r.id where l.field = "stmt-list";
let members = select l.block as block, r.child as child, r.ordinal as ordinal, r.field as field, l.file as file from lists as l join "syntax-child" as r on l.list = r.parent;
let comments = select l.block as block, l.ordinal as ordinal, r.text as text, l.file as file from members as l join "syntax-tree" as r on l.child = r.id where r.kind = "comment";
let tails = select block, ordinal, file from members where field = "tail-expr";
let after_tail = select l.block as block, l.ordinal as ordinal, l.text as text, l.file as file from comments as l join tails as r on l.block = r.block where r.ordinal < l.ordinal;
let leading = antijoin(left=comments, right=after_tail, left-on=["block", "ordinal"], right-on=["block", "ordinal"]);
let commented = group-digest(from=leading, keys=["block", "file"], distinct="text", digest="digest", count="count");
let left_digests = select l.id as id, l.left as left, l.right as right, l.file as file, l.span as span, r.digest as digest from same as l join commented as r on l.left = r.block;
let same_comments = select l.id as id, l.file as file, l.span as span from left_digests as l join commented as r on l.right = r.block and l.digest = r.digest;
let left_bare = antijoin(left=same, right=commented, left-on=["left"], right-on=["block"]);
let both_bare = antijoin(left=left_bare, right=commented, left-on=["right"], right-on=["block"]);
let bare = select id, file, span from both_bare;
let candidates = union(left=bare, right=same_comments);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:if_same_then_else|style|all))\s*(?:,|$)");
emit violations subject file key(id);
