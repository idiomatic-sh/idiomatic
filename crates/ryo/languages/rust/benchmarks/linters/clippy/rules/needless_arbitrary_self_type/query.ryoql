import lint_attributes from "rust/clippy/lint-attributes";
let receivers = select id, file from "syntax-tree" where kind = "self-param";
let types = select l.parent as receiver, l.child as type from "syntax-child" as l join receivers as r on l.parent = r.id where l.field = "ty";
let keywords = select file, span from "syntax-tree" where kind = "self-type-kw";
let path_types = select id, file, span from "syntax-tree" where kind = "path-type";
let selves = select l.id as id from path_types as l join keywords as r on l.file = r.file and l.span = r.span;
let references = select id from "syntax-tree" where kind = "ref-type";
let referenced = select l.parent as id from "syntax-child" as l join selves as r on l.child = r.id where l.field = "ty";
let self_references = select l.id as id from references as l join referenced as r on l.id = r.id;
let mutable = select l.parent as receiver, r.span as start from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "mut-kw";
let by_value = select l.receiver as receiver, l.type as type from types as l join selves as r on l.type = r.id;
let by_reference = select l.receiver as receiver, l.type as type from types as l join self_references as r on l.type = r.id;
let plain_by_reference = antijoin(left=by_reference, right=mutable, left-on=["receiver"], right-on=["receiver"]);
let needless = union(left=by_value, right=plain_by_reference);
let names = select l.parent as receiver, r.span as start from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "name";
let named = antijoin(left=names, right=mutable, left-on=["receiver"], right-on=["receiver"]);
let starts = union(left=mutable, right=named);
let started = select l.receiver as receiver, l.type as type, r.start as start from needless as l join starts as r on l.receiver = r.receiver;
let typed = select l.type as id, r.file as file, l.start as start, r.span as end from started as l join "syntax-tree" as r on l.type = r.id;
let spanned = span-between(from=typed, start="start", end="end", output="span");
let candidates = select id, file, span from spanned;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:needless_arbitrary_self_type|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
