import lint_attributes from "rust/clippy/lint-attributes";
import attribute_owners from "rust/clippy/attribute-owners";
import inner_attributes from "rust/clippy/inner-attributes";
import doc_comments from "rust/clippy/doc-comments";
import hulls from "rust/clippy/hulls";
let items = select id, file from "syntax-tree" where kind = "fn" or kind = "module" or kind = "impl" or kind = "trait" or kind = "extern-block";
let item_parents = select l.id as id, r.parent as parent, l.file as file from items as l join "syntax-child" as r on l.id = r.child;
let members = select l.id as id, l.file as file from item_parents as l join "syntax-tree" as r on l.parent = r.id where r.kind = "assoc-item-list" or r.kind = "extern-item-list";
let checked = antijoin(left=items, right=members, left-on=["id"], right-on=["id"]);
let attributes = select occurrence as id, target as style, file, span from "decorates";
let doc_rows = doc_comments();
let docs = select l.id as id, r.kind as style, l.file as file, l.span as span from doc_rows as l join "syntax-tree" as r on l.id = r.id;
let elements = union(left=attributes, right=docs);
let element_ids = select id, file from elements;
let owners = attribute_owners(elements=element_ids);
let owned = select l.id as id, l.owner as item, r.style as style, r.file as file, r.span as span from owners as l join elements as r on l.id = r.id;
let on_items = select l.id as id, l.item as item, l.style as style, l.file as file, l.span as span from owned as l join checked as r on l.item = r.id;
let inner_marks = inner_attributes();
let inner = select l.id as id, l.item as item, l.style as style, l.file as file, l.span as span from on_items as l join inner_marks as r on l.id = r.id;
let outer = antijoin(left=on_items, right=inner_marks, left-on=["id"], right-on=["id"]);
let mixed = select l.item as item, l.file as file from outer as l join inner as r on l.item = r.item and l.style = r.style;
let mixed_elements = select l.item as owner, l.id as id, l.file as file, l.span as span from on_items as l join mixed as r on l.item = r.item;
let spans = hulls(members=mixed_elements);
let candidates = select id, file, span from spans;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:mixed_attributes_style|style|all))\s*(?:,|$)");
emit violations subject file key(span);
