import lint_attributes from "rust/clippy/lint-attributes";
let functions = select id from "syntax-tree" where kind = "fn";
let generic_lists = select l.parent as function, l.child as list from "syntax-child" as l join functions as r on l.parent = r.id where l.field = "generic-param-list";
let where_clauses = select l.parent as function, l.child as clause from "syntax-child" as l join functions as r on l.parent = r.id where l.field = "where-clause";
let parameters = select l.list as list, l.function as function, r.child as parameter from generic_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "params";
let bound_lists = select l.parent as owner, l.child as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "type-bound-list";
let bounds = select l.parent as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "type-bound";
let filled_lists = select l.owner as owner from bound_lists as l join bounds as r on l.list = r.list;
let bounded_parameters = select l.list as list, l.function as function, l.parameter as parameter from parameters as l join filled_lists as r on l.parameter = r.owner;
let name_nodes = select id from "syntax-tree" where kind = "name" or kind = "lifetime";
let parameter_names = select l.list as list, l.function as function, r.child as name from bounded_parameters as l join "syntax-child" as r on l.parameter = r.parent;
let named_parameters = select l.list as list, l.function as function, l.name as name from parameter_names as l join name_nodes as r on l.name = r.id;
let words = select id, file, span, text from "syntax-tree" where kind = "ident" or kind = "lifetime-ident";
let word_children = select l.parent as name, r.file as file, r.span as span, r.text as text from "syntax-child" as l join words as r on l.child = r.id;
let parameter_words = select l.list as list, l.function as function, r.file as file, r.span as span, r.text as text from named_parameters as l join word_children as r on l.name = r.name;
let predicates = select l.function as function, r.child as predicate from where_clauses as l join "syntax-child" as r on l.clause = r.parent where r.field = "predicates";
let binders = select l.parent as predicate from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "for-binder";
let filled_predicates = select l.function as function, l.predicate as predicate from predicates as l join filled_lists as r on l.predicate = r.owner;
let binder_predicates = select l.function as function, l.predicate as predicate from predicates as l join binders as r on l.predicate = r.predicate;
let lifetime_predicates = select l.parent as predicate from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "lifetime";
let binder_type_predicates = antijoin(left=binder_predicates, right=lifetime_predicates, left-on=["predicate"], right-on=["predicate"]);
let bounding = union(left=filled_predicates, right=binder_type_predicates);
let subjects = select l.function as function, r.child as subject from bounding as l join "syntax-child" as r on l.predicate = r.parent;
let subject_spans = select l.function as function, r.file as file, r.span as span from subjects as l join "syntax-tree" as r on l.subject = r.id where r.kind != "for-binder" and r.kind != "type-bound-list" and r.kind != "colon" and r.kind != "whitespace" and r.kind != "comment";
let subject_words = select l.function as function, r.text as text from subject_spans as l join words as r on l.file = r.file and l.span = r.span;
let repeated = select l.list as id, l.file as file, l.span as span from parameter_words as l join subject_words as r on l.function = r.function and l.text = r.text;
let violations = lint_attributes(candidates=repeated, names="(?:^|,)\s*(?:clippy::(?:multiple_bound_locations|style|all))\s*(?:,|$)");
emit violations subject file key(span);
