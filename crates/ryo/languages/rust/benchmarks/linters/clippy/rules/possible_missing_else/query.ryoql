import lint_attributes from "rust/clippy/lint-attributes";
let tree = select id, file from "syntax-tree";
let lists = select id, file from "syntax-tree" where kind = "stmt-list";
let members = select l.child as id, l.field as field, r.kind as kind, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "statements" or l.field = "tail-expr";
let statements = select id, file from members where kind = "expr-stmt";
let terminated = select l.parent as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "semicolon";
let open_statements = antijoin(left=statements, right=terminated, left-on=["id"], right-on=["id"]);
let statement_exprs = select l.id as id, r.child as expr, l.file as file from statements as l join "syntax-child" as r on l.id = r.parent where r.field = "expr";
let tails = select id, id as expr, file from members where field = "tail-expr";
let shaped = union(left=statement_exprs, right=tails);
let kinded = select l.id as id, l.expr as expr, r.kind as kind, l.file as file from shaped as l join "syntax-tree" as r on l.expr = r.id;
let flavoured = select l.parent as expr, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "async-kw" or r.kind = "const-kw" or r.kind = "gen-kw" or r.kind = "try-kw";
let blocks = select id, expr, file from kinded where kind = "block-expr";
let plain_blocks = antijoin(left=blocks, right=flavoured, left-on=["expr"], right-on=["expr"]);
let if_rows = select id, expr, file from kinded where kind = "if-expr";
let followers = union(left=if_rows, right=plain_blocks);
let open_ifs = select l.id as id, l.file as file from if_rows as l join open_statements as r on l.id = r.id;
let after_first = axis(from=open_ifs, relation="syntax-child", direction=next-sibling, domain=tree);
let touching = select l.id as id, l.related as second, l.file as file from after_first as l join followers as r on l.related = r.id;
let touching_spans = select l.id as id, r.span as start, l.file as file from touching as l join "syntax-tree" as r on l.second = r.id;
let touching_bounds = select l.id as id, l.start as start, r.span as end, l.file as file from touching_spans as l join "syntax-tree" as r on l.id = r.id;
let touching_gaps = span-between(from=touching_bounds, start="start", end="end", output="span");
let spaces = select id, span, file from "syntax-tree" where kind = "whitespace" and matches(text, "^[^\n]*$");
let spaced = select l.id as first, l.related as id, r.span as span, l.file as file from after_first as l join spaces as r on l.related = r.id;
let after_space = axis(from=spaced, relation="syntax-child", direction=next-sibling, domain=tree);
let spaced_gaps = select l.first as id, l.span as span, l.file as file from after_space as l join followers as r on l.related = r.id;
let touching_rows = select id, span, file from touching_gaps;
let gaps = union(left=touching_rows, right=spaced_gaps);
let candidates = select id, file, span from gaps;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:possible_missing_else|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
