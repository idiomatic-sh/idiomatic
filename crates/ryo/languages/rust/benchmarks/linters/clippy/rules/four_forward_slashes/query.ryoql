import lint_attributes from "rust/clippy/lint-attributes";
import item_heads from "rust/clippy/item-heads";
let items = select id, file from "syntax-tree" where kind = "fn" or kind = "struct" or kind = "enum" or kind = "union" or kind = "trait" or kind = "impl" or kind = "module" or kind = "use" or kind = "extern-crate" or kind = "const" or kind = "static" or kind = "type-alias" or kind = "macro-rules" or kind = "macro-def" or kind = "extern-block";
let item_edges = select l.id as id, r.parent as parent, r.ordinal as ordinal, l.file as file from items as l join "syntax-child" as r on l.id = r.child;
let placed = select l.id as id, l.parent as parent, l.ordinal as ordinal, l.file as file from item_edges as l join "syntax-tree" as r on l.parent = r.id where r.kind = "source-file" or r.kind = "item-list" or r.kind = "stmt-list";
let placed_items = select id, file from placed;
let firsts = item_heads(items=placed_items);
let siblings = select l.id as id, r.child as sibling, r.ordinal as ordinal, l.file as file from placed as l join "syntax-child" as r on l.parent = r.parent where r.ordinal < l.ordinal;
let solid = select l.id as id, l.sibling as sibling, l.ordinal as ordinal, l.file as file, r.span as span from siblings as l join "syntax-tree" as r on l.sibling = r.id where r.kind != "comment" and r.kind != "whitespace";
let farther = select l.id as id, l.sibling as sibling from solid as l join solid as r on l.id = r.id where r.ordinal > l.ordinal;
let previous = antijoin(left=solid, right=farther, left-on=["id", "sibling"], right-on=["id", "sibling"]);
let after_previous = select l.id as id, l.head as head, l.file as file, r.span as from_span, l.span as head_span from firsts as l join previous as r on l.id = r.id;
let opening = antijoin(left=firsts, right=previous, left-on=["id"], right-on=["id"]);
let opening_parents = select l.id as id, l.head as head, r.parent as parent, l.file as file, l.span as head_span from opening as l join placed as r on l.id = r.id;
let from_files = select l.id as id, l.head as head, l.file as file, r.span as from_span, l.head_span as head_span from opening_parents as l join "syntax-tree" as r on l.parent = r.id;
let following = span-between(from=after_previous, start="from_span", end="head_span", output="region");
let leading = span-between(from=from_files, start="from_span", end="head_span", output="region");
let following_runs = source-matches(from=following, span="region", pattern="\n(?P<run>(?:[ \t]*(?:(?://|#\[)[^\n]*)?\n)*)[^\n]*\z", output="found", capture="run", capture-output="run_span");
let leading_runs = source-matches(from=leading, span="region", pattern="(?:\A|\n)(?P<run>(?:[ \t]*(?:(?://|#\[)[^\n]*)?\n)*)[^\n]*\z", output="found", capture="run", capture-output="run_span");
let following_rows = select id, head, file, head_span, run_span from following_runs;
let leading_rows = select id, head, file, head_span, run_span from leading_runs;
let runs = union(left=following_rows, right=leading_rows);
let bad = source-matches(from=runs, span="run_span", pattern="(?m)^[ \t]*////(?:[^/!\n][^\n]*)?$", output="line");
let bounded = span-bounds(from=bad, span="line", start-output="begin", end-output="finish");
let lower = select l.id as id, l.line as line from bounded as l join bounded as r on l.id = r.id where r.begin < l.begin;
let topmost = antijoin(left=bounded, right=lower, left-on=["id", "line"], right-on=["id", "line"]);
let points = source-matches(from=topmost, span="head_span", pattern="\A", output="point");
let spanned = span-between(from=points, start="line", end="point", output="whole");
let candidates = select head as id, file, whole as span from spanned;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:four_forward_slashes|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
