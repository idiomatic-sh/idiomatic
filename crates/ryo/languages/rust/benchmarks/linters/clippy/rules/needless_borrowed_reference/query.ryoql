import bindings from "rust/clippy/bindings";
import lint_attributes from "rust/clippy/lint-attributes";
let references = select id, file, span from "syntax-tree" where kind = "ref-pat";
let mutable = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "mut-kw";
let shared = antijoin(left=references, right=mutable, left-on=["id"], right-on=["id"]);
let patterns = select id, kind from "syntax-tree" where matches(kind, "-pat$");
let pattern_children = select l.parent as parent, l.child as child, r.kind as kind from "syntax-child" as l join patterns as r on l.child = r.id;
let paren_ids = select id from "syntax-tree" where kind = "paren-pat";
let paren_edges = select l.parent as outer, l.child as inner from pattern_children as l join paren_ids as r on l.parent = r.id;
let peeling = closure(edges=paren_edges, source="outer", destination="inner");
let shown = select id as outer, id as inner from patterns;
let peeled_pairs = union(left=shown, right=peeling);
let peeled = select l.outer as outer, l.inner as inner, r.kind as kind from peeled_pairs as l join patterns as r on l.inner = r.id where r.kind != "paren-pat";
let binding_rows = bindings();
let bare = select id from binding_rows where at = 0;
let refs = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "ref-kw";
let bare_refs = select l.id as id from bare as l join refs as r on l.id = r.id;
let ref_bindings = antijoin(left=bare_refs, right=mutable, left-on=["id"], right-on=["id"]);
let inner = select l.id as reference, l.file as file, l.span as span, r.child as child from shared as l join pattern_children as r on l.id = r.parent;
let inner_peeled = select l.reference as reference, l.file as file, l.span as span, r.inner as pattern, r.kind as kind from inner as l join peeled as r on l.child = r.outer;
let direct = select l.reference as id, l.file as file, l.span as span from inner_peeled as l join ref_bindings as r on l.pattern = r.id;
let aggregates = select reference, file, span, pattern from inner_peeled where kind = "slice-pat" or kind = "tuple-pat" or kind = "tuple-struct-pat" or kind = "record-pat";
let field_lists = select l.parent as pattern, l.child as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "record-pat-field-list";
let fields = select l.pattern as pattern, r.child as field from field_lists as l join "syntax-child" as r on l.list = r.parent;
let field_patterns = select l.pattern as parent, r.child as child, r.kind as kind from fields as l join pattern_children as r on l.field = r.parent;
let rest_fields = select l.pattern as parent, l.field as child, r.kind as kind from fields as l join patterns as r on l.field = r.id where r.kind = "rest-pat";
let record_elements = union(left=field_patterns, right=rest_fields);
let elements = union(left=pattern_children, right=record_elements);
let aggregate_elements = select l.reference as reference, r.child as child from aggregates as l join elements as r on l.pattern = r.parent;
let peeled_elements = select l.reference as reference, r.inner as element, r.kind as kind from aggregate_elements as l join peeled as r on l.child = r.outer;
let ref_elements = select l.reference as reference from peeled_elements as l join ref_bindings as r on l.element = r.id;
let neutral = select reference, element from peeled_elements where kind = "wildcard-pat" or kind = "rest-pat";
let ref_element_ids = select l.reference as reference, l.element as element from peeled_elements as l join ref_bindings as r on l.element = r.id;
let accepted = union(left=neutral, right=ref_element_ids);
let rejected = antijoin(left=peeled_elements, right=accepted, left-on=["reference", "element"], right-on=["reference", "element"]);
let referencing = select l.reference as reference, l.file as file, l.span as span from aggregates as l join ref_elements as r on l.reference = r.reference;
let all_ref = antijoin(left=referencing, right=rejected, left-on=["reference"], right-on=["reference"]);
let aggregate_hits = select reference as id, file, span from all_ref;
let hits = union(left=direct, right=aggregate_hits);
let hosts = select id from "syntax-tree" where kind = "or-pat" or kind = "let-stmt" or kind = "let-expr" or kind = "match-arm" or kind = "for-expr" or kind = "param";
let hosted = axis(from=hits, relation="syntax-child", direction=nearest-ancestor, domain=hosts);
let alternatives = select id from "syntax-tree" where kind = "or-pat";
let in_alternatives = select l.id as id from hosted as l join alternatives as r on l.related = r.id;
let candidates = antijoin(left=hits, right=in_alternatives, left-on=["id"], right-on=["id"]);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:needless_borrowed_reference|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
