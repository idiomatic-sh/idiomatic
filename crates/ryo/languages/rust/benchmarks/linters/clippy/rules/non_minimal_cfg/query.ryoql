import lint_attributes from "rust/clippy/lint-attributes";
let composites = select id, file, span from "syntax-tree" where kind = "cfg-composite";
let composite_children = select l.parent as composite, l.child as child, l.file as file from "syntax-child" as l join composites as r on l.parent = r.id;
let names = select l.composite as composite, r.text as name, l.file as file from composite_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "ident";
let negations = select composite as id, file from names where name = "not";
let owners = select id, file from "syntax-tree" where kind = "cfg-meta" or kind = "cfg-attr-meta";
let stops = union(left=negations, right=owners);
let chained = axis(from=composites, relation="syntax-child", direction=nearest-ancestor, domain=stops);
let cfgs = select id, file from "syntax-tree" where kind = "cfg-meta";
let in_cfg = select l.id as id, l.file as file, l.span as span from chained as l join cfgs as r on l.related = r.id;
let groups = select l.id as id, l.file as file, l.span as span, r.name as name from in_cfg as l join names as r on l.id = r.composite where r.name = "any" or r.name = "all";
let predicates = select l.composite as composite, l.child as child, l.file as file from composite_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "cfg-atom" or r.kind = "cfg-composite";
let counts = group-count(from=predicates, keys=["composite", "file"], count="conditions");
let singles = select l.id as id, l.file as file, l.span as span from groups as l join counts as r on l.id = r.composite where r.conditions = 1;
let alls = select id, file, span from groups where name = "all";
let empty_alls = antijoin(left=alls, right=counts, left-on=["id"], right-on=["composite"]);
let candidates = union(left=singles, right=empty_alls);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:non_minimal_cfg|style|all))\s*(?:,|$)");
emit violations subject file key(span);
