import lint_attributes from "rust/clippy/lint-attributes";
let ifs = select id, file, span from "syntax-tree" where kind = "if-expr";
let if_children = select l.parent as id, l.child as child, l.field as field, l.file as file from "syntax-child" as l join ifs as r on l.parent = r.id;
let conditions = select l.id as id, l.child as condition, l.file as file from if_children as l join "syntax-tree" as r on l.child = r.id where l.field = "condition" and r.kind = "path-expr";
let thens = select id, child as block, file from if_children where field = "then-branch";
let elses = select l.id as id, l.child as block, l.file as file from if_children as l join "syntax-tree" as r on l.child = r.id where l.field = "else-branch" and r.kind = "block-expr";
let bools = select l.parent as literal, l.file as file, r.kind as value from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "true-kw" or r.kind = "false-kw";
let then_lists = select l.id as id, l.file as file, r.child as list from thens as l join "syntax-child" as r on l.block = r.parent where r.field = "stmt-list";
let then_entries = select l.id as id, l.file as file, r.child as entry, r.field as field from then_lists as l join "syntax-child" as r on l.list = r.parent;
let then_statements = select id, file, entry from then_entries where field = "statements";
let then_counts = group-count(from=then_statements, keys=["id", "file"], count="statements");
let single_thens = select id, file from then_counts where statements = 1;
let then_tail_entries = select id, file, entry from then_entries where field = "tail-expr";
let then_tails = select l.id as id, l.file as file, r.value as value from then_tail_entries as l join bools as r on l.entry = r.literal;
let assignments = select l.id as id, l.file as file, r.child as assignment from then_statements as l join "syntax-child" as r on l.entry = r.parent where r.field = "expr";
let assignment_children = select l.id as id, l.file as file, r.child as child, r.field as field from assignments as l join "syntax-child" as r on l.assignment = r.parent;
let operators = select id, file, child from assignment_children where field = "op";
let assigning = select l.id as id, l.file as file from operators as l join "syntax-tree" as r on l.child = r.id where r.kind = "eq";
let values = select id, file, child from assignment_children where field = "rhs";
let clearing = select l.id as id, l.file as file from values as l join bools as r on l.child = r.literal where r.value = "false-kw";
let places_assigned = select id, file, child from assignment_children where field = "lhs";
let targets = select l.id as id, l.child as target, l.file as file from places_assigned as l join "syntax-tree" as r on l.child = r.id where r.kind = "path-expr";
let else_lists = select l.id as id, l.file as file, r.child as list from elses as l join "syntax-child" as r on l.block = r.parent where r.field = "stmt-list";
let else_entries = select l.id as id, l.file as file, r.child as entry, r.field as field from else_lists as l join "syntax-child" as r on l.list = r.parent;
let else_statements = select id, file from else_entries where field = "statements";
let else_tail_entries = select id, file, entry from else_entries where field = "tail-expr";
let else_tails = select l.id as id, l.file as file, r.value as value from else_tail_entries as l join bools as r on l.entry = r.literal;
let opposed = select l.id as id, l.file as file from then_tails as l join else_tails as r on l.id = r.id where l.value != r.value;
let condition_places = select condition as id, file from conditions;
let target_places = select target as id, file from targets;
let places = union(left=condition_places, right=target_places);
let idents = select id, file, text from "syntax-tree" where kind = "ident";
let place_idents = axis(from=places, relation="syntax-child", direction=descendant, domain=idents);
let place_counts = group-count(from=place_idents, keys=["id", "file"], count="idents");
let simple_places = select id, file from place_counts where idents = 1;
let place_texts = select l.id as id, l.file as file, r.text as text from place_idents as l join idents as r on l.related = r.id;
let simple_texts = select l.id as id, l.file as file, l.text as text from place_texts as l join simple_places as r on l.id = r.id;
let condition_texts = select l.id as id, l.file as file, r.text as text from conditions as l join simple_texts as r on l.condition = r.id;
let target_texts = select l.id as id, l.file as file, r.text as text from targets as l join simple_texts as r on l.target = r.id;
let same = select l.id as id, l.file as file from condition_texts as l join target_texts as r on l.id = r.id and l.text = r.text;
let shaped = intersection(left=same, right=single_thens);
let assigned = intersection(left=shaped, right=assigning);
let cleared = intersection(left=assigned, right=clearing);
let swapped = intersection(left=cleared, right=opposed);
let taken = antijoin(left=swapped, right=else_statements, left-on=["id"], right-on=["id"]);
let located = select l.id as id, l.file as file, r.span as span from taken as l join ifs as r on l.id = r.id;
let candidates = select r.condition as id, l.file as file, l.span as span from located as l join conditions as r on l.id = r.id;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:manual_take|complexity|all))\s*(?:,|$)");
emit violations subject file key(span);
