import lint_attributes from "rust/clippy/lint-attributes";
let operators = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "op" and r.kind = "eq";
let binaries = select id, file, span from "syntax-tree" where kind = "bin-expr";
let assignments = select l.id as id, l.file as file, l.span as span from binaries as l join operators as r on l.id = r.id;
let projections = select id, kind from "syntax-tree" where kind = "field-expr" or kind = "index-expr";
let targets = select l.parent as assignment, l.child as target from "syntax-child" as l join assignments as r on l.parent = r.id where l.field = "lhs";
let projected_targets = select l.assignment as assignment, l.target as target from targets as l join projections as r on l.target = r.id;
let field_bases = select l.parent as outer, l.child as inner from "syntax-child" as l join projections as r on l.parent = r.id where r.kind = "field-expr" and l.field = "expr";
let index_bases = select l.parent as outer, l.child as inner from "syntax-child" as l join projections as r on l.parent = r.id where r.kind = "index-expr" and l.field = "base";
let parens = select id from "syntax-tree" where kind = "paren-expr";
let paren_edges = select l.parent as outer, l.child as inner from "syntax-child" as l join parens as r on l.parent = r.id where l.field = "expr";
let projection_edges = union(left=field_bases, right=index_bases);
let chain_edges = union(left=projection_edges, right=paren_edges);
let chains = closure(edges=chain_edges, source="outer", destination="inner");
let reached = select l.assignment as assignment, r.inner as node from projected_targets as l join chains as r on l.target = r.outer;
let started = select assignment, target as node from projected_targets;
let along = union(left=started, right=reached);
let peeling = closure(edges=paren_edges, source="outer", destination="inner");
let unwrapped = select l.outer as outer, r.inner as inner from projection_edges as l join peeling as r on l.inner = r.outer;
let bare = select outer, inner from projection_edges;
let peeled = union(left=bare, right=unwrapped);
let temporaries = select id, kind from "syntax-tree" where kind = "record-expr" or kind = "tuple-expr";
let innermost = select l.outer as projection, l.inner as base, r.kind as kind from peeled as l join temporaries as r on l.inner = r.id;
let fields = select id from "syntax-tree" where kind = "field-expr";
let field_innermost = select l.projection as projection, l.base as base, l.kind as kind from innermost as l join fields as r on l.projection = r.id;
let tuple_bases = select projection from field_innermost where kind = "tuple-expr";
let record_bases = select projection, base from field_innermost where kind = "record-expr";
let identifiers = select id, text from "syntax-tree" where kind = "ident" or kind = "int-number";
let name_refs = select l.parent as owner, r.text as name from "syntax-child" as l join identifiers as r on l.child = r.id;
let accessed = select l.parent as projection, r.name as name from "syntax-child" as l join name_refs as r on l.child = r.owner where l.field = "name-ref";
let lists = select l.parent as record, l.child as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "record-expr-field-list";
let spreads = select l.record as record from lists as l join "syntax-child" as r on l.list = r.parent where r.field = "spread";
let list_fields = select l.record as record, r.child as field from lists as l join "syntax-child" as r on l.list = r.parent where r.field = "fields";
let field_name_refs = select l.record as record, c.child as name_ref from list_fields as l join "syntax-child" as c on l.field = c.parent where c.field = "name-ref";
let written_names = select l.record as record, r.name as name from field_name_refs as l join name_refs as r on l.name_ref = r.owner;
let shorthand_paths = select l.record as record, l.field as field, c.child as expression from list_fields as l join "syntax-child" as c on l.field = c.parent where c.field = "expr";
let named_field_ids = select l.field as field from list_fields as l join "syntax-child" as c on l.field = c.parent where c.field = "name-ref";
let shorthands = antijoin(left=shorthand_paths, right=named_field_ids, left-on=["field"], right-on=["field"]);
let shorthand_idents = select l.record as record, l.expression as expression, r.file as file, r.span as span from shorthands as l join "syntax-tree" as r on l.expression = r.id;
let shorthand_tokens = select id, file, span, text from "syntax-tree" where kind = "ident";
let shorthand_names = select l.record as record, r.text as name from shorthand_idents as l join shorthand_tokens as r on l.file = r.file and l.span = r.span;
let declared = union(left=written_names, right=shorthand_names);
let accessed_records = select l.projection as projection, l.base as base, r.name as name from record_bases as l join accessed as r on l.projection = r.projection;
let listed = select l.projection as projection from accessed_records as l join declared as r on l.base = r.record and l.name = r.name;
let spread_records = select l.projection as projection from record_bases as l join spreads as r on l.base = r.record;
let record_owned = union(left=listed, right=spread_records);
let temporary_projections = union(left=tuple_bases, right=record_owned);
let hits = select l.assignment as id from along as l join temporary_projections as r on l.node = r.projection;
let candidates = select l.id as id, l.file as file, l.span as span from assignments as l join hits as r on l.id = r.id;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:temporary_assignment|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
