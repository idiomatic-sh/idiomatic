import lint_attributes from "rust/clippy/lint-attributes";
let loops = select id, file, span from "syntax-tree" where kind = "loop-expr";
let bodies = select l.parent as id, l.child as body from "syntax-child" as l join loops as r on l.parent = r.id where l.field = "loop-body";
let lists = select l.id as id, r.child as list from bodies as l join "syntax-child" as r on l.body = r.parent where r.field = "stmt-list";
let contents = select l.parent as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind != "l-curly" and r.kind != "r-curly" and r.kind != "semicolon" and r.kind != "whitespace" and r.kind != "comment" and r.kind != "attr";
let filled = select l.id as id from lists as l join contents as r on l.list = r.list;
let empty = antijoin(left=loops, right=filled, left-on=["id"], right-on=["id"]);
let items = select id from "syntax-tree" where kind = "fn" or kind = "const" or kind = "static";
let owners = axis(from=empty, relation="syntax-child", direction=nearest-ancestor, domain=items);
let handlers = select declaration as id from "decorates" where target = "panic_handler";
let handled = select l.id as id from owners as l join handlers as r on l.related = r.id;
let spinning = antijoin(left=empty, right=handled, left-on=["id"], right-on=["id"]);
let heads = select l.parent as id, l.ordinal as ordinal, r.span as head from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "label" or r.kind = "loop-kw";
let later_heads = select l.id as id, l.ordinal as ordinal from heads as l join heads as r on l.id = r.id where r.ordinal < l.ordinal;
let first_heads = antijoin(left=heads, right=later_heads, left-on=["id", "ordinal"], right-on=["id", "ordinal"]);
let headed = select l.id as id, l.file as file, l.span as span, r.head as head from spinning as l join first_heads as r on l.id = r.id;
let unattributed = span-between(from=headed, start="head", end="span", output="written");
let reported = select r.body as id, l.file as file, l.written as span from unattributed as l join bodies as r on l.id = r.id;
let violations = lint_attributes(candidates=reported, names="(?:^|,)\s*(?:clippy::(?:empty_loop|suspicious|all))\s*(?:,|$)");
emit violations subject file key(id);
