import lint_attributes from "rust/clippy/lint-attributes";
import next_token from "rust/clippy/next-token";
let definitions = select id from "syntax-tree" where kind = "macro-rules";
let exports = select declaration as id from "decorates" where target = "macro_export";
let exported = select l.id as id from definitions as l join exports as r on l.id = r.id;
let keywords = select id, file, span from "syntax-tree" where kind = "crate-kw";
let owners = axis(from=keywords, relation="syntax-child", direction=nearest-ancestor, domain=exported);
let owned = select id, file, span, related as definition from owners;
let keyword_tokens = select id, file from owned;
let following = next_token(tokens=keyword_tokens);
let dollars = select id, file from "syntax-tree" where kind = "dollar";
let after_dollars = next_token(tokens=dollars);
let escaped = select next as id from after_dollars where kind = "crate-kw";
let colons = select id, file, next as colon, span as colon_span from following where kind = "colon";
let colon_ends = span-bounds(from=colons, span="colon_span", start-output="colon_start", end-output="colon_end");
let second_colons = select id, file, span from "syntax-tree" where kind = "colon";
let second_starts = span-bounds(from=second_colons, span="span", start-output="second_start", end-output="second_end");
let separated = select l.id as id from colon_ends as l join second_starts as r on l.file = r.file and l.colon_end = r.second_start;
let separated_slots = select l.id as id, l.file as file, l.span as span, l.definition as definition from owned as l join separated as r on l.id = r.id;
let unhygienic = antijoin(left=separated_slots, right=escaped, left-on=["id"], right-on=["id"]);
let starts = span-bounds(from=unhygienic, span="span", start-output="start", end-output="end");
let later_ones = select l.id as id from starts as l join starts as r on l.definition = r.definition where r.start < l.start;
let first = antijoin(left=starts, right=later_ones, left-on=["id"], right-on=["id"]);
let candidates = select id, file, span from first;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:crate_in_macro_def|suspicious|all))\s*(?:,|$)");
emit violations subject file key(id);
