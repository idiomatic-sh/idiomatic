import lint_attributes from "rust/clippy/lint-attributes";
import next_token from "rust/clippy/next-token";
let identifiers = select id, file, span, text from "syntax-tree" where kind = "ident" and matches(text, "^(?:assert_matches|cfg_select|debug_assert_matches|format|format_args|eprint|eprintln|print|println|write|writeln|vec|matches)$");
let opens = select id, kind from "syntax-tree" where kind = "l-paren" or kind = "l-brack" or kind = "l-curly";
let trees = select id, span from "syntax-tree" where kind = "token-tree";
let tree_opens = select l.parent as tree, r.kind as open from "syntax-child" as l join opens as r on l.child = r.id;
let parenthesized_names = select id, file, span, text from identifiers where text != "vec" and text != "cfg_select";
let bracketed_names = select id, file, span, text from identifiers where text = "vec";
let braced_names = select id, file, span, text from identifiers where text = "cfg_select";
let calls = select id, file, span from "syntax-tree" where kind = "macro-call";
let call_paths = select l.parent as call, l.child as path, r.file as file, r.span as span from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "path";
let paths = select id from "syntax-tree" where kind = "path";
let name_paths = axis(from=identifiers, relation="syntax-child", direction=nearest-ancestor, domain=paths);
let called_names = select l.call as call, l.file as file, l.span as path_span, r.id as name, r.span as name_span from call_paths as l join name_paths as r on l.path = r.related;
let named_calls = select l.call as call, l.file as file, l.path_span as path_span, l.name as name, l.name_span as name_span from called_names as l join calls as r on l.call = r.id;
let bangs = select l.parent as call, r.span as bang from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "bang";
let name_ends = span-bounds(from=named_calls, span="name_span", start-output="name_start", end-output="name_end");
let banged = select l.call as call, l.file as file, l.path_span as path_span, l.name as name, l.name_end as name_end, r.bang as bang from name_ends as l join bangs as r on l.call = r.call;
let bang_starts = span-bounds(from=banged, span="bang", start-output="bang_start", end-output="bang_end");
let adjacent = select call, file, path_span, name from bang_starts where bang_start = name_end;
let commented = select l.parent as call from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "comment";
let uncommented = antijoin(left=adjacent, right=commented, left-on=["call"], right-on=["call"]);
let call_trees = select l.parent as call, r.id as tree, r.span as tree_span from "syntax-child" as l join trees as r on l.child = r.id;
let delimited = select l.call as call, l.file as file, l.path_span as path_span, l.name as name, r.tree as tree, r.tree_span as tree_span from uncommented as l join call_trees as r on l.call = r.call;
let opened = select l.call as call, l.file as file, l.path_span as path_span, l.name as name, l.tree as tree, l.tree_span as tree_span, r.open as open from delimited as l join tree_opens as r on l.tree = r.tree;
let paren_calls = select l.tree as id, l.file as file, l.path_span as start, l.tree_span as end from opened as l join parenthesized_names as r on l.name = r.id where l.open != "l-paren";
let bracket_calls = select l.tree as id, l.file as file, l.path_span as start, l.tree_span as end from opened as l join bracketed_names as r on l.name = r.id where l.open != "l-brack";
let brace_calls = select l.tree as id, l.file as file, l.path_span as start, l.tree_span as end from opened as l join braced_names as r on l.name = r.id where l.open != "l-curly";
let some_calls = union(left=paren_calls, right=bracket_calls);
let wrong_calls = union(left=some_calls, right=brace_calls);
let call_hits = span-between(from=wrong_calls, start="start", end="end", output="span");
let definitions = select id from "syntax-tree" where kind = "macro-rules";
let defined = axis(from=identifiers, relation="syntax-child", direction=nearest-ancestor, domain=definitions);
let defined_names = select id, file from defined;
let after_names = next_token(tokens=defined_names);
let name_bangs = select id, file, next as bang from after_names where kind = "bang";
let bang_tokens = select bang as id, file from name_bangs;
let after_bangs = next_token(tokens=bang_tokens);
let bang_trees = select id as bang, next as tree, span as tree_span from after_bangs where kind = "token-tree";
let token_calls = select l.id as name, l.file as file, r.tree as tree, r.tree_span as tree_span from name_bangs as l join bang_trees as r on l.bang = r.bang;
let token_opened = select l.name as name, l.file as file, l.tree_span as tree_span, r.open as open from token_calls as l join tree_opens as r on l.tree = r.tree;
let paren_tokens = select r.id as id, l.file as file, r.span as start, l.tree_span as end from token_opened as l join parenthesized_names as r on l.name = r.id where l.open != "l-paren";
let bracket_tokens = select r.id as id, l.file as file, r.span as start, l.tree_span as end from token_opened as l join bracketed_names as r on l.name = r.id where l.open != "l-brack";
let brace_tokens = select r.id as id, l.file as file, r.span as start, l.tree_span as end from token_opened as l join braced_names as r on l.name = r.id where l.open != "l-curly";
let some_tokens = union(left=paren_tokens, right=bracket_tokens);
let wrong_tokens = union(left=some_tokens, right=brace_tokens);
let token_hits = span-between(from=wrong_tokens, start="start", end="end", output="span");
let call_rows = select id, file, span from call_hits;
let token_rows = select id, file, span from token_hits;
let candidates = union(left=call_rows, right=token_rows);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:nonstandard_macro_braces|style|all))\s*(?:,|$)");
emit violations subject file key(span);
