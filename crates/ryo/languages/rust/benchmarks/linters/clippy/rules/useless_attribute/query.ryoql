import lint_attributes from "rust/clippy/lint-attributes";
let imports = select id, kind, file from "syntax-tree" where kind = "use" or kind = "extern-crate";
let levels = select occurrence, declaration, file, span from "decorates" where target = "allow" or target = "warn" or target = "deny" or target = "forbid" or target = "expect";
let attributes = select r.occurrence as occurrence, r.declaration as declaration, l.kind as item, r.file as file, r.span as span from imports as l join levels as r on l.id = r.declaration;
let outer = source-matches(from=attributes, span="span", pattern="\A#\s*\[", output="opening");
let lints = source-matches(from=outer, span="span", pattern="[(,]\s*(?P<lint>[^,()\s][^,()]*[^,()\s]|[^,()\s])", output="found", capture="lint", capture-output="lint_span", capture-text-output="lint_written");
let named = replace(from=lints, text="lint_written", pattern="\s+", replacement="", output="lint");
let use_lints = select occurrence, declaration, lint, file from named where item = "use";
let use_kept = select occurrence, declaration, lint, file from use_lints where matches(lint, "^(?:(?:clippy::)?[A-Za-z_][A-Za-z0-9_]*)(?:=[\s\S]*)?$");
let use_strange = difference(left=use_lints, right=use_kept);
let use_exempt = select occurrence, declaration, lint, file from use_kept where matches(lint, "^(?:ambiguous_glob_reexports|dead_code|deprecated|deprecated_in_future|exported_private_dependencies|hidden_glob_reexports|unreachable_pub|unused|unused_braces|unused_import_braces|unused_imports|redundant_imports|clippy::(?:wildcard_imports|enum_glob_use|redundant_pub_crate|macro_use_imports|unsafe_removed_from_name|module_name_repetitions|single_component_path_imports|disallowed_types|unused_trait_names))$");
let crate_lints = select occurrence, declaration, lint, file from named where item = "extern-crate";
let crate_unused = select occurrence, declaration, lint, file from crate_lints where lint = "unused_extern_crates";
let macro_uses = select declaration, file from "decorates" where target = "macro_use";
let crate_imports = select l.occurrence as occurrence, l.declaration as declaration, l.lint as lint, l.file as file from crate_lints as l join macro_uses as r on l.declaration = r.declaration where l.lint = "unused_imports";
let crate_exempt = union(left=crate_unused, right=crate_imports);
let returns = union(left=use_strange, right=use_exempt);
let stops = union(left=returns, right=crate_exempt);
let stop_attributes = select l.occurrence as occurrence, l.declaration as declaration, l.file as file, l.span as span from attributes as l join stops as r on l.occurrence = r.occurrence;
let bounded = span-bounds(from=outer, span="span", start-output="begin", end-output="finish");
let stop_bounded = span-bounds(from=stop_attributes, span="span", start-output="begin", end-output="finish");
let stopped = select l.occurrence as occurrence, l.file as file from bounded as l join stop_bounded as r on l.declaration = r.declaration where r.begin <= l.begin;
let useless = antijoin(left=outer, right=stopped, left-on=["occurrence"], right-on=["occurrence"]);
let candidates = select occurrence as id, file, span from useless;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:useless_attribute|correctness|all))\s*(?:,|$)");
emit violations subject file key(span);
