import numeric_constants from "rust/clippy/numeric-constants";
import lint_attributes from "rust/clippy/lint-attributes";
let ors = select id, file, span from "syntax-tree" where kind = "or-pat";
let or_children = select l.parent as pattern, l.child as id, l.file as file from "syntax-child" as l join ors as r on l.parent = r.id;
let alternatives = select l.pattern as pattern, l.id as id, r.kind as kind, l.file as file from or_children as l join "syntax-tree" as r on l.id = r.id where matches(r.kind, "-pat$");
let constants = numeric_constants();
let integers = select id, value, file from constants where kind = "integer";
let points = select l.pattern as pattern, l.id as id, r.value as low, r.value as end, l.file as file from alternatives as l join integers as r on l.id = r.id where l.kind = "literal-pat";
let ranges = select pattern, id, file from alternatives where kind = "range-pat";
let range_children = select l.id as id, r.child as child, r.ordinal as ordinal, l.file as file from ranges as l join "syntax-child" as r on l.id = r.parent;
let range_operators = select l.id as id, l.ordinal as ordinal, r.text as operator, l.file as file from range_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "dot2" or r.kind = "dot2eq" or r.kind = "dot3";
let range_bounds = select l.id as id, l.ordinal as ordinal, r.value as value, l.file as file from range_children as l join integers as r on l.child = r.id;
let range_lows = select l.id as id, l.value as low, r.operator as operator, l.file as file from range_bounds as l join range_operators as r on l.id = r.id where l.ordinal < r.ordinal;
let range_ends = select l.id as id, l.value as end, l.file as file from range_bounds as l join range_operators as r on l.id = r.id where r.ordinal < l.ordinal;
let bounded = select l.id as id, l.low as low, r.end as end, l.operator as operator, l.file as file from range_lows as l join range_ends as r on l.id = r.id;
let spans = select l.pattern as pattern, l.id as id, r.low as low, r.end as end, r.operator as operator, l.file as file from ranges as l join bounded as r on l.id = r.id;
let closed_spans = select pattern, id, low, end, file from spans where operator = "..=" or operator = "...";
let open_spans = select pattern, id, low, end, file from spans where operator = "..";
let closed = union(left=points, right=closed_spans);
let numeric_points = select pattern, id, file from points;
let numeric_spans = select pattern, id, file from spans;
let numeric = union(left=numeric_points, right=numeric_spans);
let other = antijoin(left=alternatives, right=numeric, left-on=["id"], right-on=["id"]);
let counted = group-count(from=alternatives, keys=["pattern", "file"], count="alternatives");
let many = select pattern, file from counted where alternatives >= 3;
let pairs = select pattern, file from counted where alternatives >= 2;
let ranged = select l.pattern as pattern, l.file as file from pairs as l join ranges as r on l.pattern = r.pattern;
let eligible = union(left=many, right=ranged);
let numeric_only = antijoin(left=eligible, right=other, left-on=["pattern"], right-on=["pattern"]);
let closed_before_closed = select l.pattern as pattern, l.id as id, l.end as end, r.low as next_low, l.file as file from closed as l join closed as r on l.pattern = r.pattern where numeric_gte(r.end, l.end) and l.end != r.end;
let closed_before_open_wide = select l.pattern as pattern, l.id as id, l.end as end, r.low as next_low, r.end as next_end, l.file as file from closed as l join open_spans as r on l.pattern = r.pattern where numeric_gte(r.end, l.end) and l.end != r.end;
let closed_before_open_touching = select pattern, id, end, next_low, next_end, file from closed_before_open_wide where integer_successor(end, next_end);
let closed_before_open_kept = antijoin(left=closed_before_open_wide, right=closed_before_open_touching, left-on=["id", "next_low", "next_end"], right-on=["id", "next_low", "next_end"]);
let closed_before_open = select pattern, id, end, next_low, file from closed_before_open_kept;
let closed_followed = union(left=closed_before_closed, right=closed_before_open);
let open_before_open = select l.pattern as pattern, l.id as id, l.end as end, r.low as next_low, l.file as file from open_spans as l join open_spans as r on l.pattern = r.pattern where numeric_gte(r.end, l.end) and l.end != r.end;
let open_before_closed = select l.pattern as pattern, l.id as id, l.end as end, r.low as next_low, l.file as file from open_spans as l join closed as r on l.pattern = r.pattern where numeric_gte(r.end, l.end);
let open_followed = union(left=open_before_open, right=open_before_closed);
let closed_reached = select pattern, id, file from closed_followed where numeric_gte(end, next_low) or integer_successor(end, next_low);
let open_reached = select pattern, id, file from open_followed where numeric_gte(end, next_low);
let reached = union(left=closed_reached, right=open_reached);
let closed_needing = select pattern, id, file from closed_followed;
let open_needing = select pattern, id, file from open_followed;
let needing = union(left=closed_needing, right=open_needing);
let gaps = antijoin(left=needing, right=reached, left-on=["id"], right-on=["id"]);
let contiguous = antijoin(left=numeric_only, right=gaps, left-on=["pattern"], right-on=["pattern"]);
let candidates = select l.id as id, l.file as file, l.span as span from ors as l join contiguous as r on l.id = r.pattern;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:manual_range_patterns|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
