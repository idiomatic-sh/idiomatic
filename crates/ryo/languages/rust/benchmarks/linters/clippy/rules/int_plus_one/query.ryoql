import lint_attributes from "rust/clippy/lint-attributes";
let one_tokens = select id from "syntax-tree" where kind = "int-number" and matches(text, "^(?:0[xob])?[0_]*1_*(?:[iu](?:8|16|32|64|128|size))?$");
let ones = select l.parent as id from "syntax-child" as l join one_tokens as r on l.child = r.id;
let operators = select l.parent as id, r.kind as op from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "op";
let negations = select id from operators where op = "minus";
let negated = select l.parent as id from "syntax-child" as l join ones as r on l.child = r.id where l.field = "expr";
let minus_ones = select l.id as id from negations as l join negated as r on l.id = r.id;
let lefts = select parent as id, child as operand from "syntax-child" where field = "lhs";
let rights = select parent as id, child as operand from "syntax-child" where field = "rhs";
let left_ones = select l.id as id from lefts as l join ones as r on l.operand = r.id;
let right_ones = select l.id as id from rights as l join ones as r on l.operand = r.id;
let left_minus_ones = select l.id as id from lefts as l join minus_ones as r on l.operand = r.id;
let additions = select id from operators where op = "plus";
let subtractions = select id from operators where op = "minus";
let one_added = union(left=left_ones, right=right_ones);
let plus_one = select l.id as id from additions as l join one_added as r on l.id = r.id;
let minus_one_subtracted = select l.id as id from subtractions as l join right_ones as r on l.id = r.id;
let minus_one_added = select l.id as id from additions as l join left_minus_ones as r on l.id = r.id;
let minus_one = union(left=minus_one_subtracted, right=minus_one_added);
let left_plus = select l.id as id from lefts as l join plus_one as r on l.operand = r.id;
let left_minus = select l.id as id from lefts as l join minus_one as r on l.operand = r.id;
let right_plus = select l.id as id from rights as l join plus_one as r on l.operand = r.id;
let right_minus = select l.id as id from rights as l join minus_one as r on l.operand = r.id;
let at_least = select id from operators where op = "gteq";
let at_most = select id from operators where op = "lteq";
let at_least_shapes = union(left=left_minus, right=right_plus);
let at_most_shapes = union(left=left_plus, right=right_minus);
let at_least_hits = select l.id as id from at_least as l join at_least_shapes as r on l.id = r.id;
let at_most_hits = select l.id as id from at_most as l join at_most_shapes as r on l.id = r.id;
let hits = union(left=at_least_hits, right=at_most_hits);
let candidates = select r.id as id, r.file as file, r.span as span from hits as l join "syntax-tree" as r on l.id = r.id;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:int_plus_one|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
