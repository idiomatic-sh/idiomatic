import lint_attributes from "rust/clippy/lint-attributes";
let renames = select id from "syntax-tree" where kind = "rename";
let renamed_trees = select l.parent as tree, l.child as rename from "syntax-child" as l join renames as r on l.child = r.id;
let tree_paths = select l.tree as tree, r.child as path from renamed_trees as l join "syntax-child" as r on l.tree = r.parent where r.field = "path";
let identifiers = select id, text from "syntax-tree" where kind = "ident";
let paths = select id from "syntax-tree" where kind = "path";
let path_idents = axis(from=identifiers, relation="syntax-child", direction=nearest-ancestor, domain=paths);
let last_names = select l.tree as tree, r.text as old from tree_paths as l join path_idents as r on l.path = r.related;
let unsafe_names = select tree from last_names where matches(old, "Unsafe|unsafe");
let name_tokens = select l.parent as name, r.text as text from "syntax-child" as l join identifiers as r on l.child = r.id;
let rename_names = select l.parent as rename, r.text as new from "syntax-child" as l join name_tokens as r on l.child = r.name where l.field = "name";
let unsafe_renames = select rename from rename_names where matches(new, "Unsafe|unsafe");
let safe_renames = antijoin(left=rename_names, right=unsafe_renames, left-on=["rename"], right-on=["rename"]);
let safe_trees = select l.tree as tree from renamed_trees as l join safe_renames as r on l.rename = r.rename;
let removed = select l.tree as id from unsafe_names as l join safe_trees as r on l.tree = r.tree;
let uses = select id, file, span from "syntax-tree" where kind = "use";
let owners = axis(from=removed, relation="syntax-child", direction=nearest-ancestor, domain=uses);
let heads = select l.parent as id, l.ordinal as ordinal, r.span as head from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "visibility" or r.kind = "use-kw";
let later_heads = select l.id as id, l.ordinal as ordinal from heads as l join heads as r on l.id = r.id where r.ordinal < l.ordinal;
let first_heads = antijoin(left=heads, right=later_heads, left-on=["id", "ordinal"], right-on=["id", "ordinal"]);
let owned = select l.id as id, r.file as file, r.span as span, r.id as item from owners as l join uses as r on l.related = r.id;
let headed = select l.id as id, l.file as file, l.span as span, r.head as head from owned as l join first_heads as r on l.item = r.id;
let spanned = span-between(from=headed, start="head", end="span", output="written");
let candidates = select id, file, written as span from spanned;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:unsafe_removed_from_name|style|all))\s*(?:,|$)");
emit violations subject file key(span);
