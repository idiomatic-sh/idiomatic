import lint_attributes from "rust/clippy/lint-attributes";
let operators = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "op" and r.kind = "eq";
let binaries = select id, file, span from "syntax-tree" where kind = "bin-expr";
let assignments = select l.id as id, l.file as file, l.span as span from binaries as l join operators as r on l.id = r.id;
let parens = select id from "syntax-tree" where kind = "paren-expr";
let paren_edges = select l.parent as outer, l.child as inner from "syntax-child" as l join parens as r on l.parent = r.id where l.field = "expr";
let blocks = select id from "syntax-tree" where kind = "block-expr";
let modified = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "async-kw" or r.kind = "const-kw" or r.kind = "try-kw";
let plain_blocks = antijoin(left=blocks, right=modified, left-on=["id"], right-on=["id"]);
let block_lists = select l.parent as block, l.child as list from "syntax-child" as l join plain_blocks as r on l.parent = r.id where l.field = "stmt-list";
let stated = select parent as list from "syntax-child" where field = "statements";
let bare_lists = antijoin(left=block_lists, right=stated, left-on=["list"], right-on=["list"]);
let block_edges = select l.block as outer, r.child as inner from bare_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "tail-expr";
let edges = union(left=paren_edges, right=block_edges);
let wrapping = closure(edges=edges, source="outer", destination="inner");
let operands = select parent as id, child as operand from "syntax-child" where field = "lhs" or field = "rhs";
let wrapped_operands = select l.id as id, r.inner as operand from operands as l join wrapping as r on l.operand = r.outer;
let reached = union(left=operands, right=wrapped_operands);
let nested = select l.id as id from reached as l join assignments as r on l.operand = r.id;
let outer = select l.id as id, l.file as file, l.span as span from assignments as l join nested as r on l.id = r.id;
let violations = lint_attributes(candidates=outer, names="(?:^|,)\s*(?:clippy::(?:multi_assignments|suspicious|all))\s*(?:,|$)");
emit violations subject file key(id);
