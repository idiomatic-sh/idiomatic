import lint_attributes from "rust/clippy/lint-attributes";
let fors = select id, file, span from "syntax-tree" where kind = "for-expr";
let for_children = select l.parent as id, l.child as child, l.field as field, l.file as file from "syntax-child" as l join fors as r on l.parent = r.id;
let iterables = select id, child as iterable, file from for_children where field = "iterable";
let bodies = select id, child as body, file from for_children where field = "loop-body";
let arrays = select id, file from "syntax-tree" where kind = "array-expr";
let array_children = select l.parent as id, l.child as child, l.field as field, l.file as file from "syntax-child" as l join arrays as r on l.parent = r.id;
let elements = select id, child as element, file from array_children where field = "fields";
let counted = group-count(from=elements, keys=["id", "file"], count="elements");
let ones = select id, file from counted where elements = 1;
let repeats = select l.id as id, l.file as file from array_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "semicolon";
let singles = antijoin(left=ones, right=repeats, left-on=["id"], right-on=["id"]);
let direct = select l.id as id, l.iterable as iterable, l.file as file, l.iterable as array from iterables as l join singles as r on l.iterable = r.id;
let refs = select l.id as id, l.iterable as iterable, l.file as file from iterables as l join "syntax-tree" as r on l.iterable = r.id where r.kind = "ref-expr";
let raw_refs = select l.parent as iterable, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "raw-kw";
let plain_refs = antijoin(left=refs, right=raw_refs, left-on=["iterable"], right-on=["iterable"]);
let ref_operands = select l.id as id, l.iterable as iterable, l.file as file, r.child as array from plain_refs as l join "syntax-child" as r on l.iterable = r.parent where r.field = "expr";
let borrowed = select l.id as id, l.iterable as iterable, l.file as file, l.array as array from ref_operands as l join singles as r on l.array = r.id;
let calls = select l.id as id, l.iterable as iterable, l.file as file from iterables as l join "syntax-tree" as r on l.iterable = r.id where r.kind = "method-call-expr";
let call_children = select l.id as id, l.iterable as iterable, l.file as file, r.child as child, r.field as field from calls as l join "syntax-child" as r on l.iterable = r.parent;
let call_name_refs = select id, iterable, file, child as name_ref from call_children where field = "name-ref";
let call_name_tokens = select l.id as id, l.iterable as iterable, l.file as file, r.child as token from call_name_refs as l join "syntax-child" as r on l.name_ref = r.parent;
let iterator_calls = select l.id as id, l.iterable as iterable, l.file as file from call_name_tokens as l join "syntax-tree" as r on l.token = r.id where r.text = "iter" or r.text = "iter_mut" or r.text = "into_iter";
let call_arg_lists = select id, iterable, file, child as list from call_children where field = "arg-list";
let call_arguments = select l.id as id, l.iterable as iterable, l.file as file from call_arg_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "args";
let bare_calls = antijoin(left=iterator_calls, right=call_arguments, left-on=["iterable"], right-on=["iterable"]);
let receivers = select id, iterable, file, child as array from call_children where field = "receiver";
let receiver_singles = select l.id as id, l.iterable as iterable, l.file as file, l.array as array from receivers as l join singles as r on l.array = r.id;
let called = select l.id as id, l.iterable as iterable, l.file as file, l.array as array from receiver_singles as l join bare_calls as r on l.iterable = r.iterable;
let referenced = union(left=borrowed, right=called);
let loops = union(left=direct, right=referenced);
let body_lists = select l.id as id, l.file as file, r.child as list from bodies as l join "syntax-child" as r on l.body = r.parent where r.field = "stmt-list";
let body_entries = select l.id as id, l.file as file from body_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "statements" or r.field = "tail-expr";
let filled = project(from=body_entries, columns=["id", "file"]);
let jumps = select id, file from "syntax-tree" where kind = "break-expr" or kind = "continue-expr" or kind = "for-expr" or kind = "while-expr" or kind = "await-expr";
let loop_bodies = select body as id, file from bodies;
let jump_bodies = axis(from=jumps, relation="syntax-child", direction=ancestor, domain=loop_bodies);
let closures = select id, file from "syntax-tree" where kind = "closure-expr";
let jump_closures = axis(from=jumps, relation="syntax-child", direction=ancestor, domain=closures);
let closure_bodies = axis(from=closures, relation="syntax-child", direction=ancestor, domain=loop_bodies);
let shielded = select l.id as id, r.related as related, l.file as file from jump_closures as l join closure_bodies as r on l.related = r.id;
let reaching = antijoin(left=jump_bodies, right=shielded, left-on=["id", "related"], right-on=["id", "related"]);
let broken = select l.id as id, l.file as file from bodies as l join reaching as r on l.body = r.related;
let filled_loops = select l.id as id, l.iterable as iterable, l.file as file, l.array as array from loops as l join filled as r on l.id = r.id;
let unbroken = antijoin(left=filled_loops, right=broken, left-on=["id"], right-on=["id"]);
let loop_elements = select l.id as id, l.iterable as iterable, l.file as file, r.element as element from unbroken as l join elements as r on l.array = r.id;
let ranges = select l.id as id, l.iterable as iterable, l.file as file, l.element as element from loop_elements as l join "syntax-tree" as r on l.element = r.id where r.kind = "range-expr";
let started = select l.id as id, l.iterable as iterable, l.file as file from ranges as l join "syntax-child" as r on l.element = r.parent where r.field = "start";
let started_spans = select l.iterable as id, l.file as file, r.span as span from started as l join "syntax-tree" as r on l.iterable = r.id;
let whole = antijoin(left=unbroken, right=started, left-on=["id"], right-on=["id"]);
let whole_spans = select l.iterable as id, l.file as file, r.span as span from whole as l join fors as r on l.id = r.id;
let candidates = union(left=started_spans, right=whole_spans);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:single_element_loop|complexity|all))\s*(?:,|$)");
emit violations subject file key(span);
