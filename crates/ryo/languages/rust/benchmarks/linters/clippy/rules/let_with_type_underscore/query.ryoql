import lint_attributes from "rust/clippy/lint-attributes";
let statements = select id, file, span from "syntax-tree" where kind = "let-stmt";
let inferred = select id from "syntax-tree" where kind = "infer-type";
let annotations = select l.parent as statement, l.child as id from "syntax-child" as l join inferred as r on l.child = r.id where l.field = "ty";
let keywords = select l.parent as statement, r.span as keyword from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "let-kw";
let annotated = select r.id as id, l.file as file, l.span as span, l.id as statement from statements as l join annotations as r on l.id = r.statement;
let headed = select l.id as id, l.file as file, l.span as span, r.keyword as keyword from annotated as l join keywords as r on l.statement = r.statement;
let written = span-between(from=headed, start="keyword", end="span", output="reported");
let candidates = select id, file, reported as span from written;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:let_with_type_underscore|complexity|all))\s*(?:,|$)");
emit violations subject file key(id);
