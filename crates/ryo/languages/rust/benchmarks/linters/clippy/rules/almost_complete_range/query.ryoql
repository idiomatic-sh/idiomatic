import lint_attributes from "rust/clippy/lint-attributes";
let tokens = select id, file, text from "syntax-tree" where kind = "char" or kind = "byte";
let lower_starts = select id, file from tokens where matches(text, "^b?'(?:a|\\x61|\\u\{[0_]*6_*1_*\})'$");
let lower_ends = select id, file from tokens where matches(text, "^b?'(?:z|\\x7[aA]|\\u\{[0_]*7_*[aA]_*\})'$");
let upper_starts = select id, file from tokens where matches(text, "^b?'(?:A|\\x41|\\u\{[0_]*4_*1_*\})'$");
let upper_ends = select id, file from tokens where matches(text, "^b?'(?:Z|\\x5[aA]|\\u\{[0_]*5_*[aA]_*\})'$");
let digit_starts = select id, file from tokens where matches(text, "^b?'(?:0|\\x30|\\u\{[0_]*3_*0_*\})'$");
let digit_ends = select id, file from tokens where matches(text, "^b?'(?:9|\\x39|\\u\{[0_]*3_*9_*\})'$");
let lower_start_pairs = extend(from=lower_starts, values={pair: 1});
let upper_start_pairs = extend(from=upper_starts, values={pair: 2});
let digit_start_pairs = extend(from=digit_starts, values={pair: 3});
let lower_end_pairs = extend(from=lower_ends, values={pair: 1});
let upper_end_pairs = extend(from=upper_ends, values={pair: 2});
let digit_end_pairs = extend(from=digit_ends, values={pair: 3});
let letter_start_tokens = union(left=lower_start_pairs, right=upper_start_pairs);
let start_tokens = union(left=letter_start_tokens, right=digit_start_pairs);
let letter_end_tokens = union(left=lower_end_pairs, right=upper_end_pairs);
let end_tokens = union(left=letter_end_tokens, right=digit_end_pairs);
let literals = select id from "syntax-tree" where kind = "literal";
let literal_tokens = select l.parent as literal, l.child as token from "syntax-child" as l join literals as r on l.parent = r.id;
let start_literals = select l.literal as literal, r.pair as pair from literal_tokens as l join start_tokens as r on l.token = r.id;
let end_literals = select l.literal as literal, r.pair as pair from literal_tokens as l join end_tokens as r on l.token = r.id;
let wrappers = select id from "syntax-tree" where kind = "paren-expr" or kind = "literal-pat";
let wrapped_kinds = select id from "syntax-tree" where kind = "paren-expr" or kind = "literal";
let wrapper_edges = select l.parent as parent, l.child as child from "syntax-child" as l join wrappers as r on l.parent = r.id;
let wrapping_edges = select l.parent as parent, l.child as child from wrapper_edges as l join wrapped_kinds as r on l.child = r.id;
let wrapping = closure(edges=wrapping_edges, source="parent", destination="child");
let wrapped_starts = select l.parent as bound, r.pair as pair from wrapping as l join start_literals as r on l.child = r.literal;
let bare_starts = select literal as bound, pair from start_literals;
let start_bounds = union(left=bare_starts, right=wrapped_starts);
let wrapped_ends = select l.parent as bound, r.pair as pair from wrapping as l join end_literals as r on l.child = r.literal;
let bare_ends = select literal as bound, pair from end_literals;
let end_bounds = union(left=bare_ends, right=wrapped_ends);
let ranges = select id, file, span from "syntax-tree" where kind = "range-expr" or kind = "range-pat";
let half_open = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "dot2";
let half_open_ranges = select l.id as id, l.file as file, l.span as span from ranges as l join half_open as r on l.id = r.id;
let range_children = select l.id as id, l.file as file, l.span as span, r.child as child, r.ordinal as ordinal from half_open_ranges as l join "syntax-child" as r on l.id = r.parent;
let range_starts = select l.id as id, l.file as file, l.span as span, l.ordinal as ordinal, r.pair as pair from range_children as l join start_bounds as r on l.child = r.bound;
let range_ends = select l.parent as id, l.ordinal as ordinal, r.pair as pair from "syntax-child" as l join end_bounds as r on l.child = r.bound;
let incomplete = select l.id as id, l.file as file, l.span as span from range_starts as l join range_ends as r on l.id = r.id and l.pair = r.pair where l.ordinal < r.ordinal;
let candidates = project(from=incomplete, columns=["id", "file", "span"]);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:almost_complete_range|suspicious|all))\s*(?:,|$)");
emit violations subject file key(id);
