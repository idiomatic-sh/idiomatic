import lint_attributes from "rust/clippy/lint-attributes";
import item_heads from "rust/clippy/item-heads";
let fns = select id, file from "syntax-tree" where kind = "fn";
let fn_children = select l.parent as id, l.child as child, l.field as field, l.ordinal as ordinal, l.file as file from "syntax-child" as l join fns as r on l.parent = r.id;
let lists = select id, child as list, file from fn_children where field = "param-list";
let inputs = select l.id as id, r.child as input, l.file as file from lists as l join "syntax-child" as r on l.list = r.parent where r.field = "params";
let counted = group-count(from=inputs, keys=["id", "file"], count="inputs");
let crowded = select id, file from counted where inputs > 7;
let abis = select id, child as abi, file from fn_children where field = "abi";
let abi_strings = select l.id as id, l.file as file, r.child as string from abis as l join "syntax-child" as r on l.abi = r.parent;
let rust_abis = select l.id as id, l.file as file from abi_strings as l join "syntax-tree" as r on l.string = r.id where r.kind = "string" and matches(r.text, "^\x22Rust\x22$");
let abi_fns = select id, file from abis;
let foreign = antijoin(left=abi_fns, right=rust_abis, left-on=["id"], right-on=["id"]);
let impl_traits = select l.parent as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "for-kw";
let impl_lists = select l.child as id, l.file as file from "syntax-child" as l join impl_traits as r on l.parent = r.id where l.field = "assoc-item-list";
let implementations = select l.child as id, l.file as file from "syntax-child" as l join impl_lists as r on l.parent = r.id;
let extern_lists = select id, file from "syntax-tree" where kind = "extern-item-list";
let declarations = select l.child as id, l.file as file from "syntax-child" as l join extern_lists as r on l.parent = r.id;
let inherited = union(left=implementations, right=declarations);
let skipped = union(left=foreign, right=inherited);
let checked = antijoin(left=crowded, right=skipped, left-on=["id"], right-on=["id"]);
let bodied = select id, file from fn_children where field = "body";
let signature_parts = select id, child, ordinal, file from fn_children where field = "param-list" or field = "ret-type";
let clauses = select id, child, ordinal, file from fn_children where field = "where-clause";
let where_clauses = select l.id as id, l.child as child, l.ordinal as ordinal, l.file as file from clauses as l join bodied as r on l.id = r.id;
let ends = union(left=signature_parts, right=where_clauses);
let earlier_ends = select l.id as id, l.child as child, l.file as file from ends as l join ends as r on l.id = r.id where l.ordinal < r.ordinal;
let last_ends = antijoin(left=ends, right=earlier_ends, left-on=["child"], right-on=["child"]);
let heads = item_heads(items=checked);
let starts = select id, file, span from heads;
let bounds = select l.id as id, l.file as file, l.span as start, r.child as finish_node from starts as l join last_ends as r on l.id = r.id;
let bounded = select l.id as id, l.file as file, l.start as start, r.span as finish from bounds as l join "syntax-tree" as r on l.finish_node = r.id;
let spanned = span-between(from=bounded, start="start", end="finish", output="span");
let candidates = select r.child as id, l.file as file, l.span as span from spanned as l join "syntax-child" as r on l.id = r.parent where r.field = "name";
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:too_many_arguments|complexity|all))\s*(?:,|$)");
emit violations subject file key(span);
