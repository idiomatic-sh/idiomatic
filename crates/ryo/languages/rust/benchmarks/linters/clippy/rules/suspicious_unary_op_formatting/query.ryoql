import lint_attributes from "rust/clippy/lint-attributes";
import operator_before_unary from "rust/clippy/operator-before-unary";
let found = operator_before_unary();
let binary = select id, file, span, gap from found where operator = "+" or operator = "-" or operator = "*" or operator = "/" or operator = "%" or operator = "^" or operator = "&" or operator = "|" or operator = "&&" or operator = "||" or operator = "<<" or operator = ">>" or operator = "==" or operator = "!=" or operator = "<" or operator = "<=" or operator = ">" or operator = ">=";
let candidates = select id, file, span from binary where ends_with(gap, " ");
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:suspicious_unary_op_formatting|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
