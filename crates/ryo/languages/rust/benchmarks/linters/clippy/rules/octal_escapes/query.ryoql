import lint_attributes from "rust/clippy/lint-attributes";
let tokens = select id, file, span, text from "syntax-tree" where kind = "string" or kind = "byte-string" or kind = "c-string";
let hosts = select id, file from "syntax-tree" where kind = "literal" or kind = "macro-call" or kind = "macro-rules" or kind = "macro-def" or kind = "attr";
let hosted = axis(from=tokens, relation="syntax-child", direction=nearest-ancestor, domain=hosts);
let readers = select id, file from "syntax-tree" where kind = "literal" or kind = "macro-call";
let strings = select l.id as id, l.file as file, l.span as span, l.text as text from hosted as l join readers as r on l.related = r.id;
let cooked = select id, file, span, text from strings where matches(text, "^[bc]?\x22");
let calls = select id, file from "syntax-tree" where kind = "macro-call";
let call_children = select l.parent as call, l.child as child, l.file as file from "syntax-child" as l join calls as r on l.parent = r.id;
let call_paths = select l.call as call, r.id as id, r.file as file, r.span as span from call_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "path";
let format_paths = source-matches(from=call_paths, span="span", pattern="(?:\A|:)\s*(?:format|print|println|eprint|eprintln|write|writeln|panic|unreachable|todo|unimplemented|assert|debug_assert|assert_eq|assert_ne|debug_assert_eq|debug_assert_ne|format_args)\s*\z", output="name");
let format_calls = select call, file from format_paths;
let format_children = select l.call as call, l.child as child, l.file as file from call_children as l join format_calls as r on l.call = r.call;
let format_trees = select l.child as tree, l.file as file from format_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "token-tree";
let tree_strings = select l.parent as tree, l.child as id, l.ordinal as ordinal, l.file as file from "syntax-child" as l join cooked as r on l.child = r.id;
let format_strings = select l.tree as tree, l.id as id, l.ordinal as ordinal, l.file as file from tree_strings as l join format_trees as r on l.tree = r.tree;
let later_strings = select l.tree as tree, l.id as id, l.ordinal as ordinal, l.file as file from format_strings as l join format_strings as r on l.tree = r.tree where r.ordinal < l.ordinal;
let templates = antijoin(left=format_strings, right=later_strings, left-on=["id"], right-on=["id"]);
let read = antijoin(left=cooked, right=templates, left-on=["id"], right-on=["id"]);
let escapes = source-matches(from=read, span="span", pattern="(?P<octal>\\0[0-7]{1,2})|\\[\s\S]", output="found", capture="octal", capture-output="escape");
let candidates = select id, file, escape as span from escapes;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:octal_escapes|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
