import lint_attributes from "rust/clippy/lint-attributes";
let ranges = select id, file from "syntax-tree" where kind = "range-expr";
let parens = select id, file, span from "syntax-tree" where kind = "paren-expr";
let range_ends = select l.child as id, l.field as field, l.file as file from "syntax-child" as l join ranges as r on l.parent = r.id where l.field = "start" or l.field = "end";
let paren_ends = select l.id as id, l.field as field, r.span as span, l.file as file from range_ends as l join parens as r on l.id = r.id;
let inner_parens = select l.parent as parent, l.child as child, l.file as file from "syntax-child" as l join parens as r on l.child = r.id where l.field = "expr";
let paren_chain = select l.parent as parent, l.child as child, l.file as file from inner_parens as l join parens as r on l.parent = r.id;
let deep = closure(edges=paren_chain, source="parent", destination="child", keys=["file"]);
let deep_rows = select parent, child, file from deep;
let selves = select id as parent, id as child, file from paren_ends;
let reaches = union(left=selves, right=deep_rows);
let literals = select id, file from "syntax-tree" where kind = "literal";
let paren_literals = select l.parent as paren, l.child as literal, l.file as file from "syntax-child" as l join literals as r on l.child = r.id where l.field = "expr";
let peeled = select l.parent as id, r.literal as literal, l.file as file from reaches as l join paren_literals as r on l.child = r.paren;
let found = select l.id as id, l.field as field, l.span as span, r.literal as literal, l.file as file from paren_ends as l join peeled as r on l.id = r.id;
let float_tokens = select l.parent as literal, r.text as text, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "float-number";
let suffixed = select literal, file from float_tokens where matches(text, "f(?:16|32|64|128)$");
let floats = select literal, file from float_tokens;
let plain_floats = difference(left=floats, right=suffixed);
let starts = select id, literal, file from found where field = "start";
let float_starts = select l.id as id, l.file as file from starts as l join plain_floats as r on l.literal = r.literal;
let kept = antijoin(left=found, right=float_starts, left-on=["id"], right-on=["id"]);
let candidates = select id, file, span from kept;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:needless_parens_on_range_literals|style|all))\s*(?:,|$)");
emit violations subject file key(span);
