import lint_attributes from "rust/clippy/lint-attributes";
import attribute_owners from "rust/clippy/attribute-owners";
import attribute_items from "rust/clippy/attribute-items";
let attributes = select id, file, span from "syntax-tree" where kind = "attr";
let attribute_ids = select id, file from attributes;
let owned_rows = attribute_owners(elements=attribute_ids);
let owned = select id as attribute, owner, file from owned_rows;
let attribute_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from owned as l join "syntax-child" as r on l.attribute = r.parent;
let metas = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from attribute_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta" or r.kind = "unsafe-meta";
let unsafe_metas = select attribute, owner, meta, file from metas where kind = "unsafe-meta";
let unsafe_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from unsafe_metas as l join "syntax-child" as r on l.meta = r.parent;
let unwrapped = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from unsafe_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta";
let plain = select attribute, owner, meta, kind, file from metas where kind != "unsafe-meta";
let effective = union(left=plain, right=unwrapped);
let meta_children = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.child as child, l.file as file from effective as l join "syntax-child" as r on l.meta = r.parent;
let meta_paths = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.span as span, l.file as file from meta_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "path";
let path_texts = source-matches(from=meta_paths, span="span", pattern="\A(?P<path>[\s\S]*)\z", output="whole", capture="path", capture-output="path_span", capture-text-output="path_written");
let spelled = replace(from=path_texts, text="path_written", pattern="\s+", replacement="", output="spelled");
let named = replace(from=spelled, text="spelled", pattern="\br#", replacement="", output="name");
let checked = select attribute, owner, meta, kind, name, file from named where name != "doc" and name != "rustc_on_unimplemented" and name != "reason";
let top_words = select attribute, owner, name as key, file from checked where kind = "path-meta";
let pairs = select attribute, owner, meta, name, file from checked where kind = "key-value-meta";
let pair_children = select l.attribute as attribute, l.owner as owner, l.name as name, r.child as value, l.file as file from pairs as l join "syntax-child" as r on l.meta = r.parent;
let pair_literals = select l.attribute as attribute, l.owner as owner, l.name as name, l.value as value, l.file as file from pair_children as l join "syntax-tree" as r on l.value = r.id where r.kind = "literal";
let pair_strings = select l.attribute as attribute, l.owner as owner, l.name as key, r.value as value, l.file as file from pair_literals as l join "string-literal" as r on l.value = r.occurrence;
let pair_others = antijoin(left=pair_literals, right=pair_strings, left-on=["attribute"], right-on=["attribute"]);
let pair_words = select attribute, owner, name as key, file from pair_others;
let top_plain = union(left=top_words, right=pair_words);
let top_plain_spans = select l.attribute as attribute, l.owner as owner, l.key as key, r.span as span, l.file as file from top_plain as l join attributes as r on l.attribute = r.id;
let top_plain_bounded = span-bounds(from=top_plain_spans, span="span", start-output="begin", end-output="finish");
let top_plain_later = select l.attribute as attribute, l.file as file, l.span as span from top_plain_bounded as l join top_plain_bounded as r on l.owner = r.owner and l.key = r.key where r.begin < l.begin;
let top_string_spans = select l.attribute as attribute, l.owner as owner, l.key as key, l.value as value, r.span as span, l.file as file from pair_strings as l join attributes as r on l.attribute = r.id;
let top_string_bounded = span-bounds(from=top_string_spans, span="span", start-output="begin", end-output="finish");
let top_string_later = select l.attribute as attribute, l.file as file, l.span as span from top_string_bounded as l join top_string_bounded as r on l.owner = r.owner and l.key = r.key and l.value = r.value where r.begin < l.begin;
let top_later = union(left=top_plain_later, right=top_string_later);
let lists = select l.attribute as attribute, l.owner as owner, l.name as parent, r.child as child, l.file as file from checked as l join "syntax-child" as r on l.meta = r.parent where l.kind = "token-tree-meta";
let list_trees = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.child as tree, l.file as file from lists as l join "syntax-tree" as r on l.child = r.id where r.kind = "token-tree";
let items = attribute_items(attributes=attribute_ids);
let named_items = select tree, item, name, shape, token, inner, extent, begin, file from items where name != "doc" and name != "rustc_on_unimplemented" and name != "reason";
let first_named = select l.attribute as attribute, l.owner as owner, l.parent as parent, r.item as item, r.name as name, r.shape as shape, r.token as token, r.inner as inner, r.extent as extent, r.begin as begin, l.file as file from list_trees as l join named_items as r on l.tree = r.tree;
let first_plain = select attribute, owner, parent, name, extent, begin, file from first_named where shape = 0 or shape = 3;
let first_plain_later = select l.attribute as attribute, l.file as file, l.extent as span from first_plain as l join first_plain as r on l.owner = r.owner and l.parent = r.parent and l.name = r.name where r.begin < l.begin;
let first_string_rows = select attribute, owner, parent, name, token, extent, begin, file from first_named where shape = 2;
let first_strings = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.name as name, r.value as value, l.extent as extent, l.begin as begin, l.file as file from first_string_rows as l join "string-literal" as r on l.token = r.occurrence;
let first_string_later = select l.attribute as attribute, l.file as file, l.extent as span from first_strings as l join first_strings as r on l.owner = r.owner and l.parent = r.parent and l.name = r.name and l.value = r.value where r.begin < l.begin;
let first_lists = select attribute, owner, parent, name as middle, inner as tree, file from first_named where shape = 1;
let second_named = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.middle as middle, r.name as name, r.shape as shape, r.token as token, r.extent as extent, r.begin as begin, l.file as file from first_lists as l join named_items as r on l.tree = r.tree;
let second_plain = select attribute, owner, parent, middle, name, extent, begin, file from second_named where shape = 0 or shape = 3;
let second_plain_later = select l.attribute as attribute, l.file as file, l.extent as span from second_plain as l join second_plain as r on l.owner = r.owner and l.parent = r.parent and l.middle = r.middle and l.name = r.name where r.begin < l.begin;
let second_string_rows = select attribute, owner, parent, middle, name, token, extent, begin, file from second_named where shape = 2;
let second_strings = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.middle as middle, l.name as name, r.value as value, l.extent as extent, l.begin as begin, l.file as file from second_string_rows as l join "string-literal" as r on l.token = r.occurrence;
let second_string_later = select l.attribute as attribute, l.file as file, l.extent as span from second_strings as l join second_strings as r on l.owner = r.owner and l.parent = r.parent and l.middle = r.middle and l.name = r.name and l.value = r.value where r.begin < l.begin;
let first_later = union(left=first_plain_later, right=first_string_later);
let second_later = union(left=second_plain_later, right=second_string_later);
let nested_later = union(left=first_later, right=second_later);
let later = union(left=top_later, right=nested_later);
let candidates = select attribute as id, file, span from later;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:duplicated_attributes|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
