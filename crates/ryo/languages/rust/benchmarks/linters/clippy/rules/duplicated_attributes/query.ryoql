import lint_attributes from "rust/clippy/lint-attributes";
import attribute_owners from "rust/clippy/attribute-owners";
let attributes = select id, file, span from "syntax-tree" where kind = "attr";
let attribute_ids = select id, file from attributes;
let owned_rows = attribute_owners(elements=attribute_ids);
let owned = select id as attribute, owner, file from owned_rows;
let attribute_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from owned as l join "syntax-child" as r on l.attribute = r.parent;
let metas = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from attribute_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta" or r.kind = "unsafe-meta";
let unsafe_metas = select attribute, owner, meta, file from metas where kind = "unsafe-meta";
let unsafe_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from unsafe_metas as l join "syntax-child" as r on l.meta = r.parent;
let unwrapped = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from unsafe_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta";
let plain = select attribute, owner, meta, kind, file from metas where kind != "unsafe-meta";
let effective = union(left=plain, right=unwrapped);
let meta_children = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.child as child, l.file as file from effective as l join "syntax-child" as r on l.meta = r.parent;
let meta_paths = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.span as span, l.file as file from meta_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "path";
let path_texts = source-matches(from=meta_paths, span="span", pattern="\A(?P<path>[\s\S]*)\z", output="whole", capture="path", capture-output="path_span", capture-text-output="path_written");
let named = replace(from=path_texts, text="path_written", pattern="\s+", replacement="", output="name");
let checked = select attribute, owner, meta, kind, name, file from named where name != "doc" and name != "rustc_on_unimplemented" and name != "reason";
let top_words = select attribute, owner, name as key, file from checked where kind = "path-meta";
let pairs = select attribute, owner, meta, name, file from checked where kind = "key-value-meta";
let pair_children = select l.attribute as attribute, l.owner as owner, l.name as name, r.child as value, l.file as file from pairs as l join "syntax-child" as r on l.meta = r.parent;
let pair_literals = select l.attribute as attribute, l.owner as owner, l.name as name, l.value as value, l.file as file from pair_children as l join "syntax-tree" as r on l.value = r.id where r.kind = "literal";
let pair_strings = select l.attribute as attribute, l.owner as owner, l.name as key, r.value as value, l.file as file from pair_literals as l join "string-literal" as r on l.value = r.occurrence;
let pair_others = antijoin(left=pair_literals, right=pair_strings, left-on=["attribute"], right-on=["attribute"]);
let pair_words = select attribute, owner, name as key, file from pair_others;
let top_plain = union(left=top_words, right=pair_words);
let top_plain_spans = select l.attribute as attribute, l.owner as owner, l.key as key, r.span as span, l.file as file from top_plain as l join attributes as r on l.attribute = r.id;
let top_plain_bounded = span-bounds(from=top_plain_spans, span="span", start-output="begin", end-output="finish");
let top_plain_later = select l.attribute as attribute, l.file as file, l.span as span from top_plain_bounded as l join top_plain_bounded as r on l.owner = r.owner and l.key = r.key where r.begin < l.begin;
let top_string_spans = select l.attribute as attribute, l.owner as owner, l.key as key, l.value as value, r.span as span, l.file as file from pair_strings as l join attributes as r on l.attribute = r.id;
let top_string_bounded = span-bounds(from=top_string_spans, span="span", start-output="begin", end-output="finish");
let top_string_later = select l.attribute as attribute, l.file as file, l.span as span from top_string_bounded as l join top_string_bounded as r on l.owner = r.owner and l.key = r.key and l.value = r.value where r.begin < l.begin;
let top_later = union(left=top_plain_later, right=top_string_later);
let lists = select l.attribute as attribute, l.owner as owner, l.name as parent, r.child as child, l.file as file from checked as l join "syntax-child" as r on l.meta = r.parent where l.kind = "token-tree-meta";
let list_trees = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.child as tree, l.file as file from lists as l join "syntax-tree" as r on l.child = r.id where r.kind = "token-tree";
let tree_nodes = select id, file from "syntax-tree" where kind = "token-tree";
let attribute_trees = axis(from=tree_nodes, relation="syntax-child", direction=nearest-ancestor, domain=attribute_ids);
let trees = select id as tree, related as attribute, file from attribute_trees;
let slots = select l.tree as tree, l.attribute as attribute, r.child as child, r.ordinal as ordinal, l.file as file from trees as l join "syntax-child" as r on l.tree = r.parent;
let significant = select l.tree as tree, l.attribute as attribute, l.child as child, l.ordinal as ordinal, r.kind as kind, r.text as text, r.span as span, l.file as file from slots as l join "syntax-tree" as r on l.child = r.id where r.kind != "whitespace" and r.kind != "comment";
let unread_openers = select attribute from significant where kind = "l-brack" or kind = "l-curly";
let separators = select tree, child as separator, ordinal as at, file from significant where kind = "l-paren" or kind = "comma";
let members = select tree, attribute, child, ordinal, kind, text, span, file from significant where kind != "l-paren" and kind != "r-paren" and kind != "comma";
let preceding = select l.child as child, r.separator as separator, r.at as at, l.file as file from members as l join separators as r on l.tree = r.tree where r.at < l.ordinal;
let farther = select l.child as child, l.separator as separator from preceding as l join preceding as r on l.child = r.child where r.at > l.at;
let nearest = antijoin(left=preceding, right=farther, left-on=["child", "separator"], right-on=["child", "separator"]);
let placed = select l.tree as tree, l.attribute as attribute, l.child as child, l.ordinal as ordinal, l.kind as kind, l.text as text, l.span as span, r.separator as item, l.file as file from members as l join nearest as r on l.child = r.child;
let path_members = select tree, attribute, child, ordinal, span, item, file from placed where kind = "ident" or kind = "colon" or kind = "self-kw" or kind = "super-kw" or kind = "crate-kw";
let tails = antijoin(left=placed, right=path_members, left-on=["child"], right-on=["child"]);
let literal_members = select child from placed where kind = "string" or kind = "byte-string" or kind = "c-string" or kind = "char" or kind = "byte" or kind = "int-number" or kind = "float-number" or kind = "true-kw" or kind = "false-kw";
let later_tails = select l.child as child from tails as l join tails as r on l.item = r.item where r.ordinal < l.ordinal;
let first_tails = antijoin(left=tails, right=later_tails, left-on=["child"], right-on=["child"]);
let second_tails = antijoin(left=tails, right=first_tails, left-on=["child"], right-on=["child"]);
let tail_counts = group-count(from=tails, keys=["item", "file"], count="tails");
let trailing_paths = select l.item as item from path_members as l join first_tails as r on l.item = r.item where l.ordinal > r.ordinal;
let pathed = project(from=path_members, columns=["tree", "attribute", "item", "file"]);
let headed = antijoin(left=pathed, right=trailing_paths, left-on=["item"], right-on=["item"]);
let words = antijoin(left=headed, right=tails, left-on=["item"], right-on=["item"]);
let single_tails = select l.item as item, l.kind as kind, l.child as child from first_tails as l join tail_counts as r on l.item = r.item where r.tails = 1;
let list_tails = select l.tree as tree, l.attribute as attribute, l.item as item, r.child as child, l.file as file from headed as l join single_tails as r on l.item = r.item where r.kind = "token-tree";
let double_tails = select l.item as item, l.child as child from first_tails as l join tail_counts as r on l.item = r.item where r.tails = 2 and l.kind = "eq";
let literal_seconds = select l.item as item, r.child as child, r.kind as kind, r.text as text from double_tails as l join second_tails as r on l.item = r.item;
let literal_tails = select l.item as item, l.kind as kind, l.text as text from literal_seconds as l join literal_members as r on l.child = r.child;
let valued = select l.tree as tree, l.attribute as attribute, l.item as item, r.kind as kind, r.text as text, l.file as file from headed as l join literal_tails as r on l.item = r.item;
let bare_literals = select l.item as item from single_tails as l join literal_members as r on l.child = r.child;
let bare_items = antijoin(left=bare_literals, right=pathed, left-on=["item"], right-on=["item"]);
let read_words = select item from words;
let read_lists = select item from list_tails;
let read_values = select item from valued;
let read_some = union(left=read_words, right=read_lists);
let read_more = union(left=read_some, right=read_values);
let read_items = union(left=read_more, right=bare_items);
let unread_items = antijoin(left=placed, right=read_items, left-on=["item"], right-on=["item"]);
let unread_item_attributes = select attribute from unread_items;
let member_after = select l.attribute as attribute, l.child as child, l.kind as kind, r.child as next, r.ordinal as next_at, r.kind as next_kind from placed as l join placed as r on l.item = r.item where r.ordinal > l.ordinal;
let member_beyond = select l.child as child, l.next as next from member_after as l join member_after as r on l.child = r.child where r.next_at < l.next_at;
let adjacent = antijoin(left=member_after, right=member_beyond, left-on=["child", "next"], right-on=["child", "next"]);
let joined_segments = select attribute from adjacent where (kind = "ident" or kind = "self-kw" or kind = "super-kw" or kind = "crate-kw") and (next_kind = "ident" or next_kind = "self-kw" or next_kind = "super-kw" or next_kind = "crate-kw");
let colon_pairs = select child, next from adjacent where kind = "colon" and next_kind = "colon";
let paired_firsts = select child from colon_pairs;
let paired_seconds = select next as child from colon_pairs;
let paired = union(left=paired_firsts, right=paired_seconds);
let colons = select attribute, child from placed where kind = "colon";
let lone_colons = antijoin(left=colons, right=paired, left-on=["child"], right-on=["child"]);
let lone_colon_attributes = select attribute from lone_colons;
let unread_paths = union(left=joined_segments, right=lone_colon_attributes);
let unread_shapes = union(left=unread_item_attributes, right=unread_openers);
let unread = union(left=unread_shapes, right=unread_paths);
let path_later = select l.child as child from path_members as l join path_members as r on l.item = r.item where r.ordinal < l.ordinal;
let path_earlier = select l.child as child from path_members as l join path_members as r on l.item = r.item where r.ordinal > l.ordinal;
let path_firsts = antijoin(left=path_members, right=path_later, left-on=["child"], right-on=["child"]);
let path_lasts = antijoin(left=path_members, right=path_earlier, left-on=["child"], right-on=["child"]);
let path_ends = select l.item as item, l.span as first_span, r.span as last_span, l.file as file from path_firsts as l join path_lasts as r on l.item = r.item;
let path_spans = span-between(from=path_ends, start="first_span", end="last_span", output="path_span");
let path_written = source-matches(from=path_spans, span="path_span", pattern="\A(?P<path>[\s\S]*)\z", output="whole", capture="path", capture-output="written_span", capture-text-output="path_text");
let path_names = replace(from=path_written, text="path_text", pattern="\s+", replacement="", output="name");
let member_later = select l.child as child from placed as l join placed as r on l.item = r.item where r.ordinal < l.ordinal;
let member_earlier = select l.child as child from placed as l join placed as r on l.item = r.item where r.ordinal > l.ordinal;
let member_firsts = antijoin(left=placed, right=member_later, left-on=["child"], right-on=["child"]);
let member_lasts = antijoin(left=placed, right=member_earlier, left-on=["child"], right-on=["child"]);
let item_ends = select l.tree as tree, l.item as item, l.span as first_span, r.span as last_span, l.file as file from member_firsts as l join member_lasts as r on l.item = r.item;
let item_extents = span-between(from=item_ends, start="first_span", end="last_span", output="extent");
let item_bounds = span-bounds(from=item_extents, span="extent", start-output="begin", end-output="finish");
let named_items = select l.tree as tree, l.item as item, r.name as name, l.extent as extent, l.begin as begin, l.file as file from item_bounds as l join path_names as r on l.item = r.item where r.name != "doc" and r.name != "rustc_on_unimplemented" and r.name != "reason";
let string_items = select item, text as value from valued where kind = "string";
let other_values = select item from valued where kind != "string";
let word_items = select item from words;
let plain_items = union(left=word_items, right=other_values);
let read_trees = antijoin(left=list_trees, right=unread, left-on=["attribute"], right-on=["attribute"]);
let first_named = select l.attribute as attribute, l.owner as owner, l.parent as parent, r.item as item, r.name as name, r.extent as extent, r.begin as begin, l.file as file from read_trees as l join named_items as r on l.tree = r.tree;
let first_plain = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.name as name, l.extent as extent, l.begin as begin, l.file as file from first_named as l join plain_items as r on l.item = r.item;
let first_plain_later = select l.attribute as attribute, l.file as file, l.extent as span from first_plain as l join first_plain as r on l.owner = r.owner and l.parent = r.parent and l.name = r.name where r.begin < l.begin;
let first_strings = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.name as name, r.value as value, l.extent as extent, l.begin as begin, l.file as file from first_named as l join string_items as r on l.item = r.item;
let first_string_later = select l.attribute as attribute, l.file as file, l.extent as span from first_strings as l join first_strings as r on l.owner = r.owner and l.parent = r.parent and l.name = r.name and l.value = r.value where r.begin < l.begin;
let first_lists = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.name as middle, r.child as tree, l.file as file from first_named as l join list_tails as r on l.item = r.item;
let second_named = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.middle as middle, r.item as item, r.name as name, r.extent as extent, r.begin as begin, l.file as file from first_lists as l join named_items as r on l.tree = r.tree;
let second_plain = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.middle as middle, l.name as name, l.extent as extent, l.begin as begin, l.file as file from second_named as l join plain_items as r on l.item = r.item;
let second_plain_later = select l.attribute as attribute, l.file as file, l.extent as span from second_plain as l join second_plain as r on l.owner = r.owner and l.parent = r.parent and l.middle = r.middle and l.name = r.name where r.begin < l.begin;
let second_strings = select l.attribute as attribute, l.owner as owner, l.parent as parent, l.middle as middle, l.name as name, r.value as value, l.extent as extent, l.begin as begin, l.file as file from second_named as l join string_items as r on l.item = r.item;
let second_string_later = select l.attribute as attribute, l.file as file, l.extent as span from second_strings as l join second_strings as r on l.owner = r.owner and l.parent = r.parent and l.middle = r.middle and l.name = r.name and l.value = r.value where r.begin < l.begin;
let first_later = union(left=first_plain_later, right=first_string_later);
let second_later = union(left=second_plain_later, right=second_string_later);
let nested_later = union(left=first_later, right=second_later);
let later = union(left=top_later, right=nested_later);
let candidates = select attribute as id, file, span from later;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:duplicated_attributes|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
