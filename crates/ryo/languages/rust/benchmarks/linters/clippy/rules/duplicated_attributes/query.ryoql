import lint_attributes from "rust/clippy/lint-attributes";
import attribute_owners from "rust/clippy/attribute-owners";
let attributes = select id, file, span from "syntax-tree" where kind = "attr";
let attribute_ids = select id, file from attributes;
let owned_rows = attribute_owners(elements=attribute_ids);
let owned = select id as attribute, owner, file from owned_rows;
let attribute_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from owned as l join "syntax-child" as r on l.attribute = r.parent;
let metas = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from attribute_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta" or r.kind = "unsafe-meta";
let unsafe_metas = select attribute, owner, meta, file from metas where kind = "unsafe-meta";
let unsafe_children = select l.attribute as attribute, l.owner as owner, r.child as meta, l.file as file from unsafe_metas as l join "syntax-child" as r on l.meta = r.parent;
let unwrapped = select l.attribute as attribute, l.owner as owner, l.meta as meta, r.kind as kind, l.file as file from unsafe_children as l join "syntax-tree" as r on l.meta = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta";
let plain = select attribute, owner, meta, kind, file from metas where kind != "unsafe-meta";
let effective = union(left=plain, right=unwrapped);
let meta_children = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.child as child, l.file as file from effective as l join "syntax-child" as r on l.meta = r.parent;
let meta_paths = select l.attribute as attribute, l.owner as owner, l.meta as meta, l.kind as kind, r.span as span, l.file as file from meta_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "path";
let path_texts = source-matches(from=meta_paths, span="span", pattern="\A(?P<path>[\s\S]*)\z", output="whole", capture="path", capture-output="path_span", capture-text-output="path_written");
let named = replace(from=path_texts, text="path_written", pattern="\s+", replacement="", output="name");
let checked = select attribute, owner, meta, kind, name, file from named where name != "doc" and name != "rustc_on_unimplemented" and name != "reason";
let meta_spans = select l.attribute as attribute, l.owner as owner, l.kind as kind, r.span as span, l.file as file from checked as l join "syntax-tree" as r on l.meta = r.id where l.kind = "path-meta" or l.kind = "key-value-meta";
let top_written = source-matches(from=meta_spans, span="span", pattern="\A(?P<key>(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:\s*::\s*(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*(?:\s*=\s*\x22(?:[^\x22\\]|\\.)*\x22)?)", output="found", capture="key", capture-output="key_span", capture-text-output="key_written");
let top_keyed = replace(from=top_written, text="key_written", pattern="\s+", replacement="", output="key");
let top_attributes = select l.attribute as attribute, l.owner as owner, l.key as key, r.span as span, l.file as file from top_keyed as l join attributes as r on l.attribute = r.id;
let top_bounded = span-bounds(from=top_attributes, span="span", start-output="begin", end-output="finish");
let top_later = select l.attribute as attribute, l.file as file, l.span as span from top_bounded as l join top_bounded as r on l.owner = r.owner and l.key = r.key where r.begin < l.begin;
let lists = select l.attribute as attribute, l.owner as owner, l.name as parent, r.child as child, l.file as file from checked as l join "syntax-child" as r on l.meta = r.parent where l.kind = "token-tree-meta";
let list_trees = select l.attribute as attribute, l.owner as owner, l.parent as parent, r.span as span, l.file as file from lists as l join "syntax-tree" as r on l.child = r.id where r.kind = "token-tree";
let first_items = source-matches(from=list_trees, span="span", pattern="[(,]\s*(?P<item>(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:\s*::\s*(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*(?:\s*=\s*(?:\x22(?:[^\x22\\]|\\.)*\x22|[^,()\s]+)|\s*\((?:[^()\x22]|\x22(?:[^\x22\\]|\\.)*\x22|\((?:[^()\x22]|\x22(?:[^\x22\\]|\\.)*\x22)*\))*\))?)", output="found", capture="item", capture-output="item_span", capture-text-output="item_text");
let first_written = source-matches(from=first_items, span="item_span", pattern="\A(?P<key>(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:\s*::\s*(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*(?:\s*=\s*\x22(?:[^\x22\\]|\\.)*\x22)?)", output="head", capture="key", capture-output="key_span", capture-text-output="key_written");
let first_keyed = replace(from=first_written, text="key_written", pattern="\s+", replacement="", output="key");
let first_lists = select attribute, owner, parent, key, item_span, file from first_keyed where matches(item_text, "^[^=(]*\(");
let first_list_items = select attribute, owner, parent, key, item_span, file from first_lists;
let first_words = antijoin(left=first_keyed, right=first_list_items, left-on=["attribute", "item_span"], right-on=["attribute", "item_span"]);
let first_keys = select attribute, owner, parent, key, item_span, file from first_words where not glob_any(key, "reason") and not glob_any(key, "reason=*");
let first_bounded = span-bounds(from=first_keys, span="item_span", start-output="begin", end-output="finish");
let first_later = select l.attribute as attribute, l.file as file, l.item_span as span from first_bounded as l join first_bounded as r on l.owner = r.owner and l.parent = r.parent and l.key = r.key where r.begin < l.begin;
let second_parents = select attribute, owner, parent, key as middle, item_span, file from first_lists where key != "doc" and key != "rustc_on_unimplemented" and key != "reason";
let second_items = source-matches(from=second_parents, span="item_span", pattern="[(,]\s*(?P<item>(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:\s*::\s*(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*(?:\s*=\s*(?:\x22(?:[^\x22\\]|\\.)*\x22|[^,()\s]+)|\s*\((?:[^()\x22]|\x22(?:[^\x22\\]|\\.)*\x22)*\))?)", output="found", capture="item", capture-output="inner_span", capture-text-output="inner_text");
let second_written = source-matches(from=second_items, span="inner_span", pattern="\A(?P<key>(?:r#)?[A-Za-z_][A-Za-z0-9_]*(?:\s*::\s*(?:r#)?[A-Za-z_][A-Za-z0-9_]*)*(?:\s*=\s*\x22(?:[^\x22\\]|\\.)*\x22)?)", output="head", capture="key", capture-output="key_span", capture-text-output="key_written");
let second_keyed = replace(from=second_written, text="key_written", pattern="\s+", replacement="", output="key");
let second_lists = select attribute, owner, parent, middle, key, inner_span, file from second_keyed where matches(inner_text, "^[^=(]*\(");
let second_words = select attribute, owner, parent, middle, key, inner_span, file from second_keyed where not glob_any(key, "reason") and not glob_any(key, "reason=*");
let second_keys = antijoin(left=second_words, right=second_lists, left-on=["attribute", "inner_span"], right-on=["attribute", "inner_span"]);
let second_bounded = span-bounds(from=second_keys, span="inner_span", start-output="begin", end-output="finish");
let second_later = select l.attribute as attribute, l.file as file, l.inner_span as span from second_bounded as l join second_bounded as r on l.owner = r.owner and l.parent = r.parent and l.middle = r.middle and l.key = r.key where r.begin < l.begin;
let nested_later = union(left=first_later, right=second_later);
let later = union(left=top_later, right=nested_later);
let candidates = select attribute as id, file, span from later;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:duplicated_attributes|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
