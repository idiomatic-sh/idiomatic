import lint_attributes from "rust/clippy/lint-attributes";
let tree = select id, file from "syntax-tree";
let ifs = select id, file from "syntax-tree" where kind = "if-expr";
let branches = select l.parent as id, l.child as branch, l.field as field, l.file as file from "syntax-child" as l join ifs as r on l.parent = r.id where l.field = "then-branch" or l.field = "else-branch";
let thens = select branch as id, id as owner, file from branches where field = "then-branch";
let elses = select l.branch as id, l.id as owner, r.kind as kind, l.file as file from branches as l join "syntax-tree" as r on l.branch = r.id where l.field = "else-branch";
let after_then = axis(from=thens, relation="syntax-child", direction=next-sibling, domain=tree);
let starts = select l.owner as owner, r.span as start, l.file as file from after_then as l join "syntax-tree" as r on l.related = r.id;
let before_else = axis(from=elses, relation="syntax-child", direction=previous-sibling, domain=tree);
let ends = select l.owner as owner, l.kind as kind, r.span as end, l.file as file from before_else as l join "syntax-tree" as r on l.related = r.id;
let bounded = select l.owner as id, r.kind as kind, l.start as start, r.end as end, l.file as file from starts as l join ends as r on l.owner = r.owner;
let gaps = span-between(from=bounded, start="start", end="end", output="gap");
let broken = source-matches(from=gaps, span="gap", pattern="\A\s*else\s*\n\s*\z", output="found");
let block_broken = select id, file, found from broken where kind = "block-expr";
let allman = source-matches(from=block_broken, span="found", pattern="\A[^\S\n]*\n[^\S\n]*else[^\S\n]*\n[^\S\n]*\z", output="allman_found");
let allman_rows = select id, file, found from allman;
let broken_rows = select id, file, found from broken;
let flagged = difference(left=broken_rows, right=allman_rows);
let candidates = select id, file, found as span from flagged;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:suspicious_else_formatting|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
