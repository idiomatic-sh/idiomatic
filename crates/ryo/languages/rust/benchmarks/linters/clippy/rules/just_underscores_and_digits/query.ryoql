import bindings from "rust/clippy/bindings";
import lint_attributes from "rust/clippy/lint-attributes";
let functions = select id, file from "syntax-tree" where kind = "fn";
let bodies = select l.parent as function, l.child as body from "syntax-child" as l join functions as r on l.parent = r.id where l.field = "body";
let traits = select id from "syntax-tree" where kind = "trait";
let trait_lists = select l.child as list from "syntax-child" as l join traits as r on l.parent = r.id;
let trait_methods = select l.child as function from "syntax-child" as l join trait_lists as r on l.parent = r.list;
let checked = antijoin(left=bodies, right=trait_methods, left-on=["function"], right-on=["function"]);
let lists = select l.function as function, r.child as list from checked as l join "syntax-child" as r on l.body = r.parent where r.field = "stmt-list";
let opens = select l.parent as list, l.child as open from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "l-curly";
let anchors = select l.function as function, r.open as anchor from lists as l join opens as r on l.list = r.list;
let parameter_lists = select l.function as function, r.child as list from checked as l join "syntax-child" as r on l.function = r.parent where r.field = "param-list";
let parameters = select l.function as function, r.child as parameter from parameter_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "params";
let parameter_roots = select l.function as function, r.child as root from parameters as l join "syntax-child" as r on l.parameter = r.parent where r.field = "pat";
let holders = select id, file from "syntax-tree" where kind = "let-stmt" or kind = "match-arm";
let items = select id from "syntax-tree" where kind = "fn" or kind = "const" or kind = "static" or kind = "struct" or kind = "enum" or kind = "union" or kind = "trait" or kind = "impl" or kind = "type-alias" or kind = "module" or kind = "extern-block";
let holder_items = axis(from=holders, relation="syntax-child", direction=nearest-ancestor, domain=items);
let held = select l.related as function, l.id as holder from holder_items as l join checked as r on l.related = r.function;
let holder_roots = select l.function as function, r.child as root from held as l join "syntax-child" as r on l.holder = r.parent where r.field = "pat";
let roots = union(left=parameter_roots, right=holder_roots);
let nodes = select id, kind from "syntax-tree" where kind != "whitespace" and kind != "comment" and kind != "pipe" and kind != "comma" and kind != "l-paren" and kind != "r-paren" and kind != "l-brack" and kind != "r-brack" and kind != "l-curly" and kind != "r-curly" and kind != "colon" and kind != "amp" and kind != "dot2";
let edges = select l.parent as parent, l.child as child, l.ordinal as ordinal, p.kind as kind from "syntax-child" as l join nodes as p on l.parent = p.id;
let node_edges = select l.parent as parent, l.child as child, l.ordinal as ordinal, l.kind as kind from edges as l join nodes as r on l.child = r.id;
let passing = select parent, child from node_edges where kind = "tuple-pat" or kind = "tuple-struct-pat" or kind = "slice-pat" or kind = "ref-pat" or kind = "box-pat" or kind = "paren-pat" or kind = "record-pat" or kind = "record-pat-field-list";
let colons = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "colon";
let field_edges = select parent, child from node_edges where kind = "record-pat-field";
let named_field_edges = select l.parent as parent, l.child as child from field_edges as l join colons as r on l.parent = r.id;
let alternatives = select parent, child, ordinal from node_edges where kind = "or-pat";
let later_alternatives = select l.parent as parent, l.child as child from alternatives as l join alternatives as r on l.parent = r.parent where r.ordinal < l.ordinal;
let first_alternatives = antijoin(left=alternatives, right=later_alternatives, left-on=["parent", "child"], right-on=["parent", "child"]);
let first_edges = select parent, child from first_alternatives;
let pattern_edges = union(left=passing, right=named_field_edges);
let walk_edges = union(left=pattern_edges, right=first_edges);
let descents = closure(edges=walk_edges, source="parent", destination="child");
let descended = select l.function as function, r.child as id from roots as l join descents as r on l.root = r.parent;
let direct = select function, root as id from roots;
let visited = union(left=direct, right=descended);
let binding_rows = bindings();
let digit_names = select id, file, name_span from binding_rows where matches(name, "^[_0-9]+$");
let found = select l.function as function, r.file as file, r.name_span as span from visited as l join digit_names as r on l.id = r.id;
let candidates = select r.anchor as id, l.file as file, l.span as span from found as l join anchors as r on l.function = r.function;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:just_underscores_and_digits|style|all))\s*(?:,|$)");
emit violations subject file key(span);
