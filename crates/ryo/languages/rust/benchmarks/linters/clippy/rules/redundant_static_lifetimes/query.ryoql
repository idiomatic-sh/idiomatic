import lint_attributes from "rust/clippy/lint-attributes";
let items = select id from "syntax-tree" where kind = "const" or kind = "static";
let associated_lists = select id from "syntax-tree" where kind = "assoc-item-list";
let associated = select l.child as id from "syntax-child" as l join associated_lists as r on l.parent = r.id;
let free_items = antijoin(left=items, right=associated, left-on=["id"], right-on=["id"]);
let roots = select l.child as type from "syntax-child" as l join free_items as r on l.parent = r.id where l.field = "ty";
let types = select id, kind from "syntax-tree" where matches(kind, "-type$");
let containers = select id from "syntax-tree" where kind = "array-type" or kind = "slice-type" or kind = "tuple-type" or kind = "ref-type";
let container_children = select l.parent as outer, l.child as inner from "syntax-child" as l join containers as r on l.parent = r.id;
let type_edges = select l.outer as outer, l.inner as inner from container_children as l join types as r on l.inner = r.id;
let descents = closure(edges=type_edges, source="outer", destination="inner");
let descended = select r.inner as type from roots as l join descents as r on l.type = r.outer;
let visited = union(left=roots, right=descended);
let references = select id from "syntax-tree" where kind = "ref-type";
let visited_references = select l.type as id from visited as l join references as r on l.type = r.id;
let statics = select id, file, span from "syntax-tree" where kind = "lifetime-ident" and text = "'static";
let lifetimes = select l.parent as lifetime, r.file as file, r.span as span from "syntax-child" as l join statics as r on l.child = r.id;
let reference_lifetimes = select l.parent as reference, r.lifetime as lifetime, r.file as file, r.span as span from "syntax-child" as l join lifetimes as r on l.child = r.lifetime where l.field = "lifetime";
let elided = select l.parent as reference from "syntax-child" as l join types as r on l.child = r.id where l.field = "ty" and (r.kind = "path-type" or r.kind = "slice-type" or r.kind = "array-type" or r.kind = "tuple-type");
let elidable = select l.reference as reference, l.lifetime as lifetime, l.file as file, l.span as span from reference_lifetimes as l join elided as r on l.reference = r.reference;
let redundant = select l.lifetime as id, l.file as file, l.span as span from elidable as l join visited_references as r on l.reference = r.id;
let violations = lint_attributes(candidates=redundant, names="(?:^|,)\s*(?:clippy::(?:redundant_static_lifetimes|style|all))\s*(?:,|$)");
emit violations subject file key(id);
