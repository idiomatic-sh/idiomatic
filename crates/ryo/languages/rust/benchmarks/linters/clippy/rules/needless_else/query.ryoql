import lint_attributes from "rust/clippy/lint-attributes";
let conditionals = select id, file, span from "syntax-tree" where kind = "if-expr";
let else_keywords = select l.parent as id, l.ordinal as ordinal, r.span as keyword from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "else-kw";
let blocks = select id from "syntax-tree" where kind = "block-expr";
let else_branches = select l.parent as id, l.child as branch from "syntax-child" as l join blocks as r on l.child = r.id where l.field = "else-branch";
let then_branches = select parent as id, ordinal from "syntax-child" where field = "then-branch";
let lists = select l.id as id, l.branch as branch, r.child as list from else_branches as l join "syntax-child" as r on l.branch = r.parent where r.field = "stmt-list";
let contents = select l.parent as list from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind != "l-curly" and r.kind != "r-curly" and r.kind != "whitespace";
let filled = select l.id as id from lists as l join contents as r on l.list = r.list;
let empty = antijoin(left=lists, right=filled, left-on=["id"], right-on=["id"]);
let comments = select l.parent as id, l.ordinal as ordinal from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "comment";
let commented = select l.id as id from comments as l join then_branches as r on l.id = r.id where l.ordinal > r.ordinal;
let quiet = antijoin(left=empty, right=commented, left-on=["id"], right-on=["id"]);
let keyed = select l.id as id, l.branch as branch, r.keyword as keyword from quiet as l join else_keywords as r on l.id = r.id;
let spanned = select l.branch as id, r.file as file, l.keyword as keyword, r.span as span from keyed as l join conditionals as r on l.id = r.id;
let reported = span-between(from=spanned, start="keyword", end="span", output="written");
let candidates = select id, file, written as span from reported;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:needless_else|style|all))\s*(?:,|$)");
emit violations subject file key(id);
