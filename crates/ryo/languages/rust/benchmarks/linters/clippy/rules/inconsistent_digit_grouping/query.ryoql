import lint_attributes from "rust/clippy/lint-attributes";
let tokens = select id, file, span, text from "syntax-tree" where (kind = "int-number" or kind = "float-number") and matches(text, "^(?:[1-9]|0(?:$|[^xob]))");
let hosts = select id, file from "syntax-tree" where kind = "literal" or kind = "macro-call" or kind = "macro-rules" or kind = "macro-def" or kind = "attr";
let hosted = axis(from=tokens, relation="syntax-child", direction=nearest-ancestor, domain=hosts);
let readers = select id, file from "syntax-tree" where kind = "literal" or kind = "macro-call";
let literals = select l.id as id, l.file as file, l.span as span, l.text as text from hosted as l join readers as r on l.related = r.id;
let suffix_like = select id, file, span, text from literals where matches(text, "^(?:[0-9][0-9_]*|0x[0-9a-fA-F_]*|0o[0-7_]*)_(?:8|16|32|64)$");
let suffix_like_digits = replace(from=suffix_like, text="text", pattern="^0[xo]|_", replacement="", output="digits");
let decimal_mistyped = select id, file, span from suffix_like_digits where matches(text, "^[0-9][0-9_]*_(?:8|16|32|64)$") and matches(digits, "^(?:0*(?:[0-9]{1,2}|1[0-9]{2}|2[01234][0-9]{1}|25[01234]|255)8|0*(?:[0-9]{1,4}|[12345][0-9]{4}|6[01234][0-9]{3}|65[01234][0-9]{2}|655[012][0-9]{1}|6553[01234]|65535)16|0*(?:[0-9]{1,9}|[123][0-9]{9}|4[01][0-9]{8}|42[012345678][0-9]{7}|429[0123][0-9]{6}|4294[012345678][0-9]{5}|42949[012345][0-9]{4}|429496[0123456][0-9]{3}|4294967[01][0-9]{2}|42949672[012345678][0-9]{1}|429496729[01234]|4294967295)32|0*(?:[0-9]{1,19}|1[01234567][0-9]{18}|18[0123][0-9]{17}|184[0123][0-9]{16}|1844[012345][0-9]{15}|18446[0123456][0-9]{14}|184467[0123][0-9]{13}|1844674[0123][0-9]{12}|184467440[0123456][0-9]{10}|1844674407[012][0-9]{9}|18446744073[0123456][0-9]{8}|1844674407370[012345678][0-9]{6}|18446744073709[01234][0-9]{5}|184467440737095[01234][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[012345][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[01234]|18446744073709551615)64)$");
let hexadecimal_mistyped = select id, file, span from suffix_like_digits where matches(text, "^0x[0-9a-fA-F_]*_(?:8|16|32|64)$") and matches(digits, "^(?:0*(?:[0-9a-fA-F]{1,1}|[123456789aAbBcCdDeE][0-9a-fA-F]{1}|[fF][0123456789aAbBcCdDeE]|[fF][fF])8|0*(?:[0-9a-fA-F]{1,3}|[123456789aAbBcCdDeE][0-9a-fA-F]{3}|[fF][0123456789aAbBcCdDeE][0-9a-fA-F]{2}|[fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{1}|[fF][fF][fF][0123456789aAbBcCdDeE]|[fF][fF][fF][fF])16|0*(?:[0-9a-fA-F]{1,7}|[123456789aAbBcCdDeE][0-9a-fA-F]{7}|[fF][0123456789aAbBcCdDeE][0-9a-fA-F]{6}|[fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{5}|[fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{4}|[fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{3}|[fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{2}|[fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{1}|[fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE]|[fF][fF][fF][fF][fF][fF][fF][fF])32|0*(?:[0-9a-fA-F]{1,15}|[123456789aAbBcCdDeE][0-9a-fA-F]{15}|[fF][0123456789aAbBcCdDeE][0-9a-fA-F]{14}|[fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{13}|[fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{12}|[fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{11}|[fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{10}|[fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{9}|[fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{8}|[fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{7}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{6}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{5}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{4}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{3}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{2}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE][0-9a-fA-F]{1}|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][0123456789aAbBcCdDeE]|[fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF][fF])64)$");
let octal_mistyped = select id, file, span from suffix_like_digits where matches(text, "^0o[0-7_]*_(?:8|16|32|64)$") and matches(digits, "^(?:0*(?:[0-7]{1,2}|[12][0-7]{2}|3[0123456][0-7]{1}|37[0123456]|377)8|0*(?:[0-7]{1,5}|1[0123456][0-7]{4}|17[0123456][0-7]{3}|177[0123456][0-7]{2}|1777[0123456][0-7]{1}|17777[0123456]|177777)16|0*(?:[0-7]{1,10}|[12][0-7]{10}|3[0123456][0-7]{9}|37[0123456][0-7]{8}|377[0123456][0-7]{7}|3777[0123456][0-7]{6}|37777[0123456][0-7]{5}|377777[0123456][0-7]{4}|3777777[0123456][0-7]{3}|37777777[0123456][0-7]{2}|377777777[0123456][0-7]{1}|3777777777[0123456]|37777777777)32|0*(?:[0-7]{1,21}|1[0123456][0-7]{20}|17[0123456][0-7]{19}|177[0123456][0-7]{18}|1777[0123456][0-7]{17}|17777[0123456][0-7]{16}|177777[0123456][0-7]{15}|1777777[0123456][0-7]{14}|17777777[0123456][0-7]{13}|177777777[0123456][0-7]{12}|1777777777[0123456][0-7]{11}|17777777777[0123456][0-7]{10}|177777777777[0123456][0-7]{9}|1777777777777[0123456][0-7]{8}|17777777777777[0123456][0-7]{7}|177777777777777[0123456][0-7]{6}|1777777777777777[0123456][0-7]{5}|17777777777777777[0123456][0-7]{4}|177777777777777777[0123456][0-7]{3}|1777777777777777777[0123456][0-7]{2}|17777777777777777777[0123456][0-7]{1}|177777777777777777777[0123456]|1777777777777777777777)64)$");
let exponent_mistyped = select id, file, span from literals where matches(text, "^[0-9][0-9_]*(?:\.[0-9_]*)?[eE][+-]?[0-9_]*_(?:32|64)$");
let integer_mistyped = union(left=decimal_mistyped, right=hexadecimal_mistyped);
let radix_mistyped = union(left=integer_mistyped, right=octal_mistyped);
let mistyped = union(left=radix_mistyped, right=exponent_mistyped);
let unsuffixed = replace(from=literals, text="text", pattern="_?(?:[iu](?:8|16|32|64|128|size)|f(?:16|32|64|128))$", replacement="", output="unsuffixed");
let mantissas = replace(from=unsuffixed, text="unsuffixed", pattern="_?[eE][+-]?[0-9_]*$", replacement="", output="mantissa");
let grouped_integers = select id, file, span, mantissa from mantissas where matches(mantissa, "^[0-9_]*_[0-9_]*(?:\.|$)");
let consistent_integers = select id, file, span, mantissa from grouped_integers where matches(mantissa, "^(?:[0-9]{1,1}(?:_[0-9]{1})+|[0-9]{1,2}(?:_[0-9]{2})+|[0-9]{1,3}(?:_[0-9]{3})+|[0-9]{1,4}(?:_[0-9]{4})+|[0-9]{1,5}(?:_[0-9]{5})+|[0-9]{1,6}(?:_[0-9]{6})+|[0-9]{1,7}(?:_[0-9]{7})+|[0-9]{1,8}(?:_[0-9]{8})+|[0-9]{1,9}(?:_[0-9]{9})+|[0-9]{1,10}(?:_[0-9]{10})+|[0-9]{1,11}(?:_[0-9]{11})+|[0-9]{1,12}(?:_[0-9]{12})+|[0-9]{1,13}(?:_[0-9]{13})+|[0-9]{1,14}(?:_[0-9]{14})+|[0-9]{1,15}(?:_[0-9]{15})+|[0-9]{1,16}(?:_[0-9]{16})+|[0-9]{1,17}(?:_[0-9]{17})+|[0-9]{1,18}(?:_[0-9]{18})+|[0-9]{1,19}(?:_[0-9]{19})+|[0-9]{1,20}(?:_[0-9]{20})+|[0-9]{1,21}(?:_[0-9]{21})+|[0-9]{1,22}(?:_[0-9]{22})+|[0-9]{1,23}(?:_[0-9]{23})+|[0-9]{1,24}(?:_[0-9]{24})+|[0-9]{1,25}(?:_[0-9]{25})+|[0-9]{1,26}(?:_[0-9]{26})+|[0-9]{1,27}(?:_[0-9]{27})+|[0-9]{1,28}(?:_[0-9]{28})+|[0-9]{1,29}(?:_[0-9]{29})+|[0-9]{1,30}(?:_[0-9]{30})+|[0-9]{1,31}(?:_[0-9]{31})+|[0-9]{1,32}(?:_[0-9]{32})+|[0-9]{1,33}(?:_[0-9]{33})+|[0-9]{1,34}(?:_[0-9]{34})+|[0-9]{1,35}(?:_[0-9]{35})+|[0-9]{1,36}(?:_[0-9]{36})+|[0-9]{1,37}(?:_[0-9]{37})+|[0-9]{1,38}(?:_[0-9]{38})+|[0-9]{1,39}(?:_[0-9]{39})+|[0-9]{1,40}(?:_[0-9]{40})+)(?:\.|$)");
let inconsistent_integers = antijoin(left=grouped_integers, right=consistent_integers, left-on=["id"], right-on=["id"]);
let fine_integers = select id, file, span, mantissa from mantissas where matches(mantissa, "^(?:[0-9]{1,5}|[0-9]{1,1}(?:_[0-9]{1})+|[0-9]{1,2}(?:_[0-9]{2})+|[0-9]{1,3}(?:_[0-9]{3})+|[0-9]{1,4}(?:_[0-9]{4})+)\.");
let grouped_fractions = select id, file, span, mantissa from fine_integers where matches(mantissa, "\.[0-9_]*_[0-9_]*$");
let consistent_fractions = select id, file, span, mantissa from grouped_fractions where matches(mantissa, "\.(?:(?:[0-9]{1}_)+[0-9]{0,1}|(?:[0-9]{2}_)+[0-9]{0,2}|(?:[0-9]{3}_)+[0-9]{0,3}|(?:[0-9]{4}_)+[0-9]{0,4}|(?:[0-9]{5}_)+[0-9]{0,5}|(?:[0-9]{6}_)+[0-9]{0,6}|(?:[0-9]{7}_)+[0-9]{0,7}|(?:[0-9]{8}_)+[0-9]{0,8}|(?:[0-9]{9}_)+[0-9]{0,9}|(?:[0-9]{10}_)+[0-9]{0,10}|(?:[0-9]{11}_)+[0-9]{0,11}|(?:[0-9]{12}_)+[0-9]{0,12}|(?:[0-9]{13}_)+[0-9]{0,13}|(?:[0-9]{14}_)+[0-9]{0,14}|(?:[0-9]{15}_)+[0-9]{0,15}|(?:[0-9]{16}_)+[0-9]{0,16}|(?:[0-9]{17}_)+[0-9]{0,17}|(?:[0-9]{18}_)+[0-9]{0,18}|(?:[0-9]{19}_)+[0-9]{0,19}|(?:[0-9]{20}_)+[0-9]{0,20}|(?:[0-9]{21}_)+[0-9]{0,21}|(?:[0-9]{22}_)+[0-9]{0,22}|(?:[0-9]{23}_)+[0-9]{0,23}|(?:[0-9]{24}_)+[0-9]{0,24}|(?:[0-9]{25}_)+[0-9]{0,25}|(?:[0-9]{26}_)+[0-9]{0,26}|(?:[0-9]{27}_)+[0-9]{0,27}|(?:[0-9]{28}_)+[0-9]{0,28}|(?:[0-9]{29}_)+[0-9]{0,29}|(?:[0-9]{30}_)+[0-9]{0,30}|(?:[0-9]{31}_)+[0-9]{0,31}|(?:[0-9]{32}_)+[0-9]{0,32}|(?:[0-9]{33}_)+[0-9]{0,33}|(?:[0-9]{34}_)+[0-9]{0,34}|(?:[0-9]{35}_)+[0-9]{0,35}|(?:[0-9]{36}_)+[0-9]{0,36}|(?:[0-9]{37}_)+[0-9]{0,37}|(?:[0-9]{38}_)+[0-9]{0,38}|(?:[0-9]{39}_)+[0-9]{0,39}|(?:[0-9]{40}_)+[0-9]{0,40})$");
let inconsistent_fractions = antijoin(left=grouped_fractions, right=consistent_fractions, left-on=["id"], right-on=["id"]);
let mismatched_parts = select id, file, span, mantissa from mantissas where matches(mantissa, "^(?:[0-9]{2,5}\.(?:[0-9]{1}_)+[0-9]{0,1}|[0-9]{1,1}(?:_[0-9]{1})+\.[0-9]{2,5}|[0-9]{1,1}(?:_[0-9]{1})+\.(?:[0-9]{2}_)+[0-9]{0,2}|[0-9]{1,1}(?:_[0-9]{1})+\.(?:[0-9]{3}_)+[0-9]{0,3}|[0-9]{1,1}(?:_[0-9]{1})+\.(?:[0-9]{4}_)+[0-9]{0,4}|[0-9]{3,5}\.(?:[0-9]{2}_)+[0-9]{0,2}|[0-9]{1,2}(?:_[0-9]{2})+\.[0-9]{3,5}|[0-9]{1,2}(?:_[0-9]{2})+\.(?:[0-9]{1}_)+[0-9]{0,1}|[0-9]{1,2}(?:_[0-9]{2})+\.(?:[0-9]{3}_)+[0-9]{0,3}|[0-9]{1,2}(?:_[0-9]{2})+\.(?:[0-9]{4}_)+[0-9]{0,4}|[0-9]{4,5}\.(?:[0-9]{3}_)+[0-9]{0,3}|[0-9]{1,3}(?:_[0-9]{3})+\.[0-9]{4,5}|[0-9]{1,3}(?:_[0-9]{3})+\.(?:[0-9]{1}_)+[0-9]{0,1}|[0-9]{1,3}(?:_[0-9]{3})+\.(?:[0-9]{2}_)+[0-9]{0,2}|[0-9]{1,3}(?:_[0-9]{3})+\.(?:[0-9]{4}_)+[0-9]{0,4}|[0-9]{5,5}\.(?:[0-9]{4}_)+[0-9]{0,4}|[0-9]{1,4}(?:_[0-9]{4})+\.[0-9]{5,5}|[0-9]{1,4}(?:_[0-9]{4})+\.(?:[0-9]{1}_)+[0-9]{0,1}|[0-9]{1,4}(?:_[0-9]{4})+\.(?:[0-9]{2}_)+[0-9]{0,2}|[0-9]{1,4}(?:_[0-9]{4})+\.(?:[0-9]{3}_)+[0-9]{0,3})$");
let integer_or_fraction = union(left=inconsistent_integers, right=inconsistent_fractions);
let inconsistent = union(left=integer_or_fraction, right=mismatched_parts);
let grouping = antijoin(left=inconsistent, right=mistyped, left-on=["id"], right-on=["id"]);
let candidates = select id, file, span from grouping;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:inconsistent_digit_grouping|style|all))\s*(?:,|$)");
emit violations subject file key(id);
