import lint_attributes from "rust/clippy/lint-attributes";
let statements = select l.child as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "statements" and r.kind = "expr-stmt";
let statement_children = select l.id as id, l.file as file, r.child as child, r.field as field from statements as l join "syntax-child" as r on l.id = r.parent;
let semicolons = select l.id as id, l.file as file from statement_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "semicolon";
let open = antijoin(left=statements, right=semicolons, left-on=["id"], right-on=["id"]);
let expressions = select l.id as statement, l.file as file, r.child as id from open as l join "syntax-child" as r on l.id = r.parent where r.field = "expr";
let ifs = select l.statement as statement, l.file as file, l.id as id, r.span as span from expressions as l join "syntax-tree" as r on l.id = r.id where r.kind = "if-expr";
let if_children = select l.statement as statement, l.id as id, l.file as file, l.span as span, r.child as child, r.field as field from ifs as l join "syntax-child" as r on l.id = r.parent;
let elses = select id, file from if_children where field = "else-branch";
let lets = select id, file from "syntax-tree" where kind = "let-expr";
let conditionals = select id, file from "syntax-tree" where kind = "if-expr" or kind = "while-expr" or kind = "match-guard";
let let_owners = axis(from=lets, relation="syntax-child", direction=nearest-ancestor, domain=conditionals);
let let_ifs = select related as id, file from let_owners;
let skipped = union(left=elses, right=let_ifs);
let thens = select statement, id, file, span, child as then from if_children where field = "then-branch";
let plain = antijoin(left=thens, right=skipped, left-on=["id"], right-on=["id"]);
let then_lists = select l.then as then, l.file as file, r.child as list from plain as l join "syntax-child" as r on l.then = r.parent where r.field = "stmt-list";
let list_children = select l.then as then, l.file as file, r.child as child from then_lists as l join "syntax-child" as r on l.list = r.parent;
let filled = select l.then as then, l.file as file from list_children as l join "syntax-tree" as r on l.child = r.id where r.kind != "l-curly" and r.kind != "r-curly" and r.kind != "whitespace";
let empty = antijoin(left=plain, right=filled, left-on=["then"], right-on=["then"]);
let candidates = select then as id, file, span from empty;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:needless_ifs|complexity|all))\s*(?:,|$)");
emit violations subject file key(span);
