import lint_attributes from "rust/clippy/lint-attributes";
import cfg_test from "rust/clippy/cfg-test";
let ident_pats = select id, file from "syntax-tree" where kind = "ident-pat";
let pat_names = select l.id as id, l.file as file, r.child as name from ident_pats as l join "syntax-child" as r on l.id = r.parent where r.field = "name";
let name_tokens = select l.id as id, l.file as file, l.name as name, r.child as token from pat_names as l join "syntax-child" as r on l.name = r.parent;
let placeholders = select l.id as id, l.file as file, l.name as name from name_tokens as l join "syntax-tree" as r on l.token = r.id where r.kind = "ident" and matches(r.text, "^(?:foo|baz|quux)$");
let pat_owners = select l.id as id, l.file as file, r.parent as param from placeholders as l join "syntax-child" as r on l.id = r.child where r.field = "pat";
let pat_params = select l.id as id, l.file as file, l.param as param from pat_owners as l join "syntax-tree" as r on l.param = r.id where r.kind = "param";
let param_lists = select l.id as id, l.file as file, r.parent as list from pat_params as l join "syntax-child" as r on l.param = r.child;
let param_owners = select l.id as id, l.file as file, r.parent as owner from param_lists as l join "syntax-child" as r on l.list = r.child;
let bodies = select parent as owner, file from "syntax-child" where field = "body";
let bodied = select l.id as id, l.file as file from param_owners as l join bodies as r on l.owner = r.owner;
let bodiless_pats = antijoin(left=param_owners, right=bodied, left-on=["id"], right-on=["id"]);
let bodiless = select id, file from bodiless_pats;
let tests_by_cfg = cfg_test();
let tested = select declaration as id, file from tests_by_cfg;
let test_functions = select declaration as id, file from "decorates" where target = "test";
let test_scopes = union(left=tested, right=test_functions);
let in_tests = axis(from=placeholders, relation="syntax-child", direction=ancestor, domain=test_scopes);
let in_test_pats = select id, file from in_tests;
let test_files = select id, file from placeholders where glob_any(file, "tests/**");
let in_test_code = union(left=in_test_pats, right=test_files);
let excluded = union(left=bodiless, right=in_test_code);
let bindings = antijoin(left=placeholders, right=excluded, left-on=["id"], right-on=["id"]);
let candidates = select l.name as id, l.file as file, r.span as span from bindings as l join "syntax-tree" as r on l.name = r.id;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:disallowed_names|style|all))\s*(?:,|$)");
emit violations subject file key(span);
