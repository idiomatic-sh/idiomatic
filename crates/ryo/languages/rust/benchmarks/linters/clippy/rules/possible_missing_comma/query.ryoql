import lint_attributes from "rust/clippy/lint-attributes";
let tree = select id, file from "syntax-tree";
let arrays = select id, file from "syntax-tree" where kind = "array-expr";
let repeats = select l.parent as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "semicolon";
let lists = antijoin(left=arrays, right=repeats, left-on=["id"], right-on=["id"]);
let elements = select l.child as id, l.file as file from "syntax-child" as l join lists as r on l.parent = r.id;
let binaries = select l.id as id, l.file as file from elements as l join "syntax-tree" as r on l.id = r.id where r.kind = "bin-expr";
let edges = select l.parent as parent, l.child as child, l.field as field, l.file as file from "syntax-child" as l join binaries as r on l.parent = r.id where l.field = "lhs" or l.field = "op";
let operators = select l.parent as id, l.child as operator, l.file as file from edges as l join "syntax-tree" as r on l.child = r.id where l.field = "op" and (r.text = "-" or r.text = "*" or r.text = "&&");
let sides = select l.child as lhs, l.parent as id, r.operator as operator, l.file as file from edges as l join operators as r on l.parent = r.id where l.field = "lhs";
let lhs_lines = select l.id as id, l.lhs as lhs, l.operator as operator, r."start-line" as lhs_line, r."end-line" as lhs_end, l.file as file from sides as l join "source-location" as r on l.lhs = r.id;
let broken = select l.id as id, l.lhs as lhs, l.lhs_line as lhs_line, r."start-line" as operator_line, l.file as file from lhs_lines as l join "source-location" as r on l.operator = r.id where r."start-line" > l.lhs_end;
let breaks = select id, file, text from "syntax-tree" where kind = "whitespace" and matches(text, "\n");
let break_lines = select l.text as text, r."end-line" as line, l.file as file from breaks as l join "source-location" as r on l.id = r.id;
let operator_breaks = select l.id as id, l.lhs as lhs, l.lhs_line as lhs_line, r.text as operator_break, l.file as file from broken as l join break_lines as r on l.file = r.file and l.operator_line = r.line;
let both_breaks = select l.id as id, l.lhs as lhs, l.operator_break as operator_break, r.text as lhs_break, l.file as file from operator_breaks as l join break_lines as r on l.file = r.file and l.lhs_line = r.line;
let operator_indented = replace(from=both_breaks, text="operator_break", pattern="(?s)^.*\n", replacement="", output="operator_indent");
let indented = replace(from=operator_indented, text="lhs_break", pattern="(?s)^.*\n", replacement="", output="lhs_indent");
let flagged = select id, lhs, file from indented where operator_indent <= lhs_indent;
let lhs_rows = select lhs as id, id as binary, file from flagged;
let after_lhs = axis(from=lhs_rows, relation="syntax-child", direction=next-sibling, domain=tree);
let lhs_spans = select l.id as id, l.binary as binary, l.related as next, r.span as end, l.file as file from after_lhs as l join "syntax-tree" as r on l.id = r.id;
let bounded = select l.binary as id, r.span as start, l.end as end, l.file as file from lhs_spans as l join "syntax-tree" as r on l.next = r.id;
let spanned = span-between(from=bounded, start="start", end="end", output="span");
let candidates = select id, file, span from spanned;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:possible_missing_comma|correctness|all))\s*(?:,|$)");
emit violations subject file key(span);
