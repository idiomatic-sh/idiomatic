import lint_attributes from "rust/clippy/lint-attributes";
import doc_comments from "rust/clippy/doc-comments";
import attribute_owners from "rust/clippy/attribute-owners";
import hulls from "rust/clippy/hulls";
let comments = doc_comments();
let comment_elements = select id, file, span from comments;
let blank_comments = select id, file, span from comments where matches(text, "^(?:///|//!)\s*$") or matches(text, "^/\*[*!]\s*\*/$");
let suspicious = select id, file from comments where matches(text, "^(?:///!|/\*\*!)");
let doc_attributes = select occurrence, arguments, file from "decorates" where target = "doc";
let attribute_metas = select l.occurrence as occurrence, r.child as meta, l.file as file from doc_attributes as l join "syntax-child" as r on l.occurrence = r.parent;
let values = select l.occurrence as occurrence, l.meta as meta, l.file as file from attribute_metas as l join "syntax-tree" as r on l.meta = r.id where r.kind = "key-value-meta";
let value_children = select l.occurrence as occurrence, r.child as child, l.file as file from values as l join "syntax-child" as r on l.meta = r.parent;
let literals = select l.occurrence as id, l.file as file, r.span as span from value_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "literal";
let blank_literals = source-matches(from=literals, span="span", pattern="\A(?:\x22\s*\x22|r#*\x22\s*\x22#*)\z", output="found");
let blank_attributes = select id, file, span from blank_literals;
let value_ids = select occurrence as id, file from values;
let hidden = select occurrence as id, file from doc_attributes where matches(arguments, "(?:^|,)\s*hidden\s*(?:,|$)");
let elements = union(left=comment_elements, right=literals);
let blanks = union(left=blank_comments, right=blank_attributes);
let element_ids = select id, file from elements;
let skip_ids = union(left=suspicious, right=hidden);
let all_ids = union(left=element_ids, right=value_ids);
let owner_ids = union(left=all_ids, right=skip_ids);
let owners = attribute_owners(elements=owner_ids);
let element_owners = select l.owner as owner, l.id as id, r.file as file, r.span as span from owners as l join elements as r on l.id = r.id;
let value_owners = select l.owner as owner, l.id as id, l.file as file from owners as l join value_ids as r on l.id = r.id;
let blank_ids = select id, file from blanks;
let filled_values = antijoin(left=value_owners, right=blank_ids, left-on=["id"], right-on=["id"]);
let filled_comments = select l.owner as owner, l.id as id, l.file as file from element_owners as l join comment_elements as r on l.id = r.id;
let filled_comment_rows = antijoin(left=filled_comments, right=blank_ids, left-on=["id"], right-on=["id"]);
let filled = union(left=filled_values, right=filled_comment_rows);
let skipped = select l.owner as owner, l.id as id, l.file as file from owners as l join skip_ids as r on l.id = r.id;
let excluded = union(left=filled, right=skipped);
let empty_owned = antijoin(left=element_owners, right=excluded, left-on=["owner"], right-on=["owner"]);
let spans = hulls(members=empty_owned);
let candidates = select id, file, span from spans;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:empty_docs|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
