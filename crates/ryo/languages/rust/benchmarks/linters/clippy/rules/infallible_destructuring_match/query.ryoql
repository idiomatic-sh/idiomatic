import bindings from "rust/clippy/bindings";
import lint_attributes from "rust/clippy/lint-attributes";
let statements = select id, file, span from "syntax-tree" where kind = "let-stmt";
let elses = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "let-else";
let plain_statements = antijoin(left=statements, right=elses, left-on=["id"], right-on=["id"]);
let initializers = select l.parent as statement, l.child as expression from "syntax-child" as l join plain_statements as r on l.parent = r.id where l.field = "initializer";
let parens = select id from "syntax-tree" where kind = "paren-expr";
let paren_edges = select l.parent as outer, l.child as inner from "syntax-child" as l join parens as r on l.parent = r.id where l.field = "expr";
let paren_peeling = closure(edges=paren_edges, source="outer", destination="inner");
let peeled_initializers = select l.statement as statement, r.inner as expression from initializers as l join paren_peeling as r on l.expression = r.outer;
let all_initializers = union(left=initializers, right=peeled_initializers);
let matches = select id from "syntax-tree" where kind = "match-expr";
let destructurings = select l.statement as statement, l.expression as match from all_initializers as l join matches as r on l.expression = r.id;
let arm_lists = select l.match as match, r.child as list from destructurings as l join "syntax-child" as r on l.match = r.parent where r.field = "match-arm-list";
let arms = select l.match as match, r.child as arm from arm_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "arms";
let arm_counts = group-count(from=arms, keys=["match"], count="count");
let single = select match from arm_counts where count = 1;
let single_arms = select l.match as match, l.arm as arm from arms as l join single as r on l.match = r.match;
let guarded = select parent as arm from "syntax-child" where field = "guard";
let unguarded = antijoin(left=single_arms, right=guarded, left-on=["arm"], right-on=["arm"]);
let tuple_structs = select id from "syntax-tree" where kind = "tuple-struct-pat";
let arm_patterns = select l.match as match, l.arm as arm, r.child as pattern from unguarded as l join "syntax-child" as r on l.arm = r.parent where r.field = "pat";
let tuple_arms = select l.match as match, l.arm as arm, l.pattern as pattern from arm_patterns as l join tuple_structs as r on l.pattern = r.id;
let self_types = select id from "syntax-tree" where kind = "self-type-kw";
let self_owners = axis(from=self_types, relation="syntax-child", direction=nearest-ancestor, domain=tuple_structs);
let self_patterns = select related as pattern from self_owners;
let resolved_arms = antijoin(left=tuple_arms, right=self_patterns, left-on=["pattern"], right-on=["pattern"]);
let patterns = select id, kind from "syntax-tree" where matches(kind, "-pat$");
let subpatterns = select l.parent as pattern, l.child as subpattern from "syntax-child" as l join patterns as r on l.child = r.id where r.kind != "rest-pat";
let arm_subpatterns = select l.match as match, l.arm as arm, r.subpattern as subpattern from resolved_arms as l join subpatterns as r on l.pattern = r.pattern;
let subpattern_counts = group-count(from=arm_subpatterns, keys=["arm"], count="count");
let one_subpattern = select arm from subpattern_counts where count = 1;
let lone = select l.match as match, l.arm as arm, l.subpattern as subpattern from arm_subpatterns as l join one_subpattern as r on l.arm = r.arm;
let wrappers = select id from "syntax-tree" where kind = "paren-pat" or kind = "ref-pat";
let wrapper_edges = select l.parent as outer, l.child as inner from "syntax-child" as l join wrappers as r on l.parent = r.id;
let wrapper_pattern_edges = select l.outer as outer, l.inner as inner from wrapper_edges as l join patterns as r on l.inner = r.id;
let unwrapping = closure(edges=wrapper_pattern_edges, source="outer", destination="inner");
let lone_unwrapped = select l.match as match, l.arm as arm, r.inner as subpattern from lone as l join unwrapping as r on l.subpattern = r.outer;
let lone_all = union(left=lone, right=lone_unwrapped);
let binding_rows = bindings();
let declared = select file, name from "defines" where kind = "struct" or kind = "constant" or kind = "import";
let named_bindings = select l.match as match, l.arm as arm, r.file as file, r.name as name from lone_all as l join binding_rows as r on l.subpattern = r.id;
let shadowed = select l.arm as arm from named_bindings as l join declared as r on l.file = r.file and l.name = r.name;
let bound = antijoin(left=named_bindings, right=shadowed, left-on=["arm"], right-on=["arm"]);
let bodies = select l.match as match, l.arm as arm, l.name as name, r.child as body from bound as l join "syntax-child" as r on l.arm = r.parent where r.field = "expr";
let blocks = select id from "syntax-tree" where kind = "block-expr";
let modified = select l.parent as id from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "async-kw" or r.kind = "const-kw" or r.kind = "try-kw" or r.kind = "unsafe-kw" or r.kind = "label";
let plain_blocks = antijoin(left=blocks, right=modified, left-on=["id"], right-on=["id"]);
let block_lists = select l.parent as block, l.child as list from "syntax-child" as l join plain_blocks as r on l.parent = r.id where l.field = "stmt-list";
let stated = select parent as list from "syntax-child" where field = "statements";
let bare_lists = antijoin(left=block_lists, right=stated, left-on=["list"], right-on=["list"]);
let block_edges = select l.block as outer, r.child as inner from bare_lists as l join "syntax-child" as r on l.list = r.parent where r.field = "tail-expr";
let body_edges = union(left=paren_edges, right=block_edges);
let body_peeling = closure(edges=body_edges, source="outer", destination="inner");
let peeled_bodies = select l.match as match, l.name as name, r.inner as body from bodies as l join body_peeling as r on l.body = r.outer;
let direct_bodies = select match, name, body from bodies;
let all_bodies = union(left=direct_bodies, right=peeled_bodies);
let path_expressions = select l.parent as expression, r.file as file, r.span as span from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where l.field = "path";
let identifiers = select file, span, text from "syntax-tree" where kind = "ident";
let single_names = select l.expression as expression, r.text as text from path_expressions as l join identifiers as r on l.file = r.file and l.span = r.span;
let spelled = replace(from=single_names, text="text", pattern="^r#", replacement="", output="name");
let returned = select l.match as match from all_bodies as l join spelled as r on l.body = r.expression and l.name = r.name;
let found = select l.statement as statement, l.match as match from destructurings as l join returned as r on l.match = r.match;
let keywords = select l.parent as statement, r.span as keyword from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "let-kw";
let located = select l.match as id, r.file as file, r.span as span, l.statement as statement from found as l join statements as r on l.statement = r.id;
let headed = select l.id as id, l.file as file, l.span as span, r.keyword as keyword from located as l join keywords as r on l.statement = r.statement;
let written = span-between(from=headed, start="keyword", end="span", output="reported");
let candidates = select id, file, reported as span from written;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:infallible_destructuring_match|style|all))\s*(?:,|$)");
emit violations subject file key(id);
