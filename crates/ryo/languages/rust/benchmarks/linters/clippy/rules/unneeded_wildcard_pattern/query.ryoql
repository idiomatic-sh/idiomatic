import lint_attributes from "rust/clippy/lint-attributes";
let tuples = select id, file from "syntax-tree" where kind = "tuple-pat" or kind = "tuple-struct-pat";
let patterns = select id, kind, span from "syntax-tree" where matches(kind, "-pat$");
let elements = select l.parent as tuple, l.child as element, l.ordinal as ordinal, r.kind as kind, r.span as span from "syntax-child" as l join patterns as r on l.child = r.id;
let tuple_elements = select l.tuple as tuple, r.file as file, l.element as element, l.ordinal as ordinal, l.kind as kind, l.span as span from elements as l join tuples as r on l.tuple = r.id;
let rests = select tuple, file, element as rest, ordinal as rest_ordinal from tuple_elements where kind = "rest-pat";
let wilds = select tuple, element, ordinal, span from tuple_elements where kind = "wildcard-pat";
let others = select tuple, ordinal from tuple_elements where kind != "wildcard-pat" and kind != "rest-pat";
let left_wilds = select l.tuple as tuple, l.file as file, l.rest as rest, l.rest_ordinal as rest_ordinal, r.ordinal as ordinal, r.span as span from rests as l join wilds as r on l.tuple = r.tuple where r.ordinal < l.rest_ordinal;
let left_blocked = select l.tuple as tuple, l.ordinal as ordinal from left_wilds as l join others as r on l.tuple = r.tuple where r.ordinal > l.ordinal and r.ordinal < l.rest_ordinal;
let left_runs = antijoin(left=left_wilds, right=left_blocked, left-on=["tuple", "ordinal"], right-on=["tuple", "ordinal"]);
let left_inner = select l.tuple as tuple, l.ordinal as ordinal from left_runs as l join left_runs as r on l.tuple = r.tuple where r.ordinal < l.ordinal;
let left_first = antijoin(left=left_runs, right=left_inner, left-on=["tuple", "ordinal"], right-on=["tuple", "ordinal"]);
let siblings = select id from "syntax-tree";
let rest_ids = select rest as id from rests;
let before_rests = axis(from=rest_ids, relation="syntax-child", direction=previous-sibling, domain=siblings);
let after_rests = axis(from=rest_ids, relation="syntax-child", direction=next-sibling, domain=siblings);
let before_spans = select l.id as rest, r.span as before from before_rests as l join "syntax-tree" as r on l.related = r.id;
let after_spans = select l.id as rest, r.span as after from after_rests as l join "syntax-tree" as r on l.related = r.id;
let left_bounds = select l.tuple as id, l.file as file, l.span as start, r.before as end from left_first as l join before_spans as r on l.rest = r.rest;
let right_wilds = select l.tuple as tuple, l.file as file, l.rest as rest, l.rest_ordinal as rest_ordinal, r.ordinal as ordinal, r.span as span from rests as l join wilds as r on l.tuple = r.tuple where r.ordinal > l.rest_ordinal;
let right_blocked = select l.tuple as tuple, l.ordinal as ordinal from right_wilds as l join others as r on l.tuple = r.tuple where r.ordinal < l.ordinal and r.ordinal > l.rest_ordinal;
let right_runs = antijoin(left=right_wilds, right=right_blocked, left-on=["tuple", "ordinal"], right-on=["tuple", "ordinal"]);
let right_inner = select l.tuple as tuple, l.ordinal as ordinal from right_runs as l join right_runs as r on l.tuple = r.tuple where r.ordinal > l.ordinal;
let right_last = antijoin(left=right_runs, right=right_inner, left-on=["tuple", "ordinal"], right-on=["tuple", "ordinal"]);
let right_bounds = select l.tuple as id, l.file as file, r.after as start, l.span as end from right_last as l join after_spans as r on l.rest = r.rest;
let field_lists = select id, file from "syntax-tree" where kind = "record-pat-field-list";
let list_children = select l.parent as list, r.file as file, l.child as child, l.ordinal as ordinal from "syntax-child" as l join field_lists as r on l.parent = r.id;
let record_rests = select l.list as list, l.file as file, l.child as rest, l.ordinal as rest_ordinal from list_children as l join patterns as r on l.child = r.id where r.kind = "rest-pat";
let fields = select l.list as list, l.child as field, l.ordinal as ordinal, r.span as span from list_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "record-pat-field";
let wild_field_ids = select l.parent as field from "syntax-child" as l join patterns as r on l.child = r.id where r.kind = "wildcard-pat";
let wild_fields = select l.list as list, l.field as field, l.ordinal as ordinal, l.span as span from fields as l join wild_field_ids as r on l.field = r.field;
let other_fields = antijoin(left=fields, right=wild_field_ids, left-on=["field"], right-on=["field"]);
let field_runs_all = select l.list as list, l.file as file, l.rest as rest, l.rest_ordinal as rest_ordinal, r.ordinal as ordinal, r.span as span from record_rests as l join wild_fields as r on l.list = r.list where r.ordinal < l.rest_ordinal;
let field_blocked = select l.list as list, l.ordinal as ordinal from field_runs_all as l join other_fields as r on l.list = r.list where r.ordinal > l.ordinal and r.ordinal < l.rest_ordinal;
let field_runs = antijoin(left=field_runs_all, right=field_blocked, left-on=["list", "ordinal"], right-on=["list", "ordinal"]);
let field_inner = select l.list as list, l.ordinal as ordinal from field_runs as l join field_runs as r on l.list = r.list where r.ordinal < l.ordinal;
let field_first = antijoin(left=field_runs, right=field_inner, left-on=["list", "ordinal"], right-on=["list", "ordinal"]);
let record_rest_ids = select rest as id from record_rests;
let before_record_rests = axis(from=record_rest_ids, relation="syntax-child", direction=previous-sibling, domain=siblings);
let before_record_spans = select l.id as rest, r.span as before from before_record_rests as l join "syntax-tree" as r on l.related = r.id;
let field_bounds = select l.list as id, l.file as file, l.span as start, r.before as end from field_first as l join before_record_spans as r on l.rest = r.rest;
let tuple_bounds = union(left=left_bounds, right=right_bounds);
let bounds = union(left=tuple_bounds, right=field_bounds);
let spanned = span-between(from=bounds, start="start", end="end", output="span");
let candidates = select id, file, span from spanned;
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:unneeded_wildcard_pattern|complexity|all))\s*(?:,|$)");
emit violations subject file key(span);
