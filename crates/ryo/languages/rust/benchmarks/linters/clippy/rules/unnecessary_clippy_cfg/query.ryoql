import lint_attributes from "rust/clippy/lint-attributes";
let cfg_attrs = select id, file from "syntax-tree" where kind = "cfg-attr-meta";
let attr_items = select l.parent as owner, l.child as child, l.file as file from "syntax-child" as l join cfg_attrs as r on l.parent = r.id;
let atoms = select l.owner as owner, r.id as id, r.file as file, r.span as span from attr_items as l join "syntax-tree" as r on l.child = r.id where r.kind = "cfg-atom";
let clippy_predicates = source-matches(from=atoms, span="span", pattern="\Aclippy\z", output="found");
let attr_metas = select l.owner as owner, l.child as child, l.file as file from attr_items as l join "syntax-tree" as r on l.child = r.id where r.kind = "path-meta" or r.kind = "token-tree-meta" or r.kind = "key-value-meta" or r.kind = "unsafe-meta" or r.kind = "cfg-meta" or r.kind = "cfg-attr-meta";
let attr_counts = group-count(from=attr_metas, keys=["owner", "file"], count="metas");
let single_attrs = select owner, file from attr_counts where metas = 1;
let clippy_attrs = select l.owner as owner, l.file as file from single_attrs as l join clippy_predicates as r on l.owner = r.owner;
let behind = select l.owner as owner, l.child as meta, l.file as file from attr_metas as l join clippy_attrs as r on l.owner = r.owner;
let behind_children = select l.owner as owner, r.child as child, l.file as file from behind as l join "syntax-child" as r on l.meta = r.parent;
let behind_paths = select l.owner as owner, r.span as span, l.file as file from behind_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "path";
let level_paths = source-matches(from=behind_paths, span="span", pattern="\A(?:allow|warn|deny|forbid|expect)\z", output="found");
let behind_trees = select l.owner as owner, r.span as span, l.file as file from behind_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "token-tree";
let level_trees = select l.owner as owner, l.span as span, l.file as file from behind_trees as l join level_paths as r on l.owner = r.owner;
let items = source-matches(from=level_trees, span="span", pattern="[(,]\s*(?P<item>[^,()]*[^,()\s])", output="found", capture="item", capture-output="item_span", capture-text-output="item_text");
let lints = select owner, file, item_span from items where matches(item_text, "^clippy\s*::\s*[A-Za-z_][A-Za-z0-9_]*$");
let item_counts = group-count(from=items, keys=["owner", "file"], count="written");
let lint_counts = group-count(from=lints, keys=["owner", "file"], count="written");
let whole = intersection(left=item_counts, right=lint_counts);
let partial = difference(left=lint_counts, right=item_counts);
let owner_parents = select l.owner as owner, r.parent as attribute, l.file as file from whole as l join "syntax-child" as r on l.owner = r.child;
let whole_attrs = select l.attribute as id, l.file as file, r.span as span from owner_parents as l join "syntax-tree" as r on l.attribute = r.id;
let partial_lints = select l.owner as owner, l.file as file, l.item_span as item_span from lints as l join partial as r on l.owner = r.owner;
let bounded = span-bounds(from=partial_lints, span="item_span", start-output="begin", end-output="finish");
let later = select l.owner as owner, l.item_span as item_span from bounded as l join bounded as r on l.owner = r.owner where r.begin < l.begin;
let firsts = antijoin(left=bounded, right=later, left-on=["owner", "item_span"], right-on=["owner", "item_span"]);
let first_lints = select owner as id, file, item_span as span from firsts;
let candidates = union(left=whole_attrs, right=first_lints);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:unnecessary_clippy_cfg|suspicious|all))\s*(?:,|$)");
emit violations subject file key(span);
