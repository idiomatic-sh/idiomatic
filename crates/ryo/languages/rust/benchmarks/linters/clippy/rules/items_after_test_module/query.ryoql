import lint_attributes from "rust/clippy/lint-attributes";
import item_start from "rust/clippy/item-start";
import cfg_test from "rust/clippy/cfg-test";
let containers = select id, file from "syntax-tree" where kind = "source-file" or kind = "item-list";
let items = select l.parent as container, l.child as id, l.ordinal as ordinal, l.file as file from "syntax-child" as l join containers as r on l.parent = r.id where l.field = "items";
let modules = select l.container as container, l.id as id, l.ordinal as ordinal, l.file as file from items as l join "syntax-tree" as r on l.id = r.id where r.kind = "module";
let tests_by_cfg = cfg_test();
let tested = select declaration as id, file from tests_by_cfg;
let tested_modules = select l.container as container, l.id as id, l.ordinal as ordinal, l.file as file from modules as l join tested as r on l.id = r.id;
let inline_modules = select l.container as container, l.id as id, l.ordinal as ordinal, l.file as file from tested_modules as l join "syntax-child" as r on l.id = r.parent where r.field = "item-list";
let preceded = select l.container as container, l.id as id, l.ordinal as ordinal, l.file as file from inline_modules as l join inline_modules as r on l.container = r.container where r.ordinal < l.ordinal;
let firsts = antijoin(left=inline_modules, right=preceded, left-on=["id"], right-on=["id"]);
let afters = select l.id as test, r.id as id, l.file as file from firsts as l join items as r on l.container = r.container where l.ordinal < r.ordinal;
let after_modules = select l.test as test, l.file as file from afters as l join "syntax-tree" as r on l.id = r.id where r.kind = "module" or r.kind = "macro-call";
let expanding = select declaration as id, file from "decorates" where target = "derive" or target = "test";
let after_expanding = select l.test as test, l.file as file from afters as l join expanding as r on l.id = r.id;
let blocked = union(left=after_modules, right=after_expanding);
let after_children = select l.test as test, r.child as id, l.file as file from afters as l join "syntax-child" as r on l.id = r.parent;
let after_candidates = select l.test as test, l.id as id, l.file as file, r.span as span from after_children as l join "syntax-tree" as r on l.id = r.id;
let after_rows = select id, file, span from after_candidates;
let after_kept = lint_attributes(candidates=after_rows, names="(?:^|,)\s*(?:clippy::(?:items_after_test_module|style|all))\s*(?:,|$)");
let after_silenced_rows = antijoin(left=after_candidates, right=after_kept, left-on=["id"], right-on=["id"]);
let after_silenced = select test, file from after_silenced_rows;
let suppressed = union(left=blocked, right=after_silenced);
let followed = project(from=afters, columns=["test", "file"]);
let lintable = antijoin(left=followed, right=suppressed, left-on=["test"], right-on=["test"]);
let tests = select test as id, file from lintable;
let starts = item_start(items=tests);
let named = select l.id as id, l.file as file, l.span as start, r.child as name from starts as l join "syntax-child" as r on l.id = r.parent where r.field = "name";
let ends = select l.id as id, l.file as file, l.start as start, r.span as finish from named as l join "syntax-tree" as r on l.name = r.id;
let spanned = span-between(from=ends, start="start", end="finish", output="span");
let bodies = select l.id as id, l.file as file, l.span as span, r.child as body from spanned as l join "syntax-child" as r on l.id = r.parent where r.field = "item-list";
let body_tokens = select l.body as body, l.file as file, l.span as span, r.child as token from bodies as l join "syntax-child" as r on l.body = r.parent;
let candidates = select l.token as id, l.file as file, l.span as span from body_tokens as l join "syntax-tree" as r on l.token = r.id where r.kind = "l-curly";
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:items_after_test_module|style|all))\s*(?:,|$)");
emit violations subject file key(span);
