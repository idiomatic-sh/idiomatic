import lint_attributes from "rust/clippy/lint-attributes";
let ref_pats = select l.parent as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "ref-kw";
let placed = select l.id as id, l.file as file, r.parent as owner, r.field as field from ref_pats as l join "syntax-child" as r on l.id = r.child;
let pats = select id, file, owner from placed where field = "pat";
let param_pats = select l.id as id, l.file as file, l.owner as param from pats as l join "syntax-tree" as r on l.owner = r.id where r.kind = "param";
let param_lists = select l.id as id, l.file as file, r.parent as list from param_pats as l join "syntax-child" as r on l.param = r.child;
let param_fns = select l.id as id, l.file as file, r.parent as function from param_lists as l join "syntax-child" as r on l.list = r.child;
let bodies = select parent as function, file from "syntax-child" where field = "body";
let fn_nodes = select id as function, file from "syntax-tree" where kind = "fn";
let fn_bodies = select l.function as function, l.file as file from bodies as l join fn_nodes as r on l.function = r.function;
let checked_params = select l.id as id, l.file as file from param_fns as l join fn_bodies as r on l.function = r.function;
let param_candidates = select l.id as id, l.file as file, r.span as span from checked_params as l join "syntax-tree" as r on l.id = r.id;
let let_pats = select l.id as id, l.file as file, l.owner as statement from pats as l join "syntax-tree" as r on l.owner = r.id where r.kind = "let-stmt";
let subpatterns = select l.parent as id, l.file as file from "syntax-child" as l join "syntax-tree" as r on l.child = r.id where r.kind = "at";
let plain_lets = antijoin(left=let_pats, right=subpatterns, left-on=["id"], right-on=["id"]);
let initialized = select l.id as id, l.file as file, r.child as initializer from plain_lets as l join "syntax-child" as r on l.statement = r.parent where r.field = "initializer";
let let_candidates = select l.initializer as id, l.file as file, r.span as span from initialized as l join "syntax-tree" as r on l.id = r.id;
let candidates = union(left=param_candidates, right=let_candidates);
let violations = lint_attributes(candidates=candidates, names="(?:^|,)\s*(?:clippy::(?:toplevel_ref_arg|style|all))\s*(?:,|$)");
emit violations subject file key(span);
