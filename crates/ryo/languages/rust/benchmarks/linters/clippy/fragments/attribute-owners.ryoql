import inner_attributes from "rust/clippy/inner-attributes";
input elements: relation<id: node, file: file>;
output relation<id: node, owner: node, file: file>;
let edges = select l.child as id, l.parent as parent, l.ordinal as ordinal, l.file as file from "syntax-child" as l join elements as r on l.child = r.id;
let parented = select l.id as id, l.parent as parent, l.ordinal as ordinal, r.kind as kind, l.file as file from edges as l join "syntax-tree" as r on l.parent = r.id;
let held = select id, parent as owner, file from parented where kind != "source-file" and kind != "item-list" and kind != "assoc-item-list" and kind != "extern-item-list" and kind != "stmt-list" and kind != "record-field-list" and kind != "tuple-field-list" and kind != "variant-list" and kind != "match-arm-list";
let listed = select id, parent, ordinal, kind, file from parented where kind = "source-file" or kind = "item-list" or kind = "assoc-item-list" or kind = "extern-item-list" or kind = "stmt-list" or kind = "record-field-list" or kind = "tuple-field-list" or kind = "variant-list" or kind = "match-arm-list";
let inner_marks = inner_attributes();
let inner = select l.id as id, l.parent as parent, l.kind as kind, l.file as file from listed as l join inner_marks as r on l.id = r.id;
let crate_level = select id, parent as owner, file from inner where kind = "source-file";
let in_lists = select id, parent, file from inner where kind = "item-list" or kind = "assoc-item-list" or kind = "extern-item-list" or kind = "stmt-list" or kind = "match-arm-list";
let lifted = select l.id as id, r.parent as owner, l.file as file from in_lists as l join "syntax-child" as r on l.parent = r.child;
let lifted_blocks = select l.id as id, l.owner as owner, l.file as file from lifted as l join "syntax-tree" as r on l.owner = r.id where r.kind = "block-expr";
let block_parents = select l.id as id, r.parent as owner, l.file as file from lifted_blocks as l join "syntax-child" as r on l.owner = r.child;
let bodies = select l.id as id, l.owner as owner, l.file as file from block_parents as l join "syntax-tree" as r on l.owner = r.id where r.kind = "fn";
let blocks = antijoin(left=lifted, right=bodies, left-on=["id"], right-on=["id"]);
let inner_lifted = union(left=blocks, right=bodies);
let inner_owned = union(left=crate_level, right=inner_lifted);
let detached = antijoin(left=listed, right=inner_marks, left-on=["id"], right-on=["id"]);
let siblings = select l.id as id, r.child as owner, r.ordinal as ordinal, l.file as file from detached as l join "syntax-child" as r on l.parent = r.parent where r.ordinal > l.ordinal;
let documented = select l.id as id, l.owner as owner, l.ordinal as ordinal, l.file as file from siblings as l join "syntax-tree" as r on l.owner = r.id where r.kind != "whitespace" and r.kind != "comment";
let nearer = select l.id as id, l.owner as owner from documented as l join documented as r on l.id = r.id where r.ordinal < l.ordinal;
let nearest = antijoin(left=documented, right=nearer, left-on=["id", "owner"], right-on=["id", "owner"]);
let detached_owned = select id, owner, file from nearest;
let listed_owned = union(left=inner_owned, right=detached_owned);
let owned = union(left=held, right=listed_owned);
return owned;
