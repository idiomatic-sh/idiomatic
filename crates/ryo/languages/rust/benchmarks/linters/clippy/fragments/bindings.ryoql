output relation<id: node, file: file, span: span, name: symbol, name_span: span, at: number>;
let patterns = select id, file, span from "syntax-tree" where kind = "ident-pat";
let names = select l.parent as pattern, l.child as name from "syntax-child" as l join patterns as r on l.parent = r.id where l.field = "name";
let identifiers = select id, text, span from "syntax-tree" where kind = "ident";
let name_tokens = select l.parent as name, r.text as text, r.span as span from "syntax-child" as l join identifiers as r on l.child = r.id;
let named = select l.pattern as id, r.text as text, r.span as name_span from names as l join name_tokens as r on l.name = r.name;
let spelled = replace(from=named, text="text", pattern="^r#", replacement="", output="name");
let rows = select l.id as id, l.file as file, l.span as span, r.name as name, r.name_span as name_span from patterns as l join spelled as r on l.id = r.id;
let ats = select id from "syntax-tree" where kind = "at";
let subpatterned_ids = select l.parent as id from "syntax-child" as l join ats as r on l.child = r.id;
let bare = antijoin(left=rows, right=subpatterned_ids, left-on=["id"], right-on=["id"]);
let subpatterned = select l.id as id, l.file as file, l.span as span, l.name as name, l.name_span as name_span from rows as l join subpatterned_ids as r on l.id = r.id;
let bare_rows = extend(from=bare, values={at: 0});
let subpatterned_rows = extend(from=subpatterned, values={at: 1});
let bindings = union(left=bare_rows, right=subpatterned_rows);
return bindings;
