import binary_operands from "rust/clippy/binary-operands";
import numeric_constants from "rust/clippy/numeric-constants";
import spanless_eq from "rust/clippy/spanless-eq";
import side_effects from "rust/clippy/side-effects";
output relation<id: node, file: file, span: span, finding: symbol>;
let binaries = binary_operands();
let constants = numeric_constants();
let comparisons = select id, op, left, right, file from binaries where op = "<" or op = "<=" or op = ">" or op = ">=";
let constant_right = select l.id as id, l.op as op, l.left as operand, r.value as value, l.file as file from comparisons as l join constants as r on l.right = r.id;
let variable_left = antijoin(left=constant_right, right=constants, left-on=["operand"], right-on=["id"]);
let constant_left = select l.id as id, l.op as op, l.right as operand, r.value as value, l.file as file from comparisons as l join constants as r on l.left = r.id;
let variable_right = antijoin(left=constant_left, right=constants, left-on=["operand"], right-on=["id"]);
let marked = replace(from=variable_right, text="op", pattern="<", replacement="l", output="marked");
let turned = replace(from=marked, text="marked", pattern=">", replacement="<", output="turned");
let reversed = replace(from=turned, text="turned", pattern="l", replacement=">", output="reversed");
let flipped = select id, reversed as op, operand, value, file from reversed;
let normalized = union(left=variable_left, right=flipped);
let conjunctions = select id, left, right, file, span from binaries where op = "&&";
let left_sides = select l.id as id, l.right as right, l.file as file, l.span as span, r.op as left_op, r.operand as left_operand, r.value as left_value from conjunctions as l join normalized as r on l.left = r.id;
let sides = select l.id as id, l.file as file, l.span as span, l.left_op as left_op, l.left_operand as left_operand, l.left_value as left_value, r.op as right_op, r.operand as right_operand, r.value as right_value from left_sides as l join normalized as r on l.right = r.id;
let operands = select id, left_operand as left, right_operand as right, file, span from sides;
let matching = spanless_eq(pairs=operands);
let lefts = select left as id, file from matching;
let effectful = side_effects(operands=lefts, kinds="^(?:call-expr|method-call-expr|macro-expr|macro-call|block-expr|if-expr|match-expr|closure-expr|loop-expr|while-expr|for-expr|try-expr|await-expr|return-expr|break-expr|continue-expr|yield-expr|yeet-expr|become-expr|let-expr|format-args-expr|asm-expr|underscore-expr)$");
let same = antijoin(left=matching, right=effectful, left-on=["left"], right-on=["id"]);
let compared = select l.id as id, l.file as file, l.span as span, l.left_op as left_op, l.left_value as left_value, l.right_op as right_op, l.right_value as right_value from sides as l join same as r on l.id = r.id;
let at_least = select id, file, span, left_op, right_op from compared where numeric_gte(left_value, right_value);
let at_most = select id, file, span, left_op, right_op from compared where numeric_gte(right_value, left_value);
let equal_all = select id, file, span, left_op, right_op from compared where numeric_gte(left_value, right_value) and numeric_gte(right_value, left_value);
let greater = antijoin(left=at_least, right=equal_all, left-on=["id"], right-on=["id"]);
let less = antijoin(left=at_most, right=equal_all, left-on=["id"], right-on=["id"]);
let equal = select id, file, span, left_op, right_op from equal_all where left_op = "<" or left_op = ">" or right_op = "<" or right_op = ">";
let ordered = union(left=greater, right=less);
let any_order = union(left=ordered, right=equal);
let alike = select id, file, span from any_order where matches(left_op, "^<") and matches(right_op, "^<") or matches(left_op, "^>") and matches(right_op, "^>");
let lesser_low = select id, file, span from less where matches(left_op, "^<") and matches(right_op, "^>");
let greater_high = select id, file, span from greater where matches(left_op, "^>") and matches(right_op, "^<");
let equal_opposed = select id, file, span from equal where matches(left_op, "^<") and matches(right_op, "^>") or matches(left_op, "^>") and matches(right_op, "^<");
let apart = union(left=lesser_low, right=greater_high);
let opposed = union(left=apart, right=equal_opposed);
let redundant = extend(from=alike, values={"finding": "redundant"});
let impossible = extend(from=opposed, values={"finding": "impossible"});
let findings = union(left=redundant, right=impossible);
return findings;
