output relation<id: node, kind: symbol, value: symbol, file: file>;
let numbers = select id, kind, value, file from "numeric-literal";
let parens = select id, file from "syntax-tree" where kind = "paren-expr";
let paren_inner = select l.parent as outer, l.child as inner, l.file as file from "syntax-child" as l join parens as r on l.parent = r.id where l.field = "expr";
let parenthesized_numbers = select l.outer as id, r.kind as kind, r.value as value, l.file as file from paren_inner as l join numbers as r on l.inner = r.id;
let operands = union(left=numbers, right=parenthesized_numbers);
let negatable = select id, file from "syntax-tree" where kind = "prefix-expr" or kind = "literal-pat";
let negatable_children = select l.parent as parent, l.child as child, l.file as file from "syntax-child" as l join negatable as r on l.parent = r.id;
let minus_signs = select l.parent as id, l.file as file from negatable_children as l join "syntax-tree" as r on l.child = r.id where r.kind = "minus";
let operand_children = select l.parent as id, r.kind as kind, r.value as value, l.file as file from negatable_children as l join operands as r on l.child = r.id;
let negated_operands = select l.id as id, l.kind as kind, l.value as value, l.file as file from operand_children as l join minus_signs as r on l.id = r.id;
let negated = replace(from=negated_operands, text="value", pattern="^", replacement="-", output="signed");
let negated_values = select id, kind, signed as value, file from negated;
let parenthesized_negations = select l.outer as id, r.kind as kind, r.value as value, l.file as file from paren_inner as l join negated_values as r on l.inner = r.id;
let pattern_literals = select l.id as id, l.kind as kind, l.value as value, l.file as file from operand_children as l join "syntax-tree" as r on l.id = r.id where r.kind = "literal-pat";
let plain_patterns = antijoin(left=pattern_literals, right=minus_signs, left-on=["id"], right-on=["id"]);
let signed = union(left=negated_values, right=parenthesized_negations);
let expressions = union(left=operands, right=signed);
let constants = union(left=expressions, right=plain_patterns);
return constants;
