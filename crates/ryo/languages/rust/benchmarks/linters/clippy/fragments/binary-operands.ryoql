output relation<id: node, op: symbol, left: node, right: node, file: file, span: span>;
let binaries = select id, file, span from "syntax-tree" where kind = "bin-expr";
let roles = select l.parent as parent, l.child as child, l.field as field, l.file as file from "syntax-child" as l join binaries as r on l.parent = r.id;
let op_tokens = select l.parent as id, r.text as op, l.file as file from roles as l join "syntax-tree" as r on l.child = r.id where l.field = "op";
let left_operands = select parent as id, child as operand, file from roles where field = "lhs";
let right_operands = select parent as id, child as operand, file from roles where field = "rhs";
let parens = select id, file from "syntax-tree" where kind = "paren-expr";
let paren_inner = select l.parent as outer, l.child as inner, l.file as file from "syntax-child" as l join parens as r on l.parent = r.id where l.field = "expr";
let paren_twice = select l.outer as outer, r.inner as inner, l.file as file from paren_inner as l join paren_inner as r on l.inner = r.outer;
let paren_once = antijoin(left=paren_inner, right=parens, left-on=["inner"], right-on=["id"]);
let unwrapped = union(left=paren_once, right=paren_twice);
let left_parenthesized = select l.id as id, r.inner as operand, l.file as file from left_operands as l join unwrapped as r on l.operand = r.outer;
let left_plain = antijoin(left=left_operands, right=parens, left-on=["operand"], right-on=["id"]);
let lefts = union(left=left_parenthesized, right=left_plain);
let right_parenthesized = select l.id as id, r.inner as operand, l.file as file from right_operands as l join unwrapped as r on l.operand = r.outer;
let right_plain = antijoin(left=right_operands, right=parens, left-on=["operand"], right-on=["id"]);
let rights = union(left=right_parenthesized, right=right_plain);
let paren_spans = select id, file, span from "syntax-tree" where kind = "paren-expr";
let nested_parens = select l.inner as id, l.file as file from paren_inner as l join parens as r on l.inner = r.id;
let outermost_parens = antijoin(left=paren_spans, right=nested_parens, left-on=["id"], right-on=["id"]);
let wrapped_binaries = select l.inner as id, l.file as file, r.span as span from unwrapped as l join outermost_parens as r on l.outer = r.id;
let bare_binaries = antijoin(left=binaries, right=wrapped_binaries, left-on=["id"], right-on=["id"]);
let spanned_binaries = union(left=wrapped_binaries, right=bare_binaries);
let with_op = select l.id as id, r.op as op, l.file as file, l.span as span from spanned_binaries as l join op_tokens as r on l.id = r.id;
let with_left = select l.id as id, l.op as op, r.operand as left, l.file as file, l.span as span from with_op as l join lefts as r on l.id = r.id;
let operands = select l.id as id, l.op as op, l.left as left, r.operand as right, l.file as file, l.span as span from with_left as l join rights as r on l.id = r.id;
return operands;
