output relation<id: node, file: file, span: span, operator: symbol, gap: symbol>;
let tree = select id, file from "syntax-tree";
let binaries = select id, file from "syntax-tree" where kind = "bin-expr";
let prefixes = select id, file from "syntax-tree" where kind = "prefix-expr";
let edges = select l.parent as parent, l.child as child, l.field as field, l.file as file from "syntax-child" as l join binaries as r on l.parent = r.id where l.field = "lhs" or l.field = "op" or l.field = "rhs";
let unary_sides = select l.parent as id, l.child as rhs, l.file as file from edges as l join prefixes as r on l.child = r.id where l.field = "rhs";
let operator_edges = select l.child as id, l.parent as binary, r.rhs as rhs, l.file as file from edges as l join unary_sides as r on l.parent = r.id where l.field = "op";
let after_operator = axis(from=operator_edges, relation="syntax-child", direction=next-sibling, domain=prefixes);
let tight = select l.binary as id, l.rhs as rhs, r.text as operator, l.file as file from after_operator as l join "syntax-tree" as r on l.id = r.id where l.related = l.rhs;
let lhs_edges = select l.child as id, l.parent as binary, l.file as file from edges as l join tight as r on l.parent = r.id where l.field = "lhs";
let after_lhs = axis(from=lhs_edges, relation="syntax-child", direction=next-sibling, domain=tree);
let starts = select l.binary as binary, r.span as start, l.file as file from after_lhs as l join "syntax-tree" as r on l.related = r.id;
let operand_edges = select l.child as id, l.parent as rhs, l.file as file from "syntax-child" as l join tight as r on l.parent = r.rhs where l.field = "expr";
let before_operand = axis(from=operand_edges, relation="syntax-child", direction=previous-sibling, domain=tree);
let ends = select l.rhs as rhs, r.span as end, r.text as gap, l.file as file from before_operand as l join "syntax-tree" as r on l.related = r.id;
let started = select l.id as id, l.rhs as rhs, l.operator as operator, r.start as start, l.file as file from tight as l join starts as r on l.id = r.binary;
let bounded = select l.id as id, l.operator as operator, l.start as start, r.end as end, r.gap as gap, l.file as file from started as l join ends as r on l.rhs = r.rhs;
let spanned = span-between(from=bounded, start="start", end="end", output="span");
let found = select id, file, span, operator, gap from spanned;
return found;
