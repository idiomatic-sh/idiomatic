import path_names from "rust/clippy/path-names";
input attributes: relation<id: node, file: file>;
output relation<attribute: node, tree: node, item: node, name: symbol, shape: number, token: node, inner: node, extent: span, begin: number, file: file>;
let tree_nodes = select id, file from "syntax-tree" where kind = "token-tree";
let attribute_trees = axis(from=attributes, relation="syntax-child", direction=descendant, domain=tree_nodes);
let trees = select related as tree, id as attribute, file from attribute_trees;
let slots = select l.tree as tree, l.attribute as attribute, r.child as child, r.ordinal as ordinal, l.file as file from trees as l join "syntax-child" as r on l.tree = r.parent;
let significant = select l.tree as tree, l.attribute as attribute, l.child as child, l.ordinal as ordinal, r.kind as kind, r.text as text, r.span as span, l.file as file from slots as l join "syntax-tree" as r on l.child = r.id where r.kind != "whitespace" and r.kind != "comment";
let unread_openers = select attribute from significant where kind = "l-brack" or kind = "l-curly";
let separators = select tree, child as separator, ordinal as at, file from significant where kind = "l-paren" or kind = "comma";
let members = select tree, attribute, child, ordinal, kind, text, span, file from significant where kind != "l-paren" and kind != "r-paren" and kind != "comma";
let preceding = select l.child as child, r.separator as separator, r.at as at, l.file as file from members as l join separators as r on l.tree = r.tree where r.at < l.ordinal;
let farther = select l.child as child, l.separator as separator from preceding as l join preceding as r on l.child = r.child where r.at > l.at;
let nearest = antijoin(left=preceding, right=farther, left-on=["child", "separator"], right-on=["child", "separator"]);
let placed = select l.tree as tree, l.attribute as attribute, l.child as child, l.ordinal as ordinal, l.kind as kind, l.text as text, l.span as span, r.separator as item, l.file as file from members as l join nearest as r on l.child = r.child;
let path_members = select tree, attribute, child, ordinal, span, item, file from placed where kind = "ident" or kind = "colon" or kind = "self-kw" or kind = "super-kw" or kind = "crate-kw";
let tails = antijoin(left=placed, right=path_members, left-on=["child"], right-on=["child"]);
let literal_members = select child from placed where kind = "string" or kind = "byte-string" or kind = "c-string" or kind = "char" or kind = "byte" or kind = "int-number" or kind = "float-number" or kind = "true-kw" or kind = "false-kw";
let later_tails = select l.child as child from tails as l join tails as r on l.item = r.item where r.ordinal < l.ordinal;
let first_tails = antijoin(left=tails, right=later_tails, left-on=["child"], right-on=["child"]);
let second_tails = antijoin(left=tails, right=first_tails, left-on=["child"], right-on=["child"]);
let tail_counts = group-count(from=tails, keys=["item", "file"], count="tails");
let trailing_paths = select l.item as item from path_members as l join first_tails as r on l.item = r.item where l.ordinal > r.ordinal;
let pathed = project(from=path_members, columns=["tree", "attribute", "item", "file"]);
let headed = antijoin(left=pathed, right=trailing_paths, left-on=["item"], right-on=["item"]);
let words = antijoin(left=headed, right=tails, left-on=["item"], right-on=["item"]);
let single_tails = select l.item as item, l.kind as kind, l.child as child from first_tails as l join tail_counts as r on l.item = r.item where r.tails = 1;
let list_tails = select l.tree as tree, l.attribute as attribute, l.item as item, r.child as child, l.file as file from headed as l join single_tails as r on l.item = r.item where r.kind = "token-tree";
let double_tails = select l.item as item, l.child as child from first_tails as l join tail_counts as r on l.item = r.item where r.tails = 2 and l.kind = "eq";
let literal_seconds = select l.item as item, r.child as child, r.kind as kind, r.text as text from double_tails as l join second_tails as r on l.item = r.item;
let literal_tails = select l.item as item, l.kind as kind, l.child as token from literal_seconds as l join literal_members as r on l.child = r.child;
let valued = select l.tree as tree, l.attribute as attribute, l.item as item, r.kind as kind, r.token as token, l.file as file from headed as l join literal_tails as r on l.item = r.item;
let bare_literals = select l.item as item from single_tails as l join literal_members as r on l.child = r.child;
let bare_items = antijoin(left=bare_literals, right=pathed, left-on=["item"], right-on=["item"]);
let read_words = select item from words;
let read_lists = select item from list_tails;
let read_values = select item from valued;
let read_some = union(left=read_words, right=read_lists);
let read_more = union(left=read_some, right=read_values);
let read_items = union(left=read_more, right=bare_items);
let unread_items = antijoin(left=placed, right=read_items, left-on=["item"], right-on=["item"]);
let unread_item_attributes = select attribute from unread_items;
let member_after = select l.attribute as attribute, l.child as child, l.kind as kind, r.child as next, r.ordinal as next_at, r.kind as next_kind from placed as l join placed as r on l.item = r.item where r.ordinal > l.ordinal;
let member_beyond = select l.child as child, l.next as next from member_after as l join member_after as r on l.child = r.child where r.next_at < l.next_at;
let adjacent = antijoin(left=member_after, right=member_beyond, left-on=["child", "next"], right-on=["child", "next"]);
let joined_segments = select attribute from adjacent where (kind = "ident" or kind = "self-kw" or kind = "super-kw" or kind = "crate-kw") and (next_kind = "ident" or next_kind = "self-kw" or next_kind = "super-kw" or next_kind = "crate-kw");
let colon_pairs = select attribute, child, next from adjacent where kind = "colon" and next_kind = "colon";
let pair_ends = select l.attribute as attribute, l.child as child, r.next_kind as next_kind from colon_pairs as l join adjacent as r on l.next = r.child;
let led_pairs = select attribute, child from pair_ends where next_kind = "ident" or next_kind = "self-kw" or next_kind = "super-kw" or next_kind = "crate-kw";
let pair_attributes = select attribute, child from colon_pairs;
let open_pairs = antijoin(left=pair_attributes, right=led_pairs, left-on=["child"], right-on=["child"]);
let open_pair_attributes = select attribute from open_pairs;
let paired_firsts = select child from colon_pairs;
let paired_seconds = select next as child from colon_pairs;
let paired = union(left=paired_firsts, right=paired_seconds);
let colons = select attribute, child from placed where kind = "colon";
let lone_colons = antijoin(left=colons, right=paired, left-on=["child"], right-on=["child"]);
let lone_colon_attributes = select attribute from lone_colons;
let unread_separators = union(left=lone_colon_attributes, right=open_pair_attributes);
let unread_paths = union(left=joined_segments, right=unread_separators);
let unread_shapes = union(left=unread_item_attributes, right=unread_openers);
let unread = union(left=unread_shapes, right=unread_paths);
let path_later = select l.child as child from path_members as l join path_members as r on l.item = r.item where r.ordinal < l.ordinal;
let path_firsts = antijoin(left=path_members, right=path_later, left-on=["child"], right-on=["child"]);
let member_later = select l.child as child from placed as l join placed as r on l.item = r.item where r.ordinal < l.ordinal;
let member_earlier = select l.child as child from placed as l join placed as r on l.item = r.item where r.ordinal > l.ordinal;
let member_firsts = antijoin(left=placed, right=member_later, left-on=["child"], right-on=["child"]);
let member_lasts = antijoin(left=placed, right=member_earlier, left-on=["child"], right-on=["child"]);
let item_ends = select l.tree as tree, l.item as item, l.span as first_span, r.span as last_span, l.file as file from member_firsts as l join member_lasts as r on l.item = r.item;
let item_extents = span-between(from=item_ends, start="first_span", end="last_span", output="extent");
let item_bounds = span-bounds(from=item_extents, span="extent", start-output="begin", end-output="finish");
let path_rows = path_names();
let first_names = select l.item as item, r.name as name from path_firsts as l join path_rows as r on l.child = r.id;
let named = select l.item as item, r.name as name, l.extent as extent, l.begin as begin, l.file as file from item_bounds as l join first_names as r on l.item = r.item;
let word_rows = select l.attribute as attribute, l.tree as tree, l.item as item, r.name as name, l.item as token, l.item as inner, r.extent as extent, r.begin as begin, l.file as file from words as l join named as r on l.item = r.item;
let word_shaped = extend(from=word_rows, values={shape: 0});
let list_rows = select l.attribute as attribute, l.tree as tree, l.item as item, r.name as name, l.item as token, l.child as inner, r.extent as extent, r.begin as begin, l.file as file from list_tails as l join named as r on l.item = r.item;
let list_shaped = extend(from=list_rows, values={shape: 1});
let value_rows = select l.attribute as attribute, l.tree as tree, l.item as item, r.name as name, l.kind as kind, l.token as token, l.item as inner, r.extent as extent, r.begin as begin, l.file as file from valued as l join named as r on l.item = r.item;
let string_rows = select attribute, tree, item, name, token, inner, extent, begin, file from value_rows where kind = "string";
let string_shaped = extend(from=string_rows, values={shape: 2});
let literal_rows = select attribute, tree, item, name, token, inner, extent, begin, file from value_rows where kind != "string";
let literal_shaped = extend(from=literal_rows, values={shape: 3});
let named_shapes = union(left=word_shaped, right=list_shaped);
let valued_shapes = union(left=string_shaped, right=literal_shaped);
let shaped = union(left=named_shapes, right=valued_shapes);
let read = antijoin(left=shaped, right=unread, left-on=["attribute"], right-on=["attribute"]);
let items = select attribute, tree, item, name, shape, token, inner, extent, begin, file from read;
return items;
