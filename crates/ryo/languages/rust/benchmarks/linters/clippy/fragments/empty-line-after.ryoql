import attribute_owners from "rust/clippy/attribute-owners";
import inner_attributes from "rust/clippy/inner-attributes";
import doc_comments from "rust/clippy/doc-comments";
import item_heads from "rust/clippy/item-heads";
import hulls from "rust/clippy/hulls";
output relation<head: node, stop: node, file: file, span: span>;
let items = select id, file from "syntax-tree" where kind = "fn" or kind = "struct" or kind = "enum" or kind = "union" or kind = "trait" or kind = "impl" or kind = "module" or kind = "use" or kind = "extern-crate" or kind = "const" or kind = "static" or kind = "type-alias" or kind = "macro-rules" or kind = "macro-def" or kind = "extern-block";
let item_parents = select l.id as id, r.parent as parent, l.file as file from items as l join "syntax-child" as r on l.id = r.child;
let foreign = select l.id as id, l.file as file from item_parents as l join "syntax-tree" as r on l.parent = r.id where r.kind = "extern-item-list";
let checked = antijoin(left=items, right=foreign, left-on=["id"], right-on=["id"]);
let attributes = select occurrence as id, file, span from "decorates" where target != "derive" and target != "test";
let docs = doc_comments();
let doc_rows = select id, file, span from docs;
let marked = union(left=attributes, right=doc_rows);
let inner_marks = inner_attributes();
let stops = antijoin(left=marked, right=inner_marks, left-on=["id"], right-on=["id"]);
let stop_ids = select id, file from stops;
let owners = attribute_owners(elements=stop_ids);
let owned = select l.owner as owner, l.id as id, r.file as file, r.span as span from owners as l join stops as r on l.id = r.id;
let item_stops = select l.owner as owner, l.id as id, l.file as file, l.span as span from owned as l join checked as r on l.owner = r.id;
let first_stops = hulls(members=item_stops);
let heads = item_heads(items=checked);
let ends = select l.owner as owner, r.head as head, l.file as file, l.span as stops_span, r.span as head_span from first_stops as l join heads as r on l.owner = r.id;
let regions = span-between(from=ends, start="stops_span", end="head_span", output="region");
let region_bounds = span-bounds(from=regions, span="region", start-output="begin", end-output="finish");
let blank_runs = select id, file, span from "syntax-tree" where kind = "whitespace" and matches(text, "\n[ \t\r]*\n");
let run_bounds = span-bounds(from=blank_runs, span="span", start-output="begin", end-output="finish");
let item_runs = select l.owner as owner, l.head as head, r.span as span, r.begin as run_begin, l.file as file from region_bounds as l join run_bounds as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let segments = source-matches(from=item_runs, span="span", pattern="(?P<line>[^\n]*)\n", output="segment", capture="line", capture-output="line_span");
let line_bounds = span-bounds(from=segments, span="line_span", start-output="line_begin", end-output="line_end");
let blank_lines = select owner, head, file, line_span, line_begin from line_bounds where line_begin > run_begin;
let later_lines = select l.owner as owner, l.line_span as line_span from blank_lines as l join blank_lines as r on l.owner = r.owner where r.line_begin < l.line_begin;
let first_lines = antijoin(left=blank_lines, right=later_lines, left-on=["owner", "line_span"], right-on=["owner", "line_span"]);
let earlier_lines = select l.owner as owner, l.line_span as line_span from blank_lines as l join blank_lines as r on l.owner = r.owner where r.line_begin > l.line_begin;
let last_lines = antijoin(left=blank_lines, right=earlier_lines, left-on=["owner", "line_span"], right-on=["owner", "line_span"]);
let stop_bounds = span-bounds(from=item_stops, span="span", start-output="stop_begin", end-output="stop_end");
let before = select l.owner as owner, l.id as stop, l.span as stop_span, l.stop_end as stop_end, l.file as file from stop_bounds as l join first_lines as r on l.owner = r.owner where l.stop_end <= r.line_begin;
let nearer = select l.owner as owner, l.stop as stop from before as l join before as r on l.owner = r.owner where r.stop_end > l.stop_end;
let previous = antijoin(left=before, right=nearer, left-on=["owner", "stop"], right-on=["owner", "stop"]);
let reported = select l.owner as owner, r.head as head, l.stop as stop, l.file as file, l.stop_span as stop_span, r.line_span as line_span from previous as l join last_lines as r on l.owner = r.owner;
let spanned = span-between(from=reported, start="stop_span", end="line_span", output="whole");
let found = select head, stop, file, whole as span from spanned;
return found;
