import suppress from "python/ruff/suppress";
let imports = select occurrence as alias, binding, target, file from "static-import";
let allowed = select * from imports where matches(target, "^(?:builtins|six\.moves\.builtins)\.(?:\*|ascii|bytes|chr|dict|filter|hex|input|int|isinstance|list|map|max|min|next|object|oct|open|pow|range|round|str|super|zip)$") or target = "builtins" or target = "io.open" or target = "six.callable" or target = "six.next" or target = "six.moves.filter" or target = "six.moves.input" or target = "six.moves.map" or target = "six.moves.range" or target = "six.moves.zip";
let aliases_with_asname = select parent as alias from "semantic-child" where field = "asname";
let unaliased = antijoin(left=allowed,right=aliases_with_asname,left-on=["alias"],right-on=["alias"]);
let alias_bindings = select alias, target, file, alias as binding from unaliased;
let shadowed = select binding, previous from "binding-shadow" where relationship = "replacement";
let previous = select binding, previous from shadowed;
let real_bindings = select occurrence as binding from "binding-event" where kind = "bind";
let local_shadow_rows = select l.binding as binding from previous as l join real_bindings as r on l.previous = r.binding;
let no_local_shadow = antijoin(left=alias_bindings,right=local_shadow_rows,left-on=["binding"],right-on=["binding"]);
let aliases = select parent as statement, child as alias from "semantic-child" where field = "names";
let parent_imports = select l.statement as statement, l.alias as alias, r.file as file, r.span as span from aliases as l join "semantic-syntax" as r on l.statement = r.id;
let selected_aliases = select r.statement as statement, l.alias as alias, r.file as file, r.span as span from no_local_shadow as l join parent_imports as r on l.alias = r.alias and l.file = r.file;
let statement_counts = group-count(from=selected_aliases, keys=["statement"], count="count", distinct="alias");
let import_statements = select id, file, span from "semantic-syntax" where kind = "import-from";
let reportable_rows = select l.statement as id, r.file as file, r.span as span from statement_counts as l join import_statements as r on l.statement = r.id;
let reportable = select id, file, span from reportable_rows;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP029(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP029)(?:,|$)");
emit violations subject file key(id);
