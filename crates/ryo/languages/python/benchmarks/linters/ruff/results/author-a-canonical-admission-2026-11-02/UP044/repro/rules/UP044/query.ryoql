import unpack from "python/ruff/unpack-symbols";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select l.id as id, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let inputs = select value as id, file from values;
let unpack_names = unpack(expressions=inputs);
let unpack_subscripts = select l.id as id, l.file as file from values as l join unpack_names as r on l.value = r.id and l.file = r.file;
let slices = select l.id as id, r.child as slice, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let unpack_slices = select l.id as id, r.slice as slice, l.file as file from unpack_subscripts as l join slices as r on l.id = r.id and l.file = r.file;
let valid_slices = select l.id as id, l.file as file from unpack_slices as l join nodes as r on l.slice = r.id and l.file = r.file where r.kind = "name" or r.kind = "attribute" or r.kind = "subscript";
let direct_index = select l.id as id, l.file as file from valid_slices as l join slices as r on l.id = r.slice and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.slice as id, l.file as file from slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_elements = select r.child as id, l.file as file from tuple_slices as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let tuple_index = select l.id as id, l.file as file from valid_slices as l join tuple_elements as r on l.id = r.id and l.file = r.file;
let varargs = select child as parameter, file from "semantic-child" where field = "vararg";
let vararg_annotations = select r.child as id, l.file as file from varargs as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let vararg = select l.id as id, l.file as file from valid_slices as l join vararg_annotations as r on l.id = r.id and l.file = r.file;
let contexts0 = union(left=direct_index, right=tuple_index);
let contexts = union(left=contexts0, right=vararg);
let targets = select file from "language-target" where major = 3 and minor >= 11;
let eligible = select l.id as id, l.file as file from contexts as l join targets as r on l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from eligible as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP044(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP044)(?:,|$)");
emit violations subject file key(id);
