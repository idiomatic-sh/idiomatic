import symbols from "python/ruff/modernization-symbols";
import annotation_context from "python/ruff/annotation-evaluation-context";
input source_nodes: relation<id: node, file: file>;
output relation<id: node, operator: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let subscripts0 = select id, file from nodes where kind = "subscript";
let subscripts = select l.id as id, l.file as file from subscripts0 as l join source_nodes as r on l.id = r.id and l.file = r.file;
let values = select l.id as id, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let slices = select l.id as id, r.child as slice, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let named_inputs = select id, file from nodes where kind = "name" or kind = "attribute";
let known = symbols(expressions=named_inputs);
let operators = select l.id as id, r.kind as operator, l.file as file from values as l join known as r on l.value = r.id and l.file = r.file where r.kind = "union" or r.kind = "optional";
let candidates = select l.id as id, l.operator as operator, r.slice as slice, l.file as file from operators as l join slices as r on l.id = r.id and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_children = select l.id as source, r.child as target, l.file as file from tuples as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let starts = select slice as id, file from candidates;
let tuple_paths = closure(edges=tuple_children, source="source", destination="target", keys=["file"]);
let tuple_members = select l.id as slice, r.target as member, l.file as file from starts as l join tuple_paths as r on l.id = r.source and l.file = r.file;
let own_members = select id as slice, id as member, file from starts;
let members = union(left=tuple_members, right=own_members);
let starred = select id, file from nodes where kind = "starred";
let starred_members = select l.slice as slice, l.file as file from members as l join starred as r on l.member = r.id and l.file = r.file;
let has_star = select l.id as id, l.file as file from candidates as l join starred_members as r on l.slice = r.slice and l.file = r.file;
let strings = select id, file from "literal-properties" where kind = "string";
let quoted_members = select l.slice as slice, l.file as file from members as l join strings as r on l.member = r.id and l.file = r.file;
let has_quote = select l.id as id, l.file as file from candidates as l join quoted_members as r on l.slice = r.slice and l.file = r.file;
let contexts = annotation_context(expressions=subscripts);
let nonruntime0 = select id, file from contexts where evaluation = "postponed" or evaluation = "unevaluated" or evaluation = "deferred";
let stubs = select id, file from subscripts where ends_with(file, ".pyi");
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_axes = axis(from=subscripts, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let embedded_nested = select id, file from embedded_axes;
let embedded_own = select l.id as id, l.file as file from subscripts as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let embedded = union(left=embedded_nested, right=embedded_own);
let checking = select id, file from known where kind = "type-checking";
let ifs = select id, file from nodes where kind = "if";
let if_tests = select l.id as id, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let checking_ifs = select l.id as id, l.file as file from if_tests as l join checking as r on l.test = r.id and l.file = r.file;
let checking_bodies = select r.child as id, l.file as file from checking_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let checking_axes = axis(from=subscripts, relation="semantic-child", direction=ancestor, domain=checking_bodies);
let checking_members = select id, file from checking_axes;
let nonruntime1 = union(left=nonruntime0, right=stubs);
let nonruntime2 = union(left=embedded, right=checking_members);
let nonruntime = union(left=nonruntime1, right=nonruntime2);
let runtime_quotes = antijoin(left=has_quote, right=nonruntime, left-on=["id", "file"], right-on=["id", "file"]);
let malformed0 = union(left=has_star, right=runtime_quotes);
let named_tuples = select id, file from known where kind = "named-tuple";
let direct_named = select l.id as id, l.file as file from candidates as l join named_tuples as r on l.slice = r.id and l.file = r.file;
let union_candidates = select id, slice, file from candidates where operator = "union";
let direct_tuple_members = select l.id as id, r.target as member, l.file as file from union_candidates as l join tuple_children as r on l.slice = r.source and l.file = r.file;
let union_named = select l.id as id, l.file as file from direct_tuple_members as l join named_tuples as r on l.member = r.id and l.file = r.file;
let malformed1 = union(left=direct_named, right=union_named);
let malformed = union(left=malformed0, right=malformed1);
let acceptable = antijoin(left=candidates, right=malformed, left-on=["id", "file"], right-on=["id", "file"]);
let modern_files = select file from "language-target" where major = 3 and minor >= 10;
let modern = select l.id as id, l.operator as operator, l.file as file from acceptable as l join modern_files as r on l.file = r.file;
let stub_rows = select l.id as id, l.operator as operator, l.file as file from acceptable as l join stubs as r on l.id = r.id and l.file = r.file;
let future_files = select file from "compiler-feature" where feature = "python.future-annotations" and enabled = "true";
let legacy_files0 = select file from "language-target" where major = 3 and minor >= 7 and minor < 10;
let legacy_files = select l.file as file from legacy_files0 as l join future_files as r on l.file = r.file;
let annotated = select id, file from contexts;
let legacy_contexts = union(left=annotated, right=embedded);
let legacy_candidates = select l.id as id, l.operator as operator, l.file as file from acceptable as l join legacy_files as r on l.file = r.file;
let legacy = select l.id as id, l.operator as operator, l.file as file from legacy_candidates as l join legacy_contexts as r on l.id = r.id and l.file = r.file;
let result0 = union(left=modern, right=stub_rows);
let result = union(left=result0, right=legacy);
return result;
