input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let bare = select l.id as id, l.id as root, l.file as file from expressions as l join names as r on l.id = r.id and l.file = r.file;
let attribute_values = select l.id as id, r.child as root, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let simple_attributes0 = select l.id as id, l.root as root, l.file as file from attribute_values as l join names as r on l.root = r.id and l.file = r.file;
let simple_attributes = select l.id as id, l.root as root, l.file as file from simple_attributes0 as l join expressions as r on l.id = r.id and l.file = r.file;
let roots = union(left=bare, right=simple_attributes);
let unique_reads = select reference, file from "binding-read" where state = "unique-declaration";
let unique_uses0 = select reference, binding, file from "binding-use" where certainty = "unique";
let unique_uses = select l.reference as reference, l.binding as binding, l.file as file from unique_uses0 as l join unique_reads as r on l.reference = r.reference and l.file = r.file;
let imported_roots = select l.id as id, l.root as root, r.binding as binding, l.file as file from roots as l join unique_uses as r on l.root = r.reference and l.file = r.file;
let imports = select l.id as id, l.root as root, l.binding as binding, r.target as target, l.file as file from imported_roots as l join "static-import" as r on l.binding = r.occurrence and l.file = r.file;
let bare_imports = select l.id as id, l.target as target, l.file as file from imports as l join bare as r on l.id = r.id and l.file = r.file;
let bare_unpack = select id, file from bare_imports where target = "typing.Unpack" or target = "typing_extensions.Unpack";
let modules = select id, file from imports where target = "typing" or target = "typing_extensions";
let labels0 = select l.id as id, r.child as label, l.file as file from simple_attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let labels = select l.id as id, l.file as file from labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "Unpack";
let attr_unpack = select l.id as id, l.file as file from labels as l join modules as r on l.id = r.id and l.file = r.file;
let result = union(left=bare_unpack, right=attr_unpack);
return result;
