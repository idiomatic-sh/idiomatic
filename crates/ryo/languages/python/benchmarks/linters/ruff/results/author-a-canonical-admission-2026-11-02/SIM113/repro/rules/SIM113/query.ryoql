import assigned_values from "python/ruff/assigned-values";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, text, file from "semantic-syntax";
let loops = select id, file from nodes where kind = "for";
let bodies = select l.id as loop, r.child as statement, l.file as file from loops as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let augments = select id, file from nodes where kind = "aug-assign";
let direct_augments = select l.loop as loop, l.statement as id, l.file as file from bodies as l join augments as r on l.statement = r.id and l.file = r.file;
let targets = select l.loop as loop, l.id as id, r.child as reference, l.file as file from direct_augments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let names = select id, file from nodes where kind = "name";
let name_targets = select l.loop as loop, l.id as id, l.reference as reference, l.file as file from targets as l join names as r on l.reference = r.id and l.file = r.file;
let value_edges = select l.id as id, r.child as value, l.file as file from direct_augments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let integers = select id, file from "literal-properties" where kind = "integer";
let values = select l.id as id, l.value as value, l.file as file from value_edges as l join integers as r on l.value = r.id and l.file = r.file;
let value_positions = select l.id as id, l.file as file, r."start-byte" as start, r."end-byte" as end from values as l join "source-location" as r on l.value = r.id and l.file = r.file;
let number_tokens = select l.text as text, l.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id and l.file = r.file where l.text != "";
let value_tokens = select l.id as id, l.file as file, r.text as text from value_positions as l join number_tokens as r on l.start = r.start and l.end = r.end and l.file = r.file;
let clean_values = replace(from=value_tokens, text="text", pattern="_", replacement="", output="clean");
let ones = select id, file from clean_values where matches(clean, "^(?:0*1|0[xX]0*1|0[oO]0*1|0[bB]0*1)$");
let additions = select id, file from nodes where text = "+" or text = "+=";
let op_edges = select parent as id, child as op, file from "semantic-child" where field = "op";
let add_augments = select l.id as id, l.file as file from op_edges as l join additions as r on l.op = r.id and l.file = r.file;
let increment_shapes = select l.loop as loop, l.id as id, l.reference as reference, l.file as file from name_targets as l join ones as r on l.id = r.id and l.file = r.file;
let increments0 = select l.loop as loop, l.id as id, l.reference as reference, l.file as file from increment_shapes as l join add_augments as r on l.id = r.id and l.file = r.file;
let read_events = select occurrence, name, scope, phase, ordinal, file from "binding-event" where kind = "read";
let increments = select l.loop as loop, l.id as id, l.reference as reference, r.name as name, r.scope as scope, l.file as file from increments0 as l join read_events as r on l.reference = r.occurrence and l.file = r.file;
let declarations = select occurrence as id, name, scope, file from "binding-event" where kind = "global" or kind = "nonlocal";
let directed = select l.id as id, l.file as file from increments as l join declarations as r on l.name = r.name and l.scope = r.scope and l.file = r.file;
let uses = select reference, binding, file from "binding-use";
let initializer_uses = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, r.binding as binding, l.file as file from increments as l join uses as r on l.reference = r.reference and l.file = r.file;
let assignments = select id, file from nodes where kind = "assign" or kind = "ann-assign";
let init_targets = select l.id as statement, r.child as binding, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets" or r.field = "target";
let init_values = select l.id as statement, r.child as value, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let zeros = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let zero_assignments = select l.statement as statement, l.file as file from init_values as l join zeros as r on l.value = r.id and l.file = r.file;
let init_zero_direct = select l.binding as binding, l.statement as statement, l.file as file from init_targets as l join zero_assignments as r on l.statement = r.statement and l.file = r.file;
let assigned = assigned_values();
let assigned_zero = select l.binding as binding, l.file as file from assigned as l join zeros as r on l.value = r.id and l.file = r.file;
let target_shapes = select id, file from nodes where kind = "name" or kind = "tuple" or kind = "list";
let valid_target_roots = select l.statement as statement, l.binding as root, l.file as file from init_targets as l join target_shapes as r on l.binding = r.id and l.file = r.file;
let target_root_ids = select root as id, file from valid_target_roots;
let assigned_bindings = select binding as id, file from assigned_zero;
let nested_targets = axis(from=assigned_bindings, relation="semantic-child", direction=nearest-ancestor, domain=target_root_ids);
let nested_init_zero = select l.id as binding, r.statement as statement, l.file as file from nested_targets as l join valid_target_roots as r on l.related = r.root and l.file = r.file;
let init_zero = union(left=init_zero_direct, right=nested_init_zero);
let candidate_initializers = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, r.statement as initializer, l.file as file from initializer_uses as l join init_zero as r on l.binding = r.binding and l.file = r.file;
let statement_edges = select parent, child, field, file from "semantic-child";
let loop_parents = select l.id as loop, r.parent as parent, r.field as field, l.file as file from loops as l join statement_edges as r on l.id = r.child and l.file = r.file;
let same_level0 = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, l.initializer as initializer, r.parent as parent, r.field as field, l.file as file from candidate_initializers as l join statement_edges as r on l.initializer = r.child and l.file = r.file;
let same_level = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, l.initializer as initializer, l.file as file from same_level0 as l join loop_parents as r on l.loop = r.loop and l.parent = r.parent and l.field = r.field and l.file = r.file;
let located_loops = select l.id as loop, l.file as file, r."start-byte" as start, r."end-byte" as end from loops as l join "source-location" as r on l.id = r.id and l.file = r.file;
let before_loop = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, l.initializer as initializer, l.file as file, r."start-byte" as init_start from same_level as l join "source-location" as r on l.initializer = r.id and l.file = r.file;
let initializers = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, l.initializer as initializer, l.init_start as init_start, l.file as file from before_loop as l join located_loops as r on l.loop = r.loop and l.file = r.file where l.init_start < r.start;
let competing_initializers = select l.id as id, l.file as file from initializers as l join initializer_uses as r on l.id = r.id and l.file = r.file where r.binding != l.binding and r.binding != l.reference;
let init_stores = select occurrence, name, scope, phase, ordinal, file from "binding-event" where kind = "bind";
let matching_initializers = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, r.phase as phase, r.ordinal as init_ordinal, l.file as file from initializers as l join init_stores as r on l.binding = r.occurrence and l.scope = r.scope and l.file = r.file;
let same_phase = select l.loop as loop, l.id as id, l.reference as reference, l.name as name, l.scope as scope, l.binding as binding, l.phase as phase, l.init_ordinal as init_ordinal, r.ordinal as read_ordinal, l.file as file from matching_initializers as l join read_events as r on l.reference = r.occurrence and l.phase = r.phase and l.file = r.file where l.init_ordinal < r.ordinal;
let missing_entry_candidates = antijoin(left=initializers, right=same_phase, left-on=["id", "binding", "file"], right-on=["id", "binding", "file"]);
let missing_entry_identity = select id, file from missing_entry_candidates;
let mutations = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup" or kind = "wildcard";
let intervening0 = select l.loop as loop, l.id as id, r.occurrence as mutation, l.file as file from same_phase as l join mutations as r on l.scope = r.scope and l.phase = r.phase and l.file = r.file where r.ordinal > l.init_ordinal and r.ordinal < l.read_ordinal and (l.name = r.name or r.kind = "wildcard");
let intervening1 = select l.loop as loop, l.id as id, l.file as file, r."start-byte" as start from intervening0 as l join "source-location" as r on l.mutation = r.id and l.file = r.file;
let intervening = select l.id as id, l.file as file from intervening1 as l join located_loops as r on l.loop = r.loop and l.file = r.file where l.start < r.start;
let cross_phase_mutations = select l.id as id, l.file as file from same_phase as l join mutations as r on l.scope = r.scope and l.file = r.file where l.phase != r.phase and (l.name = r.name or r.kind = "wildcard");
let entry_blockers0 = union(left=missing_entry_identity, right=intervening);
let entry_blockers = union(left=entry_blockers0, right=cross_phase_mutations);
let binds = select occurrence as binding, name, scope, file from "binding-event" where kind = "bind";
let other_bindings0 = select l.id as id, l.loop as loop, r.binding as binding, l.file as file from initializers as l join binds as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.reference != r.binding;
let other_bindings1 = select l.id as id, l.loop as loop, l.file as file, r."start-byte" as start from other_bindings0 as l join "source-location" as r on l.binding = r.id and l.file = r.file;
let inner_binds = select l.id as id, l.file as file from other_bindings1 as l join located_loops as r on l.loop = r.loop and l.file = r.file where l.start >= r.start and l.start < r.end;
let initializers_with_phase = select l.id as id, l.loop as loop, l.reference as reference, l.binding as binding, l.init_start as init_start, r.phase as phase, l.file as file from initializers as l join same_phase as r on l.id = r.id and l.binding = r.binding and l.file = r.file;
let post_increment_uses = select l.id as id, l.loop as loop, l.init_start as init_start, l.phase as initial_phase, r.reference as use, l.file as file from initializers_with_phase as l join uses as r on l.reference = r.binding and l.file = r.file;
let post_initializer_uses = select l.id as id, l.loop as loop, l.init_start as init_start, l.phase as initial_phase, r.reference as use, l.file as file from initializers_with_phase as l join uses as r on l.binding = r.binding and l.file = r.file;
let post_uses0 = union(left=post_increment_uses, right=post_initializer_uses);
let post_uses1 = select l.id as id, l.loop as loop, l.init_start as init_start, l.initial_phase as initial_phase, l.use as use, r.phase as use_phase, l.file as file from post_uses0 as l join read_events as r on l.use = r.occurrence and l.file = r.file;
let post_uses2 = select l.id as id, l.loop as loop, l.init_start as init_start, l.initial_phase as initial_phase, l.use_phase as use_phase, l.file as file, r."start-byte" as start from post_uses1 as l join "source-location" as r on l.use = r.id and l.file = r.file;
let outer_uses = select l.id as id, l.file as file from post_uses2 as l join located_loops as r on l.loop = r.loop and l.file = r.file where l.use_phase != l.initial_phase or (l.start >= l.init_start and (l.start < r.start or l.start >= r.end));
let continues = select id, file from nodes where kind = "continue";
let scope_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let continue_scopes = axis(from=continues, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let loop_scopes = axis(from=loops, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let continue_owners = axis(from=continues, relation="semantic-child", direction=ancestor, domain=loops);
let scoped_continues = select l.id as id, l.related as loop, r.related as scope, l.file as file from continue_owners as l join continue_scopes as r on l.id = r.id and l.file = r.file;
let module_continues = antijoin(left=continue_owners, right=continue_scopes, left-on=["id", "file"], right-on=["id", "file"]);
let module_loop_continues = antijoin(left=module_continues, right=loop_scopes, left-on=["related", "file"], right-on=["id", "file"]);
let nested_continues = select l.loop as loop, l.file as file from scoped_continues as l join loop_scopes as r on l.loop = r.id and l.scope = r.related and l.file = r.file;
let module_continue_loops = select related as loop, file from module_loop_continues;
let continue_blockers = union(left=nested_continues, right=module_continue_loops);
let continue_loops = select l.id as id, l.file as file from initializers as l join continue_blockers as r on l.loop = r.loop and l.file = r.file;
let declaration_blockers0 = union(left=directed, right=competing_initializers);
let declaration_blockers = union(left=declaration_blockers0, right=entry_blockers);
let invalid0 = union(left=declaration_blockers, right=inner_binds);
let invalid1 = union(left=outer_uses, right=continue_loops);
let invalid = union(left=invalid0, right=invalid1);
let valid = antijoin(left=initializers, right=invalid, left-on=["id", "file"], right-on=["id", "file"]);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from valid as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])SIM113(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM113)(?:,|$)");
emit violations subject file key(id);
