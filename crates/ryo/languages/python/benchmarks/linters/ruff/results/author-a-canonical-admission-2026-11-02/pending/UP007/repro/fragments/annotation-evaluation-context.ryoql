import future_context from "python/ruff/future-annotation-context";
input expressions: relation<id: node, file: file>;
output relation<id: node, file: file, evaluation: symbol>;
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let parameters = select id, file from nodes where kind = "arg";
let parameter_roots0 = select r.child as id, l.file as file from parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_owners = axis(from=parameter_roots0, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let parameter_roots = select id, file from parameter_owners;
let return_roots = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let signature_roots = union(left=parameter_roots, right=return_roots);
let assignments = select id, file from nodes where kind = "ann-assign";
let variable_roots = select l.id as assignment, r.child as id, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let scopes = select id, kind, file from nodes where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let variable_scopes0 = axis(from=assignments, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let variable_scopes = select l.id as assignment, r.kind as kind, l.file as file from variable_scopes0 as l join scopes as r on l.related = r.id and l.file = r.file;
let local_variables = select l.id as id, l.file as file from variable_roots as l join variable_scopes as r on l.assignment = r.assignment and l.file = r.file where r.kind = "function-def" or r.kind = "async-function-def" or r.kind = "lambda";
let outer_variables = select l.id as id, l.assignment as assignment, l.file as file from variable_roots as l join variable_scopes as r on l.assignment = r.assignment and l.file = r.file where r.kind = "module" or r.kind = "class-def";
let targets = select l.id as assignment, r.child as target, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let names = select id, file from nodes where kind = "name";
let name_targets = select l.assignment as assignment, l.target as target, l.file as file from targets as l join names as r on l.target = r.id and l.file = r.file;
let positions = select id, "start-byte" as start, file from "source-location";
let name_target_positions = select l.assignment as assignment, l.target as target, r.start as target_start, l.file as file from name_targets as l join positions as r on l.target = r.id and l.file = r.file;
let simple_assignments = select l.assignment as assignment, l.file as file from name_target_positions as l join positions as r on l.assignment = r.id and l.file = r.file where l.target_start = r.start;
let simple_variables = select l.id as id, l.file as file from outer_variables as l join simple_assignments as r on l.assignment = r.assignment and l.file = r.file;
let complex_variables = antijoin(left=outer_variables, right=simple_variables, left-on=["id", "file"], right-on=["id", "file"]);
let complex_roots = select id, file from complex_variables;
let stored_roots = union(left=signature_roots, right=simple_variables);
let eager_outer_roots = select id, file from outer_variables;
let eager_candidates = union(left=signature_roots, right=eager_outer_roots);
let variable_root_nodes = select id, file from variable_roots;
let annotation_roots = union(left=signature_roots, right=variable_root_nodes);
let membership_axes = axis(from=expressions, relation="semantic-child", direction=nearest-ancestor, domain=annotation_roots);
let nested_members = select id, related as root, file from membership_axes;
let self_members = select l.id as id, r.id as root, l.file as file from expressions as l join annotation_roots as r on l.id = r.id and l.file = r.file;
let members = union(left=nested_members, right=self_members);
let known_files = select file from "compiler-feature" where feature = "python.future-annotations";
let input_files = select id, file from expressions;
let future_members = future_context(expressions=input_files);
let enabled_files = select file from future_members;
let disabled_files = select file from "compiler-feature" where feature = "python.future-annotations" and enabled = "false";
let native_files = select file from "language-target" where major = 3 and minor >= 14;
let immediate_files = select file from "language-target" where major = 3 and minor < 14;
let postponed_roots = select l.id as root, l.file as file from stored_roots as l join enabled_files as r on l.file = r.file;
let native_roots0 = select l.id as id, l.file as file from stored_roots as l join disabled_files as r on l.file = r.file;
let native_roots = select l.id as root, l.file as file from native_roots0 as l join native_files as r on l.file = r.file;
let eager_roots0 = select l.id as id, l.file as file from eager_candidates as l join disabled_files as r on l.file = r.file;
let eager_roots = select l.id as root, l.file as file from eager_roots0 as l join immediate_files as r on l.file = r.file;
let local_unevaluated = select l.id as root, l.file as file from local_variables as l join known_files as r on l.file = r.file;
let future_complex = select l.id as root, l.file as file from complex_roots as l join enabled_files as r on l.file = r.file;
let native_complex0 = select l.id as id, l.file as file from complex_roots as l join disabled_files as r on l.file = r.file;
let native_complex = select l.id as root, l.file as file from native_complex0 as l join native_files as r on l.file = r.file;
let unevaluated_roots0 = union(left=local_unevaluated, right=future_complex);
let unevaluated_roots = union(left=unevaluated_roots0, right=native_complex);
let eager_members = select l.id as id, l.file as file from members as l join eager_roots as r on l.root = r.root and l.file = r.file;
let postponed_members = select l.id as id, l.file as file from members as l join postponed_roots as r on l.root = r.root and l.file = r.file;
let native_members = select l.id as id, l.file as file from members as l join native_roots as r on l.root = r.root and l.file = r.file;
let unevaluated_members = select l.id as id, l.file as file from members as l join unevaluated_roots as r on l.root = r.root and l.file = r.file;
let eager_rows = extend(from=eager_members, values={evaluation: "eager"});
let postponed_rows = extend(from=postponed_members, values={evaluation: "postponed"});
let native_rows = extend(from=native_members, values={evaluation: "deferred"});
let unevaluated_rows = extend(from=unevaluated_members, values={evaluation: "unevaluated"});
let rows0 = union(left=eager_rows, right=postponed_rows);
let rows1 = union(left=native_rows, right=unevaluated_rows);
let rows = union(left=rows0, right=rows1);
let lambdas = select id, file from nodes where kind = "lambda";
let lambda_bodies = select r.child as id, l.file as file from lambdas as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let generators = select id, file from nodes where kind = "generator-exp";
let generator_elements = select r.child as id, l.file as file from generators as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elt";
let generator_clauses = select l.id as generator, r.child as id, l.file as file from generators as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let clause_positions = select l.generator as generator, l.id as id, r.start as start, l.file as file from generator_clauses as l join positions as r on l.id = r.id and l.file = r.file;
let later_clauses = select l.id as id, l.file as file from clause_positions as l join clause_positions as r on l.generator = r.generator and l.file = r.file where r.start < l.start;
let first_clauses = antijoin(left=generator_clauses, right=later_clauses, left-on=["id", "file"], right-on=["id", "file"]);
let first_iterables = select r.child as id, l.file as file from first_clauses as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "iter";
let all_clause_children = select r.child as id, l.file as file from generator_clauses as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let delayed_clause_children = antijoin(left=all_clause_children, right=first_iterables, left-on=["id", "file"], right-on=["id", "file"]);
let separate_bodies0 = union(left=lambda_bodies, right=generator_elements);
let separate_bodies1 = union(left=separate_bodies0, right=delayed_clause_children);
let embedded_roots = select root as id, file from "embedded-expression";
let separate_bodies = union(left=separate_bodies1, right=embedded_roots);
let body_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=separate_bodies);
let nested_body_members = select id, file from body_axes;
let direct_body_members = select l.id as id, l.file as file from expressions as l join separate_bodies as r on l.id = r.id and l.file = r.file;
let body_members = union(left=nested_body_members, right=direct_body_members);
let result = antijoin(left=rows, right=body_members, left-on=["id", "file"], right-on=["id", "file"]);
return result;
