import suppress from "python/ruff/suppress";
let elements = select id, kind, text, file from "syntax-tree";
let shebangs = select id, file from elements where kind = "comment" and starts_with(text, "#!");
let positioned = select l.id as id, l.file as file, r."start-byte" as start from shebangs as l join "source-location" as r on l.id = r.id and l.file = r.file where r."start-byte" > 0;
let nonwhite = select id, file from elements where text != "" and matches(text, "[^ \t\r\n\x0c]");
let nonwhite_positions = select l.id as id, l.file as file, r."start-byte" as start from nonwhite as l join "source-location" as r on l.id = r.id and l.file = r.file;
let blocked = select l.id as id, l.file as file from positioned as l join nonwhite_positions as r on l.file = r.file where r.start < l.start;
let eligible = antijoin(left=positioned, right=blocked, left-on=["id", "file"], right-on=["id", "file"]);
let whitespace = select id, file from elements where text != "" and matches(text, "^[ \t\r\n\x0c]+$");
let spaces = select l.id as id, l.file as file, r.span as span, r."start-byte" as start, r."end-byte" as end, r."start-line" as line from whitespace as l join "source-location" as r on l.id = r.id and l.file = r.file;
let first_spaces = select file, span as first_span, line from spaces where start = 0;
let last_spaces = select l.id as id, l.file as file, r.span as last_span from eligible as l join spaces as r on l.file = r.file and l.start = r.end;
let bounds = select l.id as id, l.file as file, r.first_span as first_span, l.last_span as last_span, r.line as line from last_spaces as l join first_spaces as r on l.file = r.file;
let composed = span-between(from=bounds, start="first_span", end="last_span", output="span");
let candidates = select id, file, span, line from composed;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])EXE004(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:EXE004)(?:,|$)");
emit violations subject file key(id);
