import type_context from "python/ruff/type-definition-context";
import future_context from "python/ruff/future-annotation-context";
input expressions: relation<id: node, file: file>;
output relation<id: node, file: file, visit: symbol>;
let nodes = select id, kind, file from "semantic-syntax";
let expression_nodes = select id, file from nodes where glob_any(kind, "{name,attribute,call,subscript,bin-op,unary-op,bool-op,if-exp,named-expr,await,yield,yield-from,list,set,tuple,dict,list-comp,set-comp,dict-comp,generator-exp,joined-str,template-str,formatted-value,starred,constant,slice}");
let contexts = type_context(expressions=expression_nodes);
let input_expressions = select l.id as id, l.file as file from expressions as l join expression_nodes as r on l.id = r.id and l.file = r.file;
let unvisited = antijoin(left=input_expressions, right=contexts, left-on=["id", "file"], right-on=["id", "file"]);
let stub_type_roots = select id, file from contexts where kind = "type" and matches(file, "[.]pyi$");
let stub_type_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=stub_type_roots);
let stub_type_nested = select id, file from stub_type_axes;
let stub_type_self = select l.id as id, l.file as file from expressions as l join stub_type_roots as r on l.id = r.id and l.file = r.file;
let stub_types = union(left=stub_type_nested, right=stub_type_self);
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let parameters = select id, file from nodes where kind = "arg";
let assignments = select id, file from nodes where kind = "ann-assign";
let annotated_owners = union(left=parameters, right=assignments);
let annotations = select r.child as id, l.file as file from annotated_owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let returns = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let annotation_roots = union(left=annotations, right=returns);
let annotation_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=annotation_roots);
let annotation_nested = select id, file from annotation_axes;
let annotation_self = select l.id as id, l.file as file from expressions as l join annotation_roots as r on l.id = r.id and l.file = r.file;
let annotation_members = union(left=annotation_nested, right=annotation_self);
let future_annotations = future_context(expressions=annotation_members);
let stub_annotations = select id, file from annotation_members where matches(file, "[.]pyi$");
let classes = select id, file from nodes where kind = "class-def";
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_children = select r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let stub_headers = select l.id as id, l.file as file from class_children as l join argument_nodes as r on l.id = r.id and l.file = r.file where matches(l.file, "[.]pyi$");
let type_parameters = select id, file from nodes where kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let parameter_payloads = select r.child as id, l.file as file from type_parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "bound" or r.field = "default-value";
let aliases = select id, file from nodes where kind = "type-alias";
let alias_payloads = select r.child as id, l.file as file from aliases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let embedded = select root as id, file from "embedded-expression";
let payloads0 = union(left=parameter_payloads, right=alias_payloads);
let payloads1 = union(left=embedded, right=stub_headers);
let payloads = union(left=payloads0, right=payloads1);
let payload_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=payloads);
let payload_nested = select id, file from payload_axes;
let payload_self = select l.id as id, l.file as file from expressions as l join payloads as r on l.id = r.id and l.file = r.file;
let payload_members = union(left=payload_nested, right=payload_self);
let deferred0 = union(left=stub_types, right=future_annotations);
let deferred1 = union(left=stub_annotations, right=payload_members);
let deferred_all = union(left=deferred0, right=deferred1);
let deferred = antijoin(left=deferred_all, right=unvisited, left-on=["id", "file"], right-on=["id", "file"]);
let deferred_rows = extend(from=deferred, values={visit: "deferred"});
let unvisited_rows = extend(from=unvisited, values={visit: "unvisited"});
let result = union(left=deferred_rows, right=unvisited_rows);
return result;
