input calls: relation<id: node,file: file>;
output relation<call: node,argument: node,kind: symbol,keyword: symbol,ordinal: number,file: file>;
let wrappers = select id,file from "semantic-syntax" where kind="call-arguments";
let children = select l.id as call,r.child as wrapper,l.file as file from calls as l join "semantic-child" as r on l.id=r.parent and l.file=r.file;
let arguments = select l.call as call,l.wrapper as wrapper,l.file as file from children as l join wrappers as r on l.wrapper=r.id and l.file=r.file;
let positionals = select l.call as call,r.child as argument,l.file as file from arguments as l join "semantic-child" as r on l.wrapper=r.parent and l.file=r.file where r.field="args";
let positional_locations = select l.call as call,l.argument as argument,r."start-byte" as start,l.file as file from positionals as l join "source-location" as r on l.argument=r.id and l.file=r.file;
let preceding = select l.call as call,l.argument as argument,r.argument as previous,l.file as file from positional_locations as l join positional_locations as r on l.call=r.call and l.file=r.file where r.start<l.start;
let ranks = group-count(from=preceding,keys=["call","argument","file"],count="ordinal",distinct="previous");
let unranked = antijoin(left=positionals,right=ranks,left-on=["call","argument","file"],right-on=["call","argument","file"]);
let first = extend(from=unranked,values={ordinal: 0});
let ranked = union(left=first,right=ranks);
let positional_kinds = extend(from=ranked,values={kind: "positional",keyword: ""});
let positional_rows = select call,argument,kind,keyword,ordinal,file from positional_kinds;
let keywords = select l.call as call,r.child as wrapper,l.file as file from arguments as l join "semantic-child" as r on l.wrapper=r.parent and l.file=r.file where r.field="keywords";
let keyword_labels0 = select l.call as call,l.wrapper as wrapper,r.child as label,l.file as file from keywords as l join "semantic-child" as r on l.wrapper=r.parent and l.file=r.file where r.field="arg";
let keyword_labels = select l.call as call,l.wrapper as wrapper,r.name as keyword,l.file as file from keyword_labels0 as l join "identifier" as r on l.label=r.id and l.file=r.file;
let spread_keywords = antijoin(left=keywords,right=keyword_labels,left-on=["call","wrapper","file"],right-on=["call","wrapper","file"]);
let named_keywords = extend(from=keyword_labels,values={kind: "keyword"});
let spread_kinds = extend(from=spread_keywords,values={kind: "keyword-spread",keyword: ""});
let named_keyword_rows = select call,wrapper,kind,keyword,file from named_keywords;
let spread_keyword_rows = select call,wrapper,kind,keyword,file from spread_kinds;
let all_keywords = union(left=named_keyword_rows,right=spread_keyword_rows);
let keyword_values = select l.call as call,r.child as argument,l.kind as kind,l.keyword as keyword,l.file as file from all_keywords as l join "semantic-child" as r on l.wrapper=r.parent and l.file=r.file where r.field="value";
let keyword_ordinals = extend(from=keyword_values,values={ordinal: 0});
let keyword_rows = select call,argument,kind,keyword,ordinal,file from keyword_ordinals;
let result = union(left=positional_rows,right=keyword_rows);
return result;
