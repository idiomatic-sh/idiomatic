input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let statement_test_owners = select id, file from nodes where kind = "if" or kind = "elif-else-clause" or kind = "while" or kind = "assert" or kind = "if-exp";
let statement_tests = select r.child as id, l.file as file from statement_test_owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let guards = select child as id, file from "semantic-child" where field = "guard" or field = "ifs";
let unary_nodes = select id, file from nodes where kind = "unary-op";
let unary_locations = select l.id as id, r."start-byte" as position, l.file as file from unary_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let not_tokens = select l.id as id, r."start-byte" as position, l.file as file from "syntax-tree" as l join "source-location" as r on l.id = r.id and l.file = r.file where l.text = "not";
let not_nodes = select l.id as id, l.file as file from unary_locations as l join not_tokens as r on l.position = r.position and l.file = r.file;
let not_operands = select r.child as id, l.file as file from not_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "operand";
let calls = select id, file from nodes where kind = "call";
let functions = select l.id as call, r.child as function, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let bool_names = select id, file from "qualified-name" where (provenance = "builtin" or provenance = "import") and path = "builtins.bool";
let bool_calls = select l.call as call, l.file as file from functions as l join bool_names as r on l.function = r.id and l.file = r.file;
let call_wrappers = select id, file from nodes where kind = "call-arguments";
let wrappers = select l.call as call, r.child as wrapper, l.file as file from bool_calls as l join "semantic-child" as r on l.call = r.parent and l.file = r.file;
let argument_wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from wrappers as l join call_wrappers as r on l.wrapper = r.id and l.file = r.file;
let arguments = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from argument_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let later_arguments = select l.call as call, l.argument as argument, l.file as file from arguments as l join arguments as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let first_arguments = antijoin(left=arguments, right=later_arguments, left-on=["call","argument","file"], right-on=["call","argument","file"]);
let bool_arguments = select argument as id, file from first_arguments;
let seeds0 = union(left=statement_tests, right=guards);
let seeds1 = union(left=seeds0, right=not_operands);
let seeds = union(left=seeds1, right=bool_arguments);
let bool_nodes = select id, file from nodes where kind = "bool-op";
let bool_fields = select l.id as source, r.child as destination, l.file as file from bool_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "values";
let bool_edges = select l.source as source, l.destination as destination, l.file as file from bool_fields as l join bool_nodes as r on l.destination = r.id and l.file = r.file;
let paths = closure(edges=bool_edges, source="source", destination="destination", keys=["file"]);
let nested_tests = select r.destination as id, l.file as file from seeds as l join paths as r on l.id = r.source and l.file = r.file;
let all_tests = union(left=seeds, right=nested_tests);
let result = select l.id as id, l.file as file from expressions as l join all_tests as r on l.id = r.id and l.file = r.file;
return result;
