import qualified_match from "python/ruff/qualified-at-visit";
import call_arguments from "python/ruff/call-arguments";
import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
import builtin_match from "python/ruff/builtin-match-at-visit";
import call_context from "python/ruff/call-checker-context";
import rounded_arguments from "python/ruff/rounded-arguments";
let nodes=select id,kind,file from "semantic-syntax";
let calls=select id,file from nodes where kind="call";
let checks=call_context(calls=calls);
let builtin_int=builtin_match(checks=checks,builtin="builtins.int");
let int_calls=select check as id,file from builtin_int;
let arguments=call_arguments(calls=int_calls);
let counts=group-count(from=arguments,keys=["call","file"],count="count",distinct="argument");
let single_arguments=select l.call as call,l.argument as argument,l.file as file from arguments as l join counts as r on l.call=r.call and l.file=r.file where r.count=1 and l.kind="positional";
let integers=select id,file from "expression-type" where resolution="atom" and type="integer";
let integer_candidates=select l.call as id,l.file as file from single_arguments as l join integers as r on l.argument=r.id and l.file=r.file;
let inner_calls=select l.call as outer_call,l.argument as inner_call,l.file as file from single_arguments as l join calls as r on l.argument=r.id and l.file=r.file;
let inner_inputs=select inner_call as id,file from inner_calls;
let inner_checks=call_context(calls=inner_inputs);
let direct_return_matches=qualified_match(checks=inner_checks,pattern="^(?:builtins[.](?:len|id|hash|ord|int)|math[.](?:comb|factorial|gcd|lcm|isqrt|perm|ceil|floor|trunc))$");
let direct_return_candidates=select l.outer_call as id,l.file as file from inner_calls as l join direct_return_matches as r on l.inner_call=r.check and l.file=r.file;
let inner_round_matches=qualified_match(checks=inner_checks,pattern="^builtins[.]round$");
let round_inner=select check as id,file from inner_round_matches;
let rounded=rounded_arguments(calls=round_inner);
let integral_rounded=select call,file from rounded where ndigits_kind="none" or ((rounded_kind="integer-equivalent" or rounded_kind="integer-assignable") and (ndigits_kind="integer-literal" or ndigits_kind="integer-equivalent"));
let rounded_candidates=select l.outer_call as id,l.file as file from inner_calls as l join integral_rounded as r on l.inner_call=r.call and l.file=r.file;
let candidates0=union(left=integer_candidates,right=direct_return_candidates);
let candidates=union(left=candidates0,right=rounded_candidates);
let inputs=select id,file from candidates;
let visited=type_context(expressions=inputs);
let visited_candidates=select l.id as id,l.file as file from candidates as l join visited as r on l.id=r.id and l.file=r.file;
let locations=select l.id as id,l.file as file,r.span as span,r."start-line" as line from visited_candidates as l join "source-location" as r on l.id=r.id and l.file=r.file;
let violations=suppress(candidates=locations,inline-pattern="(?:^|[^A-Z0-9])RUF046(?:$|[^A-Z0-9])",range-pattern="(?:^|,)(?:RUF046)(?:,|$)");
emit violations subject file key(id);
