import bounded_integer from "python/ruff/nonnegative-i64-literal";
import call_arguments from "python/ruff/call-arguments";
import binding_type from "python/ruff/binding-type";
input calls: relation<id: node,file: file>;
output relation<call: node,rounded: node,rounded_kind: symbol,ndigits_kind: symbol,file: file>;
let nodes=select id,kind,file from "semantic-syntax";
let arguments=call_arguments(calls=calls);
let counts=group-count(from=arguments,keys=["call","file"],count="count",distinct="argument");
let too_many=select call,file from counts where count>2;
let spread_keywords=select call,file from arguments where kind="keyword-spread";
let stars=select id,file from nodes where kind="starred";
let spread_positionals=select l.call as call,l.file as file from arguments as l join stars as r on l.argument=r.id and l.file=r.file where l.kind="positional";
let spreads=union(left=spread_keywords,right=spread_positionals);
let rejected=union(left=too_many,right=spreads);
let accepted=antijoin(left=arguments,right=rejected,left-on=["call","file"],right-on=["call","file"]);
let number_keywords=select call,argument as rounded,file from accepted where kind="keyword" and keyword="number";
let first_args0=select call,argument as rounded,file from accepted where kind="positional" and ordinal=0;
let first_args=antijoin(left=first_args0,right=number_keywords,left-on=["call","file"],right-on=["call","file"]);
let rounded_values=union(left=number_keywords,right=first_args);
let ndigits_keywords=select call,argument as ndigits,file from accepted where kind="keyword" and keyword="ndigits";
let second_args0=select call,argument as ndigits,file from accepted where kind="positional" and ordinal=1;
let second_args=antijoin(left=second_args0,right=ndigits_keywords,left-on=["call","file"],right-on=["call","file"]);
let ndigits_values=union(left=ndigits_keywords,right=second_args);
let rounded_inputs=select rounded as reference,file from rounded_values;
let ndigits_inputs=select ndigits as reference,file from ndigits_values;
let type_inputs=union(left=rounded_inputs,right=ndigits_inputs);
let inferred_int=select id,file from "expression-type" where resolution="atom" and type="integer";
let inferred_float=select id,file from "expression-type" where resolution="atom" and type="float";
let integer_names=binding_type(references=type_inputs,builtin="builtins.int",typing="__no_such_typing_member__",atom="integer");
let float_names=binding_type(references=rounded_inputs,builtin="builtins.float",typing="__no_such_typing_member__",atom="float");
let rounded_equivalent_int0=select l.call as call,l.rounded as rounded,l.file as file from rounded_values as l join inferred_int as r on l.rounded=r.id and l.file=r.file;
let rounded_equivalent_float0=select l.call as call,l.rounded as rounded,l.file as file from rounded_values as l join inferred_float as r on l.rounded=r.id and l.file=r.file;
let rounded_assignable_int0=select l.call as call,l.rounded as rounded,l.file as file from rounded_values as l join integer_names as r on l.rounded=r.reference and l.file=r.file;
let rounded_assignable_float0=select l.call as call,l.rounded as rounded,l.file as file from rounded_values as l join float_names as r on l.rounded=r.reference and l.file=r.file;
let rounded_known0=union(left=rounded_equivalent_int0,right=rounded_equivalent_float0);
let rounded_known1=union(left=rounded_assignable_int0,right=rounded_assignable_float0);
let rounded_known=union(left=rounded_known0,right=rounded_known1);
let rounded_other0=antijoin(left=rounded_values,right=rounded_known,left-on=["call","file"],right-on=["call","file"]);
let rounded_int_equivalent=extend(from=rounded_equivalent_int0,values={rounded_kind: "integer-equivalent"});
let rounded_float_equivalent=extend(from=rounded_equivalent_float0,values={rounded_kind: "float-equivalent"});
let rounded_int_assignable=extend(from=rounded_assignable_int0,values={rounded_kind: "integer-assignable"});
let rounded_float_assignable=extend(from=rounded_assignable_float0,values={rounded_kind: "float-assignable"});
let rounded_other=extend(from=rounded_other0,values={rounded_kind: "other"});
let rounded_kinds0=union(left=rounded_int_equivalent,right=rounded_float_equivalent);
let rounded_kinds1=union(left=rounded_int_assignable,right=rounded_float_assignable);
let rounded_kinds2=union(left=rounded_kinds0,right=rounded_kinds1);
let rounded_kinds=union(left=rounded_kinds2,right=rounded_other);
let none_literals=select id,file from "literal-properties" where kind="null";
let ndigits_none0=select l.call as call,l.file as file from ndigits_values as l join none_literals as r on l.ndigits=r.id and l.file=r.file;
let ndigits_absent0=antijoin(left=rounded_values,right=ndigits_values,left-on=["call","file"],right-on=["call","file"]);
let ndigits_absent=select call,file from ndigits_absent0;
let ndigits_none=union(left=ndigits_none0,right=ndigits_absent);
let constants=select id,file from nodes where kind="constant";
let ndigits_expression_inputs=select ndigits as id,file from ndigits_values;
let integer_literals=bounded_integer(expressions=ndigits_expression_inputs);
let ndigits_literal0=select l.call as call,l.file as file from ndigits_values as l join integer_literals as r on l.ndigits=r.id and l.file=r.file;
let ndigits_equivalent0=select l.call as call,l.file as file from ndigits_values as l join inferred_int as r on l.ndigits=r.id and l.file=r.file;
let ndigits_equivalent=antijoin(left=ndigits_equivalent0,right=ndigits_literal0,left-on=["call","file"],right-on=["call","file"]);
let ndigits_assignable0=select l.call as call,l.file as file from ndigits_values as l join integer_names as r on l.ndigits=r.reference and l.file=r.file;
let ndigits_known0=union(left=ndigits_none,right=ndigits_equivalent0);
let ndigits_known=union(left=ndigits_known0,right=ndigits_assignable0);
let ndigits_other0=antijoin(left=rounded_values,right=ndigits_known,left-on=["call","file"],right-on=["call","file"]);
let ndigits_other=select call,file from ndigits_other0;
let ndigits_none_kind=extend(from=ndigits_none,values={ndigits_kind: "none"});
let ndigits_literal_kind=extend(from=ndigits_literal0,values={ndigits_kind: "integer-literal"});
let ndigits_equivalent_kind=extend(from=ndigits_equivalent,values={ndigits_kind: "integer-equivalent"});
let ndigits_assignable_kind=extend(from=ndigits_assignable0,values={ndigits_kind: "integer-assignable"});
let ndigits_other_kind=extend(from=ndigits_other,values={ndigits_kind: "other"});
let ndigits_kinds0=union(left=ndigits_none_kind,right=ndigits_literal_kind);
let ndigits_kinds1=union(left=ndigits_equivalent_kind,right=ndigits_assignable_kind);
let ndigits_kinds2=union(left=ndigits_kinds0,right=ndigits_kinds1);
let ndigits_kinds=union(left=ndigits_kinds2,right=ndigits_other_kind);
let result=select l.call as call,l.rounded as rounded,l.rounded_kind as rounded_kind,r.ndigits_kind as ndigits_kind,l.file as file from rounded_kinds as l join ndigits_kinds as r on l.call=r.call and l.file=r.file;
return result;
