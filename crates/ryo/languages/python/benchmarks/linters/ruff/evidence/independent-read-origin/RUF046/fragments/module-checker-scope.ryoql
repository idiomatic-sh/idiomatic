input expressions: relation<id: node,file: file>;
output relation<id: node,file: file>;
let nodes=select id,kind,file from "semantic-syntax";
let lexical_scope_nodes=select child as id,file from "scope";
let module_nodes=select id,file from nodes where kind="module";
let scope_nodes0=union(left=lexical_scope_nodes,right=module_nodes);
let extra_scopes=select id,file from nodes where kind="type-alias" or kind="list-comp" or kind="set-comp" or kind="dict-comp" or kind="generator-exp";
let scope_nodes=union(left=scope_nodes0,right=extra_scopes);
let ancestors=axis(from=expressions,relation="semantic-child",direction=ancestor,domain=scope_nodes);
let lexical_scopes=select id,related as scope,file from ancestors;
let callables=select id,file from nodes where kind="function-def" or kind="async-function-def" or kind="lambda";
let classes=select id,file from nodes where kind="class-def";
let default_roots0=select child as id,file from "semantic-child" where field="defaults" or field="kw-defaults";
let default_owners=axis(from=default_roots0,relation="semantic-child",direction=nearest-ancestor,domain=callables);
let default_roots=select id,related as owner,file from default_owners;
let decorated_nodes=union(left=callables,right=classes);
let decorator_roots=select r.child as id,l.id as owner,l.file as file from decorated_nodes as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="decorator-list";
let comprehensions=select id,file from nodes where kind="comprehension";
let generator_owners=axis(from=comprehensions,relation="semantic-child",direction=nearest-ancestor,domain=extra_scopes);
let generator_locations=select l.id as id,l.related as owner,r."start-byte" as start,l.file as file from generator_owners as l join "source-location" as r on l.id=r.id and l.file=r.file;
let later_generators=select l.id as id,l.file as file from generator_locations as l join generator_locations as r on l.owner=r.owner and l.file=r.file where r.start<l.start;
let first_generators=antijoin(left=generator_locations,right=later_generators,left-on=["id","file"],right-on=["id","file"]);
let iterable_roots=select r.child as id,l.owner as owner,l.file as file from first_generators as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="iter";
let early_roots0=union(left=default_roots,right=decorator_roots);
let early_roots=union(left=early_roots0,right=iterable_roots);
let early_axes=axis(from=expressions,relation="semantic-child",direction=ancestor,domain=early_roots);
let early_nested=select l.id as id,r.owner as scope,l.file as file from early_axes as l join early_roots as r on l.related=r.id and l.file=r.file;
let early_self=select l.id as id,r.owner as scope,l.file as file from expressions as l join early_roots as r on l.id=r.id and l.file=r.file;
let excluded=union(left=early_nested,right=early_self);
let visible_scopes=antijoin(left=lexical_scopes,right=excluded,left-on=["id","scope","file"],right-on=["id","scope","file"]);
let scope_ancestors=axis(from=scope_nodes,relation="semantic-child",direction=ancestor,domain=scope_nodes);
let candidates_with_inner_scopes=select l.id as id,l.scope as scope,r.scope as inner,l.file as file from visible_scopes as l join visible_scopes as r on l.id=r.id and l.file=r.file where l.scope!=r.scope;
let outer_scopes=select l.id as id,l.scope as scope,l.file as file from candidates_with_inner_scopes as l join scope_ancestors as r on l.inner=r.id and l.scope=r.related and l.file=r.file;
let nearest=antijoin(left=visible_scopes,right=outer_scopes,left-on=["id","scope","file"],right-on=["id","scope","file"]);
let modules=select id,file from nodes where kind="module";
let result=select l.id as id,l.file as file from nearest as l join modules as r on l.scope=r.id and l.file=r.file;
return result;
