input checks: relation<check: node,root: node,file: file>;
param builtin: string;
param typing: string;
param mode: string;
output relation<check: node,file: file>;
let nodes=select id,kind,file from "semantic-syntax";
let names=select id,file from nodes where kind="name";
let attrs=select id,file from nodes where kind="attribute";
let named_roots=select l.check as check,l.root as root,l.root as head,l.file as file from checks as l join names as r on l.root=r.id and l.file=r.file;
let attr_roots=select l.check as check,l.root as root,l.file as file from checks as l join attrs as r on l.root=r.id and l.file=r.file;
let attr_inputs=select root as id,file from attr_roots;
let attr_head_axes=axis(from=attr_inputs,relation="semantic-child",direction=descendant,domain=names);
let attr_heads=select l.check as check,l.root as root,r.related as head,l.file as file from attr_roots as l join attr_head_axes as r on l.root=r.id and l.file=r.file;
let heads=union(left=named_roots,right=attr_heads);
let head_inputs=select head as id,file from heads;
let head_labels=select l.check as check,l.root as root,l.head as head,r.name as name,l.file as file from heads as l join "identifier" as r on l.head=r.id and l.file=r.file;
let reads=select reference as head,state,file from "binding-read";
let builtin_reads=select head,file from reads where state="builtin";
let definite_reads=select head,file from reads where state="unique-declaration";
let uncertain_reads=select head,file from reads where state!="builtin" and state!="unique-declaration";
let unclassified_heads=antijoin(left=heads,right=reads,left-on=["head","file"],right-on=["head","file"]);
let builtin_heads=select l.check as check,l.root as root,l.head as head,l.name as name,l.file as file from head_labels as l join builtin_reads as r on l.head=r.head and l.file=r.file;
let direct_builtin_matches=select l.check as check,l.file as file from builtin_heads as l join named_roots as r on l.check=r.check and l.root=r.root and l.file=r.file where concat("builtins.",l.name)=$builtin or (($mode="pattern") and matches(concat("builtins.",l.name),$builtin));
let uses=select reference as head,binding,file from "binding-use" where certainty="unique";
let unique_import_uses0=select l.head as head,r.target as target,l.binding as definition,l.file as file from uses as l join "static-import" as r on l.binding=r.occurrence and l.file=r.file;
let unique_import_uses=select l.head as head,l.target as target,l.definition as definition,l.file as file from unique_import_uses0 as l join definite_reads as r on l.head=r.head and l.file=r.file;
let direct_imports0=select id,file from "defines" where kind="import" and refinement="import";
let aliased_imports=select parent as id,file from "semantic-child" where field="asname";
let direct_imports=antijoin(left=direct_imports0,right=aliased_imports,left-on=["id","file"],right-on=["id","file"]);
let dotted_imports=select l.head as head,l.target as target,l.definition as definition,l.file as file from unique_import_uses as l join direct_imports as r on l.definition=r.id and l.file=r.file where matches(l.target,"[.]");
let dotted_modules=replace(from=dotted_imports,text="target",pattern="[.].*$",replacement="",output="module");
let ordinary_imports=antijoin(left=unique_import_uses,right=dotted_imports,left-on=["head","definition","file"],right-on=["head","definition","file"]);
let ordinary_paths=select head,target as path,file from ordinary_imports;
let module_paths=select head,module as path,file from dotted_modules;
let import_paths=union(left=ordinary_paths,right=module_paths);
let import_named_paths=select l.check as check,r.path as path,l.file as file from named_roots as l join import_paths as r on l.head=r.head and l.file=r.file;
let simple_attr_values=select l.check as check,l.root as root,r.child as head,l.file as file from attr_roots as l join "semantic-child" as r on l.root=r.parent and l.file=r.file where r.field="value";
let simple_attrs=select l.check as check,l.root as root,l.head as head,l.file as file from simple_attr_values as l join names as r on l.head=r.id and l.file=r.file;
let attr_labels0=select l.check as check,l.root as root,l.head as head,r.child as label,l.file as file from simple_attrs as l join "semantic-child" as r on l.root=r.parent and l.file=r.file where r.field="attr";
let attr_labels=select l.check as check,l.root as root,l.head as head,r.name as name,l.file as file from attr_labels0 as l join "identifier" as r on l.label=r.id and l.file=r.file;
let import_attr_paths=select l.check as check,l.name as name,r.path as path,l.file as file from attr_labels as l join import_paths as r on l.head=r.head and l.file=r.file;
let imported_name_matches=select check,file from import_named_paths where path=$builtin or (($mode="pattern") and matches(path,$builtin)) or path=concat("typing.",$typing) or path=concat("typing_extensions.",$typing) or path=concat("_typeshed.",$typing);
let imported_attr_matches=select check,file from import_attr_paths where concat(path,".",name)=$builtin or (($mode="pattern") and matches(concat(path,".",name),$builtin)) or concat(path,".",name)=concat("typing.",$typing) or concat(path,".",name)=concat("typing_extensions.",$typing) or concat(path,".",name)=concat("_typeshed.",$typing);
let head_origins=select l.head as head,r.path as path,l.file as file from heads as l join "qualified-name" as r on l.head=r.id and l.file=r.file where r.provenance="builtin" or r.provenance="import";
let agreed_import_heads=select l.head as head,l.file as file from head_origins as l join import_paths as r on l.head=r.head and l.path=r.path and l.file=r.file;
let trustworthy_heads0=union(left=agreed_import_heads,right=builtin_reads);
let unclassified_ids=select head,file from unclassified_heads;
let trustworthy_heads=union(left=trustworthy_heads0,right=unclassified_ids);
let raw_paths0=select l.check as check,l.head as head,r.path as path,l.file as file from heads as l join "qualified-name" as r on l.root=r.id and l.file=r.file where r.provenance="builtin" or r.provenance="import";
let raw_paths=select l.check as check,l.path as path,l.file as file from raw_paths0 as l join trustworthy_heads as r on l.head=r.head and l.file=r.file;
let raw_matches=select check,file from raw_paths where path=$builtin or (($mode="pattern") and matches(path,$builtin)) or path=concat("typing.",$typing) or path=concat("typing_extensions.",$typing) or path=concat("_typeshed.",$typing);
let matches0=union(left=direct_builtin_matches,right=imported_name_matches);
let matches1=union(left=matches0,right=imported_attr_matches);
let matches2=union(left=matches1,right=raw_matches);
let generic_owners=select id,file from nodes where kind="function-def" or kind="async-function-def" or kind="class-def" or kind="type-alias";
let parameters=select id,name,file from "defines" where refinement="type-var" or refinement="type-var-tuple" or refinement="param-spec";
let parameter_axes=axis(from=parameters,relation="semantic-child",direction=nearest-ancestor,domain=generic_owners);
let owned_parameters=select l.id as declaration,l.name as name,r.related as owner,l.file as file from parameters as l join parameter_axes as r on l.id=r.id and l.file=r.file;
let generic_axes=axis(from=head_inputs,relation="semantic-child",direction=ancestor,domain=generic_owners);
let callables=select id,file from nodes where kind="function-def" or kind="async-function-def" or kind="lambda";
let functions=select id,file from nodes where kind="function-def" or kind="async-function-def";
let classes=select id,file from nodes where kind="class-def";
let defaults=select child as id,file from "semantic-child" where field="defaults" or field="kw-defaults";
let default_axes=axis(from=defaults,relation="semantic-child",direction=nearest-ancestor,domain=callables);
let function_defaults=select l.id as id,l.related as owner,l.file as file from default_axes as l join functions as r on l.related=r.id and l.file=r.file;
let decorated_owners=union(left=functions,right=classes);
let decorators=select r.child as id,l.id as owner,l.file as file from decorated_owners as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="decorator-list";
let early_roots=union(left=function_defaults,right=decorators);
let early_axes=axis(from=head_inputs,relation="semantic-child",direction=ancestor,domain=early_roots);
let early_nested=select l.id as head,r.owner as owner,l.file as file from early_axes as l join early_roots as r on l.related=r.id and l.file=r.file;
let early_self=select l.id as head,r.owner as owner,l.file as file from head_inputs as l join early_roots as r on l.id=r.id and l.file=r.file;
let early_generics=union(left=early_nested,right=early_self);
let generic_contexts0=select id as head,related as owner,file from generic_axes;
let generic_contexts=antijoin(left=generic_contexts0,right=early_generics,left-on=["head","owner","file"],right-on=["head","owner","file"]);
let visible_parameters=select l.head as head,l.owner as owner,r.name as name,l.file as file from generic_contexts as l join owned_parameters as r on l.owner=r.owner and l.file=r.file;
let parameter_heads=select l.check as check,l.head as head,r.owner as owner,l.file as file from head_labels as l join visible_parameters as r on l.head=r.head and l.name=r.name and l.file=r.file;
let ordinary_definitions=select id,owner,file from "defines" where refinement!="type-var" and refinement!="type-var-tuple" and refinement!="param-spec";
let ordinary_uses=select l.head as head,r.owner as scope,l.file as file from uses as l join ordinary_definitions as r on l.binding=r.id and l.file=r.file;
let args=select id,file from nodes where kind="arg";
let arg_annotations=select r.child as id,l.file as file from args as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="annotation";
let arg_function_axes=axis(from=arg_annotations,relation="semantic-child",direction=nearest-ancestor,domain=functions);
let parameter_headers=select id,related as owner,file from arg_function_axes;
let return_headers=select r.child as id,l.id as owner,l.file as file from functions as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="returns";
let class_argument_nodes=select id,file from nodes where kind="call-arguments";
let class_children=select r.child as id,l.id as owner,l.file as file from classes as l join "semantic-child" as r on l.id=r.parent and l.file=r.file;
let class_headers=select l.id as id,l.owner as owner,l.file as file from class_children as l join class_argument_nodes as r on l.id=r.id and l.file=r.file;
let param_nodes=select id,file from nodes where kind="type-var" or kind="type-var-tuple" or kind="param-spec";
let payloads=select r.child as id,l.id as parameter,l.file as file from param_nodes as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="bound" or r.field="default-value";
let payload_headers=select l.id as id,r.related as owner,l.file as file from payloads as l join parameter_axes as r on l.parameter=r.id and l.file=r.file;
let aliases=select id,file from nodes where kind="type-alias";
let alias_headers=select r.child as id,l.id as owner,l.file as file from aliases as l join "semantic-child" as r on l.id=r.parent and l.file=r.file where r.field="value";
let headers0=union(left=parameter_headers,right=return_headers);
let headers1=union(left=class_headers,right=payload_headers);
let headers2=union(left=headers0,right=headers1);
let headers=union(left=headers2,right=alias_headers);
let header_axes=axis(from=head_inputs,relation="semantic-child",direction=ancestor,domain=headers);
let header_nested=select l.id as head,r.owner as scope,l.file as file from header_axes as l join headers as r on l.related=r.id and l.file=r.file;
let header_self=select l.id as head,r.owner as scope,l.file as file from head_inputs as l join headers as r on l.id=r.id and l.file=r.file;
let header_exclusions=union(left=header_nested,right=header_self);
let body_ordinary_uses=antijoin(left=ordinary_uses,right=header_exclusions,left-on=["head","scope","file"],right-on=["head","scope","file"]);
let scope_edges=select child as source,parent as destination,file from "scope";
let scope_paths=closure(edges=scope_edges,source="source",destination="destination",keys=["file"]);
let same_scope_overrides=select l.check as check,l.head as head,l.owner as owner,l.file as file from parameter_heads as l join body_ordinary_uses as r on l.head=r.head and l.owner=r.scope and l.file=r.file;
let override_options=select l.check as check,l.head as head,l.owner as owner,r.scope as scope,l.file as file from parameter_heads as l join body_ordinary_uses as r on l.head=r.head and l.file=r.file;
let inner_scope_overrides=select l.check as check,l.head as head,l.owner as owner,l.file as file from override_options as l join scope_paths as r on l.scope=r.source and l.owner=r.destination and l.file=r.file;
let overrides=union(left=same_scope_overrides,right=inner_scope_overrides);
let active_parameters=antijoin(left=parameter_heads,right=overrides,left-on=["check","head","owner","file"],right-on=["check","head","owner","file"]);
let barriers=select check,file from active_parameters;
let result=antijoin(left=matches2,right=barriers,left-on=["check","file"],right-on=["check","file"]);
return result;
