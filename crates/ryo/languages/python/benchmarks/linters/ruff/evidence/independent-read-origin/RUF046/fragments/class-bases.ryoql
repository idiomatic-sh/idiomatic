import lookup_attribute from "python/ruff/lookup-attribute";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, file: file>;
output relation<context: node, child_class: node, base: node, parent_class: node, file: file>;
let bases = select declaration as class, occurrence as expression, file from "inherits";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_bases = select l.class as class, l.file as file, l.expression as expression from bases as l join subscript_nodes as r on l.expression = r.id and l.file = r.file;
let ordinary_bases = antijoin(left=bases, right=subscript_nodes, left-on=["expression", "file"], right-on=["id", "file"]);
let ordinary_base_rows = select class, expression as base, expression, file from ordinary_bases;
let subscript_base_rows = select l.class as class, l.expression as base, r.child as expression, l.file as file from subscript_bases as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "value";
let all_base_rows = union(left=ordinary_base_rows, right=subscript_base_rows);
let expressions = select expression as id, file from all_base_rows;
let definitions = lookup_attribute(ordered_contexts=ordered_contexts, expressions=expressions);
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let class_definitions = select l.context as context, l.expression as expression, l.definition as class, l.file as file from definitions as l join classes as r on l.definition = r.id and l.file = r.file;
let resolved_base_edges = select r.context as context, l.class as child_class, l.base as base, r.class as parent_class, l.file as file from all_base_rows as l join class_definitions as r on l.expression = r.expression and l.file = r.file;
return resolved_base_edges;
