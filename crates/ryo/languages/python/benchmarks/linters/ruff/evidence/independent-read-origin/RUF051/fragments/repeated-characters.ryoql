input strings: relation<id: node, value: symbol, file: file>;
output relation<id: node, file: file>;
let middle_parts = capture(from=strings, path="value", pattern="{*before}{*character}{*after}", captures=["before", "character", "after"]);
let middle_chars = select id, before, character, file from middle_parts where matches(character, "(?s)^.$");
let first_parts = capture(from=strings, path="value", pattern="{*character}{*after}", captures=["character", "after"]);
let first_chars0 = select id, character, file from first_parts where matches(character, "(?s)^.$");
let first_chars1 = extend(from=first_chars0, values={before: ""});
let first_chars = select id, before, character, file from first_chars1;
let last_parts = capture(from=strings, path="value", pattern="{*before}{*character}", captures=["before", "character"]);
let last_chars = select id, before, character, file from last_parts where matches(character, "(?s)^.$");
let edge_chars = union(left=first_chars, right=last_chars);
let characters = union(left=middle_chars, right=edge_chars);
let counts = group-count(from=characters, keys=["id", "character", "file"], distinct="before", count="count");
let repeated = select id, file from counts where count > 1;
return repeated;
