input expressions: relation<id: node, file: file>;
output relation<id: node, file: file, evaluation: symbol, root: node, mode: symbol>;
let rows = select r.id as id, r.file as file, r.evaluation as evaluation, r.root as root, r.mode as mode from expressions as l join "annotation-evaluation" as r on l.id = r.id and l.file = r.file;
return rows;
