import annotation_origins from "python/ruff/annotation-origins";
input annotations: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_edges = select l.id as parent, r.child as child, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let string_hosts = select id, file from "literal-properties" where kind = "string";
let string_edges = select l.host as parent, l.root as child, l.file as file from "embedded-expression" as l join string_hosts as r on l.host = r.id and l.file = r.file;
let value_edges = union(left=subscript_edges, right=string_edges);
let names = select id, file from nodes where kind = "name" or kind = "attribute";
let walked = axis(from=annotations, relation=value_edges, direction=descendant, domain=names);
let nested_roots = select id as annotation, related as root, file from walked;
let direct_roots = select id as annotation, id as root, file from annotations;
let root_rows = union(left=direct_roots, right=nested_roots);
let root_expressions = select root as id, file from root_rows;
let origins = annotation_origins(expressions=root_expressions);
let root_matches = select l.annotation as id, l.file as file from root_rows as l join origins as r on l.root = r.id and l.file = r.file where r.path = "typing.IO" or r.path = "typing.BinaryIO" or r.path = "typing.TextIO" or r.path = "typing_extensions.IO" or r.path = "typing_extensions.BinaryIO" or r.path = "typing_extensions.TextIO" or r.path = "io.IOBase" or r.path = "io.RawIOBase" or r.path = "io.BufferedIOBase" or r.path = "io.TextIOBase" or r.path = "io.BytesIO" or r.path = "io.StringIO" or r.path = "io.BufferedReader" or r.path = "io.BufferedWriter" or r.path = "io.BufferedRandom" or r.path = "io.BufferedRWPair" or r.path = "io.TextIOWrapper" or r.path = "io.FileIO" or r.path = "_typeshed.IO" or r.path = "_typeshed.BinaryIO" or r.path = "_typeshed.TextIO";
let unique_matches = group-count(from=root_matches, keys=["id","file"], count="count");
let results = select id, file from unique_matches;
return results;
