import staged from "python/ruff/site-lookup-symbol-events-staged";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, header_point: number, stage: number, file: file>;
input expressions: relation<id: node, file: file>;
output relation<context: node, expression: node, occurrence: node, scope: node, kind: symbol, file: file>;
let current = select context, initial_scope, point, header_point, stage, file from ordered_contexts where stage = 0;
let others = select context, initial_scope, point, header_point, stage, file from ordered_contexts where stage != 0;
let staged_rows = staged(ordered_contexts=others, expressions=expressions);
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let attributes = select id, file from nodes where kind = "attribute";
let name_nodes = select id, file from nodes where kind = "name";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let named_or_attributed = union(left=name_nodes, right=attributes);
let attribute_value_edges = select r.child as origin, l.id as destination, l.file as file from attributes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let contiguous_attribute_edges = select l.origin as origin, l.destination as destination from attribute_value_edges as l join named_or_attributed as r on l.origin = r.id and l.file = r.file;
let expression_self_edges = select id as origin, id as destination from named_or_attributed;
let expression_edges = union(left=contiguous_attribute_edges, right=expression_self_edges);
let expression_paths = closure(edges=expression_edges, source="origin", destination="destination");
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges,source="origin",destination="destination",keys=["file"]);
let outer_lookup_scopes = select l.context as context, l.initial_scope as initial_scope, l.point as point, l.file as file, r.destination as lookup_scope from current as l join scope_paths as r on l.initial_scope = r.origin and l.file = r.file;
let ancestor_class_scopes = select l.context as context, l.lookup_scope as lookup_scope, l.file as file from outer_lookup_scopes as l join classes as r on l.lookup_scope = r.id and l.file = r.file;
let visible_outer_scopes = antijoin(left=outer_lookup_scopes,right=ancestor_class_scopes,left-on=["context","lookup_scope","file"],right-on=["context","lookup_scope","file"]);
let self_lookup_scopes = select context, initial_scope, point, file, initial_scope as lookup_scope from current;
let lookup_scopes = union(left=visible_outer_scopes,right=self_lookup_scopes);
let base_root_paths = select r.origin as expression, l.file as file from expressions as l join expression_paths as r on l.id = r.destination;
let base_name_roots = select l.expression as expression, l.file as file from base_root_paths as l join name_nodes as r on l.expression = r.id and l.file = r.file;
let root_names = select l.expression as expression, l.file as file, r.name as name from base_name_roots as l join "identifier" as r on l.expression = r.id and l.file = r.file;
let context_names = select l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from lookup_scopes as l join root_names as r on l.file = r.file;
let events = select occurrence, name, lexical as scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup" or kind = "global" or kind = "nonlocal";
let hits = as-of(left=context_names, right=events, left-on=[lookup_scope,name,file], right-on=[scope,name,file], left-order="point", right-order="ordinal", bound=at-or-before, output={context:[left,context], expression:[left,expression], lookup_scope:[left,lookup_scope], file:[left,file], occurrence:[right,occurrence], kind:[right,kind]});
let competing = select l.context as context, l.expression as expression, l.lookup_scope as farther, r.lookup_scope as closer, l.file as file from hits as l join hits as r on l.context = r.context and l.expression = r.expression and l.file = r.file where l.lookup_scope != r.lookup_scope;
let farther = select l.context as context, l.expression as expression, l.farther as lookup_scope, l.file as file from competing as l join scope_paths as r on l.closer = r.origin and l.farther = r.destination and l.file = r.file;
let nearest = antijoin(left=hits, right=farther, left-on=["context","expression","lookup_scope","file"], right-on=["context","expression","lookup_scope","file"]);
let current_rows = select context, expression, occurrence, lookup_scope as scope, kind, file from nearest;
let results = union(left=current_rows, right=staged_rows);
return results;
