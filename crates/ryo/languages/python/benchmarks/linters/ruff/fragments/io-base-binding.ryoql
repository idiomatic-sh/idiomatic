import assigned_values from "python/ruff/assigned-values";
import io_base_initializer from "python/ruff/io-base-initializer";
import io_base_annotation from "python/ruff/io-base-annotation";
input references: relation<reference: node, file: file>;
output relation<reference: node, file: file>;
let candidate_uses = select l.reference as reference, r.binding as binding, l.file as file from references as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let uses = select reference, binding, file from candidate_uses;
let values = assigned_values();
let initializer_expressions = select value as id, file from values;
let io_initializers = io_base_initializer(expressions=initializer_expressions);
let initialized = select l.binding as binding, l.file as file from values as l join io_initializers as r on l.value = r.id and l.file = r.file;
let nodes = select id, kind, file from "semantic-syntax";
let annotation_fields = select parent as owner, child as annotation, file from "semantic-child" where field = "annotation" or field = "returns";
let annotation_expressions = select annotation as id, file from annotation_fields;
let io_annotations = io_base_annotation(annotations=annotation_expressions);
let typed_annotations = select l.owner as owner, l.file as file from annotation_fields as l join io_annotations as r on l.annotation = r.id and l.file = r.file;
let targets = select parent as owner, child as target, file from "semantic-child" where field = "target";
let typed_targets = select r.target as binding, l.file as file from typed_annotations as l join targets as r on l.owner = r.owner and l.file = r.file;
let typed_parameters = select l.owner as binding, l.file as file from typed_annotations as l join nodes as r on l.owner = r.id and l.file = r.file where r.kind = "arg";
let typed = union(left=typed_targets, right=typed_parameters);
let annotated_targets = select r.target as binding, l.file as file from annotation_fields as l join targets as r on l.owner = r.owner and l.file = r.file;
let unannotated_initializers = antijoin(left=initialized, right=annotated_targets, left-on=["binding","file"], right-on=["binding","file"]);
let io_bindings = union(left=unannotated_initializers, right=typed);
let known_uses = select l.reference as reference, l.file as file from uses as l join io_bindings as r on l.binding = r.binding and l.file = r.file;
let unknown_uses = antijoin(left=uses, right=io_bindings, left-on=["binding","file"], right-on=["binding","file"]);
let unknown_references = select reference, file from unknown_uses;
let results = antijoin(left=known_uses, right=unknown_references, left-on=["reference","file"], right-on=["reference","file"]);
let unique_results = group-count(from=results, keys=["reference","file"], count="count");
let known_references = select reference, file from unique_results;
return known_references;
