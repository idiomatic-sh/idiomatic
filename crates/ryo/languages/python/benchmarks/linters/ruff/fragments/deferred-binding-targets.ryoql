import ablation_final from "python/ruff/ablation-namespace-final";
import ablation_deferred from "python/ruff/ablation-deferred";
input reads: relation<id: node, name: symbol, file: file>;
input skipped: relation<id: node, file: file>;
output relation<reference: node, occurrence: node, kind: symbol, point: number, file: file>;
let namespace_final = ablation_final();
let visited = antijoin(left=reads, right=skipped, left-on=[id,file], right-on=[id,file]);
let wanted = select id,file from visited;
let resolved = ablation_deferred(expressions=wanted);
let targets = select l.id as reference, l.name as name, r.occurrence as occurrence, r.kind as kind, r.point as point, l.file as file from visited as l join resolved as r on l.id = r.reference and l.file = r.file;
let module_binds = select reference, occurrence, kind, point, name, file from targets where kind = "bind";
let deleted_names = select name, file from namespace_final where kind = "delete" and matches(file, "[.]pyi$");
let normal = antijoin(left=module_binds, right=deleted_names, left-on=[name,file], right-on=[name,file]);
let direct = select reference, occurrence, kind, point, file from normal;
let unresolved = select reference, name, kind, point, file from targets where kind != "bind";
let reconsider = select l.reference as reference, l.name as name, l.kind as kind, l.point as point, l.file as file from module_binds as l join deleted_names as r on l.name = r.name and l.file = r.file;
let lexical = union(left=unresolved, right=reconsider);
let builtin = select reference, name, file from lexical where kind = "builtin";
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_held = select l.name as name, l.file as file from namespace_final as l join modules as r on l.namespace = r.id and l.file = r.file;
let implicit = antijoin(left=builtin, right=module_held, left-on=[name,file], right-on=[name,file]);
let fallback = antijoin(left=lexical, right=implicit, left-on=[reference,file], right-on=[reference,file]);
let paths = select l.reference as reference, l.name as name, l.point as point, r.scope as scope, r.depth as depth, l.file as file from fallback as l join "lookup-scope" as r on l.reference = r.reference and l.file = r.file;
let candidates = select l.reference as reference, l.name as name, l.scope as scope, l.depth as depth, l.point as point, r.event as occurrence, r.kind as kind, r.ordinal as ordinal, l.file as file from paths as l join namespace_final as r on l.scope = r.namespace and l.name = r.name and l.file = r.file where r.kind != "annotation" or matches(l.file, "[.]pyi$");
let nearest = group-min(from=candidates, keys=[reference,file], order="depth");
let ordinary = select reference, occurrence, kind, point, file from nearest where kind = "bind";
let deletions = select reference, name, scope, occurrence, ordinal, point, file from nearest where kind = "delete" and matches(file, "[.]pyi$");
let positions = select r.id as id, r."start-byte" as start, r.file as file from "source-location" as r;
let read_starts = select l.reference as reference, l.name as name, l.scope as scope, l.occurrence as occurrence, l.ordinal as ordinal, l.point as point, l.file as file, r.start as start from deletions as l join positions as r on l.reference = r.id and l.file = r.file;
let forward = select l.reference as reference, l.name as name, l.scope as scope, l.ordinal as ordinal, l.point as point, l.file as file from read_starts as l join positions as r on l.occurrence = r.id and l.file = r.file where l.start < r.start;
let history = select l.reference as reference, r.occurrence as occurrence, r.kind as kind, r.ordinal as ordinal, l.point as point, l.file as file from forward as l join "binding-event" as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal and r.kind in ["bind","annotation","delete","cleanup"];
let predecessor = group-max(from=history, keys=[reference,file], order="ordinal");
let restored = select reference, occurrence, kind, point, file from predecessor where kind = "bind";
let lexical_binds = union(left=ordinary, right=restored);
let answers = union(left=direct, right=lexical_binds);
return answers;
