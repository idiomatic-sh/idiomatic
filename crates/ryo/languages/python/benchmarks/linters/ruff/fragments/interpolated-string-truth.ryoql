output relation<id: node, file: file, truthy: symbol>;
let nodes = select id, kind, file from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let joined = select id, file from nodes where kind = "joined-str";
let spec_edges = select parent, child, file from edges where field = "format-spec";
let specs = select child as id, file from spec_edges;
let strings = antijoin(left=joined, right=specs, left-on=["id", "file"], right-on=["id", "file"]);
let parts0 = select l.id as string, r.child as part, l.file as file from strings as l join edges as r on l.id = r.parent and l.file = r.file;
let parts = select l.string as string, l.part as part, l.file as file from parts0 as l join nodes as r on l.part = r.id and l.file = r.file where r.kind = "f-string-part";
let formatted0 = select l.string as string, r.child as formatted, l.file as file from parts as l join edges as r on l.part = r.parent and l.file = r.file;
let formatted = select l.string as string, l.formatted as formatted, l.file as file from formatted0 as l join nodes as r on l.formatted = r.id and l.file = r.file where r.kind = "formatted-value";
let literal_text = select owner as string, value, file from "interpolated-string-literal";
let text_strings = select string, file from literal_text where value != "";
let formatted_children = select l.string as string, l.formatted as formatted, r.child as child, r.field as field, l.file as file from formatted as l join edges as r on l.formatted = r.parent and l.file = r.file;
let debug_marks = select l.string as string, l.formatted as formatted, l.file as file from formatted_children as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file where r.text = "=";
let specified = select string, formatted, file from formatted_children where field = "format-spec";
let converted = select string, formatted, file from formatted_children where field = "conversion";
let values = select string, formatted, child as value, file from formatted_children where field = "value";
let literals = select id, file, kind, empty from "literal-properties";
let empty_literals = select id, file from literals where kind = "string" and empty = "true";
let rendered_literals = antijoin(left=literals, right=empty_literals, left-on=["id", "file"], right-on=["id", "file"]);
let displays = select id, file from nodes where kind in ["list", "tuple", "set", "dict", "list-comp", "set-comp", "dict-comp", "lambda"];
let rendered_literal_ids = select id, file from rendered_literals;
let rendered_base = union(left=rendered_literal_ids, right=displays);
let conditionals = select id, file from nodes where kind = "if-exp";
let conditional_branches = select l.id as id, r.child as branch, l.file as file from conditionals as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body" or r.field = "orelse";
let unrendered_branches = antijoin(left=conditional_branches, right=rendered_base, left-on=["branch", "file"], right-on=["id", "file"]);
let rendered_conditionals = antijoin(left=conditionals, right=unrendered_branches, left-on=["id", "file"], right-on=["id", "file"]);
let named = select id, file from nodes where kind = "named-expr";
let named_values = select l.id as id, r.child as value, l.file as file from named as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "value";
let rendered_named = select l.id as id, l.file as file from named_values as l join rendered_base as r on l.value = r.id and l.file = r.file;
let rendered_compound = union(left=rendered_conditionals, right=rendered_named);
let rendered_values = union(left=rendered_base, right=rendered_compound);
let unspecified_values = antijoin(left=values, right=specified, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let rendered_interpolations = select l.string as string, l.file as file from unspecified_values as l join rendered_values as r on l.value = r.id and l.file = r.file;
let debug_strings = select string, file from debug_marks;
let own_text = union(left=text_strings, right=debug_strings);
let own_truthy = union(left=own_text, right=rendered_interpolations);
let interpolating = select string, file from formatted;
let static_strings = select id as string, file from strings;
let static_texts = antijoin(left=static_strings, right=interpolating, left-on=["string", "file"], right-on=["string", "file"]);
let own_empty = antijoin(left=static_texts, right=text_strings, left-on=["string", "file"], right-on=["string", "file"]);
let nested_truthy = select l.string as string, l.file as file from unspecified_values as l join own_truthy as r on l.value = r.string and l.file = r.file;
let truthy_strings = union(left=own_truthy, right=nested_truthy);
let empty_values = select id as value, file from empty_literals;
let nested_empty_values = select string as value, file from own_empty;
let empty_renderings = union(left=empty_values, right=nested_empty_values);
let plain_values = antijoin(left=unspecified_values, right=converted, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let undebugged_values = antijoin(left=plain_values, right=debug_marks, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let empty_interpolations = select l.string as string, l.formatted as formatted, l.file as file from undebugged_values as l join empty_renderings as r on l.value = r.value and l.file = r.file;
let other_interpolations = antijoin(left=formatted, right=empty_interpolations, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let unknown_strings = select string, file from other_interpolations;
let textless = antijoin(left=static_strings, right=text_strings, left-on=["string", "file"], right-on=["string", "file"]);
let empty_strings = antijoin(left=textless, right=unknown_strings, left-on=["string", "file"], right-on=["string", "file"]);
let truthy_ids = select string as id, file from truthy_strings;
let empty_ids = select string as id, file from empty_strings;
let truthy_rows = extend(from=truthy_ids, values={truthy: "true"});
let empty_rows = extend(from=empty_ids, values={truthy: "false"});
let result = union(left=truthy_rows, right=empty_rows);
return result;
