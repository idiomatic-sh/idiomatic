import evaluated_targets from "python/ruff/evaluated-targets";
input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let arguments = select call, file from "call-argument";
let empty_calls = antijoin(left=calls, right=arguments, left-on=["id","file"], right-on=["call","file"]);
let functions = select parent, child, file from "semantic-child" where field = "func";
let empty_functions = select l.id as call, l.file as file, r.child as function from empty_calls as l join functions as r on l.id = r.parent and l.file = r.file;
let builtin_functions = select id, file from "qualified-name" where provenance = "builtin" and (path = "builtins.list" or path = "builtins.tuple" or path = "builtins.set" or path = "builtins.dict" or path = "builtins.frozenset");
let empty_builtins = select l.call as id, l.file as file from empty_functions as l join builtin_functions as r on l.function = r.id and l.file = r.file;
let effectful_calls = antijoin(left=calls, right=empty_builtins, left-on=["id","file"], right-on=["id","file"]);
let direct_effects = select id, file from nodes where kind = "await" or kind = "named-expr" or kind = "dict-comp" or kind = "generator-exp" or kind = "list-comp" or kind = "set-comp" or kind = "subscript" or kind = "yield" or kind = "yield-from";
let binops = select id, file from nodes where kind = "bin-op";
let operands = select parent, child, file from "semantic-child" where field = "left" or field = "right";
let binop_operands = select l.id as binop, l.file as file, r.child as operand from binops as l join operands as r on l.id = r.parent and l.file = r.file;
let safe_operands = select id, file from nodes where kind = "constant" or kind = "joined-str" or kind = "list" or kind = "tuple" or kind = "set" or kind = "dict" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp";
let unsafe_operands = antijoin(left=binop_operands, right=safe_operands, left-on=["operand","file"], right-on=["id","file"]);
let unsafe_binops = select binop as id, file from unsafe_operands;
let effects_a = union(left=effectful_calls, right=direct_effects);
let effects = union(left=effects_a, right=unsafe_binops);
let all_effects = evaluated_targets(expressions=expressions, targets=effects);
let pure = antijoin(left=expressions, right=all_effects, left-on=["id","file"], right-on=["id","file"]);
return pure;
