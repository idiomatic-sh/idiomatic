import noqa_suppressions from "python/ruff/noqa-suppressions";
import noqa_codes from "python/ruff/noqa-codes";
import noqa_blankets from "python/ruff/noqa-blankets";
input candidates: relation<id: node, file: file, span: span, line: number>;
input locations: relation<id: node, file: file, span: span, line: number>;
input additional_locations: relation<id: node, file: file, line: number>;
param codes: string;
output relation<id: node, file: file, span: span, directive: node, scope: number>;
let base = noqa_suppressions(candidates=candidates, locations=locations, codes=$codes);
let directive_codes = noqa_codes();
let blankets = noqa_blankets();
let coded = select id as directive, file, line, scope from directive_codes where matches(code, $codes);
let blanket = select id as directive, file, line, scope from blankets;
let suppressions = union(left=coded, right=blanket);
let line_suppressions = select directive, file, line from suppressions where scope = 0;
let parent_match_ids = select l.id as id, l.file as file, r.directive as directive from additional_locations as l join line_suppressions as r on l.file = r.file and l.line = r.line;
let parent_matches = select l.id as id, l.file as file, l.span as span, r.directive as directive from candidates as l join parent_match_ids as r on l.id = r.id and l.file = r.file;
let file_edges = select id, file, span, directive from base where scope = 1;
let parent_without_file = antijoin(left=parent_matches, right=file_edges, left-on=[id, span], right-on=[id, span]);
let parent_edges = extend(from=parent_without_file, values={scope: 0});
let line_edges = select * from base where scope = 0;
let line_without_parent = antijoin(left=line_edges, right=parent_matches, left-on=[id, span], right-on=[id, span]);
let other_edges = select * from base where scope != 0;
let kept = union(left=other_edges, right=line_without_parent);
let matches = union(left=kept, right=parent_edges);
return matches;
