import directive_index from "python/ruff/noqa-directive-index";
import probe from "python/ruff/noqa-probe";
input candidates: relation<id: node,file: file,span: span,line: number>;
input locations: relation<id: node,file: file,span: span,line: number>;
input additional_locations: relation<id: node,file: file,line: number>;
param code: string;
output relation<id: node,file: file,span: span,directive: node,scope: number>;
let indexed = directive_index();
let non_line = select directive,file,scope,code,line as first,through as final,begin,last,bound,excluded from indexed where scope!=0;
let other_edges = probe(candidates=candidates,windows=non_line,code=$code);
let line_suppressions = select directive,file,line,scope from indexed where scope=0 and (code=$code or code="");
let line_edges = select l.id as id,l.file as file,l.span as span,r.directive as directive,r.scope as scope from line_suppressions as r join locations as l on l.file=r.file and l.line=r.line;
let parent_match_ids = select l.id as id,l.file as file,r.directive as directive,r.scope as scope from line_suppressions as r join additional_locations as l on l.file=r.file and l.line=r.line;
let parent_edges = select l.id as id,l.file as file,l.span as span,r.directive as directive,r.scope as scope from parent_match_ids as r join candidates as l on l.id=r.id and l.file=r.file;
let line_without_parent = antijoin(left=line_edges,right=parent_edges,left-on=[id,span],right-on=[id,span]);
let kept = union(left=other_edges,right=line_without_parent);
let matches = union(left=kept,right=parent_edges);
return matches;
