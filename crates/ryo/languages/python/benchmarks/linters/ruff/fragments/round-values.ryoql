import binding_type from "python/ruff/binding-type";
input calls: relation<id: node,file: file>;
output relation<call: node,integer: symbol,ndigits: symbol,file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let arguments = select call, expression, position, file from "call-argument";
let counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="expression");
let short_calls = select l.id as id, l.file as file from calls as l join counts as r on l.id = r.call and l.file = r.file where r.count <= 2;
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let wrappers_join_1 = select l.id as l_id, r.child as r_child, l.file as l_file, r.parent as r_parent, r.file as r_file from short_calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let wrappers = select l.l_id as call, l.r_child as wrapper, l.l_file as file from wrappers_join_1 as l join argument_nodes as n on l.r_child = n.id and l.r_file = n.file;
let keyword_fields = select parent, child, file from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id, l.file as file from wrappers as l join keyword_fields as r on l.wrapper = r.parent and l.file = r.file;
let keyword_args = select parent, child, file from "semantic-child" where field = "arg";
let keyword_names_join_1 = select l.call as l_call, l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from keywords as l join keyword_args as e on l.id = e.parent and l.file = e.file;
let keyword_names = select l.l_call as call, l.l_id as id, r.name as name, l.l_file as file from keyword_names_join_1 as l join "identifier" as r on l.e_child = r.id and l.e_file = r.file;
let variadic_keywords = antijoin(left=keywords, right=keyword_names, left-on=["id","file"], right-on=["id","file"]);
let starred = select id, file from nodes where kind = "starred";
let starred_calls = select l.call as id, l.file as file from arguments as l join starred as r on l.expression = r.id and l.file = r.file;
let variadic_calls = select call as id, file from variadic_keywords;
let invalid_calls = union(left=starred_calls, right=variadic_calls);
let valid_calls = antijoin(left=short_calls, right=invalid_calls, left-on=["id","file"], right-on=["id","file"]);
let values = select parent, child, file from "semantic-child" where field = "value";
let keyword_values = select l.call as call, l.name as name, r.child as expression, l.file as file from keyword_names as l join values as r on l.id = r.parent and l.file = r.file;
let keyword_expression_ids = select expression, file from keyword_values;
let positionals = antijoin(left=arguments, right=keyword_expression_ids, left-on=["expression","file"], right-on=["expression","file"]);
let named_numbers = select call, expression, file from keyword_values where name = "number";
let positional_numbers = select call, expression, file from positionals where position = 0;
let unnamed_numbers = antijoin(left=positional_numbers, right=named_numbers, left-on=["call","file"], right-on=["call","file"]);
let number_values = union(left=named_numbers, right=unnamed_numbers);
let numbers = select l.call as call, l.expression as expression, l.file as file from number_values as l join valid_calls as r on l.call = r.id and l.file = r.file;
let name_nodes = select id, file from nodes where kind = "name";
let number_names = select l.expression as reference, l.file as file from numbers as l join name_nodes as r on l.expression = r.id and l.file = r.file;
let typed_int_names = binding_type(references=number_names, builtin="builtins.int", typing="__not_a_typing_alias__", atom="integer");
let atoms = select id, file from "expression-type" where resolution = "atom" and type = "integer";
let typed_number_ids = select reference as id, file from typed_int_names;
let all_integer_values = union(left=atoms, right=typed_number_ids);
let int_numbers = select l.call as call, l.file as file from numbers as l join all_integer_values as r on l.expression = r.id and l.file = r.file;
let other_numbers0 = antijoin(left=numbers, right=int_numbers, left-on=["call","file"], right-on=["call","file"]);
let other_numbers = select call, file from other_numbers0;
let integer_calls = extend(from=int_numbers, values={integer: "true"});
let other_calls = extend(from=other_numbers, values={integer: "false"});
let classified_numbers = union(left=integer_calls, right=other_calls);
let named_digits = select call, expression, file from keyword_values where name = "ndigits";
let positional_digits = select call, expression, file from positionals where position = 1;
let unnamed_digits = antijoin(left=positional_digits, right=named_digits, left-on=["call","file"], right-on=["call","file"]);
let digit_values = union(left=named_digits, right=unnamed_digits);
let none_values = select id, file from "literal-properties" where kind = "null";
let none_digits = select l.call as call, l.file as file from digit_values as l join none_values as r on l.expression = r.id and l.file = r.file;
let no_digits0 = antijoin(left=numbers, right=digit_values, left-on=["call","file"], right-on=["call","file"]);
let no_digits = select call, file from no_digits0;
let none_calls0 = union(left=none_digits, right=no_digits);
let none_calls = extend(from=none_calls0, values={ndigits: "none"});
let nonnegative_literals = select id, file from "numeric-literal" where kind = "integer" and numeric_gte(value, 0) and numeric_gte(9223372036854775807, value);
let nonnegative_digits = select l.call as call, l.file as file from digit_values as l join nonnegative_literals as r on l.expression = r.id and l.file = r.file;
let nonnegative_calls = extend(from=nonnegative_digits, values={ndigits: "nonnegative-literal"});
let integer_digits0 = select l.call as call, l.file as file from digit_values as l join atoms as r on l.expression = r.id and l.file = r.file;
let integer_digits = antijoin(left=integer_digits0, right=nonnegative_digits, left-on=["call","file"], right-on=["call","file"]);
let integer_digit_calls = extend(from=integer_digits, values={ndigits: "integer-expression"});
let recognized_digits0 = union(left=none_calls, right=nonnegative_calls);
let recognized_digits = union(left=recognized_digits0, right=integer_digit_calls);
let result = select l.call as call, l.integer as integer, r.ndigits as ndigits, l.file as file from classified_numbers as l join recognized_digits as r on l.call = r.call and l.file = r.file;
return result;
