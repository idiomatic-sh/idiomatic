import directive_index from "python/ruff/noqa-directive-index";
import probe from "python/ruff/noqa-probe";
input candidates: relation<id: node,file: file,span: span,line: number>;
param code: string;
output relation<id: node,file: file,span: span,directive: node,scope: number>;
let indexed = directive_index();
let windows = select directive,file,scope,code,first as first,final as final,begin,last,bound,excluded from indexed;
let matched = probe(candidates=candidates,windows=windows,code=$code);
return matched;
