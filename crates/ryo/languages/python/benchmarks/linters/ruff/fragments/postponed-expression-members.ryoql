input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let late_annotations = select id, file from "annotation-evaluation" where evaluation != "eager";
let late = select l.id as id, l.file as file from expressions as l join late_annotations as r on l.id = r.id and l.file = r.file;
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_axes = axis(from=expressions, relation="semantic-child", direction=nearest-ancestor, domain=embedded_roots);
let inner = select id, file from embedded_axes;
let roots = select l.id as id, l.file as file from expressions as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let embedded = union(left=inner,right=roots);
let result = union(left=late,right=embedded);
return result;
