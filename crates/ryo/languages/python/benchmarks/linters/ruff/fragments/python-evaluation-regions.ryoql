output relation<id: node, kind: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let lexical_scopes = select id, kind, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let lexical_regions = select r.child as id, l.kind as kind, l.file as file from lexical_scopes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let comprehensions = select id, kind, file from nodes where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let results = select r.child as id, l.kind as kind, l.file as file from comprehensions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elt" or r.field = "key" or r.field = "value";
let clauses = select l.id as owner, r.child as clause, r.ordinal as ordinal, l.kind as kind, l.file as file from comprehensions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let later = select l.clause as clause, l.kind as kind, l.file as file from clauses as l join clauses as r on l.owner = r.owner and l.file = r.file where l.ordinal > r.ordinal;
let later_iterables = select r.child as id, l.kind as kind, l.file as file from later as l join "semantic-child" as r on l.clause = r.parent and l.file = r.file where r.field = "iter";
let filters = select r.child as id, l.kind as kind, l.file as file from clauses as l join "semantic-child" as r on l.clause = r.parent and l.file = r.file where r.field = "ifs";
let comp_values = union(left=results, right=later_iterables);
let comp_regions = union(left=comp_values, right=filters);
let result = union(left=lexical_regions, right=comp_regions);
return result;
