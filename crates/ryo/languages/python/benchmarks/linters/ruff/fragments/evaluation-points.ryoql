input reads: relation<reference: node, file: file>;
output relation<reference: node, point: number, file: file>;
let reference_points = select l.reference as reference, r.ordinal as point, l.file as file from reads as l join "binding-event" as r on l.reference = r.occurrence and l.file = r.file where r.kind = "read" or r.kind = "delete";
let lazy_roots = select child as id, file from "semantic-child" where field = "bound" or field = "default-value";
let lazy_inputs = select reference as id, file from reads;
let lazy_axis = axis(from=lazy_inputs, relation="semantic-child", direction=ancestor, domain=lazy_roots);
let lazy_nested = select id as reference, file from lazy_axis;
let lazy_self = select l.id as reference, l.file as file from lazy_inputs as l join lazy_roots as r on l.id = r.id and l.file = r.file;
let lazy_reads = union(left=lazy_nested, right=lazy_self);
let eager_points = antijoin(left=reference_points, right=lazy_reads, left-on=["reference", "file"], right-on=["reference", "file"]);
let lazy_points0 = extend(from=lazy_reads, values={point: 2147483647});
let lazy_points = select reference, point, file from lazy_points0;
let points = union(left=eager_points, right=lazy_points);
return points;
