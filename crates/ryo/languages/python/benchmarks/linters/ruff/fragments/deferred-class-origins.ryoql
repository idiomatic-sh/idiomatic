import qualified_origins from "python/ruff/qualified-origins";
input expressions: relation<id: node, file: file>;
output relation<expression: node, path: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let name_nodes = select id, file from nodes where kind = "name";
let named_expressions = select l.id as id, l.file as file from expressions as l join name_nodes as r on l.id = r.id and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let attribute_expressions = select l.id as id, l.file as file from expressions as l join attributes as r on l.id = r.id and l.file = r.file;
let attribute_roots = select r.child as id, l.file as file from attribute_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let named_attribute_roots = select l.id as id, l.file as file from attribute_roots as l join name_nodes as r on l.id = r.id and l.file = r.file;
let roots = union(left=named_expressions, right=named_attribute_roots);
let classes = select id, file from nodes where kind = "class-def";
let name_class_axes = axis(from=roots, relation="semantic-child", direction=nearest-ancestor, domain=classes);
let read_events = select occurrence as id, ordinal, file from "binding-event" where kind = "read";
let name_points = select l.id as context, l.related as initial_scope, r.ordinal as header_point, l.file as file from name_class_axes as l join read_events as r on l.id = r.id and l.file = r.file;
let file_ordinals = select ordinal as point, file from "binding-event";
let prior_file_ordinals = select l.point as point, l.file as file from file_ordinals as l join file_ordinals as r on l.file = r.file where l.point < r.point;
let final_file_ordinals = antijoin(left=file_ordinals, right=prior_file_ordinals, left-on=["point", "file"], right-on=["point", "file"]);
let late_name_contexts = select l.context as context, l.initial_scope as initial_scope, r.point as point, l.header_point as header_point, l.file as file from name_points as l join final_file_ordinals as r on l.file = r.file;
let context_rows = extend(from=late_name_contexts, values={stage: 1});
let contexts = select context, initial_scope, point, header_point, stage, file from context_rows;
let origins = qualified_origins(symbol_contexts=contexts, expressions=expressions);
let results = select expression, path, file from origins;
return results;
