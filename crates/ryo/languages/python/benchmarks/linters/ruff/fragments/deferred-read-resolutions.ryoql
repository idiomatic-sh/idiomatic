import lookup_events from "python/ruff/lookup-read-events";
import type_context from "python/ruff/type-definition-context";
input missing: relation<id: node, name: symbol, scope: node, phase: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let expressions = select id, file from missing;
let typed = type_context(expressions=expressions);
let stub_types = select id, file from typed where kind = "type" and matches(file, "[.]pyi$");
let events = select occurrence as id, scope, name, ordinal, kind, file from "binding-event";
let reads = select l.id as id, l.name as name, l.scope as scope, r.ordinal as point, l.file as file from missing as l join events as r on l.id = r.id and l.file = r.file where r.kind = "read";
let future_imports = select occurrence as id, file from "static-import" where target = "__future__.annotations";
let future_modules = select id, file from nodes where kind = "module";
let future_events0 = select l.id as id, r.scope as scope, l.file as file from future_imports as l join events as r on l.id = r.id and l.file = r.file;
let future_events = select l.id as id, l.file as file from future_events0 as l join future_modules as r on l.scope = r.id and l.file = r.file;
let future_points = select r."start-byte" as point, l.file as file from future_events as l join "source-location" as r on l.id = r.id and l.file = r.file;
let native_types = select reference as id, file from "binding-read" where context = "type";
let future_type_reads0 = select l.id as id, l.file as file from reads as l join native_types as r on l.id = r.id and l.file = r.file;
let future_type_reads = select l.id as id, r."start-byte" as point, l.file as file from future_type_reads0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let future_types = select l.id as id, l.file as file from future_type_reads as l join future_points as r on l.file = r.file where r.point <= l.point;
let type_parameters = select id, name, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_nodes = select id, file from nodes where kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let parameter_payloads = select l.id as owner, r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "bound" or r.field = "default-value";
let aliases = select id, file from nodes where kind = "type-alias";
let alias_payloads = select l.id as owner, r.child as id, l.file as file from aliases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let explicit_payloads0 = union(left=parameter_payloads, right=alias_payloads);
let explicit_payloads = select id, file from explicit_payloads0;
let embedded_payloads = select root as id, file from "embedded-expression";
let classes = select id, file from nodes where kind = "class-def";
let call_containers = select id, file from nodes where kind = "call-arguments";
let class_children = select l.id as owner, r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_headers = select l.owner as owner, l.id as id, l.file as file from class_children as l join call_containers as r on l.id = r.id and l.file = r.file;
let stub_class_headers = select id, file from class_headers where matches(file, "[.]pyi$");
let deferred_roots0 = union(left=explicit_payloads, right=embedded_payloads);
let deferred_roots = union(left=deferred_roots0, right=stub_class_headers);
let payload_descendants = axis(from=deferred_roots, relation="semantic-child", direction=descendant, domain=expressions);
let payload_members = select related as id, file from payload_descendants;
let direct_payloads = select l.id as id, l.file as file from expressions as l join deferred_roots as r on l.id = r.id and l.file = r.file;
let payload_types = union(left=payload_members, right=direct_payloads);
let deferred_types0 = union(left=stub_types, right=future_types);
let deferred_types = union(left=deferred_types0, right=payload_types);
let all_points = select ordinal as point, file from events;
let older_points = select l.point as point, l.file as file from all_points as l join all_points as r on l.file = r.file where l.point < r.point;
let final_points = antijoin(left=all_points, right=older_points, left-on=["point", "file"], right-on=["point", "file"]);
let deferred_reads = select l.id as id, r.scope as initial_scope, l.file as file from deferred_types as l join reads as r on l.id = r.id and l.file = r.file;
let context_points = select l.id as context, l.initial_scope as initial_scope, r.point as point, r.point as header_point, l.file as file from deferred_reads as l join final_points as r on l.file = r.file;
let context_rows = extend(from=context_points, values={stage: 0});
let contexts = select context, initial_scope, point, header_point, stage, file from context_rows;
let local_events0 = lookup_events(ordered_contexts=contexts, expressions=expressions);
let local_events = select context, expression, occurrence, scope, kind, file from local_events0 where context = expression;
let local_bound = select context as id, file from local_events where kind = "bind" or kind = "annotation" and matches(file, "[.]pyi$");
let modules = select id, file from nodes where kind = "module";
let module_context_points = select l.context as context, r.id as initial_scope, l.point as point, l.header_point as header_point, l.stage as stage, l.file as file from contexts as l join modules as r on l.file = r.file;
let module_contexts = select context, initial_scope, point, header_point, stage, file from module_context_points;
let module_events0 = lookup_events(ordered_contexts=module_contexts, expressions=expressions);
let module_bound = select context as id, file from module_events0 where context = expression and kind = "bind";
let deletion_events = select l.context as id, l.occurrence as deletion, l.scope as scope, r.name as name, r.ordinal as point, l.file as file from local_events as l join events as r on l.occurrence = r.id and l.file = r.file where l.kind = "delete" and matches(l.file, "[.]pyi$");
let source_locations = select id, "start-byte" as start, file from "source-location";
let reference_positions = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, l.point as point, r.start as reference_start, l.file as file from deletion_events as l join source_locations as r on l.id = r.id and l.file = r.file;
let forward_deletions = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, l.point as point, l.file as file from reference_positions as l join source_locations as r on l.deletion = r.id and l.file = r.file where l.reference_start < r.start;
let predecessor_options = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, r.ordinal as point, r.kind as kind, l.file as file from forward_deletions as l join events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point and (r.kind = "bind" or r.kind = "annotation" or r.kind = "delete" or r.kind = "cleanup");
let older_predecessors = select l.id as id, l.deletion as deletion, l.point as point, l.file as file from predecessor_options as l join predecessor_options as r on l.id = r.id and l.deletion = r.deletion and l.file = r.file where l.point < r.point;
let predecessors = antijoin(left=predecessor_options, right=older_predecessors, left-on=["id", "deletion", "point", "file"], right-on=["id", "deletion", "point", "file"]);
let restored_bindings = select id, file from predecessors where kind = "bind";
let no_predecessors = antijoin(left=forward_deletions, right=predecessor_options, left-on=["id", "file"], right-on=["id", "file"]);
let no_module_predecessors = select l.id as id, l.name as name, l.file as file from no_predecessors as l join modules as r on l.scope = r.id and l.file = r.file;
let builtins = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let restored_builtins = select l.id as id, l.file as file from no_module_predecessors as l join builtins as r on l.name = r.name and l.file = r.file;
let restored0 = union(left=restored_bindings, right=restored_builtins);
let known0 = union(left=local_bound, right=module_bound);
let known = union(left=known0, right=restored0);
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let generic_owners0 = union(left=functions, right=classes);
let generic_owners = union(left=generic_owners0, right=aliases);
let parameter_owners = axis(from=type_parameters, relation="semantic-child", direction=nearest-ancestor, domain=generic_owners);
let owned_parameters = select l.id as declaration, l.name as name, r.related as owner, l.file as file from type_parameters as l join parameter_owners as r on l.id = r.id and l.file = r.file;
let direct_visibility = select l.id as owner, r.child as root, l.file as file from generic_owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body" or r.field = "returns" or r.field = "type-params";
let alias_visibility = select owner, id as root, file from alias_payloads;
let class_visibility = select owner, id as root, file from class_headers;
let args = select id, file from nodes where kind = "arg";
let annotations = select r.child as id, l.file as file from args as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let annotation_owners = axis(from=annotations, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let annotation_visibility = select related as owner, id as root, file from annotation_owners;
let visibility0 = union(left=direct_visibility, right=alias_visibility);
let visibility1 = union(left=class_visibility, right=annotation_visibility);
let visibility = union(left=visibility0, right=visibility1);
let roots = select root as id, file from visibility;
let visible_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=roots);
let visible_reads = select l.id as id, r.owner as owner, l.file as file from visible_axes as l join visibility as r on l.related = r.root and l.file = r.file;
let visible_direct = select l.id as id, r.owner as owner, l.file as file from expressions as l join visibility as r on l.id = r.root and l.file = r.file;
let all_visible_reads = union(left=visible_reads, right=visible_direct);
let parameter_matches = select l.id as id, l.owner as owner, l.file as file from all_visible_reads as l join owned_parameters as r on l.owner = r.owner and l.file = r.file;
let named_matches = select l.id as id, l.owner as owner, r.name as name, l.file as file from parameter_matches as l join owned_parameters as r on l.owner = r.owner and l.file = r.file;
let matching_parameter_reads = select l.id as id, l.owner as owner, l.file as file from named_matches as l join missing as r on l.id = r.id and l.name = r.name and l.file = r.file;
let scope_edges = select child as child, parent as parent, file from "scope";
let scope_paths = closure(edges=scope_edges, source="child", destination="parent", keys=["file"]);
let shadowing_scopes = select l.id as id, r.scope as scope, r.name as name, r.point as point, l.owner as owner, l.file as file from matching_parameter_reads as l join reads as r on l.id = r.id and l.file = r.file;
let initial_local_reads = select l.id as id, l.scope as scope, l.name as name, l.point as point, l.owner as owner, l.file as file from shadowing_scopes as l join scope_paths as r on l.scope = r.child and l.owner = r.parent and l.file = r.file;
let direct_local_reads = select id, scope, name, point, owner, file from shadowing_scopes where scope = owner;
let base_local_reads = union(left=initial_local_reads, right=direct_local_reads);
let ancestor_scope_options = select l.id as id, r.parent as scope, l.name as name, l.point as point, l.owner as owner, l.file as file from shadowing_scopes as l join scope_paths as r on l.scope = r.child and l.file = r.file;
let enclosed_ancestor_scopes = select l.id as id, l.scope as scope, l.name as name, l.point as point, l.owner as owner, l.file as file from ancestor_scope_options as l join scope_paths as r on l.scope = r.child and l.owner = r.parent and l.file = r.file;
let owner_ancestor_scopes = select id, scope, name, point, owner, file from ancestor_scope_options where scope = owner;
let ancestor_scopes = union(left=enclosed_ancestor_scopes, right=owner_ancestor_scopes);
let raw_local_reads = union(left=base_local_reads, right=ancestor_scopes);
let ancestor_class_scopes0 = select l.id as id, l.scope as scope, l.owner as owner, l.file as file from raw_local_reads as l join classes as r on l.scope = r.id and l.file = r.file;
let ancestor_class_scopes = select l.id as id, l.scope as scope, l.owner as owner, l.file as file from ancestor_class_scopes0 as l join reads as r on l.id = r.id and l.file = r.file where l.scope != r.scope;
let local_reads = antijoin(left=raw_local_reads, right=ancestor_class_scopes, left-on=["id", "scope", "owner", "file"], right-on=["id", "scope", "owner", "file"]);
let nonparameter_events = antijoin(left=events, right=type_parameters, left-on=["id", "file"], right-on=["id", "file"]);
let locally_shadowed = select l.id as id, l.owner as owner, l.file as file from local_reads as l join nonparameter_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (r.kind = "bind" or r.kind = "annotation" or r.kind = "delete" or r.kind = "cleanup");
let known_parameters = antijoin(left=matching_parameter_reads, right=locally_shadowed, left-on=["id", "owner", "file"], right-on=["id", "owner", "file"]);
let known_parameter_ids = select id, file from known_parameters;
let results = union(left=known, right=known_parameter_ids);
return results;
