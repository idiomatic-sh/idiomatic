input pairs: relation<context: node, left: node, right: node, file: file>;
output relation<context: node, left: node, right: node, file: file>;
let nodes = select id, kind, text, file from "semantic-syntax";
let shapes = select id, shape, file from "expression-shape";
let all_edges = select parent, child, ordinal, field, file from "semantic-child";
let embedded = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=all_edges, right=embedded, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let left_roots = select left as id, file from pairs;
let right_roots = select right as id, file from pairs;
let roots = union(left=left_roots, right=right_roots);
let classes = subtree-class(id="id", parent="parent", child="child", from=roots, relation=walk_edges, labels=nodes, leaves=shapes, label=["kind", "text"], leaf-label=["shape"], step=["field", "ordinal"], output="class");
let left_classes = select l.context as context, l.left as left, l.right as right, r.class as class, l.file as file from pairs as l join classes as r on l.left = r.id and l.file = r.file;
let equal = select l.context as context, l.left as left, l.right as right, l.file as file from left_classes as l join classes as r on l.right = r.id and l.class = r.class and l.file = r.file;
return equal;
