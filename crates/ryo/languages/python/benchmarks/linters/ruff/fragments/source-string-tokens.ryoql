output relation<id: node, file: file, span: span>;
let tokens = select id, file, span from "semantic-syntax" where kind = "string" or kind = "fstring-middle" or kind = "tstring-middle";
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_descendants = axis(from=embedded_roots, relation="semantic-child", direction=descendant, domain=tokens);
let embedded_tokens = select related as id, file from embedded_descendants;
let source_tokens = antijoin(left=tokens, right=embedded_tokens, left-on=["id", "file"], right-on=["id", "file"]);
return source_tokens;
