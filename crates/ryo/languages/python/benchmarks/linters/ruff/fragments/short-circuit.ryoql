import interpolated_string_truth from "python/ruff/interpolated-string-truth";
import boolean_test_context from "python/ruff/boolean-test-context";
import without_effect from "python/ruff/without-effect";
param operator: string;
param truthy: string;
output relation<id: node, file: file, span: span, line: number>;
let nodes = select id, kind, file, span from "semantic-syntax";
let operator_edges = select parent, child, file from "semantic-child" where field = "op";
let operator_tokens = select id, file from "semantic-syntax" where text = $operator;
let wanted_ops = select l.parent as id, l.file as file from operator_edges as l join operator_tokens as r on l.child = r.id and l.file = r.file;
let value_edges = select parent, child, ordinal, file from "semantic-child" where field = "values";
let boolean_values = select l.id as boolop, l.file as file, r.child as value, r.ordinal as ordinal from wanted_ops as l join value_edges as r on l.id = r.parent and l.file = r.file;
let literals = select id, file, kind, zero, empty, boolean from "literal-properties";
let true_booleans = select id, file from literals where boolean = "true";
let true_numbers = select id, file from literals where (kind = "integer" or kind = "float" or kind = "complex") and zero = "false";
let true_strings = select id, file from literals where (kind = "string" or kind = "bytes") and empty = "false";
let true_ellipses0 = select id, file from literals where kind = "ellipsis";
let callables = select id, file from nodes where kind in ["lambda", "generator-exp"];
let true_ellipses = union(left=true_ellipses0, right=callables);
let false_booleans = select id, file from literals where kind = "boolean" and boolean = "false";
let false_numbers = select id, file from literals where (kind = "integer" or kind = "float" or kind = "complex") and zero = "true";
let false_strings = select id, file from literals where (kind = "string" or kind = "bytes") and empty = "true";
let false_nulls = select id, file from literals where kind = "null";
let interpolated_truth = interpolated_string_truth();
let true_interpolated = select id, file from interpolated_truth where truthy = "true";
let false_interpolated = select id, file from interpolated_truth where truthy = "false";
let displays = select id, file from nodes where kind in ["list", "tuple", "set"];
let display_elements = select l.id as id, l.file as file, r.child as element from displays as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let starred_nodes = select id, file from nodes where kind = "starred";
let unstarred_elements = antijoin(left=display_elements, right=starred_nodes, left-on=["element","file"], right-on=["id","file"]);
let populated_displays = select id, file from display_elements;
let true_displays = select id, file from unstarred_elements;
let false_displays = antijoin(left=displays, right=populated_displays, left-on=["id","file"], right-on=["id","file"]);
let dicts = select id, file from nodes where kind = "dict";
let dict_values = select l.id as id, l.file as file from dicts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "values";
let true_dicts = select l.id as id, l.file as file from dicts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "keys";
let false_dicts = antijoin(left=dicts, right=dict_values, left-on=["id","file"], right-on=["id","file"]);
let calls = select id, file from nodes where kind = "call";
let call_functions = select l.id as call, l.file as file, r.child as function from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let initializers = select id, file from "qualified-name" where provenance = "builtin" and (path in ["builtins.list", "builtins.tuple", "builtins.set", "builtins.dict", "builtins.frozenset"]);
let initializer_calls = select l.call as id, l.file as file from call_functions as l join initializers as r on l.function = r.id and l.file = r.file;
let call_arguments = select call, file from "call-argument";
let empty_initializers = antijoin(left=initializer_calls, right=call_arguments, left-on=["id","file"], right-on=["call","file"]);
let keyword_edges = select parent as id, file from "semantic-child" where field = "keywords";
let argument_rows = select call, file, expression, position from "call-argument";
let initializer_args = select l.id as id, l.file as file, r.expression as argument, r.position as ordinal from initializer_calls as l join argument_rows as r on l.id = r.call and l.file = r.file;
let later_args = select l.id as id, l.file as file from initializer_args as l join initializer_args as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal;
let single_args0 = antijoin(left=initializer_args, right=later_args, left-on=["id","file"], right-on=["id","file"]);
let single_args = antijoin(left=single_args0, right=keyword_edges, left-on=["id","file"], right-on=["id","file"]);
let containers = select id, file from nodes where kind in ["list", "tuple", "set", "dict"];
let container_args = select l.id as id, l.file as file, l.argument as argument from single_args as l join containers as r on l.argument = r.id and l.file = r.file;
let truth_a = union(left=true_booleans, right=true_numbers);
let truth_b = union(left=true_strings, right=true_ellipses);
let truth_c = union(left=true_interpolated, right=true_displays);
let truth_d = union(left=truth_a, right=truth_b);
let truth_e = union(left=truth_c, right=true_dicts);
let direct_true = union(left=truth_d, right=truth_e);
let falsity_a = union(left=false_booleans, right=false_numbers);
let falsity_b = union(left=false_strings, right=false_nulls);
let falsity_c = union(left=false_interpolated, right=false_displays);
let falsity_d = union(left=falsity_a, right=falsity_b);
let falsity_e = union(left=falsity_c, right=false_dicts);
let direct_false0 = union(left=falsity_d, right=falsity_e);
let direct_false = union(left=direct_false0, right=empty_initializers);
let wrapped_true = select l.id as id, l.file as file from container_args as l join direct_true as r on l.argument = r.id and l.file = r.file;
let wrapped_false = select l.id as id, l.file as file from container_args as l join direct_false as r on l.argument = r.id and l.file = r.file;
let true_values = union(left=direct_true, right=wrapped_true);
let false_values = union(left=direct_false, right=wrapped_false);
let true_rows = extend(from=true_values, values={truth: "true"});
let false_rows = extend(from=false_values, values={truth: "false"});
let truth = union(left=true_rows, right=false_rows);
let short_values = select id, file from truth where truth = $truthy;
let unknown_values = antijoin(left=boolean_values, right=truth, left-on=["value","file"], right-on=["id","file"]);
let boolean_ops = select id, file from wanted_ops;
let tested_ops = boolean_test_context(expressions=boolean_ops);
let tested_unknowns = select l.boolop as boolop, l.file as file, l.value as value from unknown_values as l join tested_ops as r on l.boolop = r.id and l.file = r.file;
let tested_unknown_values = select value as id, file from tested_unknowns;
let pure_tested_values = without_effect(expressions=tested_unknown_values);
let passing_unknowns = select l.boolop as boolop, l.file as file, l.value as value from tested_unknowns as l join pure_tested_values as r on l.value = r.id and l.file = r.file;
let blocking = antijoin(left=unknown_values, right=passing_unknowns, left-on=["boolop","value","file"], right-on=["boolop","value","file"]);
let later_pairs = select l.boolop as boolop, l.file as file, l.value as value, l.ordinal as ordinal, r.value as next, r.ordinal as next_ordinal from boolean_values as l join boolean_values as r on l.boolop = r.boolop and l.file = r.file where l.ordinal < r.ordinal;
let windows = group-min(from=later_pairs, keys=["boolop", "file", "value"], order="next_ordinal");
let open_windows = antijoin(left=windows, right=blocking, left-on=["boolop","value","file"], right-on=["boolop","value","file"]);
let current_hits = select l.boolop as boolop, l.file as file, l.ordinal as ordinal from open_windows as l join short_values as r on l.value = r.id and l.file = r.file;
let next_hits = select l.boolop as boolop, l.file as file, l.ordinal as ordinal from open_windows as l join short_values as r on l.next = r.id and l.file = r.file;
let hits = union(left=current_hits, right=next_hits);
let first_hits = group-min(from=hits, keys=["boolop", "file"], order="ordinal");
let prior_blocks = select l.boolop as boolop, l.file as file, r.ordinal as block from first_hits as l join blocking as r on l.boolop = r.boolop and l.file = r.file where r.ordinal < l.ordinal;
let last_blocks = group-max(from=prior_blocks, keys=["boolop", "file"], order="block");
let furthest_values = select l.boolop as boolop, l.file as file, r.next as value from last_blocks as l join windows as r on l.boolop = r.boolop and l.file = r.file and l.block = r.ordinal;
let furthest_locations = select l.boolop as boolop, l.file as file, r.span as start_span, r."start-line" as line from furthest_values as l join "source-location" as r on l.value = r.id and l.file = r.file;
let furthest_offsets = span-bounds(from=furthest_locations, span="start_span", start-output="value_begin", end-output="value_end");
let opening_parens = select id, file, span from "semantic-syntax" where text = "(";
let opening_offsets = span-bounds(from=opening_parens, span="span", start-output="opening_begin", end-output="opening_end");
let matching_closers = select source, target, file from "token-link" as t where t."link-kind" = "matching-delimiter";
let closing_offsets = select l.source as opening, l.file as file, r."start-byte" as closing_begin from matching_closers as l join "source-location" as r on l.target = r.id and l.file = r.file;
let enclosing_openings = select l.boolop as boolop, l.file as file, l.start_span as start_span, l.value_end as value_end, r.id as opening, r.span as opening_span from furthest_offsets as l join opening_offsets as r on l.file = r.file and l.value_begin = r.opening_end;
let wrapped_starts = select l.boolop as boolop, l.file as file, l.start_span as original_span, l.opening_span as start_span from enclosing_openings as l join closing_offsets as r on l.opening = r.opening and l.file = r.file where r.closing_begin = l.value_end;
let wrapped_rows = select l.boolop as boolop, l.file as file, l.start_span as start_span, r.line as line from wrapped_starts as l join furthest_locations as r on l.boolop = r.boolop and l.file = r.file and l.original_span = r.start_span;
let plain_rows0 = antijoin(left=furthest_locations, right=wrapped_starts, left-on=["boolop","file","start_span"], right-on=["boolop","file","original_span"]);
let plain_rows = select boolop, file, start_span, line from plain_rows0;
let started_rows = union(left=plain_rows, right=wrapped_rows);
let started_bounds = select l.boolop as id, l.file as file, l.start_span as start_span, l.line as line, r.span as expression_span from started_rows as l join nodes as r on l.boolop = r.id and l.file = r.file;
let started = span-between(from=started_bounds, start="start_span", end="expression_span", output="span");
let started_locations = select id, file, span, line from started;
let whole_hits = antijoin(left=first_hits, right=last_blocks, left-on=["boolop","file"], right-on=["boolop","file"]);
let whole_locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from whole_hits as l join "source-location" as r on l.boolop = r.id and l.file = r.file;
let locations = union(left=started_locations, right=whole_locations);
return locations;
