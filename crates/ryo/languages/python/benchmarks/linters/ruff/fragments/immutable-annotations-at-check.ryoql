import final_own from "python/ruff/module-final-at-check";
import lookup_symbols from "python/ruff/lookup-symbol-events";
import deferred_types from "python/ruff/deferred-type-reads";
input checks: relation<check: node, root: node, scope: node, point: number, file: file>;
output relation<check: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let roots = select root as id, file from checks;
let root_axes = axis(from=roots, relation="semantic-child", direction=descendant, domain=nodes);
let nested_members = select r.check as check, l.related as id, l.file as file from root_axes as l join checks as r on l.id = r.root and l.file = r.file;
let root_members = select check, root as id, file from checks;
let members = union(left=nested_members, right=root_members);
let name_nodes = select id, file from nodes where kind = "name";
let member_names = select l.check as check, l.id as id, l.file as file from members as l join name_nodes as r on l.id = r.id and l.file = r.file;
let expression_inputs = select id, file from members;
let deferred_visits = deferred_types(expressions=expression_inputs);
let cached_paths0 = select l.check as check, l.id as id, r.path as path, r.provenance as origin, l.file as file from members as l join "qualified-name" as r on l.id = r.id and l.file = r.file where r.provenance = "import" or r.provenance = "builtin" and (r."since-major" < 3 or r."since-major" = 3 and r."since-minor" <= 10);
let cached_paths = antijoin(left=cached_paths0, right=deferred_visits, left-on=["id", "file"], right-on=["id", "file"]);
let cached_uses = select reference as id, file from "binding-use";
let unresolved_names = antijoin(left=member_names, right=cached_uses, left-on=["id", "file"], right-on=["id", "file"]);
let postponed_names = select l.check as check, l.id as id, l.file as file from member_names as l join deferred_visits as r on l.id = r.id and l.file = r.file;
let fresh_names = union(left=unresolved_names, right=postponed_names);
let fresh_inputs = select id, file from fresh_names;
let fresh_name_scopes = select l.id as id, r.scope as scope, l.file as file from fresh_names as l join checks as r on l.check = r.check and l.file = r.file;
let fresh_name_scope_counts = group-count(from=fresh_name_scopes, keys=["id", "file"], count="scopes", distinct="scope");
let single_scope_names = select id, file from fresh_name_scope_counts where scopes = 1;
let shared_scope_names = select id, file from fresh_name_scope_counts where scopes > 1;
let own_contexts0 = select l.id as context, r.scope as initial_scope, r.point as point, r.point as header_point, l.file as file from fresh_names as l join checks as r on l.check = r.check and l.file = r.file;
let own_contexts1 = select l.context as context, l.initial_scope as initial_scope, l.point as point, l.header_point as header_point, l.file as file from own_contexts0 as l join single_scope_names as r on l.context = r.id and l.file = r.file;
let own_contexts2 = project(from=own_contexts1, columns=["context", "initial_scope", "point", "header_point", "file"]);
let own_contexts = extend(from=own_contexts2, values={stage: 4});
let shared_name_checks = select l.check as check, l.file as file from fresh_names as l join shared_scope_names as r on l.id = r.id and l.file = r.file;
let shared_contexts0 = select l.check as context, l.scope as initial_scope, l.point as point, l.point as header_point, l.file as file from checks as l join shared_name_checks as r on l.check = r.check and l.file = r.file;
let shared_contexts1 = project(from=shared_contexts0, columns=["context", "initial_scope", "point", "header_point", "file"]);
let shared_contexts = extend(from=shared_contexts1, values={stage: 2});
let lookup_contexts0 = union(left=own_contexts, right=shared_contexts);
let lookup_contexts = select context, initial_scope, point, header_point, stage, file from lookup_contexts0;
let final_bindings = final_own(contexts=own_contexts);
let pending_contexts = antijoin(left=lookup_contexts,right=final_bindings,left-on=[context,file],right-on=[context,file]);
let other_bindings = lookup_symbols(ordered_contexts=pending_contexts, expressions=fresh_inputs);
let raw_bindings = union(left=final_bindings,right=other_bindings);
let own_bindings = select l.check as check, l.id as id, r.occurrence as occurrence, r.scope as scope, r.kind as kind, l.file as file from fresh_names as l join raw_bindings as r on l.id = r.context and l.id = r.expression and l.file = r.file;
let shared_fresh_names = select l.check as check, l.id as id, l.file as file from fresh_names as l join shared_scope_names as r on l.id = r.id and l.file = r.file;
let shared_bindings = select l.check as check, l.id as id, r.occurrence as occurrence, r.scope as scope, r.kind as kind, l.file as file from shared_fresh_names as l join raw_bindings as r on l.check = r.context and l.id = r.expression and l.file = r.file;
let relevant_bindings = union(left=own_bindings, right=shared_bindings);
let argument_declarations = select id, name, owner as scope, file from "defines" where kind = "parameter";
let fresh_name_labels = select l.check as check, l.id as id, r.name as name, l.file as file from fresh_names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let scoped_name_labels = select l.check as check, l.id as id, l.name as name, r.scope as scope, l.file as file from fresh_name_labels as l join checks as r on l.check = r.check and l.file = r.file;
let argument_matches = select l.check as check, l.id as id, r.id as occurrence, l.scope as scope, l.file as file from scoped_name_labels as l join argument_declarations as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let argument_bindings0 = extend(from=argument_matches, values={kind: "bind"});
let argument_bindings = select check, id, occurrence, scope, kind, file from argument_bindings0;
let outer_bindings = antijoin(left=relevant_bindings, right=argument_matches, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let initial_bindings = union(left=outer_bindings, right=argument_bindings);
let generic_owners = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "type-alias";
let type_parameters = select id, name, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_axes = axis(from=type_parameters, relation="semantic-child", direction=nearest-ancestor, domain=generic_owners);
let owned_parameters = select l.id as declaration, l.name as name, r.related as owner, l.file as file from type_parameters as l join parameter_axes as r on l.id = r.id and l.file = r.file;
let context_scopes = select scope as id, file from checks;
let generic_ancestor_axes = axis(from=context_scopes, relation="semantic-child", direction=ancestor, domain=generic_owners);
let ancestor_generics = select r.check as check, l.related as owner, l.file as file from generic_ancestor_axes as l join checks as r on l.id = r.scope and l.file = r.file;
let own_generics = select l.check as check, l.scope as owner, l.file as file from checks as l join generic_owners as r on l.scope = r.id and l.file = r.file;
let visible_generics = union(left=ancestor_generics, right=own_generics);
let contextual_parameters = select l.check as check, r.declaration as declaration, r.name as name, l.owner as owner, l.file as file from visible_generics as l join owned_parameters as r on l.owner = r.owner and l.file = r.file;
let parameter_name_matches = select l.check as check, l.id as id, r.declaration as occurrence, r.owner as owner, l.file as file from fresh_name_labels as l join contextual_parameters as r on l.check = r.check and l.name = r.name and l.file = r.file;
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges, source="origin", destination="destination", keys=["file"]);
let binding_scope_options = select l.check as check, l.id as id, l.occurrence as occurrence, l.scope as scope, l.file as file, r.owner as owner from initial_bindings as l join parameter_name_matches as r on l.check = r.check and l.id = r.id and l.file = r.file;
let same_scope_values = select check, id, owner, file from binding_scope_options where scope = owner;
let inner_scope_values = select l.check as check, l.id as id, l.owner as owner, l.file as file from binding_scope_options as l join scope_paths as r on l.scope = r.origin and l.owner = r.destination and l.file = r.file;
let shadowed_parameter_owners = union(left=same_scope_values, right=inner_scope_values);
let visible_parameter_matches = antijoin(left=parameter_name_matches, right=shadowed_parameter_owners, left-on=["check", "id", "owner", "file"], right-on=["check", "id", "owner", "file"]);
let shadowed_outer_values = select check, id, file from visible_parameter_matches;
let surviving_values = antijoin(left=initial_bindings, right=shadowed_outer_values, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let parameter_value_rows0 = select check, id, occurrence, owner as scope, file from visible_parameter_matches;
let parameter_value_rows1 = extend(from=parameter_value_rows0, values={kind: "bind"});
let parameter_value_rows = select check, id, occurrence, scope, kind, file from parameter_value_rows1;
let bindings = union(left=surviving_values, right=parameter_value_rows);
let imported_paths0 = select l.check as check, l.id as id, r.target as path, l.occurrence as definition, l.file as file from bindings as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let bare_import_definitions0 = select id, file from "defines" where kind = "import" and refinement = "import";
let import_asnames = select parent as id, file from "semantic-child" where field = "asname";
let bare_import_definitions = antijoin(left=bare_import_definitions0, right=import_asnames, left-on=["id", "file"], right-on=["id", "file"]);
let deep_import_paths = select l.check as check, l.id as id, l.path as path, l.file as file from imported_paths0 as l join bare_import_definitions as r on l.definition = r.id and l.file = r.file where starts_with(l.path, "collections.") or starts_with(l.path, "typing.") or starts_with(l.path, "typing_extensions.") or starts_with(l.path, "builtins.");
let imported_paths1 = select check, id, path, file from imported_paths0;
let direct_import_paths = antijoin(left=imported_paths1, right=deep_import_paths, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let module_0a = select check, id, file from deep_import_paths where starts_with(path, "collections.");
let module_0b = extend(from=module_0a, values={path: "collections"});
let imported_module_paths_0 = union(left=direct_import_paths, right=module_0b);
let module_1a = select check, id, file from deep_import_paths where starts_with(path, "typing.");
let module_1b = extend(from=module_1a, values={path: "typing"});
let imported_module_paths_1 = union(left=imported_module_paths_0, right=module_1b);
let module_2a = select check, id, file from deep_import_paths where starts_with(path, "typing_extensions.");
let module_2b = extend(from=module_2a, values={path: "typing_extensions"});
let imported_module_paths_2 = union(left=imported_module_paths_1, right=module_2b);
let module_3a = select check, id, file from deep_import_paths where starts_with(path, "builtins.");
let module_3b = extend(from=module_3a, values={path: "builtins"});
let imported_module_paths_3 = union(left=imported_module_paths_2, right=module_3b);
let import_origins0 = extend(from=imported_module_paths_3, values={origin: "import"});
let import_origins = select check, id, path, origin, file from import_origins0;
let unbound_names = antijoin(left=fresh_names, right=bindings, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let builtin_catalog = select name, file from "implicit-symbol" as q where q.kind = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10);
let unbound_labels = select l.check as check, l.id as id, r.name as name, l.file as file from unbound_names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let builtin_labels = select l.check as check, l.id as id, l.name as name, l.file as file from unbound_labels as l join builtin_catalog as r on l.name = r.name and l.file = r.file;
let builtin_paths0 = select check, id, concat("builtins.", name) as path, file from builtin_labels where name in ["bool", "bytes", "complex", "float", "frozendict", "frozenset", "int", "object", "range", "str", "tuple"];
let builtin_paths1 = extend(from=builtin_paths0, values={origin: "builtin"});
let builtin_paths = select check, id, path, origin, file from builtin_paths1;
let fresh_paths_10 = union(left=import_origins, right=builtin_paths);
let resolved_paths0 = union(left=cached_paths, right=fresh_paths_10);
let attributes = select id, file from nodes where kind = "attribute";
let attribute_values = select l.id as id, r.child as value, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let attribute_labels0 = select l.id as id, r.child as label, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let attribute_labels = select l.id as id, r.name as name, l.file as file from attribute_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let attribute_bases_0 = select r.check as check, l.id as id, r.path as path, r.origin as origin, l.file as file from attribute_values as l join resolved_paths0 as r on l.value = r.id and l.file = r.file;
let attribute_parts_0 = select l.check as check, l.id as id, l.path as path, l.origin as origin, r.name as name, l.file as file from attribute_bases_0 as l join attribute_labels as r on l.id = r.id and l.file = r.file;
let attribute_0_paths = select check, id, concat(path, ".", name) as path, origin, file from attribute_parts_0 where concat(path, ".", name) in ["builtins.bool", "builtins.bytes", "builtins.complex", "builtins.float", "builtins.frozendict", "builtins.frozenset", "builtins.int", "builtins.object", "builtins.range", "builtins.str", "builtins.tuple", "collections.abc", "collections.abc.ByteString", "collections.abc.Collection", "collections.abc.Container", "collections.abc.Iterable", "collections.abc.Mapping", "collections.abc.Reversible", "collections.abc.Sequence", "collections.abc.Set", "collections.abc.Sized", "typing.AbstractSet", "typing.Annotated", "typing.ByteString", "typing.Callable", "typing.Collection", "typing.Container", "typing.FrozenSet", "typing.Iterable", "typing.Literal", "typing.LiteralString", "typing.Mapping", "typing.Never", "typing.NoReturn", "typing.Optional", "typing.Reversible", "typing.Sequence", "typing.Sized", "typing.Tuple", "typing.Union", "typing_extensions.Annotated"];
let attributes_0_40 = union(left=resolved_paths0, right=attribute_0_paths);
let attribute_bases_1 = select r.check as check, l.id as id, r.path as path, r.origin as origin, l.file as file from attribute_values as l join attributes_0_40 as r on l.value = r.id and l.file = r.file;
let attribute_parts_1 = select l.check as check, l.id as id, l.path as path, l.origin as origin, r.name as name, l.file as file from attribute_bases_1 as l join attribute_labels as r on l.id = r.id and l.file = r.file;
let attribute_1_paths = select check, id, concat(path, ".", name) as path, origin, file from attribute_parts_1 where concat(path, ".", name) in ["builtins.bool", "builtins.bytes", "builtins.complex", "builtins.float", "builtins.frozendict", "builtins.frozenset", "builtins.int", "builtins.object", "builtins.range", "builtins.str", "builtins.tuple", "collections.abc", "collections.abc.ByteString", "collections.abc.Collection", "collections.abc.Container", "collections.abc.Iterable", "collections.abc.Mapping", "collections.abc.Reversible", "collections.abc.Sequence", "collections.abc.Set", "collections.abc.Sized", "typing.AbstractSet", "typing.Annotated", "typing.ByteString", "typing.Callable", "typing.Collection", "typing.Container", "typing.FrozenSet", "typing.Iterable", "typing.Literal", "typing.LiteralString", "typing.Mapping", "typing.Never", "typing.NoReturn", "typing.Optional", "typing.Reversible", "typing.Sequence", "typing.Sized", "typing.Tuple", "typing.Union", "typing_extensions.Annotated"];
let attributes_1_40 = union(left=attributes_0_40, right=attribute_1_paths);
let resolved_paths = select check, id, path, origin, file from attributes_1_40;
let direct_non_generic_nodes = select check, id, file from resolved_paths where (path = "collections.abc.Sized" or path = "typing.LiteralString" or path = "typing.Sized") or origin = "builtin" and (path in ["builtins.bool", "builtins.bytes", "builtins.complex", "builtins.float", "builtins.int", "builtins.object", "builtins.range", "builtins.str"]);
let direct_generic_nodes = select check, id, file from resolved_paths where (path in ["builtins.frozenset", "builtins.tuple", "builtins.frozendict", "collections.abc.ByteString", "collections.abc.Collection", "collections.abc.Container", "collections.abc.Iterable", "collections.abc.Mapping", "collections.abc.Reversible", "collections.abc.Sequence", "collections.abc.Set", "typing.AbstractSet", "typing.ByteString", "typing.Callable", "typing.Collection", "typing.Container", "typing.FrozenSet", "typing.Iterable", "typing.Literal", "typing.Mapping", "typing.Never", "typing.NoReturn", "typing.Reversible", "typing.Sequence", "typing.Tuple"]);
let subscript_nodes = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as id, r.child as value, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let base_paths = select r.check as check, l.id as id, r.path as path, l.file as file from subscript_values as l join resolved_paths as r on l.value = r.id and l.file = r.file;
let generic_subscripts = select check, id, file from base_paths where (path in ["builtins.frozenset", "builtins.tuple", "builtins.frozendict", "collections.abc.ByteString", "collections.abc.Collection", "collections.abc.Container", "collections.abc.Iterable", "collections.abc.Mapping", "collections.abc.Reversible", "collections.abc.Sequence", "collections.abc.Set", "typing.AbstractSet", "typing.ByteString", "typing.Callable", "typing.Collection", "typing.Container", "typing.FrozenSet", "typing.Iterable", "typing.Literal", "typing.Mapping", "typing.Never", "typing.NoReturn", "typing.Reversible", "typing.Sequence", "typing.Tuple"]);
let optional_subscripts = select check, id, file from base_paths where path = "typing.Optional";
let union_subscripts = select check, id, file from base_paths where path = "typing.Union";
let annotated_subscripts = select check, id, file from base_paths where path = "typing.Annotated" or path = "typing_extensions.Annotated";
let slices = select l.id as id, r.child as slice, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuple_nodes = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.id as id, l.slice as slice, l.file as file from slices as l join tuple_nodes as r on l.slice = r.id and l.file = r.file;
let tuple_elements = select parent as tuple, child as element, ordinal, file from "semantic-child" where field = "elts";
let first_elements = group-min(from=tuple_elements, keys=["tuple", "file"], order="ordinal");
let optional_edges = select l.check as check, l.id as source, r.slice as destination, l.file as file from optional_subscripts as l join slices as r on l.id = r.id and l.file = r.file;
let valid_union_roots = select l.check as check, l.id as id, r.slice as slice, l.file as file from union_subscripts as l join tuple_slices as r on l.id = r.id and l.file = r.file;
let union_edges = select l.check as check, l.id as source, r.element as destination, l.file as file from valid_union_roots as l join tuple_elements as r on l.slice = r.tuple and l.file = r.file;
let annotated_tuples = select l.check as check, l.id as id, r.slice as slice, l.file as file from annotated_subscripts as l join tuple_slices as r on l.id = r.id and l.file = r.file;
let annotated_edges = select l.check as check, l.id as source, r.element as destination, l.file as file from annotated_tuples as l join first_elements as r on l.slice = r.tuple and l.file = r.file;
let op_children = select parent,child,file from "semantic-child" where field = "op";
let bar_tokens = select id,file from "semantic-syntax" where text = "|";
let raw_bit_or_nodes = select l.parent as node,l.file as file from op_children as l join bar_tokens as r on l.child = r.id and l.file = r.file;
let bit_or_nodes = select l.check as check, l.id as id, l.file as file from members as l join raw_bit_or_nodes as r on l.id = r.node and l.file = r.file;
let binary_sides = select parent, child, file from "semantic-child" where field = "left" or field = "right";
let binary_edges = select l.check as check, l.id as source, r.child as destination, l.file as file from bit_or_nodes as l join binary_sides as r on l.id = r.parent and l.file = r.file;
let edges0 = union(left=optional_edges, right=union_edges);
let edges1 = union(left=edges0, right=annotated_edges);
let edges = union(left=edges1, right=binary_edges);
let paths = closure(edges=edges, source="source", destination="destination", keys=["check", "file"]);
let nested_required = select l.check as check, r.destination as id, l.file as file from checks as l join paths as r on l.check = r.check and l.root = r.source and l.file = r.file;
let root_required = select check, root as id, file from checks;
let required = union(left=root_required, right=nested_required);
let none_nodes0 = select id, file from "literal-properties" where kind = "null";
let none_nodes = select l.check as check, l.id as id, l.file as file from members as l join none_nodes0 as r on l.id = r.id and l.file = r.file;
let union_roots = select check, id, file from valid_union_roots;
let annotated_roots = select check, source as id, file from annotated_edges;
let immutable0 = union(left=direct_non_generic_nodes, right=direct_generic_nodes);
let immutable1 = union(left=immutable0, right=generic_subscripts);
let immutable2 = union(left=immutable1, right=optional_subscripts);
let immutable3 = union(left=immutable2, right=union_roots);
let immutable4 = union(left=immutable3, right=annotated_roots);
let immutable5 = union(left=immutable4, right=bit_or_nodes);
let immutable = union(left=immutable5, right=none_nodes);
let bad_members = antijoin(left=required, right=immutable, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let check_keys = select check, file from checks;
let result = antijoin(left=check_keys, right=bad_members, left-on=["check", "file"], right-on=["check", "file"]);
return result;
