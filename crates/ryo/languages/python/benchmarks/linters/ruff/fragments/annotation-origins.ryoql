import lookup_symbol_events from "python/ruff/lookup-symbol-events";
import future_context from "python/ruff/future-annotation-context";
input expressions: relation<id: node, file: file>;
output relation<id: node, path: symbol, provenance: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let named_nodes = union(left=names, right=attributes);
let descendant_expressions = axis(from=named_nodes, relation="semantic-child", direction=ancestor, domain=expressions);
let nested_expressions = select id, file from descendant_expressions;
let own_expressions = select l.id as id, l.file as file from expressions as l join named_nodes as r on l.id = r.id and l.file = r.file;
let desired_expressions = union(left=own_expressions, right=nested_expressions);
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_labels0 = select l.id as id, r.child as label, l.file as file from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let attr_labels = select l.id as id, r.name as name, l.file as file from attr_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let attrs = select l.id as id, r.child as value, l.file as file from attributes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let one_roots = select l.id as id, l.value as root, l.file as file from attrs as l join names as r on l.value = r.id and l.file = r.file;
let two_roots = select l.id as id, r.root as root, l.value as middle, l.file as file from attrs as l join one_roots as r on l.value = r.id and l.file = r.file;
let own_roots = select id, id as root, file from names;
let roots0 = union(left=own_roots, right=one_roots);
let two_root_ids = select id, root, file from two_roots;
let roots = union(left=roots0, right=two_root_ids);
let desired_roots = select l.id as id, r.root as root, l.file as file from desired_expressions as l join roots as r on l.id = r.id and l.file = r.file;
let root_names = select root as id, file from desired_roots;
let annotation_roots = select child as id, file from "semantic-child" where field = "annotation" or field = "returns";
let annotation_descendants = axis(from=root_names, relation="semantic-child", direction=ancestor, domain=annotation_roots);
let nested_annotation_names = select id, file from annotation_descendants;
let direct_annotation_names = select l.id as id, l.file as file from root_names as l join annotation_roots as r on l.id = r.id and l.file = r.file;
let annotation_names = union(left=nested_annotation_names, right=direct_annotation_names);
let future_names = future_context(expressions=annotation_names);
let stub_names = select id, file from annotation_names where matches(file, "[.]pyi$");
let deferred0 = union(left=future_names, right=stub_names);
let string_hosts = select id, file from "literal-properties" where kind = "string";
let embedded_roots = axis(from=root_names, relation="semantic-child", direction=ancestor, domain=string_hosts);
let embedded_names = select id, file from embedded_roots;
let deferred_names = union(left=deferred0, right=embedded_names);
let ordinals = select ordinal as point, file from "binding-event";
let earlier_ordinals = select l.point as point, l.file as file from ordinals as l join ordinals as r on l.file = r.file where l.point < r.point;
let final_ordinals = antijoin(left=ordinals, right=earlier_ordinals, left-on=["point","file"], right-on=["point","file"]);
let lexical_reads = select reference as id, scope, file from "binding-read";
let deferred_scopes = select l.id as context, r.scope as initial_scope, l.file as file from deferred_names as l join lexical_reads as r on l.id = r.id and l.file = r.file;
let scopes = select context, initial_scope, file from deferred_scopes;
let context_points = select l.context as context, l.initial_scope as initial_scope, r.point as point, r.point as header_point, l.file as file from scopes as l join final_ordinals as r on l.file = r.file;
let context_rows = extend(from=context_points, values={stage: 0});
let contexts = select context, initial_scope, point, header_point, stage, file from context_rows;
let events = lookup_symbol_events(ordered_contexts=contexts, expressions=root_names);
let own_events = select context, expression, occurrence, kind, file from events where context = expression;
let imports0 = select l.expression as root, r.target as target, l.occurrence as definition, l.file as file from own_events as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let module_imports = select id, file from "defines" where kind = "import" and refinement = "import";
let asnames = select parent as id, file from "semantic-child" where field = "asname";
let unaliased_modules = antijoin(left=module_imports, right=asnames, left-on=["id","file"], right-on=["id","file"]);
let deep_imports = select l.root as root, l.target as target, l.definition as definition, l.file as file from imports0 as l join unaliased_modules as r on l.definition = r.id and l.file = r.file where matches(l.target, "[.]");
let simple_imports = antijoin(left=imports0, right=deep_imports, left-on=["root","definition","file"], right-on=["root","definition","file"]);
let direct_names = select l.id as id, r.target as path, l.file as file from desired_roots as l join simple_imports as r on l.root = r.root and l.file = r.file where l.id = l.root;
let direct_rows = extend(from=direct_names, values={provenance: "import"});
let direct = select id, path, provenance, file from direct_rows;
let first_components = replace(from=deep_imports, text="target", pattern="[.].*$", replacement="", output="module");
let simple_modules = select root, target as module, file from simple_imports;
let deep_modules = select root, module, file from first_components;
let module_roots = union(left=simple_modules, right=deep_modules);
let one_labels0 = select l.id as id, l.root as root, l.file as file, r.name as name from one_roots as l join attr_labels as r on l.id = r.id and l.file = r.file;
let one_labels = select l.id as id, l.name as name, r.module as module, l.file as file from one_labels0 as l join module_roots as r on l.root = r.root and l.file = r.file;
let two_labels0 = select l.id as id, l.middle as middle, l.root as root, l.file as file, r.name as name from two_roots as l join attr_labels as r on l.id = r.id and l.file = r.file;
let two_labels1 = select l.id as id, l.root as root, l.file as file, l.name as name from two_labels0 as l join attr_labels as r on l.middle = r.id and l.file = r.file where r.name = "abc";
let abc_roots = select root, file from module_roots where module = "collections";
let two_labels = select l.id as id, l.name as name, l.file as file from two_labels1 as l join abc_roots as r on l.root = r.root and l.file = r.file;
let module_0 = select id, name, file from one_labels where module = "typing";
let module_paths_0 = replace(from=module_0, text="name", pattern="^", replacement="typing.", output="path");
let module_origins_0 = extend(from=module_paths_0, values={provenance: "import"});
let origins_0 = select id, path, provenance, file from module_origins_0;
let module_1 = select id, name, file from one_labels where module = "typing_extensions";
let module_paths_1 = replace(from=module_1, text="name", pattern="^", replacement="typing_extensions.", output="path");
let module_origins_1 = extend(from=module_paths_1, values={provenance: "import"});
let origins_1 = select id, path, provenance, file from module_origins_1;
let module_2 = select id, name, file from one_labels where module = "builtins";
let module_paths_2 = replace(from=module_2, text="name", pattern="^", replacement="builtins.", output="path");
let module_origins_2 = extend(from=module_paths_2, values={provenance: "import"});
let origins_2 = select id, path, provenance, file from module_origins_2;
let module_3 = select id, name, file from one_labels where module = "collections";
let module_paths_3 = replace(from=module_3, text="name", pattern="^", replacement="collections.", output="path");
let module_origins_3 = extend(from=module_paths_3, values={provenance: "import"});
let origins_3 = select id, path, provenance, file from module_origins_3;
let module_4 = select id, name, file from one_labels where module = "collections.abc";
let module_rows_4 = union(left=module_4, right=two_labels);
let module_paths_4 = replace(from=module_rows_4, text="name", pattern="^", replacement="collections.abc.", output="path");
let module_origins_4 = extend(from=module_paths_4, values={provenance: "import"});
let origins_4 = select id, path, provenance, file from module_origins_4;
let module_5 = select id, name, file from one_labels where module = "io";
let module_paths_5 = replace(from=module_5, text="name", pattern="^", replacement="io.", output="path");
let module_origins_5 = extend(from=module_paths_5, values={provenance: "import"});
let origins_5 = select id, path, provenance, file from module_origins_5;
let module_6 = select id, name, file from one_labels where module = "os";
let module_paths_6 = replace(from=module_6, text="name", pattern="^", replacement="os.", output="path");
let module_origins_6 = extend(from=module_paths_6, values={provenance: "import"});
let origins_6 = select id, path, provenance, file from module_origins_6;
let module_7 = select id, name, file from one_labels where module = "pathlib";
let module_paths_7 = replace(from=module_7, text="name", pattern="^", replacement="pathlib.", output="path");
let module_origins_7 = extend(from=module_paths_7, values={provenance: "import"});
let origins_7 = select id, path, provenance, file from module_origins_7;
let module_8 = select id, name, file from one_labels where module = "_typeshed";
let module_paths_8 = replace(from=module_8, text="name", pattern="^", replacement="_typeshed.", output="path");
let module_origins_8 = extend(from=module_paths_8, values={provenance: "import"});
let origins_8 = select id, path, provenance, file from module_origins_8;
let contextual_root_names = select l.context as context, r.name as name, l.file as file from scopes as l join "identifier" as r on l.context = r.id and l.file = r.file;
let builtin_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let possible_builtins = select l.context as id, l.name as name, l.file as file from contextual_root_names as l join builtin_names as r on l.name = r.name and l.file = r.file;
let unbound_builtins = antijoin(left=possible_builtins, right=own_events, left-on=["id","file"], right-on=["expression","file"]);
let builtin_paths = replace(from=unbound_builtins, text="name", pattern="^", replacement="builtins.", output="path");
let builtin_rows = extend(from=builtin_paths, values={provenance: "builtin"});
let builtin_origins = select id, path, provenance, file from builtin_rows;
let merged_0 = union(left=direct, right=origins_0);
let merged_1 = union(left=merged_0, right=origins_1);
let merged_2 = union(left=merged_1, right=origins_2);
let merged_3 = union(left=merged_2, right=origins_3);
let merged_4 = union(left=merged_3, right=origins_4);
let merged_5 = union(left=merged_4, right=builtin_origins);
let extra_5 = union(left=merged_5, right=origins_5);
let extra_6 = union(left=extra_5, right=origins_6);
let extra_7 = union(left=extra_6, right=origins_7);
let extra_8 = union(left=extra_7, right=origins_8);
let resolved = select l.id as id, r.path as path, r.provenance as provenance, l.file as file from desired_roots as l join extra_8 as r on l.id = r.id and l.file = r.file;
let recomputed = select l.id as id, l.file as file from desired_roots as l join scopes as r on l.root = r.context and l.file = r.file;
let original_names = select l.id as id, r.path as path, r.provenance as provenance, l.file as file from desired_expressions as l join "qualified-name" as r on l.id = r.id and l.file = r.file;
let originals = antijoin(left=original_names, right=recomputed, left-on=["id","file"], right-on=["id","file"]);
let results = union(left=originals, right=resolved);
return results;
