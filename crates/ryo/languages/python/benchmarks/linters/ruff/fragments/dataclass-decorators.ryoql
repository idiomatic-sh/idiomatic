output relation<class: node, decorator: node, expression: node, path: symbol, file: file>;
let decorators = select occurrence as decorator, declaration as class, file from "decorates";
let roots = select l.decorator as decorator, l.class as class, l.file as file, r.child as expression from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct = select l.decorator as decorator, l.class as class, l.expression as expression, r.path as path, l.file as file from roots as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let functions = select parent, child, file from "semantic-child" where field = "func";
let callables = select l.decorator as decorator, l.class as class, l.expression as expression, r.child as callee, l.file as file from roots as l join functions as r on l.expression = r.parent and l.file = r.file;
let called = select l.decorator as decorator, l.class as class, l.expression as expression, r.path as path, l.file as file from callables as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let origins = union(left=direct, right=called);
let recognized = select * from origins where path = "dataclasses.dataclass" or path = "attr.define" or path = "attr.frozen" or path = "attr.mutable" or path = "attrs.define" or path = "attrs.frozen" or path = "attrs.mutable" or path = "attr.s" or path = "attr.attributes" or path = "attr.attrs";
let ordered = select l.decorator as decorator, l.class as class, l.expression as expression, l.path as path, l.file as file, r."start-byte" as start from recognized as l join "source-location" as r on l.decorator = r.id and l.file = r.file;
let later = select l.decorator as decorator, l.file as file from ordered as l join ordered as r on l.class = r.class and l.file = r.file where l.start > r.start;
let first = antijoin(left=ordered, right=later, left-on=["decorator","file"], right-on=["decorator","file"]);
let result = select class, decorator, expression, path, file from first;
return result;
