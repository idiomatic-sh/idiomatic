input expressions: relation<id: node, file: file>;
output relation<id: node, kind: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let bare = select l.id as id, l.id as root, l.file as file from expressions as l join names as r on l.id = r.id and l.file = r.file;
let attribute_values = select l.id as id, r.child as root, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let simple_attributes0 = select l.id as id, l.root as root, l.file as file from attribute_values as l join names as r on l.root = r.id and l.file = r.file;
let simple_attributes = select l.id as id, l.root as root, l.file as file from simple_attributes0 as l join expressions as r on l.id = r.id and l.file = r.file;
let roots = union(left=bare, right=simple_attributes);
let unique_reads = select reference, file from "binding-read" where state = "unique-declaration";
let unique_uses_raw = select reference, binding, scope, file from "binding-use" where certainty = "unique";
let lexical_declarations = select l.occurrence as reference, r.owner as scope, l.file as file from "resolves" as l join "defines" as r on l.definition = r.id and l.file = r.file;
let callable_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let lexical_locals = select l.reference as reference, l.scope as scope, l.file as file from lexical_declarations as l join callable_scopes as r on l.scope = r.id and l.file = r.file;
let conflicting_associations = select l.reference as reference, l.binding as binding, l.file as file from unique_uses_raw as l join lexical_locals as r on l.reference = r.reference and l.file = r.file where l.scope != r.scope;
let unique_uses0 = antijoin(left=unique_uses_raw, right=conflicting_associations, left-on=["reference","binding","file"], right-on=["reference","binding","file"]);
let unique_uses = select l.reference as reference, l.binding as binding, l.file as file from unique_uses0 as l join unique_reads as r on l.reference = r.reference and l.file = r.file;
let imported_roots = select l.id as id, l.root as root, r.binding as binding, l.file as file from roots as l join unique_uses as r on l.root = r.reference and l.file = r.file;
let imports = select l.id as id, l.root as root, l.binding as binding, r.target as target, l.file as file from imported_roots as l join "static-import" as r on l.binding = r.occurrence and l.file = r.file;
let bare_imports = select l.id as id, l.target as target, l.file as file from imports as l join bare as r on l.id = r.id and l.file = r.file;
let bare_union0 = select id, file from bare_imports where target = "typing.Union" or target = "typing_extensions.Union";
let bare_optional0 = select id, file from bare_imports where target = "typing.Optional" or target = "typing_extensions.Optional";
let bare_named_tuple0 = select id, file from bare_imports where target = "typing.NamedTuple" or target = "typing_extensions.NamedTuple";
let bare_type0 = select id, file from bare_imports where target = "builtins.type";
let bare_checking0 = select id, file from bare_imports where target = "typing.TYPE_CHECKING" or target = "typing_extensions.TYPE_CHECKING";
let bare_union = extend(from=bare_union0, values={kind: "union"});
let bare_optional = extend(from=bare_optional0, values={kind: "optional"});
let bare_named_tuple = extend(from=bare_named_tuple0, values={kind: "named-tuple"});
let bare_type = extend(from=bare_type0, values={kind: "builtin-type"});
let bare_checking = extend(from=bare_checking0, values={kind: "type-checking"});
let module_definitions = select id, file from "defines" where refinement = "import";
let asnames = select parent as id, file from "semantic-child" where field = "asname";
let unaliased_modules = antijoin(left=module_definitions, right=asnames, left-on=["id", "file"], right-on=["id", "file"]);
let deep_modules = select l.id as id, l.target as target, l.file as file from imports as l join unaliased_modules as r on l.binding = r.id and l.file = r.file;
let typing_modules0 = select id, file from imports where target = "typing" or target = "typing_extensions";
let typing_modules1 = select id, file from deep_modules where starts_with(target, "typing.") or starts_with(target, "typing_extensions.");
let typing_modules = union(left=typing_modules0, right=typing_modules1);
let builtin_modules0 = select id, file from imports where target = "builtins";
let builtin_modules1 = select id, file from deep_modules where starts_with(target, "builtins.");
let builtin_modules = union(left=builtin_modules0, right=builtin_modules1);
let labels0 = select l.id as id, r.child as label, l.file as file from simple_attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let labels = select l.id as id, r.name as name, l.file as file from labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let typing_labels = select l.id as id, l.name as name, l.file as file from labels as l join typing_modules as r on l.id = r.id and l.file = r.file;
let attr_union0 = select id, file from typing_labels where name = "Union";
let attr_optional0 = select id, file from typing_labels where name = "Optional";
let attr_named_tuple0 = select id, file from typing_labels where name = "NamedTuple";
let attr_checking0 = select id, file from typing_labels where name = "TYPE_CHECKING";
let attr_type0 = select l.id as id, l.file as file from labels as l join builtin_modules as r on l.id = r.id and l.file = r.file where l.name = "type";
let attr_union = extend(from=attr_union0, values={kind: "union"});
let attr_optional = extend(from=attr_optional0, values={kind: "optional"});
let attr_named_tuple = extend(from=attr_named_tuple0, values={kind: "named-tuple"});
let attr_checking = extend(from=attr_checking0, values={kind: "type-checking"});
let attr_type = extend(from=attr_type0, values={kind: "builtin-type"});
let builtin_reads0 = select reference as id, file from "binding-read" where state = "builtin" and name = "type";
let lexical_local_reads = select reference as id, file from lexical_locals;
let builtin_reads = antijoin(left=builtin_reads0, right=lexical_local_reads, left-on=["id","file"], right-on=["id","file"]);
let builtin_type0 = select l.id as id, l.file as file from bare as l join builtin_reads as r on l.root = r.id and l.file = r.file;
let builtin_type = extend(from=builtin_type0, values={kind: "builtin-type"});
let a = union(left=bare_union, right=bare_optional);
let b = union(left=bare_named_tuple, right=bare_type);
let c = union(left=bare_checking, right=attr_union);
let d = union(left=attr_optional, right=attr_named_tuple);
let e = union(left=attr_checking, right=attr_type);
let ab = union(left=a, right=b);
let cd = union(left=c, right=d);
let ef = union(left=e, right=builtin_type);
let abcd = union(left=ab, right=cd);
let result = union(left=abcd, right=ef);
let ordered = select id, kind, file from result;
return ordered;
