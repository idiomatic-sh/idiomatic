import comment_seeds from "python/ruff/directive-comment-seed";
output relation<id: node, file: file, line: number, scope: number, marker: span, suffix: symbol, suffix_span: span>;
let seeds = comment_seeds();
let comments = select id, file from seeds where matches(text, "(?i:noqa)");
let located = select l.id as id, l.file as file, r.span as comment_span, r."start-line" as line, r."start-byte" as comment_start from comments as l join "source-location" as r on l.id = r.id and l.file = r.file;
let directive_files = project(from=located, columns=["file"]);
let roots = select l.id as id, l.file as file, l.span as span from "syntax-tree" as l join directive_files as r on l.file = r.file where l.kind = "module";
let line_hashes = source-matches(from=roots, span="span", pattern="(?mR)^\x{FEFF}?[ \t\f]*(?P<hash>#)", output="line_match", capture="hash", capture-output="hash_span");
let hash_bounds = span-bounds(from=line_hashes, span="hash_span", start-output="comment_start", end-output="hash_end");
let own_line_starts = select file, comment_start from hash_bounds;
let inline_found = source-matches(from=located, span="comment_span", pattern="#[^\S\r\n]*(?i:noqa)(?P<suffix>.*)$", output="marker", capture="suffix", capture-output="suffix_span", capture-text-output="suffix");
let inline_heads = extend(from=inline_found, values={scope: 0});
let file_found = source-matches(from=located, span="comment_span", pattern="#[^\S\r\n]*(?:ruff|flake8)[^\S\r\n]*:[^\S\r\n]*(?i:noqa)(?P<suffix>.*)$", output="marker", capture="suffix", capture-output="suffix_span", capture-text-output="suffix");
let standalone_file = select l.id as id, l.file as file, l.line as line, l.marker as marker, l.suffix as suffix, l.suffix_span as suffix_span from file_found as l join own_line_starts as r on l.file = r.file and l.comment_start = r.comment_start;
let file_heads = extend(from=standalone_file, values={scope: 1});
let inline_shaped = select id, file, line, scope, marker, suffix, suffix_span from inline_heads;
let file_shaped = select id, file, line, scope, marker, suffix, suffix_span from file_heads;
let heads = union(left=inline_shaped, right=file_shaped);
return heads;
