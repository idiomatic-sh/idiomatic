import noqa_codes from "python/ruff/noqa-codes";
import noqa_blankets from "python/ruff/noqa-blankets";
import noqa_ranges from "python/ruff/noqa-ranges";
input candidates: relation<id: node, file: file, span: span, line: number>;
input locations: relation<id: node, file: file, span: span, line: number>;
param codes: string;
output relation<id: node, file: file, span: span, directive: node, scope: number>;
let directive_codes = noqa_codes();
let blankets = noqa_blankets();
let coded = select id as directive, file, line, scope from directive_codes where matches(code, $codes);
let blanket = select id as directive, file, line, scope from blankets;
let suppressions = union(left=coded, right=blanket);
let line_suppressions = select directive, file, line from suppressions where scope = 0;
let file_suppressions = select directive, file from suppressions where scope = 1;
let file_matches = select l.id as id, l.file as file, l.span as span, r.directive as directive from candidates as l join file_suppressions as r on l.file = r.file;
let file_edges = extend(from=file_matches, values={scope: 1});
let line_matches = select l.id as id, l.file as file, l.span as span, r.directive as directive from locations as l join line_suppressions as r on l.file = r.file and l.line = r.line;
let line_without_file = antijoin(left=line_matches, right=file_matches, left-on=[id, span], right-on=[id, span]);
let line_edges = extend(from=line_without_file, values={scope: 0});
let ranges = noqa_ranges();
let rule_ranges = select directive, file, begin, last, bound, excluded from ranges where matches(code, $codes);
let bounds = span-bounds(from=candidates, span="span", start-output="begin", end-output="finish");
let range_hidden = select l.id as id, l.file as file, l.span as span, r.directive as directive from bounds as l join rule_ranges as r on l.file = r.file where l.begin >= r.begin and l.begin <= r.last and l.finish <= r.bound and l.begin != r.excluded;
let range_edges = extend(from=range_hidden, values={scope: 2});
let noqa_edges = union(left=file_edges, right=line_edges);
let matches = union(left=noqa_edges, right=range_edges);
return matches;
