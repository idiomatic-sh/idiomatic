import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppress_directives from "python/ruff/suppress-directives";
input candidates: relation<id: node, file: file, span: span, line: number>;
param inline-pattern: string;
param range-pattern: string;
output relation<id: node, file: file, span: span>;
let candidate_locations = select id, file, span, line from candidates;
let mappings = noqa_line_map();
let located = noqa_locations(candidates=candidate_locations, mappings=mappings);
let empty_additional = select id, file, line from candidate_locations where id != id;
let violations = suppress_directives(candidates=candidate_locations, locations=located, additional_locations=empty_additional, inline-pattern=$inline-pattern, range-pattern=$range-pattern);
return violations;
