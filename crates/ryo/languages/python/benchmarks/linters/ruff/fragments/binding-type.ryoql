import assigned_values from "python/ruff/assigned-values";
input references: relation<reference: node, file: file>;
param builtin: string;
param typing: string;
param atom: string;
output relation<reference: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let events = select occurrence as binding, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "annotation";
let prior_bindings = select l.binding as binding, l.file as file from events as l join events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let unique_bindings = antijoin(left=events, right=prior_bindings, left-on=["binding","file"], right-on=["binding","file"]);
let uses = select l.reference as reference, l.file as file, r.binding as binding from references as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let single_uses = select l.reference as reference, l.file as file, l.binding as binding from uses as l join unique_bindings as r on l.binding = r.binding and l.file = r.file;
let values = select parent, child, file from "semantic-child" where field = "value";
let target_fields = select parent, child, file from "semantic-child" where field = "target" or field = "targets";
let initializers = assigned_values();
let initializer_bindings = select l.value as value, l.file as file, r.binding as binding from initializers as l join events as r on l.binding = r.binding and l.file = r.file;
let atoms = select id, file from "expression-type" where resolution = "atom" and type = $atom;
let atom_bindings = select l.binding as binding, l.file as file from initializer_bindings as l join atoms as r on l.value = r.id and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.id as call, l.file as file, r.child as function from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let builtin_calls = select l.call as id, l.file as file from call_functions as l join "qualified-name" as r on l.function = r.id and l.file = r.file where r.path = $builtin;
let constructor_bindings = select l.binding as binding, l.file as file from initializer_bindings as l join builtin_calls as r on l.value = r.id and l.file = r.file;
let initialized = union(left=atom_bindings, right=constructor_bindings);
let annotations = select parent as owner, child as annotation, file from "semantic-child" where field = "annotation" or field = "returns";
let subscripts = select id, file from nodes where kind = "subscript";
let unsubscripted_annotations = antijoin(left=annotations, right=subscripts, left-on=["annotation","file"], right-on=["id","file"]);
let subscript_annotations = select l.owner as owner, l.file as file, l.annotation as annotation from annotations as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let annotation_bases = select l.owner as owner, l.file as file, r.child as annotation from subscript_annotations as l join values as r on l.annotation = r.parent and l.file = r.file;
let mapped_annotations = union(left=unsubscripted_annotations, right=annotation_bases);
let typed_annotations = select l.owner as owner, l.file as file from mapped_annotations as l join "qualified-name" as r on l.annotation = r.id and l.file = r.file where r.path = $builtin or r.path = concat("typing.", $typing) or r.path = concat("typing_extensions.", $typing) or r.path = concat("_typeshed.", $typing);
let annotated_targets = select l.owner as owner, l.file as file, r.child as target from typed_annotations as l join target_fields as r on l.owner = r.parent and l.file = r.file;
let annotated_bindings = select l.target as binding, l.file as file from annotated_targets as l join events as r on l.target = r.binding and l.file = r.file;
let parameter_bindings = select l.owner as binding, l.file as file from typed_annotations as l join events as r on l.owner = r.binding and l.file = r.file;
let typed_declarations = union(left=annotated_bindings, right=parameter_bindings);
let function_names = select parent, child, file from "semantic-child" where field = "name";
let typed_functions = select l.owner as owner, l.file as file, r.child as name from typed_annotations as l join function_names as r on l.owner = r.parent and l.file = r.file;
let typed_function_bindings = select l.name as binding, l.file as file from typed_functions as l join events as r on l.name = r.binding and l.file = r.file;
let annotated_bindings_all = union(left=typed_declarations, right=typed_function_bindings);
let typed_bindings = union(left=initialized, right=annotated_bindings_all);
let result = select l.reference as reference, l.file as file from single_uses as l join typed_bindings as r on l.binding = r.binding and l.file = r.file;
return result;
