import active from "python/ruff/directive-active-file";
import noqa_codes from "python/ruff/noqa-codes";
import noqa_blankets from "python/ruff/noqa-blankets";
import noqa_ranges from "python/ruff/noqa-ranges";
import noqa_line_map from "python/ruff/noqa-line-map";
import code_aliases from "python/ruff/suppression-code-aliases";
import canonical_codes from "python/ruff/suppression-catalog";
output relation<directive: node,file: file,scope: number,code: symbol,line: number,through: number,first: number,final: number,begin: number,last: number,bound: number,excluded: number>;
let tokens = noqa_codes();
let coded = select id as directive,file,line,scope,code from tokens;
let aliases = code_aliases();
let renamed = select l.directive as directive,l.file as file,l.line as line,l.scope as scope,r.canonical as code from coded as l join aliases as r on l.code=r.code;
let plain = antijoin(left=coded,right=aliases,left-on=[code],right-on=[code]);
let canonical = union(left=plain,right=renamed);
let blankets = noqa_blankets();
let blanket_heads = select id as directive,file,line,scope from blankets;
let blanket = extend(from=blanket_heads,values={code:""});
let heads = union(left=canonical,right=blanket);
let file_heads = select directive,file,scope,code from heads where scope=1;
let file_blankets = select file from file_heads where code="";
let file_codes = select file,code from file_heads where code!="";
let inline = select directive,file,line,scope,code from heads where scope=0;
let enabled = antijoin(left=inline,right=file_blankets,left-on=[file],right-on=[file]);
let mixed = select l.directive as directive,l.file as file,l.line as line,l.scope as scope,l.code as code from enabled as l join file_codes as r on l.file=r.file where l.code="";
let ordinary = antijoin(left=enabled,right=mixed,left-on=[directive,file],right-on=[directive,file]);
let catalog = canonical_codes();
let mixed_keyed = extend(from=mixed,values={pair:0});
let catalog_keyed = extend(from=catalog,values={pair:0});
let mixed_codes = select l.directive as directive,l.file as file,l.line as line,l.scope as scope,r.canonical as code from mixed_keyed as l join catalog_keyed as r on l.pair=r.pair;
let alternatives = union(left=ordinary,right=mixed_codes);
let lines = antijoin(left=alternatives,right=file_codes,left-on=[file,code],right-on=[file,code]);
let mappings = noqa_line_map();
let nearest = as-of(left=lines,right=mappings,left-on=[file],right-on=[file],left-order="line",right-order="line",bound=at-or-before,output={directive:[left,directive],file:[left,file],scope:[left,scope],code:[left,code],line:[left,line],first:[right,line],final:[right,endline]});
let inside = select directive,file,scope,code,line,first,final from nearest where line<=final;
let outside = antijoin(left=lines,right=inside,left-on=[file,directive,code],right-on=[file,directive,code]);
let direct = select directive,file,scope,code,line,line as through,line as first,line as final from outside;
let endpoints = select directive,file,scope,code,line,line as through,first,final from inside where line=final;
let interior = select directive,file,scope,code,line,line as through from inside where line<final;
let physical_only = extend(from=interior,values={first:1,final:0});
let mapped = union(left=direct,right=endpoints);
let all_lines = union(left=mapped,right=physical_only);
let line_windows = extend(from=all_lines,values={begin:0,last:4294967295,bound:4294967295,excluded:4294967295});
let file_windows = extend(from=file_heads,values={line:0,through:4294967295,first:0,final:4294967295,begin:0,last:4294967295,bound:4294967295,excluded:4294967295});
let ranges = noqa_ranges();
let renamed_ranges = select l.directive as directive,l.file as file,r.canonical as code,l.begin as begin,l.last as last,l.bound as bound,l.excluded as excluded from ranges as l join aliases as r on l.code=r.code;
let plain_ranges = antijoin(left=ranges,right=aliases,left-on=[code],right-on=[code]);
let canonical_ranges = union(left=plain_ranges,right=renamed_ranges);
let range_windows = extend(from=canonical_ranges,values={scope:2,line:0,through:4294967295,first:0,final:4294967295});
let line_rows = select directive,file,scope,code,line,through,first,final,begin,last,bound,excluded from line_windows;
let file_rows = select directive,file,scope,code,line,through,first,final,begin,last,bound,excluded from file_windows;
let range_rows = select directive,file,scope,code,line,through,first,final,begin,last,bound,excluded from range_windows;
let simple = union(left=line_rows,right=file_rows);
let indexed = union(left=simple,right=range_rows);
let needed = active();
let windows = select r.directive as directive,r.file as file,r.scope as scope,r.code as code,r.line as line,r.through as through,r.first as first,r.final as final,r.begin as begin,r.last as last,r.bound as bound,r.excluded as excluded from needed as l join indexed as r on l.file=r.file;
return windows;
