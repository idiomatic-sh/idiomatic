input bindings: relation<id: node, file: file>;
output relation<binding: node, owner: node, arm: symbol, arm_id: node>;
let nodes = select id, kind from "semantic-syntax";
let branch_kinds = select id from nodes where kind in ["if", "try", "try-star", "with", "async-with", "match-case", "if-exp"];
let tree_parents = select parent as id from "semantic-child";
let event_starts = select id from bindings;
let event_walk = axis(from=event_starts, relation="semantic-child", direction=ancestor, domain=tree_parents);
let event_branch_ancestors = select id as binding, related as owner from event_walk;
let branch_owners = select l.binding as binding, l.owner as owner from event_branch_ancestors as l join branch_kinds as r on l.owner = r.id;
let branch_arm_candidates = select l.binding as binding, l.owner as owner, r.child as arm_node, r.field as field from branch_owners as l join "semantic-child" as r on l.owner = r.parent;
let arm_starts = select binding as id, owner, field, arm_node from branch_arm_candidates;
let arm_walk = axis(from=arm_starts, relation="semantic-child", direction=ancestor, domain=tree_parents);
let walked_members = select id as binding, owner, field, arm_node from arm_walk where related = arm_node;
let definition_statements = select id from nodes where kind in ["function-def", "async-function-def", "class-def"];
let arm_statements = select l.id as id, l.owner as owner, l.field as field, l.arm_node as arm_node from arm_starts as l join definition_statements as r on l.arm_node = r.id;
let statement_members = select id as binding, owner, field, arm_node from arm_statements where id = arm_node;
let branch_members = union(left=walked_members, right=statement_members);
let try_body = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "body";
let try_orelse = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "orelse";
let try_main = union(left=try_body,right=try_orelse);
let ordinary_branch_fields0 = select l.binding as binding, l.owner as owner, l.field as arm, l.owner as arm_id from branch_members as l join nodes as r on l.owner = r.id where (r.kind != "try" and r.kind != "try-star" and r.kind != "if" and r.kind != "with" and r.kind != "async-with") or (r.kind = "with" or r.kind = "async-with") and l.field = "body" or r.kind = "if" and l.field != "orelse" or (r.kind = "try" or r.kind = "try-star") and l.field = "finalbody";
let conditional_clause_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "if" and l.field = "orelse";
let ordinary_branch_fields = union(left=ordinary_branch_fields0, right=conditional_clause_fields);
let clause_branch_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "try" and l.field = "handlers" or r.kind = "try-star" and l.field = "handlers";
let try_main_owners = select binding, owner, owner as arm_id from try_main;
let try_main_arms = extend(from=try_main_owners, values={arm: "try-main"});
let branch_paths_ordinary = union(left=ordinary_branch_fields,right=clause_branch_fields);
let branch_paths = union(left=branch_paths_ordinary,right=try_main_arms);
return branch_paths;
