import postponed_members from "python/ruff/postponed-expression-members";
import deferred_origins from "python/ruff/final-annotation-origins";
input expressions: relation<id: node, file: file>;
output relation<id: node, path: symbol, provenance: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let named_nodes = union(left=names, right=attributes);
let named_kinds = select id, file from "semantic-syntax" where kind = "name" or kind = "attribute";
let descendant_expressions = axis(from=expressions, relation="semantic-child", direction=descendant, domain=named_kinds);
let nested_expressions = select related as id, file from descendant_expressions;
let own_expressions = select l.id as id, l.file as file from expressions as l join named_nodes as r on l.id = r.id and l.file = r.file;
let desired_expressions = union(left=own_expressions, right=nested_expressions);
let deferred_regions = postponed_members(expressions=desired_expressions);
let region_names = select l.id as id, l.file as file from desired_expressions as l join deferred_regions as r on l.id = r.id and l.file = r.file;
let stub_names = select id, file from desired_expressions where matches(file, "[.]pyi$");
let deferred_inputs = union(left=region_names, right=stub_names);
let plain_inputs = antijoin(left=desired_expressions, right=deferred_inputs, left-on=["id","file"], right-on=["id","file"]);
let plain = select l.id as id, r.path as path, r.provenance as provenance, l.file as file from plain_inputs as l join "qualified-name" as r on l.id = r.id and l.file = r.file;
let deferred = deferred_origins(expressions=deferred_inputs);
let results = union(left=plain, right=deferred);
return results;
