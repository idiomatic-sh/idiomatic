input events: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
input probes: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
output relation<scope: node, phase: node, name: symbol, file: file, point: number, event_ordinal: number>;
let earlier = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.ordinal as point, r.ordinal as event_ordinal from probes as l join events as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let passed = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point, l.event_ordinal as event_ordinal from earlier as l join earlier as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.point = r.point where l.event_ordinal < r.event_ordinal;
let results = antijoin(left=earlier, right=passed, left-on=[scope,phase,name,file,point,event_ordinal], right-on=[scope,phase,name,file,point,event_ordinal]);
return results;
