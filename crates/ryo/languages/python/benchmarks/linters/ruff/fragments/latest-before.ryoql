input events: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
input probes: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
output relation<scope: node, phase: node, name: symbol, file: file, point: number, event_ordinal: number>;
let results = as-of(left=probes, right=events, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", bound=before, output={scope:[left,scope], phase:[left,phase], name:[left,name], file:[left,file], point:[left,ordinal], event_ordinal:[right,ordinal]});
return results;
