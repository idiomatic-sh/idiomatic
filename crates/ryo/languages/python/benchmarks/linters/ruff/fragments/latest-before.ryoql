import resolve_pointers from "python/ruff/resolve-pointers";
input events: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
input probes: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
output relation<scope: node, phase: node, name: symbol, file: file, point: number, event_ordinal: number>;
let event_stream = extend(from=events, values={tag: "event"});
let probe_stream = extend(from=probes, values={tag: "probe"});
let event_probe_stream = union(left=event_stream, right=probe_stream);
let stream_pairs = ordered-match(left=event_probe_stream, right=event_probe_stream, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", output={scope:[left,scope], phase:[left,phase], name:[left,name], file:[left,file], src:[left,ordinal], dst:[right,ordinal], dtag:[right,tag]});
let probe_pointers = select scope, phase, name, file, dst as node, src as target from stream_pairs where dtag = "probe";
let event_pointers = select scope, phase, name, file, ordinal as node, ordinal as target from events;
let jump0 = union(left=probe_pointers, right=event_pointers);
let jump20 = resolve_pointers(pointers=jump0);
let probe_ends = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as point, l.target as event_ordinal from jump20 as l join probes as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.node = r.ordinal;
let results = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point, l.event_ordinal as event_ordinal from probe_ends as l join events as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.event_ordinal = r.ordinal;
return results;
