input events: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
input probes: relation<scope: node, phase: node, name: symbol, file: file, ordinal: number>;
output relation<scope: node, phase: node, name: symbol, file: file, point: number, event_ordinal: number>;
let event_stream = extend(from=events, values={tag: "event"});
let probe_stream = extend(from=probes, values={tag: "probe"});
let event_probe_stream = union(left=event_stream, right=probe_stream);
let stream_pairs = ordered-match(left=event_probe_stream, right=event_probe_stream, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", output={scope:[left,scope], phase:[left,phase], name:[left,name], file:[left,file], src:[left,ordinal], dst:[right,ordinal], dtag:[right,tag]});
let probe_pointers = select scope, phase, name, file, dst as node, src as target from stream_pairs where dtag = "probe";
let event_pointers = select scope, phase, name, file, ordinal as node, ordinal as target from events;
let jump0 = union(left=probe_pointers, right=event_pointers);
let jump1 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump0 as l join jump0 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump2 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump1 as l join jump1 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump3 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump2 as l join jump2 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump4 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump3 as l join jump3 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump5 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump4 as l join jump4 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump6 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump5 as l join jump5 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump7 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump6 as l join jump6 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump8 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump7 as l join jump7 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump9 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump8 as l join jump8 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump10 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump9 as l join jump9 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump11 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump10 as l join jump10 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump12 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump11 as l join jump11 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump13 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump12 as l join jump12 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let jump14 = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as node, r.target as target from jump13 as l join jump13 as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.target = r.node;
let probe_ends = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.node as point, l.target as event_ordinal from jump14 as l join probes as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.node = r.ordinal;
let resolved_ends = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point, l.event_ordinal as event_ordinal from probe_ends as l join events as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.event_ordinal = r.ordinal;
let overflow_ends = antijoin(left=probe_ends, right=resolved_ends, left-on=["scope", "phase", "name", "file", "point"], right-on=["scope", "phase", "name", "file", "point"]);
let fallback_candidates = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point, r.ordinal as event_ordinal from overflow_ends as l join events as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file where r.ordinal < l.point;
let fallback_older = ordered-match(left=fallback_candidates, right=fallback_candidates, left-on=[scope,phase,name,file,point], right-on=[scope,phase,name,file,point], left-order="event_ordinal", right-order="event_ordinal", output={scope:[left,scope], phase:[left,phase], name:[left,name], file:[left,file], point:[left,point], event_ordinal:[left,event_ordinal]});
let fallback_latest = antijoin(left=fallback_candidates, right=fallback_older, left-on=["scope", "phase", "name", "file", "point", "event_ordinal"], right-on=["scope", "phase", "name", "file", "point", "event_ordinal"]);
let results = union(left=resolved_ends, right=fallback_latest);
return results;
