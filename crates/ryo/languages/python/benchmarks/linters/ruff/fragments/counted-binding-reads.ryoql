import nearest_read_lookup from "python/ruff/nearest-read-lookup";
import type_root_binds from "python/ruff/type-root-binds";
import exceptions from "python/ruff/binding-read-exceptions";
import stepped from "python/ruff/exceptional-read-uses";
input deferred: relation<reference: node, file: file>;
input bindings: relation<binding: node, file: file>;
output relation<reference: node, binding: node, file: file>;
let read_lookup = nearest_read_lookup();
let fast = select reference, event as binding, file from read_lookup where kind = "bind" and namespace = "own";
let headers = type_root_binds();
let own = antijoin(left=fast, right=headers, left-on=[binding,file], right-on=[id,file]);
let direct = antijoin(left=own, right=deferred, left-on=[reference,file], right-on=[reference,file]);
let suspect = exceptions();
let eager_suspect = antijoin(left=suspect, right=deferred, left-on=[reference,file], right-on=[reference,file]);
let adjusted = stepped(reads=eager_suspect);
let adjusted_binds = select reference, binding, file from adjusted where kind = "bind";
let eligible_direct = select r.reference as reference, r.binding as binding, r.file as file from bindings as l join direct as r on l.binding = r.binding and l.file = r.file;
let answers = union(left=eligible_direct, right=adjusted_binds);
return answers;
