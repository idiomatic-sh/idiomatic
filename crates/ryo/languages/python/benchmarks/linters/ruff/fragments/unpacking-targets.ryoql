output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let containers = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "set";
let assign_nodes = select id, file from nodes where kind = "assign";
let assign_targets = select parent, child, file from "semantic-child" where field = "targets";
let assigned_targets = select l.id as statement, r.child as target, l.file as file from assign_nodes as l join assign_targets as r on l.id = r.parent and l.file = r.file;
let container_targets = select l.statement as statement, l.target as target, l.file as file from assigned_targets as l join containers as r on l.target = r.id and l.file = r.file;
let scalar_targets = antijoin(left=assigned_targets, right=container_targets, left-on=["statement", "target", "file"], right-on=["statement", "target", "file"]);
let mixed_statements = select statement, file from scalar_targets;
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let container_values = select l.parent as statement, l.file as file from value_fields as l join containers as r on l.child = r.id and l.file = r.file;
let dynamic_assigns = antijoin(left=container_targets, right=container_values, left-on=["statement", "file"], right-on=["statement", "file"]);
let mixed_assigns = select l.statement as statement, l.target as target, l.file as file from container_targets as l join mixed_statements as r on l.statement = r.statement and l.file = r.file;
let unpacking = union(left=dynamic_assigns, right=mixed_assigns);
let assigned_roots = select target as id, file from unpacking;
let tuple_nodes = select id, file from nodes where kind = "tuple";
let optional_vars = select child, file from "semantic-child" where field = "optional-vars";
let with_tuples = select l.child as id, l.file as file from optional_vars as l join tuple_nodes as r on l.child = r.id and l.file = r.file;
let roots = union(left=assigned_roots, right=with_tuples);
return roots;
