input expressions: relation<id: node, file: file>;
input targets: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let lambdas = select id, file from nodes where kind = "lambda";
let lambda_bodies = select r.child as id, l.file as file from lambdas as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let direct_seed_regions = select l.id as id, l.file as file, r.id as region from expressions as l join lambda_bodies as r on l.id = r.id and l.file = r.file;
let non_body_seeds = antijoin(left=expressions, right=lambda_bodies, left-on=["id","file"], right-on=["id","file"]);
let seed_region_axes = axis(from=non_body_seeds, relation="semantic-child", direction=nearest-ancestor, domain=lambda_bodies);
let inherited_seed_regions = select id, file, related as region from seed_region_axes;
let seed_regions = union(left=direct_seed_regions, right=inherited_seed_regions);
let direct_effect_regions = select l.id as id, l.file as file, r.id as region from targets as l join lambda_bodies as r on l.id = r.id and l.file = r.file;
let non_body_effects = antijoin(left=targets, right=lambda_bodies, left-on=["id","file"], right-on=["id","file"]);
let effect_region_axes = axis(from=non_body_effects, relation="semantic-child", direction=nearest-ancestor, domain=lambda_bodies);
let inherited_effect_regions = select id, file, related as region from effect_region_axes;
let effect_regions = union(left=direct_effect_regions, right=inherited_effect_regions);
let descendants = axis(from=expressions, relation="semantic-child", direction=descendant, domain=targets);
let regional_pairs = select l.id as id, l.file as file, r.region as region from descendants as l join effect_regions as r on l.related = r.id and l.file = r.file;
let regional_effects = select l.id as id, l.file as file from regional_pairs as l join seed_regions as r on l.id = r.id and l.file = r.file and l.region = r.region;
let outer_effects = antijoin(left=targets, right=effect_regions, left-on=["id","file"], right-on=["id","file"]);
let outer_seeds = antijoin(left=expressions, right=seed_regions, left-on=["id","file"], right-on=["id","file"]);
let outer_pairs = select l.id as id, l.file as file from descendants as l join outer_effects as r on l.related = r.id and l.file = r.file;
let outer_nested_effects = select l.id as id, l.file as file from outer_pairs as l join outer_seeds as r on l.id = r.id and l.file = r.file;
let nested_effects = union(left=regional_effects, right=outer_nested_effects);
let root_effects = select l.id as id, l.file as file from expressions as l join targets as r on l.id = r.id and l.file = r.file;
let reached = union(left=nested_effects, right=root_effects);
return reached;
