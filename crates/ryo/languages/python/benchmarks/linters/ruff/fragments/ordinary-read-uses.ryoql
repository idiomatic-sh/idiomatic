import lookup_events from "python/ruff/lookup-read-events";
input reads: relation<reference: node, file: file>;
output relation<reference: node, binding: node, kind: symbol, file: file>;
let reference_events = select occurrence as reference, scope as raw_scope, ordinal as point, kind, file from "binding-event" where kind = "read" or kind = "delete";
let read_events = select reference, raw_scope as initial_scope, point, file from reference_events where kind = "read";
let delete_events = select reference as id, point, file from reference_events where kind = "delete";
let owner_scopes = select child as id, file from "scope";
let delete_owners = axis(from=delete_events, relation="semantic-child", direction=nearest-ancestor, domain=owner_scopes);
let delete_scopes = select l.id as reference, r.related as initial_scope, l.point as point, l.file as file from delete_events as l join delete_owners as r on l.id = r.id and l.file = r.file;
let read_positions = select l.reference as context, r.initial_scope as initial_scope, r.point as point, l.file as file from reads as l join read_events as r on l.reference = r.reference and l.file = r.file;
let lazy_roots = select child as id, file from "semantic-child" where field = "bound" or field = "default-value";
let lazy_inputs = select reference as id, file from reads;
let lazy_axis = axis(from=lazy_inputs, relation="semantic-child", direction=ancestor, domain=lazy_roots);
let lazy_nested = select id as context, file from lazy_axis;
let lazy_self = select l.id as context, l.file as file from lazy_inputs as l join lazy_roots as r on l.id = r.id and l.file = r.file;
let lazy_reads = union(left=lazy_nested, right=lazy_self);
let eager_positions = antijoin(left=read_positions, right=lazy_reads, left-on=["context", "file"], right-on=["context", "file"]);
let lazy_positions0 = select l.context as context, l.initial_scope as initial_scope, l.file as file from read_positions as l join lazy_reads as r on l.context = r.context and l.file = r.file;
let lazy_positions1 = extend(from=lazy_positions0, values={point: 2147483647});
let lazy_positions = select context, initial_scope, point, file from lazy_positions1;
let read_contexts = union(left=eager_positions, right=lazy_positions);
let delete_contexts = select l.reference as context, r.initial_scope as initial_scope, r.point as point, l.file as file from reads as l join delete_scopes as r on l.reference = r.reference and l.file = r.file;
let read_stages = extend(from=read_contexts, values={stage: 2});
let delete_stages = extend(from=delete_contexts, values={stage: 3});
let staged_contexts = union(left=read_stages, right=delete_stages);
let contexts = select context, initial_scope, point, point as header_point, stage, file from staged_contexts;
let expressions = select reference as id, file from reads;
let lookups = lookup_events(ordered_contexts=contexts, expressions=expressions);
let own_lookups = select context as reference, occurrence, kind, file from lookups where context = expression;
let resolved_lookups = select reference, occurrence as binding, kind, file from own_lookups where kind = "bind" or kind = "global" or kind = "nonlocal";
let resolved_references = select reference as context, file from resolved_lookups;
let lazy_unresolved0 = antijoin(left=lazy_reads, right=resolved_references, left-on=["context", "file"], right-on=["context", "file"]);
let lazy_unresolved1 = select context as reference, context as binding, file from lazy_unresolved0;
let lazy_unresolved2 = extend(from=lazy_unresolved1, values={kind: "unresolved"});
let lazy_unresolved = select reference, binding, kind, file from lazy_unresolved2;
let lookup_rows = union(left=resolved_lookups, right=lazy_unresolved);
return lookup_rows;
