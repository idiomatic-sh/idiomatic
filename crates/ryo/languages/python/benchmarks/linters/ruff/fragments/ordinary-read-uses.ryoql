import decisions_of from "python/ruff/namespace-decisions";
import points_of from "python/ruff/evaluation-points";
input reads: relation<reference: node, file: file>;
output relation<reference: node, binding: node, kind: symbol, file: file>;
let points = points_of(reads=reads);
let decisions = decisions_of(reads=points);
let answers = select reference, event, kind, depth, file from decisions where via != "declaration";
let farther_answers = select l.reference as reference, l.depth as depth, l.file as file from answers as l join answers as r on l.reference = r.reference and l.file = r.file where r.depth < l.depth;
let nearest_answers = antijoin(left=answers, right=farther_answers, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let resolved_lookups = select reference, event as binding, kind, file from nearest_answers where kind = "bind" or kind = "global" or kind = "nonlocal";
return resolved_lookups;
