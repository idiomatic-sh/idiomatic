import conditional_deletions from "python/ruff/conditional-deletions";
import annotation_context from "python/ruff/annotation-evaluation-context";
import latest_before from "python/ruff/latest-before";
input reads: relation<reference: node, file: file>;
output relation<reference: node, binding: node, kind: symbol, file: file>;
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let scope_nodes_for_events = select child as id, file from "scope";
let redirect_events = select occurrence as id, name, ordinal, kind, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_owners = axis(from=redirect_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let redirect_namespace_rows = select id as occurrence, name, ordinal, kind, file, related as scope from redirect_owners;
let redirect_module_nodes = select id, file from nodes where kind = "module";
let module_redirect_rows = select l.occurrence as occurrence, l.file as file from redirect_namespace_rows as l join redirect_module_nodes as r on l.scope = r.id and l.file = r.file;
let redirect_namespaces = antijoin(left=redirect_namespace_rows, right=module_redirect_rows, left-on=["occurrence", "file"], right-on=["occurrence", "file"]);
let handler_span_binds = select occurrence as handler, name, scope, ordinal as begin, file from "binding-event" where kind = "bind";
let handler_span_ends = select occurrence as handler, name, scope, ordinal as finish, file from "binding-event" where kind = "cleanup";
let handler_spans = select l.handler as handler, l.name as name, l.scope as scope, l.begin as begin, r.finish as finish, l.file as file from handler_span_binds as l join handler_span_ends as r on l.handler = r.handler and l.name = r.name and l.scope = r.scope and l.file = r.file where l.begin < r.finish;
let span_deletions = select occurrence as id, name, scope, ordinal, file from "binding-event" where kind = "delete";
let handler_owned_deletions = select l.id as id, l.file as file from span_deletions as l join handler_spans as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.ordinal > r.begin and l.ordinal < r.finish;
let all_value_namespace_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let conditional_delete_rows = conditional_deletions();
let unconditional_value_events = antijoin(left=all_value_namespace_events, right=conditional_delete_rows, left-on=["id", "file"], right-on=["id", "file"]);
let value_namespace_events = antijoin(left=unconditional_value_events, right=handler_owned_deletions, left-on=["id", "file"], right-on=["id", "file"]);
let stub_annotation_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "annotation" and matches(file, "[.]pyi$");
let parameter_declarations = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let annotation_prior_values = antijoin(left=value_namespace_events, right=parameter_declarations, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_previous_events = union(left=annotation_prior_values, right=stub_annotation_events);
let annotation_prior_stream = select scope, name, file, ordinal, id from annotation_previous_events;
let annotation_prior_pairs = ordered-match(left=annotation_prior_stream, right=annotation_prior_stream, left-on=[scope,name,file], right-on=[scope,name,file], left-order="ordinal", right-order="ordinal", output={later:[right,id], later_order:[right,ordinal], file:[right,file]});
let delayed_annotations = select l.id as id, l.file as file from stub_annotation_events as l join annotation_prior_pairs as r on l.id = r.later and l.ordinal = r.later_order and l.file = r.file;
let fresh_annotations = antijoin(left=stub_annotation_events, right=delayed_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let builtin_module_nodes = select id, file from nodes where kind = "module";
let builtin_annotation_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let module_annotation_names = select l.id as id, l.name as name, l.file as file from fresh_annotations as l join builtin_module_nodes as r on l.scope = r.id and l.file = r.file;
let delayed_builtin_annotations = select l.id as id, l.file as file from module_annotation_names as l join builtin_annotation_names as r on l.name = r.name and l.file = r.file;
let real_annotations = antijoin(left=fresh_annotations, right=delayed_builtin_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let all_raw_namespace_events = union(left=value_namespace_events, right=real_annotations);
let scope_body_roots = select l.id as scope, l.file as file, r.child as id from scope_nodes_for_events as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let type_function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_header_children = select l.id as owner, l.file as file, r.child as id from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.owner as owner, l.file as file from class_header_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_annotation_roots = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_type_owners = axis(from=parameter_annotation_roots,relation="semantic-child",direction=nearest-ancestor,domain=type_function_nodes);
let parameter_type_roots = select id, related as owner, file from parameter_type_owners;
let return_type_roots = select r.child as id, l.id as owner, l.file as file from type_function_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_type_roots = union(left=parameter_type_roots,right=return_type_roots);
let type_scope_roots = union(left=class_type_roots,right=function_type_roots);
let body_evaluation_roots = select id, scope as owner, file from scope_body_roots;
let evaluation_roots = union(left=body_evaluation_roots,right=type_scope_roots);
let nearest_evaluations = axis(from=all_raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=evaluation_roots);
let class_type_namespace_events = select l.id as id, l.file as file from nearest_evaluations as l join class_type_roots as r on l.related = r.id and l.file = r.file;
let function_type_namespace_candidates = select l.id as id, l.file as file from nearest_evaluations as l join function_type_roots as r on l.related = r.id and l.file = r.file;
let function_event_contexts = annotation_context(expressions=function_type_namespace_candidates);
let function_type_namespace_events = select id, file from function_event_contexts where evaluation = "eager" or evaluation = "postponed" or evaluation = "deferred";
let all_type_namespace_events = union(left=class_type_namespace_events, right=function_type_namespace_events);
let raw_namespace_events = antijoin(left=all_raw_namespace_events,right=all_type_namespace_events,left-on=["id","file"],right-on=["id","file"]);
let annotation_inputs = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "annotation";
let python_annotations = antijoin(left=annotation_inputs, right=stub_annotation_events, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_function_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_annotations = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from python_annotations as l join annotation_function_scopes as r on l.scope = r.id and l.file = r.file;
let function_annotation_probes = select scope, scope as phase, name, file, ordinal from function_annotations;
let value_event_stream = select scope, scope as phase, name, file, ordinal from value_namespace_events;
let function_annotation_hits = latest_before(events=value_event_stream, probes=function_annotation_probes);
let delayed_function_annotations = select l.id as id, l.file as file from function_annotations as l join function_annotation_hits as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.point;
let fresh_function_annotations = antijoin(left=function_annotations, right=delayed_function_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let type_parameter_defines = select id, name, owner, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let valid_namespace_ids = select id, file from raw_namespace_events;
let valid_annotation_ids = select id, file from fresh_function_annotations;
let valid_parameter_ids = select id, file from type_parameter_defines;
let valid_event_ids0 = union(left=valid_namespace_ids, right=valid_annotation_ids);
let valid_event_ids = union(left=valid_event_ids0, right=valid_parameter_ids);
let resolution_rows = select r.reference as reference, r.event as event, r.kind as kind, r.scope as scope, r.lexical as lexical, r.depth as depth, r.ordinal as ordinal, r.context as context, r.file as file from reads as l join "binding-resolution" as r on l.reference = r.reference and l.file = r.file;
let rows = select reference, event, kind, scope, lexical, depth, ordinal, file from resolution_rows where context != "deletion" or depth = 0;
let plain_candidates = select reference, event, kind, depth, file from rows where (kind = "bind" or kind = "annotation" or kind = "delete") and lexical = scope;
let unproven_candidates = antijoin(left=plain_candidates, right=valid_event_ids, left-on=["event", "file"], right-on=["id", "file"]);
let plain_answers = antijoin(left=plain_candidates, right=unproven_candidates, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let stepping_rows = antijoin(left=rows, right=plain_answers, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let declaration_rows = select l.reference as reference, l.depth as depth, l.scope as scope, r.name as name, l.file as file from stepping_rows as l join redirect_namespaces as r on l.event = r.occurrence and l.ordinal = r.ordinal and l.scope = r.scope and l.file = r.file where l.kind = "global" or l.kind = "nonlocal";
let home_rows = antijoin(left=stepping_rows, right=declaration_rows, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let home_names = select l.reference as reference, l.depth as depth, l.scope as scope, r.name as name, l.ordinal as ordinal, l.file as file from home_rows as l join "binding-event" as r on l.event = r.occurrence and l.ordinal = r.ordinal and l.file = r.file;
let home_group_rows = select scope, name, file from home_names;
let home_groups_counts = group-count(from=home_group_rows, keys=["scope","name","file"], count="count");
let home_groups = select scope, name, file from home_groups_counts;
let stream_inputs = select occurrence as id, name, scope, lexical, ordinal, kind, file from "binding-event" where kind != "read" and kind != "wildcard";
let home_events = select e.id as id, e.name as name, e.scope as scope, e.lexical as lexical, e.ordinal as ordinal, e.kind as kind, e.file as file from stream_inputs as e join home_groups as g on e.scope = g.scope and e.name = g.name and e.file = g.file;
let home_own_events = select id, name, scope, ordinal, kind, file from home_events where lexical = scope;
let home_unproven = antijoin(left=home_own_events, right=valid_event_ids, left-on=["id", "file"], right-on=["id", "file"]);
let home_valid = antijoin(left=home_own_events, right=home_unproven, left-on=["id", "ordinal", "file"], right-on=["id", "ordinal", "file"]);
let home_ignored = antijoin(left=home_events, right=home_valid, left-on=["id", "ordinal", "file"], right-on=["id", "ordinal", "file"]);
let home_stream = select scope, name, file, ordinal from home_events;
let home_pairs = ordered-match(left=home_stream, right=home_stream, left-on=[scope,name,file], right-on=[scope,name,file], left-order="ordinal", right-order="ordinal", output={scope:[left,scope], name:[left,name], file:[left,file], before:[left,ordinal], at:[right,ordinal]});
let home_skips = select l.scope as scope, l.scope as phase, l.name as name, l.file as file, r.at as node, r.before as target from home_ignored as l join home_pairs as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.at;
let home_selves = select scope, scope as phase, name, file, ordinal as node, ordinal as target from home_valid where kind != "cleanup";
let home_cleanups = select id, name, scope, ordinal, file from home_valid where kind = "cleanup";
let home_binds = select id, name, scope, ordinal, file from home_events where kind = "bind";
let home_intervals = select l.scope as scope, l.name as name, l.file as file, l.ordinal as finish, r.ordinal as begin from home_cleanups as l join home_binds as r on l.id = r.id and l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let home_restores = select l.scope as scope, l.scope as phase, l.name as name, l.file as file, l.finish as node, r.before as target from home_intervals as l join home_pairs as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.begin = r.at;
let home_pointers0 = union(left=home_skips, right=home_selves);
let home_pointers = union(left=home_pointers0, right=home_restores);
let home_resolved = follow(edges=home_pointers, source="node", destination="target", keys=[scope,phase,name,file]);
let home_finals = select l.reference as reference, l.depth as depth, l.scope as scope, l.name as name, r.target as final, l.file as file from home_names as l join home_resolved as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.node;
let home_final_counts = group-count(from=home_finals, keys=["reference","depth","scope","name","final","file"], count="count");
let home_answers = select l.reference as reference, r.id as event, r.kind as kind, l.depth as depth, l.file as file from home_final_counts as l join home_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.final = r.ordinal;
let declaration_references = select l.reference as reference, l.depth as depth, l.scope as scope, l.name as name, r.ordinal as point, l.file as file from declaration_rows as l join "binding-event" as r on l.reference = r.occurrence and l.file = r.file where r.kind = "read" or r.kind = "delete";
let lazy_roots = select child as id, file from "semantic-child" where field = "bound" or field = "default-value";
let lazy_inputs = select reference as id, file from declaration_rows;
let lazy_axis = axis(from=lazy_inputs, relation="semantic-child", direction=ancestor, domain=lazy_roots);
let lazy_nested = select id as reference, file from lazy_axis;
let lazy_self = select l.id as reference, l.file as file from lazy_inputs as l join lazy_roots as r on l.id = r.id and l.file = r.file;
let lazy_reads = union(left=lazy_nested, right=lazy_self);
let eager_declaration_points = antijoin(left=declaration_references, right=lazy_reads, left-on=["reference", "file"], right-on=["reference", "file"]);
let lazy_declaration_references = antijoin(left=declaration_references, right=eager_declaration_points, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let lazy_declaration_rows = select reference, depth, scope, name, file from lazy_declaration_references;
let lazy_declaration_points0 = extend(from=lazy_declaration_rows, values={point: 2147483647});
let lazy_declaration_points = select reference, depth, scope, name, point, file from lazy_declaration_points0;
let declaration_points = union(left=eager_declaration_points, right=lazy_declaration_points);
let declaring_group_rows = select scope, name, file from declaration_rows;
let declaring_groups_counts = group-count(from=declaring_group_rows, keys=["scope","name","file"], count="count");
let declaring_groups = select scope, name, file from declaring_groups_counts;
let declaring_events = select e.id as id, e.name as name, e.lexical as scope, e.ordinal as ordinal, e.kind as kind, e.file as file from stream_inputs as e join declaring_groups as g on e.lexical = g.scope and e.name = g.name and e.file = g.file;
let declaring_unproven0 = antijoin(left=declaring_events, right=valid_event_ids, left-on=["id", "file"], right-on=["id", "file"]);
let declaring_unproven = select id, name, scope, ordinal, kind, file from declaring_unproven0 where kind != "global" and kind != "nonlocal";
let declaring_valid = antijoin(left=declaring_events, right=declaring_unproven, left-on=["id", "ordinal", "file"], right-on=["id", "ordinal", "file"]);
let nearest_declaring_options = as-of(left=declaration_points, right=declaring_valid, left-on=[scope,name,file], right-on=[scope,name,file], left-order="point", right-order="ordinal", bound=before, output={reference:[left,reference], depth:[left,depth], scope:[left,scope], name:[left,name], event:[right,id], ordinal:[right,ordinal], kind:[right,kind], file:[left,file]});
let older_declaring_options = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from nearest_declaring_options as l join nearest_declaring_options as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where l.ordinal < r.ordinal;
let declaring_starts = antijoin(left=nearest_declaring_options, right=older_declaring_options, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let declaring_plain = select reference, event, kind, depth, file from declaring_starts where kind = "bind" or kind = "annotation" or kind = "delete";
let declaring_cleanups = select reference, depth, scope, name, ordinal, file from declaring_starts where kind = "cleanup";
let declaring_stream = select scope, name, file, ordinal from declaring_events;
let declaring_pairs = ordered-match(left=declaring_stream, right=declaring_stream, left-on=[scope,name,file], right-on=[scope,name,file], left-order="ordinal", right-order="ordinal", output={scope:[left,scope], name:[left,name], file:[left,file], before:[left,ordinal], at:[right,ordinal]});
let declaring_skips = select l.scope as scope, l.scope as phase, l.name as name, l.file as file, r.at as node, r.before as target from declaring_unproven as l join declaring_pairs as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.at;
let declaring_selves = select scope, scope as phase, name, file, ordinal as node, ordinal as target from declaring_valid where kind != "cleanup";
let declaring_cleanup_events = select id, name, scope, ordinal, file from declaring_valid where kind = "cleanup";
let declaring_binds = select id, name, scope, ordinal, file from declaring_events where kind = "bind";
let declaring_intervals = select l.scope as scope, l.name as name, l.file as file, l.ordinal as finish, r.ordinal as begin from declaring_cleanup_events as l join declaring_binds as r on l.id = r.id and l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let declaring_restores = select l.scope as scope, l.scope as phase, l.name as name, l.file as file, l.finish as node, r.before as target from declaring_intervals as l join declaring_pairs as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.begin = r.at;
let declaring_pointers0 = union(left=declaring_skips, right=declaring_selves);
let declaring_pointers = union(left=declaring_pointers0, right=declaring_restores);
let declaring_resolved = follow(edges=declaring_pointers, source="node", destination="target", keys=[scope,phase,name,file]);
let declaring_finals = select l.reference as reference, l.depth as depth, l.scope as scope, l.name as name, r.target as final, l.file as file from declaring_cleanups as l join declaring_resolved as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.node;
let declaring_final_counts = group-count(from=declaring_finals, keys=["reference","depth","scope","name","final","file"], count="count");
let declaring_restored = select l.reference as reference, r.id as event, r.kind as kind, l.depth as depth, l.file as file from declaring_final_counts as l join declaring_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.final = r.ordinal;
let stepped_answers0 = union(left=home_answers, right=declaring_plain);
let stepped_answers = union(left=stepped_answers0, right=declaring_restored);
let answers = union(left=plain_answers, right=stepped_answers);
let nearest_answers = group-min(from=answers, keys=["reference", "file"], order="depth");
let resolved_lookups = select reference, event as binding, kind, file from nearest_answers where kind = "bind" or kind = "global" or kind = "nonlocal";
return resolved_lookups;
