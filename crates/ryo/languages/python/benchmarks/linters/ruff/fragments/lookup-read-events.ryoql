import conditional_deletions from "python/ruff/conditional-deletions";
input reads: relation<reference: node, point: number, file: file>;
output relation<reference: node, event: node, kind: symbol, scope: node, depth: number, via: symbol, file: file>;
let path = select r.reference as reference, r.name as name, r.scope as scope, r.depth as depth, r.context as context, l.point as point, r.file as file from reads as l join "lookup-scope" as r on l.reference = r.reference and l.file = r.file;
let stream = select occurrence as event, name, scope, lexical, ordinal, kind, file from "binding-event" where kind != "read" and kind != "wildcard";
let prior = select l.reference as reference, l.name as name, r.event as event, r.kind as kind, l.scope as scope, r.lexical as lexical, l.depth as depth, r.ordinal as ordinal, l.context as context, l.file as file from path as l join stream as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point;
let type_parameters = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_steps = select l.reference as reference, l.name as name, l.scope as event, l.scope as scope, l.scope as lexical, l.depth as depth, l.context as context, l.file as file from path as l join type_parameters as r on l.scope = r.id and l.file = r.file;
let parameter_binds = extend(from=parameter_steps, values={kind: "bind", ordinal: 0});
let parameter_events = select reference, name, event, kind, scope, lexical, depth, ordinal, context, file from parameter_binds;
let found = union(left=prior, right=parameter_events);
let modules = select id, file from "semantic-syntax" where kind = "module";
let own_events = select reference, name, event, kind, scope, depth, ordinal, context, file from found where lexical = scope;
let declared_events = select l.reference as reference, l.name as name, l.event as event, l.kind as kind, l.lexical as scope, r.depth as depth, l.ordinal as ordinal, l.context as context, l.file as file from found as l join path as r on l.reference = r.reference and l.lexical = r.scope and l.file = r.file where l.lexical != l.scope;
let checker_events = union(left=own_events, right=declared_events);
let events = select reference, name, event, kind, scope, depth, ordinal, file from checker_events where context != "deletion" or depth = 0;
let module_declarations = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from events as l join modules as r on l.scope = r.id and l.file = r.file where l.kind = "global" or l.kind = "nonlocal";
let scoped_events0 = antijoin(left=events, right=module_declarations, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let handler_ends = select reference, event, depth, ordinal, file from scoped_events0 where kind = "cleanup";
let handler_spans = select l.reference as reference, l.depth as depth, r.ordinal as begin, l.ordinal as finish, l.file as file from handler_ends as l join scoped_events0 as r on l.reference = r.reference and l.depth = r.depth and l.event = r.event and l.file = r.file where r.kind = "bind" and r.ordinal < l.ordinal;
let ended_events = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from scoped_events0 as l join handler_spans as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where l.ordinal >= r.begin and l.ordinal < r.finish;
let scoped_events = antijoin(left=scoped_events0, right=ended_events, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let conditional = conditional_deletions();
let counted_events = antijoin(left=scoped_events, right=conditional, left-on=["event", "file"], right-on=["id", "file"]);
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let call_arguments = select id, file from "semantic-syntax" where kind = "call-arguments";
let class_children = select r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_headers = select l.id as id, l.file as file from class_children as l join call_arguments as r on l.id = r.id and l.file = r.file;
let parameters = select id, file from "semantic-syntax" where kind = "arg";
let parameter_annotations = select r.child as id, l.file as file from parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let return_annotations = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let signature_annotations = union(left=parameter_annotations, right=return_annotations);
let type_roots = union(left=class_headers, right=signature_annotations);
let scope_nodes = select child as id, file from "scope";
let body_roots = select r.child as id, l.file as file from scope_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let evaluation_roots = union(left=body_roots, right=type_roots);
let bound_events = select event as id, file from stream where kind = "bind" or kind = "delete";
let nearest_roots = axis(from=bound_events, relation="semantic-child", direction=nearest-ancestor, domain=evaluation_roots);
let type_root_events = select l.id as id, l.file as file from nearest_roots as l join type_roots as r on l.related = r.id and l.file = r.file;
let body_events = antijoin(left=counted_events, right=type_root_events, left-on=["event", "file"], right-on=["id", "file"]);
let stored_values = select reference, event, kind, scope, depth, ordinal, file from body_events where kind = "bind" or kind = "delete" or kind = "global" or kind = "nonlocal";
let cleanups = select reference, depth, ordinal, file from body_events where kind = "cleanup";
let annotations = select reference, name, event, kind, scope, depth, ordinal, file from body_events where kind = "annotation";
let stub_annotations = select reference, name, event, kind, scope, depth, ordinal, file from annotations where matches(file, "[.]pyi$");
let python_annotations = antijoin(left=annotations, right=stub_annotations, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_annotations = select l.reference as reference, l.event as event, l.kind as kind, l.scope as scope, l.depth as depth, l.ordinal as ordinal, l.file as file from python_annotations as l join function_scopes as r on l.scope = r.id and l.file = r.file;
let builtin_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let module_stub_annotations = select l.reference as reference, l.name as name, l.depth as depth, l.ordinal as ordinal, l.file as file from stub_annotations as l join modules as r on l.scope = r.id and l.file = r.file;
let builtin_stub_annotations = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from module_stub_annotations as l join builtin_names as r on l.name = r.name and l.file = r.file;
let declaring_stub_annotations0 = antijoin(left=stub_annotations, right=builtin_stub_annotations, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let declaring_stub_annotations = select reference, event, kind, scope, depth, ordinal, file from declaring_stub_annotations0;
let candidate_annotations = union(left=function_annotations, right=declaring_stub_annotations);
let prior_values0 = select reference, depth, ordinal, file from stored_values where kind = "bind" or kind = "delete";
let prior_values = union(left=prior_values0, right=cleanups);
let delayed_annotations = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from candidate_annotations as l join prior_values as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where r.ordinal < l.ordinal;
let fresh_annotations = antijoin(left=candidate_annotations, right=delayed_annotations, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let values = union(left=stored_values, right=fresh_annotations);
let older_values = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from values as l join values as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where l.ordinal < r.ordinal;
let decisive = antijoin(left=values, right=older_values, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let plain_decisions0 = select reference, event, kind, scope, depth, file from decisive where kind = "bind" or kind = "delete" or kind = "annotation";
let plain_decisions = extend(from=plain_decisions0, values={via: "direct"});
let declaration_decisions = select reference, event, kind, scope, depth, ordinal, file from decisive where kind = "global" or kind = "nonlocal";
let restored_keys = select l.reference as reference, l.depth as depth, l.file as file from declaration_decisions as l join cleanups as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where l.ordinal < r.ordinal;
let restored_declarations0 = select l.reference as reference, l.event as event, l.kind as kind, l.scope as scope, l.depth as depth, l.file as file from declaration_decisions as l join restored_keys as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file;
let restored_declarations = extend(from=restored_declarations0, values={via: "cleanup"});
let direct_declarations0 = antijoin(left=declaration_decisions, right=restored_keys, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let direct_declarations1 = select reference, event, kind, scope, depth, file from direct_declarations0;
let direct_declarations = extend(from=direct_declarations1, values={via: "declaration"});
let decisions0 = union(left=plain_decisions, right=restored_declarations);
let decisions1 = union(left=decisions0, right=direct_declarations);
let decisions = select reference, event, kind, scope, depth, via, file from decisions1;
return decisions;
