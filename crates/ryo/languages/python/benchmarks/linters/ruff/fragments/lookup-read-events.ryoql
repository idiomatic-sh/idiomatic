import conditional_deletions from "python/ruff/conditional-deletions";
input reads: relation<reference: node, point: number, file: file>;
output relation<reference: node, event: node, kind: symbol, scope: node, depth: number, file: file>;
let stream = select occurrence as event, name, lexical as scope, ordinal, kind, file from "binding-event" where kind != "read" and kind != "wildcard";
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_declarations = select l.event as event, l.ordinal as ordinal, l.file as file from stream as l join modules as r on l.scope = r.id and l.file = r.file where glob_any(l.kind, "{global,nonlocal}");
let scoped_stream = antijoin(left=stream, right=module_declarations, left-on=["event", "ordinal", "file"], right-on=["event", "ordinal", "file"]);
let conditional = conditional_deletions();
let counted_stream = antijoin(left=scoped_stream, right=conditional, left-on=["event", "file"], right-on=["id", "file"]);
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let call_arguments = select id, file from "semantic-syntax" where kind = "call-arguments";
let class_children = select r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_headers = select l.id as id, l.file as file from class_children as l join call_arguments as r on l.id = r.id and l.file = r.file;
let parameters = select id, file from "semantic-syntax" where kind = "arg";
let parameter_annotations = select r.child as id, l.file as file from parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let return_annotations = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let signature_annotations = union(left=parameter_annotations, right=return_annotations);
let type_roots = union(left=class_headers, right=signature_annotations);
let scope_nodes = select child as id, file from "scope";
let body_roots = select r.child as id, l.file as file from scope_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let evaluation_roots = union(left=body_roots, right=type_roots);
let bound_events = select event as id, file from counted_stream where glob_any(kind, "{bind,delete}");
let nearest_roots = axis(from=bound_events, relation="semantic-child", direction=nearest-ancestor, domain=evaluation_roots);
let type_root_events = select l.id as id, l.file as file from nearest_roots as l join type_roots as r on l.related = r.id and l.file = r.file;
let body_stream = antijoin(left=counted_stream, right=type_root_events, left-on=["event", "file"], right-on=["id", "file"]);
let stored_values = select event, name, scope, ordinal, kind, file from body_stream where glob_any(kind, "{bind,delete,global,nonlocal}");
let cleanups = select event, name, scope, ordinal, file from body_stream where kind = "cleanup";
let annotations = select event, name, scope, ordinal, kind, file from body_stream where kind = "annotation";
let stub_annotations = select event, name, scope, ordinal, kind, file from annotations where matches(file, "[.]pyi$");
let python_annotations = antijoin(left=annotations, right=stub_annotations, left-on=["event", "ordinal", "file"], right-on=["event", "ordinal", "file"]);
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_annotations = select l.event as event, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from python_annotations as l join function_scopes as r on l.scope = r.id and l.file = r.file;
let builtin_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let module_stub_annotations = select l.event as event, l.name as name, l.ordinal as ordinal, l.file as file from stub_annotations as l join modules as r on l.scope = r.id and l.file = r.file;
let builtin_stub_annotations = select l.event as event, l.ordinal as ordinal, l.file as file from module_stub_annotations as l join builtin_names as r on l.name = r.name and l.file = r.file;
let declaring_stub_annotations = antijoin(left=stub_annotations, right=builtin_stub_annotations, left-on=["event", "ordinal", "file"], right-on=["event", "ordinal", "file"]);
let candidate_annotations = union(left=function_annotations, right=declaring_stub_annotations);
let prior_stored = select scope, name, ordinal, file from stored_values where glob_any(kind, "{bind,delete}");
let prior_cleanups = select scope, name, ordinal, file from cleanups;
let prior_values = union(left=prior_stored, right=prior_cleanups);
let delayed_annotations = select l.event as event, l.ordinal as ordinal, l.file as file from candidate_annotations as l join prior_values as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let fresh_annotations = antijoin(left=candidate_annotations, right=delayed_annotations, left-on=["event", "ordinal", "file"], right-on=["event", "ordinal", "file"]);
let values = union(left=stored_values, right=fresh_annotations);
let handler_binds = select event, name, scope, ordinal, file from body_stream where kind = "bind";
let handler_spans = select l.scope as scope, l.name as name, r.ordinal as begin, l.ordinal as finish, l.file as file from cleanups as l join handler_binds as r on l.event = r.event and l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let handled_values = select l.scope as scope, l.name as name, l.ordinal as ordinal, r.finish as finish, l.file as file from values as l join handler_spans as r on l.scope = r.scope and l.name = r.name and l.file = r.file where l.ordinal >= r.begin and l.ordinal < r.finish;
let path = select r.reference as reference, r.name as name, r.scope as scope, r.depth as depth, r.context as context, l.point as point, r.file as file from reads as l join "lookup-scope" as r on l.reference = r.reference and l.file = r.file;
let outer_deletion_steps = select reference, depth, file from path where context = "deletion" and depth > 0;
let prior0 = select l.reference as reference, r.event as event, r.kind as kind, l.scope as scope, l.name as name, l.depth as depth, r.ordinal as ordinal, l.point as point, l.file as file from path as l join values as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point;
let ended = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from prior0 as l join handled_values as r on l.scope = r.scope and l.name = r.name and l.ordinal = r.ordinal and l.file = r.file where r.finish < l.point;
let prior = antijoin(left=prior0, right=ended, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let type_parameters = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_steps = select l.reference as reference, l.scope as event, l.scope as scope, l.name as name, l.depth as depth, l.point as point, l.file as file from path as l join type_parameters as r on l.scope = r.id and l.file = r.file;
let parameter_binds = extend(from=parameter_steps, values={kind: "bind", ordinal: 0});
let parameter_events = select reference, event, kind, scope, name, depth, ordinal, point, file from parameter_binds;
let found = union(left=prior, right=parameter_events);
let older_found = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from found as l join found as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file where l.ordinal < r.ordinal;
let outer_deletion_found = select l.reference as reference, l.depth as depth, l.ordinal as ordinal, l.file as file from found as l join outer_deletion_steps as r on l.reference = r.reference and l.depth = r.depth and l.file = r.file;
let undecisive = union(left=older_found, right=outer_deletion_found);
let decisive = antijoin(left=found, right=undecisive, left-on=["reference", "depth", "ordinal", "file"], right-on=["reference", "depth", "ordinal", "file"]);
let declaration_decisions = select reference, event, kind, scope, name, depth, ordinal, point, file from decisive where kind = "global" or kind = "nonlocal";
let plain_decisions0 = antijoin(left=decisive, right=declaration_decisions, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let plain_decisions = select reference, event, kind, scope, depth, file from plain_decisions0;
let restored_declarations = select l.reference as reference, l.event as event, l.kind as kind, l.scope as scope, l.depth as depth, l.file as file from declaration_decisions as l join cleanups as r on l.scope = r.scope and l.name = r.name and l.file = r.file where l.ordinal < r.ordinal and r.ordinal < l.point;
let decisions = union(left=plain_decisions, right=restored_declarations);
return decisions;
