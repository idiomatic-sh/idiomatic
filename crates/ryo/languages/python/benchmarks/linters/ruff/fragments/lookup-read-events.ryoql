import conditional_deletions from "python/ruff/conditional-deletions";
import annotation_context from "python/ruff/annotation-evaluation-context";
import latest_before from "python/ruff/latest-before";
import resolve_pointers from "python/ruff/resolve-pointers";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, header_point: number, stage: number, file: file>;
input expressions: relation<id: node, file: file>;
output relation<context: node, expression: node, occurrence: node, scope: node, kind: symbol, file: file>;
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let attributes = select id, file from nodes where kind = "attribute";
let name_nodes = select id, file from nodes where kind = "name";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let scope_nodes_for_events = select child as id, file from "scope";
let redirect_events = select occurrence as id, name, ordinal, kind, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_owners = axis(from=redirect_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let redirect_namespace_rows = select id as occurrence, name, ordinal, kind, file, related as scope from redirect_owners;
let redirect_module_nodes = select id, file from nodes where kind = "module";
let module_redirect_rows = select l.occurrence as occurrence, l.file as file from redirect_namespace_rows as l join redirect_module_nodes as r on l.scope = r.id and l.file = r.file;
let redirect_namespaces = antijoin(left=redirect_namespace_rows, right=module_redirect_rows, left-on=["occurrence", "file"], right-on=["occurrence", "file"]);
let handler_span_binds = select occurrence as handler, name, scope, ordinal as begin, file from "binding-event" where kind = "bind";
let handler_span_ends = select occurrence as handler, name, scope, ordinal as finish, file from "binding-event" where kind = "cleanup";
let handler_spans = select l.handler as handler, l.name as name, l.scope as scope, l.begin as begin, r.finish as finish, l.file as file from handler_span_binds as l join handler_span_ends as r on l.handler = r.handler and l.name = r.name and l.scope = r.scope and l.file = r.file where l.begin < r.finish;
let span_deletions = select occurrence as id, name, scope, ordinal, file from "binding-event" where kind = "delete";
let handler_owned_deletions = select l.id as id, l.file as file from span_deletions as l join handler_spans as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.ordinal > r.begin and l.ordinal < r.finish;
let all_value_namespace_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let conditional_delete_rows = conditional_deletions();
let unconditional_value_events = antijoin(left=all_value_namespace_events, right=conditional_delete_rows, left-on=["id", "file"], right-on=["id", "file"]);
let value_namespace_events = antijoin(left=unconditional_value_events, right=handler_owned_deletions, left-on=["id", "file"], right-on=["id", "file"]);
let stub_annotation_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "annotation" and matches(file, "[.]pyi$");
let parameter_declarations = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let annotation_prior_values = antijoin(left=value_namespace_events, right=parameter_declarations, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_previous_events = union(left=annotation_prior_values, right=stub_annotation_events);
let annotation_prior_stream = select scope, name, file, ordinal, id from annotation_previous_events;
let annotation_prior_pairs = ordered-match(left=annotation_prior_stream, right=annotation_prior_stream, left-on=[scope,name,file], right-on=[scope,name,file], left-order="ordinal", right-order="ordinal", output={later:[right,id], later_order:[right,ordinal], file:[right,file]});
let delayed_annotations = select l.id as id, l.file as file from stub_annotation_events as l join annotation_prior_pairs as r on l.id = r.later and l.ordinal = r.later_order and l.file = r.file;
let fresh_annotations = antijoin(left=stub_annotation_events, right=delayed_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let builtin_module_nodes = select id, file from nodes where kind = "module";
let builtin_annotation_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let module_annotation_names = select l.id as id, l.name as name, l.file as file from fresh_annotations as l join builtin_module_nodes as r on l.scope = r.id and l.file = r.file;
let delayed_builtin_annotations = select l.id as id, l.file as file from module_annotation_names as l join builtin_annotation_names as r on l.name = r.name and l.file = r.file;
let real_annotations = antijoin(left=fresh_annotations, right=delayed_builtin_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let all_raw_namespace_events = union(left=value_namespace_events, right=real_annotations);
let scope_body_roots = select l.id as scope, l.file as file, r.child as id from scope_nodes_for_events as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let type_function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_header_children = select l.id as owner, l.file as file, r.child as id from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.owner as owner, l.file as file from class_header_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_annotation_roots = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_type_owners = axis(from=parameter_annotation_roots,relation="semantic-child",direction=nearest-ancestor,domain=type_function_nodes);
let parameter_type_roots = select id, related as owner, file from parameter_type_owners;
let return_type_roots = select r.child as id, l.id as owner, l.file as file from type_function_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_type_roots = union(left=parameter_type_roots,right=return_type_roots);
let type_scope_roots = union(left=class_type_roots,right=function_type_roots);
let body_evaluation_roots = select id, scope as owner, file from scope_body_roots;
let evaluation_roots = union(left=body_evaluation_roots,right=type_scope_roots);
let nearest_evaluations = axis(from=all_raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=evaluation_roots);
let stub_type_roots = select id, file from type_scope_roots where matches(file, "\.pyi$");
let function_root_inputs = select id, file from function_type_roots;
let function_annotation_contexts = annotation_context(expressions=function_root_inputs);
let eager_function_roots = select id, file from function_annotation_contexts where evaluation = "eager";
let active_function_roots = antijoin(left=eager_function_roots, right=stub_type_roots, left-on=["id", "file"], right-on=["id", "file"]);
let class_root_ids = select id, file from class_type_roots;
let active_class_roots = antijoin(left=class_root_ids, right=stub_type_roots, left-on=["id", "file"], right-on=["id", "file"]);
let active_initial_type_roots = union(left=active_function_roots, right=active_class_roots);
let class_type_namespace_events = select l.id as id, l.file as file from nearest_evaluations as l join class_type_roots as r on l.related = r.id and l.file = r.file;
let function_type_namespace_candidates = select l.id as id, l.file as file from nearest_evaluations as l join function_type_roots as r on l.related = r.id and l.file = r.file;
let function_event_contexts = annotation_context(expressions=function_type_namespace_candidates);
let function_type_namespace_events = select id, file from function_event_contexts where evaluation = "eager" or evaluation = "postponed" or evaluation = "deferred";
let all_type_namespace_events = union(left=class_type_namespace_events, right=function_type_namespace_events);
let raw_namespace_events = antijoin(left=all_raw_namespace_events,right=all_type_namespace_events,left-on=["id","file"],right-on=["id","file"]);
let lexical_event_owners = axis(from=raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let event_body_ancestors = axis(from=raw_namespace_events,relation="semantic-child",direction=ancestor,domain=scope_body_roots);
let ancestor_body_owners = select l.id as id, l.file as file, r.scope as scope from event_body_ancestors as l join scope_body_roots as r on l.related = r.id and l.file = r.file;
let self_body_owners = select l.id as id, l.file as file, r.scope as scope from raw_namespace_events as l join scope_body_roots as r on l.id = r.id and l.file = r.file;
let event_body_owners = union(left=ancestor_body_owners,right=self_body_owners);
let lexical_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from lexical_event_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let named_expressions = select id, file from nodes where kind = "named-expr";
let walrus_targets = select r.child as id, l.file as file from named_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let walrus_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from raw_namespace_events as l join walrus_targets as r on l.id = r.id and l.file = r.file;
let non_comprehension_scopes = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let walrus_lexical_owners = axis(from=walrus_events,relation="semantic-child",direction=nearest-ancestor,domain=non_comprehension_scopes);
let walrus_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from walrus_lexical_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let owned_namespace_events = union(left=lexical_body_events,right=walrus_body_events);
let redirect_key_names = select scope, name, file from redirect_namespaces;
let redirected_namespace_events = select l.id as occurrence, l.name as name, l.related as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from owned_namespace_events as l join redirect_key_names as r on l.related = r.scope and l.name = r.name and l.file = r.file;
let normal_namespace_rows = antijoin(left=raw_namespace_events,right=redirected_namespace_events,left-on=["id","file"],right-on=["occurrence","file"]);
let normal_namespace_events = select id as occurrence, name, scope, ordinal, kind, file from normal_namespace_rows;
let corrected_namespace_events = union(left=normal_namespace_events,right=redirected_namespace_events);
let type_parameter_defines = select id, name, owner, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let type_parameter_rows = select id as occurrence, name, id as scope, file from type_parameter_defines;
let type_parameter_stamped = extend(from=type_parameter_rows, values={ordinal: 0, kind: "bind"});
let type_parameter_events = select occurrence, name, scope, ordinal, kind, file from type_parameter_stamped;
let declared_namespace_events = union(left=corrected_namespace_events,right=redirect_namespaces);
let namespace_events = union(left=declared_namespace_events,right=type_parameter_events);
let named_or_attributed = union(left=name_nodes, right=attributes);
let attribute_value_edges = select r.child as origin, l.id as destination, l.file as file from attributes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let contiguous_attribute_edges = select l.origin as origin, l.destination as destination from attribute_value_edges as l join named_or_attributed as r on l.origin = r.id and l.file = r.file;
let expression_self_edges = select id as origin, id as destination from named_or_attributed;
let expression_edges = union(left=contiguous_attribute_edges, right=expression_self_edges);
let expression_paths = closure(edges=expression_edges, source="origin", destination="destination");
let type_owner_inputs = select owner as id, file from type_parameter_defines;
let type_owner_scopes = axis(from=type_owner_inputs, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes_for_events);
let type_parameter_edges = select l.id as origin, r.related as destination, l.file as file from type_parameter_defines as l join type_owner_scopes as r on l.owner = r.id and l.file = r.file;
let plain_scope_edges = select child as origin, parent as destination, file from "scope";
let type_owner_edges = select owner as origin, id as destination, file from type_parameter_defines;
let type_scope_edges = union(left=type_parameter_edges, right=type_owner_edges);
let scope_edges = union(left=plain_scope_edges, right=type_scope_edges);
let scope_paths = closure(edges=scope_edges,source="origin",destination="destination",keys=["file"]);
let outer_lookup_scopes = select l.stage as stage, l.header_point as header_point, l.context as context, l.initial_scope as initial_scope, l.point as point, l.file as file, r.destination as lookup_scope from ordered_contexts as l join scope_paths as r on l.initial_scope = r.origin and l.file = r.file;
let ancestor_class_scopes = select l.context as context, l.lookup_scope as lookup_scope, l.file as file from outer_lookup_scopes as l join classes as r on l.lookup_scope = r.id and l.file = r.file where l.lookup_scope != l.initial_scope;
let visible_outer_scopes = antijoin(left=outer_lookup_scopes,right=ancestor_class_scopes,left-on=["context","lookup_scope","file"],right-on=["context","lookup_scope","file"]);
let self_lookup_scopes = select stage, header_point, context, initial_scope, point, file, initial_scope as lookup_scope from ordered_contexts;
let ordinary_lookup_scopes = union(left=visible_outer_scopes,right=self_lookup_scopes);
let type_owner_nodes = select owner as id, file from type_parameter_defines;
let type_header_axis = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=type_owner_nodes);
let type_header_owner_rows = select id as expression, related as owner, file from type_header_axis;
let outside_decorators = select child as root, parent as owner, file from "semantic-child" where field = "decorator-list";
let default_roots = select child as id, file from "semantic-child" where field = "defaults" or field = "kw-defaults";
let default_callables = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let default_owner_axis = axis(from=default_roots, relation="semantic-child", direction=nearest-ancestor, domain=default_callables);
let outside_defaults = select id as root, related as owner, file from default_owner_axis;
let outside_roots = union(left=outside_decorators, right=outside_defaults);
let outside_root_inputs = select root as id, file from outside_roots;
let outside_axis = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=outside_root_inputs);
let outside_descendants = select l.id as expression, r.owner as owner, l.file as file from outside_axis as l join outside_roots as r on l.related = r.root and l.file = r.file;
let outside_self = select l.id as expression, r.owner as owner, l.file as file from expressions as l join outside_roots as r on l.id = r.root and l.file = r.file;
let outside_pairs = union(left=outside_descendants, right=outside_self);
let type_header_owners = antijoin(left=type_header_owner_rows, right=outside_pairs, left-on=["expression","owner","file"], right-on=["expression","owner","file"]);
let type_header_parameters = select l.expression as expression, r.id as lookup_scope, l.file as file from type_header_owners as l join type_parameter_defines as r on l.owner = r.owner and l.file = r.file;
let type_context_scopes = select c.stage as stage, c.header_point as header_point, c.context as context, c.initial_scope as initial_scope, c.point as point, c.file as file, h.lookup_scope as lookup_scope from ordered_contexts as c join type_header_parameters as h on c.context = h.expression and c.file = h.file where c.stage >= 0;
let lookup_scopes = union(left=ordinary_lookup_scopes,right=type_context_scopes);
let base_root_paths = select r.origin as expression, l.file as file from expressions as l join expression_paths as r on l.id = r.destination;
let base_name_roots = select l.expression as expression, l.file as file from base_root_paths as l join name_nodes as r on l.expression = r.id and l.file = r.file;
let root_names = select l.expression as expression, l.file as file, r.name as name from base_name_roots as l join "identifier" as r on l.expression = r.id and l.file = r.file;
let own_context_names = select l.stage as stage, l.header_point as header_point, l.initial_scope as initial_scope, l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from lookup_scopes as l join root_names as r on l.context = r.expression and l.file = r.file;
let context_names = select stage, header_point, initial_scope, context, point, file, lookup_scope, expression, name from own_context_names;
let cleanup_events = select occurrence, name, scope, ordinal, file from namespace_events where kind = "cleanup";
let handler_binds = select occurrence, name, scope, ordinal, file from namespace_events where kind = "bind";
let handler_intervals = select l.occurrence as handler, l.name as name, l.scope as scope, l.file as file, l.ordinal as finish, r.ordinal as begin from cleanup_events as l join handler_binds as r on l.occurrence = r.occurrence and l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let declaration_context_names = select stage, header_point, initial_scope, context, point, file, lookup_scope, expression, name from context_names where stage < 2;
let declaration_preceding_bindings = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.occurrence as definition, r.ordinal as ordinal, r.kind as kind from declaration_context_names as l join namespace_events as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (l.stage != 1 or l.lookup_scope != l.initial_scope);
let annotation_inputs = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "annotation";
let python_annotations = antijoin(left=annotation_inputs, right=stub_annotation_events, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_function_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_annotations = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from python_annotations as l join annotation_function_scopes as r on l.scope = r.id and l.file = r.file;
let function_annotation_probes = select scope, scope as phase, name, file, ordinal from function_annotations;
let value_event_stream = select scope, scope as phase, name, file, ordinal from value_namespace_events;
let function_annotation_hits = latest_before(events=value_event_stream, probes=function_annotation_probes);
let delayed_function_annotations = select l.id as id, l.file as file from function_annotations as l join function_annotation_hits as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.point;
let fresh_function_annotations = antijoin(left=function_annotations, right=delayed_function_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_events = select id as occurrence, name, scope, ordinal, kind, file from fresh_function_annotations;
let ordinary_events = select occurrence, name, scope, ordinal, kind, file from namespace_events;
let target_events = union(left=ordinary_events, right=annotation_events);
let global_redirect_scopes = select scope as redirect_scope, name, file from redirect_namespaces where kind = "global";
let target_scope_names = select context, lookup_scope, name, file from context_names where stage > 1;
let global_chain_scopes = select l.context as context, l.lookup_scope as redirect_scope, l.name as name, l.file as file from target_scope_names as l join global_redirect_scopes as r on l.lookup_scope = r.redirect_scope and l.name = r.name and l.file = r.file;
let global_skipped0 = select l.context as context, r.destination as lookup_scope, l.name as name, l.file as file from global_chain_scopes as l join scope_paths as r on l.redirect_scope = r.origin and l.file = r.file;
let skipped_modules = select id, file from nodes where kind = "module";
let global_skipped_modules = select l.context as context, l.lookup_scope as lookup_scope, l.name as name, l.file as file from global_skipped0 as l join skipped_modules as r on l.lookup_scope = r.id and l.file = r.file;
let global_skipped = antijoin(left=global_skipped0, right=global_skipped_modules, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let linear_names0 = select context, lookup_scope, name, point, expression, file from context_names where stage = 2 and point < 2147483647;
let linear_names1 = antijoin(left=linear_names0, right=global_skipped, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let own_delete_names0 = select context, lookup_scope, name, point, expression, file from context_names where stage = 3 and lookup_scope = initial_scope;
let own_delete_names = antijoin(left=own_delete_names0, right=global_skipped, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let streamed_names = union(left=linear_names1, right=own_delete_names);
let stream_groups = select lookup_scope as scope, name, file from streamed_names;
let group_events = select e.occurrence as occurrence, e.name as name, e.scope as scope, e.ordinal as ordinal, e.kind as kind, e.file as file from target_events as e join stream_groups as g on e.scope = g.scope and e.name = g.name and e.file = g.file;
let event_stream0 = select scope, scope as phase, name, file, ordinal from group_events;
let event_points = select scope as lookup_scope, name, file, ordinal as point from group_events;
let absent_delete_names = antijoin(left=own_delete_names, right=event_points, left-on=["lookup_scope", "name", "file", "point"], right-on=["lookup_scope", "name", "file", "point"]);
let present_delete_names = antijoin(left=own_delete_names, right=absent_delete_names, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let probed_names = union(left=linear_names1, right=absent_delete_names);
let read_probes = select lookup_scope as scope, lookup_scope as phase, name, file, point as ordinal from probed_names;
let latest_ends = latest_before(events=event_stream0, probes=read_probes);
let read_starts = select scope as lookup_scope, name, file, point, event_ordinal as start from latest_ends;
let event_pairs = ordered-match(left=event_stream0, right=event_stream0, left-on=[scope,name,file], right-on=[scope,name,file], left-order="ordinal", right-order="ordinal", output={scope:[left,scope], name:[left,name], file:[left,file], before:[left,ordinal], at:[right,ordinal]});
let delete_starts = select l.lookup_scope as lookup_scope, l.name as name, l.file as file, l.point as point, r.before as start from present_delete_names as l join event_pairs as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file and l.point = r.at;
let probe_starts = union(left=read_starts, right=delete_starts);
let restorable_cleanups = select i.scope as scope, i.name as name, i.file as file, i.finish as node, p.before as target from handler_intervals as i join event_pairs as p on i.scope = p.scope and i.name = p.name and i.file = p.file and i.begin = p.at;
let plain_nodes = select scope, name, file, ordinal as node from group_events where kind != "cleanup";
let self_nodes = select scope, name, file, node from plain_nodes;
let self_pointers = select scope, name, file, node, node as target from self_nodes;
let event_pointer_rows0 = union(left=self_pointers, right=restorable_cleanups);
let event_pointer_rows = select scope, scope as phase, name, file, node, target from event_pointer_rows0;
let resolved_pointers = resolve_pointers(pointers=event_pointer_rows);
let linear_event_ends = select l.lookup_scope as lookup_scope, l.name as name, l.file as file, l.point as point, l.start as start, r.target as final from probe_starts as l join resolved_pointers as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file and l.start = r.node;
let handled_names = select context, lookup_scope, name, file from streamed_names;
let linear_event_rows = select occurrence as definition, scope, name, ordinal, kind, file from group_events;
let linear_event_hits = select l.lookup_scope as lookup_scope, l.name as name, l.file as file, l.point as point, l.start as start, r.definition as definition, r.ordinal as ordinal, r.kind as kind from linear_event_ends as l join linear_event_rows as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file and l.final = r.ordinal;
let linear_resolved = select l.context as context, l.expression as expression, r.definition as definition, l.name as name, l.lookup_scope as lookup_scope, r.ordinal as ordinal, r.kind as kind, r.start as start, l.point as point, l.file as file from streamed_names as l join linear_event_hits as r on l.lookup_scope = r.lookup_scope and l.name = r.name and l.file = r.file and l.point = r.point;
let linear_plain = select context, lookup_scope, name, file, definition from linear_resolved where (kind = "global" or kind = "nonlocal") and start = ordinal;
let linear_kept = antijoin(left=linear_resolved, right=linear_plain, left-on=["context", "lookup_scope", "name", "file", "definition"], right-on=["context", "lookup_scope", "name", "file", "definition"]);
let linear_last = select context, name, file, lookup_scope, expression, definition, ordinal, kind from linear_kept;
let fallback_names = antijoin(left=target_scope_names, right=handled_names, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let type_lookup_scopes = union(left=outer_lookup_scopes, right=self_lookup_scopes);
let own_type_context_names = select l.stage as stage, l.header_point as header_point, l.initial_scope as initial_scope, l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from type_lookup_scopes as l join root_names as r on l.context = r.expression and l.file = r.file;
let type_context_names = select stage, header_point, initial_scope, context, point, file, lookup_scope, expression, name from own_type_context_names;
let old_path_declaration_names = select lookup_scope as scope, name, file from declaration_context_names;
let old_path_fallback_names = select lookup_scope as scope, name, file from fallback_names;
let old_path_type_names = select lookup_scope as scope, name, file from type_context_names where stage < 2;
let old_path_names0 = union(left=old_path_declaration_names, right=old_path_fallback_names);
let old_path_names = union(left=old_path_names0, right=old_path_type_names);
let handler_intervals_old = select h.handler as handler, h.name as name, h.scope as scope, h.file as file, h.finish as finish, h.begin as begin from handler_intervals as h join old_path_names as n on h.scope = n.scope and h.name = n.name and h.file = n.file;
let target_context_rows0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, l.point as point, l.stage as stage, l.initial_scope as initial_scope from context_names as l join fallback_names as r on l.context = r.context and l.lookup_scope = r.lookup_scope and l.name = r.name and l.file = r.file;
let target_context_rows = select context, name, file, lookup_scope, expression, point, stage, initial_scope from target_context_rows0 where stage > 1;
let target_candidates = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, l.point as point, l.stage as stage, l.initial_scope as initial_scope, r.occurrence as definition, r.ordinal as ordinal, r.kind as kind from target_context_rows as l join target_events as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (l.stage != 3 or r.occurrence != l.context and l.lookup_scope = l.initial_scope);
let redirect_candidates = select context, lookup_scope, name, file, definition, ordinal, point from target_candidates where kind = "global" or kind = "nonlocal";
let finished_after_redirect = select l.context as context, l.lookup_scope as lookup_scope, l.name as name, l.file as file, l.definition as definition from redirect_candidates as l join handler_intervals_old as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.begin > l.ordinal and r.finish <= l.point;
let plain_redirects = antijoin(left=redirect_candidates, right=finished_after_redirect, left-on=["context", "lookup_scope", "name", "file", "definition"], right-on=["context", "lookup_scope", "name", "file", "definition"]);
let target_visible0 = antijoin(left=target_candidates, right=global_skipped, left-on=["context", "lookup_scope", "name", "file"], right-on=["context", "lookup_scope", "name", "file"]);
let target_visible = antijoin(left=target_visible0, right=plain_redirects, left-on=["context", "lookup_scope", "name", "file", "definition"], right-on=["context", "lookup_scope", "name", "file", "definition"]);
let target_preceding_bindings = select context, name, file, lookup_scope, expression, definition, ordinal, kind from target_visible;
let ordinary_preceding_bindings = union(left=declaration_preceding_bindings, right=target_preceding_bindings);
let all_type_events = select l.id as id, l.name as name, r.owner as owner, r.id as root, l.ordinal as ordinal, l.file as file from nearest_evaluations as l join type_scope_roots as r on l.related = r.id and l.file = r.file;
let active_type_events = select l.id as id, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from all_type_events as l join active_initial_type_roots as r on l.root = r.id and l.file = r.file;
let current_type_contexts = select * from type_context_names where stage = 0;
let deferred_type_contexts = select * from type_context_names where stage = 1;
let current_type_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from current_type_contexts as l join active_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let deferred_type_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from deferred_type_contexts as l join all_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (r.owner != l.initial_scope or r.ordinal <= l.header_point);
let type_bindings0 = union(left=current_type_bindings0, right=deferred_type_bindings0);
let type_bindings = extend(from=type_bindings0, values={kind: "bind"});
let all_preceding_bindings = union(left=ordinary_preceding_bindings, right=type_bindings);
let restorable_handlers = select l.handler as handler, l.name as name, l.scope as scope, l.file as file, l.begin as begin, l.finish as finish from handler_intervals_old as l join namespace_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.begin;
let handler_context_names0 = select context, lookup_scope, name, point, file from context_names;
let handler_context_names1 = select context, lookup_scope, name, point, file from type_context_names;
let handler_context_names = union(left=handler_context_names0,right=handler_context_names1);
let finished_context_handlers = select l.context as context, l.file as file, r.name as name, r.scope as scope, r.begin as begin, r.finish as finish from handler_context_names as l join restorable_handlers as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.finish <= l.point;
let restored_handler_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.ordinal as ordinal, l.file as file from all_preceding_bindings as l join finished_context_handlers as r on l.context = r.context and l.file = r.file and l.lookup_scope = r.scope and l.name = r.name where l.ordinal >= r.begin and l.ordinal <= r.finish;
let preceding_bindings = antijoin(left=all_preceding_bindings,right=restored_handler_bindings,left-on=["context","expression","definition","ordinal","file"],right-on=["context","expression","definition","ordinal","file"]);
let older_bindings = ordered-match(left=preceding_bindings, right=preceding_bindings, left-on=[context,expression,lookup_scope,file], right-on=[context,expression,lookup_scope,file], left-order="ordinal", right-order="ordinal", output={context:[left,context], expression:[left,expression], definition:[left,definition], file:[left,file]});
let unadjusted_last_bindings = antijoin(left=preceding_bindings,right=older_bindings,left-on=["context","expression","definition","file"],right-on=["context","expression","definition","file"]);
let late_deletion_events = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, l.file as file from unadjusted_last_bindings as l join ordered_contexts as r on l.context = r.context and l.file = r.file where r.stage = 1 and l.kind = "delete";
let deletion_reference_locations = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, r."start-byte" as reference_start, l.file as file from late_deletion_events as l join "source-location" as r on l.expression = r.id and l.file = r.file;
let forward_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, l.file as file from deletion_reference_locations as l join "source-location" as r on l.definition = r.id and l.file = r.file where l.reference_start < r."start-byte";
let shadowed_event_options = select l.context as context, l.expression as expression, l.definition as deletion, l.name as name, l.lookup_scope as lookup_scope, r.definition as definition, r.ordinal as ordinal, r.kind as kind, l.file as file from forward_deletions as l join preceding_bindings as r on l.context = r.context and l.expression = r.expression and l.lookup_scope = r.lookup_scope and l.file = r.file where r.ordinal < l.ordinal;
let older_shadowed_options = select l.context as context, l.expression as expression, l.deletion as deletion, l.definition as definition, l.file as file from shadowed_event_options as l join shadowed_event_options as r on l.context = r.context and l.expression = r.expression and l.deletion = r.deletion and l.file = r.file where l.ordinal < r.ordinal;
let shadowed_events = antijoin(left=shadowed_event_options, right=older_shadowed_options, left-on=["context", "expression", "deletion", "definition", "file"], right-on=["context", "expression", "deletion", "definition", "file"]);
let restored_bindings = select context, name, file, lookup_scope, expression, definition, ordinal, kind from shadowed_events where kind = "bind";
let restored_deletions = select context, expression, deletion as definition, file from shadowed_events where kind = "bind";
let unshadowed_deletions = antijoin(left=forward_deletions, right=shadowed_event_options, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "deletion", "file"]);
let module_scope_nodes = select id, file from nodes where kind = "module";
let module_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.file as file from unshadowed_deletions as l join module_scope_nodes as r on l.lookup_scope = r.id and l.file = r.file;
let implicit_builtins = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let restored_builtin_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from module_deletions as l join implicit_builtins as r on l.name = r.name and l.file = r.file;
let ignored_deletions = union(left=restored_deletions, right=restored_builtin_deletions);
let unchanged_last_bindings = antijoin(left=unadjusted_last_bindings, right=ignored_deletions, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "definition", "file"]);
let declared_last_bindings = union(left=unchanged_last_bindings, right=restored_bindings);
let last_bindings = union(left=declared_last_bindings, right=linear_last);
let competing_scopes = select l.context as context, l.expression as expression, l.definition as definition, l.lookup_scope as farther, r.lookup_scope as closer, l.file as file from last_bindings as l join last_bindings as r on l.context = r.context and l.expression = r.expression and l.file = r.file where l.lookup_scope != r.lookup_scope;
let farther_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.farther as lookup_scope, l.file as file from competing_scopes as l join scope_paths as r on l.closer = r.origin and l.farther = r.destination and l.file = r.file;
let nearest_bindings = antijoin(left=last_bindings,right=farther_bindings,left-on=["context","expression","definition","lookup_scope","file"],right-on=["context","expression","definition","lookup_scope","file"]);
let results = select context, expression, definition as occurrence, lookup_scope as scope, kind, file from nearest_bindings;
return results;
