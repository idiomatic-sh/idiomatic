import assigned_values from "python/ruff/assigned-values";
import io_base_annotation from "python/ruff/io-base-annotation";
input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let assigned = assigned_values();
let requested_calls = select l.id as id, l.file as file from expressions as l join calls as r on l.id = r.id and l.file = r.file;
let function_fields = select parent, child, file from "semantic-child" where field = "func";
let functions = select l.id as call, r.child as function, l.file as file from requested_calls as l join function_fields as r on l.id = r.parent and l.file = r.file;
let attribute_functions = select l.call as call, l.function as attribute, l.file as file from functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let labels0 = select l.call as call, l.attribute as attribute, r.child as label, l.file as file from attribute_functions as l join attr_fields as r on l.attribute = r.parent and l.file = r.file;
let open_attributes = select l.call as call, l.attribute as attribute, l.file as file from labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "open";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let receivers = select l.call as call, r.child as receiver, l.file as file from open_attributes as l join value_fields as r on l.attribute = r.parent and l.file = r.file;
let constructed_receivers = select l.call as call, l.receiver as receiver, l.file as file from receivers as l join calls as r on l.receiver = r.id and l.file = r.file;
let constructors = select l.call as call, r.child as constructor, l.file as file from constructed_receivers as l join function_fields as r on l.receiver = r.parent and l.file = r.file;
let called_expressions = select function as id, file from functions;
let constructed_expressions = select constructor as id, file from constructors;
let assigned_expressions = select value as id, file from assigned;
let expression_rows0 = union(left=called_expressions, right=constructed_expressions);
let expression_rows = union(left=expression_rows0, right=assigned_expressions);
let candidate_ids = group-count(from=expression_rows, keys=["id","file"], count="count");
let callable_expressions = select id, file from candidate_ids;
let attr_value_edges = select l.id as parent, r.child as child, l.file as file from attributes as l join value_fields as r on l.id = r.parent and l.file = r.file;
let head_axes = axis(from=callable_expressions, relation=attr_value_edges, direction=descendant, domain=names);
let nested_heads = select id as expression, related as head, file from head_axes;
let direct_heads = select l.id as expression, l.id as head, l.file as file from callable_expressions as l join names as r on l.id = r.id and l.file = r.file;
let heads = union(left=direct_heads, right=nested_heads);
let builtin_reads = select reference as head, file from "binding-read" where state = "builtin";
let builtin_open_names = select l.id as head, l.file as file from names as l join "identifier" as r on l.id = r.id and l.file = r.file where r.name = "open";
let builtin_open = select l.head as id, l.file as file from builtin_open_names as l join builtin_reads as r on l.head = r.head and l.file = r.file;
let builtin_rows = extend(from=builtin_open, values={path:"builtins.open"});
let builtin_origins = select id, path, file from builtin_rows;
let unique_import_reads = select l.reference as head, r.occurrence as binding, l.file as file from "binding-use" as l join "static-import" as r on l.binding = r.occurrence and l.file = r.file where l.certainty = "unique";
let imported_expressions = select l.expression as id, l.file as file from heads as l join unique_import_reads as r on l.head = r.head and l.file = r.file;
let imported_origins = select l.id as id, r.path as path, l.file as file from imported_expressions as l join "qualified-name" as r on l.id = r.id and l.file = r.file;
let origins = union(left=builtin_origins, right=imported_origins);
let factory_origins = select id, file from origins where path = "builtins.open" or path = "io.open" or path = "io.open_code" or path = "os.fdopen" or path = "io.IOBase" or path = "io.RawIOBase" or path = "io.BufferedIOBase" or path = "io.TextIOBase" or path = "io.BytesIO" or path = "io.StringIO" or path = "io.BufferedReader" or path = "io.BufferedWriter" or path = "io.BufferedRandom" or path = "io.BufferedRWPair" or path = "io.TextIOWrapper" or path = "io.FileIO";
let direct = select l.call as id, l.file as file from functions as l join factory_origins as r on l.function = r.id and l.file = r.file;
let path_origins = select l.call as id, l.file as file, r.path as path from constructors as l join origins as r on l.constructor = r.id and l.file = r.file;
let paths = select id, file from path_origins where path = "pathlib.Path" or path = "pathlib.PosixPath" or path = "pathlib.WindowsPath";
let direct_factories = union(left=direct, right=paths);
let return_fields = select parent as owner, child as annotation, file from "semantic-child" where field = "returns";
let annotations = select annotation as id, file from return_fields;
let io_annotations = io_base_annotation(annotations=annotations);
let io_returns = select l.owner as binding, l.file as file from return_fields as l join io_annotations as r on l.annotation = r.id and l.file = r.file;
let sync_definitions = select id, file from "semantic-syntax" where kind = "function-def";
let callable_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "class-def";
let callable_body_roots = select l.id as owner, r.child as id, l.file as file from callable_scopes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let yielding_expressions = select id, file from "semantic-syntax" where kind = "yield" or kind = "yield-from";
let root_yield_owners = select l.id as id, r.owner as owner, l.file as file from yielding_expressions as l join callable_body_roots as r on l.id = r.id and l.file = r.file;
let interior_yields = antijoin(left=yielding_expressions, right=callable_body_roots, left-on=["id","file"], right-on=["id","file"]);
let yield_body_ancestors = axis(from=interior_yields, relation="semantic-child", direction=nearest-ancestor, domain=callable_body_roots);
let interior_yield_owners = select l.id as id, r.owner as owner, l.file as file from yield_body_ancestors as l join callable_body_roots as r on l.related = r.id and l.file = r.file;
let yield_owners = union(left=root_yield_owners, right=interior_yield_owners);
let generator_functions = select owner as id, file from yield_owners;
let ordinary_sync_definitions = antijoin(left=sync_definitions, right=generator_functions, left-on=["id","file"], right-on=["id","file"]);
let annotated_functions = select l.binding as binding, l.file as file from io_returns as l join ordinary_sync_definitions as r on l.binding = r.id and l.file = r.file;
let factory_aliases = select l.binding as binding, l.file as file from assigned as l join factory_origins as r on l.value = r.id and l.file = r.file;
let typed_functions = union(left=annotated_functions, right=factory_aliases);
let named_functions = select l.call as call, l.function as reference, l.file as file from functions as l join names as r on l.function = r.id and l.file = r.file;
let callee_bindings = select l.call as call, r.binding as binding, l.file as file from named_functions as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let alias_values = select l.binding as binding, l.value as reference, l.file as file from assigned as l join names as r on l.value = r.id and l.file = r.file;
let aliases = select l.binding as source, r.binding as destination, l.file as file from alias_values as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let alias_paths = closure(edges=aliases, source="source", destination="destination", keys=["file"]);
let indirect_bindings = select l.call as call, r.destination as binding, l.file as file from callee_bindings as l join alias_paths as r on l.binding = r.source and l.file = r.file;
let all_bindings = union(left=callee_bindings, right=indirect_bindings);
let alias_sources = select source as binding, file from aliases;
let terminals = antijoin(left=all_bindings, right=alias_sources, left-on=["binding","file"], right-on=["binding","file"]);
let unknown_terminals = antijoin(left=terminals, right=typed_functions, left-on=["binding","file"], right-on=["binding","file"]);
let unknown_calls = select call, file from unknown_terminals;
let typed_calls = select l.call as id, l.file as file from all_bindings as l join typed_functions as r on l.binding = r.binding and l.file = r.file;
let known_call_results = antijoin(left=typed_calls, right=unknown_calls, left-on=["id","file"], right-on=["call","file"]);
let results = union(left=direct_factories, right=known_call_results);
let unique_results = group-count(from=results, keys=["id","file"], count="count");
let known_expressions = select id, file from unique_results;
return known_expressions;
