import annotation_context from "python/ruff/annotation-evaluation-context";
import decisions_of from "python/ruff/lookup-read-events";
input reads: relation<id: node, name: symbol, scope: node, phase: node, file: file>;
output relation<id: node, file: file>;
let replay_reads = select id, name, scope, file from reads;
let builtin_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let annotation_inputs = select id, file from replay_reads;
let annotation_contexts = annotation_context(expressions=annotation_inputs);
let eager_annotation_ids = select id, file from annotation_contexts where evaluation = "eager" and matches(file, "[.]py$");
let eager_reads = select l.id as id, l.name as name, l.scope as scope, l.file as file from replay_reads as l join eager_annotation_ids as r on l.id = r.id and l.file = r.file;
let events = select occurrence as id, ordinal, kind, file from "binding-event";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let arguments = select id, file from "semantic-syntax" where kind = "arg";
let argument_annotations = select r.child as id, l.file as file from arguments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let argument_owners = axis(from=argument_annotations, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let argument_roots = select id, related as owner, file from argument_owners;
let return_roots = select r.child as id, l.id as owner, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let signature_roots = union(left=argument_roots, right=return_roots);
let signature_root_ids = select id, file from signature_roots;
let signature_axes = axis(from=eager_reads, relation="semantic-child", direction=ancestor, domain=signature_root_ids);
let nested_signature_reads = select l.id as id, r.owner as owner, l.file as file from signature_axes as l join signature_roots as r on l.related = r.id and l.file = r.file;
let direct_signature_reads = select l.id as id, r.owner as owner, l.file as file from eager_reads as l join signature_roots as r on l.id = r.id and l.file = r.file;
let signature_reads = union(left=nested_signature_reads, right=direct_signature_reads);
let signature_points = select l.id as reference, r.ordinal as point, l.file as file from signature_reads as l join events as r on l.owner = r.id and l.file = r.file where r.kind = "bind";
let assignments = select id, file from "semantic-syntax" where kind = "ann-assign";
let variable_roots = select r.child as id, l.id as owner, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let variable_axes = axis(from=eager_reads, relation="semantic-child", direction=ancestor, domain=variable_roots);
let nested_variable_reads = select l.id as id, r.owner as owner, l.file as file from variable_axes as l join variable_roots as r on l.related = r.id and l.file = r.file;
let direct_variable_reads = select l.id as id, r.owner as owner, l.file as file from eager_reads as l join variable_roots as r on l.id = r.id and l.file = r.file;
let variable_reads = union(left=nested_variable_reads, right=direct_variable_reads);
let stored_roots = select r.child as id, l.id as owner, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target" or r.field = "value";
let stored_axes = axis(from=stored_roots, relation="semantic-child", direction=descendant, domain=events);
let nested_stored_events = select l.related as id, r.owner as owner, l.file as file from stored_axes as l join stored_roots as r on l.id = r.id and l.file = r.file;
let direct_stored_events = select l.id as id, r.owner as owner, l.file as file from events as l join stored_roots as r on l.id = r.id and l.file = r.file;
let stored_events = union(left=nested_stored_events, right=direct_stored_events);
let stored_points = select l.owner as owner, r.ordinal as point, l.file as file from stored_events as l join events as r on l.id = r.id and l.file = r.file;
let later_stored_points = select l.owner as owner, l.point as point, l.file as file from stored_points as l join stored_points as r on l.owner = r.owner and l.file = r.file where r.point < l.point;
let first_stored_points = antijoin(left=stored_points, right=later_stored_points, left-on=["owner", "point", "file"], right-on=["owner", "point", "file"]);
let variable_points = select l.id as reference, r.point as point, l.file as file from variable_reads as l join first_stored_points as r on l.owner = r.owner and l.file = r.file;
let definition_points = union(left=signature_points, right=variable_points);
let decisions = decisions_of(reads=definition_points);
let answers = select reference, event, kind, scope, depth, file from decisions where via != "declaration";
let farther_answers = select l.reference as reference, l.depth as depth, l.file as file from answers as l join answers as r on l.reference = r.reference and l.file = r.file where r.depth < l.depth;
let nearest_answers = antijoin(left=answers, right=farther_answers, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let eager_bound = select l.id as id, l.file as file from eager_reads as l join nearest_answers as r on l.id = r.reference and l.file = r.file where r.kind = "bind";
let eager_unbound = antijoin(left=eager_reads, right=eager_bound, left-on=["id", "file"], right-on=["id", "file"]);
let eager_answered = select l.id as id, l.file as file from eager_unbound as l join nearest_answers as r on l.id = r.reference and l.file = r.file;
let eager_unanswered = antijoin(left=eager_unbound, right=eager_answered, left-on=["id", "file"], right-on=["id", "file"]);
let eager_builtins = select l.id as id, l.file as file from eager_unanswered as l join builtin_names as r on l.name = r.name and l.file = r.file;
let eager_without_builtins = antijoin(left=eager_unbound, right=eager_builtins, left-on=["id", "file"], right-on=["id", "file"]);
let eager_points = select l.id as id, l.scope as scope, r.point as point, l.file as file from eager_without_builtins as l join definition_points as r on l.id = r.reference and l.file = r.file;
let scope_edges = select child as child, parent as parent, file from "scope";
let scope_paths = closure(edges=scope_edges, source="child", destination="parent", keys=["file"]);
let eager_outer_scopes = select l.id as id, r.parent as scope, l.point as point, l.file as file from eager_points as l join scope_paths as r on l.scope = r.child and l.file = r.file;
let eager_scopes = union(left=eager_points, right=eager_outer_scopes);
let wildcard_events = select scope, ordinal, file from "binding-event" where kind = "wildcard";
let wildcard_masked = select l.id as id, l.file as file from eager_scopes as l join wildcard_events as r on l.scope = r.scope and l.file = r.file where r.ordinal < l.point;
let eager_missing0 = select id, file from eager_without_builtins;
let eager_missing = antijoin(left=eager_missing0, right=wildcard_masked, left-on=["id", "file"], right-on=["id", "file"]);
return eager_missing;
