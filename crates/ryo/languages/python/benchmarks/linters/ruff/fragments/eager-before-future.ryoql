import annotation_context from "python/ruff/annotation-evaluation-context";
import lookup_events from "python/ruff/lookup-read-events";
input reads: relation<id: node, name: symbol, scope: node, phase: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let modules = select id, file from nodes where kind = "module";
let events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event";
let locations = select id, "start-byte" as start, file from "source-location";
let annotation_inputs = select id, file from reads;
let annotation_contexts = annotation_context(expressions=annotation_inputs);
let eager_annotation_ids = select id, file from annotation_contexts where evaluation = "eager";
let runtime_reads = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file from reads as l join eager_annotation_ids as r on l.id = r.id and l.file = r.file where matches(l.file, "[.]py$");
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let arguments = select id, file from nodes where kind = "arg";
let annotation_roots = select l.id as parameter, r.child as id, l.file as file from arguments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let annotation_axes = axis(from=annotation_roots, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let parameter_roots = select id, related as function, file from annotation_axes;
let return_roots = select r.child as id, l.id as function, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let roots = union(left=parameter_roots, right=return_roots);
let root_nodes = select id, file from roots;
let reference_axes = axis(from=runtime_reads, relation="semantic-child", direction=ancestor, domain=root_nodes);
let nested_annotations = select l.id as id, r.function as function, l.file as file from reference_axes as l join roots as r on l.related = r.id and l.file = r.file;
let direct_annotations = select l.id as id, r.function as function, l.file as file from runtime_reads as l join roots as r on l.id = r.id and l.file = r.file;
let early_function_annotations = union(left=nested_annotations, right=direct_annotations);
let function_points0 = select l.id as id, l.function as function, r.ordinal as bind_point, l.file as file from early_function_annotations as l join events as r on l.function = r.id and l.file = r.file where r.kind = "bind";
let assignments = select id, file from nodes where kind = "ann-assign";
let variable_roots = select r.child as id, l.id as assignment, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let variable_axes = axis(from=runtime_reads, relation="semantic-child", direction=ancestor, domain=variable_roots);
let nested_variables = select l.id as id, r.assignment as assignment, l.file as file from variable_axes as l join variable_roots as r on l.related = r.id and l.file = r.file;
let direct_variables = select l.id as id, r.assignment as assignment, l.file as file from runtime_reads as l join variable_roots as r on l.id = r.id and l.file = r.file;
let variable_annotations = union(left=nested_variables, right=direct_variables);
let eager_variable_reads = select id, file from runtime_reads;
let eager_variables = select l.id as id, l.assignment as assignment, l.file as file from variable_annotations as l join eager_variable_reads as r on l.id = r.id and l.file = r.file;
let after_variable_roots = select r.child as id, l.id as assignment, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target" or r.field = "value";
let after_variable_axes = axis(from=after_variable_roots, relation="semantic-child", direction=descendant, domain=events);
let after_nested_events = select l.related as id, r.assignment as assignment, l.file as file from after_variable_axes as l join after_variable_roots as r on l.id = r.id and l.file = r.file;
let after_direct_events = select l.id as id, r.assignment as assignment, l.file as file from events as l join after_variable_roots as r on l.id = r.id and l.file = r.file;
let after_variable_events = union(left=after_nested_events, right=after_direct_events);
let variable_event_points = select l.id as id, l.assignment as assignment, r.ordinal as point, l.file as file from after_variable_events as l join events as r on l.id = r.id and l.file = r.file;
let not_first_variable_events = select l.id as id, l.assignment as assignment, l.file as file from variable_event_points as l join variable_event_points as r on l.assignment = r.assignment and l.file = r.file where r.point < l.point;
let first_variable_events = antijoin(left=variable_event_points, right=not_first_variable_events, left-on=["id", "assignment", "file"], right-on=["id", "assignment", "file"]);
let variable_points = select l.id as id, r.id as function, r.point as bind_point, l.file as file from eager_variables as l join first_variable_events as r on l.assignment = r.assignment and l.file = r.file;
let variable_annotation_rows = select id, function, file from variable_points;
let early_annotations = union(left=early_function_annotations, right=variable_annotation_rows);
let function_points = union(left=function_points0, right=variable_points);
let previous_points = select l.id as id, l.function as function, r.ordinal as point, l.file as file from function_points as l join events as r on l.file = r.file where r.ordinal < l.bind_point;
let older_points = select l.id as id, l.point as point, l.file as file from previous_points as l join previous_points as r on l.id = r.id and l.file = r.file where l.point < r.point;
let predecessor_points = antijoin(left=previous_points, right=older_points, left-on=["id", "point", "file"], right-on=["id", "point", "file"]);
let no_predecessor = antijoin(left=function_points, right=previous_points, left-on=["id", "file"], right-on=["id", "file"]);
let first_points = select id, function, bind_point as point, file from no_predecessor;
let points = union(left=predecessor_points, right=first_points);
let context_points = select l.id as context, r.scope as initial_scope, l.point as point, l.point as header_point, l.file as file from points as l join reads as r on l.id = r.id and l.file = r.file;
let context_rows = extend(from=context_points, values={stage: 0});
let contexts = select context, initial_scope, point, header_point, stage, file from context_rows;
let expressions = select id, file from early_annotations;
let resolutions = lookup_events(ordered_contexts=contexts, expressions=expressions);
let own_resolutions = select context as id, occurrence, kind, file from resolutions where context = expression;
let first_self_resolutions = select l.id as id, l.occurrence as occurrence, l.file as file from own_resolutions as l join no_predecessor as r on l.id = r.id and l.occurrence = r.function and l.file = r.file;
let visible_resolutions = antijoin(left=own_resolutions, right=first_self_resolutions, left-on=["id", "occurrence", "file"], right-on=["id", "occurrence", "file"]);
let bound = select id, file from visible_resolutions where kind = "bind";
let without_bindings = antijoin(left=early_annotations, right=bound, left-on=["id", "file"], right-on=["id", "file"]);
let no_local_events = antijoin(left=without_bindings, right=visible_resolutions, left-on=["id", "file"], right-on=["id", "file"]);
let unbound_names = select l.id as id, r.name as name, l.file as file from no_local_events as l join reads as r on l.id = r.id and l.file = r.file;
let builtin_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let builtins = select l.id as id, l.file as file from unbound_names as l join builtin_names as r on l.name = r.name and l.file = r.file;
let no_builtins = antijoin(left=without_bindings, right=builtins, left-on=["id", "file"], right-on=["id", "file"]);
let scopes = select child as child, parent as parent, file from "scope";
let scope_paths = closure(edges=scopes, source="child", destination="parent", keys=["file"]);
let reference_scopes = select l.id as id, r.scope as scope, l.point as point, l.file as file from points as l join reads as r on l.id = r.id and l.file = r.file;
let inherited_scopes = select l.id as id, r.parent as scope, l.point as point, l.file as file from reference_scopes as l join scope_paths as r on l.scope = r.child and l.file = r.file;
let all_scopes = union(left=reference_scopes, right=inherited_scopes);
let wildcard_masked = select l.id as id, l.file as file from all_scopes as l join events as r on l.scope = r.scope and l.file = r.file where r.kind = "wildcard" and r.ordinal <= l.point;
let result = select l.id as id, l.file as file from no_builtins as l;
let unmasked = antijoin(left=result, right=wildcard_masked, left-on=["id", "file"], right-on=["id", "file"]);
return unmasked;
