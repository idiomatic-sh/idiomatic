import nearest_read_lookup from "python/ruff/nearest-read-lookup";
import type_root_binds from "python/ruff/type-root-binds";
output relation<reference: node, file: file>;
let read_lookup = nearest_read_lookup();
let resolution = select reference, event, kind, namespace, file from read_lookup;
let held_annotation = select reference, file from resolution where kind = "annotation";
let held_delete = select reference, file from resolution where kind = "delete";
let held_cleanup = select reference, file from resolution where kind = "cleanup";
let held_global = select reference, file from resolution where kind = "global";
let held_nonlocal = select reference, file from resolution where kind = "nonlocal";
let held_none = select reference, file from resolution where kind = "none";
let held_routed = select reference, file from resolution where namespace = "routed";
let header_binds = type_root_binds();
let held_header = select r.reference as reference, r.file as file from header_binds as l join resolution as r on l.id = r.event and l.file = r.file;
let held0 = union(left=held_annotation, right=held_delete);
let held1 = union(left=held0, right=held_cleanup);
let held2 = union(left=held1, right=held_global);
let held3 = union(left=held2, right=held_nonlocal);
let held4 = union(left=held3, right=held_none);
let held5 = union(left=held4, right=held_routed);
let suspect_reads = union(left=held5, right=held_header);
return suspect_reads;
