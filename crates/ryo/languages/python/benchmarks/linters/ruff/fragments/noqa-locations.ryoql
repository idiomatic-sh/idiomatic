input candidates: relation<id: node, file: file, span: span, line: number>;
input mappings: relation<id: node, file: file, line: number, endline: number>;
output relation<id: node, file: file, span: span, line: number>;
let candidate_locations = select id, file, span, line from candidates;
let mapped_candidates = select l.id as id, l.file as file, l.span as span, r.endline as line from candidate_locations as l join mappings as r on l.file = r.file where l.line >= r.line and l.line <= r.endline;
let smaller_candidates = select l.id as id, l.span as span, l.line as line from mapped_candidates as l join mapped_candidates as r on l.id = r.id and l.span = r.span where l.line < r.line;
let remapped_locations = antijoin(left=mapped_candidates, right=smaller_candidates, left-on=["id", "span", "line"], right-on=["id", "span", "line"]);
let unchanged_locations = antijoin(left=candidate_locations, right=remapped_locations, left-on=["id", "span"], right-on=["id", "span"]);
let located = union(left=unchanged_locations, right=remapped_locations);
return located;
