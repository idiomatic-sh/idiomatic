input contexts: relation<context: node, sequence: symbol, index: symbol, value: symbol, file: file>;
input starts: relation<context: node, entry: node, destination: node, position: number, file: file>;
output relation<id: node, context: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let all_children = select parent, child, field, ordinal, file from "semantic-child";
let embedded_roots = select root as id, file from "embedded-expression";
let children = antijoin(left=all_children, right=embedded_roots, left-on=["child","file"], right-on=["id","file"]);
let special_statements = select id, kind, file from nodes where kind = "assign" or kind = "ann-assign" or kind = "aug-assign" or kind = "delete";
let ordinary_children = antijoin(left=children, right=special_statements, left-on=["parent","file"], right-on=["id","file"]);
let special_children = select l.parent as parent, l.child as child, l.field as field, l.ordinal as ordinal, l.file as file from children as l join special_statements as r on l.parent = r.id and l.file = r.file where l.field = "value" and r.kind != "delete";
let walk_children = union(left=ordinary_children, right=special_children);
let descendant_roots = select destination as id, context, file from starts;
let descendants = axis(from=descendant_roots, relation="semantic-child", direction=descendant, domain=nodes);
let descendants_rows = select l.context as context, l.file as file, r.related as source from descendant_roots as l join descendants as r on l.id = r.id and l.file = r.file;
let direct_rows = select context, file, destination as source from starts;
let reachable_rows = union(left=descendants_rows, right=direct_rows);
let inner_edges = select l.context as context, l.file as file, l.source as source, r.child as destination, r.child as edge, r.ordinal as position from reachable_rows as l join walk_children as r on l.source = r.parent and l.file = r.file;
let entry_edges = select context, file, entry as source, destination, destination as edge, position from starts;
let edges = union(left=inner_edges, right=entry_edges);
let roots = select context, file, entry from starts;
let visits = ordered-dfs(from=roots, root="entry", edges=edges, source="source", destination="destination", order="position", edge="edge", keys=["context","file"], output="visit");
let names = select id, file from nodes where kind = "name";
let named = select l.id as id, l.file as file, r.name as name from names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let values = select parent, child, file from children where field = "value";
let slices = select parent, child, file from children where field = "slice";
let subscript_values = select l.id as id, l.file as file, r.child as value from subscripts as l join values as r on l.id = r.parent and l.file = r.file;
let subscript_names = select l.id as id, l.file as file, r.name as sequence from subscript_values as l join named as r on l.value = r.id and l.file = r.file;
let subscript_slices = select l.id as id, l.file as file, l.sequence as sequence, r.child as slice from subscript_names as l join slices as r on l.id = r.parent and l.file = r.file;
let indexed_names = select l.id as id, l.file as file, l.sequence as sequence, r.name as index from subscript_slices as l join named as r on l.slice = r.id and l.file = r.file;
let matching_accesses = select l.context as context, l.file as file, r.id as id from contexts as l join indexed_names as r on l.sequence = r.sequence and l.index = r.index and l.file = r.file;
let visited_accesses = select l.destination as id, l.context as context, l.file as file, l.visit as visit from visits as l join matching_accesses as r on l.destination = r.id and l.context = r.context and l.file = r.file;
let targets = select parent, child, file from children where field = "target" or field = "targets";
let assign_targets = select l.id as statement, l.file as file, l.kind as kind, r.child as target from special_statements as l join targets as r on l.id = r.parent and l.file = r.file;
let without_values = antijoin(left=assign_targets, right=values, left-on=["statement","file"], right-on=["parent","file"]);
let skipped_annotations = select statement, file from without_values where kind = "ann-assign";
let live_targets = antijoin(left=assign_targets, right=skipped_annotations, left-on=["statement","file"], right-on=["statement","file"]);
let named_targets = select l.statement as statement, l.file as file, r.name as name from live_targets as l join named as r on l.target = r.id and l.file = r.file;
let name_mutations = select l.context as context, l.file as file, r.statement as statement from contexts as l join named_targets as r on l.file = r.file where r.name = l.sequence or r.name = l.index or r.name = l.value;
let subscript_targets = select l.statement as statement, l.file as file, r.id as id, r.sequence as sequence, r.index as index from live_targets as l join indexed_names as r on l.target = r.id and l.file = r.file;
let indexed_mutations = select l.context as context, l.file as file, r.statement as statement from contexts as l join subscript_targets as r on l.sequence = r.sequence and l.index = r.index and l.file = r.file;
let mutations = union(left=name_mutations, right=indexed_mutations);
let mutation_visits = select l.context as context, l.file as file, l.visit as visit from visits as l join mutations as r on l.destination = r.statement and l.context = r.context and l.file = r.file;
let blocked_accesses = select l.id as id, l.context as context, l.file as file from visited_accesses as l join mutation_visits as r on l.context = r.context and l.file = r.file where r.visit <= l.visit;
let surviving = antijoin(left=visited_accesses, right=blocked_accesses, left-on=["id","context","file"], right-on=["id","context","file"]);
let result = select id, context, file from surviving;
return result;
