input contexts: relation<context: node, sequence: symbol, index: symbol, value: symbol, file: file>;
input starts: relation<context: node, entry: node, destination: node, position: number, file: file>;
output relation<id: node, context: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let embedded_roots = select root as id, file from "embedded-expression";
let special_statements = select id, kind, file from nodes where kind = "assign" or kind = "ann-assign" or kind = "aug-assign" or kind = "delete";
let descendant_roots = select destination as id, context, file from starts;
let descendants = axis(from=descendant_roots, relation="semantic-child", direction=descendant, domain=nodes);
let descendants_rows = select l.context as context, l.file as file, r.related as source from descendant_roots as l join descendants as r on l.id = r.id and l.file = r.file;
let direct_rows = select context, file, destination as source from starts;
let reachable_rows = union(left=descendants_rows, right=direct_rows);
let reachable_all = select l.context as context, l.file as file, l.source as source, r.child as child, r.field as field, r.ordinal as ordinal from reachable_rows as l join "semantic-child" as r on l.source = r.parent and l.file = r.file;
let reachable_children = antijoin(left=reachable_all, right=embedded_roots, left-on=["child","file"], right-on=["id","file"]);
let reachable_ordinary = antijoin(left=reachable_children, right=special_statements, left-on=["source","file"], right-on=["id","file"]);
let reachable_special = select l.context as context, l.file as file, l.source as source, l.child as child, l.field as field, l.ordinal as ordinal from reachable_children as l join special_statements as r on l.source = r.id and l.file = r.file where l.field = "value" and r.kind != "delete";
let reachable_walk = union(left=reachable_ordinary, right=reachable_special);
let inner_edges = select context, file, source, child as destination, child as edge, ordinal as position from reachable_walk;
let entry_edges = select context, file, entry as source, destination, destination as edge, position from starts;
let edges = union(left=inner_edges, right=entry_edges);
let roots = select context, file, entry from starts;
let visits = ordered-dfs(from=roots, root="entry", edges=edges, source="source", destination="destination", order="position", edge="edge", keys=["context","file"], output="visit");
let visited_ids = select destination as id, file from visits;
let visited = project(from=visited_ids, columns=["id","file"]);
let visited_subscripts = select l.id as id, l.file as file from visited as l join nodes as r on l.id = r.id and l.file = r.file where r.kind = "subscript";
let subscript_value_edges = select l.id as id, l.file as file, r.child as value from visited_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let subscript_values = antijoin(left=subscript_value_edges, right=embedded_roots, left-on=["value","file"], right-on=["id","file"]);
let subscript_value_names = select l.id as id, l.file as file, l.value as value from subscript_values as l join nodes as r on l.value = r.id and l.file = r.file where r.kind = "name";
let subscript_names = select l.id as id, l.file as file, r.name as sequence from subscript_value_names as l join "identifier" as r on l.value = r.id and l.file = r.file;
let subscript_slice_edges = select l.id as id, l.file as file, l.sequence as sequence, r.child as slice from subscript_names as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let subscript_slices = antijoin(left=subscript_slice_edges, right=embedded_roots, left-on=["slice","file"], right-on=["id","file"]);
let subscript_slice_names = select l.id as id, l.file as file, l.sequence as sequence, l.slice as slice from subscript_slices as l join nodes as r on l.slice = r.id and l.file = r.file where r.kind = "name";
let indexed_names = select l.id as id, l.file as file, l.sequence as sequence, r.name as index from subscript_slice_names as l join "identifier" as r on l.slice = r.id and l.file = r.file;
let matching_accesses = select l.context as context, l.file as file, r.id as id from contexts as l join indexed_names as r on l.sequence = r.sequence and l.index = r.index and l.file = r.file;
let visited_accesses = select l.destination as id, l.context as context, l.file as file, l.visit as visit from visits as l join matching_accesses as r on l.destination = r.id and l.context = r.context and l.file = r.file;
let visited_statements = select l.id as id, r.kind as kind, l.file as file from visited as l join special_statements as r on l.id = r.id and l.file = r.file;
let target_edges = select l.id as statement, l.file as file, l.kind as kind, r.child as target from visited_statements as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target" or r.field = "targets";
let assign_targets = antijoin(left=target_edges, right=embedded_roots, left-on=["target","file"], right-on=["id","file"]);
let statement_value_edges = select l.id as parent, l.file as file, r.child as child from visited_statements as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let values = antijoin(left=statement_value_edges, right=embedded_roots, left-on=["child","file"], right-on=["id","file"]);
let without_values = antijoin(left=assign_targets, right=values, left-on=["statement","file"], right-on=["parent","file"]);
let skipped_annotations = select statement, file from without_values where kind = "ann-assign";
let live_targets = antijoin(left=assign_targets, right=skipped_annotations, left-on=["statement","file"], right-on=["statement","file"]);
let live_name_targets = select l.statement as statement, l.file as file, l.target as target from live_targets as l join nodes as r on l.target = r.id and l.file = r.file where r.kind = "name";
let named_targets = select l.statement as statement, l.file as file, r.name as name from live_name_targets as l join "identifier" as r on l.target = r.id and l.file = r.file;
let name_mutations = select l.context as context, l.file as file, r.statement as statement from contexts as l join named_targets as r on l.file = r.file where r.name = l.sequence or r.name = l.index or r.name = l.value;
let target_subscripts = select l.statement as statement, l.file as file, l.target as target from live_targets as l join nodes as r on l.target = r.id and l.file = r.file where r.kind = "subscript";
let target_subscript_values = select l.statement as statement, l.file as file, l.target as target, r.child as value from target_subscripts as l join "semantic-child" as r on l.target = r.parent and l.file = r.file where r.field = "value";
let target_subscript_values_kept = antijoin(left=target_subscript_values, right=embedded_roots, left-on=["value","file"], right-on=["id","file"]);
let target_value_names = select l.statement as statement, l.file as file, l.target as target, l.value as value from target_subscript_values_kept as l join nodes as r on l.value = r.id and l.file = r.file where r.kind = "name";
let target_sequences = select l.statement as statement, l.file as file, l.target as target, r.name as sequence from target_value_names as l join "identifier" as r on l.value = r.id and l.file = r.file;
let target_slice_edges = select l.statement as statement, l.file as file, l.sequence as sequence, r.child as slice from target_sequences as l join "semantic-child" as r on l.target = r.parent and l.file = r.file where r.field = "slice";
let target_slices = antijoin(left=target_slice_edges, right=embedded_roots, left-on=["slice","file"], right-on=["id","file"]);
let target_slice_names = select l.statement as statement, l.file as file, l.sequence as sequence, l.slice as slice from target_slices as l join nodes as r on l.slice = r.id and l.file = r.file where r.kind = "name";
let subscript_targets = select l.statement as statement, l.file as file, l.sequence as sequence, r.name as index from target_slice_names as l join "identifier" as r on l.slice = r.id and l.file = r.file;
let indexed_mutations = select l.context as context, l.file as file, r.statement as statement from contexts as l join subscript_targets as r on l.sequence = r.sequence and l.index = r.index and l.file = r.file;
let mutations = union(left=name_mutations, right=indexed_mutations);
let mutation_visits = select l.context as context, l.file as file, l.visit as visit from visits as l join mutations as r on l.destination = r.statement and l.context = r.context and l.file = r.file;
let blocked_accesses = select l.id as id, l.context as context, l.file as file from visited_accesses as l join mutation_visits as r on l.context = r.context and l.file = r.file where r.visit <= l.visit;
let surviving = antijoin(left=visited_accesses, right=blocked_accesses, left-on=["id","context","file"], right-on=["id","context","file"]);
let result = select id, context, file from surviving;
return result;
