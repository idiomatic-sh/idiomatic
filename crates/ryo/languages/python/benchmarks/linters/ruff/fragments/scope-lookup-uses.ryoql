input reads: relation<reference: node, file: file>;
input uses: relation<reference: node, binding: node, file: file>;
output relation<reference: node, binding: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let events = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event";
let read_events = select occurrence as reference, name, scope as read_scope, ordinal as point, file from events where kind = "read";
let read_rows = select l.reference as reference, r.name as name, r.read_scope as read_scope, r.point as point, l.file as file from reads as l join read_events as r on l.reference = r.reference and l.file = r.file;
let binds = select occurrence as binding, name, scope, phase, ordinal, file from events where kind = "bind";
let redirects = select scope, phase, name, file from events where kind = "global" or kind = "nonlocal";
let redirected_binds = select l.binding as binding, l.name as name, l.phase as home, l.ordinal as ordinal, l.file as file from binds as l join redirects as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file;
let plain_binds = antijoin(left=binds, right=redirected_binds, left-on=["binding", "file"], right-on=["binding", "file"]);
let local_binds = select binding, name, scope as home, ordinal, file from plain_binds;
let home_bind_rows = union(left=local_binds, right=redirected_binds);
let home_binds0 = extend(from=home_bind_rows, values={kind: "bind"});
let home_binds1 = select binding, name, home, ordinal, kind, file from home_binds0;
let module_nodes = select id, file from nodes where kind = "module";
let module_end_events = select occurrence as binding, name, scope as home, ordinal, kind, file from events where kind = "delete" or kind = "cleanup";
let module_ends = select l.binding as binding, l.name as name, l.home as home, l.ordinal as ordinal, l.kind as kind, l.file as file from module_end_events as l join module_nodes as r on l.home = r.id and l.file = r.file;
let home_binds = union(left=home_binds1, right=module_ends);
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges, source="origin", destination="destination", keys=["file"]);
let ancestors = select origin, destination, file from scope_paths;
let scope_selves = select child as origin, child as destination, file from "scope";
let chain = union(left=scope_selves, right=ancestors);
let candidates0 = select l.reference as reference, l.name as name, l.point as point, l.read_scope as read_scope, r.destination as home, l.file as file from read_rows as l join chain as r on l.read_scope = r.origin and l.file = r.file;
let class_nodes = select id, file from nodes where kind = "class-def";
let hidden_classes = select l.reference as reference, l.home as home, l.file as file from candidates0 as l join class_nodes as r on l.home = r.id and l.file = r.file where l.home != l.read_scope;
let candidates = antijoin(left=candidates0, right=hidden_classes, left-on=["reference", "home", "file"], right-on=["reference", "home", "file"]);
let deferring_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let deferring_chain = select l.origin as origin, l.destination as via, l.file as file from chain as l join deferring_nodes as r on l.destination = r.id and l.file = r.file;
let deferred_homes = select l.origin as read_scope, r.destination as home, l.file as file from deferring_chain as l join ancestors as r on l.via = r.origin and l.file = r.file;
let candidate_binds = select l.reference as reference, l.read_scope as read_scope, l.point as point, l.home as home, r.binding as binding, r.ordinal as ordinal, r.kind as kind, l.file as file from candidates as l join home_binds as r on l.home = r.home and l.name = r.name and l.file = r.file;
let early_binds = select reference, home, binding, ordinal, kind, file from candidate_binds where ordinal < point;
let late_binds = select l.reference as reference, l.home as home, l.binding as binding, l.ordinal as ordinal, l.kind as kind, l.file as file from candidate_binds as l join deferred_homes as r on l.read_scope = r.read_scope and l.home = r.home and l.file = r.file;
let visible_binds = union(left=early_binds, right=late_binds);
let older_binds = select l.reference as reference, l.binding as binding, l.file as file from visible_binds as l join visible_binds as r on l.reference = r.reference and l.home = r.home and l.file = r.file where l.ordinal < r.ordinal;
let last_binds = antijoin(left=visible_binds, right=older_binds, left-on=["reference", "binding", "file"], right-on=["reference", "binding", "file"]);
let competing = select l.reference as reference, l.binding as binding, l.home as farther, r.home as closer, l.file as file from last_binds as l join last_binds as r on l.reference = r.reference and l.file = r.file where l.home != r.home;
let farther_binds = select l.reference as reference, l.binding as binding, l.file as file from competing as l join ancestors as r on l.closer = r.origin and l.farther = r.destination and l.file = r.file;
let nearest = antijoin(left=last_binds, right=farther_binds, left-on=["reference", "binding", "file"], right-on=["reference", "binding", "file"]);
let provided = select l.reference as reference, r.home as provided_home, l.file as file from uses as l join home_binds1 as r on l.binding = r.binding and l.file = r.file;
let nearest_binds = select reference, binding, home, file from nearest where kind = "bind";
let nearest_homes = select l.reference as reference, l.binding as binding, l.home as home, r.provided_home as provided_home, l.file as file from nearest_binds as l join provided as r on l.reference = r.reference and l.file = r.file;
let overriding = select l.reference as reference, l.binding as binding, l.file as file from nearest_homes as l join ancestors as r on l.home = r.origin and l.provided_home = r.destination and l.file = r.file where l.home != l.provided_home;
let overridden = select reference, file from overriding;
let unprovided = antijoin(left=nearest_binds, right=uses, left-on=["reference", "file"], right-on=["reference", "file"]);
let fresh = select reference, binding, file from unprovided;
let read_uses = select l.reference as reference, l.binding as binding, l.file as file from uses as l join read_rows as r on l.reference = r.reference and l.file = r.file;
let kept = antijoin(left=read_uses, right=overridden, left-on=["reference", "file"], right-on=["reference", "file"]);
let kept_rows = select reference, binding, file from kept;
let corrected = union(left=kept_rows, right=overriding);
let result = union(left=corrected, right=fresh);
return result;
