import suppression_edges from "python/ruff/suppression-edges";
input candidates: relation<id: node, file: file, span: span, line: number>;
input locations: relation<id: node, file: file, span: span, line: number>;
input additional_locations: relation<id: node, file: file, line: number>;
param inline-pattern: string;
param range-pattern: string;
output relation<id: node, file: file, span: span>;
let matched = suppression_edges(candidates=candidates, locations=locations, additional_locations=additional_locations, inline-pattern=$inline-pattern, range-pattern=$range-pattern);
let located = select id, file, span from locations;
let violations = antijoin(left=located, right=matched, left-on=[id, span], right-on=[id, span]);
return violations;
