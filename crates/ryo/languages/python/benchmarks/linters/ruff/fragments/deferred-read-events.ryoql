import deferred_context from "python/ruff/deferred-type-reads";
import decisions_of from "python/ruff/lookup-read-events";
input missing: relation<id: node, name: symbol, scope: node, phase: node, file: file>;
output relation<reference: node, occurrence: node, kind: symbol, point: number, file: file>;
let expressions = select id, file from missing;
let deferred_contexts = deferred_context(expressions=expressions);
let deferred_types = select id, file from deferred_contexts where visit = "deferred";
let unvisited_types = select id, file from deferred_contexts where visit = "unvisited";
let all_points = select ordinal as point, file from "binding-event";
let point_pairs = ordered-match(left=all_points, right=all_points, left-on=[file], right-on=[file], left-order="point", right-order="point", output={point:[left,point], file:[left,file]});
let final_points = antijoin(left=all_points, right=point_pairs, left-on=["point", "file"], right-on=["point", "file"]);
let deferred_references = select id as reference, file from deferred_types;
let end_points0 = extend(from=deferred_references, values={point: 2147483647});
let end_points = select reference, point, file from end_points0;
let decisions = decisions_of(reads=end_points);
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_decisions = select l.reference as reference, l.event as occurrence, l.kind as kind, l.file as file from decisions as l join modules as r on l.scope = r.id and l.file = r.file;
let module_rows = select reference, occurrence, kind, file from module_decisions where kind = "bind";
let builtins = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let no_module_decisions = antijoin(left=deferred_references, right=module_decisions, left-on=["reference", "file"], right-on=["reference", "file"]);
let module_implicit_names = select l.reference as reference, r.name as name, l.file as file from no_module_decisions as l join missing as r on l.reference = r.id and l.file = r.file;
let module_implicit_builtins = select l.reference as reference, l.file as file from module_implicit_names as l join builtins as r on l.name = r.name and l.file = r.file;
let answers = select reference, event, kind, scope, depth, file from decisions;
let farther_answers = select l.reference as reference, l.depth as depth, l.file as file from answers as l join answers as r on l.reference = r.reference and l.file = r.file where r.depth < l.depth;
let nearest_answers = antijoin(left=answers, right=farther_answers, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let local_rows0 = select reference, event as occurrence, kind, file from nearest_answers;
let local_rows1 = antijoin(left=local_rows0, right=module_rows, left-on=["reference", "file"], right-on=["reference", "file"]);
let local_rows = antijoin(left=local_rows1, right=module_implicit_builtins, left-on=["reference", "file"], right-on=["reference", "file"]);
let lookup_rows = union(left=local_rows, right=module_rows);
let events = select occurrence as id, scope, name, ordinal, kind, file from "binding-event";
let deletion_events = select l.reference as id, l.event as deletion, l.scope as scope, r.name as name, r.ordinal as point, l.file as file from nearest_answers as l join events as r on l.event = r.id and l.file = r.file where l.kind = "delete" and r.kind = "delete" and matches(l.file, "[.]pyi$");
let source_locations = select id, "start-byte" as start, file from "source-location";
let reference_positions = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, l.point as point, r.start as reference_start, l.file as file from deletion_events as l join source_locations as r on l.id = r.id and l.file = r.file;
let forward_deletions = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, l.point as point, l.file as file from reference_positions as l join source_locations as r on l.deletion = r.id and l.file = r.file where l.reference_start < r.start;
let predecessor_options = select l.id as id, l.deletion as deletion, l.scope as scope, l.name as name, r.ordinal as point, r.kind as kind, l.file as file from forward_deletions as l join events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point and (r.kind = "bind" or r.kind = "annotation" or r.kind = "delete" or r.kind = "cleanup");
let older_predecessors = select l.id as id, l.deletion as deletion, l.point as point, l.file as file from predecessor_options as l join predecessor_options as r on l.id = r.id and l.deletion = r.deletion and l.file = r.file where l.point < r.point;
let predecessors = antijoin(left=predecessor_options, right=older_predecessors, left-on=["id", "deletion", "point", "file"], right-on=["id", "deletion", "point", "file"]);
let restored_bindings = select id, file from predecessors where kind = "bind";
let no_predecessors = antijoin(left=forward_deletions, right=predecessor_options, left-on=["id", "file"], right-on=["id", "file"]);
let no_module_predecessors = select l.id as id, l.name as name, l.file as file from no_predecessors as l join modules as r on l.scope = r.id and l.file = r.file;
let restored_builtins = select l.id as id, l.file as file from no_module_predecessors as l join builtins as r on l.name = r.name and l.file = r.file;
let restorable_ids = union(left=restored_bindings, right=restored_builtins);
let restored_predecessors = select l.id as reference, l.point as point, l.scope as scope, l.name as name, l.file as file from predecessors as l join restorable_ids as r on l.id = r.id and l.file = r.file where l.kind = "bind";
let restored_rows = select l.reference as reference, r.id as occurrence, r.kind as kind, l.file as file from restored_predecessors as l join events as r on l.scope = r.scope and l.name = r.name and l.point = r.ordinal and l.file = r.file;
let not_restored = antijoin(left=lookup_rows, right=restorable_ids, left-on=["reference", "file"], right-on=["id", "file"]);
let results0 = union(left=not_restored, right=restored_rows);
let deferred_ids = union(left=deferred_types, right=unvisited_types);
let no_event_ids = antijoin(left=deferred_ids, right=results0, left-on=["id", "file"], right-on=["reference", "file"]);
let missing_rows0 = select l.id as reference, l.id as occurrence, l.file as file from no_event_ids as l;
let missing_rows1 = extend(from=missing_rows0, values={kind: "absent"});
let missing_rows = select reference, occurrence, kind, file from missing_rows1;
let all_rows = union(left=results0, right=missing_rows);
let result = select l.reference as reference, l.occurrence as occurrence, l.kind as kind, r.point as point, l.file as file from all_rows as l join final_points as r on l.file = r.file;
return result;
