import latest_before from "python/ruff/latest-before";
input reads: relation<reference: node, file: file>;
output relation<reference: node, event: node, kind: symbol, scope: node, lexical: node, depth: number, ordinal: number, context: symbol, file: file>;
let events = select occurrence, name, scope, kind, ordinal, lexical, file from "binding-event";
let read_events = select occurrence, name, scope as home, kind as asking, ordinal as point, file from events where kind = "read" or kind = "delete";
let asked = select l.reference as reference, r.name as name, r.home as home, r.asking as asking, r.point as point, l.file as file from reads as l join read_events as r on l.reference = r.occurrence and l.file = r.file;
let read_rows = select reference, scope as start, context, file from "binding-read";
let probes = select l.reference as reference, l.name as name, l.home as home, l.asking as asking, l.point as point, r.start as start, r.context as context, l.file as file from asked as l join read_rows as r on l.reference = r.reference and l.file = r.file;
let scope_rows = select parent, child, file from "scope";
let modules = select child as id, file from scope_rows where child = parent;
let scope_edges = select child, parent, file from scope_rows where child != parent;
let ancestors = closure(edges=scope_edges, source="child", destination="parent", keys=["file"]);
let above = select child as low, parent as high, file from ancestors;
let selves = select child as low, child as high, file from scope_rows;
let chain = union(left=above, right=selves);
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let class_chain = select l.low as low, l.high as high, l.file as file from above as l join classes as r on l.high = r.id and l.file = r.file;
let visible = antijoin(left=chain, right=class_chain, left-on=["low", "high", "file"], right-on=["low", "high", "file"]);
let below = select l.low as low, r.high as high, l.high as mid, l.file as file from visible as l join above as r on l.high = r.low and l.file = r.file;
let below_counts = group-count(from=below, keys=["low", "high", "file"], count="depth");
let deep = select l.low as low, l.high as high, l.depth as depth, l.file as file from below_counts as l join visible as r on l.low = r.low and l.high = r.high and l.file = r.file;
let shallow0 = extend(from=selves, values={depth: 0});
let shallow = select low, high, depth, file from shallow0;
let path = union(left=deep, right=shallow);
let within = select l.low as low, r.high as high, l.high as mid, l.file as file from visible as l join chain as r on l.high = r.low and l.file = r.file;
let within_counts = group-count(from=within, keys=["low", "high", "file"], count="after");
let global_events = select lexical as scope, name, file from events where kind = "global";
let global_names = project(from=global_events, columns=["scope", "name", "file"]);
let spaces_all = select l.reference as reference, l.name as name, l.home as home, l.asking as asking, l.point as point, l.context as context, r.high as scope, r.depth as depth, l.start as start, l.file as file from probes as l join path as r on l.start = r.low and l.file = r.file;
let cut_candidates0 = select l.reference as reference, l.scope as scope, l.depth as depth, l.start as start, l.file as file from spaces_all as l join global_names as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let cut_candidates = antijoin(left=cut_candidates0, right=modules, left-on=["scope", "file"], right-on=["id", "file"]);
let farther_cuts = select l.reference as reference, l.depth as depth, l.file as file from cut_candidates as l join cut_candidates as r on l.reference = r.reference and l.file = r.file where r.depth < l.depth;
let cuts = antijoin(left=cut_candidates, right=farther_cuts, left-on=["reference", "depth", "file"], right-on=["reference", "depth", "file"]);
let beyond = select l.reference as reference, l.scope as scope, l.file as file from spaces_all as l join cuts as r on l.reference = r.reference and l.file = r.file where l.depth > r.depth;
let spaces_kept = antijoin(left=spaces_all, right=beyond, left-on=["reference", "scope", "file"], right-on=["reference", "scope", "file"]);
let cut_after = select l.reference as reference, r.after as depth, l.file as file from cuts as l join within_counts as r on l.start = r.low and l.scope = r.high and l.file = r.file;
let cut_modules = select l.reference as reference, l.depth as depth, r.id as scope, l.file as file from cut_after as l join modules as r on l.file = r.file;
let module_spaces = select l.reference as reference, l.name as name, l.home as home, l.asking as asking, l.point as point, l.context as context, r.scope as scope, r.depth as depth, l.start as start, l.file as file from probes as l join cut_modules as r on l.reference = r.reference and l.file = r.file;
let spaces = union(left=spaces_kept, right=module_spaces);
let own_events = select occurrence, name, scope as space, kind, ordinal as at, ordinal, lexical, file from events where kind in ["bind", "annotation", "cleanup", "delete", "global", "nonlocal"];
let declarations = select occurrence, name, lexical as space, kind, ordinal as at, ordinal, lexical, scope, file from events where kind = "global" or kind = "nonlocal";
let routed = select occurrence, name, space, kind, at, ordinal, lexical, file from declarations where space != scope;
let later_routed = select l.occurrence as occurrence, l.space as space, l.name as name, l.at as at, l.file as file from routed as l join routed as r on l.space = r.space and l.name = r.name and l.file = r.file where r.at < l.at;
let first_routed = antijoin(left=routed, right=later_routed, left-on=["occurrence", "space", "name", "at", "file"], right-on=["occurrence", "space", "name", "at", "file"]);
let initial0 = select occurrence, name, space, kind, ordinal, lexical, file from first_routed;
let initial1 = extend(from=initial0, values={at: 0});
let initial = select occurrence, name, space, kind, at, ordinal, lexical, file from initial1;
let stream0 = union(left=own_events, right=routed);
let stream = union(left=stream0, right=initial);
let own_deletes = select reference, name, scope, depth, context, point, file from spaces where asking = "delete" and scope = home;
let plain = antijoin(left=spaces, right=own_deletes, left-on=["reference", "scope", "file"], right-on=["reference", "scope", "file"]);
let stream_points = select space as scope, space as phase, name, file, at as ordinal from stream;
let probe_points = select scope, scope as phase, name, file, point as ordinal from plain;
let hits = latest_before(events=stream_points, probes=probe_points);
let plain_answers = select l.reference as reference, l.name as name, l.scope as scope, l.depth as depth, l.context as context, r.event_ordinal as at, l.file as file from plain as l join hits as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.point = r.point;
let stream_order = select space, name, file, at from stream;
let stream_pairs = ordered-match(left=stream_order, right=stream_order, left-on=[space,name,file], right-on=[space,name,file], left-order="at", right-order="at", output={space:[left,space], name:[left,name], file:[left,file], before:[left,at], at:[right,at]});
let own_answers = select l.reference as reference, l.name as name, l.scope as scope, l.depth as depth, l.context as context, r.before as at, l.file as file from own_deletes as l join stream_pairs as r on l.scope = r.space and l.name = r.name and l.file = r.file and l.point = r.at;
let answers = union(left=plain_answers, right=own_answers);
let resolved = select l.reference as reference, r.occurrence as event, r.kind as kind, l.scope as scope, r.lexical as lexical, l.depth as depth, r.ordinal as ordinal, l.context as context, l.file as file from answers as l join stream as r on l.scope = r.space and l.name = r.name and l.file = r.file and l.at = r.at;
return resolved;
