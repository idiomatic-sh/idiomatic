import ablation_final from "python/ruff/ablation-namespace-final";
import deferred_context from "python/ruff/deferred-type-reads";
input expressions: relation<id: node, file: file>;
output relation<reference: node, occurrence: node, kind: symbol, point: number, file: file>;
let contexts = deferred_context(expressions=expressions);
let visits = select id as reference, file from contexts where visit = "deferred";
let reads = select l.reference as reference,r.name as name,l.file as file from visits as l join "binding-read" as r on l.reference=r.reference and l.file=r.file;
let events = select occurrence as reference, ordinal, file, kind from "binding-event";
let read_points = select reference,file from events where kind="read";
let relevant = select l.reference as reference,l.name as name,l.file as file from reads as l join read_points as r on l.reference=r.reference and l.file=r.file;
let finals = group-max(from=events, keys=[file], order="ordinal");
let modules = select id,file from "semantic-syntax" where kind="module";
let namespace_final = ablation_final();
let module_final = select l.name as name,l.event as occurrence,l.file as file from namespace_final as l join modules as r on l.namespace=r.id and l.file=r.file where l.kind="bind";
let found = select l.reference as reference,r.occurrence as occurrence,l.file as file,concat("","bind") as kind from relevant as l join module_final as r on l.name=r.name and l.file=r.file;
let language = select major,minor,file from "language-target";
let builtin_names = select l.name as name,r.file as file from "implicit-symbol" as l join language as r on l.file=r.file where l.kind="builtin" and (l."since-major"<r.major or l."since-major"=r.major and l."since-minor"<=r.minor);
let unbound = antijoin(left=relevant,right=found,left-on=[reference,file],right-on=[reference,file]);
let implicit = select l.reference as reference,l.reference as occurrence,l.file as file,concat("","builtin") as kind from unbound as l join builtin_names as r on l.name=r.name and l.file=r.file;
let known = union(left=found,right=implicit);
let unrecognized = antijoin(left=reads,right=known,left-on=[reference,file],right-on=[reference,file]);
let absent = select reference,reference as occurrence,file,concat("","absent") as kind from unrecognized;
let all_results = union(left=known,right=absent);
let result = select l.reference as reference,l.occurrence as occurrence,l.kind as kind,r.ordinal as point,l.file as file from all_results as l join finals as r on l.file=r.file;
return result;
