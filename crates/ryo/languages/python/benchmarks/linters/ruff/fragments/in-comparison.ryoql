input expressions: relation<id: node, file: file>;
output relation<id: node, key: node, container: node, file: file>;
let result = select l.id as id,r.left as key,r.right as container,l.file as file from expressions as l join "comparison-operands" as r on l.id=r.id and l.file=r.file where r.operator="in" and r.count=1;
return result;
