import future_context from "python/ruff/future-annotation-context";
import type_scope_events from "python/ruff/checker-type-scope-events";
input events: relation<occurrence: node, name: symbol, scope: node, ordinal: number, kind: symbol, file: file>;
output relation<declaration: node, name: symbol, scope: node, binding: node, target_scope: node, kind: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let scopes = select child as id, file from "scope";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let generics = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let scope_edges = select child, parent, file from "scope";
let paths = closure(edges=scope_edges, source="child", destination="parent", keys=["file"]);
let declarations = select occurrence as id, name, scope, ordinal, file from events where kind = "nonlocal";
let annotation_inputs = select occurrence as id, name, ordinal, file from "binding-event" where kind = "annotation";
let annotation_owners = axis(from=annotation_inputs, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let annotations = select l.id as occurrence, l.name as name, r.related as scope, l.ordinal as ordinal, l.file as file from annotation_inputs as l join annotation_owners as r on l.id = r.id and l.file = r.file;
let annotated = extend(from=annotations, values={kind: "annotation"});
let annotation_events = select occurrence, name, scope, ordinal, kind, file from annotated;
let raw_primary = select occurrence, name, scope, ordinal, kind, file from events where kind = "bind" or kind = "global" or kind = "delete" or kind = "cleanup";
let parameters = select id, name, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let primary_values = antijoin(left=raw_primary, right=parameters, left-on=["occurrence", "file"], right-on=["id", "file"]);
let annotation_prior = union(left=primary_values, right=annotation_events);
let delayed_annotation_ids = select l.occurrence as occurrence, l.file as file from annotation_events as l join annotation_prior as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let real_annotations = antijoin(left=annotation_events, right=delayed_annotation_ids, left-on=["occurrence", "file"], right-on=["occurrence", "file"]);
let primary = union(left=primary_values, right=real_annotations);
let parameter_owners = axis(from=parameters, relation="semantic-child", direction=nearest-ancestor, domain=generics);
let owned_parameters0 = select l.id as occurrence, l.name as name, r.related as scope, l.file as file from parameters as l join parameter_owners as r on l.id = r.id and l.file = r.file;
let parameter_locations = select id, "start-byte" as position, file from "source-location";
let owned_parameters = select l.occurrence as occurrence, l.name as name, l.scope as scope, r.position as position, l.file as file from owned_parameters0 as l join parameter_locations as r on l.occurrence = r.id and l.file = r.file;
let outer_scope_rows = select l.id as declaration, l.name as name, l.scope as scope, r.parent as target_scope, l.ordinal as point, l.file as file from declarations as l join paths as r on l.scope = r.child and l.file = r.file;
let outer_functions = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, l.point as point, l.file as file from outer_scope_rows as l join functions as r on l.target_scope = r.id and l.file = r.file;
let self_type_scopes = select id as declaration, name, scope, scope as target_scope, ordinal as point, file from declarations;
let visible_type_scopes = union(left=outer_scope_rows, right=self_type_scopes);
let declared_parameter_targets0 = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, r.occurrence as binding, r.position as position, l.file as file from visible_type_scopes as l join owned_parameters as r on l.target_scope = r.scope and l.name = r.name and l.file = r.file;
let declared_parameter_targets1 = extend(from=declared_parameter_targets0, values={rank: 2});
let declared_parameter_targets = select declaration, name, scope, target_scope, binding, position, rank, file from declared_parameter_targets1;
let raw_type_events = type_scope_events();
let locations = select id, "start-byte" as start, file from "source-location";
let classes = select id, file from nodes where kind = "class-def";
let class_type_events = select l.occurrence as occurrence, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from raw_type_events as l join classes as r on l.owner = r.id and l.file = r.file;
let function_type_events = select l.occurrence as occurrence, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from raw_type_events as l join functions as r on l.owner = r.id and l.file = r.file;
let function_type_inputs = select occurrence as id, file from function_type_events;
let deferred_function_events0 = future_context(expressions=function_type_inputs);
let deferred_function_events = select id as occurrence, file from deferred_function_events0;
let eager_function_events = antijoin(left=function_type_events, right=deferred_function_events, left-on=["occurrence", "file"], right-on=["occurrence", "file"]);
let runtime_functions = select occurrence, name, owner, ordinal, file from eager_function_events where matches(file, "[.]py$");
let runtime_classes = select occurrence, name, owner, ordinal, file from class_type_events where matches(file, "[.]py$");
let runtime_type_events = union(left=runtime_functions, right=runtime_classes);
let runtime_type_targets = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, r.occurrence as binding, r.ordinal as ordinal, l.file as file from visible_type_scopes as l join runtime_type_events as r on l.target_scope = r.owner and l.name = r.name and l.file = r.file;
let local_classes = axis(from=classes, relation="semantic-child", direction=ancestor, domain=functions);
let initial_classes = antijoin(left=classes, right=local_classes, left-on=["id", "file"], right-on=["id", "file"]);
let initial_stub_events = select l.occurrence as occurrence, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from class_type_events as l join initial_classes as r on l.owner = r.id and l.file = r.file where matches(l.file, "[.]pyi$");
let deferred_declarations = axis(from=declarations, relation="semantic-child", direction=ancestor, domain=functions);
let stub_type_targets0 = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, r.occurrence as binding, r.ordinal as ordinal, l.file as file from visible_type_scopes as l join initial_stub_events as r on l.target_scope = r.owner and l.name = r.name and l.file = r.file;
let stub_type_targets = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, l.binding as binding, l.ordinal as ordinal, l.file as file from stub_type_targets0 as l join deferred_declarations as r on l.declaration = r.id and l.file = r.file;
let evaluated_type_targets0 = union(left=runtime_type_targets, right=stub_type_targets);
let evaluated_type_targets1 = extend(from=evaluated_type_targets0, values={rank: 1});
let evaluated_type_targets = select declaration, name, scope, target_scope, binding, ordinal as position, rank, file from evaluated_type_targets1;
let all_type_targets = union(left=declared_parameter_targets, right=evaluated_type_targets);
let earlier_type_targets = select l.declaration as declaration, l.target_scope as target_scope, l.binding as binding, l.file as file from all_type_targets as l join all_type_targets as r on l.declaration = r.declaration and l.target_scope = r.target_scope and l.file = r.file where l.rank = r.rank and l.position < r.position or r.rank < l.rank;
let parameter_targets0 = antijoin(left=all_type_targets, right=earlier_type_targets, left-on=["declaration", "target_scope", "binding", "file"], right-on=["declaration", "target_scope", "binding", "file"]);
let parameter_targets1 = extend(from=parameter_targets0, values={kind: "bind", priority: 1});
let parameter_targets = select declaration, name, scope, target_scope, binding, kind, priority, file from parameter_targets1;
let seeded_values = select l.declaration as declaration, l.file as file from outer_functions as l join primary as r on l.target_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point;
let seeded_parameters = select declaration, file from parameter_targets;
let seeded = union(left=seeded_values, right=seeded_parameters);
let valid_declarations = select l.id as occurrence, l.name as name, l.scope as scope, l.ordinal as ordinal, l.file as file from declarations as l join seeded as r on l.id = r.declaration and l.file = r.file;
let valid_nonlocals0 = extend(from=valid_declarations, values={kind: "nonlocal"});
let valid_nonlocals = select occurrence, name, scope, ordinal, kind, file from valid_nonlocals0;
let nonlocal_delayed_annotations = select l.occurrence as occurrence, l.file as file from real_annotations as l join valid_nonlocals as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let final_annotations = antijoin(left=real_annotations, right=nonlocal_delayed_annotations, left-on=["occurrence", "file"], right-on=["occurrence", "file"]);
let final_primary = union(left=primary_values, right=final_annotations);
let value_events = union(left=final_primary, right=valid_nonlocals);
let value_targets0 = select l.declaration as declaration, l.name as name, l.scope as scope, l.target_scope as target_scope, r.occurrence as binding, r.ordinal as ordinal, r.kind as kind, l.file as file from outer_functions as l join value_events as r on l.target_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point;
let earlier_values = select l.declaration as declaration, l.target_scope as target_scope, l.binding as binding, l.file as file from value_targets0 as l join value_targets0 as r on l.declaration = r.declaration and l.target_scope = r.target_scope and l.file = r.file where l.ordinal < r.ordinal;
let last_values = antijoin(left=value_targets0, right=earlier_values, left-on=["declaration", "target_scope", "binding", "file"], right-on=["declaration", "target_scope", "binding", "file"]);
let value_targets1 = extend(from=last_values, values={priority: 0});
let value_targets = select declaration, name, scope, target_scope, binding, kind, priority, file from value_targets1;
let all_targets = union(left=value_targets, right=parameter_targets);
let farther_pairs = select l.declaration as declaration, l.target_scope as target_scope, r.target_scope as nearer_scope, l.file as file from all_targets as l join all_targets as r on l.declaration = r.declaration and l.file = r.file where l.target_scope != r.target_scope;
let farther = select l.declaration as declaration, l.target_scope as target_scope, l.file as file from farther_pairs as l join paths as r on l.nearer_scope = r.child and l.target_scope = r.parent and l.file = r.file;
let nearest_targets = antijoin(left=all_targets, right=farther, left-on=["declaration", "target_scope", "file"], right-on=["declaration", "target_scope", "file"]);
let lower_priority = select l.declaration as declaration, l.binding as binding, l.file as file from nearest_targets as l join nearest_targets as r on l.declaration = r.declaration and l.target_scope = r.target_scope and l.file = r.file where r.priority < l.priority;
let selected = antijoin(left=nearest_targets, right=lower_priority, left-on=["declaration", "binding", "file"], right-on=["declaration", "binding", "file"]);
let result = select declaration, name, scope, binding, target_scope, kind, file from selected;
return result;
