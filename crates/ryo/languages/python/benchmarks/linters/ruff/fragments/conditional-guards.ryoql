input conditions: relation<context: node, test: node, file: file>;
output relation<context: node, file: file>;
let tc_names = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_qualified = select id, file from "qualified-name" where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attr_edges = select l.id as attribute, r.child as label, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let tc_attributes = select l.attribute as id, l.file as file from attr_edges as l join tc_names as r on l.label = r.id and l.file = r.file;
let tc0 = union(left=tc_names, right=tc_qualified);
let tc = union(left=tc0, right=tc_attributes);
let tc_conditions = select l.context as context, l.file as file from conditions as l join tc as r on l.test = r.id and l.file = r.file;
let embedded = select host as parent, root as child, file from "embedded-expression";
let physical_edges = select parent, child, file from "semantic-child";
let edges = antijoin(left=physical_edges, right=embedded, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let paths = closure(edges=edges, source="parent", destination="child", keys=["file"]);
let descendants = select l.context as context, r.child as test, l.file as file from conditions as l join paths as r on l.test = r.parent and l.file = r.file;
let all_tests = union(left=conditions, right=descendants);
let sys_names = select id, file from "qualified-name" where path = "sys.version_info" or path = "sys.platform";
let sys_conditions = select l.context as context, l.file as file from all_tests as l join sys_names as r on l.test = r.id and l.file = r.file;
let guarded = union(left=tc_conditions, right=sys_conditions);
return guarded;
