import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/suppression-edges";
input candidates: relation<file: file, span: span>;
param inline-pattern: string;
param range-pattern: string;
output relation<file: file, span: span, directive: node, scope: number>;
let starts = source-matches(from=candidates, span="span", pattern="^", output="point");
let points = span-bounds(from=starts, span="point", start-output="begin", end-output="finish");
let covering = select r.id as id, l.file as file, l.span as span, l.point as point, r.span as origin, r."start-line" as base_line, r."start-byte" as begin, r."end-byte" as finish from points as l join "source-location" as r on l.file = r.file where r."start-byte" <= l.begin and r."end-byte" >= l.begin;
let broader = select l.id as id, l.file as file, l.span as span from covering as l join covering as r on l.file = r.file and l.span = r.span where l.begin < r.begin or l.begin = r.begin and l.finish > r.finish;
let nearest = antijoin(left=covering, right=broader, left-on=[id,file,span], right-on=[id,file,span]);
let prefixes = span-between(from=nearest, start="origin", end="point", output="prefix");
let located = source-matches(from=prefixes, span="prefix", base-line="base_line", pattern="$", output="line_point", line-output="line");
let originals = select id, file, span, line from located;
let mappings = noqa_line_map();
let remapped = noqa_locations(candidates=originals, mappings=mappings);
let no_additional = select id, file, line from originals where id != id;
let matched = suppression_edges(candidates=originals, locations=remapped, additional_locations=no_additional, inline-pattern=$inline-pattern, range-pattern=$range-pattern);
let result = select file, span, directive, scope from matched;
return result;
