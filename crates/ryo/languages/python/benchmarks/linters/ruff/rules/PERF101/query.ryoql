import assigned_values from "python/ruff/assigned-values";
import suppress from "python/ruff/suppress";
let loops = select id, file from "semantic-syntax" where kind = "for" or kind = "async-for";
let iter_fields = select parent, child from "semantic-child" where field = "iter";
let loop_iterators = select l.id as loop, l.file as file, r.child as iterator from loops as l join iter_fields as r on l.id = r.parent;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let list_functions = select id, file from "qualified-name" where path = "builtins.list";
let list_calls = select l.call as call, l.file as file from call_functions as l join list_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let argument_wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_arguments = select parent, child, file from "semantic-child" where field = "args";
let call_args = select l.call as call, r.child as argument, l.file as file from argument_wrappers as l join positional_arguments as r on l.wrapper = r.parent and l.file = r.file;
let counts = group-count(from=call_args, keys=["call", "file"], count="count", distinct="argument");
let unary_calls = select l.call as call, l.file as file from list_calls as l join counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let loop_list_calls = select l.loop as loop, l.file as file, r.call as call from loop_iterators as l join unary_calls as r on l.iterator = r.call and l.file = r.file;
let loop_list_arguments = select l.loop as loop, l.file as file, l.call as call, r.argument as argument from loop_list_calls as l join call_args as r on l.call = r.call and l.file = r.file;
let literal_collections = select id, file from "semantic-syntax" where kind = "list" or kind = "tuple" or kind = "set";
let direct_literal_casts = select l.call as id, l.file as file from loop_list_arguments as l join literal_collections as r on l.argument = r.id and l.file = r.file;
let argument_names = select l.loop as loop, l.file as file, l.call as call, r.id as argument from loop_list_arguments as l join "semantic-syntax" as r on l.argument = r.id and l.file = r.file where r.kind = "name";
let argument_scopes = select l.loop as loop, l.file as file, l.call as call, r.scope as scope, r.name as name from argument_names as l join "binding-read" as r on l.argument = r.reference and l.file = r.file;
let loop_points = select l.loop as loop, l.file as file, l.call as call, l.scope as scope, l.name as name, r."end-byte" as point from argument_scopes as l join "source-location" as r on l.loop = r.id and l.file = r.file;
let available_bindings = select occurrence as binding, scope, name, ordinal, file from "binding-event" where kind = "bind";
let binding_points = select l.binding as binding, l.scope as scope, l.name as name, l.ordinal as ordinal, l.file as file, r."start-byte" as point from available_bindings as l join "source-location" as r on l.binding = r.id and l.file = r.file;
let candidates_bindings = select l.loop as loop, l.file as file, l.call as call, r.binding as binding, r.ordinal as ordinal from loop_points as l join binding_points as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.point < l.point;
let shadowed_bindings = select l.loop as loop, l.file as file, l.call as call, l.binding as binding from candidates_bindings as l join candidates_bindings as r on l.loop = r.loop and l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let final_bindings = antijoin(left=candidates_bindings, right=shadowed_bindings, left-on=["loop","file","call","binding"], right-on=["loop","file","call","binding"]);
let iterable_bindings = select loop, file, call, binding from final_bindings;
let assignment_nodes = select id, file from "semantic-syntax" where kind = "ann-assign";
let assignment_targets = select parent, child, file from "semantic-child" where field = "targets" or field = "target";
let assignment_values = select parent, child, file from "semantic-child" where field = "value";
let annotation_targets = select l.id as assignment, l.file as file, r.child as target from assignment_nodes as l join assignment_targets as r on l.id = r.parent and l.file = r.file;
let annotation_bindings = select l.assignment as assignment, l.file as file, r.occurrence as binding from annotation_targets as l join "binding-event" as r on l.target = r.occurrence and l.file = r.file where r.kind = "bind";
let annotated_values = select l.binding as binding, l.file as file, r.child as value from annotation_bindings as l join assignment_values as r on l.assignment = r.parent and l.file = r.file;
let assigned_values_rows = assigned_values();
let ordinary_values = select binding, file, value from assigned_values_rows;
let all_assigned_values = union(left=ordinary_values, right=annotated_values);
let assigned_collections = select l.binding as binding, l.file as file from all_assigned_values as l join literal_collections as r on l.value = r.id and l.file = r.file;
let assigned_list_cast_arguments = select l.loop as loop, l.file as file, l.call as call, r.binding as binding from iterable_bindings as l join assigned_collections as r on l.binding = r.binding and l.file = r.file;
let nodes = select id, kind, file from "semantic-syntax";
let loop_body_edges = select parent, child, file from "semantic-child" where field = "body";
let body_roots = select r.child as id, l.id as loop, l.file as file from loops as l join loop_body_edges as r on l.id = r.parent and l.file = r.file;
let mutation_statements = select id, kind, file from nodes where kind = "expr" or kind = "assign" or kind = "ann-assign" or kind = "aug-assign" or kind = "delete";
let nested_statements = axis(from=body_roots, relation="semantic-child", direction=descendant, domain=mutation_statements);
let nested_rows = select l.loop as loop, l.file as file, r.related as statement from body_roots as l join nested_statements as r on l.id = r.id and l.file = r.file;
let direct_rows = select l.loop as loop, l.file as file, r.id as statement from body_roots as l join mutation_statements as r on l.id = r.id and l.file = r.file;
let statement_rows = union(left=nested_rows, right=direct_rows);
let body_statements = select l.loop as loop, l.file as file, l.statement as statement, r.kind as kind from statement_rows as l join mutation_statements as r on l.statement = r.id and l.file = r.file;
let expression_rows = select loop, file, statement from body_statements where kind = "expr";
let expression_calls = select l.loop as loop, l.file as file, r.child as call from expression_rows as l join assignment_values as r on l.statement = r.parent and l.file = r.file;
let expression_functions = select l.loop as loop, l.file as file, r.child as function from expression_calls as l join function_fields as r on l.call = r.parent and l.file = r.file;
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let function_attrs = select l.loop as loop, l.file as file, l.function as function, r.child as identifier from expression_functions as l join attr_edges as r on l.function = r.parent and l.file = r.file;
let methods = select l.loop as loop, l.file as file, l.function as function from function_attrs as l join "identifier" as r on l.identifier = r.id and l.file = r.file where r.name = "append" or r.name = "insert" or r.name = "extend" or r.name = "remove" or r.name = "pop" or r.name = "clear" or r.name = "reverse" or r.name = "sort";
let receivers = select l.loop as loop, l.file as file, r.child as receiver from methods as l join assignment_values as r on l.function = r.parent and l.file = r.file;
let name_nodes = select id, file from nodes where kind = "name";
let names = select l.id as id, l.file as file, r.name as name from name_nodes as l join "identifier" as r on l.id = r.id and l.file = r.file;
let method_mutations = select l.loop as loop, l.file as file, r.name as name from receivers as l join names as r on l.receiver = r.id and l.file = r.file;
let augmented_statements = select loop, file, statement from body_statements where kind = "aug-assign";
let augmented_targets = select l.loop as loop, l.file as file, r.child as target from augmented_statements as l join assignment_targets as r on l.statement = r.parent and l.file = r.file;
let augmented_mutations = select l.loop as loop, l.file as file, r.name as name from augmented_targets as l join names as r on l.target = r.id and l.file = r.file;
let indexed_statements = select loop, file, statement from body_statements where kind = "assign" or kind = "ann-assign" or kind = "delete";
let indexed_targets = select l.loop as loop, l.file as file, r.child as target from indexed_statements as l join assignment_targets as r on l.statement = r.parent and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let indexed_subscripts = select l.loop as loop, l.file as file, r.id as target from indexed_targets as l join subscripts as r on l.target = r.id and l.file = r.file;
let indexed_receivers = select l.loop as loop, l.file as file, r.child as receiver from indexed_subscripts as l join assignment_values as r on l.target = r.parent and l.file = r.file;
let indexed_mutations = select l.loop as loop, l.file as file, r.name as name from indexed_receivers as l join names as r on l.receiver = r.id and l.file = r.file;
let mutations_a = union(left=method_mutations, right=augmented_mutations);
let mutations = union(left=mutations_a, right=indexed_mutations);
let iterator_names = select l.loop as loop, l.file as file, l.call as call, r.name as name from loop_list_arguments as l join names as r on l.argument = r.id and l.file = r.file;
let named_casts = select l.loop as loop, l.file as file, l.call as call, r.name as name from assigned_list_cast_arguments as l join iterator_names as r on l.loop = r.loop and l.call = r.call and l.file = r.file;
let mutated_casts = select l.loop as loop, l.file as file, l.call as call from named_casts as l join mutations as r on l.loop = r.loop and l.file = r.file and l.name = r.name;
let stable_casts = antijoin(left=named_casts, right=mutated_casts, left-on=["loop","file","call"], right-on=["loop","file","call"]);
let variable_casts = select call as id, file from stable_casts;
let candidates = union(left=direct_literal_casts, right=variable_casts);
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PERF101(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PERF101)(?:,|$)");
emit violations subject file key(id);
