import observation_matches from "python/ruff/suppress-matches";
import symbols from "python/ruff/modernization-symbols";
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let class_argument_nodes0 = select l.id as class, r.child as wrapper, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_argument_nodes = select l.class as class, l.wrapper as wrapper, l.file as file from class_argument_nodes0 as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let class_keywords = select r.child as id, l.file as file from class_argument_nodes as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let labels0 = select l.id as id, r.child as label, l.file as file from class_keywords as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "arg";
let metaclasses = select l.id as id, l.file as file from labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "metaclass";
let values = select l.id as keyword, r.child as id, l.file as file from metaclasses as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let roots = select id, file from values;
let known = symbols(expressions=roots);
let candidates0 = select l.keyword as id, l.file as file from values as l join known as r on l.id = r.id and l.file = r.file where r.kind = "builtin-type";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:UP050)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP050"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
