import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let name_edges = select parent as function, child as name from "semantic-child" where field = "name";
let function_name_nodes = select l.id as function, l.file as file, r.name as name_node from functions as l join name_edges as r on l.id = r.function;
let named_functions = select l.function as function, l.file as file, r.name as name, r.id as name_id, r.span as name_span from function_name_nodes as l join "identifier" as r on l.name_node = r.id and l.file = r.file;
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let scope_edges = select child, parent, file from "scope";
let method_scopes = select l.child as function, l.file as file from scope_edges as l join classes as r on l.parent = r.id and l.file = r.file;
let named_methods = select l.function as function, l.file as file, l.name as name, l.name_id as name_id, l.name_span as name_span from named_functions as l join method_scopes as r on l.function = r.function and l.file = r.file;
let decorators = select occurrence as decorator, declaration as function, file from "decorates";
let decorator_roots = select l.function as function, l.file as file, r.child as expression from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_decorator_origins = select l.function as function, l.file as file, r.path as path from decorator_roots as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let callable_edges = select parent, child from "semantic-child" where field = "func";
let decorator_callables = select l.function as function, l.file as file, r.child as callable from decorator_roots as l join callable_edges as r on l.expression = r.parent;
let called_decorator_origins = select l.function as function, l.file as file, r.path as path from decorator_callables as l join "qualified-name" as r on l.callable = r.id and l.file = r.file;
let decorator_origins = union(left=direct_decorator_origins, right=called_decorator_origins);
let static_decorators = select function, file from decorator_origins where path = "builtins.staticmethod" or path = "abc.abstractstaticmethod";
let class_decorators = select function, file from decorator_origins where path = "builtins.classmethod" or path = "abc.abstractclassmethod";
let explicit_static_methods = select l.function as function, l.file as file from named_methods as l join static_decorators as r on l.function = r.function and l.file = r.file;
let new_methods = select function, file from named_methods where name = "__new__";
let implicit_static_methods = antijoin(left=new_methods, right=class_decorators, left-on=["function","file"], right-on=["function","file"]);
let static_methods = union(left=explicit_static_methods, right=implicit_static_methods);
let first_parameters = select id, owner, name, file, span from "parameter" where ordinal = 0 and (refinement = "positional-only" or refinement = "positional-or-keyword") and (name = "self" or name = "cls");
let static_parameters = select l.id as id, l.owner as function, l.name as parameter, l.file as file, l.span as span from first_parameters as l join static_methods as r on l.owner = r.function and l.file = r.file;
let candidates = select l.id as id, l.file as file, l.span as span from static_parameters as l join named_methods as r on l.function = r.function and l.file = r.file where r.name != "__new__" or l.parameter != "cls";
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLW0211)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0211"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
