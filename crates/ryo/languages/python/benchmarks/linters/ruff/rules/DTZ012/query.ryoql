import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let qualified = select id from qualified_names where path = "datetime.date.fromtimestamp" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let matching_calls = select l.parent as id, l.child as function from functions as l join qualified as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from calls as l join matching_calls as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*DTZ012(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:DTZ012)(?:,|$)");
emit violations subject file key(id);
