import observation_matches from "python/ruff/suppress-matches";
import keyword_argument_names from "python/ruff/call-keywords";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let functions = select parent, child from "semantic-child" where field = "func";
let qualified = select id from qualified_names where path = "subprocess.Popen" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let matching_calls = select l.parent as id, l.child as function from functions as l join qualified as r on l.child = r.id;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let keyword_names = keyword_argument_names(keywords=keywords, identifiers=semantic_identifiers);
let preexec = select call, id from keyword_names where name = "preexec_fn";
let values = select parent, child from "semantic-child" where field = "value";
let none_tokens = select id from "semantic-syntax" where kind = "name-token" and text = "None";
let none_literals = select l.parent as id from "semantic-child" as l join none_tokens as r on l.child = r.id;
let none_values = select l.parent as id from values as l join none_literals as r on l.child = r.id;
let nonempty = antijoin(left=preexec, right=none_values, left-on=["id"], right-on=["id"]);
let unsafe_keywords = select l.id as id from nonempty as l join matching_calls as r on l.call = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join unsafe_keywords as r on l.id = r.id;
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, code="PLW1509");
let violations = antijoin(left=reportable, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_used = select directive,file,concat("","PLW1509") as code from suppression_found where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
