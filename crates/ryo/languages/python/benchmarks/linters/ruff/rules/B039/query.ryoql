import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let contextvar_qualified = select id from "qualified-name" where path = "contextvars.ContextVar";
let contextvar_subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_value_fields = select parent, child from "semantic-child" where field = "value";
let subscript_values = select l.parent as subscript, l.child as value from subscript_value_fields as l join contextvar_subscripts as r on l.parent = r.id;
let contextvar_subscript_calls = select l.subscript as id from subscript_values as l join contextvar_qualified as r on l.value = r.id;
let contextvar_functions = union(left=contextvar_qualified, right=contextvar_subscript_calls);
let contextvar_calls = select l.call as call from call_functions as l join contextvar_functions as r on l.function = r.id;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keyword_edges = select l.call as call, r.child as keyword from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let call_keywords = select l.call as call, l.keyword as keyword from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent as keyword, child from "semantic-child" where field = "arg";
let arg_tokens = select l.keyword as keyword, r.child as token from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let semantic_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifier_children = select r.child as id, l.name as name from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let identifiers = select l.id as id, l.name as name from identifier_children as l join semantic_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name from arg_tokens as l join identifiers as r on l.token = r.id;
let default_keywords = select keyword from keyword_names where name = "default";
let default_keyword_calls = select l.call as call, l.keyword as keyword from call_keywords as l join default_keywords as r on l.keyword = r.keyword;
let keyword_values = select parent as keyword, child as value from "semantic-child" where field = "value";
let defaults = select l.call as call, r.value as value from default_keyword_calls as l join keyword_values as r on l.keyword = r.keyword;
let selected_defaults = select l.call as call, l.value as value from defaults as l join contextvar_calls as r on l.call = r.call;
let mutable_expressions = select id from "semantic-syntax" where kind = "list" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "dict-comp" or kind = "set-comp";
let mutable_default_values = select l.call as call, l.value as value from selected_defaults as l join mutable_expressions as r on l.value = r.id;
let default_call_nodes = select id from "semantic-syntax" where kind = "call";
let default_calls = select l.call as contextvar_call, l.value as default_call from selected_defaults as l join default_call_nodes as r on l.value = r.id;
let default_call_functions = select l.contextvar_call as contextvar_call, l.default_call as default_call, r.child as function from default_calls as l join function_fields as r on l.default_call = r.parent;
let immutable_qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let immutable_names = select id from immutable_qualified_names where (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10) and (path = "datetime.date" or path = "datetime.datetime" or path = "datetime.time" or path = "datetime.timedelta" or path = "datetime.timezone" or path = "datetime.tzinfo" or path = "decimal.Decimal" or path = "fractions.Fraction" or path = "operator.attrgetter" or path = "operator.itemgetter" or path = "operator.methodcaller" or path = "pathlib.Path" or path = "types.MappingProxyType" or path = "re.compile" or path = "builtins.bool" or path = "builtins.bytes" or path = "builtins.complex" or path = "builtins.float" or path = "builtins.frozenset" or path = "builtins.int" or path = "builtins.range" or path = "builtins.str" or path = "builtins.tuple" or path = "builtins.slice" or path = "builtins.frozendict");
let direct_immutable_calls = select l.contextvar_call as call from default_call_functions as l join immutable_names as r on l.function = r.id;
let default_call_subscripts = select id from "semantic-syntax" where kind = "subscript";
let subscript_default_functions = select l.contextvar_call as contextvar_call, l.default_call as default_call, r.id as subscript from default_call_functions as l join default_call_subscripts as r on l.function = r.id;
let subscript_immutable_bases = select l.contextvar_call as contextvar_call, r.value as value from subscript_default_functions as l join subscript_values as r on l.subscript = r.subscript;
let immutable_subscript_calls = select l.contextvar_call as call from subscript_immutable_bases as l join immutable_names as r on l.value = r.id;
let immutable_calls = union(left=direct_immutable_calls, right=immutable_subscript_calls);
let unsafe_calls = antijoin(left=default_calls, right=immutable_calls, left-on=["contextvar_call"], right-on=["call"]);
let mutable_violations = select call, value from mutable_default_values;
let unsafe_call_values = select contextvar_call as call, default_call as value from unsafe_calls;
let reported_mutable = union(left=mutable_violations, right=unsafe_call_values);
let reportable_values = select l.value as id from reported_mutable as l;
let reportable = select l.id as id, r.file as file, r.span as span from reportable_values as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B039(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B039)(?:,|$)");
emit violations subject file key(id);
