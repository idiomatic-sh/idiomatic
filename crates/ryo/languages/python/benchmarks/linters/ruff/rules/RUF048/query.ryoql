import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let constants = select id, file from nodes where kind = "constant";
let argument_counts = group-count(from=all_arguments, keys=["call","file"], count="count", distinct="value");
let one_total_argument = select call, file from argument_counts where count = 1;
let two_total_arguments = select call, file from argument_counts where count = 2;
let keyword_calls = select related as call, file from keyword_owners;
let no_keyword_calls = antijoin(left=calls, right=keyword_calls, left-on=["id","file"], right-on=["call","file"]);
let two_positional_calls = select l.id as call, l.file as file from no_keyword_calls as l join two_total_arguments as r on l.id = r.call and l.file = r.file;
let first_arguments = select call, file, value from positional_arguments where position = 0;
let second_arguments = select call, file, value from positional_arguments where position = 1;
let attributes = select id, file from nodes where kind = "attribute";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_ids = select l.id as id, l.file as file, r.child as identifier from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let attr_names = select l.id as id, l.file as file, r.name as name from attr_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let maps = select call, file from qualified_calls where path = "builtins.map";
let binary_maps = select l.call as call, l.file as file from maps as l join two_positional_calls as r on l.call = r.call and l.file = r.file;
let map_first_values = select l.call as call, l.file as file, r.value as value from binary_maps as l join first_arguments as r on l.call = r.call and l.file = r.file;
let int_mappers = select l.call as call, l.file as file from map_first_values as l join "qualified-name" as r on l.value = r.id and l.file = r.file where r.path = "builtins.int";
let map_second_values = select l.call as call, l.file as file, r.value as split from int_mappers as l join second_arguments as r on l.call = r.call and l.file = r.file;
let one_argument_splits = select l.call as call, l.file as file, l.split as split from map_second_values as l join one_total_argument as r on l.split = r.call and l.file = r.file;
let split_separators = select call, file, value from named_keyword_values where name = "sep";
let keyword_or_positional_separators = union(left=split_separators, right=first_arguments);
let split_values = select l.call as call, l.file as file, l.split as split, r.value as separator from one_argument_splits as l join keyword_or_positional_separators as r on l.split = r.call and l.file = r.file;
let plain_strings = select l.occurrence as id, l.file as file, l.value as value from "string-literal" as l join constants as r on l.occurrence = r.id and l.file = r.file;
let dot_splits = select l.call as call, l.file as file, l.split as split from split_values as l join plain_strings as r on l.separator = r.id and l.file = r.file where r.value = ".";
let split_callees = select l.call as call, l.file as file, r.callee as callee from dot_splits as l join callee_nodes as r on l.split = r.call and l.file = r.file;
let named_split_callees = select l.call as call, l.file as file, l.callee as callee from split_callees as l join attr_names as r on l.callee = r.id and l.file = r.file where r.name = "split";
let version_receivers = select l.call as call, l.file as file, r.child as receiver from named_split_callees as l join value_edges as r on l.callee = r.parent and l.file = r.file;
let name_nodes = select id, file from nodes where kind = "name";
let named_version_roots = select l.id as id, l.file as file from name_nodes as l join "identifier" as r on l.id = r.id and l.file = r.file where r.name = "__version__";
let attributed_version_roots = select id, file from attr_names where name = "__version__";
let version_roots = union(left=named_version_roots, right=attributed_version_roots);
let version_maps = select l.call as call, l.file as file from version_receivers as l join version_roots as r on l.receiver = r.id and l.file = r.file;
let candidates = select l.call as id, l.file as file, r.span as span from version_maps as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF048(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF048)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF048(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF048)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF048"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
