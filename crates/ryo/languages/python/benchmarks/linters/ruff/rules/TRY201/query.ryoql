import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let statements = select id from "semantic-syntax" where glob_any(kind, "{function-def,async-function-def,class-def,return,delete,assign,type-alias,aug-assign,ann-assign,for,async-for,while,if,with,async-with,match,raise,try,assert,import,import-from,global,nonlocal,expr,pass,break,continue}");
let statement_ancestors = axis(from=statements, relation="semantic-child", direction=nearest-ancestor, domain=statements);
let statement_edges = select related as parent, id as child from statement_ancestors;
let tries = select id from "semantic-syntax" where kind = "try";
let ordinary_edges = antijoin(left=statement_edges, right=tries, left-on=["parent"], right-on=["id"]);
let try_body_fields = select parent, child from "semantic-child" where field = "body" or field = "finalbody";
let walked_statements = select l.id as parent, r.child as child from tries as l join try_body_fields as r on l.id = r.parent;
let try_edges = select l.parent as parent, r.child as child from walked_statements as l join statement_edges as r on l.child = r.parent;
let visit_edges = union(left=ordinary_edges, right=try_edges);
let handlers = select id from "semantic-syntax" where kind = "except-handler";
let body_fields = select parent, child from "semantic-child" where field = "body";
let handler_roots = select l.id as parent, r.child as child from handlers as l join body_fields as r on l.id = r.parent;
let traversal_edges = union(left=visit_edges, right=handler_roots);
let reachable = closure(edges=traversal_edges, source="parent", destination="child");
let name_fields = select parent, child from "semantic-child" where field = "name";
let named_handlers = select l.id as handler, r.child as alias from handlers as l join name_fields as r on l.id = r.parent;
let handler_names = select l.handler as handler, r.name as name from named_handlers as l join "identifier" as r on l.alias = r.id;
let raises = select id from "semantic-syntax" where kind = "raise";
let causes = select parent from "semantic-child" where field = "cause";
let unchained = antijoin(left=raises, right=causes, left-on=["id"], right-on=["parent"]);
let raised_fields = select parent, child from "semantic-child" where field = "exc";
let raised_names = select l.parent as statement, r.id as id, r.name as name, r.file as file, r.span as span from raised_fields as l join "identifier" as r on l.child = r.id;
let named_raises = select l.statement as statement, l.id as id, l.name as name, l.file as file, l.span as span from raised_names as l join unchained as r on l.statement = r.id;
let traversed_raises = select l.parent as handler, r.id as id, r.name as name, r.file as file, r.span as span from reachable as l join named_raises as r on l.child = r.statement;
let contributions = select l.handler as handler, l.id as id, l.file as file, l.span as span from traversed_raises as l join handler_names as r on l.handler = r.handler and l.name = r.name;
let reportable = select id, file, span from contributions;
let candidate_locations = line_located(candidates=reportable);
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:TRY201)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let attributed = select l.id as id, r.handler as handler, l.file as file, l.span as span from violations as l join contributions as r on l.id = r.id;
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "TRY201"});
observe ruf100_used as noqa_matches;
emit attributed subject file key(id, handler);
