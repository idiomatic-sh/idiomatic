import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import deferred_class_origins from "python/ruff/deferred-class-origins";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let statement_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "return" or kind = "delete" or kind = "assign" or kind = "type-alias" or kind = "aug-assign" or kind = "ann-assign" or kind = "for" or kind = "async-for" or kind = "while" or kind = "if" or kind = "with" or kind = "async-with" or kind = "match" or kind = "raise" or kind = "try" or kind = "try-star" or kind = "assert" or kind = "import" or kind = "import-from" or kind = "global" or kind = "nonlocal" or kind = "expr" or kind = "pass" or kind = "break" or kind = "continue";
let body_edges = select parent as owner, child as statement, field, ordinal, file from "semantic-child" where field = "body" or field = "orelse" or field = "finalbody";
let suites = select l.owner as owner, l.statement as statement, l.field as field, l.ordinal as ordinal, l.file as file from body_edges as l join statement_nodes as r on l.statement = r.id and l.file = r.file;
let suite_counts = group-count(from=suites, keys=["owner", "field", "file"], count="count", distinct="statement");
let multi_suites = select l.owner as owner, l.statement as statement, l.field as field, l.ordinal as ordinal, l.file as file from suites as l join suite_counts as r on l.owner = r.owner and l.field = r.field and l.file = r.file where r.count >= 2;
let passes = select id, file from nodes where kind = "pass";
let expressions = select id, file from nodes where kind = "expr";
let expression_values = select l.id as statement, r.child as value, l.file as file from expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let ellipsis_literals = select id, file from "literal-properties" where kind = "ellipsis";
let ellipsis_statements = select l.statement as id, l.file as file from expression_values as l join ellipsis_literals as r on l.value = r.id and l.file = r.file;
let placeholders = union(left=passes, right=ellipsis_statements);
let placeholder_statements = select l.owner as owner, l.statement as statement, l.field as field, l.ordinal as ordinal, l.file as file from multi_suites as l join placeholders as r on l.statement = r.id and l.file = r.file;
let classes = select id, file from nodes where kind = "class-def";
let protocol_names = select id, file from "qualified-name" where path = "typing.Protocol" or path = "typing_extensions.Protocol";
let bases = select declaration as class, occurrence as base, file from "inherits";
let direct_bases = select class, base as expression, file from bases;
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_bases = select l.class as class, l.base as subscript, l.file as file from bases as l join subscripts as r on l.base = r.id and l.file = r.file;
let mapped_bases = select l.class as class, r.child as expression, l.file as file from subscript_bases as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "value";
let base_expressions = union(left=direct_bases, right=mapped_bases);
let original_protocol_classes = select l.class as id, l.file as file from base_expressions as l join protocol_names as r on l.expression = r.id and l.file = r.file;
let stub_protocol_classes = select id, file from original_protocol_classes where matches(file, "\.pyi$");
let cached_protocol_classes = antijoin(left=original_protocol_classes, right=stub_protocol_classes, left-on=["id", "file"], right-on=["id", "file"]);
let stub_base_expressions = select expression as id, file from base_expressions where matches(file, "\.pyi$");
let late_base_origins = deferred_class_origins(expressions=stub_base_expressions);
let late_protocol_origins = select expression, file from late_base_origins where path = "typing.Protocol" or path = "typing_extensions.Protocol";
let late_protocol_classes = select l.class as id, l.file as file from base_expressions as l join late_protocol_origins as r on l.expression = r.expression and l.file = r.file;
let protocol_classes = union(left=cached_protocol_classes, right=late_protocol_classes);
let decorators = select declaration as function, occurrence as decorator, file from "decorates";
let decorator_roots = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let abstract_names = select id, file from "qualified-name" where path = "abc.abstractmethod" or path = "abc.abstractclassmethod" or path = "abc.abstractstaticmethod" or path = "abc.abstractproperty";
let abstract_functions = select l.function as id, l.file as file from decorator_roots as l join abstract_names as r on l.expression = r.id and l.file = r.file;
let protocol_abstract_scopes = union(left=protocol_classes, right=abstract_functions);
let ifs = select id, file from nodes where kind = "if";
let if_tests = select l.id as owner, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let tc_names = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_origins = select id, file from "qualified-name" where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let tc_flags = union(left=tc_names, right=tc_origins);
let simple_tc_ifs = select l.owner as owner, l.file as file from if_tests as l join tc_flags as r on l.test = r.id and l.file = r.file;
let attribute_labels = select parent as attribute, child as label, file from "semantic-child" where field = "attr";
let tc_attributes = select l.attribute as id, l.file as file from attribute_labels as l join tc_names as r on l.label = r.id and l.file = r.file;
let attribute_tc_ifs = select l.owner as owner, l.file as file from if_tests as l join tc_attributes as r on l.test = r.id and l.file = r.file;
let tc_ifs = union(left=simple_tc_ifs, right=attribute_tc_ifs);
let tc_bodies = select r.child as id, l.file as file from tc_ifs as l join "semantic-child" as r on l.owner = r.parent and l.file = r.file where r.field = "body";
let protected_scopes = union(left=protocol_abstract_scopes, right=tc_bodies);
let owners0 = group-count(from=multi_suites, keys=["owner", "file"], count="count", distinct="statement");
let owners = select owner as id, file from owners0;
let protected_owner_axes = axis(from=owners, relation="semantic-child", direction=ancestor, domain=protected_scopes);
let protected_owner_descendants = select id, file from protected_owner_axes;
let protected_owner_self = select l.id as id, l.file as file from owners as l join protected_scopes as r on l.id = r.id and l.file = r.file;
let protected_owners = union(left=protected_owner_descendants, right=protected_owner_self);
let protected_owner_suites = select l.owner as owner, l.statement as statement, l.field as field, l.ordinal as ordinal, l.file as file from multi_suites as l join protected_owners as r on l.owner = r.id and l.file = r.file;
let direct_tc_suites = select l.owner as owner, l.statement as statement, l.field as field, l.ordinal as ordinal, l.file as file from multi_suites as l join tc_ifs as r on l.owner = r.owner and l.file = r.file where l.field = "body";
let protected_suites = union(left=protected_owner_suites, right=direct_tc_suites);
let protected_ellipses = select l.owner as owner, l.field as field, l.ordinal as ordinal, l.file as file from protected_suites as l join ellipsis_statements as r on l.statement = r.id and l.file = r.file;
let stopped_placeholders = select l.statement as id, l.file as file from placeholder_statements as l join protected_ellipses as r on l.owner = r.owner and l.field = r.field and l.file = r.file where r.ordinal <= l.ordinal;
let reportable_rows = antijoin(left=placeholder_statements, right=stopped_placeholders, left-on=["statement", "file"], right-on=["id", "file"]);
let reportable = select statement as id, file from reportable_rows;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PIE790($|[, #])", range-pattern="(?:^|,)PIE790(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PIE790)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PIE790)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PIE790"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
