import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let lexical = select source, target, file from "token-link" as t where t."link-kind" = "next-token";
let starts = select source as id from lexical;
let ends = select target as id from lexical;
let ids = union(left=starts, right=ends);
let native = select l.id as id, r.kind as kind, r.text as text, r.file as file, r.span as span from ids as l join "syntax-tree" as r on l.id = r.id;
let significant = select id, kind, text, file, span from native where kind != "comment" and kind != "nl";
let backwards = select target as parent, source as child from lexical;
let following = axis(from=significant, relation=backwards, direction=nearest-ancestor, domain=significant);
let next_code = select id as source, related as target, file from following;
let incoming = select target as id from next_code;
let code_ids = select id from significant;
let roots = antijoin(left=code_ids, right=incoming, left-on=[id], right-on=[id]);
let locations = select id, "start-byte" as begin from "source-location";
let openings0 = select id, file, span from significant where kind = "lpar";
let openings = select l.id as id, l.file as file, l.span as span, r.begin as begin from openings0 as l join locations as r on l.id = r.id;
let following_openings = select l.id as outer_id, r.target as inner_id, l.file as file from openings as l join next_code as r on l.id = r.source;
let attempts = select l.outer_id as outer_id, l.inner_id as inner_id, l.file as file, r.begin as begin, r.span as start_span from following_openings as l join openings as r on l.inner_id = r.id;
let pairs = select source as inner_id, target as close_id from "token-link" as t where t."link-kind" = "matching-delimiter";
let grouped = select l.outer_id as outer_id, l.inner_id as inner_id, l.file as file, l.begin as begin, l.start_span as start_span, r.close_id as close_id from attempts as l join pairs as r on l.inner_id = r.inner_id;
let blocker_tokens = select id from significant where kind = "comma" or (kind = "name-token" and text = "yield");
let enclosure = select source as id, target as inner_id from "token-link" as t where t."link-kind" = "enclosing-delimiter";
let blockers0 = select l.id as id, r.inner_id as inner_id from blocker_tokens as l join enclosure as r on l.id = r.id;
let blockers = select l.id as id, l.inner_id as inner_id, r.begin as begin from blockers0 as l join locations as r on l.id = r.id;
let blocked = ordered-match(left=grouped, right=blockers, left-on=[inner_id], right-on=[inner_id], left-order="begin", right-order="begin", output={outer_id:[left,outer_id],consumed:[right,id]});
let unblocked = antijoin(left=grouped, right=blocked, left-on=[outer_id], right-on=[outer_id]);
let inner_first = select l.outer_id as outer_id, r.target as first_id from unblocked as l join next_code as r on l.inner_id = r.source;
let empty = select l.outer_id as outer_id, l.close_id as consumed from unblocked as l join inner_first as r on l.outer_id = r.outer_id where l.close_id = r.first_id;
let nonempty = antijoin(left=unblocked, right=empty, left-on=[outer_id], right-on=[outer_id]);
let completed = select l.outer_id as outer_id, l.inner_id as inner_id, l.close_id as close_id, l.file as file, l.start_span as start_span, r.target as consumed from nonempty as l join next_code as r on l.close_id = r.source;
let not_nested = antijoin(left=following_openings, right=attempts, left-on=[outer_id], right-on=[outer_id]);
let simple_consumed = select outer_id, inner_id as consumed from not_nested;
let completed_consumed = select outer_id, consumed from completed;
let stopped0 = union(left=blocked, right=empty);
let stopped1 = union(left=stopped0, right=simple_consumed);
let stopped = union(left=stopped1, right=completed_consumed);
let special_steps = select l.outer_id as parent, r.target as child from stopped as l join next_code as r on l.consumed = r.source;
let non_open = select id from significant where kind != "lpar";
let ordinary_steps = select l.source as parent, l.target as child from next_code as l join non_open as r on l.source = r.id;
let steps = union(left=ordinary_steps, right=special_steps);
let visited0 = axis(from=roots, relation=steps, direction=descendant, domain=code_ids);
let visited_ids = select related as id from visited0;
let visited = union(left=roots, right=visited_ids);
let closing = select id from significant where kind = "rpar";
let candidates = select l.outer_id as outer_id, l.inner_id as id, l.close_id as close_id, l.file as file, l.start_span as start_span from completed as l join closing as r on l.consumed = r.id;
let reached = select l.id as id, l.close_id as close_id, l.file as file, l.start_span as start_span from candidates as l join visited as r on l.outer_id = r.id;
let bounds = select l.id as id, l.file as file, l.start_span as start_span, r.span as end_span from reached as l join significant as r on l.close_id = r.id;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let findings = select l.id as id, l.file as file, l.span as span, r."start-line" as line from composed as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=findings, inline-pattern="(?:^|[^A-Z0-9])UP034(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP034(?:,|$)");
let ruf100_matches = observation_matches(candidates=findings, inline-pattern="(?:^|[^A-Z0-9])UP034(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP034(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP034"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
