import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress-unmapped";
let lambdas = select id, file, span from "semantic-syntax" where kind = "lambda";
let argument_fields = select parent, child from "semantic-child" where field = "args";
let lambda_arguments = select l.parent as lambda, l.child as arguments, r.file as file from argument_fields as l join lambdas as r on l.parent = r.id;
let parameter_fields = select parent, child, file from "semantic-child" where field = "posonlyargs" or field = "args" or field = "kwonlyargs" or field = "vararg" or field = "kwarg";
let parameter_children = select l.lambda as lambda, l.file as file from lambda_arguments as l join parameter_fields as r on l.arguments = r.parent and l.file = r.file;
let no_parameters = antijoin(left=lambdas,right=parameter_children,left-on=["id","file"],right-on=["lambda","file"]);
let body_fields = select parent, child from "semantic-child" where field = "body";
let lambda_bodies = select l.parent as lambda, l.child as body, r.file as file from body_fields as l join no_parameters as r on l.parent = r.id;
let empty_lists = select id, file from "semantic-syntax" where kind = "list";
let list_elements = select parent, file from "semantic-child" where field = "elts";
let empty_list_nodes = antijoin(left=empty_lists,right=list_elements,left-on=["id","file"],right-on=["parent","file"]);
let empty_dicts = select id, file from "semantic-syntax" where kind = "dict";
let dict_keys = select parent, file from "semantic-child" where field = "keys";
let empty_dict_nodes = antijoin(left=empty_dicts,right=dict_keys,left-on=["id","file"],right-on=["parent","file"]);
let empty_literals = union(left=empty_list_nodes,right=empty_dict_nodes);
let candidates = select l.lambda as id, l.file as file from lambda_bodies as l join empty_literals as r on l.body = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from candidates as l join lambdas as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PIE807(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PIE807)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PIE807)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PIE807)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PIE807"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
