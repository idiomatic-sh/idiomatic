import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let qualified_names = select id, path, provenance, "since-major" as since_major, "since-minor" as since_minor from "qualified-name";
let qualified = select id, path from qualified_names where path = "builtins.setattr" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let builtin_calls = select l.parent as id, r.path as path from functions as l join qualified as r on l.child = r.id;
let call_wrappers = select parent, child from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as wrapper from call_wrappers as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.wrapper = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let counts = group-count(from=positional, keys=["call"], count="count", distinct="id");
let exact_counts = select call from counts where count = 3;
let exact_calls = select l.id as id from builtin_calls as l join exact_counts as r on l.id = r.call;
let first_arguments = select call, id from positional where ordinal = 0;
let starred_nodes = select id from "semantic-syntax" where kind = "starred";
let starred_arguments = select l.call as call from first_arguments as l join starred_nodes as r on l.id = r.id;
let unstarred_calls = antijoin(left=exact_calls, right=starred_arguments, left-on=["id"], right-on=["call"]);
let arg_one = select call, id from positional where ordinal = 1;
let constant_nodes = select id from "semantic-syntax" where kind = "constant";
let string_literal_facts = select occurrence, value from "string-literal";
let string_literals = select l.occurrence as occurrence, l.value as value from string_literal_facts as l join constant_nodes as r on l.occurrence = r.id;
let named_literals = select l.call as call, l.id as argument, r.value as value from arg_one as l join string_literals as r on l.id = r.occurrence;
let valid_identifier_strings = select call, argument, value from named_literals where matches(value, "^[_\p{XID_Start}][_\p{XID_Continue}]*$");
let invalid_keywords = select call, argument, value from valid_identifier_strings where value = "False" or value = "None" or value = "True" or value = "and" or value = "as" or value = "assert" or value = "async" or value = "await" or value = "break" or value = "class" or value = "continue" or value = "def" or value = "del" or value = "elif" or value = "else" or value = "except" or value = "finally" or value = "for" or value = "from" or value = "global" or value = "if" or value = "import" or value = "in" or value = "is" or value = "lambda" or value = "nonlocal" or value = "not" or value = "or" or value = "pass" or value = "raise" or value = "return" or value = "try" or value = "while" or value = "with" or value = "yield";
let nonkeywords = antijoin(left=valid_identifier_strings, right=invalid_keywords, left-on=["call", "argument"], right-on=["call", "argument"]);
let mangled_starts = select call, argument, value from nonkeywords where matches(value, "^__");
let nonmangled_ends = select call, argument, value from nonkeywords where matches(value, "__$");
let mangled_names = antijoin(left=mangled_starts, right=nonmangled_ends, left-on=["call", "argument"], right-on=["call", "argument"]);
let valid_names = antijoin(left=nonkeywords, right=mangled_names, left-on=["call", "argument"], right-on=["call", "argument"]);
let debug_names = select call, argument from valid_names where value = "__debug__";
let non_debug_names = antijoin(left=valid_names, right=debug_names, left-on=["call", "argument"], right-on=["call", "argument"]);
let expression_statements = select id, file from "semantic-syntax" where kind = "expr";
let statement_values = select parent, child from "semantic-child" where field = "value";
let direct_expression_calls = select l.child as call from statement_values as l join expression_statements as r on l.parent = r.id;
let eligible_unstarred_calls = select l.id as id from unstarred_calls as l join direct_expression_calls as r on l.id = r.call;
let matching_names = select l.call as id from non_debug_names as l join eligible_unstarred_calls as r on l.call = r.id;
let reportable = select l.id as id, r.file as file, r.span as span from matching_names as l join calls as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B010(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B010)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B010(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B010)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B010"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
