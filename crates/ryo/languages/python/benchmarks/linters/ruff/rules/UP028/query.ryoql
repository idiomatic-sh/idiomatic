import observation_matches from "python/ruff/suppress-unmapped-matches";
import suppress from "python/ruff/suppress-unmapped";
let loops = select id, file, span from "semantic-syntax" where kind = "for";
let body_fields = select parent, child, ordinal from "semantic-child" where field = "body";
let loop_bodies = select l.parent as loop, l.child as body, r.file as file from body_fields as l join loops as r on l.parent = r.id;
let multiple_bodies = select l.loop as loop, l.body as body from loop_bodies as l join loop_bodies as r on l.loop = r.loop where l.body != r.body;
let single_body_loops = antijoin(left=loop_bodies,right=multiple_bodies,left-on=["loop","body"],right-on=["loop","body"]);
let expr_statements = select id, file from "semantic-syntax" where kind = "expr";
let expression_bodies = select l.loop as loop, l.body as statement, l.file as file from single_body_loops as l join expr_statements as r on l.body = r.id and l.file = r.file;
let statement_values = select parent, child from "semantic-child" where field = "value";
let yield_nodes = select id, file from "semantic-syntax" where kind = "yield";
let yielded = select l.parent as statement, l.child as yield from statement_values as l join yield_nodes as r on l.child = r.id;
let body_yields = select l.loop as loop, r.yield as yield, l.file as file from expression_bodies as l join yielded as r on l.statement = r.statement;
let yield_values = select parent, child from "semantic-child" where field = "value";
let loop_targets = select parent, child from "semantic-child" where field = "target";
let target_nodes = select l.parent as loop, l.child as target, r.file as file from loop_targets as l join loops as r on l.parent = r.id;
let yielded_values = select l.loop as loop, r.child as value, l.file as file from body_yields as l join yield_values as r on l.yield = r.parent;
let expression_roots = select id, file from "semantic-syntax" where kind = "name" or kind = "tuple";
let target_shape_roots = select l.loop as loop, l.target as id, l.file as file from target_nodes as l join expression_roots as r on l.target = r.id and l.file = r.file;
let shapes = select id, shape, file from "expression-shape";
let shaped_targets = select l.loop as loop, r.shape as shape, l.file as file from target_shape_roots as l join shapes as r on l.id = r.id and l.file = r.file;
let shaped_values = select l.loop as loop, r.shape as shape, l.file as file from yielded_values as l join shapes as r on l.value = r.id and l.file = r.file;
let matching_shapes = select l.loop as loop, l.file as file from shaped_targets as l join shaped_values as r on l.loop = r.loop and l.file = r.file and l.shape = r.shape;
let for_elses = select parent as loop from "semantic-child" where field = "orelse";
let without_else = antijoin(left=matching_shapes,right=for_elses,left-on=["loop"],right-on=["loop"]);
let function_defs = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let async_functions = select id, file from "semantic-syntax" where kind = "async-function-def";
let nearest_functions = axis(from=loops,relation="semantic-child",direction=nearest-ancestor,domain=function_defs);
let async_loops = select l.id as loop from nearest_functions as l join async_functions as r on l.related = r.id and l.file = r.file;
let synchronous = antijoin(left=without_else,right=async_loops,left-on=["loop"],right-on=["loop"]);
let all_shapes = select id, shape, file from "expression-shape";
let target_descendants = axis(from=target_shape_roots,relation="semantic-child",direction=descendant,domain=all_shapes);
let target_allowed_descendants = axis(from=target_shape_roots,relation="semantic-child",direction=descendant,domain=expression_roots);
let target_unsupported_descendants = antijoin(left=target_descendants,right=target_allowed_descendants,left-on=["related","file"],right-on=["related","file"]);
let unsupported_targets = select loop from target_unsupported_descendants;
let supported_shapes = antijoin(left=synchronous,right=unsupported_targets,left-on=["loop"],right-on=["loop"]);
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let target_name_axes = axis(from=target_shape_roots,relation="semantic-child",direction=descendant,domain=name_nodes);
let target_descendant_names = select loop, related as id, file from target_name_axes;
let target_root_names = select l.loop as loop, r.id as id, l.file as file from target_shape_roots as l join name_nodes as r on l.id = r.id and l.file = r.file;
let target_name_nodes = union(left=target_descendant_names,right=target_root_names);
let yield_shape_roots = select l.loop as loop, l.value as id, l.file as file from yielded_values as l join expression_roots as r on l.value = r.id and l.file = r.file;
let yield_name_axes = axis(from=yield_shape_roots,relation="semantic-child",direction=descendant,domain=name_nodes);
let yield_descendant_names = select loop, related as id, file from yield_name_axes;
let yield_root_names = select l.loop as loop, r.id as id, l.file as file from yield_shape_roots as l join name_nodes as r on l.id = r.id and l.file = r.file;
let yield_name_nodes = union(left=yield_descendant_names,right=yield_root_names);
let loop_bind_events = select occurrence, name, scope, file from "binding-event" where kind = "bind";
let target_bindings = select l.loop as loop, l.id as target_name, r.name as name, r.scope as scope, r.file as file from target_name_nodes as l join loop_bind_events as r on l.id = r.occurrence and l.file = r.file;
let same_name_bindings = select l.loop as loop, l.target_name as target_name, r.occurrence as binding, l.file as file from target_bindings as l join loop_bind_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let all_binding_uses = select l.loop as loop, l.target_name as target_name, l.file as file, r.reference as reference from same_name_bindings as l join "binding-use" as r on l.binding = r.binding and l.file = r.file;
let yielded_binding_uses = select l.loop as loop, l.target_name as target_name, l.file as file, l.reference as reference from all_binding_uses as l join yield_name_nodes as r on l.loop = r.loop and l.reference = r.id and l.file = r.file;
let external_uses = antijoin(left=all_binding_uses,right=yielded_binding_uses,left-on=["loop","target_name","reference","file"],right-on=["loop","target_name","reference","file"]);
let loops_with_external_uses = select loop from external_uses;
let no_external_uses = antijoin(left=supported_shapes,right=loops_with_external_uses,left-on=["loop"],right-on=["loop"]);
let reportable = select l.loop as id, r.file as file, r.span as span from no_external_uses as l join loops as r on l.loop = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP028(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP028)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP028(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP028)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP028"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
