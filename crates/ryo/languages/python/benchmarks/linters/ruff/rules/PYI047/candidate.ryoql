import suppress from "python/ruff/suppress";
let definitions = select id as binding, kind, refinement, name, owner as scope, file, span from "defines";
let private_definitions = select * from definitions where starts_with(name, "_");
let uses = select binding, file from "binding-use";
let unused_private = antijoin(left=private_definitions, right=uses, left-on=["binding", "file"], right-on=["binding", "file"]);
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let ordinary_scopes = select id, file from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def";
let ordinary_scope_definitions = select l.binding as binding, l.file as file from unused_private as l join ordinary_scopes as r on l.scope = r.id and l.file = r.file;
let stub_definitions = select l.binding as binding, l.file as file from unused_private as l join stub_files as r on l.file = r.file;
let permitted_definitions = union(left=ordinary_scope_definitions, right=stub_definitions);
let eligible_private = select l.binding as binding, l.file as file, r.kind as kind from permitted_definitions as l join unused_private as r on l.binding = r.binding and l.file = r.file;
let annotated_assignments = select id, file from "semantic-syntax" where kind = "ann-assign";
let alias_annotations = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let annotation_fields = select parent as assignment, child as annotation, file from "semantic-child" where field = "annotation";
let typed_alias_annotations = select l.assignment as assignment, l.file as file from annotation_fields as l join alias_annotations as r on l.annotation = r.id and l.file = r.file;
let typed_alias_statements = select l.id as statement, l.file as file from annotated_assignments as l join typed_alias_annotations as r on l.id = r.assignment and l.file = r.file;
let target_fields = select parent as statement, child as target, file from "semantic-child" where field = "target";
let private_alias_targets = select l.binding as id, r.statement as statement, l.file as file from eligible_private as l join target_fields as r on l.binding = r.target and l.file = r.file where l.kind = "variable";
let annotated_alias_names = select l.id as id, l.file as file from private_alias_targets as l join typed_alias_statements as r on l.statement = r.statement and l.file = r.file;
let type_alias_nodes = select id, file from "semantic-syntax" where kind = "type-alias";
let type_alias_names = select parent as statement, child as target, file from "semantic-child" where field = "name";
let private_type_alias_targets = select l.binding as id, r.statement as statement, l.file as file from eligible_private as l join type_alias_names as r on l.binding = r.target and l.file = r.file where l.kind = "type-alias";
let unused_type_alias_names = select l.id as id, l.file as file from private_type_alias_targets as l join type_alias_nodes as r on l.statement = r.id and l.file = r.file;
let all_alias_names = union(left=annotated_alias_names, right=unused_type_alias_names);
let candidates = select l.id as id, l.file as file, r.span as span from all_alias_names as l join definitions as r on l.id = r.binding and l.file = r.file;
let locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI047(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI047(?:,|$)");
emit violations subject file key(id);
