import suppress from "python/ruff/suppress";
let breaks = select id from "semantic-syntax" where kind = "break";
let loops = select id from "semantic-syntax" where kind = "for" or kind = "async-for" or kind = "while";
let body_edges = select parent, child from "semantic-child" where field = "body";
let loop_bodies = select r.child as id, l.id as loop from loops as l join body_edges as r on l.id = r.parent;
let non_boundaries = select id from "semantic-syntax" where kind != "function-def" and kind != "async-function-def" and kind != "class-def" and kind != "lambda";
let body_nodes = select l.id as id, l.loop as loop from loop_bodies as l join non_boundaries as r on l.id = r.id;
let body_boundaries = select id from body_nodes;
let scope_nodes = select id from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let boundaries = union(left=body_boundaries, right=scope_nodes);
let direct = select l.id as id, r.loop as loop from breaks as l join body_nodes as r on l.id = r.id;
let other_breaks = antijoin(left=breaks, right=direct, left-on=["id"], right-on=["id"]);
let ancestors = axis(from=other_breaks, relation="semantic-child", direction=nearest-ancestor, domain=boundaries);
let nested = select l.id as id, r.loop as loop from ancestors as l join body_nodes as r on l.related = r.id;
let exits = union(left=direct, right=nested);
let no_exit = antijoin(left=loops, right=exits, left-on=["id"], right-on=["loop"]);
let children = select r.child as child from no_exit as l join "semantic-child" as r on l.id = r.parent;
let keywords = select id, file, span from "semantic-syntax" where kind = "name-token" and text = "else";
let reportable = select r.id as id, r.file as file, r.span as span from children as l join keywords as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0120(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0120)(?:,|$)");
emit violations subject file key(id);
