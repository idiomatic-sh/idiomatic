import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let logger_methods = select id from "qualified-name" where path = "logging.debug" or path = "logging.info" or path = "logging.warn" or path = "logging.warning" or path = "logging.error" or path = "logging.critical" or path = "logging.log" or path = "logging.exception";
let root_logger_calls = select l.call as id from call_functions as l join logger_methods as r on l.function = r.id;
let candidate_rows = select l.id as id, r.file as file, r.span as span from root_logger_calls as l join calls as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidate_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*LOG015(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:LOG015)(?:,|$)");
emit violations subject file key(id);
