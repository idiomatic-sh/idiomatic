import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let type_parameter_edges = select parent, child, file from "semantic-child" where field = "type-params";
let generic_classes = select l.id as id, l.file as file from classes as l join type_parameter_edges as r on l.id = r.parent and l.file = r.file;
let bases = select occurrence as id, declaration as class, file from "inherits";
let generic_class_bases = select l.id as id, l.class as class, l.file as file from bases as l join generic_classes as r on l.class = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_bases = select l.id as id, l.class as class, l.file as file from generic_class_bases as l join subscripts as r on l.id = r.id and l.file = r.file;
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let generic_origins = select id, file from "qualified-name" where path = "typing.Generic" or path = "typing_extensions.Generic";
let generic_bases_join_1 = select l.id as l_id, l.class as l_class, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from subscript_bases as l join value_edges as e on l.id = e.parent and l.file = e.file;
let generic_bases = select l.l_id as id, l.l_class as class, l.l_file as file from generic_bases_join_1 as l join generic_origins as r on l.e_child = r.id and l.e_file = r.file;
let ordered_bases = select l.id as id, l.class as class, l.file as file, r."start-byte" as begin from generic_bases as l join "source-location" as r on l.id = r.id and l.file = r.file;
let later_bases = select l.id as id, l.file as file from ordered_bases as l join ordered_bases as r on l.class = r.class and l.file = r.file where l.begin > r.begin;
let first_bases = antijoin(left=ordered_bases, right=later_bases, left-on=["id","file"], right-on=["id","file"]);
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from first_bases as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF053(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF053)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF053(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF053)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF053"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
