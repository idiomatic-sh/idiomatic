import observation_matches from "python/ruff/suppress-matches";
import negated_comparisons from "python/ruff/negated-comparisons";
let candidate_locations = negated_comparisons(operator="==");
let violations_matches = observation_matches(candidates=candidate_locations, code="SIM201");
let violations = antijoin(left=candidate_locations, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","SIM201") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
