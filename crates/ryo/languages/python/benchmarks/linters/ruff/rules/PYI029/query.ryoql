import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let functions = select id, file, span from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let stub_functions = select l.id as id, l.file as file, l.span as span from functions as l join stub_files as r on l.file = r.file;
let names = select parent, child, file from "semantic-child" where field = "name";
let ids = select id, name, file from "identifier";
let named = select l.parent as function, l.child as name, r.name as text, l.file as file from names as l join ids as r on l.child = r.id and l.file = r.file;
let target_names = select function, name, file from named where text = "__str__" or text = "__repr__";
let stub_names = select l.function as function, l.name as name, l.file as file from target_names as l join stub_functions as r on l.function = r.id and l.file = r.file;
let returns = select parent as function, child as annotation, file from "semantic-child" where field = "returns";
let string_returns = select l.function as function, l.file as file from returns as l join "qualified-name" as r on l.annotation = r.id and l.file = r.file where r.path = "builtins.str";
let args_edges = select l.parent as function, l.child as args, l.file as file from "semantic-child" as l join stub_functions as r on l.parent = r.id and l.file = r.file where l.field = "args";
let args_nodes = select id, file from "semantic-syntax" where kind = "arguments";
let args = select l.function as function, r.id as args, l.file as file from args_edges as l join args_nodes as r on l.args = r.id and l.file = r.file;
let positional = select parent as args, child as parameter, file from "semantic-child" where field = "args" or field = "posonlyargs";
let positional_counts = group-count(from=positional, keys=["args", "file"], count="count", distinct="parameter");
let too_many = select args, file from positional_counts where count > 1;
let too_many_functions = select l.function as function, l.file as file from args as l join too_many as r on l.args = r.args and l.file = r.file;
let kwonly = select parent as args, child as parameter, file from "semantic-child" where field = "kwonlyargs";
let kwonly_functions = select l.function as function, l.file as file from args as l join kwonly as r on l.args = r.args and l.file = r.file;
let signature_ok = antijoin(left=stub_names, right=too_many_functions, left-on=["function", "file"], right-on=["function", "file"]);
let no_kwonly = antijoin(left=signature_ok, right=kwonly_functions, left-on=["function", "file"], right-on=["function", "file"]);
let decorated = select parent as function, child as decorators, file from "semantic-child" where field = "decorator-list";
let decorator_names = select l.parent as decorators, l.child as decorator, l.file as file from "semantic-child" as l join decorated as r on l.parent = r.decorators and l.file = r.file;
let abstract_names = select id, file from "qualified-name" where path = "abc.abstractmethod" or path = "typing.abstractmethod" or path = "typing_extensions.abstractmethod";
let decorator_functions = select l.function as function, n.decorator as decorator, l.file as file from decorated as l join decorator_names as n on l.decorators = n.decorators and l.file = n.file;
let abstract_methods = select l.function as function, l.file as file from decorator_functions as l join abstract_names as r on l.decorator = r.id and l.file = r.file;
let concrete_methods = antijoin(left=no_kwonly, right=abstract_methods, left-on=["function", "file"], right-on=["function", "file"]);
let target_string_names = select name as id, function, file from stub_names;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_ancestors = axis(from=stub_functions, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let eligible_methods = select l.id as id, l.function as function, l.file as file from target_string_names as l join concrete_methods as r on l.function = r.function and l.file = r.file;
let class_methods = select l.id as id, l.function as function, l.file as file from eligible_methods as l join class_ancestors as c on l.function = c.id and l.file = c.file;
let with_string_return = select l.id as id, l.function as function, l.file as file from class_methods as l join string_returns as r on l.function = r.function and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from with_string_return as l join "source-location" as r on l.id = r.id and l.file = r.file;
let locations = select r.id as id, r.file as file, r."start-line" as line from "source-location" as r;
let candidates = select l.id as id, l.file as file, l.span as span, r.line as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI029(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI029)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI029)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI029)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI029"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
