import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = call_syntax();
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let constants = select id, file from nodes where kind = "constant";
let attributes = select id, file from nodes where kind = "attribute";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_ids = select l.id as id, l.file as file, r.child as identifier from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let attr_names = select l.id as id, l.file as file, r.name as name from attr_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let method_callees = select l.call as call, l.file as file, l.callee as callee, r.name as name from callee_nodes as l join attr_names as r on l.callee = r.id and l.file = r.file;
let method_calls = select l.call as call, l.file as file, l.name as name, r.child as receiver from method_callees as l join value_edges as r on l.callee = r.parent and l.file = r.file;
let resolve_calls = select call, file, receiver from method_calls where name = "resolve";
let empty_resolvers = select l.call as call, l.file as file, l.receiver as constructor from resolve_calls as l join empty_calls as r on l.call = r.id and l.file = r.file;
let path_calls = select call, file from qualified_calls where path = "pathlib.Path";
let no_positional_paths = antijoin(left=path_calls, right=positional_arguments, left-on=["call","file"], right-on=["call","file"]);
let plain_strings = select l.occurrence as id, l.file as file, l.value as value from "string-literal" as l join constants as r on l.occurrence = r.id and l.file = r.file;
let single_path_arguments = select l.call as call, l.file as file, r.value as value from path_calls as l join single_arguments as r on l.call = r.call and l.file = r.file;
let cwd_path_arguments = select l.call as call, l.file as file from single_path_arguments as l join plain_strings as r on l.value = r.id and l.file = r.file where r.value = "" or r.value = ".";
let cwd_paths = union(left=no_positional_paths, right=cwd_path_arguments);
let cwd_resolvers = select l.call as call, l.file as file from empty_resolvers as l join cwd_paths as r on l.constructor = r.call and l.file = r.file;
let candidates = select l.call as id, l.file as file, r.span as span from cwd_resolvers as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB177)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB177"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
