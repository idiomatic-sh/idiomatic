import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
import keyword_argument_names from "python/ruff/call-keywords";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let positional_places = group-ordinal(from=positional_ordered, keys=["call"], order="ordinal", output="place");
let positional = select call, id, place as ordinal from positional_places;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let keyword_names = keyword_argument_names(keywords=keywords, identifiers=semantic_identifiers);
let qualified = select id, path from "qualified-name" where path = "trio.sleep" or path = "anyio.sleep";
let matching_calls = select l.parent as id, r.path as path from functions as l join qualified as r on l.child = r.id;
let positional_ids = select call, id from positional;
let all_arguments = union(left=positional_ids, right=keywords);
let counts = group-count(from=all_arguments, keys=["call"], count="count", distinct="id");
let single = select call from counts where count = 1;
let one_argument = select l.id as id, l.path as path from matching_calls as l join single as r on l.id = r.call;
let first_args = select call, id from positional where ordinal = 0;
let relevant_positional = select l.call as call, l.id as id from first_args as l join one_argument as r on l.call = r.id;
let relevant_keywords = select l.call as call, l.id as id from keyword_names as l join one_argument as r on l.call = r.id where r.path = "trio.sleep" and l.name = "seconds" or r.path = "anyio.sleep" and l.name = "delay";
let values = select parent, child from "semantic-child" where field = "value";
let keyword_values = select l.call as call, r.child as id from relevant_keywords as l join values as r on l.id = r.parent;
let arguments = union(left=relevant_positional, right=keyword_values);
let zero_literals = select id from "numeric-literal" where kind = "integer" and value = "0";
let invalid = select l.call as id from arguments as l join zero_literals as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from calls as l join invalid as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:ASYNC115|TRIO115)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "ASYNC115"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
