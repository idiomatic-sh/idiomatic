import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def";
let classes = select id, file from nodes where kind = "class-def";
let class_scope = select l.child as function, l.file as file from "scope" as l join classes as r on l.parent = r.id and l.file = r.file;
let names = select id as function, name, file from "defines" where name = "__iter__" or name = "__aiter__";
let sync_named_functions = select l.id as function, r.name as name, l.file as file from functions as l join names as r on l.id = r.function and l.file = r.file;
let methods = select l.function as function, l.name as name, l.file as file from sync_named_functions as l join class_scope as r on l.function = r.function and l.file = r.file;
let arguments = select l.function as function, l.name as name, r.child as arguments, l.file as file from methods as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "args";
let positional_edges = select parent as arguments, child as parameter, file from "semantic-child" where field = "args" or field = "posonlyargs";
let positional_counts = group-count(from=positional_edges, keys=["arguments", "file"], count="count", distinct="parameter");
let one_parameter_methods = select l.function as function, l.name as name, l.arguments as arguments, l.file as file from arguments as l join positional_counts as r on l.arguments = r.arguments and l.file = r.file where r.count = 1;
let extra_parameters = select parent as arguments, file from "semantic-child" where field = "vararg" or field = "kwarg" or field = "kwonlyargs";
let shaped_methods = antijoin(left=one_parameter_methods, right=extra_parameters, left-on=["arguments", "file"], right-on=["arguments", "file"]);
let returns = select l.function as function, l.name as name, r.child as annotation, l.file as file from shaped_methods as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "returns";
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as subscript, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let bare_returns = antijoin(left=returns, right=subscripts, left-on=["annotation", "file"], right-on=["id", "file"]);
let bare_return_values = select function, name, annotation, annotation as value, file from bare_returns;
let mapped_return_values = select l.function as function, l.name as name, l.annotation as annotation, r.value as value, l.file as file from returns as l join subscript_values as r on l.annotation = r.subscript and l.file = r.file;
let return_values = union(left=bare_return_values, right=mapped_return_values);
let generators = select id, path, file from "qualified-name" where path = "typing.Generator" or path = "typing_extensions.Generator" or path = "collections.abc.Generator" or path = "typing.AsyncGenerator" or path = "typing_extensions.AsyncGenerator" or path = "collections.abc.AsyncGenerator";
let generator_returns = select l.function as function, l.name as name, l.annotation as annotation, r.path as path, l.file as file from return_values as l join generators as r on l.value = r.id and l.file = r.file;
let matching_returns = select function, name, annotation, file from generator_returns where name = "__iter__" and (path = "typing.Generator" or path = "typing_extensions.Generator" or path = "collections.abc.Generator") or name = "__aiter__" and (path = "typing.AsyncGenerator" or path = "typing_extensions.AsyncGenerator" or path = "collections.abc.AsyncGenerator");
let subscript_returns = select l.function as function, l.name as name, l.annotation as annotation, l.file as file from matching_returns as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let bare_generator_returns = antijoin(left=matching_returns, right=subscripts, left-on=["annotation", "file"], right-on=["id", "file"]);
let slices = select l.function as function, l.name as name, l.annotation as annotation, r.child as slice, l.file as file from subscript_returns as l join "semantic-child" as r on l.annotation = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.function as function, l.name as name, l.annotation as annotation, l.slice as slice, l.file as file from slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let elements = select parent as tuple, child as member, ordinal, file from "semantic-child" where field = "elts";
let element_counts = group-count(from=elements, keys=["tuple", "file"], count="count", distinct="member");
let shaped_slices = select l.function as function, l.name as name, l.annotation as annotation, l.slice as slice, l.file as file from tuple_slices as l join element_counts as r on l.slice = r.tuple and l.file = r.file where l.name = "__iter__" and r.count = 3 or l.name = "__aiter__" and r.count = 2;
let element_pairs = select l.tuple as tuple, r.member as member, l.file as file from elements as l join elements as r on l.tuple = r.tuple and l.file = r.file where l.ordinal < r.ordinal;
let nonfirst_elements = group-count(from=element_pairs, keys=["tuple", "member", "file"], count="count", distinct="member");
let slice_tail_elements = select l.function as function, r.member as member, l.file as file from shaped_slices as l join nonfirst_elements as r on l.slice = r.tuple and l.file = r.file;
let nulls = select id, file from "literal-properties" where kind = "null";
let any_names = select id, file from "qualified-name" where path = "typing.Any" or path = "typing_extensions.Any";
let any_or_none = union(left=nulls, right=any_names);
let bad_slice_tails = antijoin(left=slice_tail_elements, right=any_or_none, left-on=["member", "file"], right-on=["id", "file"]);
let valid_subscript_returns = antijoin(left=shaped_slices, right=bad_slice_tails, left-on=["function", "file"], right-on=["function", "file"]);
let valid_subscript_rows = select function, name, annotation, file from valid_subscript_returns;
let annotated_methods = union(left=bare_generator_returns, right=valid_subscript_rows);
let body_children = select l.function as function, r.child as statement, l.file as file from annotated_methods as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "body";
let body_statements = select l.function as function, l.statement as statement, r.kind as kind, l.file as file from body_children as l join nodes as r on l.statement = r.id and l.file = r.file;
let simple_statement_kinds = select function, statement, file from body_statements where kind = "pass" or kind = "return" or kind = "expr";
let unsupported_statements = antijoin(left=body_statements, right=simple_statement_kinds, left-on=["function", "statement", "file"], right-on=["function", "statement", "file"]);
let expression_statements = select function, statement, file from body_statements where kind = "expr";
let expression_values = select l.function as function, l.statement as statement, r.child as value, l.file as file from expression_statements as l join "semantic-child" as r on l.statement = r.parent and l.file = r.file where r.field = "value";
let yield_expressions = select id, file from nodes where kind = "yield" or kind = "yield-from";
let string_ellipsis = select id, file from "literal-properties" where kind = "string" or kind = "ellipsis";
let allowed_expression_values = union(left=yield_expressions, right=string_ellipsis);
let bad_expression_statements = antijoin(left=expression_values, right=allowed_expression_values, left-on=["value", "file"], right-on=["id", "file"]);
let body_yields = select l.function as function, l.statement as statement, l.file as file from expression_values as l join yield_expressions as r on l.value = r.id and l.file = r.file;
let located_yields = select l.function as function, r."start-byte" as position, l.file as file from body_yields as l join "source-location" as r on l.statement = r.id and l.file = r.file;
let return_statements = select function, statement, file from body_statements where kind = "return";
let return_expressions = select l.function as function, l.statement as statement, r.child as value, l.file as file from return_statements as l join "semantic-child" as r on l.statement = r.parent and l.file = r.file where r.field = "value";
let nonnull_returns = antijoin(left=return_expressions, right=nulls, left-on=["value", "file"], right-on=["id", "file"]);
let located_nonnull_returns = select l.function as function, r."start-byte" as position, l.file as file from nonnull_returns as l join "source-location" as r on l.statement = r.id and l.file = r.file;
let late_returns = select l.function as function, l.file as file from located_nonnull_returns as l join located_yields as r on l.function = r.function and l.file = r.file where r.position < l.position;
let body_problems0 = select function, file from unsupported_statements;
let body_problems1 = select function, file from bad_expression_statements;
let body_problems2 = union(left=body_problems0, right=body_problems1);
let body_problems = union(left=body_problems2, right=late_returns);
let stub_problems = select function, file from body_problems where matches(file, "\.pyi$");
let runtime_problems = antijoin(left=body_problems, right=stub_problems, left-on=["function", "file"], right-on=["function", "file"]);
let valid_methods = antijoin(left=annotated_methods, right=runtime_problems, left-on=["function", "file"], right-on=["function", "file"]);
let function_names = select parent as function, child as name, file from "semantic-child" where field = "name";
let reportable = select r.name as id, l.file as file from valid_methods as l join function_names as r on l.function = r.function and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PYI058($|[, #])", range-pattern="(?:^|,)PYI058(?:,|$)");
emit violations subject file key(id);
