import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let attributes = select id, file, span from "semantic-syntax" where kind = "attribute";
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let known_tokens = select id from semantic_identifiers where matches(text, "^(?:assert_any_call|assert_called|assert_called_once|assert_called_once_with|assert_called_with|assert_has_calls|assert_not_called|assert_awaited|assert_awaited_once|assert_awaited_with|assert_awaited_once_with|assert_any_await|assert_has_awaits|assert_not_awaited)$");
let missing_tokens = select id from semantic_identifiers where matches(text, "^(?:any_call|called_once|called_once_with|called_with|has_calls|not_called|awaited|awaited_once|awaited_with|awaited_once_with|any_await|has_awaits|not_awaited)$");
let known_attributes = select l.parent as id from attr_tokens as l join known_tokens as r on l.child = r.id;
let missing_attributes = select l.parent as id from attr_tokens as l join missing_tokens as r on l.child = r.id;
let expressions = select id from "semantic-syntax" where kind = "expr";
let values = select parent, child from "semantic-child" where field = "value";
let standalone_values = select r.child as id from expressions as l join values as r on l.id = r.parent;
let uncalled = select l.id as id from standalone_values as l join known_attributes as r on l.id = r.id;
let assertions = select id from "semantic-syntax" where kind = "assert";
let tests = select parent, child from "semantic-child" where field = "test";
let asserted = select r.child as id from assertions as l join tests as r on l.id = r.parent;
let functions = select parent, child from "semantic-child" where field = "func";
let missing_calls = select l.parent as id from functions as l join missing_attributes as r on l.child = r.id;
let missing_values = union(left=missing_attributes, right=missing_calls);
let invalid_asserts = select l.id as id from asserted as l join missing_values as r on l.id = r.id;
let invalid = union(left=uncalled, right=invalid_asserts);
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PGH005(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PGH005)(?:,|$)");
emit violations subject file key(id);
