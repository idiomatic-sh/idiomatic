import suppress from "python/ruff/suppress";
import assigned_values from "python/ruff/assigned-values";
let p_binops = select id, file, span from "semantic-syntax" where kind = "bin-op";
let p_left_fields = select parent, child from "semantic-child" where field = "left";
let p_right_fields = select parent, child from "semantic-child" where field = "right";
let p_binop_lefts = select l.id as binop, l.file as file, r.child as left from p_binops as l join p_left_fields as r on l.id = r.parent;
let p_binop_rights = select l.id as binop, l.file as file, r.child as right from p_binops as l join p_right_fields as r on l.id = r.parent;
let p_left_locations = select l.binop as binop, l.left as left, l.file as file, r."end-byte" as left_end from p_binop_lefts as l join "source-location" as r on l.left = r.id and l.file = r.file;
let p_right_locations = select l.binop as binop, l.right as right, l.file as file, r."start-byte" as right_start from p_binop_rights as l join "source-location" as r on l.right = r.id and l.file = r.file;
let p_ordered_binops = select l.binop as binop, l.left as left, r.right as right, l.file as file, l.left_end as left_end, r.right_start as right_start from p_left_locations as l join p_right_locations as r on l.binop = r.binop and l.file = r.file;
let p_percent_tokens = select l.id as token, r.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "%";
let p_modulo_candidates = select l.binop as binop, l.left as left, l.right as right, l.file as file from p_ordered_binops as l join p_percent_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let p_format_literals = select l.occurrence as format_id, l.value as value, l.file as file from "string-literal" as l;
let p_literal_binops = select l.binop as binop, l.left as left, l.right as right, l.file as file, r.format_id as format_id, r.value as format_value from p_modulo_candidates as l join p_format_literals as r on l.left = r.format_id and l.file = r.file;
let p_right_shapes = select l.binop as binop, l.right as right, l.file as file, r.kind as right_kind from p_literal_binops as l join "semantic-syntax" as r on l.right = r.id and l.file = r.file;
let p_format_parses = select p.id as id, p.file as file, p.outcome as outcome, p."error-category" as error_category, p."positional-consumption" as positional_consumption, p."mapping-present" as mapping_present, p."dynamic-width" as dynamic_width, p."dynamic-precision" as dynamic_precision from "format-parse" as p where p.dialect = "percent-string" and p.representation = "decoded-string";
let p_literal_with_right_shape = select l.binop as binop, l.left as left, l.right as right, l.format_id as format_id, l.format_value as format_value, l.file as file, r.right_kind as right_kind from p_literal_binops as l join p_right_shapes as r on l.binop = r.binop and l.file = r.file;
let p_format_expressions = select l.binop as binop, l.left as left, l.right as right, l.format_id as format_id, l.format_value as format_value, l.file as file, l.right_kind as right_kind, r.outcome as outcome, r.error_category as error_category, r.positional_consumption as positional_consumption, r.mapping_present as mapping_present, r.dynamic_width as dynamic_width, r.dynamic_precision as dynamic_precision from p_literal_with_right_shape as l join p_format_parses as r on l.format_id = r.id and l.file = r.file;
let b_calls = select id, file, span from "semantic-syntax" where kind = "call";
let b_function_fields = select parent, child from "semantic-child" where field = "func";
let b_call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from b_function_fields as l join b_calls as r on l.parent = r.id;
let b_attributes = select id, file from "semantic-syntax" where kind = "attribute";
let b_value_fields = select parent, child from "semantic-child" where field = "value";
let b_attr_values = select l.id as attribute, l.file as file, r.child as receiver from b_attributes as l join b_value_fields as r on l.id = r.parent;
let b_string_values = select occurrence as receiver, file from "string-literal";
let b_literal_receivers = select l.attribute as attribute, l.file as file, r.receiver as receiver from b_attr_values as l join b_string_values as r on l.receiver = r.receiver and l.file = r.file;
let b_attr_fields = select parent, child from "semantic-child" where field = "attr";
let b_attr_children = select l.attribute as attribute, l.file as file, r.child as name_id from b_literal_receivers as l join b_attr_fields as r on l.attribute = r.parent;
let b_format_attributes = select l.attribute as attribute, l.file as file from b_attr_children as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "format";
let b_format_calls = select l.call as call, l.function as function, l.file as file, l.span as span from b_call_functions as l join b_format_attributes as r on l.function = r.attribute and l.file = r.file;
let b_argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let b_argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join b_argument_nodes as r on l.child = r.id;
let b_positional_fields = select parent, child from "semantic-child" where field = "args";
let b_positional_arguments = select l.call as call, r.child as argument, l.file as file from b_argument_owners as l join b_positional_fields as r on l.wrapper = r.parent;
let b_format_calls_with_literal = select l.call as call, l.file as file, l.span as span, r.receiver as format_id from b_format_calls as l join b_literal_receivers as r on l.function = r.attribute and l.file = r.file;
let percent_reports0 = select l.binop as id, l.file as file, r.span as span from p_format_expressions as l join p_binops as r on l.binop = r.id and l.file = r.file where l.outcome = "malformed" and l.error_category = "unsupported-format-character";
let percent_reports = extend(from=percent_reports0, values={ordinal: 0});
let specs = select id, ordinal, selector, conversion, file from "format-specification" as s where s."source-kind" = "brace-string" and s.outcome = "invalid-type";
let literal_constants = select id, file from "literal-properties" where kind = "string";
let literal_calls = select l.call as call, l.format_id as format_id, l.file as file, l.span as span from b_format_calls_with_literal as l join literal_constants as r on l.format_id = r.id and l.file = r.file;
let brace_reports0 = select l.call as id, l.file as file, l.span as span, r.ordinal as ordinal from literal_calls as l join specs as r on l.format_id = r.id and l.file = r.file;
let class_definitions = select id as binding, file from "defines" where kind = "class";
let format_methods = select owner as binding, file from "defines" where kind = "method" and name = "__format__";
let custom_classes = select l.binding as binding, l.file as file from class_definitions as l join format_methods as r on l.binding = r.binding and l.file = r.file;
let constructor_bindings = select l.call as argument, r.binding as binding, l.file as file from b_call_functions as l join "binding-use" as r on l.function = r.reference and l.file = r.file where r.certainty = "unique";
let constructed_custom = select l.argument as argument, l.file as file from constructor_bindings as l join custom_classes as r on l.binding = r.binding and l.file = r.file;
let assigned = assigned_values();
let assigned_custom = select l.binding as binding, l.file as file from assigned as l join constructed_custom as r on l.value = r.argument and l.file = r.file;
let custom_references = select l.reference as argument, l.file as file from "binding-use" as l join assigned_custom as r on l.binding = r.binding and l.file = r.file where l.certainty = "unique";
let custom_arguments = union(left=constructed_custom, right=custom_references);
let relevant_arguments = select l.call as call, l.wrapper as wrapper, l.file as file from b_argument_owners as l join literal_calls as r on l.call = r.call and l.file = r.file;
let ordered_arguments = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from relevant_arguments as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let argument_predecessors = select l.call as call, l.argument as argument, r.argument as earlier, l.file as file from ordered_arguments as l join ordered_arguments as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let later_arguments = group-count(from=argument_predecessors, keys=["call", "argument", "file"], distinct="earlier", count="position");
let first_arguments0 = antijoin(left=ordered_arguments, right=later_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let first_arguments1 = select call, argument, file from first_arguments0;
let first_arguments = extend(from=first_arguments1, values={position: 0});
let positional_arguments = union(left=first_arguments, right=later_arguments);
let field_selectors = select id, ordinal, "selector-kind" as kind, "selector-index" as position, "selector-name" as name, "index-overflow" as overflow, file from "brace-format-field";
let simple_specs = select l.id as id, l.ordinal as ordinal, r.kind as kind, r.position as position, r.name as name, l.file as file from specs as l join field_selectors as r on l.id = r.id and l.ordinal = r.ordinal and l.file = r.file where l.conversion = "" and r.overflow = "false" and (r.kind = "automatic" and l.selector = "" or r.kind != "automatic" and l.selector = r.name);
let positional_specs = select l.call as call, r.ordinal as ordinal, r.position as position, l.file as file from literal_calls as l join simple_specs as r on l.format_id = r.id and l.file = r.file where r.kind = "automatic" or r.kind = "index";
let positional_fields = select l.call as call, l.ordinal as ordinal, r.argument as argument, l.file as file from positional_specs as l join positional_arguments as r on l.call = r.call and l.position = r.position and l.file = r.file;
let keyword_nodes = select l.call as call, r.child as keyword, l.file as file from relevant_arguments as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_labels = select l.call as call, l.keyword as keyword, r.child as label, l.file as file from keyword_nodes as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let named_keywords = select l.call as call, l.keyword as keyword, r.name as name, l.file as file from keyword_labels as l join "identifier" as r on l.label = r.id and l.file = r.file;
let keyword_arguments = select l.call as call, l.name as name, r.child as argument, l.file as file from named_keywords as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let keyword_specs = select l.call as call, r.ordinal as ordinal, r.name as name, l.file as file from literal_calls as l join simple_specs as r on l.format_id = r.id and l.file = r.file where r.kind = "keyword";
let keyword_fields = select l.call as call, l.ordinal as ordinal, r.argument as argument, l.file as file from keyword_specs as l join keyword_arguments as r on l.call = r.call and l.name = r.name and l.file = r.file;
let field_arguments = union(left=positional_fields, right=keyword_fields);
let custom_fields = select l.call as id, l.ordinal as ordinal, l.file as file from field_arguments as l join custom_arguments as r on l.argument = r.argument and l.file = r.file;
let brace_reports = antijoin(left=brace_reports0, right=custom_fields, left-on=["id", "ordinal", "file"], right-on=["id", "ordinal", "file"]);
let records = union(left=percent_reports, right=brace_reports);
let unique_candidates = group-count(from=records, keys=["id", "file", "span"], count="specs");
let candidates = select id, file, span from unique_candidates;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1300(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1300)(?:,|$)");
let reports = select l.id as id, l.file as file, l.span as span, l.ordinal as ordinal from records as l join violations as r on l.id = r.id and l.file = r.file and l.span = r.span;
emit reports subject file key(id, ordinal);
