import suppress from "python/ruff/suppress";
let assertions = select id, file, span from "semantic-syntax" where kind = "assert";
let named_expressions = select id, file, span from "semantic-syntax" where kind = "named-expr";
let assert_walrus_axes = axis(from=assertions,relation="semantic-child",direction=descendant,domain=named_expressions);
let assert_walruses = select related as named_expr, file from assert_walrus_axes;
let target_fields = select parent, child from "semantic-child" where field = "target";
let walrus_targets = select l.named_expr as named_expr, r.child as target, l.file as file from assert_walruses as l join target_fields as r on l.named_expr = r.parent;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let name_targets = select l.named_expr as named_expr, r.id as target, l.file as file from walrus_targets as l join name_nodes as r on l.target = r.id and l.file = r.file;
let binding_events = select occurrence, name, file from "binding-event" where kind = "bind";
let walrus_bindings = select l.named_expr as named_expr, l.target as target, r.name as name, l.file as file from name_targets as l join binding_events as r on l.target = r.occurrence and l.file = r.file;
let use_rows = select binding, reference, file from "binding-use";
let binding_uses = select l.named_expr as named_expr, l.target as target, r.reference as reference, l.file as file from walrus_bindings as l join use_rows as r on l.target = r.binding and l.file = r.file;
let use_roots = select reference as id, named_expr, target, file from binding_uses;
let use_assert_axes = axis(from=use_roots,relation="semantic-child",direction=ancestor,domain=assertions);
let assert_uses = select id as reference, file from use_assert_axes;
let outside_uses = antijoin(left=binding_uses,right=assert_uses,left-on=["reference","file"],right-on=["reference","file"]);
let outside_bindings = select named_expr from outside_uses;
let reportable = select l.named_expr as id, l.file as file, r.span as span from outside_uses as l join named_expressions as r on l.named_expr = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF018(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF018)(?:,|$)");
emit violations subject file key(id);
