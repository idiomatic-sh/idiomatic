import observation_matches from "python/ruff/suppress-matches";
import version_checks from "python/ruff/version-checks";
let checks = version_checks();
let integers = select id, file from "literal-properties" where kind = "integer";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_checks = select l.id as id, l.comparator as tuple, l.file as file from checks as l join tuples as r on l.comparator = r.id and l.file = r.file where l.expected = "tuple";
let elements = select l.tuple as tuple, r.child as element, l.file as file from tuple_checks as l join "semantic-child" as r on l.tuple = r.parent and l.file = r.file where r.field = "elts";
let invalid_elements = antijoin(left=elements, right=integers, left-on=["element", "file"], right-on=["id", "file"]);
let bad_tuples = select tuple, file from invalid_elements;
let valid_tuples = antijoin(left=tuple_checks, right=bad_tuples, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let valid_major_checks = select l.id as id, l.file as file from checks as l join integers as r on l.comparator = r.id and l.file = r.file where l.expected = "major";
let valid_tuple_ids = select id, file from valid_tuples;
let valid_checks = union(left=valid_major_checks, right=valid_tuple_ids);
let candidates = antijoin(left=checks, right=valid_checks, left-on=["id", "file"], right-on=["id", "file"]);
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI003)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI003"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
