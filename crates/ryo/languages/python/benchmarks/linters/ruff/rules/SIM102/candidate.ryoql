import suppress from "python/ruff/suppress";
import conditional_guards from "python/ruff/conditional-guards";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let clauses = select id, file from nodes where kind = "elif-else-clause";
let owners = union(left=ifs, right=clauses);
let tests = select l.id as owner, r.child as test, l.file as file from owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let bodies = select l.id as owner, r.child as member, l.file as file from owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=bodies, keys=["owner", "file"], count="count", distinct="member");
let single_bodies = select l.owner as owner, l.member as member, l.file as file from bodies as l join body_counts as r on l.owner = r.owner and l.file = r.file where r.count = 1;
let root_clauses = select l.id as root, r.child as clause, r.ordinal as ordinal, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "orelse";
let earlier_clauses = select l.root as root, l.clause as clause, l.file as file from root_clauses as l join root_clauses as r on l.root = r.root and l.file = r.file where l.ordinal < r.ordinal;
let last_clauses = antijoin(left=root_clauses, right=earlier_clauses, left-on=["root", "clause", "file"], right-on=["root", "clause", "file"]);
let selected_clauses = select l.root as root, l.clause as branch, r.test as test, l.file as file from last_clauses as l join tests as r on l.clause = r.owner and l.file = r.file;
let roots_without_clauses = antijoin(left=ifs, right=root_clauses, left-on=["id", "file"], right-on=["root", "file"]);
let selected_roots = select l.id as root, l.id as branch, r.test as test, l.file as file from roots_without_clauses as l join tests as r on l.id = r.owner and l.file = r.file;
let selected = union(left=selected_clauses, right=selected_roots);
let selected_single_roots = select l.root as root, l.branch as branch, l.test as test, l.file as file from selected as l join body_counts as r on l.root = r.owner and l.file = r.file where r.count = 1;
let boolean_literals = select id, file from "literal-properties" where kind = "boolean";
let boolean_branches = select l.root as root, l.file as file from selected_single_roots as l join boolean_literals as r on l.test = r.id and l.file = r.file;
let comparisons = select id, file from nodes where kind = "compare";
let selected_comparisons = select l.root as root, l.test as test, l.file as file from selected_single_roots as l join comparisons as r on l.test = r.id and l.file = r.file;
let compare_lefts = select l.root as root, l.test as test, r.child as left, l.file as file from selected_comparisons as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "left";
let main_names = select id, file from "identifier" where name = "__name__";
let main_compares = select l.root as root, l.test as test, l.file as file from compare_lefts as l join main_names as r on l.left = r.id and l.file = r.file;
let compare_rights = select l.root as root, l.test as test, r.child as right, l.file as file from main_compares as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "comparators";
let right_counts = group-count(from=compare_rights, keys=["root", "test", "file"], count="count", distinct="right");
let one_right = select l.root as root, l.right as right, l.file as file from compare_rights as l join right_counts as r on l.root = r.root and l.test = r.test and l.file = r.file where r.count = 1;
let main_strings = select occurrence as id, file from "string-literal" where value = "__main__";
let main_branches = select l.root as root, l.file as file from one_right as l join main_strings as r on l.right = r.id and l.file = r.file;
let exempt_branches = union(left=boolean_branches, right=main_branches);
let allowed_branches = antijoin(left=selected_single_roots, right=exempt_branches, left-on=["root", "file"], right-on=["root", "file"]);
let plain_ifs = antijoin(left=ifs, right=root_clauses, left-on=["id", "file"], right-on=["root", "file"]);
let nested_body_ifs = select l.owner as owner, l.member as inner, l.file as file from single_bodies as l join plain_ifs as r on l.member = r.id and l.file = r.file;
let candidates0 = select l.root as root, l.branch as branch, r.inner as inner, l.file as file from allowed_branches as l join nested_body_ifs as r on l.branch = r.owner and l.file = r.file;
let top_candidates = select * from candidates0;
let chain_edges = select l.owner as origin, l.inner as destination, l.file as file from nested_body_ifs as l join plain_ifs as r on l.owner = r.id and l.file = r.file;
let chain_paths = closure(edges=chain_edges, source="origin", destination="destination", keys=["file"]);
let child_members = select l.root as root, r.destination as member, l.file as file from top_candidates as l join chain_paths as r on l.inner = r.origin and l.file = r.file;
let first_members = select root, inner as member, file from top_candidates;
let members = union(left=first_members, right=child_members);
let nonterminal = select l.root as root, l.member as member, l.file as file from members as l join chain_edges as r on l.member = r.origin and l.file = r.file;
let terminal = antijoin(left=members, right=nonterminal, left-on=["root", "member", "file"], right-on=["root", "member", "file"]);
let last_tests = select l.root as root, r.test as test, l.file as file from terminal as l join tests as r on l.member = r.owner and l.file = r.file;
let root_conditions = select owner as context, test, file from tests;
let guarded = conditional_guards(conditions=root_conditions);
let reportable = antijoin(left=last_tests, right=guarded, left-on=["root", "file"], right-on=["context", "file"]);
let locations = select id, span, "start-byte", "end-byte", "start-line", file from "source-location";
let test_ends = select l.root as root, r."end-byte" as test_end, l.file as file from reportable as l join locations as r on l.test = r.id and l.file = r.file;
let colon_tokens = select id, file from "syntax-tree" where text = ":";
let colons = select l.id as colon, r.span as colon_span, r."start-byte" as position, l.file as file from colon_tokens as l join locations as r on l.id = r.id and l.file = r.file;
let later_colons = select l.root as root, r.colon as colon, r.colon_span as colon_span, r.position as position, l.file as file from test_ends as l join colons as r on l.file = r.file where r.position >= l.test_end;
let not_first = select l.root as root, l.colon as colon, l.file as file from later_colons as l join later_colons as r on l.root = r.root and l.file = r.file where r.position < l.position;
let first_colons = antijoin(left=later_colons, right=not_first, left-on=["root", "colon", "file"], right-on=["root", "colon", "file"]);
let ranges = select l.root as id, r.branch as branch, l.colon_span as end_span, l.file as file from first_colons as l join top_candidates as r on l.root = r.root and l.file = r.file;
let bounds = select l.id as id, r.span as start_span, l.end_span as end_span, r."start-line" as line, l.file as file from ranges as l join locations as r on l.branch = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations = suppress(candidates=candidates, inline-pattern="SIM102($|[, #])", range-pattern="(?:^|,)SIM102(?:,|$)");
emit violations subject file key(id);
