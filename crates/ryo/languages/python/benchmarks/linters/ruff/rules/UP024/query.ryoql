import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let qualified_aliases = select id, file from "qualified-name" where path = "IOError" or path = "EnvironmentError" or path = "builtins.IOError" or path = "builtins.EnvironmentError" or path = "os.error" or path = "mmap.error" or path = "resource.error" or path = "select.error" or path = "socket.error";
let windows_catalog = select name, file from "implicit-symbol" where name = "WindowsError" and kind = "platform-builtin";
let windows_names = select l.id as id, l.name as name, l.file as file from "identifier" as l join "binding-read" as r on l.id = r.reference and l.name = r.name and l.file = r.file where r.state = "unbound" and r.context = "value";
let windows_aliases = select l.id as id, l.file as file from windows_names as l join windows_catalog as r on l.name = r.name and l.file = r.file;
let aliases = union(left=qualified_aliases, right=windows_aliases);
let alias_nodes = select l.id as id, l.file as file, r.span as span from aliases as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let alias_calls = select l.function as id, l.file as file from call_functions as l join alias_nodes as r on l.function = r.id and l.file = r.file;
let raises = select id, file from "semantic-syntax" where kind = "raise";
let raise_fields = select parent, child from "semantic-child" where field = "exc";
let raised_aliases = select l.child as id, r.file as file from raise_fields as l join raises as r on l.parent = r.id;
let direct_raises = select l.id as id, l.file as file from raised_aliases as l join alias_nodes as r on l.id = r.id and l.file = r.file;
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let handler_type_fields = select parent, child from "semantic-child" where field = "type";
let handler_type_roots = select l.parent as handler, l.child as id, r.file as file from handler_type_fields as l join handlers as r on l.parent = r.id;
let direct_handler_aliases = select l.id as id, l.file as file from handler_type_roots as l join alias_nodes as r on l.id = r.id and l.file = r.file;
let tuples = select id, file, span from "semantic-syntax" where kind = "tuple";
let handler_tuple_roots = select l.id as id, l.file as file from handler_type_roots as l join tuples as r on l.id = r.id and l.file = r.file;
let alias_ids = select id, file from alias_nodes;
let tuple_alias_axis = axis(from=handler_tuple_roots,relation="semantic-child",direction=descendant,domain=alias_ids);
let tuple_alias_candidates = select l.id as tuple, r.related as alias, l.file as file from handler_tuple_roots as l join tuple_alias_axis as r on l.id = r.id;
let tuple_aliases = select l.tuple as tuple, r.id as alias, l.file as file from tuple_alias_candidates as l join alias_ids as r on l.alias = r.id and l.file = r.file;
let tuple_alias_positions = select l.tuple as tuple, l.alias as alias, l.file as file, r."start-byte" as begin from tuple_aliases as l join "source-location" as r on l.alias = r.id and l.file = r.file;
let later_tuple_aliases = select l.tuple as tuple, l.alias as alias, l.file as file from tuple_alias_positions as l join tuple_alias_positions as r on l.tuple = r.tuple and l.file = r.file where l.begin > r.begin;
let first_tuple_aliases = antijoin(left=tuple_aliases,right=later_tuple_aliases,left-on=["tuple","alias","file"],right-on=["tuple","alias","file"]);
let tuple_reportable = select l.tuple as id, l.file as file, r.span as span from first_tuple_aliases as l join tuples as r on l.tuple = r.id and l.file = r.file;
let alias_reportable_a = select l.id as id, l.file as file, r.span as span from alias_calls as l join alias_nodes as r on l.id = r.id and l.file = r.file;
let alias_reportable_b = select l.id as id, l.file as file, r.span as span from direct_raises as l join alias_nodes as r on l.id = r.id and l.file = r.file;
let alias_reportable_c = select l.id as id, l.file as file, r.span as span from direct_handler_aliases as l join alias_nodes as r on l.id = r.id and l.file = r.file;
let alias_reportable_ab = union(left=alias_reportable_a,right=alias_reportable_b);
let alias_reportable = union(left=alias_reportable_ab,right=alias_reportable_c);
let reportable = union(left=alias_reportable,right=tuple_reportable);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP024(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP024)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP024)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP024)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP024"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
