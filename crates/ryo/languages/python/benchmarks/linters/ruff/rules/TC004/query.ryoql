import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import annotation_context from "python/ruff/annotation-evaluation-context";
import symbols from "python/ruff/modernization-symbols";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as owner, r.child as id, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let test_expressions = select id, file from tests;
let test_symbols = symbols(expressions=test_expressions);
let type_guards = select id, file from test_symbols where kind = "type-checking";
let guarded_ifs = select l.owner as id, l.file as file from tests as l join type_guards as r on l.id = r.id and l.file = r.file;
let guarded_bodies = select r.child as id, l.file as file from guarded_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let definition_rows = select id, owner, name, file from "defines";
let definition_nodes = select id, file from definition_rows;
let guarded_definition_axes = axis(from=definition_nodes, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_definition_nested = select id, file from guarded_definition_axes;
let guarded_definition_self = select l.id as id, l.file as file from definition_nodes as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_definition_ids = union(left=guarded_definition_nested, right=guarded_definition_self);
let guarded_definitions = select l.id as id, l.owner as owner, l.name as name, l.file as file from definition_rows as l join guarded_definition_ids as r on l.id = r.id and l.file = r.file;
let imports0 = select occurrence as id, owner, binding as name, file from "static-import";
let guarded_import_rows = select l.id as id, l.owner as owner, l.name as name, l.file as file from imports0 as l join guarded_definition_ids as r on l.id = r.id and l.file = r.file;
let stub_imports = select id, file from guarded_import_rows where ends_with(file, ".pyi");
let imports = antijoin(left=guarded_import_rows, right=stub_imports, left-on=["id","file"], right-on=["id","file"]);
let read_rows = select reference as id, name, scope, phase, context, state, file from "binding-read" where context != "deletion";
let annotation_inputs = select id, file from read_rows;
let annotation_rows = annotation_context(expressions=annotation_inputs);
let deferred_annotations = select id, file from annotation_rows where evaluation != "eager";
let ordinary_values = select id, name, scope, phase, state, file from read_rows where context = "value";
let eager_annotations = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.state as state, l.file as file from read_rows as l join annotation_rows as r on l.id = r.id and l.file = r.file where r.evaluation = "eager";
let runtime_reads0 = union(left=ordinary_values, right=eager_annotations);
let guarded_read_axes = axis(from=runtime_reads0, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_reads_nested = select id, file from guarded_read_axes;
let guarded_reads_self = select l.id as id, l.file as file from runtime_reads0 as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_reads = union(left=guarded_reads_nested, right=guarded_reads_self);
let unguarded_reads = antijoin(left=runtime_reads0, right=guarded_reads, left-on=["id","file"], right-on=["id","file"]);
let lazy_aliases = select id, file from nodes where kind = "type-alias";
let parameter_roots = select child as id, file from "semantic-child" where field = "type-params";
let lazy_roots = union(left=lazy_aliases, right=parameter_roots);
let lazy_read_axes = axis(from=unguarded_reads, relation="semantic-child", direction=ancestor, domain=lazy_roots);
let lazy_reads = select id, file from lazy_read_axes;
let runtime_reads = antijoin(left=unguarded_reads, right=lazy_reads, left-on=["id","file"], right-on=["id","file"]);
let uses = select reference, binding, file from "binding-use";
let read_uses = select l.id as id, l.name as name, l.phase as phase, l.file as file, r.binding as binding from runtime_reads as l join uses as r on l.id = r.reference and l.file = r.file;
let associated_reads = select l.id as id, l.name as name, l.phase as phase, l.binding as binding, r.owner as owner, l.file as file from read_uses as l join imports as r on l.binding = r.id and l.file = r.file;
let read_events = select occurrence as id, ordinal, file from "binding-event" where kind = "read";
let candidate_reads = select l.id as id, l.name as name, l.phase as phase, l.owner as owner, l.file as file, r.ordinal as point from associated_reads as l join read_events as r on l.id = r.id and l.file = r.file;
let value_events = select occurrence as id, name, scope, phase, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let event_nodes = select id, file from value_events;
let guarded_event_axes = axis(from=event_nodes, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_event_nested = select id, file from guarded_event_axes;
let guarded_event_self = select l.id as id, l.file as file from event_nodes as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_event_ids = union(left=guarded_event_nested, right=guarded_event_self);
let runtime_events = antijoin(left=value_events, right=guarded_event_ids, left-on=["id","file"], right-on=["id","file"]);
let preceding_options = select l.id as id, l.file as file, r.id as event, r.ordinal as ordinal, r.kind as kind from candidate_reads as l join runtime_events as r on l.owner = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point or r.phase != l.phase;
let superseded_options = select l.id as id, l.file as file, l.event as event from preceding_options as l join preceding_options as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal;
let terminal_options = antijoin(left=preceding_options, right=superseded_options, left-on=["id","file","event"], right-on=["id","file","event"]);
let available_same_namespace = select id, file from terminal_options where kind = "bind";
let other_uses = antijoin(left=read_uses, right=guarded_definition_ids, left-on=["binding","file"], right-on=["id","file"]);
let other_bindings = select l.id as id, l.name as name, l.phase as phase, l.file as file, r.phase as binding_phase, r.scope as runtime_scope, r.ordinal as ordinal from other_uses as l join runtime_events as r on l.binding = r.id and l.file = r.file where r.kind = "bind";
let earlier_other_bindings = select l.id as id, l.file as file, l.runtime_scope as runtime_scope from other_bindings as l join read_events as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal or l.binding_phase != l.phase;
let available_other_namespace = select l.id as id, l.file as file from earlier_other_bindings as l join candidate_reads as r on l.id = r.id and l.file = r.file where l.runtime_scope != r.owner;
let builtin_catalog = select name, file, "since-major" as since_major, "since-minor" as since_minor from "implicit-symbol" where kind = "builtin";
let builtin_eligible = select l.name as name, l.file as file from builtin_catalog as l join "language-target" as r on l.file = r.file where l.since_major < r.major or l.since_major = r.major and l.since_minor <= r.minor;
let local_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let nonlocal_candidates = antijoin(left=candidate_reads, right=local_scopes, left-on=["owner","file"], right-on=["id","file"]);
let available_builtins = select l.id as id, l.file as file from nonlocal_candidates as l join builtin_eligible as r on l.name = r.name and l.file = r.file;
let available0 = union(left=available_same_namespace, right=available_other_namespace);
let available = union(left=available0, right=available_builtins);
let missing = antijoin(left=candidate_reads, right=available, left-on=["id","file"], right-on=["id","file"]);
let unavailable_imports = select r.binding as id, l.file as file from missing as l join associated_reads as r on l.id = r.id and l.file = r.file;
let export_targets = select id, file from "semantic-syntax" where kind = "name-token" and text = "__all__";
let export_statement_nodes = select id, file from nodes where kind = "assign" or kind = "ann-assign" or kind = "aug-assign";
let export_assignment_axes = axis(from=export_targets, relation="semantic-child", direction=nearest-ancestor, domain=export_statement_nodes);
let export_assignment_nodes = select related as id, file from export_assignment_axes;
let export_scopes = select id, kind, file from nodes where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let export_scope_axes = axis(from=export_assignment_nodes, relation="semantic-child", direction=nearest-ancestor, domain=export_scopes);
let export_module_ids = select id, file from export_scopes where kind = "module";
let export_assignments = select l.id as id, l.file as file from export_scope_axes as l join export_module_ids as r on l.related = r.id and l.file = r.file;
let export_values = select r.child as id, l.file as file from export_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let strings = select occurrence as id, value, file from "string-literal";
let export_string_axes = axis(from=strings, relation="semantic-child", direction=ancestor, domain=export_values);
let export_strings = select l.value as name, l.file as file from strings as l join export_string_axes as r on l.id = r.id and l.file = r.file;
let module_nodes = select id, file from nodes where kind = "module";
let getattr_definitions = select id, owner, file from definition_rows where name = "__getattr__";
let getattr_files = select l.file as file from getattr_definitions as l join module_nodes as r on l.owner = r.id and l.file = r.file;
let explicit_exports = antijoin(left=export_strings, right=getattr_files, left-on=["file"], right-on=["file"]);
let exported_imports = select r.id as id, l.file as file from explicit_exports as l join imports as r on l.name = r.name and l.file = r.file;
let all_imports = union(left=unavailable_imports, right=exported_imports);
let asname_fields = select parent as id, child as token, file from "semantic-child" where field = "asname";
let alias_tokens = select l.id as id, r.token as token, l.file as file from all_imports as l join asname_fields as r on l.id = r.id and l.file = r.file;
let plain_imports = antijoin(left=all_imports, right=alias_tokens, left-on=["id","file"], right-on=["id","file"]);
let ordinary_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from plain_imports as l join "source-location" as r on l.id = r.id and l.file = r.file;
let aliased_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from alias_tokens as l join "source-location" as r on l.token = r.id and l.file = r.file;
let candidates = union(left=ordinary_candidates, right=aliased_candidates);
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])TC004(?:$|[^A-Z0-9])", range-pattern="(?:^|,)TC004(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TC004)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TC004)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TC004"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
