import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import type_match_at_check from "python/ruff/type-match-at-check";

let syntax = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from syntax where kind = "call";
let names = select id, file from syntax where kind = "name";
let functions = select id, file from syntax where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let classes = select id, file from syntax where kind = "class-def";
let comprehensions = select id, file from syntax where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let callable_scopes = union(left=functions, right=comprehensions);
let scoped_nodes = union(left=callable_scopes, right=classes);
let function_edges = select parent as call, child as function, file from "semantic-child" where field = "func";
let called_names = select l.call as call, l.function as function, l.file as file from function_edges as l join names as r on l.function = r.id and l.file = r.file;
let bare_super_reads = select reference as function, file from "binding-read" where name = "super" and state = "builtin";
let bare_super_calls = select l.call as call, l.file as file from called_names as l join bare_super_reads as r on l.function = r.function and l.file = r.file;
let called_symbols = select call as check, function as root, file from function_edges;
let resolved_super_calls = type_match_at_check(checks=called_symbols, builtin="builtins.super", typing="", mode="exact");
let super_calls0 = select l.id as call, l.file as file from calls as l join resolved_super_calls as r on l.id = r.check and l.file = r.file;

let argument_nodes = select id, file from syntax where kind = "call-arguments";
let wrappers0 = select parent as call, child as wrapper, file from "semantic-child";
let wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from wrappers0 as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let arguments = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let counts = group-count(from=arguments, keys=["call", "file"], count="count", distinct="argument");
let two_arguments = select call, file from counts where count = 2;
let ordered_pairs = select l.call as call, l.argument as first, r.argument as second, l.file as file from arguments as l join arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let pairs = select l.call as call, l.first as first, l.second as second, l.file as file from ordered_pairs as l join two_arguments as r on l.call = r.call and l.file = r.file;
let starred = select id, file from syntax where kind = "starred";
let starred_pairs = select l.call as call, l.file as file from pairs as l join starred as r on l.first = r.id and l.file = r.file;
let unstarred = antijoin(left=pairs, right=starred_pairs, left-on=["call", "file"], right-on=["call", "file"]);
let starred_seconds = select l.call as call, l.file as file from unstarred as l join starred as r on l.second = r.id and l.file = r.file;
let ordinary_pairs = antijoin(left=unstarred, right=starred_seconds, left-on=["call", "file"], right-on=["call", "file"]);

let call_inputs = select call as id, file from ordinary_pairs;
let nearest_callable = axis(from=call_inputs, relation="semantic-child", direction=nearest-ancestor, domain=scoped_nodes);
let call_functions = select l.call as call, l.first as first, l.second as second, r.related as function, l.file as file from ordinary_pairs as l join nearest_callable as r on l.call = r.id and l.file = r.file;
let method_scopes = select id, file from syntax where kind = "function-def" or kind = "async-function-def";
let lambda_scopes = select id, file from syntax where kind = "lambda";
let method_calls = select l.call as call, l.first as first, l.second as second, l.function as function, l.file as file from call_functions as l join method_scopes as r on l.function = r.id and l.file = r.file;
let lambda_calls = select l.call as call, l.first as first, l.second as second, l.function as function, l.file as file from call_functions as l join lambda_scopes as r on l.function = r.id and l.file = r.file;
let method_inputs = select function as id, file from method_calls;
let enclosing_scopes = axis(from=method_inputs, relation="semantic-child", direction=nearest-ancestor, domain=classes);
let class_methods0 = select l.call as call, l.first as first, l.second as second, l.function as function, r.related as class, l.file as file from method_calls as l join enclosing_scopes as r on l.function = r.id and l.file = r.file;
let class_methods = select l.call as call, l.first as first, l.second as second, l.function as function, l.class as class, l.file as file from class_methods0 as l join classes as c on l.class = c.id and l.file = c.file;
let lambda_inputs = select function as id, file from lambda_calls;
let lambda_enclosing_scopes = axis(from=lambda_inputs, relation="semantic-child", direction=nearest-ancestor, domain=classes);
let class_lambdas0 = select l.call as call, l.first as first, l.second as second, l.function as function, r.related as class, l.file as file from lambda_calls as l join lambda_enclosing_scopes as r on l.function = r.id and l.file = r.file;
let class_lambdas = select l.call as call, l.first as first, l.second as second, l.function as function, l.class as class, l.file as file from class_lambdas0 as l join classes as c on l.class = c.id and l.file = c.file;
let owner_calls = union(left=class_methods, right=class_lambdas);
let qualified_super_calls = antijoin(left=super_calls0, right=bare_super_calls, left-on=["call", "file"], right-on=["call", "file"]);
let qualified_owners = select l.call as call, r.function as function, r.class as class, l.file as file from qualified_super_calls as l join owner_calls as r on l.call = r.call and l.file = r.file;
let local_class_cell_bindings = select scope as function, file from "binding-event" where name = "__class__" and (kind = "bind" or kind = "annotation" or kind = "global" or kind = "nonlocal" or kind = "delete");
let raw_class_cell_loads = select scope as function, file from "binding-event" where name = "__class__" and kind = "read";
let class_cell_loads = antijoin(left=raw_class_cell_loads, right=local_class_cell_bindings, left-on=["function", "file"], right-on=["function", "file"]);
let super_loads = select scope as function, file from "binding-event" where name = "super" and kind = "read";
let safe_super_loads = antijoin(left=super_loads, right=local_class_cell_bindings, left-on=["function", "file"], right-on=["function", "file"]);
let class_cell_triggers = union(left=class_cell_loads, right=safe_super_loads);
let qualified_with_cell = select l.call as call, l.file as file from qualified_owners as l join class_cell_triggers as r on l.function = r.function and l.file = r.file;
let nested_cell_inputs = select function as id, file from class_cell_loads;
let nested_method_axes = axis(from=nested_cell_inputs, relation="semantic-child", direction=ancestor, domain=method_scopes);
let nested_class_axes = axis(from=nested_cell_inputs, relation="semantic-child", direction=nearest-ancestor, domain=classes);
let nested_methods = select l.id as nested, r.related as method, l.file as file from nested_cell_inputs as l join nested_method_axes as r on l.id = r.id and l.file = r.file where l.id != r.related;
let nested_classes = select l.nested as nested, l.method as method, r.related as class, l.file as file from nested_methods as l join nested_class_axes as r on l.nested = r.id and l.file = r.file;
let safe_nested_classes = antijoin(left=nested_classes, right=local_class_cell_bindings, left-on=["method", "file"], right-on=["function", "file"]);
let qualified_with_nested_cell = select l.call as call, l.file as file from qualified_owners as l join safe_nested_classes as r on l.function = r.method and l.class = r.class and l.file = r.file;
let qualified_with_any_cell = union(left=qualified_with_cell, right=qualified_with_nested_cell);

let argument_edges = select parent as function, child as wrapper, file from "semantic-child" where field = "args";
let argument_wrappers = select l.function as function, l.wrapper as wrapper, l.file as file from argument_edges as l join syntax as r on l.wrapper = r.id and l.file = r.file where r.kind = "arguments";
let positional_parameters = select l.function as function, r.child as parameter, r.ordinal as ordinal, r.field as field, l.file as file from argument_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "posonlyargs" or r.field = "args";
let positional_only = select function, file from positional_parameters where field = "posonlyargs";
let first_positional_only = select function, parameter, ordinal, file from positional_parameters where field = "posonlyargs";
let regular_parameters = select function, parameter, ordinal, file from positional_parameters where field = "args";
let first_regular = antijoin(left=regular_parameters, right=positional_only, left-on=["function", "file"], right-on=["function", "file"]);
let eligible_parameters = union(left=first_positional_only, right=first_regular);
let predecessors = select l.function as function, r.parameter as later, l.file as file from eligible_parameters as l join eligible_parameters as r on l.function = r.function and l.file = r.file where l.ordinal < r.ordinal;
let first_parameters = antijoin(left=eligible_parameters, right=predecessors, left-on=["function", "parameter", "file"], right-on=["function", "later", "file"]);
let parameter_arg_nodes = select id, file from syntax where kind = "arg";
let first_parameter_children = select l.function as function, r.child as parameter, l.file as file from first_parameters as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file;
let unwrapped_first_parameters = select l.function as function, l.parameter as parameter, l.file as file from first_parameter_children as l join parameter_arg_nodes as r on l.parameter = r.id and l.file = r.file;
let first_parameter_definitions = select function, parameter, file from unwrapped_first_parameters;
let second_names = select l.call as call, l.first as first, l.second as second, l.function as function, l.class as class, l.file as file from owner_calls as l join names as n on l.second = n.id and l.file = n.file;
let second_reads = select l.call as call, l.first as first, l.second as second, l.function as function, l.class as class, l.file as file from second_names as l join "binding-read" as r on l.second = r.reference and l.file = r.file where r.state = "unique-declaration";
let second_name_uses = select l.call as call, l.first as first, l.function as function, l.class as class, r.binding as binding, l.file as file from second_reads as l join "binding-use" as r on l.second = r.reference and l.file = r.file where r.certainty = "unique";
let same_first_parameter = select l.call as call, l.first as first, l.function as function, l.class as class, l.file as file from second_name_uses as l join first_parameter_definitions as r on l.binding = r.parameter and l.function = r.function and l.file = r.file;

let first_names = select l.call as call, l.first as first, l.class as class, l.function as function, r.name as name, l.file as file from same_first_parameter as l join "binding-read" as r on l.first = r.reference and l.file = r.file;
let explicit_class_cells = select call, first, class, function, file from first_names where name = "__class__";
let implicit_class_cells = antijoin(left=explicit_class_cells, right=local_class_cell_bindings, left-on=["function", "file"], right-on=["function", "file"]);
let class_definitions = select id as class, name, owner, file from "defines" where kind = "class";
let all_definitions = select id, name, owner, file from "defines";
let class_definition_positions = select l.class as class, l.name as name, l.owner as owner, l.file as file, r."start-byte" as start from class_definitions as l join "source-location" as r on l.class = r.id and l.file = r.file;
let all_definition_positions = select l.id as id, l.name as name, l.owner as owner, l.file as file, r."start-byte" as start from all_definitions as l join "source-location" as r on l.id = r.id and l.file = r.file;
let class_rebindings = select l.class as class, l.file as file from class_definition_positions as l join all_definition_positions as r on l.name = r.name and l.owner = r.owner and l.file = r.file where l.start < r.start;
let stable_class_definitions = antijoin(left=class_definitions, right=class_rebindings, left-on=["class", "file"], right-on=["class", "file"]);
let class_name_reads = select l.call as call, l.first as first, l.class as class, l.function as function, l.file as file from same_first_parameter as l join "binding-read" as r on l.first = r.reference and l.file = r.file where r.state = "unique-declaration";
let class_name_uses = select l.call as call, l.class as class, r.binding as binding, l.file as file from class_name_reads as l join "binding-use" as r on l.first = r.reference and l.file = r.file where r.certainty = "unique";
let same_class = select l.call as call, l.file as file from class_name_uses as l join stable_class_definitions as r on l.binding = r.class and l.class = r.class and l.file = r.file;
let class_attribute_nodes = select id as expr, file from syntax where kind = "attribute";
let class_attribute_values = select l.expr as expr, r.child as value, l.file as file from class_attribute_nodes as l join "semantic-child" as r on l.expr = r.parent and l.file = r.file where r.field = "value";
let class_attribute_labels0 = select l.expr as expr, r.child as label, l.file as file from class_attribute_nodes as l join "semantic-child" as r on l.expr = r.parent and l.file = r.file where r.field = "attr";
let class_attribute_labels = select l.expr as expr, r.name as name, l.file as file from class_attribute_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let class_attribute_parts = select l.expr as expr, l.value as value, r.name as name, l.file as file from class_attribute_values as l join class_attribute_labels as r on l.expr = r.expr and l.file = r.file;
let class_attribute_heads = select l.expr as expr, l.value as head, l.name as name, l.file as file from class_attribute_parts as l join names as r on l.value = r.id and l.file = r.file;
let class_attribute_reads = select l.expr as expr, l.head as head, l.name as name, l.file as file from class_attribute_heads as l join "binding-read" as r on l.head = r.reference and l.file = r.file where r.state = "unique-declaration";
let class_attribute_uses = select l.expr as expr, l.name as name, r.binding as binding, l.file as file from class_attribute_reads as l join "binding-use" as r on l.head = r.reference and l.file = r.file where r.certainty = "unique";
let class_attribute_roots = select l.expr as expr, l.name as name, r.class as root, l.file as file from class_attribute_uses as l join stable_class_definitions as r on l.binding = r.class and l.file = r.file;
let resolved_class_one = select l.expr as expr, r.class as class, l.file as file from class_attribute_roots as l join stable_class_definitions as r on l.root = r.owner and l.name = r.name and l.file = r.file;
let nested_class_attributes = select l.expr as expr, l.name as name, r.class as parent_class, l.file as file from class_attribute_parts as l join resolved_class_one as r on l.value = r.expr and l.file = r.file;
let resolved_class_two = select l.expr as expr, r.class as class, l.file as file from nested_class_attributes as l join stable_class_definitions as r on l.parent_class = r.owner and l.name = r.name and l.file = r.file;
let resolved_class_chains = union(left=resolved_class_one, right=resolved_class_two);
let mutation_statements = select id, file from syntax where kind = "assign" or kind = "ann-assign" or kind = "aug-assign" or kind = "delete" or kind = "named-expr" or kind = "for" or kind = "async-for" or kind = "withitem";
let mutation_targets = select l.id as statement, r.child as target, l.file as file from mutation_statements as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets" or r.field = "target" or r.field = "optional-vars";
let mutation_positions = select l.target as target, l.file as file, r."start-byte" as start from mutation_targets as l join "source-location" as r on l.target = r.id and l.file = r.file;
let mutated_class_chains = select r.class as class, l.file as file, l.start as start from mutation_positions as l join resolved_class_chains as r on l.target = r.expr and l.file = r.file;
let later_mutated_classes = select l.class as class, l.file as file from mutated_class_chains as l join class_definition_positions as r on l.class = r.class and l.file = r.file where l.start > r.start;
let unmutated_class_one = antijoin(left=resolved_class_one, right=later_mutated_classes, left-on=["class", "file"], right-on=["class", "file"]);
let unmutated_class_two0 = antijoin(left=resolved_class_two, right=later_mutated_classes, left-on=["class", "file"], right-on=["class", "file"]);
let mutated_class_parents = select l.expr as expr, l.file as file from nested_class_attributes as l join later_mutated_classes as r on l.parent_class = r.class and l.file = r.file;
let unmutated_class_two = antijoin(left=unmutated_class_two0, right=mutated_class_parents, left-on=["expr", "file"], right-on=["expr", "file"]);
let unmutated_class_chains = union(left=unmutated_class_one, right=unmutated_class_two);
let class_chain_calls = select l.call as call, l.file as file from same_first_parameter as l join unmutated_class_chains as r on l.first = r.expr and l.class = r.class and l.file = r.file;
let cell_calls = select call, file from implicit_class_cells;
let candidate_class_calls = union(left=same_class, right=class_chain_calls);
let candidate_calls = union(left=candidate_class_calls, right=cell_calls);

let decorator_edges = select parent as class, child as list, file from "semantic-child" where field = "decorator-list";
let decorator_items = select l.class as class, r.child as decorator, l.file as file from decorator_edges as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let dataclass_calls = select l.class as class, l.decorator as decorator, l.file as file from decorator_items as l join "semantic-syntax" as r on l.decorator = r.id and l.file = r.file where r.kind = "call";
let dataclass_functions = select l.class as class, l.decorator as decorator, r.child as function, l.file as file from dataclass_calls as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file where r.field = "func";
let dataclass_origins = select l.class as class, l.decorator as decorator, l.file as file from dataclass_functions as l join "qualified-name" as r on l.function = r.id and l.file = r.file where r.path = "dataclasses.dataclass";
let dataclass_wrappers = select l.class as class, l.decorator as decorator, r.wrapper as wrapper, l.file as file from dataclass_origins as l join wrappers as r on l.decorator = r.call and l.file = r.file;
let dataclass_keywords = select l.class as class, r.child as keyword, l.file as file from dataclass_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_names = select l.class as class, l.keyword as keyword, r.child as identifier, l.file as file from dataclass_keywords as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let slots_keywords = select l.class as class, l.keyword as keyword, l.file as file from keyword_names as l join "identifier" as r on l.identifier = r.id and l.file = r.file where r.name = "slots";
let slots_values = select l.class as class, r.child as value, l.file as file from slots_keywords as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let slotted_classes = select l.class as class, l.file as file from slots_values as l join "literal-properties" as r on l.value = r.id and l.file = r.file where r.kind = "boolean" and r.boolean = "true";
let slotted_calls = select l.call as call, l.file as file from owner_calls as l join slotted_classes as r on l.class = r.class and l.file = r.file;
let safe_candidates = antijoin(left=candidate_calls, right=slotted_calls, left-on=["call", "file"], right-on=["call", "file"]);
let literal_super_names = select l.call as call, l.file as file from called_names as l join "identifier" as r on l.function = r.id and l.file = r.file where r.name = "super";
let definite_bare_super = select l.call as call, l.file as file from super_calls0 as l join literal_super_names as r on l.call = r.call and l.file = r.file;
let called_bare_super = select l.call as id, l.file as file from safe_candidates as l join definite_bare_super as s on l.call = s.call and l.file = s.file;
let called_qualified_super = select l.call as id, l.file as file from safe_candidates as l join qualified_with_any_cell as s on l.call = s.call and l.file = s.file;
let called_super = union(left=called_bare_super, right=called_qualified_super);
let argument_ranges = select l.id as id, l.file as file, r.wrapper as wrapper from called_super as l join wrappers as r on l.id = r.call and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from argument_ranges as l join "source-location" as r on l.wrapper = r.id and l.file = r.file;
let call_spans = select l.id as id, l.file as file, r.span as span from called_super as l join calls as r on l.id = r.id and l.file = r.file;
let call_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from call_spans as l join "source-location" as r on l.id = r.id and l.file = r.file;
let unsuppressed_calls = suppress(candidates=call_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP008(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP008)(?:,|$)");
let violations = select l.id as id, l.file as file, r.span as span from unsuppressed_calls as l join candidate_locations as r on l.id = r.id and l.file = r.file;
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP008)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP008)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP008"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
