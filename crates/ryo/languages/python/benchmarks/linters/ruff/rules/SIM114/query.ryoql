import observation_matches from "python/ruff/suppress-matches";
import statement_equal from "python/ruff/statement-equal";
let ifs = select id, file from "semantic-syntax" where kind = "if";
let clause_nodes = select id, file from "semantic-syntax" where kind = "elif-else-clause";
let tests = select parent as branch, child as test, file from "semantic-child" where field = "test";
let clauses0 = select l.id as root, r.child as branch, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "orelse";
let tested_clauses = select l.root as root, l.branch as branch, l.file as file from clauses0 as l join tests as r on l.branch = r.branch and l.file = r.file;
let first_branches = select id as root, id as branch, file from ifs;
let branches0 = union(left=first_branches, right=tested_clauses);
let locations = select id, span, "start-byte", "end-byte", "start-line", "end-line", file from "source-location";
let branches = select l.root as root, l.branch as branch, r."start-byte" as position, l.file as file from branches0 as l join locations as r on l.branch = r.id and l.file = r.file;
let following = select l.root as root, l.branch as left_branch, r.branch as right_branch, r.position as right_position, l.file as file from branches as l join branches as r on l.root = r.root and l.file = r.file where l.position < r.position;
let not_next = select l.root as root, l.left_branch as left_branch, l.right_branch as right_branch, l.file as file from following as l join following as r on l.root = r.root and l.left_branch = r.left_branch and l.file = r.file where r.right_position < l.right_position;
let adjacent = antijoin(left=following, right=not_next, left-on=["root", "left_branch", "right_branch", "file"], right-on=["root", "left_branch", "right_branch", "file"]);
let body_members = select l.branch as branch, r.child as statement, r.ordinal as ordinal, l.file as file from branches as l join "semantic-child" as r on l.branch = r.parent and l.file = r.file where r.field = "body";
let predecessors = select l.branch as branch, l.statement as statement, r.statement as earlier, l.file as file from body_members as l join body_members as r on l.branch = r.branch and l.file = r.file where r.ordinal < l.ordinal;
let ranks0 = group-count(from=predecessors, keys=["branch", "statement", "file"], count="position", distinct="earlier");
let first_members0 = antijoin(left=body_members, right=ranks0, left-on=["branch", "statement", "file"], right-on=["branch", "statement", "file"]);
let first_members1 = select branch, statement, file from first_members0;
let first_members2 = extend(from=first_members1, values={position: 0});
let first_members = select branch, statement, file, position from first_members2;
let later_members = select branch, statement, file, position from ranks0;
let ranked_members = union(left=first_members, right=later_members);
let body_counts = group-count(from=body_members, keys=["branch", "file"], count="count", distinct="statement");
let left_counts = select l.root as root, l.left_branch as left_branch, l.right_branch as right_branch, r.count as count, l.file as file from adjacent as l join body_counts as r on l.left_branch = r.branch and l.file = r.file;
let equal_lengths = select l.root as root, l.left_branch as left_branch, l.right_branch as right_branch, l.file as file from left_counts as l join body_counts as r on l.right_branch = r.branch and l.count = r.count and l.file = r.file;
let left_members = select l.root as root, l.left_branch as left_branch, l.right_branch as right_branch, r.statement as left, r.position as position, l.file as file from equal_lengths as l join ranked_members as r on l.left_branch = r.branch and l.file = r.file;
let statement_pairs = select l.left_branch as context, l.left as left, r.statement as right, l.file as file from left_members as l join ranked_members as r on l.right_branch = r.branch and l.position = r.position and l.file = r.file;
let equal_statements = statement_equal(pairs=statement_pairs);
let missing_statements = antijoin(left=statement_pairs, right=equal_statements, left-on=["context", "left", "right", "file"], right-on=["context", "left", "right", "file"]);
let same_bodies = antijoin(left=equal_lengths, right=missing_statements, left-on=["left_branch", "file"], right-on=["context", "file"]);
let earlier_body_members = select l.branch as branch, l.statement as statement, l.file as file from body_members as l join body_members as r on l.branch = r.branch and l.file = r.file where l.ordinal < r.ordinal;
let last_body_members = antijoin(left=body_members, right=earlier_body_members, left-on=["branch", "statement", "file"], right-on=["branch", "statement", "file"]);
let body_ends = select l.branch as branch, r."end-line" as end_line, r.span as end_span, l.file as file from last_body_members as l join locations as r on l.statement = r.id and l.file = r.file;
let test_ends = select l.branch as branch, r."end-line" as start_line, l.file as file from tests as l join locations as r on l.test = r.id and l.file = r.file;
let body_ranges = select l.branch as branch, l.end_line as end_line, r.start_line as start_line, l.file as file from body_ends as l join test_ends as r on l.branch = r.branch and l.file = r.file;
let comment_positions = select l.id as comment, l.text as text, r."start-line" as line, r."start-byte" as position, l.file as file from "comment" as l join locations as r on l.id = r.id and l.file = r.file;
let body_comments = select l.branch as branch, r.comment as comment, r.text as text, r.position as position, l.file as file from body_ranges as l join comment_positions as r on l.file = r.file where r.line > l.start_line and r.line <= l.end_line;
let comment_predecessors = select l.branch as branch, l.comment as comment, r.comment as earlier, l.file as file from body_comments as l join body_comments as r on l.branch = r.branch and l.file = r.file where r.position < l.position;
let comment_ranks0 = group-count(from=comment_predecessors, keys=["branch", "comment", "file"], count="ordinal", distinct="earlier");
let first_comments0 = antijoin(left=body_comments, right=comment_ranks0, left-on=["branch", "comment", "file"], right-on=["branch", "comment", "file"]);
let first_comments1 = select branch, comment, file from first_comments0;
let first_comments2 = extend(from=first_comments1, values={ordinal: 0});
let first_comments = select branch, comment, file, ordinal from first_comments2;
let later_comments = select branch, comment, file, ordinal from comment_ranks0;
let comment_ranks = union(left=first_comments, right=later_comments);
let ranked_comments = select l.branch as branch, l.comment as comment, l.text as text, r.ordinal as ordinal, l.file as file from body_comments as l join comment_ranks as r on l.branch = r.branch and l.comment = r.comment and l.file = r.file;
let left_comments = select l.left_branch as context, l.right_branch as right_branch, r.comment as comment, r.text as text, r.ordinal as ordinal, l.file as file from same_bodies as l join ranked_comments as r on l.left_branch = r.branch and l.file = r.file;
let right_comments = select l.left_branch as context, l.right_branch as right_branch, r.comment as comment, r.text as text, r.ordinal as ordinal, l.file as file from same_bodies as l join ranked_comments as r on l.right_branch = r.branch and l.file = r.file;
let equal_left_comments = select l.context as context, l.comment as comment, l.file as file from left_comments as l join right_comments as r on l.context = r.context and l.right_branch = r.right_branch and l.ordinal = r.ordinal and l.text = r.text and l.file = r.file;
let equal_right_comments = select r.context as context, r.comment as comment, r.file as file from left_comments as l join right_comments as r on l.context = r.context and l.right_branch = r.right_branch and l.ordinal = r.ordinal and l.text = r.text and l.file = r.file;
let missing_left_comments = antijoin(left=left_comments, right=equal_left_comments, left-on=["context", "comment", "file"], right-on=["context", "comment", "file"]);
let missing_right_comments = antijoin(left=right_comments, right=equal_right_comments, left-on=["context", "comment", "file"], right-on=["context", "comment", "file"]);
let mismatched_comments0 = select context, file from missing_left_comments;
let mismatched_comments1 = select context, file from missing_right_comments;
let mismatched_comments = union(left=mismatched_comments0, right=mismatched_comments1);
let reportable = antijoin(left=same_bodies, right=mismatched_comments, left-on=["left_branch", "file"], right-on=["context", "file"]);
let bounds0 = select l.left_branch as id, l.right_branch as right_branch, r.span as start_span, r."start-line" as line, l.file as file from reportable as l join locations as r on l.left_branch = r.id and l.file = r.file;
let bounds = select l.id as id, l.start_span as start_span, r.end_span as end_span, l.line as line, l.file as file from bounds0 as l join body_ends as r on l.right_branch = r.branch and l.file = r.file;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:SIM114)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM114"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
