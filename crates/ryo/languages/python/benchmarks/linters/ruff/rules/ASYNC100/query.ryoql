import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let with_statements = select id, file, span, kind from "semantic-syntax" where kind = "with" or kind = "async-with";
let with_items = select l.parent as statement, l.child as item, l.ordinal as ordinal, r.file as file from "semantic-child" as l join with_statements as r on l.parent = r.id where l.field = "items";
let later_items = select l.statement as statement, l.item as earlier from with_items as l join with_items as r on l.statement = r.statement where r.ordinal > l.ordinal;
let item_contexts = select l.parent as item, l.child as expression, r.file as file from "semantic-child" as l join with_items as r on l.parent = r.item where l.field = "context-expr";
let calls = select id, file from "semantic-syntax" where kind = "call";
let context_calls = select l.item as item, l.file as file, r.id as call from item_contexts as l join calls as r on l.expression = r.id;
let call_functions = select l.parent as call, l.child as function from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "func";
let timeout_functions = select id from "qualified-name" where path = "asyncio.timeout" or path = "asyncio.timeout_at" or path = "anyio.move_on_after" or path = "anyio.fail_after" or path = "anyio.CancelScope" or path = "trio.CancelScope" or path = "trio.fail_after" or path = "trio.fail_at" or path = "trio.move_on_after" or path = "trio.move_on_at";
let timeout_calls = select l.call as call from call_functions as l join timeout_functions as r on l.function = r.id;
let timeout_context_calls = select l.item as item from context_calls as l join timeout_calls as r on l.call = r.call;
let checked_timeout_items = select l.statement as statement, l.item as item, l.ordinal as ordinal, l.file as file from with_items as l join timeout_context_calls as r on l.item = r.item;
let async_timeout_items = select l.statement as statement, l.item as item, l.ordinal as ordinal, l.file as file from checked_timeout_items as l join with_statements as r on l.statement = r.id where r.kind = "async-with";
let async_with_later = select l.statement as statement, l.item as item from async_timeout_items as l join later_items as r on l.statement = r.statement and l.item = r.earlier;
let final_async_timeout_items = antijoin(left=async_timeout_items, right=async_with_later, left-on=["statement", "item"], right-on=["statement", "item"]);
let sync_timeout_items = select l.statement as statement, l.item as item, l.file as file from checked_timeout_items as l join with_statements as r on l.statement = r.id where r.kind = "with";
let final_async_timeout_rows = select statement, item, file from final_async_timeout_items;
let applicable_timeout_items = union(left=final_async_timeout_rows, right=sync_timeout_items);
let bodies = select l.parent as statement, l.child as body, r.file as file from "semantic-child" as l join with_statements as r on l.parent = r.id where l.field = "body";
let body_root_ids = select body as id, file from bodies;
let yield_nodes = select id, file from "semantic-syntax" where kind = "yield" or kind = "yield-from";
let yield_descendants = axis(from=body_root_ids, relation="semantic-child", direction=descendant, domain=yield_nodes);
let yield_body_candidates = select l.statement as statement, r.related as id from bodies as l join yield_descendants as r on l.body = r.id;
let yield_body_roots = select l.statement as statement from yield_body_candidates as l join yield_nodes as r on l.id = r.id;
let direct_yield_roots = select l.statement as statement from bodies as l join yield_nodes as r on l.body = r.id;
let yield_roots = union(left=yield_body_roots, right=direct_yield_roots);
let async_checkpoint_nodes = select id, file from "semantic-syntax" where kind = "await" or kind = "async-with" or kind = "async-for";
let checkpoint_descendants = axis(from=body_root_ids, relation="semantic-child", direction=descendant, domain=async_checkpoint_nodes);
let checkpoint_candidates = select l.statement as statement, r.related as checkpoint from bodies as l join checkpoint_descendants as r on l.body = r.id;
let checkpoint_descendant_roots = select l.statement as statement, l.checkpoint as checkpoint from checkpoint_candidates as l join async_checkpoint_nodes as r on l.checkpoint = r.id;
let direct_checkpoints = select l.statement as statement, r.id as checkpoint from bodies as l join async_checkpoint_nodes as r on l.body = r.id;
let ordinary_checkpoints = union(left=checkpoint_descendant_roots, right=direct_checkpoints);
let comprehensions = select id, file from "semantic-syntax" where kind = "comprehension";
let async_keywords = select id, file from "syntax-tree" where text = "async";
let async_comprehension_owners = axis(from=async_keywords, relation="syntax-child", direction=nearest-ancestor, domain=comprehensions);
let async_comprehensions = group-count(from=async_comprehension_owners, keys=["related"], count="count");
let body_comprehensions = axis(from=body_root_ids, relation="semantic-child", direction=descendant, domain=comprehensions);
let body_comprehension_candidates = select l.statement as statement, r.related as checkpoint from bodies as l join body_comprehensions as r on l.body = r.id;
let comprehension_checkpoints = select l.statement as statement, l.checkpoint as checkpoint from body_comprehension_candidates as l join async_comprehensions as r on l.checkpoint = r.related;
let ordinary_and_comprehension_checkpoints = union(left=ordinary_checkpoints, right=comprehension_checkpoints);
let scopes = select id, file from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let statement_scopes = axis(from=with_statements, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let checkpoint_scope_ids = select l.checkpoint as id, r.file as file from ordinary_and_comprehension_checkpoints as l join with_statements as r on l.statement = r.id;
let checkpoint_scopes = axis(from=checkpoint_scope_ids, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let statement_checkpoint_scopes = select l.statement as statement, l.checkpoint as checkpoint, r.related as statement_scope from ordinary_and_comprehension_checkpoints as l join statement_scopes as r on l.statement = r.id;
let matching_checkpoint_scopes = select l.statement as statement from statement_checkpoint_scopes as l join checkpoint_scopes as r on l.checkpoint = r.id and l.statement_scope = r.related;
let yield_and_scope_checkpoints = union(left=yield_roots, right=matching_checkpoint_scopes);
let applicable_statements = group-count(from=applicable_timeout_items, keys=["statement"], count="count");
let reportable_statements = antijoin(left=applicable_statements, right=yield_and_scope_checkpoints, left-on=["statement"], right-on=["statement"]);
let reportable = select l.statement as id, r.file as file, r.span as span from reportable_statements as l join with_statements as r on l.statement = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC100(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC100)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:ASYNC100)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC100)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "ASYNC100"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
