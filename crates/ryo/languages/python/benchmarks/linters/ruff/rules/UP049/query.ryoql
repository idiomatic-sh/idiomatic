import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, file from "semantic-syntax";
let declarations = select id, file from nodes where kind = "class-def" or kind = "function-def" or kind = "async-function-def";
let parameters = select id, file from nodes where kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let definitions = select id, owner, name, file, span from "defines";
let parameter_definitions = select l.id as id, r.owner as owner, r.name as name, r.file as file, r.span as span from parameters as l join definitions as r on l.id = r.id and l.file = r.file;
let declared_parameters = select l.id as id, l.name as name, l.file as file, l.span as span from parameter_definitions as l join declarations as r on l.owner = r.id and l.file = r.file;
let leading_underscores = select id, file, span from declared_parameters where matches(name, "^_");
let trailing_underscores = select id, file from declared_parameters where matches(name, "_$");
let private_parameters = antijoin(left=leading_underscores, right=trailing_underscores, left-on=["id","file"], right-on=["id","file"]);
let candidates = select l.id as id, l.file as file, l.span as span, r."start-line" as line from private_parameters as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:UP049)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP049"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
