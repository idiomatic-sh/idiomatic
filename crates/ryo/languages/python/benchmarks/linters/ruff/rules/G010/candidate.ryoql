import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let warn_functions = select id, file from "qualified-name" where path = "logging.warn";
let direct_warn_functions = select l.function as id from call_functions as l join warn_functions as r on l.function = r.id;
let direct_warn_attributes = select l.id as id, r.file as file from direct_warn_functions as l join "semantic-syntax" as r on l.id = r.id where r.kind = "attribute";
let direct_warn_names = select l.id as id, r.file as file, r.span as span from direct_warn_functions as l join "semantic-syntax" as r on l.id = r.id where r.kind = "name";
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let direct_warn_attr_tokens = select r.child as id from direct_warn_attributes as l join attr_tokens as r on l.id = r.parent;
let direct_warn_attr_token_nodes = select l.id as id, r.file as file, r.span as span from direct_warn_attr_tokens as l join "semantic-syntax" as r on l.id = r.id;
let direct_warn_name_nodes = select id, file, span from direct_warn_names;
let direct_warn_locations = union(left=direct_warn_attr_token_nodes,right=direct_warn_name_nodes);
let attributes = select id, file, span from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child from "semantic-child" where field = "value";
let attribute_bases = select l.parent as attribute, l.child as base from attribute_values as l join attributes as r on l.parent = r.id;
let logger_module_names = select id, file, path from "qualified-name" where path = "logging" or path = "flask.current_app.logger";
let qualified_logger_bases = select l.attribute as attribute from attribute_bases as l join logger_module_names as r on l.base = r.id;
let call_bases = select l.attribute as attribute, l.base as call from attribute_bases as l join "semantic-syntax" as r on l.base = r.id where r.kind = "call";
let call_base_functions = select l.attribute as attribute, l.call as call, r.child as function from call_bases as l join function_fields as r on l.call = r.parent;
let logger_constructors = select id from "qualified-name" where path = "logging.getLogger" or path = "logging.Logger";
let inline_logger_matches = select l.attribute as attribute from call_base_functions as l join logger_constructors as r on l.function = r.id;
let identifier_nodes = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from identifiers as l join identifier_nodes as r on l.id = r.id;
let name_fields = select parent, child from "semantic-child" where field = "id";
let base_name_fields = select l.attribute as attribute, r.child as name from attribute_bases as l join name_fields as r on l.base = r.parent;
let base_name_tokens = select l.attribute as attribute, r.text as text from base_name_fields as l join semantic_identifiers as r on l.name = r.id;
let attr_name_fields = select l.attribute as attribute, r.child as name from attribute_bases as l join attr_fields as r on l.base = r.parent;
let attr_name_token_ids = select l.attribute as attribute, r.child as id from attr_name_fields as l join "semantic-child" as r on l.name = r.parent;
let attr_name_tokens = select l.attribute as attribute, r.text as text from attr_name_token_ids as l join semantic_identifiers as r on l.id = r.id;
let base_names = union(left=base_name_tokens,right=attr_name_tokens);
let heuristic_names = select attribute from base_names where matches(text, "^(?:log.*|.*logger|.*logging|LOG.*|.*LOGGER|.*LOGGING)$");
let resolved_names = select id from "qualified-name" where provenance = "import" or provenance = "builtin";
let any_qualified_bases = select l.attribute as attribute from attribute_bases as l join resolved_names as r on l.base = r.id;
let unresolved_heuristic_names = antijoin(left=heuristic_names,right=any_qualified_bases,left-on=["attribute"],right-on=["attribute"]);
let logger_bases_a = union(left=qualified_logger_bases,right=inline_logger_matches);
let logger_bases = union(left=logger_bases_a,right=unresolved_heuristic_names);
let warn_attribute_nodes = select l.parent as attribute from attr_tokens as l join semantic_identifiers as r on l.child = r.id where r.text = "warn";
let matched_logger_attributes = select l.attribute as id from logger_bases as l join warn_attribute_nodes as r on l.attribute = r.attribute;
let called_logger_attributes = select l.id as id from matched_logger_attributes as l join call_functions as r on l.id = r.function;
let logger_warn_fields = select l.id as attribute, r.child as wrapper from called_logger_attributes as l join attr_fields as r on l.id = r.parent;
let logger_warn_token_ids = select l.attribute as attribute, r.child as id from logger_warn_fields as l join "semantic-child" as r on l.wrapper = r.parent;
let custom_warn_locations = select l.id as id, r.file as file, r.span as span from logger_warn_token_ids as l join "semantic-syntax" as r on l.id = r.id;
let reportable_locations = union(left=direct_warn_locations,right=custom_warn_locations);
let candidate_locations = select id, file, span, r."start-line" as line from reportable_locations as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*G010(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:G010)(?:,|$)");
emit violations subject file key(id);
