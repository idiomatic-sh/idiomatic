import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress-unmapped";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let lru_functions = select id, file from "qualified-name" where path = "functools.lru_cache";
let lru_calls = select l.call as call, l.file as file from call_functions as l join lru_functions as r on l.function = r.id and l.file = r.file;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let argument_fields = select parent, child from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_argument_edges = select l.call as call, r.child as wrapper from lru_calls as l join argument_fields as r on l.call = r.parent;
let lru_wrappers = select l.call as call, l.wrapper as wrapper from call_argument_edges as l join argument_nodes as r on l.wrapper = r.id;
let calls_with_args = select l.call as call from lru_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let calls_with_keywords = select l.call as call from lru_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let no_positional_args = antijoin(left=lru_calls,right=calls_with_args,left-on=["call"],right-on=["call"]);
let no_args_or_keywords = antijoin(left=no_positional_args,right=calls_with_keywords,left-on=["call"],right-on=["call"]);
let decorator_edges = select parent, child from "semantic-child" where field = "decorator-list";
let child_edges = select parent, child from "semantic-child";
let decorator_expressions = select l.parent as declaration, r.child as expression from decorator_edges as l join child_edges as r on l.child = r.parent;
let decorator_calls = select l.call as call, l.file as file from no_args_or_keywords as l join decorator_expressions as r on l.call = r.expression;
let call_argument_nodes = select id, file, span from "semantic-syntax" where kind = "call-arguments";
let argument_children = select parent, child from "semantic-child";
let call_args_wrappers = select l.call as call, r.child as arguments, l.file as file from decorator_calls as l join argument_children as r on l.call = r.parent;
let reportable = select l.arguments as id, l.file as file, r.span as span from call_args_wrappers as l join call_argument_nodes as r on l.arguments = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP011(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP011)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP011)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP011)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP011"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
