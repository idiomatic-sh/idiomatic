import observation_matches from "python/ruff/suppress-matches";
import in_comparison from "python/ruff/in-comparison";
import binding_type from "python/ruff/binding-type";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let clauses = select parent as id, file from "semantic-child" where field = "orelse";
let simple_ifs = antijoin(left=ifs, right=clauses, left-on=["id","file"], right-on=["id","file"]);
let body_elements = select l.id as statement, r.child as body, l.file as file from simple_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=body_elements, keys=["statement","file"], count="count", distinct="body");
let single_bodies = select l.statement as statement, l.body as body, l.file as file from body_elements as l join body_counts as r on l.statement = r.statement and l.file = r.file where r.count = 1;
let deletes = select id, file from nodes where kind = "delete";
let delete_bodies = select l.statement as statement, l.body as deletion, l.file as file from single_bodies as l join deletes as r on l.body = r.id and l.file = r.file;
let tests = select l.statement as statement, l.deletion as deletion, r.child as test, l.file as file from delete_bodies as l join "semantic-child" as r on l.statement = r.parent and l.file = r.file where r.field = "test";
let compares = select id, file from nodes where kind = "compare";
let compare_tests = select l.statement as statement, l.deletion as deletion, l.test as test, l.file as file from tests as l join compares as r on l.test = r.id and l.file = r.file;
let comparison_inputs = select test as id, file from compare_tests;
let memberships = in_comparison(expressions=comparison_inputs);
let in_tests = select id as test, container, key, file from memberships;
let names = select id, file from nodes where kind = "name";
let named_tests = select l.test as test, l.container as container, l.key as key, l.file as file from in_tests as l join names as r on l.container = r.id and l.file = r.file;
let typed_inputs = select container as reference, file from named_tests;
let dict_references = binding_type(references=typed_inputs, builtin="builtins.dict", typing="Dict", atom="dict");
let dict_tests = select l.test as test, l.container as container, l.key as key, l.file as file from named_tests as l join dict_references as r on l.container = r.reference and l.file = r.file;
let delete_targets = select l.deletion as deletion, r.child as target, l.file as file from delete_bodies as l join "semantic-child" as r on l.deletion = r.parent and l.file = r.file where r.field = "targets";
let target_counts = group-count(from=delete_targets, keys=["deletion","file"], count="count", distinct="target");
let one_targets = select l.deletion as deletion, l.target as target, l.file as file from delete_targets as l join target_counts as r on l.deletion = r.deletion and l.file = r.file where r.count = 1;
let subscripts = select id, file from nodes where kind = "subscript";
let delete_subscripts = select l.deletion as deletion, l.target as target, l.file as file from one_targets as l join subscripts as r on l.target = r.id and l.file = r.file;
let deleted_containers = select l.deletion as deletion, l.target as target, r.child as container, l.file as file from delete_subscripts as l join "semantic-child" as r on l.target = r.parent and l.file = r.file where r.field = "value";
let named_deletions = select l.deletion as deletion, l.target as target, l.container as container, l.file as file from deleted_containers as l join names as r on l.container = r.id and l.file = r.file;
let deleted_keys = select l.deletion as deletion, l.container as container, r.child as key, l.file as file from named_deletions as l join "semantic-child" as r on l.target = r.parent and l.file = r.file where r.field = "slice";
let paired_tests = select l.test as test, l.container as tested_container, l.key as tested_key, r.deletion as deletion, l.file as file from dict_tests as l join compare_tests as r on l.test = r.test and l.file = r.file;
let pairs = select l.test as test, l.tested_container as tested_container, l.tested_key as tested_key, l.deletion as deletion, r.container as deleted_container, r.key as deleted_key, l.file as file from paired_tests as l join deleted_keys as r on l.deletion = r.deletion and l.file = r.file;
let named_containers = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_container as deleted_container, l.deleted_key as deleted_key, r.name as name, l.file as file from pairs as l join "identifier" as r on l.tested_container = r.id and l.file = r.file;
let same_containers = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, l.file as file from named_containers as l join "identifier" as r on l.deleted_container = r.id and l.name = r.name and l.file = r.file;
let named_keys0 = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, r.name as name, l.file as file from same_containers as l join "identifier" as r on l.tested_key = r.id and l.file = r.file;
let same_named_keys = select l.deletion as id, l.file as file from named_keys0 as l join "identifier" as r on l.deleted_key = r.id and l.name = r.name and l.file = r.file;
let constants = select id, file from nodes where kind = "constant";
let constant_test_keys = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, l.file as file from same_containers as l join constants as r on l.tested_key = r.id and l.file = r.file;
let constant_pairs = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, l.file as file from constant_test_keys as l join constants as r on l.deleted_key = r.id and l.file = r.file;
let typed_test_keys = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, r.kind as kind, l.file as file from constant_pairs as l join "literal-properties" as r on l.tested_key = r.id and l.file = r.file;
let same_typed_keys = select l.test as test, l.tested_key as tested_key, l.deletion as deletion, l.deleted_key as deleted_key, l.file as file from typed_test_keys as l join "literal-properties" as r on l.deleted_key = r.id and l.kind = r.kind and l.file = r.file;
let left_keys = select l.deletion as deletion, l.deleted_key as deleted_key, r.key as key, l.file as file from same_typed_keys as l join "constant-key" as r on l.tested_key = r.id and l.file = r.file;
let same_constant_keys = select l.deletion as id, l.file as file from left_keys as l join "constant-key" as r on l.deleted_key = r.id and l.key = r.key and l.file = r.file;
let candidates = union(left=same_named_keys, right=same_constant_keys);
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:RUF051)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF051"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
