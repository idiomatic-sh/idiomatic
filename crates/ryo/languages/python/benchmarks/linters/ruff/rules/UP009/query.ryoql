import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress-unmapped";
let comment_rows = select id, file, text from "comment";
let comment_positions = select l.id as id, l.file as file, l.text as text, r."start-byte" as begin, r."end-byte" as finish, r."start-line" as line from comment_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let coding_comments = select * from comment_positions where matches(text, "^\s*coding[:=]\s*[-_.a-zA-Z0-9]+");
let utf8_comments = select * from coding_comments where matches(text, "^\s*coding[:=]\s*(?:utf8|utf-8)(?:$|[^-_.a-zA-Z0-9])");
let earlier_coding = select l.id as later from coding_comments as l join coding_comments as r on l.file = r.file where l.begin > r.begin;
let first_coding = antijoin(left=coding_comments,right=earlier_coding,left-on=["id"],right-on=["later"]);
let first_utf8 = select l.id as id, l.file as file, l.begin as begin, l.finish as finish, l.line as line from first_coding as l join utf8_comments as r on l.id = r.id and l.file = r.file where l.line <= 2;
let preamble_code_tokens = select id, file from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let token_positions = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from preamble_code_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let code_before_cookie = select l.id as cookie from first_utf8 as l join token_positions as r on l.file = r.file where r.begin < l.begin;
let leading_utf8 = antijoin(left=first_utf8,right=code_before_cookie,left-on=["id"],right-on=["cookie"]);
let later_comments = select l.id as candidate, l.file as file, l.finish as cookie_end, r.id as later, r.begin as later_begin from leading_utf8 as l join comment_positions as r on l.file = r.file where r.begin > l.finish;
let intervening_comments = select l.candidate as candidate, l.later as later, r.id as between_id from later_comments as l join comment_positions as r on l.file = r.file where r.begin > l.cookie_end and r.begin < l.later_begin;
let intervening_counts = group-count(from=intervening_comments, keys=["candidate", "later"], count="count", distinct="between_id");
let zero_between = antijoin(left=later_comments,right=intervening_counts,left-on=["candidate", "later"],right-on=["candidate", "later"]);
let one_between_rows = select l.candidate as candidate, l.file as file, l.cookie_end as cookie_end, l.later as later, l.later_begin as later_begin from later_comments as l join intervening_counts as r on l.candidate = r.candidate and l.later = r.later where r.count = 1;
let one_between = select candidate, file, cookie_end, later, later_begin from one_between_rows;
let first_two_later = union(left=zero_between,right=one_between);
let token_between = select l.candidate as candidate, l.later as later, r.id as token from first_two_later as l join token_positions as r on r.file = l.file where r.begin >= l.cookie_end and r.begin < l.later_begin;
let contiguous_comments = antijoin(left=first_two_later,right=token_between,left-on=["candidate", "later"],right-on=["candidate", "later"]);
let other_encoding_comments = antijoin(left=coding_comments,right=utf8_comments,left-on=["id"],right-on=["id"]);
let no_encoding_comments = antijoin(left=comment_positions,right=coding_comments,left-on=["id"],right-on=["id"]);
let first_later_other = select l.candidate as candidate from contiguous_comments as l join other_encoding_comments as r on l.later = r.id;
let one_intervening_comment = select l.candidate as candidate, l.later as later, l.between_id as between_id from intervening_comments as l join intervening_counts as r on l.candidate = r.candidate and l.later = r.later where r.count = 1;
let contiguous_one_between = antijoin(left=one_intervening_comment,right=token_between,left-on=["candidate", "later"],right-on=["candidate", "later"]);
let no_encoding_middle = select l.candidate as candidate, l.later as later from contiguous_one_between as l join no_encoding_comments as r on l.between_id = r.id;
let other_second = select l.candidate as candidate from no_encoding_middle as l join other_encoding_comments as r on l.later = r.id;
let conflicts = union(left=first_later_other,right=other_second);
let no_conflicting_encoding = antijoin(left=leading_utf8,right=conflicts,left-on=["id"],right-on=["candidate"]);
let reportable = select id, file from no_conflicting_encoding;
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP009(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP009)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP009)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP009)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP009"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
