import observation_matches from "python/ruff/suppress-matches";
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let comparator_fields = select parent, child from "semantic-child" where field = "comparators";
let comparator_counts = group-count(from=comparator_fields, keys=["parent"], count="count", distinct="child");
let one_comparator_counts = select parent from comparator_counts where count = 1;
let comparator_rows = select l.parent as comparison, l.child as comparator, r.file as file from comparator_fields as l join comparisons as r on l.parent = r.id;
let single_comparators = select l.comparison as comparison, l.comparator as comparator, l.file as file from comparator_rows as l join one_comparator_counts as r on l.comparison = r.parent;
let operator_fields = select parent, child from "semantic-child" where field = "ops";
let operator_counts = group-count(from=operator_fields, keys=["parent"], count="count", distinct="child");
let one_operator_counts = select parent from operator_counts where count = 1;
let operator_rows = select l.parent as comparison, l.child as operator, r.file as file from operator_fields as l join comparisons as r on l.parent = r.id;
let single_operators = select l.comparison as comparison, l.operator as operator, l.file as file from operator_rows as l join one_operator_counts as r on l.comparison = r.parent;
let one_comparisons = select l.comparison as comparison, l.comparator as comparator, l.file as file, r.operator as operator from single_comparators as l join single_operators as r on l.comparison = r.comparison and l.file = r.file;
let left_fields = select parent, child from "semantic-child" where field = "left";
let left_rows = select l.parent as comparison, l.child as left, r.file as file from left_fields as l join comparisons as r on l.parent = r.id;
let left_comparisons = select l.comparison as comparison, l.left as left, l.file as file, r.comparator as comparator, r.operator as operator from left_rows as l join one_comparisons as r on l.comparison = r.comparison and l.file = r.file;
let version_info = select id, file from "qualified-name" where path = "sys.version_info";
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let value_fields = select parent, child from "semantic-child" where field = "value";
let subscript_values = select l.parent as subscript, l.child as value, r.file as file from value_fields as l join subscripts as r on l.parent = r.id;
let version_info_subscripts = select l.subscript as subscript, l.file as file from subscript_values as l join version_info as r on l.value = r.id and l.file = r.file;
let slice_fields = select parent, child from "semantic-child" where field = "slice";
let one_literals = select id, file from "literal-properties" where kind = "integer" and zero = "false";
let zero_literals = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let nonzero_literals = select id, file from "literal-properties" where kind = "integer" and zero = "false";
let integer_literals = union(left=zero_literals,right=nonzero_literals);
let indexed_subscripts = select l.subscript as subscript, l.file as file, r.child as index from version_info_subscripts as l join slice_fields as r on l.subscript = r.parent;
let one_index = select l.subscript as subscript, l.file as file from indexed_subscripts as l join one_literals as r on l.index = r.id and l.file = r.file;
let relational_ops = select id from "semantic-syntax" where text = "<" or text = "<=" or text = ">" or text = ">=";
let matching_ops = select l.comparison as comparison, l.left as left, l.comparator as comparator, l.file as file from left_comparisons as l join relational_ops as r on l.operator = r.id;
let left_matches = select l.comparison as comparison, l.left as left, l.comparator as comparator, l.file as file from matching_ops as l join one_index as r on l.left = r.subscript and l.file = r.file;
let reported_lefts = select l.left as id, l.file as file from left_matches as l join integer_literals as r on l.comparator = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from reported_lefts as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:YTT203)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "YTT203"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
