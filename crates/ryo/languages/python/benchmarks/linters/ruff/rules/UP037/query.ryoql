import observation_matches from "python/ruff/suppress-matches";
import type_context from "python/ruff/type-definition-context";
import annotation_context from "python/ruff/annotation-evaluation-context";
let strings = select id, file from "literal-properties" where kind = "string";
let contexts = type_context(expressions=strings);
let typed = select id, file from contexts where kind = "type";
let annotations = annotation_context(expressions=typed);
let delayed_annotations = select id, file from annotations where evaluation = "postponed" or evaluation = "deferred" or evaluation = "unevaluated";
let stub_annotations = select id, file from annotations where matches(file, "[.]pyi$");
let additional_stub_annotations = antijoin(left=stub_annotations, right=delayed_annotations, left-on=["id","file"], right-on=["id","file"]);
let eligible0 = union(left=delayed_annotations, right=additional_stub_annotations);
let literal_names = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let literal_subscripts = select l.parent as id, l.file as file from "semantic-child" as l join literal_names as r on l.child = r.id and l.file = r.file where l.field = "value";
let literal_members = axis(from=literal_subscripts, relation="semantic-child", direction=descendant, domain=strings);
let literal_ids = select related as id, file from literal_members;
let eligible = antijoin(left=eligible0, right=literal_ids, left-on=["id","file"], right-on=["id","file"]);
let parsed = select id, file from "literal-expression-parse" where dialect = "python-string-annotation" and outcome = "parsed";
let valid = select l.id as id, l.file as file from eligible as l join parsed as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from valid as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:UP037)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP037"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
