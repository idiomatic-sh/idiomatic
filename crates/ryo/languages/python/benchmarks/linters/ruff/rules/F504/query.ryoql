import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let binops = select id, file, span from "semantic-syntax" where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binop_lefts = select l.id as binop, l.file as file, r.child as left from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, l.file as file, r.child as right from binops as l join right_fields as r on l.id = r.parent;
let left_locations = select l.binop as binop, l.left as left, l.file as file, r."end-byte" as left_end from binop_lefts as l join "source-location" as r on l.left = r.id and l.file = r.file;
let right_locations = select l.binop as binop, l.right as right, l.file as file, r."start-byte" as right_start from binop_rights as l join "source-location" as r on l.right = r.id and l.file = r.file;
let ordered_binops = select l.binop as binop, l.left as left, r.right as right, l.file as file, l.left_end as left_end, r.right_start as right_start from left_locations as l join right_locations as r on l.binop = r.binop and l.file = r.file;
let percent_tokens = select l.id as token, r.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "%";
let modulo_candidates = select l.binop as binop, l.left as left, l.right as right, l.file as file from ordered_binops as l join percent_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let format_literals = select l.occurrence as format_id, l.value as value, l.file as file from "string-literal" as l;
let literal_binops = select l.binop as binop, l.left as left, l.right as right, l.file as file, r.format_id as format_id, r.value as format_value from modulo_candidates as l join format_literals as r on l.left = r.format_id and l.file = r.file;
let right_shapes = select l.binop as binop, l.right as right, l.file as file, r.kind as right_kind from literal_binops as l join "semantic-syntax" as r on l.right = r.id and l.file = r.file;
let format_parses = select p.id as id, p.file as file, p.outcome as outcome, p."error-category" as error_category, p."positional-consumption" as positional_consumption, p."mapping-present" as mapping_present, p."dynamic-width" as dynamic_width, p."dynamic-precision" as dynamic_precision from "format-parse" as p where p.dialect = "percent-string" and p.representation = "decoded-string";
let literal_with_right_shape = select l.binop as binop, l.left as left, l.right as right, l.format_id as format_id, l.format_value as format_value, l.file as file, r.right_kind as right_kind from literal_binops as l join right_shapes as r on l.binop = r.binop and l.file = r.file;
let format_expressions = select l.binop as binop, l.left as left, l.right as right, l.format_id as format_id, l.format_value as format_value, l.file as file, l.right_kind as right_kind, r.outcome as outcome, r.error_category as error_category, r.positional_consumption as positional_consumption, r.mapping_present as mapping_present, r.dynamic_width as dynamic_width, r.dynamic_precision as dynamic_precision from literal_with_right_shape as l join format_parses as r on l.format_id = r.id and l.file = r.file;
let parsed_formats = select * from format_expressions where outcome = "parsed";
let dictionaries = select id, file from "semantic-syntax" where kind = "dict";
let key_edges = select parent as dict, child as key from "semantic-child" where field = "keys";
let value_edges = select parent as dict, child as value from "semantic-child" where field = "values";
let dictionary_keys = select l.dict as dict, l.key as key, r.file as file from key_edges as l join dictionaries as r on l.dict = r.id;
let dictionary_values = select l.dict as dict, l.value as value, r.file as file from value_edges as l join dictionaries as r on l.dict = r.id;
let string_keys = select l.dict as dict, l.key as key, r.value as value, l.file as file from dictionary_keys as l join "string-literal" as r on l.key = r.occurrence and l.file = r.file;
let dynamic_keys = antijoin(left=dictionary_keys, right="string-literal", left-on=["key", "file"], right-on=["occurrence", "file"]);
let dynamic_key_dicts = select dict, file from dynamic_keys;
let spread_tokens = select id, file from "syntax-tree" where text = "**";
let spread_dict_owners = axis(from=spread_tokens, relation="semantic-child", direction=nearest-ancestor, domain=dictionaries);
let spread_dicts = select l.related as dict, r.file as file from spread_dict_owners as l join dictionaries as r on l.related = r.id and l.file = r.file;
let invalid_dictionary_a = union(left=dynamic_key_dicts, right=spread_dicts);
let valid_dictionaries = antijoin(left=dictionaries, right=invalid_dictionary_a, left-on=["id", "file"], right-on=["dict", "file"]);
let mapping_contexts = select l.binop as binop, l.format_id as format_id, l.right as dict, l.file as file from parsed_formats as l where l.right_kind = "dict" and l.positional_consumption = 0;
let valid_mapping_contexts = select l.binop as binop, l.format_id as format_id, l.dict as dict, l.file as file from mapping_contexts as l join valid_dictionaries as r on l.dict = r.id and l.file = r.file;
let expression_dictionary_keys = select l.binop as binop, l.format_id as format_id, l.dict as dict, r.key as key, r.value as value, l.file as file from valid_mapping_contexts as l join string_keys as r on l.dict = r.dict and l.file = r.file;
let mapping_format_fields = select f.id as format_id, f."mapping-key" as name, f.file as file from "format-field" as f where f."argument-kind" = "mapping";
let used_dictionary_keys = select l.binop as binop, l.key as key, l.file as file from expression_dictionary_keys as l join mapping_format_fields as r on l.format_id = r.format_id and l.file = r.file where l.value = r.name;
let extra_dictionary_keys = antijoin(left=expression_dictionary_keys, right=used_dictionary_keys, left-on=["binop", "key", "file"], right-on=["binop", "key", "file"]);
let extra_name_counts = group-count(from=extra_dictionary_keys, keys=["binop", "file"], count="count", distinct="value");
let candidates = select l.binop as id, l.file as file, r.span as span from extra_name_counts as l join binops as r on l.binop = r.id and l.file = r.file where l.count > 0;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F504)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F504"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
