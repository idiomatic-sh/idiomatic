import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let qualified = select id, file, span, path from "qualified-name" where path = "datetime.datetime.max" or path = "datetime.datetime.min";
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child from "semantic-child" where field = "value";
let attribute_bases = select l.parent as attribute, l.child as base from attribute_values as l join attributes as r on l.parent = r.id;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let attribute_names = select l.parent as attribute, r.text as name from attr_tokens as l join semantic_identifiers as r on l.child = r.id;
let time_attributes = select attribute from attribute_names where name = "time";
let replace_attributes = select attribute from attribute_names where name = "replace";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_arguments = select l.parent as call, r.id as wrapper from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "call-arguments";
let call_function_attributes = select l.parent as call, l.child as attribute from function_fields as l join attributes as r on l.child = r.id;
let time_calls = select l.call as call, l.attribute as attribute from call_function_attributes as l join time_attributes as r on l.attribute = r.attribute;
let replace_calls = select l.call as call, l.attribute as attribute from call_function_attributes as l join replace_attributes as r on l.attribute = r.attribute;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let call_keyword_edges = select l.call as call, r.child as keyword from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keywords = select l.call as call, l.keyword as keyword from call_keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let keyword_arg_fields = select parent as keyword, child as identifier from "semantic-child" where field = "arg";
let keyword_names = select l.keyword as keyword, r.name as name from keyword_arg_fields as l join "identifier" as r on l.identifier = r.id;
let tzinfo_keywords = select keyword from keyword_names where name = "tzinfo";
let keyword_calls_with_tzinfo = select l.call as call from call_keywords as l join tzinfo_keywords as r on l.keyword = r.keyword;
let selected_replace_calls = select l.call as call, l.attribute as attribute from replace_calls as l join keyword_calls_with_tzinfo as r on l.call = r.call;
let candidate_values = select l.id as expression, r.attribute as attribute from qualified as l join attribute_bases as r on l.id = r.base;
let time_value_uses = select l.expression as id from candidate_values as l join time_calls as r on l.attribute = r.attribute;
let replace_value_uses = select l.expression as id from candidate_values as l join selected_replace_calls as r on l.attribute = r.attribute;
let safe_uses = union(left=time_value_uses, right=replace_value_uses);
let unconverted = antijoin(left=qualified, right=safe_uses, left-on=["id"], right-on=["id"]);
let reportable = select id, file, span from unconverted;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*DTZ901(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:DTZ901)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*DTZ901(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:DTZ901)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "DTZ901"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
