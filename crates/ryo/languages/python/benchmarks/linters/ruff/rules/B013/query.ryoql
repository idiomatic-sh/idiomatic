import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let handlers = select id from "semantic-syntax" where kind = "except-handler";
let types = select parent, child from "semantic-child" where field = "type";
let handled = select r.child as child from handlers as l join types as r on l.id = r.parent;
let tuples = select * from "semantic-syntax" where kind = "tuple";
let elements = select parent, child from "semantic-child" where field = "elts";
let counts = group-count(from=elements, keys=["parent"], count="count", distinct="child");
let single = select parent from counts where count = 1;
let starred = select id from "semantic-syntax" where kind = "starred";
let unpacked = select l.parent as parent from elements as l join starred as r on l.child = r.id;
let eligible = antijoin(left=single, right=unpacked, left-on=["parent"], right-on=["parent"]);
let selected = select l.id as id, l.file as file, l.span as span from tuples as l join eligible as r on l.id = r.parent;
let reportable = select r.id as id, r.file as file, r.span as span from handled as l join selected as r on l.child = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B013)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "B013"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
