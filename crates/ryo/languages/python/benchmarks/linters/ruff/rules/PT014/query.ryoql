import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let parametrize_names = select id from "qualified-name" where path = "pytest.mark.parametrize";
let parametrize_calls = select l.call as call from call_functions as l join parametrize_names as r on l.function = r.id;
let call_arguments_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, r.id as arguments from "semantic-child" as l join call_arguments_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, r.ordinal as ordinal from argument_owners as l join positional_fields as r on l.arguments = r.parent;
let later_positionals = select l.call as call, l.argument as argument from positional_arguments as l join positional_arguments as r on l.call = r.call where l.ordinal > r.ordinal;
let first_positionals = antijoin(left=positional_arguments, right=later_positionals, left-on=["argument"], right-on=["argument"]);
let after_first = select l.call as call, l.argument as argument, l.ordinal as ordinal from positional_arguments as l join first_positionals as r on l.call = r.call where l.ordinal > r.ordinal;
let later_after_first = select l.call as call, l.argument as argument from after_first as l join after_first as r on l.call = r.call where l.ordinal > r.ordinal;
let second_positionals = antijoin(left=after_first, right=later_after_first, left-on=["argument"], right-on=["argument"]);
let positional_argvalues = select call, argument as value from second_positionals;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_occurrences = select l.call as call, r.child as keyword from argument_owners as l join keyword_fields as r on l.arguments = r.parent;
let keyword_name_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_name_wrappers = select l.call as call, l.keyword as keyword, r.child as wrapper from keyword_occurrences as l join keyword_name_fields as r on l.keyword = r.parent;
let keyword_name_tokens = select l.call as call, l.keyword as keyword, r.child as token from keyword_name_wrappers as l join "semantic-child" as r on l.wrapper = r.parent;
let identifier_tokens = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let token_names = select l.call as call, l.keyword as keyword, r.text as name from keyword_name_tokens as l join identifier_tokens as r on l.token = r.id;
let keyword_argvalues = select call, keyword from token_names where name = "argvalues";
let value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_values = select l.call as call, r.child as value from keyword_argvalues as l join value_fields as r on l.keyword = r.parent;
let values_calls = union(left=positional_argvalues, right=keyword_values);
let parametrize_values = select l.call as call, l.value as value from values_calls as l join parametrize_calls as r on l.call = r.call;
let value_nodes = select id, file from "semantic-syntax" where kind = "list" or kind = "tuple";
let list_values = select l.call as call, l.value as value, r.file as file from parametrize_values as l join value_nodes as r on l.value = r.id;
let element_fields = select parent, child, ordinal from "semantic-child" where field = "elts";
let elements = select l.call as call, l.value as value, l.file as file, r.child as element, r.ordinal as ordinal from list_values as l join element_fields as r on l.value = r.parent;
let shapes = select id, shape, file from "expression-shape";
let shaped_elements = select l.call as call, l.value as value, l.element as element, l.ordinal as ordinal, r.shape as shape, l.file as file from elements as l join shapes as r on l.element = r.id;
let comparable_pairs = select l.call as call, l.element as earlier, r.element as later from shaped_elements as l join shaped_elements as r on l.call = r.call and l.value = r.value and l.file = r.file and l.shape = r.shape where l.ordinal < r.ordinal;
let duplicate_ranks = group-count(from=comparable_pairs, keys=["later"], count="prior_count", distinct="earlier");
let duplicate_elements = select later as id from duplicate_ranks;
let candidate_rows = select l.id as id, r.file as file, r.span as span from duplicate_elements as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidate_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PT014(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PT014)(?:,|$)");
emit violations subject file key(id);
