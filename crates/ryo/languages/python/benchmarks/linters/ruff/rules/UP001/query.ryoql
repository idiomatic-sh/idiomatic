import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let assignments = select id, file, span from "semantic-syntax" where kind = "assign";
let targets = select parent, child from "semantic-child" where field = "targets";
let counts = group-count(from=targets, keys=["parent"], count="count", distinct="child");
let single = select parent from counts where count = 1;
let assignment_targets = select l.id as assignment, r.child as target from assignments as l join targets as r on l.id = r.parent;
let single_targets = select l.assignment as assignment, l.target as target from assignment_targets as l join single as r on l.assignment = r.parent;
let id_fields = select parent, child from "semantic-child" where field = "id";
let identifiers = select id, text from semantic_identifiers;
let names = select l.parent as id, r.text as name from id_fields as l join identifiers as r on l.child = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let metaclass_targets = select l.assignment as assignment from single_targets as l join names as r on l.target = r.id where r.name = "__metaclass__";
let named_values = select l.parent as assignment from values as l join names as r on l.child = r.id where r.name = "type";
let invalid = select l.assignment as id from metaclass_targets as l join named_values as r on l.assignment = r.assignment;
let reportable = select l.id as id, l.file as file, l.span as span from assignments as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP001(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP001)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP001(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP001)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP001"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
