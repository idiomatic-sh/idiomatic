import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import annotation_origins from "python/ruff/annotation-origins";
import immutable_annotation from "python/ruff/immutable-annotation";
import dataclass_decorators from "python/ruff/dataclass-decorators";
import suppress from "python/ruff/suppress";

let nodes = select id, kind, file from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let body = select parent, child, file from "semantic-child" where field = "body";
let statements = select l.id as class, r.child as statement, l.file as file from classes as l join body as r on l.id = r.parent and l.file = r.file;
let assignments = select l.class as class, l.statement as statement, l.file as file from statements as l join nodes as r on l.statement = r.id and l.file = r.file where r.kind = "assign" or r.kind = "ann-assign";
let annotated = select l.class as class, l.statement as statement, l.file as file from assignments as l join nodes as r on l.statement = r.id and l.file = r.file where r.kind = "ann-assign";
let values = select parent, child, file from "semantic-child" where field = "value";
let assignment_values = select l.class as class, l.statement as statement, r.child as value, l.file as file from assignments as l join values as r on l.statement = r.parent and l.file = r.file;
let annotations = select parent, child, file from "semantic-child" where field = "annotation";
let annotated_values = select l.class as class, l.statement as statement, l.value as value, r.child as annotation, l.file as file from assignment_values as l join annotations as r on l.statement = r.parent and l.file = r.file;
let annotation_roots = select annotation as id, file from annotated_values;
let immutable = immutable_annotation(expressions=annotation_roots);
let immutable_statements = select l.statement as statement, l.file as file from annotated_values as l join immutable as r on l.annotation = r.id and l.file = r.file;
let origins = annotation_origins(expressions=annotation_roots);
let direct_annotation_origins = select l.statement as statement, r.path as path, l.file as file from annotated_values as l join origins as r on l.annotation = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let annotation_subscripts = select l.statement as statement, l.annotation as annotation, l.file as file from annotated_values as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let subscript_bases = select l.statement as statement, r.child as base, l.file as file from annotation_subscripts as l join values as r on l.annotation = r.parent and l.file = r.file;
let subscript_annotation_origins = select l.statement as statement, r.path as path, l.file as file from subscript_bases as l join origins as r on l.base = r.id and l.file = r.file;
let annotation_paths = union(left=direct_annotation_origins, right=subscript_annotation_origins);
let classvars = select statement, file from annotation_paths where path = "typing.ClassVar" or path = "typing_extensions.ClassVar";
let finals = select statement, file from annotation_paths where path = "typing.Final" or path = "typing_extensions.Final";
let classvar_or_final = union(left=classvars, right=finals);
let dataclasses = dataclass_decorators();
let dataclass_statements = select l.statement as statement, l.file as file from annotated as l join dataclasses as r on l.class = r.class and l.file = r.file;
let annotated_exclusions_0 = union(left=immutable_statements, right=classvar_or_final);
let annotated_exclusions = union(left=annotated_exclusions_0, right=dataclass_statements);

let targets = select parent, child, file from "semantic-child" where field = "target" or field = "targets";
let assignment_targets = select l.class as class, l.statement as statement, r.child as target, l.file as file from assignments as l join targets as r on l.statement = r.parent and l.file = r.file;
let named_targets = select l.class as class, l.statement as statement, l.target as target, r.name as name, l.file as file from assignment_targets as l join "identifier" as r on l.target = r.id and l.file = r.file;
let special_targets = select target, file from named_targets where name = "__slots__" or name = "__dict__" or name = "__weakref__" or name = "__annotations__";
let prior_classvars = select l.class as class, l.statement as statement, l.name as name, l.file as file from named_targets as l join classvars as r on l.statement = r.statement and l.file = r.file;
let statement_locations = select l.statement as statement, l.file as file, r."start-byte" as start from assignments as l join "source-location" as r on l.statement = r.id and l.file = r.file;
let prior_classvar_locations = select l.class as class, l.name as name, l.file as file, r.start as start from prior_classvars as l join statement_locations as r on l.statement = r.statement and l.file = r.file;
let reassigned_classvars_0 = select l.statement as statement, l.target as target, l.file as file, r.start as prior_start from named_targets as l join prior_classvar_locations as r on l.class = r.class and l.name = r.name and l.file = r.file;
let reassigned_classvars = select l.target as target, l.file as file from reassigned_classvars_0 as l join statement_locations as r on l.statement = r.statement and l.file = r.file where l.prior_start < r.start;
let excluded_targets = union(left=special_targets, right=reassigned_classvars);
let active_targets = antijoin(left=assignment_targets, right=excluded_targets, left-on=["target", "file"], right-on=["target", "file"]);
let active_statements = select statement, file from active_targets;

let inherits = select declaration as class, occurrence as base, file from "inherits";
let base_origins = select l.class as class, r.path as path, l.file as file from inherits as l join "qualified-name" as r on l.base = r.id and l.file = r.file;
let copy_classes = select class, file from base_origins where path = "pydantic.BaseModel" or path = "pydantic.v1.BaseModel" or path = "pydantic.BaseSettings" or path = "pydantic_settings.BaseSettings" or path = "pydantic.BaseConfig" or path = "pydantic.v1.generics.GenericModel" or path = "msgspec.Struct" or path = "sqlmodel.SQLModel";
let class_definitions = select id as class, name, owner, file from "defines" where kind = "class";
let base_names = select l.class as child, r.name as name, l.file as file from inherits as l join "identifier" as r on l.base = r.id and l.file = r.file;
let derived_names = select l.child as child, l.name as name, r.owner as owner, l.file as file from base_names as l join class_definitions as r on l.child = r.class and l.file = r.file;
let local_bases = select l.child as child, r.class as parent, l.file as file from derived_names as l join class_definitions as r on l.name = r.name and l.owner = r.owner and l.file = r.file;
let local_ancestry = closure(edges=local_bases, source="child", destination="parent", keys=["file"]);
let inherited_copy_classes = select l.child as class, l.file as file from local_ancestry as l join copy_classes as r on l.parent = r.class and l.file = r.file;
let all_copy_classes = union(left=copy_classes, right=inherited_copy_classes);
let copy_statements = select l.statement as statement, l.file as file from assignments as l join all_copy_classes as r on l.class = r.class and l.file = r.file;
let ctypes_classes = select class, file from base_origins where path = "ctypes.Structure" or path = "ctypes.LittleEndianStructure" or path = "ctypes.BigEndianStructure" or path = "ctypes.Union" or path = "ctypes.LittleEndianUnion" or path = "ctypes.BigEndianUnion";
let ctypes_fields = select l.statement as statement, l.file as file from named_targets as l join ctypes_classes as r on l.class = r.class and l.file = r.file where l.name = "_fields_";
let all_exclusions_1 = union(left=annotated_exclusions, right=copy_statements);
let all_exclusions = union(left=all_exclusions_1, right=ctypes_fields);

let mutable_literals = select id, file from nodes where kind = "list" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "dict-comp" or kind = "set-comp";
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let callees = select l.id as call, r.child as callee, l.file as file from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let function_origins = select l.call as id, l.file as file, r.path as path from callees as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let mutable_calls = select id, file from function_origins where path = "builtins.list" or path = "builtins.dict" or path = "builtins.set" or path = "collections.Counter" or path = "collections.OrderedDict" or path = "collections.defaultdict" or path = "collections.deque";
let mutables = union(left=mutable_literals, right=mutable_calls);
let mutable_assignments = select l.statement as statement, l.value as id, l.file as file from assignment_values as l join mutables as r on l.value = r.id and l.file = r.file;
let eligible_0 = antijoin(left=mutable_assignments, right=all_exclusions, left-on=["statement", "file"], right-on=["statement", "file"]);
let eligible = select l.statement as statement, l.id as id, l.file as file from eligible_0 as l join active_statements as r on l.statement = r.statement and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from eligible as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF012(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF012)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF012)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF012)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF012"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
