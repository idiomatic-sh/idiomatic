import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let assignments = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let targets = select parent, child, file from "semantic-child" where field = "targets" or field = "target";
let values = select parent, child, file from "semantic-child" where field = "value";
let target_names = select l.id as assignment, r.child as name, l.file as file from assignments as l join targets as r on l.id = r.parent and l.file = r.file;
let value_names = select l.id as assignment, r.child as name, l.file as file from assignments as l join values as r on l.id = r.parent and l.file = r.file;
let nodes = select id, kind, file, span from "semantic-syntax";
let target_expressions = select l.assignment as assignment, r.id as name, l.file as file, r.span as span from target_names as l join nodes as r on l.name = r.id and l.file = r.file where r.kind = "name";
let value_expressions = select l.assignment as assignment, r.id as name, l.file as file from value_names as l join nodes as r on l.name = r.id and l.file = r.file where r.kind = "name";
let identifiers = select id, name, file from "identifier";
let named_targets = select l.assignment as assignment, l.name as id, l.file as file, l.span as span, r.name as name from target_expressions as l join identifiers as r on l.name = r.id and l.file = r.file;
let named_values = select l.assignment as assignment, r.name as name, l.file as file from value_expressions as l join identifiers as r on l.name = r.id and l.file = r.file;
let self_assignments = select l.id as id, l.file as file, l.span as span from named_targets as l join named_values as r on l.assignment = r.assignment and l.name = r.name and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let target_tuples = select l.assignment as assignment, l.name as tuple, l.file as file from target_names as l join tuples as r on l.name = r.id and l.file = r.file;
let value_tuples = select l.assignment as assignment, l.name as tuple, l.file as file from value_names as l join tuples as r on l.name = r.id and l.file = r.file;
let tuple_assignments = select l.assignment as assignment, l.tuple as target, r.tuple as value, l.file as file from target_tuples as l join value_tuples as r on l.assignment = r.assignment and l.file = r.file;
let tuple_elements = select parent, child, ordinal, file from "semantic-child" where field = "elts";
let tuple_target_elements = select l.assignment as assignment, l.value as tuple, r.child as child, r.ordinal as ordinal, l.file as file from tuple_assignments as l join tuple_elements as r on l.target = r.parent and l.file = r.file;
let tuple_value_elements = select l.assignment as assignment, l.target as tuple, r.child as child, r.ordinal as ordinal, l.file as file from tuple_assignments as l join tuple_elements as r on l.value = r.parent and l.file = r.file;
let tuple_element_pairs = select l.assignment as assignment, l.child as target, r.child as value, l.ordinal as ordinal, l.file as file from tuple_target_elements as l join tuple_value_elements as r on l.assignment = r.assignment and l.ordinal = r.ordinal and l.file = r.file;
let tuple_name_pairs = select l.assignment as assignment, l.target as target, l.ordinal as ordinal, l.file as file, r.span as span from tuple_element_pairs as l join nodes as r on l.target = r.id and l.file = r.file where r.kind = "name";
let tuple_value_names = select l.assignment as assignment, l.value as value, l.ordinal as ordinal, l.file as file from tuple_element_pairs as l join nodes as r on l.value = r.id and l.file = r.file where r.kind = "name";
let tuple_target_names = select l.assignment as assignment, l.target as id, l.ordinal as ordinal, l.file as file, l.span as span, r.name as name from tuple_name_pairs as l join identifiers as r on l.target = r.id and l.file = r.file;
let tuple_rhs_names = select l.assignment as assignment, l.ordinal as ordinal, r.name as name, l.file as file from tuple_value_names as l join identifiers as r on l.value = r.id and l.file = r.file;
let tuple_self_assignments = select l.id as id, l.file as file, l.span as span from tuple_target_names as l join tuple_rhs_names as r on l.assignment = r.assignment and l.ordinal = r.ordinal and l.name = r.name and l.file = r.file;
let direct_and_tuple_assignments = union(left=self_assignments, right=tuple_self_assignments);
let target_name_rows = select l.assignment as assignment, l.name as id, l.file as file, l.span as span, r.name as name from target_expressions as l join identifiers as r on l.name = r.id and l.file = r.file;
let target_location_rows = select l.assignment as assignment, l.id as id, l.file as file, l.span as span, l.name as name, r."start-byte" as start_byte from target_name_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let earlier_same_target_names = select l.assignment as assignment, l.id as later, r.id as earlier from target_location_rows as l join target_location_rows as r on l.assignment = r.assignment and l.name = r.name and l.file = r.file where r.start_byte < l.start_byte;
let later_duplicate_targets = select later as id from earlier_same_target_names;
let first_same_target_rows = antijoin(left=target_location_rows, right=later_duplicate_targets, left-on=["id"], right-on=["id"]);
let target_names_with_later_duplicate = select l.id as id from target_location_rows as l join target_location_rows as r on l.assignment = r.assignment and l.name = r.name and l.file = r.file where l.start_byte < r.start_byte;
let first_repeated_target_names = select l.id as id, l.file as file, l.span as span from first_same_target_rows as l join target_names_with_later_duplicate as r on l.id = r.id;
let repeated_target_assignments = select id, file, span from first_repeated_target_names;
let direct_tuple_and_chain_assignments = union(left=direct_and_tuple_assignments, right=repeated_target_assignments);
let target_bindings = select occurrence as id, scope, file from "binding-event" where kind = "bind";
let self_binding_scopes = select l.id as id, l.file as file, r.scope as scope, l.span as span from direct_tuple_and_chain_assignments as l join target_bindings as r on l.id = r.id and l.file = r.file;
let scope_nodes = select id, kind, file from nodes;
let outside_class = select l.id as id, l.file as file, l.span as span from self_binding_scopes as l join scope_nodes as r on l.scope = r.id and l.file = r.file where r.kind != "class-def";
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from outside_class as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PLW0127(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0127)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PLW0127(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0127)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0127"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
