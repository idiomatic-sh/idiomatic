import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let calls = call_syntax();
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let logger_functions = select id from "qualified-name" where path = "logging.error" or path = "logging.Logger.error";
let imported_logger_bindings = select occurrence as binding, file from "static-import" where target = "logging.error";
let imported_logger_functions = select l.reference as id from "binding-use" as l join imported_logger_bindings as r on l.binding = r.binding and l.file = r.file;
let direct_logger_functions = union(left=logger_functions,right=imported_logger_functions);
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let assignment_targets = select parent, child from "semantic-child" where field = "targets";
let assignment_values = select parent, child from "semantic-child" where field = "value";
let target_assignments = select l.id as assignment, r.child as target from assignment_nodes as l join assignment_targets as r on l.id = r.parent;
let value_assignments = select l.id as assignment, r.child as value from assignment_nodes as l join assignment_values as r on l.id = r.parent;
let binding_occurrences = select occurrence, file from "binding-event" where kind = "bind";
let bound_targets = select l.assignment as assignment, l.target as target, r.file as file from target_assignments as l join binding_occurrences as r on l.target = r.occurrence;
let assigned_logger_values = select l.target as target, l.file as file, r.value as value from bound_targets as l join value_assignments as r on l.assignment = r.assignment;
let value_calls = select l.target as target, l.file as file, l.value as value, r.child as function from assigned_logger_values as l join function_fields as r on l.value = r.parent;
let logger_getters = select id from "qualified-name" where path = "logging.getLogger";
let logger_initializers = select l.target as target, l.file as file from value_calls as l join logger_getters as r on l.function = r.id;
let attribute_nodes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_bases = select parent, child from "semantic-child" where field = "value";
let candidate_attributes = select l.parent as attribute, l.child as base, r.file as file from attribute_bases as l join attribute_nodes as r on l.parent = r.id;
let attribute_names = select parent, child from "semantic-child" where field = "attr";
let error_attributes = select l.parent as attribute, l.child as name, r.file as file from attribute_names as l join attribute_nodes as r on l.parent = r.id;
let semantic_identifiers = select id, name from "identifier";
let error_named_attributes = select l.attribute as attribute, l.file as file from error_attributes as l join semantic_identifiers as r on l.name = r.id where r.name = "error";
let attribute_base_names = select l.attribute as attribute, l.base as base, l.file as file from candidate_attributes as l join "semantic-syntax" as r on l.base = r.id where r.kind = "name";
let base_binding_uses = select l.attribute as attribute, r.binding as binding, l.file as file from attribute_base_names as l join "binding-use" as r on l.base = r.reference;
let logger_instance_attributes = select l.attribute as attribute from base_binding_uses as l join logger_initializers as r on l.binding = r.target and l.file = r.file;
let inferred_logger_functions = select l.attribute as id from logger_instance_attributes as l join error_named_attributes as r on l.attribute = r.attribute;
let all_logger_functions = union(left=direct_logger_functions, right=inferred_logger_functions);
let logger_calls = select l.call as call, l.function as function from call_functions as l join all_logger_functions as r on l.function = r.id;
let argument_edges = select parent, child from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as wrapper from argument_edges as l join argument_nodes as r on l.child = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keyword_edges = select l.call as call, r.child as keyword from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let call_keywords = select l.call as call, l.keyword as keyword from call_keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let argument_names = select parent as keyword, child as identifier from "semantic-child" where field = "arg";
let identifiers = select id, name from "identifier";
let keyword_arg_names = select l.keyword as keyword, r.name as name from argument_names as l join identifiers as r on l.identifier = r.id;
let exc_info_names = select keyword from keyword_arg_names where name = "exc_info";
let exc_info_keyword_calls = select l.call as call, l.keyword as keyword from call_keywords as l join exc_info_names as r on l.keyword = r.keyword;
let keyword_values = select parent as keyword, child as value from "semantic-child" where field = "value";
let exc_info_values = select l.call as call, l.keyword as keyword, r.value as value from exc_info_keyword_calls as l join keyword_values as r on l.keyword = r.keyword;
let true_literals = select id, file from "literal-properties" where boolean = "true";
let true_exc_info = select l.call as call, l.keyword as keyword from exc_info_values as l join true_literals as r on l.value = r.id;
let sys_exc_info_functions = select id from "qualified-name" where path = "sys.exc_info";
let sys_exc_info_calls = select l.parent as call from function_fields as l join sys_exc_info_functions as r on l.child = r.id;
let sys_exc_info_keywords = select l.call as call, l.keyword as keyword from exc_info_values as l join sys_exc_info_calls as r on l.value = r.call;
let valid_exc_info = union(left=true_exc_info, right=sys_exc_info_keywords);
let eligible_calls = select l.call as id, l.function as function, r.keyword as keyword from logger_calls as l join valid_exc_info as r on l.call = r.call;
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let handler_ancestors = axis(from=eligible_calls, relation="semantic-child", direction=ancestor, domain=handlers);
let call_handler_pairs = select l.id as call, l.function as function, l.keyword as keyword, r.related as handler from eligible_calls as l join handler_ancestors as r on l.id = r.id;
let reset_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let handler_reset_roots = axis(from=handlers, relation="semantic-child", direction=descendant, domain=reset_nodes);
let handler_resets = select l.id as handler, r.related as reset from handlers as l join handler_reset_roots as r on l.id = r.id;
let call_reset_ancestors = axis(from=eligible_calls, relation="semantic-child", direction=ancestor, domain=reset_nodes);
let call_resets = select l.id as call, r.related as reset from eligible_calls as l join call_reset_ancestors as r on l.id = r.id;
let handler_reset_calls = select l.call as call, r.reset as reset from call_handler_pairs as l join handler_resets as r on l.handler = r.handler;
let nested_reset_pairs = select l.call as call from handler_reset_calls as l join call_resets as r on l.call = r.call and l.reset = r.reset;
let handler_call_ids = select call as id, function, keyword from call_handler_pairs;
let reset_call_ids = select call as id from nested_reset_pairs;
let inside_handler_calls = antijoin(left=handler_call_ids, right=reset_call_ids, left-on=["id"], right-on=["id"]);
let reportable_calls = select id, function, keyword, r.file as file from inside_handler_calls as l join calls as r on l.id = r.id;
let reportable_functions = select l.function as function, l.file as file from reportable_calls as l;
let function_attribute_tokens = select parent, child from "semantic-child" where field = "attr";
let reportable_attribute_tokens = select l.file as file, r.child as id from reportable_functions as l join function_attribute_tokens as r on l.function = r.parent;
let reportable_attributes = select l.id as id, l.file as file, r.span as span from reportable_attribute_tokens as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let function_name_nodes = select l.function as id, l.file as file from reportable_functions as l join "semantic-syntax" as r on l.function = r.id and l.file = r.file where r.kind = "name";
let reportable_names = select l.id as id, l.file as file, r.span as span from function_name_nodes as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let reportable = union(left=reportable_attributes, right=reportable_names);
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:G201)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "G201"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
