import observation_matches from "python/ruff/suppress-matches";
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare";
let constant_nodes = select id, file from "semantic-syntax" where kind = "constant";
let literal_properties = select id, file, kind from "literal-properties";
let nonsingleton_literals = select l.id as id, l.file as file from constant_nodes as l join literal_properties as r on l.id = r.id and l.file = r.file where r.kind != "null" and r.kind != "boolean" and r.kind != "ellipsis";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_elements = select parent, child from "semantic-child" where field = "elts";
let tuple_edges = select l.parent as origin, l.child as destination from tuple_elements as l join tuples as r on l.parent = r.id;
let tuple_descendants = closure(edges=tuple_edges, source="origin", destination="destination");
let constant_or_tuple_ids = union(left=constant_nodes, right=tuples);
let bad_tuple_descendants = antijoin(left=tuple_descendants, right=constant_or_tuple_ids, left-on=["destination"], right-on=["id"]);
let bad_tuples = select origin as id from bad_tuple_descendants;
let good_tuples = antijoin(left=tuples, right=bad_tuples, left-on=["id"], right-on=["id"]);
let constant_exprs = union(left=nonsingleton_literals, right=good_tuples);
let mutable_literals = select id, file from "semantic-syntax" where kind = "list" or kind = "set" or kind = "dict" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp";
let bad_operands = union(left=constant_exprs, right=mutable_literals);
let left_fields = select parent, child from "semantic-child" where field = "left";
let comparator_fields = select parent, child from "semantic-child" where field = "comparators";
let left_operand_ids = select parent as comparison, child as operand from left_fields;
let comparator_operand_ids = select parent as comparison, child as operand from comparator_fields;
let all_operand_ids = union(left=left_operand_ids, right=comparator_operand_ids);
let operand_nodes = select l.comparison as comparison, l.operand as operand, r.file as file from all_operand_ids as l join "semantic-syntax" as r on l.operand = r.id;
let operands = select l.comparison as comparison, l.operand as operand, l.file as file, r."start-byte" as begin, r."end-byte" as finish from operand_nodes as l join "source-location" as r on l.operand = r.id and l.file = r.file;
let operator_fields = select parent, child from "semantic-child" where field = "ops";
let identity_ops = select id, file from "semantic-syntax" where text = "is" or kind = "is" or kind = "is-not";
let identity_comparisons = select l.parent as comparison, l.child as operator, r.file as file from operator_fields as l join identity_ops as r on l.child = r.id;
let identity_positions = select l.comparison as comparison, l.operator as operator, l.file as file, r."start-byte" as begin, r."end-byte" as finish from identity_comparisons as l join "source-location" as r on l.operator = r.id and l.file = r.file;
let possible_left = select l.comparison as comparison, l.operator as operator, r.operand as operand, r.finish as finish, r.file as file from identity_positions as l join operands as r on l.comparison = r.comparison and l.file = r.file where r.finish <= l.begin;
let nonnearest_left = select l.comparison as comparison, l.operator as operator, l.operand as operand from possible_left as l join possible_left as r on l.comparison = r.comparison and l.operator = r.operator where l.finish < r.finish;
let nearest_left = antijoin(left=possible_left, right=nonnearest_left, left-on=["comparison", "operator", "operand"], right-on=["comparison", "operator", "operand"]);
let possible_right = select l.comparison as comparison, l.operator as operator, r.operand as operand, r.begin as begin, r.file as file from identity_positions as l join operands as r on l.comparison = r.comparison and l.file = r.file where r.begin >= l.finish;
let nonnearest_right = select l.comparison as comparison, l.operator as operator, l.operand as operand from possible_right as l join possible_right as r on l.comparison = r.comparison and l.operator = r.operator where l.begin > r.begin;
let nearest_right = antijoin(left=possible_right, right=nonnearest_right, left-on=["comparison", "operator", "operand"], right-on=["comparison", "operator", "operand"]);
let bad_left = select l.comparison as comparison, l.operator as operator from nearest_left as l join bad_operands as r on l.operand = r.id and l.file = r.file;
let bad_right = select l.comparison as comparison, l.operator as operator from nearest_right as l join bad_operands as r on l.operand = r.id and l.file = r.file;
let bad_right_only = antijoin(left=bad_right, right=bad_left, left-on=["comparison", "operator"], right-on=["comparison", "operator"]);
let bad_identity_ops = union(left=bad_left, right=bad_right_only);
let reportable = select r.operator as id, l.id as comparison, l.file as file, l.span as span from comparisons as l join bad_identity_ops as r on l.id = r.comparison;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.comparison = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F632)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F632"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
