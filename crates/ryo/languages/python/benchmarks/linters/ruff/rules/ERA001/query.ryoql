import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
let module_roots = select id, file, span from "semantic-syntax" where kind = "module";
let modules = extend(from=module_roots, values={base_line: 1});
let own_lines = source-matches(from=modules, span="span", base-line="base_line", pattern="(?m)^[ \t]*(?P<comment>#[^\r\n]*)", output="whole", line-output="whole_line", capture="comment", capture-output="comment_span", capture-text-output="text", capture-line-output="line");
let comments = select id, file, span from "comment";
let own_comments = select r.id as id, l.file as file, l.comment_span as span, l.text as text, l.line as line from own_lines as l join comments as r on l.file = r.file and l.comment_span = r.span;
let tasks = select id, file from own_comments where matches(text, "^#\s*(?:TODO|FIXME|XXX)\b");
let imports = select id, file, span, line from own_comments where matches(text, "^#\s*(?:import\s+[\p{XID_Start}_][\p{XID_Continue}_.]*(?:\s|,|#|$)|from\s+[.\p{XID_Continue}_]+\s+import\s+)");
let assignments = select id, file, span, line from own_comments where matches(text, "^#\s*[\p{XID_Start}_][\p{XID_Continue}_.]*(?:\s*\[[^\]]+\])?\s*(?::[^=]+)?(?:\+|-|\*|/|//|%|\*\*|&|\||\^|<<|>>)?=\s*[^=]");
let statements = select id, file, span, line from own_comments where matches(text, "^#\s*(?:(?:return|yield|raise|assert|del|global|nonlocal)\s+\S|(?:if|elif|while|for|with|def|class|async\s+(?:def|for|with))\s+.+:\s*(?:#.*)?$|(?:else|try|finally):\s*(?:#.*)?$|(?:pass|break|continue)\s*(?:#.*)?$)");
let calls = select id, file, span, line from own_comments where matches(text, "^#\s*[\p{XID_Start}_][\p{XID_Continue}_.]*\s*\([^#]*\)\s*(?:#.*)?$");
let entries = select id, file, span, line from own_comments where matches(text, "^#\s*(?:\x22[^\x22]*\x22|'[^']*')\s*:\s*\S");
let delimiters = select id, file, span, line from own_comments where matches(text, "^#\s*[()\[\]{}]+\s*(?:#.*)?$");
let a = union(left=imports, right=assignments);
let b = union(left=statements, right=calls);
let c = union(left=entries, right=delimiters);
let ab = union(left=a, right=b);
let recognized = union(left=ab, right=c);
let candidates = antijoin(left=recognized, right=tasks, left-on=[id, file], right-on=[id, file]);
let mappings = noqa_line_map();
let locations = noqa_locations(candidates=candidates, mappings=mappings);
let additional = select id, file, line from candidates where id != id;
let matches = suppression_edges(candidates=candidates, locations=locations, additional_locations=additional, codes="^(?:ERA001)$");
let violations = antijoin(left=locations, right=matches, left-on=[id, span], right-on=[id, span]);
let matched = select directive, file from matches where scope < 2;
let noqa_matches = extend(from=matched, values={code: "ERA001"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
