import observation_matches from "python/ruff/suppress-matches";
let import_statements = select id, file, span from "semantic-syntax" where kind = "import-from";
let module_fields = select parent, child from "semantic-child" where field = "module";
let future_modules = select id from "identifier" where name = "__future__";
let future_statements = select l.parent as id, l.child as module, r.file as file, r.span as span from module_fields as l join import_statements as r on l.parent = r.id;
let exact_future_statements = select l.id as id, l.file as file, l.span as span from future_statements as l join future_modules as r on l.module = r.id;
let aliases = select parent as statement, child as alias, ordinal from "semantic-child" where field = "names";
let future_aliases = select l.statement as statement, l.alias as alias, r.file as file from aliases as l join exact_future_statements as r on l.statement = r.id;
let names = select parent as alias, child from "semantic-child" where field = "name";
let identifiers = select id, name from "identifier";
let alias_name_nodes = select l.alias as alias, l.statement as statement, l.file as file, n.child as name_id from future_aliases as l join names as n on l.alias = n.alias;
let alias_names = select l.alias as alias, l.statement as statement, l.file as file, r.name as name from alias_name_nodes as l join identifiers as r on l.name_id = r.id;
let obsolete = select * from alias_names where name = "absolute_import" or name = "division" or name = "generators" or name = "generator_stop" or name = "nested_scopes" or name = "print_function" or name = "unicode_literals" or name = "with_statement";
let aliases_with_asname = select parent as alias from "semantic-child" where field = "asname";
let unaliased = antijoin(left=obsolete,right=aliases_with_asname,left-on=["alias"],right-on=["alias"]);
let imported_aliases = select occurrence as alias from "static-import";
let bound_obsolete = select l.statement as statement, l.alias as alias, l.file as file, r.alias as binding from unaliased as l join imported_aliases as r on l.alias = r.alias;
let uses = select binding from "binding-use";
let unused = antijoin(left=bound_obsolete,right=uses,left-on=["binding"],right-on=["binding"]);
let statement_counts = group-count(from=unused, keys=["statement"], count="count", distinct="alias");
let used_statements = select l.id as id, l.file as file, l.span as span from exact_future_statements as l join statement_counts as r on l.id = r.statement;
let reportable = select id, file, span from used_statements;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:U010|UP010)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP010"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
