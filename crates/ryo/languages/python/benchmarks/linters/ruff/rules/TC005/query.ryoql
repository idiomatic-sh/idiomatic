import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import modernization_symbols from "python/ruff/modernization-symbols";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as owner, r.child as id, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let expressions = select id, file from tests;
let known = modernization_symbols(expressions=expressions);
let imported_guards = select id, file from known where kind = "type-checking";
let checking_labels = select id, file from "identifier" where name = "TYPE_CHECKING";
let names = select id, file from nodes where kind = "name";
let spelled_names = select l.id as id, l.file as file from names as l join checking_labels as r on l.id = r.id and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let attribute_labels = select l.id as id, r.child as label, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let spelled_attributes = select l.id as id, l.file as file from attribute_labels as l join checking_labels as r on l.label = r.id and l.file = r.file;
let spellings = union(left=spelled_names, right=spelled_attributes);
let guard_expressions = union(left=imported_guards, right=spellings);
let guarded = select l.owner as id, l.file as file from tests as l join guard_expressions as r on l.id = r.id and l.file = r.file;
let clauses = select parent as id, file from "semantic-child" where field = "orelse";
let without_else = antijoin(left=guarded, right=clauses, left-on=["id", "file"], right-on=["id", "file"]);
let bodies = select l.id as owner, r.child as statement, l.file as file from without_else as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let counts = group-count(from=bodies, keys=["owner", "file"], count="count", distinct="statement");
let single = select l.statement as id, l.file as file from bodies as l join counts as r on l.owner = r.owner and l.file = r.file where r.count = 1;
let passes = select id, file from nodes where kind = "pass";
let reportable = select l.id as id, l.file as file from single as l join passes as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="TC005($|[, #])", range-pattern="(?:^|,)TC005(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="TC005($|[, #])", range-pattern="(?:^|,)TC005(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TC005"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
