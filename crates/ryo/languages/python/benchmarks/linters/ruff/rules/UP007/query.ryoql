import observation_matches from "python/ruff/suppress-matches";
import pep604 from "python/ruff/pep604-candidates";
let inputs = select id, file from "semantic-syntax" where kind = "subscript";
let selected = pep604(source_nodes=inputs);
let candidates0 = select id, file from selected where operator = "union";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:U007|UP007)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP007"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
