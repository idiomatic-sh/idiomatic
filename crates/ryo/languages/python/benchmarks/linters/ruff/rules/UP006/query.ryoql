import observation_matches from "python/ruff/suppress-matches";
let pep585_symbols = select id, file from "qualified-name" where path in ["typing.Dict", "typing.FrozenSet", "typing.List", "typing.Set", "typing.Tuple", "typing.Type", "typing_extensions.Type", "typing.Deque", "typing_extensions.Deque", "typing.DefaultDict", "typing_extensions.DefaultDict"];
let pep585_nodes = select l.id as id, l.file as file, r.span as span from pep585_symbols as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from pep585_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:U006|UP006)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP006"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
