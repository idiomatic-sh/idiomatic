import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let functions = select l.id as call, r.child as function, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let attributes = select id, file from nodes where kind = "attribute";
let attr_calls = select l.call as call, l.function as function, l.file as file from functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_labels = select l.call as call, l.function as function, r.child as label, l.file as file from attr_calls as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "attr";
let join_calls = select l.call as call, l.function as function, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "join";
let receivers = select l.call as call, r.child as receiver, l.file as file from join_calls as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "value";
let literals = select occurrence as id, value, file from "string-literal";
let literal_receivers = select l.call as call, r.value as separator, l.file as file from receivers as l join literals as r on l.receiver = r.id and l.file = r.file;
let wrappers = select id, file from nodes where kind = "call-arguments";
let call_wrappers = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join wrappers as r on l.child = r.id and l.file = r.file;
let arguments = select l.call as call, r.child as argument, l.file as file from call_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let keywords = select l.call as call, l.file as file from call_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let other_args = select l.call as call, l.file as file from arguments as l join arguments as r on l.call = r.call and l.file = r.file where l.argument != r.argument;
let invalid_calls = union(left=keywords, right=other_args);
let single_args = antijoin(left=arguments, right=invalid_calls, left-on=["call", "file"], right-on=["call", "file"]);
let collections = select id, file from nodes where kind = "list" or kind = "tuple";
let collection_args = select l.call as call, l.argument as collection, l.file as file from single_args as l join collections as r on l.argument = r.id and l.file = r.file;
let literal_join_calls = select l.call as call, l.collection as collection, r.separator as separator, l.file as file from collection_args as l join literal_receivers as r on l.call = r.call and l.file = r.file;
let elements = select l.call as call, r.child as element, r.ordinal as ordinal, l.file as file from literal_join_calls as l join "semantic-child" as r on l.collection = r.parent and l.file = r.file where r.field = "elts";
let names = select id, file from nodes where kind = "name";
let simple_roots = union(left=names, right=attributes);
let scalars = select id, file from "literal-properties" where kind = "integer" or kind = "float" or kind = "complex" or kind = "boolean" or kind = "string";
let plain_allowed = union(left=simple_roots, right=scalars);
let joinee_calls = select l.element as id, l.file as file from elements as l join calls as r on l.element = r.id and l.file = r.file;
let joinee_functions = select l.function as id, l.file as file from functions as l join joinee_calls as r on l.call = r.id and l.file = r.file;
let nested_callee_attrs = axis(from=joinee_functions, relation="semantic-child", direction=descendant, domain=attributes);
let nested_attr_ids = select related as id, file from nested_callee_attrs;
let own_attr_ids = select l.id as id, l.file as file from joinee_functions as l join attributes as r on l.id = r.id and l.file = r.file;
let relevant_attrs = union(left=nested_attr_ids, right=own_attr_ids);
let attr_edges = select l.id as source, r.child as destination, l.file as file from relevant_attrs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let attr_paths = closure(edges=attr_edges, source="source", destination="destination", keys=["file"]);
let name_based_attributes = select l.source as id, l.file as file from attr_paths as l join names as r on l.destination = r.id and l.file = r.file;
let simple_callees = union(left=names, right=name_based_attributes);
let callable_names = select l.call as id, l.file as file from functions as l join simple_callees as r on l.function = r.id and l.file = r.file;
let with_args = select call as id, file from arguments;
let with_keywords = select call as id, file from keywords;
let nonempty_calls = union(left=with_args, right=with_keywords);
let simple_calls = antijoin(left=callable_names, right=nonempty_calls, left-on=["id", "file"], right-on=["id", "file"]);
let allowed = union(left=plain_allowed, right=simple_calls);
let invalid_elements = antijoin(left=elements, right=allowed, left-on=["element", "file"], right-on=["id", "file"]);
let element_counts = group-count(from=elements, keys=["call", "file"], count="element_count", distinct="element");
let nonempty = select call, file from element_counts;
let structurally_valid = antijoin(left=nonempty, right=invalid_elements, left-on=["call", "file"], right-on=["call", "file"]);
let string_elements = select l.call as call, l.element as element, r.value as value, l.file as file from elements as l join literals as r on l.element = r.id and l.file = r.file;
let nonstrings = antijoin(left=elements, right=string_elements, left-on=["call", "element", "file"], right-on=["call", "element", "file"]);
let all_strings = antijoin(left=structurally_valid, right=nonstrings, left-on=["call", "file"], right-on=["call", "file"]);
let nonstring_counts = group-count(from=nonstrings, keys=["call", "file"], count="nonstring_count", distinct="element");
let mixed_strings = select l.call as call, l.file as file from structurally_valid as l join nonstring_counts as r on l.call = r.call and l.file = r.file;
let quote_values0 = select call, separator as value, file from literal_join_calls;
let quote_values1 = select call, value, file from string_elements;
let quote_values = union(left=quote_values0, right=quote_values1);
let single_quote_values = select call, file from quote_values where matches(value, "'");
let single_quote_counts = group-count(from=single_quote_values, keys=["call", "file"], count="quote_count");
let single_quotes = select call, file from single_quote_counts;
let double_quote_values = select call, file from quote_values where matches(value, "\x22");
let double_quote_counts = group-count(from=double_quote_values, keys=["call", "file"], count="quote_count");
let double_quotes = select call, file from double_quote_counts;
let both_quotes = select l.call as call, l.file as file from single_quotes as l join double_quotes as r on l.call = r.call and l.file = r.file;
let valid_mixed = antijoin(left=mixed_strings, right=both_quotes, left-on=["call", "file"], right-on=["call", "file"]);
let element_positions = select l.call as call, l.element as element, l.ordinal as ordinal, r."end-byte" as element_end, l.file as file from elements as l join "source-location" as r on l.element = r.id and l.file = r.file;
let first_seeds = select l.call as call, r."start-byte" as first_position, l.file as file from literal_join_calls as l join "source-location" as r on l.call = r.id and l.file = r.file;
let first_elements = ordered-match(left=first_seeds, right=element_positions, left-on=["call", "file"], right-on=["call", "file"], left-order="first_position", right-order="element_end", output={call:[left,call],element:[right,element],ordinal:[right,ordinal],file:[left,file]});
let first_positions = select l.call as call, l.file as file, r."start-byte" as start from first_elements as l join "source-location" as r on l.element = r.id and l.file = r.file;
let raw_tokens = select id, file from "syntax-tree" where matches(text, "(?i)^r['\x22]");
let raw_positions = select l.file as file, r."start-byte" as start from raw_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let raw_first0 = select l.call as call, l.file as file from first_positions as l join raw_positions as r on l.start = r.start and l.file = r.file;
let raw_first = select l.call as call, l.file as file from raw_first0 as l join all_strings as r on l.call = r.call and l.file = r.file;
let sep_used = select call, file from element_counts where element_count > 1;
let used_newlines = select l.call as call, l.file as file from literal_join_calls as l join sep_used as r on l.call = r.call and l.file = r.file where matches(l.separator, "[\r\n]");
let element_newlines = select call, file from string_elements where matches(value, "[\r\n]");
let newline_rows = union(left=used_newlines, right=element_newlines);
let newline_counts = group-count(from=newline_rows, keys=["call", "file"], count="newline_count");
let newline_calls = select call, file from newline_counts;
let raw_newline = select l.call as call, l.file as file from raw_first as l join newline_calls as r on l.call = r.call and l.file = r.file;
let rare_roots = select l.call as call, l.collection as collection, l.file as file from literal_join_calls as l join raw_newline as r on l.call = r.call and l.file = r.file;
let collection_ids = select collection as id, file from rare_roots;
let physical_tokens = select id, file from "syntax-tree" where text != "";
let physical_descendants = axis(from=collection_ids, relation="syntax-child", direction=descendant, domain=physical_tokens);
let collection_tokens = select l.call as call, r.related as slot, l.file as file from rare_roots as l join physical_descendants as r on l.collection = r.id and l.file = r.file;
let order_slots = select l.call as call, l.slot as slot, r."start-byte" as slot_start, r."end-byte" as slot_end, l.file as file from collection_tokens as l join "source-location" as r on l.slot = r.id and l.file = r.file;
let rare_positions0 = select l.call as call, l.element as element, l.ordinal as ordinal, l.file as file from elements as l join raw_newline as r on l.call = r.call and l.file = r.file;
let rare_positions = select l.call as call, l.element as element, l.ordinal as ordinal, r."end-byte" as element_end, l.file as file from rare_positions0 as l join "source-location" as r on l.element = r.id and l.file = r.file;
let dense_positions = ordered-match(left=order_slots, right=rare_positions, left-on=["call", "file"], right-on=["call", "file"], left-order="slot_start", right-order="element_end", output={call:[left,call],slot:[left,slot],slot_start:[left,slot_start],slot_end:[left,slot_end],element:[right,element],file:[left,file]});
let element_edges = select l.call as call, l.element as source, r.element as destination, l.file as file from dense_positions as l join dense_positions as r on l.call = r.call and l.slot_end = r.slot_start and l.file = r.file;
let rare_elements = select l.call as call, l.element as element, l.value as value, l.file as file from string_elements as l join raw_newline as r on l.call = r.call and l.file = r.file;
let rare_separators = select l.call as call, l.separator as separator, l.file as file from literal_join_calls as l join raw_newline as r on l.call = r.call and l.file = r.file;
let rare_edges = select l.call as call, l.source as source, l.destination as destination, l.file as file from element_edges as l join raw_newline as r on l.call = r.call and l.file = r.file;
let left_values = select l.call as call, l.source as source, l.destination as destination, r.value as left_value, l.file as file from rare_edges as l join rare_elements as r on l.source = r.element and l.call = r.call and l.file = r.file;
let right_values = select l.call as call, l.source as source, l.destination as destination, r.value as right_value, l.file as file from rare_edges as l join rare_elements as r on l.destination = r.element and l.call = r.call and l.file = r.file;
let internal0 = select l.call as call, l.destination as element, l.file as file from rare_edges as l join rare_edges as r on l.destination = r.source and l.call = r.call and l.file = r.file;
let internal = select l.call as call, l.element as element, r.value as value, l.file as file from internal0 as l join rare_elements as r on l.element = r.element and l.call = r.call and l.file = r.file;
let nonempty_positions = select l.call as call, l.element as element, l.ordinal as ordinal, l.element_end as element_end, l.file as file from rare_positions as l join rare_elements as r on l.element = r.element and l.call = r.call and l.file = r.file where r.value != "";
let packed_positions = ordered-match(left=order_slots, right=nonempty_positions, left-on=["call", "file"], right-on=["call", "file"], left-order="slot_start", right-order="element_end", output={call:[left,call],slot:[left,slot],slot_start:[left,slot_start],slot_end:[left,slot_end],element:[right,element],file:[left,file]});
let nonempty_edges = select l.call as call, l.element as source, r.element as destination, l.file as file from packed_positions as l join packed_positions as r on l.call = r.call and l.slot_end = r.slot_start and l.file = r.file;
let nonempty_left = select l.call as call, l.source as source, l.destination as destination, r.value as left_value, l.file as file from nonempty_edges as l join rare_elements as r on l.source = r.element and l.call = r.call and l.file = r.file;
let nonempty_pairs = select l.call as call, l.source as source, l.destination as destination, l.left_value as left_value, r.value as right_value, l.file as file from nonempty_left as l join rare_elements as r on l.destination = r.element and l.call = r.call and l.file = r.file;
let empty_sep_pairs = select l.call as call, l.source as source, l.destination as destination, l.left_value as left_value, l.right_value as right_value, l.file as file from nonempty_pairs as l join rare_separators as r on l.call = r.call and l.file = r.file where r.separator = "";
let three_pieces = select l.call as call, l.left_value as first_value, l.right_value as middle_value, r.right_value as last_value, l.file as file from empty_sep_pairs as l join empty_sep_pairs as r on l.destination = r.source and l.call = r.call and l.file = r.file;
let internal_empty = select call, element, file from internal where value = "";
let double_empty0 = select l.call as call, l.destination as destination, l.file as file from rare_edges as l join internal_empty as r on l.source = r.element and l.call = r.call and l.file = r.file;
let double_empty = select l.call as call, l.file as file from double_empty0 as l join internal_empty as r on l.destination = r.element and l.call = r.call and l.file = r.file;
let sq_inside = select call, file from rare_elements where matches(value, "'''");
let sq_separator = select l.call as call, l.file as file from rare_separators as l join sep_used as r on l.call = r.call and l.file = r.file where matches(l.separator, "'''");
let sq_left = select l.call as call, l.file as file from left_values as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(l.left_value, "''$") and matches(r.separator, "^'")) or (matches(l.left_value, "'$") and matches(r.separator, "^''"));
let sq_right = select l.call as call, l.file as file from right_values as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(r.separator, "''$") and matches(l.right_value, "^'")) or (matches(r.separator, "'$") and matches(l.right_value, "^''"));
let sq_middle = select l.call as call, l.file as file from internal as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(l.value, "^'$") and matches(r.separator, "'$") and matches(r.separator, "^'")) or (l.value = "" and ((matches(r.separator, "''$") and matches(r.separator, "^'")) or (matches(r.separator, "'$") and matches(r.separator, "^''"))));
let sq_empties = select l.call as call, l.file as file from double_empty as l join rare_separators as r on l.call = r.call and l.file = r.file where matches(r.separator, "^'$");
let sq_empty_pairs = select call, file from empty_sep_pairs where (matches(left_value, "''$") and matches(right_value, "^'")) or (matches(left_value, "'$") and matches(right_value, "^''"));
let sq_empty_triples = select call, file from three_pieces where matches(first_value, "'$") and matches(middle_value, "^'$") and matches(last_value, "^'");
let sq_union0 = union(left=sq_inside, right=sq_separator);
let sq_union1 = union(left=sq_left, right=sq_right);
let sq_union2 = union(left=sq_middle, right=sq_empties);
let sq_union3 = union(left=sq_empty_pairs, right=sq_empty_triples);
let sq_half0 = union(left=sq_union0, right=sq_union1);
let sq_half1 = union(left=sq_union2, right=sq_union3);
let sq_found = union(left=sq_half0, right=sq_half1);
let dq_inside = select call, file from rare_elements where matches(value, "\x22\x22\x22");
let dq_separator = select l.call as call, l.file as file from rare_separators as l join sep_used as r on l.call = r.call and l.file = r.file where matches(l.separator, "\x22\x22\x22");
let dq_left = select l.call as call, l.file as file from left_values as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(l.left_value, "\x22\x22$") and matches(r.separator, "^\x22")) or (matches(l.left_value, "\x22$") and matches(r.separator, "^\x22\x22"));
let dq_right = select l.call as call, l.file as file from right_values as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(r.separator, "\x22\x22$") and matches(l.right_value, "^\x22")) or (matches(r.separator, "\x22$") and matches(l.right_value, "^\x22\x22"));
let dq_middle = select l.call as call, l.file as file from internal as l join rare_separators as r on l.call = r.call and l.file = r.file where (matches(l.value, "^\x22$") and matches(r.separator, "\x22$") and matches(r.separator, "^\x22")) or (l.value = "" and ((matches(r.separator, "\x22\x22$") and matches(r.separator, "^\x22")) or (matches(r.separator, "\x22$") and matches(r.separator, "^\x22\x22"))));
let dq_empties = select l.call as call, l.file as file from double_empty as l join rare_separators as r on l.call = r.call and l.file = r.file where matches(r.separator, "^\x22$");
let dq_empty_pairs = select call, file from empty_sep_pairs where (matches(left_value, "\x22\x22$") and matches(right_value, "^\x22")) or (matches(left_value, "\x22$") and matches(right_value, "^\x22\x22"));
let dq_empty_triples = select call, file from three_pieces where matches(first_value, "\x22$") and matches(middle_value, "^\x22$") and matches(last_value, "^\x22");
let dq_union0 = union(left=dq_inside, right=dq_separator);
let dq_union1 = union(left=dq_left, right=dq_right);
let dq_union2 = union(left=dq_middle, right=dq_empties);
let dq_union3 = union(left=dq_empty_pairs, right=dq_empty_triples);
let dq_half0 = union(left=dq_union0, right=dq_union1);
let dq_half1 = union(left=dq_union2, right=dq_union3);
let dq_found = union(left=dq_half0, right=dq_half1);
let raw_style_conflicts = select l.call as call, l.file as file from sq_found as l join dq_found as r on l.call = r.call and l.file = r.file;
let valid_static = antijoin(left=all_strings, right=raw_style_conflicts, left-on=["call", "file"], right-on=["call", "file"]);
let result = union(left=valid_static, right=valid_mixed);
let candidates = select l.call as id, l.file as file, r.span as span, r."start-line" as line from result as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])FLY002(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FLY002)(?:,|$)");
emit violations subject file key(id);
