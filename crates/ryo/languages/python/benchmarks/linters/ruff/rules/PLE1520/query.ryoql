import observation_matches from "python/ruff/suppress-matches";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let decorators = select id, file, span from "syntax-tree" where kind = "decorator";
let singledispatchmethod_names = select id, file from "qualified-name" where path = "functools.singledispatchmethod";
let decorator_axes = axis(from=singledispatchmethod_names, relation="syntax-child", direction=ancestor, domain=decorators);
let target_decorator_rows = select l.id as expression, r.related as decorator, l.file as file from singledispatchmethod_names as l join decorator_axes as r on l.id = r.id;
let function_axes = axis(from=decorators, relation="syntax-child", direction=ancestor, domain=functions);
let decorator_functions = select l.id as decorator, r.related as function, l.file as file, l.span as span from decorators as l join function_axes as r on l.id = r.id and l.file = r.file;
let target_functions = select l.decorator as decorator, l.function as function, l.file as file, l.span as span from decorator_functions as l join target_decorator_rows as r on l.decorator = r.decorator and l.file = r.file;
let scope_edges = select child, parent from "scope";
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let function_parent_scopes = select l.child as function, l.parent as parent, r.file as file from scope_edges as l join functions as r on l.child = r.id;
let methods = select l.function as function, l.file as file from function_parent_scopes as l join class_scopes as r on l.parent = r.id and l.file = r.file;
let non_class_methods = antijoin(left=functions,right=methods,left-on=["id","file"],right-on=["function","file"]);
let non_methods = select id, file from non_class_methods;
let function_decorators = select l.decorator as id, l.file as file, l.span as span from target_functions as l join non_methods as r on l.function = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from function_decorators as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLE1520)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE1520"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
