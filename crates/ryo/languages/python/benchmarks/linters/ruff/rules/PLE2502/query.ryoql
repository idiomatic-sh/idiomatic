import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress_unmapped from "python/ruff/suppress-unmapped";
let modules = select id, file, span from "syntax-tree" where kind = "module";
let locations = extend(from=modules, values={base_line:1});
let affected = source-matches(from=locations, span="span", base-line="base_line", pattern="(?mR)^[^\r\n]*(?:\x{202A}|\x{202B}|\x{202C}|\x{202D}|\x{202E}|\x{2066}|\x{2067}|\x{2068}|\x{2069}|\x{200F}|\x{061C})[^\r\n]*(?:\r\n|\r|\n|$)", output="line_span", line-output="line");
let candidates = select id, file, line_span as span, line from affected;
let violations = suppress_unmapped(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE2502(?:$|[^A-Z0-9])", range-pattern="(?:^|,)PLE2502(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLE2502)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLE2502)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE2502"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id, span);
