import observation_matches from "python/ruff/suppress-unmapped-matches";
import suppress from "python/ruff/suppress-unmapped";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let qnames = select id, path, provenance, file from "qualified-name";
let starmap_functions = select id, file from qnames where path = "itertools.starmap" and (provenance = "builtin" or provenance = "import");
let zip_functions = select id, file from qnames where path = "builtins.zip" and (provenance = "builtin" or provenance = "import");
let starmap_calls = select l.call as call, l.file as file from call_functions as l join starmap_functions as r on l.function = r.id and l.file = r.file;
let zip_calls = select l.call as call, l.file as file from call_functions as l join zip_functions as r on l.function = r.id and l.file = r.file;
let argument_edges = select parent as call, child as wrapper from "semantic-child";
let call_arguments_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.call as call, r.id as wrapper, r.file as file from argument_edges as l join call_arguments_nodes as r on l.wrapper = r.id;
let outer_wrappers = select l.call as call, l.file as file, r.wrapper as wrapper from starmap_calls as l join wrappers as r on l.call = r.call and l.file = r.file;
let inner_wrappers = select l.call as call, l.file as file, r.wrapper as wrapper from zip_calls as l join wrappers as r on l.call = r.call and l.file = r.file;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let outer_positional = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from outer_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let outer_counts = group-count(from=outer_positional, keys=["call","file"], count="count", distinct="argument");
let exactly_two = select call, file from outer_counts where count = 2;
let keyword_fields = select parent, file from "semantic-child" where field = "keywords";
let outer_keyword_wrappers = select l.call as call, l.file as file from outer_wrappers as l join keyword_fields as r on l.wrapper = r.parent and l.file = r.file;
let outer_no_keywords = antijoin(left=outer_wrappers,right=outer_keyword_wrappers,left-on=["call","file"],right-on=["call","file"]);
let eligible_outer = select l.call as call, l.file as file from exactly_two as l join outer_no_keywords as r on l.call = r.call and l.file = r.file;
let earlier_outer_arguments = select l.call as call, l.file as file, l.argument as argument, r.argument as earlier from outer_positional as l join outer_positional as r on l.call = r.call and l.file = r.file where l.ordinal > r.ordinal;
let outer_argument_ranks = group-count(from=earlier_outer_arguments, keys=["call","file","argument"], count="count", distinct="earlier");
let second_arguments = select l.call as call, l.argument as argument, l.file as file from outer_positional as l join outer_argument_ranks as r on l.call = r.call and l.file = r.file and l.argument = r.argument where r.count = 1;
let inner_calls = select l.call as outer, r.argument as inner, l.file as file from eligible_outer as l join second_arguments as r on l.call = r.call and l.file = r.file;
let nested_zip_calls = select l.outer as outer, l.inner as inner, l.file as file from inner_calls as l join zip_calls as r on l.inner = r.call and l.file = r.file;
let nested_zip_wrappers = select l.outer as outer, l.inner as inner, r.wrapper as wrapper, l.file as file from nested_zip_calls as l join inner_wrappers as r on l.inner = r.call and l.file = r.file;
let inner_keywords = select parent as wrapper, file from keyword_fields;
let keyworded_zip = select l.outer as outer, l.inner as inner, l.file as file from nested_zip_wrappers as l join inner_keywords as r on l.wrapper = r.wrapper and l.file = r.file;
let keyword_free_zip = antijoin(left=nested_zip_wrappers,right=keyworded_zip,left-on=["outer","inner","file"],right-on=["outer","inner","file"]);
let inner_positional = select l.outer as outer, l.inner as inner, r.child as argument, l.file as file from nested_zip_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let starred_nodes = select id, file from "semantic-syntax" where kind = "starred";
let starred_args = select l.outer as outer, l.inner as inner, l.argument as argument, l.file as file from inner_positional as l join starred_nodes as r on l.argument = r.id and l.file = r.file;
let all_starred_counts = group-count(from=starred_args, keys=["outer","inner","file"], count="star_count", distinct="argument");
let all_arg_counts = group-count(from=inner_positional, keys=["outer","inner","file"], count="arg_count", distinct="argument");
let all_starred_calls = select l.outer as outer, l.inner as inner, l.file as file from all_arg_counts as l join all_starred_counts as r on l.outer = r.outer and l.inner = r.inner and l.file = r.file where l.arg_count = r.star_count and l.arg_count > 0;
let valid_zip_calls = antijoin(left=keyword_free_zip,right=all_starred_calls,left-on=["outer","inner","file"],right-on=["outer","inner","file"]);
let reportable = select l.outer as id, l.file as file, r.span as span from valid_zip_calls as l join calls as r on l.outer = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF058(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF058)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF058(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF058)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF058"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
