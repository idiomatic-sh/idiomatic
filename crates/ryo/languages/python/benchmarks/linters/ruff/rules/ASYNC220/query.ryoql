import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent as call, child as function, file from "semantic-child" where field = "func";
let call_functions = select l.call as call, l.function as function, l.file as file from function_fields as l join calls as r on l.call = r.id and l.file = r.file;
let scope_boundaries = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let nearest_scopes = axis(from=calls, relation="semantic-child", direction=nearest-ancestor, domain=scope_boundaries);
let async_scopes = select id, file from "semantic-syntax" where kind = "async-function-def";
let call_nearest_scopes = select l.id as call, l.file as file, r.related as scope from calls as l join nearest_scopes as r on l.id = r.id and l.file = r.file;
let async_calls = select l.call as call, l.file as file from call_nearest_scopes as l join async_scopes as r on l.scope = r.id and l.file = r.file;
let call_qnames = select l.call as call, l.function as function, q.path as path, l.file as file, q.span as span from call_functions as l join "qualified-name" as q on l.function = q.id and l.file = q.file;
let call_argument_edges = select parent as call, child as wrapper, file from "semantic-child";
let argument_containers = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, l.file as file from call_argument_edges as l join argument_containers as r on l.wrapper = r.id and l.file = r.file;
let positional_fields = select parent as wrapper, child as value, ordinal, file from "semantic-child" where field = "args";
let positional_values = select l.call as call, p.value as value, p.ordinal as ordinal, l.file as file from call_wrappers as l join positional_fields as p on l.wrapper = p.wrapper and l.file = p.file;
let first_positional = select call, value, file from positional_values where ordinal = 1;
let keyword_fields = select parent as wrapper, child as keyword, file from "semantic-child" where field = "keywords";
let call_keyword_nodes = select l.call as call, k.keyword as keyword, l.file as file from call_wrappers as l join keyword_fields as k on l.wrapper = k.wrapper and l.file = k.file;
let keyword_names = select parent as keyword, child as name, file from "semantic-child" where field = "arg";
let keyword_values = select parent as keyword, child as value, file from "semantic-child" where field = "value";
let identifiers = select id, name, file from "identifier";
let keyword_name_edges = select l.keyword as keyword, l.call as call, k.name as name, l.file as file from call_keyword_nodes as l join keyword_names as k on l.keyword = k.keyword and l.file = k.file;
let named_keywords = select l.keyword as keyword, l.call as call, n.name as name, l.file as file from keyword_name_edges as l join identifiers as n on l.name = n.id and l.file = n.file;
let mode_keyword_nodes = select keyword, call, file from named_keywords where name = "mode";
let keyword_mode_values = select l.call as call, r.value as value, l.file as file from mode_keyword_nodes as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let mode_values_positional = select l.call as call, l.value as value, l.file as file from first_positional as l;
let mode_values = union(left=mode_values_positional, right=keyword_mode_values);
let spawn_names = select call, function, file, span from call_qnames where path = "os.spawnl" or path = "os.spawnle" or path = "os.spawnlp" or path = "os.spawnlpe" or path = "os.spawnv" or path = "os.spawnve" or path = "os.spawnvp" or path = "os.spawnvpe";
let spawn_mode_values = select l.call as call, m.value as value, l.file as file, l.function as function, l.span as span from spawn_names as l join mode_values as m on l.call = m.call and l.file = m.file;
let p_wait_values = select id, file from "qualified-name" where path = "os.P_WAIT";
let direct_p_wait = select l.call as call, l.function as function, l.file as file, l.span as span from spawn_mode_values as l join p_wait_values as r on l.value = r.id and l.file = r.file;
let name_mode_values = select l.call as call, l.value as reference, l.file as file, l.function as function, l.span as span from spawn_mode_values as l join "semantic-syntax" as n on l.value = n.id and l.file = n.file where n.kind = "name";
let binding_uses = select reference, binding, file from "binding-use";
let mode_bindings = select l.call as call, r.binding as binding, l.file as file, l.function as function, l.span as span from name_mode_values as l join binding_uses as r on l.reference = r.reference and l.file = r.file;
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let assignment_targets = select parent as assignment, child as target, file from "semantic-child" where field = "targets" or field = "target";
let assignment_values = select parent as assignment, child as value, file from "semantic-child" where field = "value";
let defined_assignment_targets = select l.id as binding, t.assignment as assignment, l.file as file from "defines" as l join assignment_targets as t on l.id = t.target and l.file = t.file;
let assigned_targets = select l.binding as binding, l.assignment as assignment, l.file as file from defined_assignment_targets as l join assignment_nodes as a on l.assignment = a.id and l.file = a.file;
let binding_assignments = select l.binding as binding, v.value as value, l.file as file from assigned_targets as l join assignment_values as v on l.assignment = v.assignment and l.file = v.file;
let binding_mode_assignments = select l.call as call, l.function as function, l.file as file, l.span as span, a.value as value from mode_bindings as l join binding_assignments as a on l.binding = a.binding and l.file = a.file;
let alias_p_wait_values = select l.call as call, l.function as function, l.file as file, l.span as span from binding_mode_assignments as l join p_wait_values as p on l.value = p.id and l.file = p.file;
let p_wait_mode_calls = union(left=direct_p_wait, right=alias_p_wait_values);
let p_wait_spawn_calls = select l.call as call, l.function as function, l.file as file, l.span as span from p_wait_mode_calls as l join spawn_names as r on l.call = r.call and l.file = r.file;
let missing_mode = antijoin(left=spawn_names, right=mode_values, left-on=["call","file"], right-on=["call","file"]);
let run_spawn_before_async = union(left=p_wait_spawn_calls, right=missing_mode);
let create_spawn_before_async = antijoin(left=spawn_mode_values, right=p_wait_spawn_calls, left-on=["call","file"], right-on=["call","file"]);
let run_spawn_calls = select l.call as call, l.function as function, l.file as file, l.span as span from run_spawn_before_async as l join async_calls as r on l.call = r.call and l.file = r.file;
let create_spawn_calls = select l.call as call, l.function as function, l.file as file, l.span as span from create_spawn_before_async as l join async_calls as r on l.call = r.call and l.file = r.file;
let direct_methods = select call, function, file, span from call_qnames where path = "subprocess.Popen" or path = "os.popen";
let async_direct_methods = select l.call as call, l.function as function, l.file as file, l.span as span from direct_methods as l join async_calls as r on l.call = r.call and l.file = r.file;
let all_candidates = union(left=async_direct_methods, right=create_spawn_calls);
let locations = select l.function as id, l.file as file, l.span as span, r."start-line" as line from all_candidates as l join "source-location" as r on l.function = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC220(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)ASYNC220(?:,|$)");
let ruf100_matches = observation_matches(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC220(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)ASYNC220(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "ASYNC220"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
