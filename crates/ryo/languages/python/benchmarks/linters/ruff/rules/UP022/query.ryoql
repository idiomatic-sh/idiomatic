import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let run_functions = select id, file from "qualified-name" where path = "subprocess.run";
let run_calls = select l.call as call, l.file as file from call_functions as l join run_functions as r on l.function = r.id and l.file = r.file;
let call_argument_fields = select parent as call, child as wrapper from "semantic-child";
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_argument_fields as l join argument_nodes as r on l.wrapper = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let call_keyword_nodes = select l.call as call, r.child as keyword, l.file as file from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id, file from "semantic-syntax" where kind = "keyword";
let actual_keywords = select l.call as call, l.keyword as keyword, l.file as file from call_keyword_nodes as l join keyword_nodes as r on l.keyword = r.id and l.file = r.file;
let run_keywords = select l.call as call, l.keyword as keyword, l.file as file from actual_keywords as l join run_calls as r on l.call = r.call and l.file = r.file;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_arg_ids = select r.call as call, l.parent as keyword, l.child as id, r.file as file from keyword_arg_fields as l join run_keywords as r on l.parent = r.keyword;
let identifiers = select id, name, file from "identifier";
let keyword_names = select l.call as call, l.keyword as keyword, l.id as id, r.name as name, l.file as file from keyword_arg_ids as l join identifiers as r on l.id = r.id and l.file = r.file;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_values = select r.call as call, l.parent as keyword, l.child as value, r.file as file from keyword_value_fields as l join run_keywords as r on l.parent = r.keyword;
let keyword_rows = select l.call as call, l.keyword as keyword, l.name as name, r.value as value, l.file as file from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file and l.call = r.call;
let relevant_keywords = select call, keyword, name, value, file from keyword_rows where name = "stdout" or name = "stderr";
let keyword_positions = select l.call as call, l.keyword as keyword, l.name as name, l.value as value, l.file as file, r."start-byte" as begin from relevant_keywords as l join "source-location" as r on l.keyword = r.id and l.file = r.file;
let later_same_keywords = select l.call as call, l.keyword as keyword, l.name as name, l.file as file from keyword_positions as l join keyword_positions as r on l.call = r.call and l.name = r.name and l.file = r.file where l.begin > r.begin;
let first_keywords = antijoin(left=relevant_keywords,right=later_same_keywords,left-on=["call","keyword","name","file"],right-on=["call","keyword","name","file"]);
let pipe_values = select id, file from "qualified-name" where path = "subprocess.PIPE";
let pipe_keywords = select l.call as call, l.keyword as keyword, l.name as name, l.file as file from first_keywords as l join pipe_values as r on l.value = r.id and l.file = r.file;
let stdout_keywords = select call, file from pipe_keywords where name = "stdout";
let stderr_keywords = select call, file from pipe_keywords where name = "stderr";
let paired_pipe_calls = select l.call as call, l.file as file from stdout_keywords as l join stderr_keywords as r on l.call = r.call and l.file = r.file;
let reportable = select l.call as id, l.file as file, r.span as span from paired_pipe_calls as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP022(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP022)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP022)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP022)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP022"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
