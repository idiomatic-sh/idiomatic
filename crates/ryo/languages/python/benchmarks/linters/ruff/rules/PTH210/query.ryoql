import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_calls = select l.call as call, l.function as attribute, l.file as file from call_functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_children = select l.parent as attribute, r.child as token from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifier_edges = select r.child as id, l.name as name from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let attribute_names = select l.attribute as attribute, r.name as name from attr_children as l join identifiers as r on l.token = r.id;
let suffix_attributes = select attribute from attribute_names where name = "with_suffix";
let suffix_calls = select l.call as call, l.attribute as attribute, l.file as file from attribute_calls as l join suffix_attributes as r on l.attribute = r.attribute;
let value_fields = select parent, child from "semantic-child" where field = "value";
let attribute_bases = select l.parent as attribute, l.child as base, r.file as file from value_fields as l join calls as r on l.child = r.id;
let base_call_fields = select parent, child from "semantic-child" where field = "func";
let base_call_functions = select l.parent as base, l.child as function, r.file as file from base_call_fields as l join calls as r on l.parent = r.id;
let path_constructors = select id, file from "qualified-name" where path = "pathlib.Path";
let path_base_calls = select l.base as base, l.file as file from base_call_functions as l join path_constructors as r on l.function = r.id and l.file = r.file;
let path_suffix_attributes = select l.attribute as attribute, l.file as file from attribute_bases as l join path_base_calls as r on l.base = r.base and l.file = r.file;
let path_suffix_attribute_rows = select l.attribute as attribute, l.file as file from path_suffix_attributes as l join suffix_attributes as r on l.attribute = r.attribute;
let path_suffix_calls = select r.call as call, l.file as file from path_suffix_attribute_rows as l join attribute_calls as r on l.attribute = r.attribute and l.file = r.file;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let assignment_targets = select parent, child from "semantic-child" where field = "targets" or field = "target";
let direct_name_targets = select l.parent as assignment, r.id as target, r.file as file from assignment_targets as l join name_nodes as r on l.child = r.id;
let assignment_values = select parent, child from "semantic-child" where field = "value";
let assignment_value_calls = select l.parent as assignment, l.child as value, r.file as file from assignment_values as l join calls as r on l.child = r.id;
let path_value_assignments = select l.assignment as assignment, l.file as file from assignment_value_calls as l join path_base_calls as r on l.value = r.base and l.file = r.file;
let assignment_path_targets = select l.target as target, l.file as file from direct_name_targets as l join path_value_assignments as r on l.assignment = r.assignment and l.file = r.file;
let assignment_path_bindings = select l.occurrence as binding, l.name as name, l.file as file from "binding-event" as l join assignment_path_targets as r on l.occurrence = r.target and l.file = r.file where l.kind = "bind";
let parameter_nodes = select id, file from "semantic-syntax" where kind = "arg";
let annotation_fields = select parent, child from "semantic-child" where field = "annotation";
let annotated_arguments = select l.id as argument, l.file as file, r.child as annotation from parameter_nodes as l join annotation_fields as r on l.id = r.parent;
let path_annotations = select l.argument as argument, l.file as file from annotated_arguments as l join path_constructors as r on l.annotation = r.id and l.file = r.file;
let annotated_path_bindings = select l.occurrence as binding, l.name as name, l.file as file from "binding-event" as l join path_annotations as r on l.occurrence = r.argument and l.file = r.file where l.kind = "bind";
let bound_path_targets = union(left=assignment_path_bindings, right=annotated_path_bindings);
let name_bases = select l.parent as attribute, l.child as base, r.file as file from value_fields as l join name_nodes as r on l.child = r.id;
let base_uses = select l.attribute as attribute, r.binding as binding, l.file as file from name_bases as l join "binding-use" as r on l.base = r.reference and l.file = r.file;
let initialized_path_bases = select l.attribute as attribute, l.file as file from base_uses as l join bound_path_targets as r on l.binding = r.binding and l.file = r.file;
let bound_path_suffix_attrs = select l.attribute as attribute, l.file as file from initialized_path_bases as l join suffix_attributes as r on l.attribute = r.attribute;
let bound_path_suffix_calls = select r.call as call, l.file as file from bound_path_suffix_attrs as l join attribute_calls as r on l.attribute = r.attribute and l.file = r.file;
let path_suffix_call_set = union(left=path_suffix_calls, right=bound_path_suffix_calls);
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, l.file as file from wrappers as l join positional_fields as r on l.wrapper = r.parent;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_arg_edges = select l.parent as keyword, r.child as token from keyword_arg_fields as l join "semantic-child" as r on l.child = r.parent;
let keyword_identifiers = select l.keyword as keyword, r.name as name from keyword_arg_edges as l join identifiers as r on l.token = r.id;
let suffix_keywords = select keyword from keyword_identifiers where name = "suffix";
let suffix_keyword_edges = select l.call as call, l.keyword as keyword, l.file as file from keywords as l join suffix_keywords as r on l.keyword = r.keyword;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_suffix_values = select l.call as call, r.child as value, l.file as file from suffix_keyword_edges as l join keyword_value_fields as r on l.keyword = r.parent;
let all_keyword_value_rows = select l.call as call, r.child as value, l.file as file from keywords as l join keyword_value_fields as r on l.keyword = r.parent;
let all_argument_values = union(left=positional_arguments, right=all_keyword_value_rows);
let argument_counts = group-count(from=all_argument_values, keys=["call", "file"], count="count", distinct="value");
let candidate_argument_values = union(left=positional_arguments, right=keyword_suffix_values);
let single_argument_calls = select call, file from argument_counts where count = 1;
let eligible_single_calls = select l.call as call, l.file as file from path_suffix_call_set as l join single_argument_calls as r on l.call = r.call and l.file = r.file;
let sole_arguments = select l.call as call, l.value as value, l.file as file from candidate_argument_values as l join eligible_single_calls as r on l.call = r.call and l.file = r.file;
let literal_suffixes = select l.call as call, r.value as value, l.file as file from sole_arguments as l join "string-literal" as r on l.value = r.occurrence and l.file = r.file;
let bad_suffixes = select call, file from literal_suffixes where matches(value, "^[^.].*") or value = ".";
let reportable = select l.call as id, r.span as span, l.file as file from bad_suffixes as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PTH210(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PTH210)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PTH210(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PTH210)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PTH210"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
