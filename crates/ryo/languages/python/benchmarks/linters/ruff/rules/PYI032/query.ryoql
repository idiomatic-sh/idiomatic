import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let names = select parent, child, file from "semantic-child" where field = "name";
let identifiers = select id, name, file from "identifier";
let function_names = select l.parent as function, r.name as name, l.file as file from names as l join identifiers as r on l.child = r.id and l.file = r.file;
let comparison_names = select function, name, file from function_names where name = "__eq__" or name = "__ne__";
let comparison_functions = select l.function as function, l.name as name, l.file as file from comparison_names as l join functions as r on l.function = r.id and l.file = r.file;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_ancestors = axis(from=functions, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let comparisons = select l.function as function, l.file as file from comparison_functions as l join class_ancestors as r on l.function = r.id and l.file = r.file;
let arguments_edges = select l.parent as function, l.child as arguments, l.file as file from "semantic-child" as l join comparisons as r on l.parent = r.function and l.file = r.file where l.field = "args";
let positional_raw = select l.parent as arguments, l.child as parameter, l.ordinal as ordinal, l.file as file from "semantic-child" as l join arguments_edges as r on l.parent = r.arguments and l.file = r.file where l.field = "args";
let parameter_wrappers = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let wrapped_raw = select l.arguments as arguments, l.parameter as wrapper, l.ordinal as ordinal, l.file as file from positional_raw as l join parameter_wrappers as w on l.parameter = w.id and l.file = w.file;
let wrapped_positions = select l.arguments as arguments, r.child as parameter, l.ordinal as ordinal, l.file as file from wrapped_raw as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let bare_positions = antijoin(left=positional_raw, right=parameter_wrappers, left-on=["parameter", "file"], right-on=["id", "file"]);
let positional = union(left=wrapped_positions, right=bare_positions);
let argument_counts = group-count(from=positional, keys=["arguments", "file"], count="count", distinct="parameter");
let exactly_two_arguments = select arguments, file from argument_counts where count = 2;
let two_argument_positions = select l.arguments as arguments, l.parameter as parameter, l.ordinal as ordinal, l.file as file from positional as l join exactly_two_arguments as r on l.arguments = r.arguments and l.file = r.file;
let prior_positions = select l.arguments as arguments, r.parameter as later, l.parameter as earlier, l.file as file from two_argument_positions as l join two_argument_positions as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let prior_counts = group-count(from=prior_positions, keys=["arguments", "later", "file"], count="count", distinct="earlier");
let earliest_second = select arguments, later as parameter, file from prior_counts where count = 1;
let annotation_edges = select parent as parameter, child as annotation, file from "semantic-child" where field = "annotation";
let annotated_second = select l.parameter as parameter, r.annotation as annotation, l.file as file from earliest_second as l join annotation_edges as r on l.parameter = r.parameter and l.file = r.file;
let any_annotations = select id as annotation, file from "qualified-name" where path = "typing.Any" or path = "typing_extensions.Any";
let matching = select l.annotation as id, l.file as file from annotated_second as l join any_annotations as r on l.annotation = r.annotation and l.file = r.file;
let locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from "source-location" as r;
let candidates = select l.id as id, l.file as file, r.span as span, r.line as line from matching as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI032(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI032)(?:,|$)");
emit violations subject file key(id);
