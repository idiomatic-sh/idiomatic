import namespace_events from "python/ruff/checker-namespace-events";
import latest_before from "python/ruff/latest-before";
import nonlocal_bindings from "python/ruff/nonlocal-bindings";
import ordinary_uses_of from "python/ruff/ordinary-read-uses";
import deferred_events from "python/ruff/deferred-read-events";
import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import noqa_additional_locations from "python/ruff/noqa-additional-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, file, span from "semantic-syntax";
let modules = select id, file from nodes where kind = "module";
let scopes = select id from nodes where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let assignment_nodes = select id from nodes where kind = "assign" or kind = "ann-assign" or kind = "aug-assign";
let assignment_scopes = axis(from=assignment_nodes,relation="semantic-child",direction=nearest-ancestor,domain=scopes);
let module_assignments = select l.id as statement from assignment_scopes as l join modules as r on l.related = r.id;
let target_fields = select parent as statement, child as target, ordinal from "semantic-child" where field = "targets" or field = "target";
let initial_targets = group-min(from=target_fields, keys=["statement"], order="ordinal");
let export_names = select id from "identifier" where name = "__all__";
let export_targets = select l.statement as statement from initial_targets as l join export_names as r on l.target = r.id;
let export_statements = select l.statement as statement from module_assignments as l join export_targets as r on l.statement = r.statement;
let value_fields = select parent, child from "semantic-child" where field = "value";
let export_values = select l.statement as statement, r.child as value from export_statements as l join value_fields as r on l.statement = r.parent;
let binary_nodes = select id from nodes where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let binary_left = select l.id as origin, r.child as destination from binary_nodes as l join left_fields as r on l.id = r.parent;
let left_paths = closure(edges=binary_left,source="origin",destination="destination");
let binary_values = select l.statement as statement, l.value as value from export_values as l join binary_nodes as r on l.value = r.id;
let left_values = select l.statement as statement, r.destination as value from binary_values as l join left_paths as r on l.value = r.origin;
let binary_spine = union(left=binary_values,right=left_values);
let right_fields = select parent, child from "semantic-child" where field = "right";
let right_values = select l.statement as statement, r.child as value from binary_spine as l join right_fields as r on l.value = r.parent;
let plain_values = antijoin(left=export_values,right=binary_values,left-on=["statement","value"],right-on=["statement","value"]);
let binary_leaves = antijoin(left=left_values,right=binary_nodes,left-on=["value"],right-on=["id"]);
let binary_operands = union(left=binary_leaves,right=right_values);
let extraction_roots = union(left=plain_values,right=binary_operands);
let named_nodes = select id from nodes where kind = "named-expr";
let named_edges = select l.id as origin, r.child as destination from named_nodes as l join value_fields as r on l.id = r.parent;
let named_paths = closure(edges=named_edges,source="origin",destination="destination");
let unwrapped_values = select l.statement as statement, r.destination as value from extraction_roots as l join named_paths as r on l.value = r.origin;
let extracted_values = union(left=extraction_roots,right=unwrapped_values);
let sequences = select id from nodes where kind = "list" or kind = "tuple";
let direct_sequences = select l.statement as statement, l.value as sequence from extracted_values as l join sequences as r on l.value = r.id;
let call_nodes = select id from nodes where kind = "call";
let selected_calls = select l.statement as statement, l.value as call from extracted_values as l join call_nodes as r on l.value = r.id;
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.call as call, r.child as function from selected_calls as l join function_fields as r on l.call = r.parent;
let subscript_nodes = select id from nodes where kind = "subscript";
let subscript_functions = select l.call as call, l.function as function from call_functions as l join subscript_nodes as r on l.function = r.id;
let generic_functions = select l.call as call, r.child as function from subscript_functions as l join value_fields as r on l.function = r.parent;
let plain_functions = antijoin(left=call_functions,right=subscript_functions,left-on=["call"],right-on=["call"]);
let resolved_functions = union(left=plain_functions,right=generic_functions);
let constructors = select q.id as id from "qualified-name" as q where (q.path = "builtins.list" or q.path = "builtins.tuple") and (q.provenance = "import" or q.provenance = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10));
let constructor_calls = select l.call as call from resolved_functions as l join constructors as r on l.function = r.id;
let argument_nodes = select id from nodes where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as arguments from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as value from argument_owners as l join positional_fields as r on l.arguments = r.parent;
let positional_counts = group-count(from=positional,keys=["call"],count="count",distinct="value");
let single_argument = select call from positional_counts where count = 1;
let keyword_fields = select parent from "semantic-child" where field = "keywords";
let keyword_calls = select l.call as call from argument_owners as l join keyword_fields as r on l.arguments = r.parent;
let no_keywords = antijoin(left=constructor_calls,right=keyword_calls,left-on=["call"],right-on=["call"]);
let valid_calls = select l.call as call from no_keywords as l join single_argument as r on l.call = r.call;
let containers = select id from nodes where kind = "list" or kind = "tuple" or kind = "set";
let container_arguments = select l.call as call, l.value as sequence from positional as l join containers as r on l.value = r.id;
let call_sequences = select l.call as call, r.sequence as sequence from valid_calls as l join container_arguments as r on l.call = r.call;
let constructed_sequences = select l.statement as statement, r.sequence as sequence from selected_calls as l join call_sequences as r on l.call = r.call;
let export_sequences = union(left=direct_sequences,right=constructed_sequences);
let element_fields = select parent, child from "semantic-child" where field = "elts";
let export_elements = select l.statement as statement, r.child as id from export_sequences as l join element_fields as r on l.sequence = r.parent;
let constants = select id from nodes where kind = "constant";
let literal_exports = select l.statement as statement, l.id as id from export_elements as l join constants as r on l.id = r.id;
let exports = select l.statement as statement, l.id as id, r.value as name, r.file as file, r.span as span from literal_exports as l join "string-literal" as r on l.id = r.occurrence;
let definitions = select id as binding, name, owner as scope, file, span from "defines";
let imports0 = select l.binding as binding, l.name as name, l.scope as scope, l.file as file, l.span as span, r.span as alias_span from definitions as l join "static-import" as r on l.binding = r.occurrence;
let import_scopes = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def";
let import_ids = select binding as id, name, scope, file, span, alias_span from imports0;
let import_lexical = axis(from=import_ids,relation="semantic-child",direction=nearest-ancestor,domain=scopes);
let imports = select l.id as binding, l.name as name, l.scope as scope, l.related as lexical, l.file as file, l.span as span, l.alias_span as alias_span from import_lexical as l join import_scopes as r on l.related = r.id and l.file = r.file;
let events = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event";
let bindings = select occurrence as binding, name, scope, phase, ordinal, file from events where kind = "bind";
let dated_imports = select l.binding as binding, l.name as name, l.scope as scope, l.lexical as lexical, l.file as file, l.span as span, l.alias_span as alias_span, r.phase as phase, r.ordinal as ordinal from imports as l join bindings as r on l.binding = r.binding;
let redirections = select occurrence as id, name, kind from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_scopes = axis(from=redirections,relation="semantic-child",direction=nearest-ancestor,domain=scopes);
let function_nodes = select id from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let global_redirect_rows = select related as lexical, name from redirect_scopes where kind = "global";
let global_redirected_counts = group-count(from=global_redirect_rows, keys=["lexical","name"], count="count");
let global_redirected = select lexical, name from global_redirected_counts;
let nonlocal_redirect_rows = select related as lexical, name from redirect_scopes where kind = "nonlocal";
let nonlocal_redirected_counts = group-count(from=nonlocal_redirect_rows, keys=["lexical","name"], count="count");
let nonlocal_redirected = select lexical, name from nonlocal_redirected_counts;
let ending_events = select occurrence as id, name, scope, phase, ordinal, file from events where kind = "bind" or kind = "delete" or kind = "cleanup";
let ending_owners = axis(from=ending_events,relation="semantic-child",direction=nearest-ancestor,domain=scopes);
let redirected_names = union(left=global_redirected,right=nonlocal_redirected);
let ending_rows = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file, r.related as lexical from ending_events as l join ending_owners as r on l.id = r.id;
let nonmodule_scopes = select id from nodes where kind != "module";
let redirected_scoped_names = select l.lexical as lexical, l.name as name from redirected_names as l join nonmodule_scopes as r on l.lexical = r.id;
let redirected_endings = select l.id as id from ending_rows as l join redirected_scoped_names as r on l.lexical = r.lexical and l.name = r.name;
let own_endings = antijoin(left=ending_rows,right=redirected_endings,left-on=["id"],right-on=["id"]);
let endings = select id as occurrence, name, scope, phase, ordinal, file from own_endings;
let ending_successors = ordered-match(left=endings, right=endings, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", output={binding:[left,occurrence], file:[left,file]});
let replaced_imports = select l.binding as binding from dated_imports as l join ending_successors as r on l.binding = r.binding and l.file = r.file;
let current_imports = antijoin(left=dated_imports,right=replaced_imports,left-on=["binding"],right-on=["binding"]);
let global_exempt0 = select l.binding as binding, l.lexical as lexical from current_imports as l join global_redirected as r on l.lexical = r.lexical and l.name = r.name;
let global_exempt = select l.binding as binding from global_exempt0 as l join function_nodes as r on l.lexical = r.id;
let nonlocal_exempt0 = select l.binding as binding, l.scope as scope from current_imports as l join nonlocal_redirected as r on l.lexical = r.lexical and l.name = r.name;
let nonlocal_exempt = select l.binding as binding from nonlocal_exempt0 as l join function_nodes as r on l.scope = r.id;
let redirected_imports = union(left=global_exempt,right=nonlocal_exempt);
let unredirected_imports = antijoin(left=current_imports,right=redirected_imports,left-on=["binding"],right-on=["binding"]);
let from_imports = select id from nodes where kind = "import-from";
let module_fields = select parent, child from "semantic-child" where field = "module";
let future_names = select id from "identifier" where name = "__future__";
let future_statements = select l.parent as id from module_fields as l join future_names as r on l.child = r.id;
let future_aliases = select r.child as binding from future_statements as l join "semantic-child" as r on l.id = r.parent;
let ordinary_imports = antijoin(left=unredirected_imports,right=future_aliases,left-on=["binding"],right-on=["binding"]);
let aliases = select id from nodes where kind = "alias";
let asname_fields = select parent as binding, child from "semantic-child" where field = "asname";
let alias_names = select l.binding as binding, r.name as name from asname_fields as l join "identifier" as r on l.child = r.id;
let name_fields = select parent as binding, child from "semantic-child" where field = "name";
let imported_names = select l.binding as binding, r.name as name from name_fields as l join "identifier" as r on l.child = r.id;
let explicit_exports = select l.binding as binding from alias_names as l join imported_names as r on l.binding = r.binding and l.name = r.name;
let implicit_imports = antijoin(left=ordinary_imports,right=explicit_exports,left-on=["binding"],right-on=["binding"]);
let binding_stream0 = select name, scope, phase, ordinal, file, binding as occurrence from bindings;
let binding_stream = extend(from=binding_stream0, values={tag: "bind"});
let ending_stream0 = select name, scope, phase, ordinal, file, occurrence from "binding-event" where kind = "delete" or kind = "cleanup";
let ending_stream = extend(from=ending_stream0, values={tag: "end"});
let replacement_timeline = union(left=binding_stream, right=ending_stream);
let timeline_pairs = ordered-match(left=replacement_timeline, right=replacement_timeline, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", output={earlier:[left,occurrence], later:[right,occurrence], before:[left,tag], after:[right,tag], ordinal:[right,ordinal]});
let local_replacements = select earlier, later, ordinal from timeline_pairs where before = "bind" and after = "bind";
let replacement_edges = select earlier, later from local_replacements;
let all_reads = select reference as id, name, scope, phase, file from "binding-read";
let deferred_resolutions = deferred_events(missing=all_reads);
let read_ids = select occurrence as reference, file from events where kind = "read" or kind = "delete";
let lexical_reads = antijoin(left=read_ids, right=deferred_resolutions, left-on=["reference", "file"], right-on=["reference", "file"]);
let ordinary_lookups = ordinary_uses_of(reads=lexical_reads);
let ordinary_uses = select reference, binding, file from ordinary_lookups where kind = "bind";
let ordinary_direct_uses = select binding from ordinary_uses;
let deferred_points = select occurrence as binding, point from deferred_resolutions where kind = "bind";
let deferred_binding_uses = select binding from deferred_points;
let plain_import_statements = select id from nodes where kind = "import";
let plain_import_owners = axis(from=aliases,relation="semantic-child",direction=nearest-ancestor,domain=plain_import_statements);
let plain_aliases = select id as binding from plain_import_owners;
let import_targets = select occurrence as binding, binding as name, target, file from "static-import";
let plain_targets = select l.binding as binding, l.name as name, l.target as target, l.file as file from import_targets as l join plain_aliases as r on l.binding = r.binding;
let alias_tails = replace(from=plain_targets, text="target", pattern="^.*[.]", replacement="", output="tail");
let alias_heads = replace(from=alias_tails, text="target", pattern="[.].*$", replacement="", output="head");
let alias_imports = select binding, tail, file from alias_heads where tail = head and tail != name;
let submodule_targets = antijoin(left=plain_targets,right=asname_fields,left-on=["binding"],right-on=["binding"]);
let submodule_imports = select binding, name, file from submodule_targets where matches(target, "[.]");
let alias_bound = select l.binding as binding, l.tail as name, l.file as file, r.scope as scope from alias_imports as l join bindings as r on l.binding = r.binding;
let submodule_bound = select l.binding as binding, l.name as name, l.file as file, r.scope as scope, r.ordinal as ordinal from submodule_imports as l join bindings as r on l.binding = r.binding;
let load_events = select occurrence as reference, ordinal from "binding-event" where kind = "read";
let ordinary_loads = select l.binding as binding, r.ordinal as point from ordinary_uses as l join load_events as r on l.reference = r.reference;
let resolved_loads = union(left=ordinary_loads, right=deferred_points);
let alias_loads = select l.point as point, r.name as name, r.scope as scope, r.file as file from resolved_loads as l join alias_bound as r on l.binding = r.binding;
let submodule_uses = select r.binding as binding from alias_loads as l join submodule_bound as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.point;
let submodule_bindings = select binding from submodule_uses;
let direct_uses0 = union(left=ordinary_direct_uses, right=deferred_binding_uses);
let nonlocal_events = namespace_events();
let resolved_nonlocals = nonlocal_bindings(events=nonlocal_events);
let nonlocal_target_uses = select binding from resolved_nonlocals;
let direct_uses1 = union(left=direct_uses0, right=submodule_bindings);
let direct_uses = union(left=direct_uses1, right=nonlocal_target_uses);
let copied_uses = select r.later as binding from direct_uses as l join local_replacements as r on l.binding = r.earlier;
let copied_marker_rows = select b.scope as scope, b.phase as phase, b.name as name, b.file as file, b.ordinal as ordinal from copied_uses as c join bindings as b on c.binding = b.binding;
let barrier_rows = select scope, phase, name, file, ordinal from ending_stream0;
let chain_events = union(left=copied_marker_rows, right=barrier_rows);
let uncopied_bindings = antijoin(left=bindings, right=copied_uses, left-on=["binding"], right-on=["binding"]);
let chain_probes = select scope, phase, name, file, ordinal from uncopied_bindings;
let chain_hits = latest_before(events=chain_events, probes=chain_probes);
let marker_hits = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point from chain_hits as l join copied_marker_rows as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.event_ordinal = r.ordinal;
let inherited_uses = select b.binding as binding from marker_hits as h join bindings as b on h.scope = b.scope and h.phase = b.phase and h.name = b.name and h.file = b.file and h.point = b.ordinal;
let copied_and_inherited = union(left=copied_uses,right=inherited_uses);
let used = union(left=direct_uses,right=copied_and_inherited);
let branch_nodes = select id, file from nodes where kind = "if" or kind = "try" or kind = "try-star" or kind = "match-case";
let child_parent_edges = select child as origin, parent as destination from "semantic-child";
let event_ancestry = closure(edges=child_parent_edges, source="origin", destination="destination");
let event_branch_ancestors = select l.occurrence as binding, r.destination as owner, l.file as file from events as l join event_ancestry as r on l.occurrence = r.origin;
let branch_events = select l.binding as binding, l.file as file from event_branch_ancestors as l join branch_nodes as r on l.owner = r.id and l.file = r.file;
let conditional_delete_bindings = select l.occurrence as binding from events as l join branch_events as r on l.occurrence = r.binding and l.file = r.file where l.kind = "delete";
let conditional_delete_events = select l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file from events as l join conditional_delete_bindings as r on l.occurrence = r.binding;
let conditional_delete_stream = select scope, phase, name, file, ordinal from conditional_delete_events;
let current_import_probes = select scope, phase, name, file, ordinal from current_imports;
let conditional_delete_hits = latest_before(events=conditional_delete_stream, probes=current_import_probes);
let imports_after_conditional_delete = select l.binding as binding from current_imports as l join conditional_delete_hits as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.ordinal = r.point;
let uses_with_conditional_deletes = union(left=used,right=imports_after_conditional_delete);
let unused_imports = antijoin(left=implicit_imports,right=uses_with_conditional_deletes,left-on=["binding"],right-on=["binding"]);
let global_imports = select l.binding as binding, l.name as name, l.file as file from unused_imports as l join modules as r on l.scope = r.id;
let exported_imports = select l.binding as binding from global_imports as l join exports as r on l.file = r.file and l.name = r.name;
let unexported_imports = antijoin(left=unused_imports,right=exported_imports,left-on=["binding"],right-on=["binding"]);
let report_candidates_with_identifier = select l.binding as binding, r.id as id, l.file as file, l.span as span from unexported_imports as l join "identifier" as r on l.file = r.file and l.span = r.span;
let import_spans_with_identifier = select l.binding as binding from report_candidates_with_identifier as l;
let report_candidates_without_identifier = antijoin(left=unexported_imports,right=import_spans_with_identifier,left-on=["binding"],right-on=["binding"]);
let dotted_report_candidates = select binding, binding as id, file, alias_span as span from report_candidates_without_identifier;
let report_candidates = union(left=report_candidates_with_identifier,right=dotted_report_candidates);
let reportable = select id, file, span from report_candidates;
let import_statements = select id from nodes where kind = "import" or kind = "import-from";
let import_owners = axis(from=aliases,relation="semantic-child",direction=nearest-ancestor,domain=import_statements);
let report_parents = select l.id as id, l.file as file, r.related as parent from report_candidates as l join import_owners as r on l.binding = r.id;
let export_parent_lines = select l.id as id, l.file as file, r."start-line" as line from report_parents as l join "source-location" as r on l.parent = r.id;
let candidate_locations = line_located(candidates=reportable);
let suppression_mappings = noqa_line_map();
let suppression_locations = noqa_locations(candidates=candidate_locations, mappings=suppression_mappings);
let suppression_parents = noqa_additional_locations(additional_locations=export_parent_lines, mappings=suppression_mappings);
let suppression_matches = suppression_edges(candidates=candidate_locations, locations=suppression_locations, additional_locations=suppression_parents, codes="^(?:F401)$");
let suppression_candidates = select id, file, span from suppression_locations;
let violations = antijoin(left=suppression_candidates, right=suppression_matches, left-on=[id, span], right-on=[id, span]);
let matched_directives = select directive, file from suppression_matches where scope < 2;
let noqa_matches = extend(from=matched_directives, values={code: "F401"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
