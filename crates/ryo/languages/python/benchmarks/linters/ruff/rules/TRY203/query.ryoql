import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let handlers = select id, file, span from "semantic-syntax" where kind = "except-handler";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let later = select l.child as child from bodies as l join bodies as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first = antijoin(left=bodies, right=later, left-on=["child"], right-on=["child"]);
let raises = select id from "semantic-syntax" where kind = "raise";
let causes = select parent from "semantic-child" where field = "cause";
let unchained = antijoin(left=raises, right=causes, left-on=["id"], right-on=["parent"]);
let starts_with_raise = select l.parent as handler, r.id as id from first as l join unchained as r on l.child = r.id;
let raised_values = select parent, child from "semantic-child" where field = "exc";
let bare = antijoin(left=starts_with_raise, right=raised_values, left-on=["id"], right-on=["parent"]);
let bare_handlers = select handler from bare;
let name_fields = select parent, child from "semantic-child" where field = "name";
let alias_tokens = select l.parent as parent, r.child as child from name_fields as l join "semantic-child" as r on l.child = r.parent;
let identifiers = select id, text from semantic_identifiers;
let aliases = select l.parent as handler, r.text as name from alias_tokens as l join identifiers as r on l.child = r.id;
let ids = select parent, child from "semantic-child" where field = "id";
let names = select l.parent as id, r.text as name from ids as l join identifiers as r on l.child = r.id;
let raised_names = select l.parent as id, r.name as name from raised_values as l join names as r on l.child = r.id;
let first_named_raises = select l.handler as handler, r.name as name from starts_with_raise as l join raised_names as r on l.id = r.id;
let named_handlers = select l.handler as handler from first_named_raises as l join aliases as r on l.handler = r.handler and l.name = r.name;
let good_handlers = union(left=bare_handlers, right=named_handlers);
let bad_handlers = antijoin(left=handlers, right=good_handlers, left-on=["id"], right-on=["handler"]);
let positions = select parent, child from "semantic-child" where field = "handlers";
let bad_tries = select l.parent as parent from positions as l join bad_handlers as r on l.child = r.id;
let good_positions = antijoin(left=positions, right=bad_tries, left-on=["parent"], right-on=["parent"]);
let reportable = select r.id as id, r.file as file, r.span as span from good_positions as l join handlers as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TRY203|TRY302)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY203|TRY302)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TRY203)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY203)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TRY203"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
