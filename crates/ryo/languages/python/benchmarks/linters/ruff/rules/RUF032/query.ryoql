import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
import keyword_argument_names from "python/ruff/call-keywords";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let keyword_names = keyword_argument_names(keywords=keywords, identifiers=semantic_identifiers);
let qualified = select id from qualified_names where path = "decimal.Decimal" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let matching_calls = select l.parent as id, l.child as function from functions as l join qualified as r on l.child = r.id;
let constants = select id from "semantic-syntax" where kind = "constant";
let float_candidates = select id, text from "semantic-syntax" where kind = "number" and matches(text, "[.eE]");
let nonfloat_tokens = select id from float_candidates where matches(text, "^0[xX]|[jJ]$");
let float_tokens = antijoin(left=float_candidates, right=nonfloat_tokens, left-on=["id"], right-on=["id"]);
let numeric_children = select l.parent as id from "semantic-child" as l join float_tokens as r on l.child = r.id;
let float_literals = select l.id as id from constants as l join numeric_children as r on l.id = r.id;
let unary = select id from "semantic-syntax" where kind = "unary-op";
let operator_fields = select parent, child from "semantic-child" where field = "op";
let signs = select id from "semantic-syntax" where text = "+" or text = "-";
let signed_ops = select l.parent as id from operator_fields as l join signs as r on l.child = r.id;
let signed_unary = select l.id as id from unary as l join signed_ops as r on l.id = r.id;
let operands = select parent, child from "semantic-child" where field = "operand";
let edges = select l.id as outer, r.child as inner from signed_unary as l join operands as r on l.id = r.parent;
let paths = closure(edges=edges, source="outer", destination="inner");
let signed_floats = select l.outer as id from paths as l join float_literals as r on l.inner = r.id;
let floats = union(left=float_literals, right=signed_floats);
let first_args = select call, id from positional where ordinal = 0;
let float_args = select l.call as call, l.id as id from first_args as l join floats as r on l.id = r.id;
let invalid = select l.id as id from float_args as l join matching_calls as r on l.call = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join invalid as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:RUF032)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF032"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
