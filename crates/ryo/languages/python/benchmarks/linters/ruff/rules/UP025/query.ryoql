import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let reportable = select id, file, span from "semantic-syntax" where kind = "string" and matches(text, "^[uU]");
let candidate_locations = line_located(candidates=reportable);
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, code="UP025");
let violations = antijoin(left=reportable, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_used = select directive,file,concat("","UP025") as code from suppression_found where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
