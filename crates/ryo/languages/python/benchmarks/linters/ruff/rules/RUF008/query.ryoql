import observation_matches from "python/ruff/suppress-matches";
import annotation_origins from "python/ruff/annotation-origins";
import suppress from "python/ruff/suppress";
import dataclass_decorators from "python/ruff/dataclass-decorators";
import immutable_annotation from "python/ruff/immutable-annotation";
let dataclasses = dataclass_decorators();
let nodes = select id, kind, file, span from "semantic-syntax";
let annotated = select id, file from nodes where kind = "ann-assign";
let body_edges = select parent, child, file from "semantic-child" where field = "body";
let class_body = select l.class as class, l.file as file, r.child as statement from dataclasses as l join body_edges as r on l.class = r.parent and l.file = r.file;
let assignments = select l.statement as statement, l.file as file from class_body as l join annotated as r on l.statement = r.id and l.file = r.file;
let values = select parent, child, file from "semantic-child" where field = "value";
let annotation_edges = select parent, child, file from "semantic-child" where field = "annotation";
let defaults = select l.statement as statement, l.file as file, r.child as value from assignments as l join values as r on l.statement = r.parent and l.file = r.file;
let annotations = select l.statement as statement, l.file as file, r.child as annotation from defaults as l join annotation_edges as r on l.statement = r.parent and l.file = r.file;
let roots = select annotation as id, file from annotations;
let immutable = immutable_annotation(expressions=roots);
let immutable_assignments = select l.statement as statement, l.file as file from annotations as l join immutable as r on l.annotation = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as id, l.file as file, r.child as value from subscripts as l join values as r on l.id = r.parent and l.file = r.file;
let annotation_names = annotation_origins(expressions=roots);
let direct_origins = select l.statement as statement, l.file as file, r.path as path from annotations as l join annotation_names as r on l.annotation = r.id and l.file = r.file;
let subscript_origins = select l.id as id, l.file as file, r.path as path from subscript_values as l join annotation_names as r on l.value = r.id and l.file = r.file;
let mapped_origins = select l.statement as statement, l.file as file, r.path as path from annotations as l join subscript_origins as r on l.annotation = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=mapped_origins);
let class_variables = select statement, file from origins where path = "typing.ClassVar" or path = "typing_extensions.ClassVar";
let exemptions = union(left=immutable_assignments, right=class_variables);
let eligible = antijoin(left=defaults, right=exemptions, left-on=["statement","file"], right-on=["statement","file"]);
let mutable_literals = select id, file from nodes where kind = "list" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "dict-comp" or kind = "set-comp";
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let callees = select l.id as call, l.file as file, r.child as callee from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let direct_functions = select call, file, callee as function from callees;
let generic_functions = select l.call as call, l.file as file, r.value as function from callees as l join subscript_values as r on l.callee = r.id and l.file = r.file;
let all_functions = union(left=direct_functions, right=generic_functions);
let function_origins = select l.call as call, l.file as file, r.path as path from all_functions as l join "qualified-name" as r on l.function = r.id and l.file = r.file;
let mutable_calls = select call as id, file from function_origins where path = "builtins.list" or path = "builtins.dict" or path = "builtins.set" or path = "collections.Counter" or path = "collections.OrderedDict" or path = "collections.defaultdict" or path = "collections.deque";
let mutable_values = union(left=mutable_literals, right=mutable_calls);
let matched = select l.value as id, l.file as file from eligible as l join mutable_values as r on l.value = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from matched as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF008(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF008)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF008(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF008)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF008"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
