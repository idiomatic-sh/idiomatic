import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let attributes = select id, file from nodes where kind = "attribute";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_ids = select l.id as attribute, l.file as file, r.child as identifier from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let named_attrs = select l.attribute as attribute, l.file as file from attr_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file where r.name = "fromkeys";
let attr_receivers = select l.attribute as attribute, l.file as file, r.child as receiver from named_attrs as l join value_edges as r on l.attribute = r.parent and l.file = r.file;
let builtin_dict_attrs = select l.attribute as attribute, l.file as file from attr_receivers as l join "qualified-name" as r on l.receiver = r.id and l.file = r.file where r.path = "builtins.dict";
let fromkeys_calls = select l.call as call, l.file as file from callee_nodes as l join builtin_dict_attrs as r on l.callee = r.attribute and l.file = r.file;
let binary_calls = select l.call as call, l.file as file from fromkeys_calls as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 2;
let second_values = select l.call as call, l.file as file, r.value as value from binary_calls as l join positional_arguments as r on l.call = r.call and l.file = r.file where r.position = 1;
let mutable_literals = select id, file from nodes where kind = "list" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "dict-comp" or kind = "set-comp";
let subscripts = select id, file from nodes where kind = "subscript";
let ordinary_callees = antijoin(left=callee_nodes, right=subscripts, left-on=["callee","file"], right-on=["id","file"]);
let subscript_functions = select l.call as call, l.file as file, l.callee as callee from callee_nodes as l join subscripts as r on l.callee = r.id and l.file = r.file;
let mapped_subscript_callees = select l.call as call, l.file as file, r.child as callee from subscript_functions as l join value_edges as r on l.callee = r.parent and l.file = r.file;
let mapped_callees = union(left=ordinary_callees, right=mapped_subscript_callees);
let mutable_calls = select l.call as id, l.file as file from mapped_callees as l join "qualified-name" as r on l.callee = r.id and l.file = r.file where r.path = "builtins.list" or r.path = "builtins.dict" or r.path = "builtins.set" or r.path = "collections.Counter" or r.path = "collections.OrderedDict" or r.path = "collections.defaultdict" or r.path = "collections.deque";
let mutable_values = union(left=mutable_literals, right=mutable_calls);
let matched_calls = select l.call as id, l.file as file from second_values as l join mutable_values as r on l.value = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span from matched_calls as l join calls as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF024(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF024)(?:,|$)");
emit violations subject file key(id);
