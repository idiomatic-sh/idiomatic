import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let sequences = select id, file from nodes where kind = "list" or kind = "tuple";
let elements = select l.id as sequence, r.child as element, l.file as file from sequences as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let starred = select id, file from nodes where kind = "starred";
let uncertain = select l.sequence as id, l.file as file from elements as l join starred as r on l.element = r.id and l.file = r.file;
let known = antijoin(left=sequences, right=uncertain, left-on=["id", "file"], right-on=["id", "file"]);
let counts = group-count(from=elements, keys=["sequence", "file"], count="length", distinct="element");
let nonempty = select l.id as sequence, l.file as file, r.length as length from known as l join counts as r on l.id = r.sequence and l.file = r.file;
let empty_ids = antijoin(left=known, right=counts, left-on=["id", "file"], right-on=["sequence", "file"]);
let empty_sequences = select id as sequence, file from empty_ids;
let empty = extend(from=empty_sequences, values={length: 0});
let lengths = union(left=nonempty, right=empty);
let subscripts = select id, file from nodes where kind = "subscript";
let receivers = select l.id as subscript, r.child as sequence, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let bounded = select l.subscript as subscript, l.file as file, r.length as length from receivers as l join lengths as r on l.sequence = r.sequence and l.file = r.file;
let indices = select l.subscript as subscript, r.child as id, l.length as length, l.file as file from bounded as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let integers = select id, value, file from "numeric-literal" where kind = "integer";
let positive = select l.id as id, l.file as file, l.length as length, r.value as magnitude from indices as l join integers as r on l.id = r.id and l.file = r.file;
let positive_bad = select id, file from positive where numeric_gte(magnitude, length);
let unaries = select id, file from nodes where kind = "unary-op";
let minus_tokens = select id, file from "semantic-syntax" where text = "-";
let minus_owners = select l.parent as id, l.file as file from "semantic-child" as l join minus_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let negatives = select l.id as id, l.length as length, l.file as file from indices as l join unaries as r on l.id = r.id and l.file = r.file;
let actual_negatives = select l.id as id, l.length as length, l.file as file from negatives as l join minus_owners as r on l.id = r.id and l.file = r.file;
let operands = select l.id as id, l.length as length, r.child as operand, l.file as file from actual_negatives as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "operand";
let negative = select l.id as id, l.file as file, l.length as length, r.value as magnitude from operands as l join integers as r on l.operand = r.id and l.file = r.file;
let negative_at_least = select id, file from negative where numeric_gte(magnitude, length);
let negative_at_most = select id, file from negative where numeric_gte(length, magnitude);
let negative_beyond = antijoin(left=negative_at_least, right=negative_at_most, left-on=["id", "file"], right-on=["id", "file"]);
let negative_zero_empty = select id, file from negative where length = 0 and numeric_gte(0, magnitude);
let negative_bad = union(left=negative_beyond, right=negative_zero_empty);
let bad = union(left=positive_bad, right=negative_bad);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from bad as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PLE0643($|[, #])", range-pattern="(?:^|,)PLE0643(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="PLE0643($|[, #])", range-pattern="(?:^|,)PLE0643(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE0643"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
