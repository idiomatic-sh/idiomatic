import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let definitions = select id as binding, kind, refinement, name, owner as scope, file, span from "defines";
let private_definitions = select * from definitions where starts_with(name, "_");
let uses = select binding, file from "binding-use";
let unused_private = antijoin(left=private_definitions, right=uses, left-on=["binding", "file"], right-on=["binding", "file"]);
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let ordinary_scopes = select id, file from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def";
let ordinary_scope_definitions = select l.binding as binding, l.file as file from unused_private as l join ordinary_scopes as r on l.scope = r.id and l.file = r.file;
let stub_definitions = select l.binding as binding, l.file as file from unused_private as l join stub_files as r on l.file = r.file;
let permitted_definitions = union(left=ordinary_scope_definitions, right=stub_definitions);
let eligible_private = select l.binding as binding, l.file as file, r.kind as kind from permitted_definitions as l join unused_private as r on l.binding = r.binding and l.file = r.file;
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let private_class_bindings = select l.binding as binding, l.file as file from eligible_private as l join classes as r on l.binding = r.id and l.file = r.file where l.kind = "class";
let typed_dict_base_occurrences = select occurrence as base, declaration as class, file from "inherits";
let typed_dict_names = select id, file from "qualified-name" where path = "typing.TypedDict" or path = "typing_extensions.TypedDict";
let typed_dict_bases = select l.class as class, l.file as file from typed_dict_base_occurrences as l join typed_dict_names as r on l.base = r.id and l.file = r.file;
let class_typed_dicts = select l.binding as binding, l.file as file from private_class_bindings as l join typed_dict_bases as r on l.binding = r.class and l.file = r.file;
let assignments = select id, file from "semantic-syntax" where kind = "assign";
let assignment_targets = select parent as assignment, child as target, file from "semantic-child" where field = "targets";
let assignment_values = select parent as assignment, child as value, file from "semantic-child" where field = "value";
let other_target_pairs = select l.assignment as assignment from assignment_targets as l join assignment_targets as r on l.assignment = r.assignment and l.file = r.file where l.target != r.target;
let single_assignment_targets = antijoin(left=assignment_targets, right=other_target_pairs, left-on=["assignment"], right-on=["assignment"]);
let calls = select id, file from "semantic-syntax" where kind = "call";
let call_functions = select parent as call, child as function, file from "semantic-child" where field = "func";
let typed_dict_functions = select id, file from "qualified-name" where path = "typing.TypedDict" or path = "typing_extensions.TypedDict";
let typed_dict_calls = select l.call as call, l.file as file from call_functions as l join typed_dict_functions as r on l.function = r.id and l.file = r.file;
let assignment_call_values = select l.assignment as assignment, c.id as call, l.file as file from assignment_values as l join calls as c on l.value = c.id and l.file = c.file;
let call_assignments = select l.assignment as assignment, l.file as file from assignment_call_values as l join typed_dict_calls as r on l.call = r.call and l.file = r.file;
let private_single_targets = select l.binding as binding, r.assignment as assignment, l.file as file from eligible_private as l join single_assignment_targets as r on l.binding = r.target and l.file = r.file where l.kind = "variable";
let assignment_candidates = select l.binding as binding, l.file as file from private_single_targets as l join call_assignments as r on l.assignment = r.assignment and l.file = r.file;
let class_and_functional = union(left=class_typed_dicts, right=assignment_candidates);
let candidates = select l.binding as id, l.file as file, r.span as span from class_and_functional as l join definitions as r on l.binding = r.binding and l.file = r.file;
let locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI049(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI049(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI049)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI049)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI049"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
