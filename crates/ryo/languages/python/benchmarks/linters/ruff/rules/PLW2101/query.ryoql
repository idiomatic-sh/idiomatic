import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let with_nodes = select id, file from nodes where kind = "with" or kind = "async-with";
let items = select l.id as owner, r.child as item, l.file as file from with_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "items";
let contexts = select r.child as id, l.file as file from items as l join "semantic-child" as r on l.item = r.parent and l.file = r.file where r.field = "context-expr";
let calls = select id, file from nodes where kind = "call";
let context_calls = select l.id as call, l.file as file from contexts as l join calls as r on l.id = r.id and l.file = r.file;
let functions = select l.call as call, r.child as id, l.file as file from context_calls as l join "semantic-child" as r on l.call = r.parent and l.file = r.file where r.field = "func";
let attributes = select id, file from nodes where kind = "attribute";
let names = select id, file from nodes where kind = "name";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let attribute_edges = select l.id as parent, r.child as child, l.file as file from attributes as l join value_fields as r on l.id = r.parent and l.file = r.file;
let head_walk = axis(from=functions, relation=attribute_edges, direction=descendant, domain=names);
let nested_heads = select id as function, related as head, file from head_walk;
let direct_heads = select l.id as function, l.id as head, l.file as file from functions as l join names as r on l.id = r.id and l.file = r.file;
let heads = union(left=direct_heads, right=nested_heads);
let import_reads = select l.reference as head, l.file as file from "binding-use" as l join "static-import" as r on l.binding = r.occurrence and l.file = r.file where l.certainty = "unique";
let imported_functions = select l.function as id, l.file as file from heads as l join import_reads as r on l.head = r.head and l.file = r.file;
let imported_names = select l.id as id, l.file as file, r.path as path from imported_functions as l join "qualified-name" as r on l.id = r.id and l.file = r.file;
let lock_factories = select id, file from imported_names where path = "threading.Lock" or path = "threading.RLock" or path = "threading.Condition" or path = "threading.Semaphore" or path = "threading.BoundedSemaphore";
let fresh_locks = select l.call as id, l.file as file from functions as l join lock_factories as r on l.id = r.id and l.file = r.file;
let unique_locks = group-count(from=fresh_locks, keys=["id","file"], count="count");
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from unique_locks as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW2101(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW2101)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW2101(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW2101)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW2101"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
