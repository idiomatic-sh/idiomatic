import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, file, span from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for";
let target_fields = select parent, child from "semantic-child" where field = "target";
let iter_fields = select parent, child from "semantic-child" where field = "iter";
let target_roots = select l.id as loop, r.child as id, l.file as file from loops as l join target_fields as r on l.id = r.parent;
let iter_roots = select l.id as loop, r.child as id, l.file as file from loops as l join iter_fields as r on l.id = r.parent;
let descendant_edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=descendant_edges, source="origin", destination="destination");
let target_descendants = select l.loop as loop, r.destination as id, l.file as file from target_roots as l join descendants as r on l.id = r.origin;
let iter_descendants = select l.loop as loop, r.destination as id, l.file as file from iter_roots as l join descendants as r on l.id = r.origin;
let target_ids = union(left=target_roots, right=target_descendants);
let iter_ids = union(left=iter_roots, right=iter_descendants);
let name_nodes = select id from nodes where kind = "name";
let identifiers = select l.id as id, l.name as name from "identifier" as l join name_nodes as r on l.id = r.id;
let target_positions = select l.loop as loop, l.id as id, l.file as file, r."start-byte" as pos from target_ids as l join "source-location" as r on l.id = r.id;
let target_names = select l.loop as loop, l.id as id, r.name as name, l.file as file, l.pos as pos from target_positions as l join identifiers as r on l.id = r.id;
let iter_names = select l.loop as loop, r.id as id, r.name as name, l.file as file from iter_ids as l join identifiers as r on l.id = r.id;
let lambdas = select id, file from nodes where kind = "lambda";
let lambda_args = select l.id as owner, r.child as id, l.file as file from lambdas as l join "semantic-child" as r on l.id = r.parent where r.field = "args";
let lambda_body_roots = select r.child as id, l.file as file from lambdas as l join "semantic-child" as r on l.id = r.parent where r.field = "body";
let lambda_arg_descendants = select l.owner as owner, r.destination as id, l.file as file from lambda_args as l join descendants as r on l.id = r.origin;
let lambda_arg_ids = select id, file from lambda_args;
let lambda_arg_children = select id, file from lambda_arg_descendants;
let lambda_arg_all = union(left=lambda_arg_ids, right=lambda_arg_children);
let without_lambda_arguments = antijoin(left=iter_names, right=lambda_arg_all, left-on=["id","file"], right-on=["id","file"]);
let lambda_direct_body_names = select l.id as id, l.file as file from lambda_body_roots as l join nodes as r on l.id = r.id and l.file = r.file where r.kind = "name";
let without_direct_lambda_names = antijoin(left=without_lambda_arguments, right=lambda_direct_body_names, left-on=["id","file"], right-on=["id","file"]);
let lambda_parameters = select owner, name, file from "parameter";
let name_lambda_ancestors = axis(from=without_direct_lambda_names, relation="semantic-child", direction=nearest-ancestor, domain=lambdas);
let shadowed_lambda_names = select l.id as id, l.file as file from name_lambda_ancestors as l join lambda_parameters as r on l.related = r.owner and l.name = r.name and l.file = r.file;
let lambda_scoped_names = antijoin(left=without_direct_lambda_names, right=shadowed_lambda_names, left-on=["id","file"], right-on=["id","file"]);
let comprehension_exprs = select id, kind, file from nodes where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let comprehension_clauses = select id, file from nodes where kind = "comprehension";
let skipped_clause_fields = select l.id as parent, r.child as id, l.file as file from comprehension_clauses as l join "semantic-child" as r on l.id = r.parent where r.field = "target" or r.field = "ifs";
let skipped_expr_fields = select l.id as parent, r.child as id, l.file as file from comprehension_exprs as l join "semantic-child" as r on l.id = r.parent where r.field = "elt" or r.field = "key" or r.field = "value";
let skipped_fields = union(left=skipped_clause_fields, right=skipped_expr_fields);
let skipped_descendants = select l.parent as parent, r.destination as id, l.file as file from skipped_fields as l join descendants as r on l.id = r.origin;
let skipped_roots = select id, file from skipped_fields;
let skipped_children = select id, file from skipped_descendants;
let skipped_nodes = union(left=skipped_roots, right=skipped_children);
let iterator_names = antijoin(left=lambda_scoped_names, right=skipped_nodes, left-on=["id","file"], right-on=["id","file"]);
let matching_names = select l.loop as loop, l.id as id, l.name as name, l.file as file, l.pos as pos from target_names as l join iterator_names as r on l.loop = r.loop and l.name = r.name and l.file = r.file;
let later_same_name = select l.loop as loop, l.id as id, l.file as file from matching_names as l join matching_names as r on l.loop = r.loop and l.file = r.file and l.name = r.name where l.pos < r.pos;
let last_occurrences = antijoin(left=matching_names, right=later_same_name, left-on=["loop","id","file"], right-on=["loop","id","file"]);
let reportable = select l.id as id, l.file as file, r.span as span from last_occurrences as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B020)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "B020"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
