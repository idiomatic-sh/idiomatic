import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let builtin_print_reads = select reference as function, file from "binding-read" where name = "print" and state = "builtin" and context = "value";
let builtin_print_functions = select l.id as id, l.file as file from "qualified-name" as l join builtin_print_reads as r on l.id = r.function and l.file = r.file where l.path = "builtins.print" and l.provenance = "builtin";
let imported_print_bindings = select occurrence as binding, file from "static-import" where target = "builtins.print";
let imported_print_uses = select l.reference as function, l.file as file from "binding-use" as l join imported_print_bindings as r on l.binding = r.binding and l.file = r.file;
let imported_print_functions = select l.id as id, l.file as file from "qualified-name" as l join imported_print_uses as r on l.id = r.function and l.file = r.file where l.path = "builtins.print" and l.provenance = "import";
let print_functions = union(left=builtin_print_functions, right=imported_print_functions);
let print_calls = select l.call as call, l.file as file from call_functions as l join print_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from argument_owners as l join positional_fields as r on l.wrapper = r.parent;
let positional_counts = group-count(from=positional_arguments, keys=["call", "file"], count="count", distinct="argument");
let empty_strings = select id, file from "literal-properties" where kind = "string" and empty = "true";
let empty_arguments = select l.call as call, l.argument as argument, l.file as file from positional_arguments as l join empty_strings as r on l.argument = r.id and l.file = r.file;
let empty_call_counts = group-count(from=empty_arguments, keys=["call", "file"], count="count", distinct="argument");
let starred_nodes = select id from "semantic-syntax" where kind = "starred";
let starred_arguments = select l.call as call, l.file as file from positional_arguments as l join starred_nodes as r on l.argument = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from argument_owners as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_arg_nodes = select l.call as call, l.keyword as keyword, l.file as file, r.child as arg_wrapper from keyword_edges as l join arg_fields as r on l.keyword = r.parent;
let arg_edges = select l.call as call, l.keyword as keyword, l.file as file, r.child as token from keyword_arg_nodes as l join "semantic-child" as r on l.arg_wrapper = r.parent;
let identifier_edges = select l.child as id, r.name as name from "semantic-child" as l join "identifier" as r on l.parent = r.id;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name, l.call as call, l.file as file from arg_edges as l join identifiers as r on l.token = r.id;
let sep_keywords = select call, keyword, file from keyword_names where name = "sep";
let any_sep_calls = select call, file from sep_keywords;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let sep_values = select l.call as call, l.keyword as keyword, l.file as file, r.child as value from sep_keywords as l join keyword_value_fields as r on l.keyword = r.parent;
let empty_sep_calls = select l.call as call, l.file as file from sep_values as l join empty_strings as r on l.value = r.id and l.file = r.file;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let named_keyword_ids = select parent as keyword from keyword_arg_fields;
let keyword_spreads = antijoin(left=keywords, right=named_keyword_ids, left-on=["keyword"], right-on=["keyword"]);
let keyword_spread_calls = select call, file from keyword_spreads;
let one_arg_calls = select call, file from positional_counts where count = 1;
let one_empty_arg_calls = select l.call as call, l.file as file from one_arg_calls as l join empty_call_counts as r on l.call = r.call and l.file = r.file;
let zero_arg_calls = antijoin(left=print_calls, right=positional_counts, left-on=["call", "file"], right-on=["call", "file"]);
let small_print_calls_a = select l.call as call, l.file as file from zero_arg_calls as l join any_sep_calls as r on l.call = r.call and l.file = r.file;
let small_print_calls_b = select l.call as call, l.file as file from one_empty_arg_calls as l;
let small_print_calls_c = select l.call as call, l.file as file from one_arg_calls as l join any_sep_calls as r on l.call = r.call and l.file = r.file;
let small_print_calls_d = union(left=small_print_calls_a, right=small_print_calls_b);
let small_print_calls = union(left=small_print_calls_d, right=small_print_calls_c);
let large_print_calls_a = select l.call as call, l.file as file from positional_counts as l join empty_call_counts as r on l.call = r.call and l.file = r.file where l.count > 1;
let large_print_calls_b = select l.call as call, l.file as file from large_print_calls_a as l join empty_sep_calls as r on l.call = r.call and l.file = r.file;
let large_print_calls = antijoin(left=large_print_calls_b, right=keyword_spread_calls, left-on=["call", "file"], right-on=["call", "file"]);
let candidate_calls = union(left=small_print_calls, right=large_print_calls);
let printable_candidates = select l.call as call, l.file as file from candidate_calls as l join print_calls as r on l.call = r.call and l.file = r.file;
let unstarred_candidates = antijoin(left=printable_candidates, right=starred_arguments, left-on=["call", "file"], right-on=["call", "file"]);
let candidates = select l.call as id, l.file as file, r.span as span from unstarred_candidates as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB105(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB105)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:FURB105)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:FURB105)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB105"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
