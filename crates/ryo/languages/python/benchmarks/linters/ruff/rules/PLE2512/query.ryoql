import observation_matches from "python/ruff/suppress-matches";
import control_characters from "python/ruff/control-character-tokens";
let occurrences = control_characters();
let candidates = select id, file, span, line from occurrences where matches(text, "^\x1a$");
let violations_matches = observation_matches(candidates=candidates, code="PLE2512");
let violations = antijoin(left=candidates, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PLE2512") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id, span);
