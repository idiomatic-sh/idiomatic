import observation_matches from "python/ruff/suppress-matches";
import binding_type from "python/ruff/binding-type";
let loops = select id, file, span from "semantic-syntax" where kind = "for";
let targets = select parent, child, file from "semantic-child" where field = "target";
let loop_targets = select l.id as loop, l.file as file, r.child as target from loops as l join targets as r on l.id = r.parent and l.file = r.file;
let loop_bindings = select l.loop as loop, l.file as file, r.occurrence as binding from loop_targets as l join "binding-event" as r on l.target = r.occurrence and l.file = r.file where r.kind = "bind";
let loop_body_edges = select parent, child, file from "semantic-child" where field = "body";
let loop_body_items = select l.loop as loop, l.file as file, r.child as statement from loop_bindings as l join loop_body_edges as r on l.loop = r.parent and l.file = r.file;
let body_counts = group-count(from=loop_body_items, keys=["loop", "file"], count="count", distinct="statement");
let single_body_loop_ids = select loop, file from body_counts where count = 1;
let single_body_items = select l.loop as loop, l.file as file, l.statement as statement from loop_body_items as l join single_body_loop_ids as r on l.loop = r.loop and l.file = r.file;
let single_body_loops = select l.loop as loop, l.file as file, l.statement as statement, r.binding as target_binding from single_body_items as l join loop_bindings as r on l.loop = r.loop and l.file = r.file;
let expression_values = select parent, child, file from "semantic-child" where field = "value";
let all_body_calls = select l.loop as loop, l.file as file, l.target_binding as target_binding, r.child as call from single_body_loops as l join expression_values as r on l.statement = r.parent and l.file = r.file;
let expression_statements = select id, file from "semantic-syntax" where kind = "expr";
let expression_body_loops = select l.loop as loop, l.file as file from single_body_loops as l join expression_statements as r on l.statement = r.id and l.file = r.file;
let body_calls = select l.loop as loop, l.file as file, l.target_binding as target_binding, l.call as call from all_body_calls as l join expression_body_loops as r on l.loop = r.loop and l.file = r.file;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let call_functions = select parent, child, file from "semantic-child" where field = "func";
let call_attributes = select l.call as call, l.file as file, l.target_binding as target_binding, r.child as attribute from body_calls as l join call_functions as r on l.call = r.parent and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child, file from "semantic-child" where field = "value";
let attribute_bases = select l.call as call, l.file as file, l.target_binding as target_binding, r.child as receiver from call_attributes as l join attribute_values as r on l.attribute = r.parent and l.file = r.file;
let names = select id, file from "semantic-syntax" where kind = "name";
let name_receivers = select l.call as call, l.file as file, l.target_binding as target_binding, r.id as receiver from attribute_bases as l join names as r on l.receiver = r.id and l.file = r.file;
let attribute_name_edges = select parent, child, file from "semantic-child" where field = "attr";
let attribute_name_nodes = select l.call as call, l.file as file, l.target_binding as target_binding, r.child as attr_name from call_attributes as l join attribute_name_edges as r on l.attribute = r.parent and l.file = r.file;
let attribute_names = select l.call as call, l.file as file, l.target_binding as target_binding, r.receiver as receiver, l.attr_name as attr_name from attribute_name_nodes as l join name_receivers as r on l.call = r.call and l.file = r.file;
let identifiers = select id, name, file from "identifier";
let append_calls = select l.call as call, l.file as file, l.target_binding as target_binding, l.receiver as receiver from attribute_names as l join identifiers as r on l.attr_name = r.id and l.file = r.file where r.name = "append" or r.name = "insert";
let call_argument_wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file where r.kind = "call-arguments";
let positional_arguments = select parent, child, file from "semantic-child" where field = "args";
let call_arguments = select l.call as call, l.file as file, r.child as argument from call_argument_wrappers as l join positional_arguments as r on l.wrapper = r.parent and l.file = r.file;
let argument_counts = group-count(from=call_arguments, keys=["call", "file"], count="count", distinct="argument");
let one_argument_call_ids = select l.call as call, l.file as file from append_calls as l join argument_counts as c on l.call = c.call and l.file = c.file where c.count = 1;
let one_argument_calls = select l.call as call, l.file as file, l.target_binding as target_binding, l.receiver as receiver, r.argument as argument from append_calls as l join call_arguments as r on l.call = r.call and l.file = r.file;
let only_one_arg_calls = select l.call as call, l.file as file, l.target_binding as target_binding, l.receiver as receiver, l.argument as argument from one_argument_calls as l join one_argument_call_ids as r on l.call = r.call and l.file = r.file;
let argument_reads = select l.call as call, l.file as file, l.target_binding as target_binding, l.receiver as receiver, r.binding as binding from only_one_arg_calls as l join "binding-use" as r on l.argument = r.reference and l.file = r.file;
let matching_loop_target = select l.call as call, l.file as file, l.receiver as receiver from argument_reads as l join loop_bindings as r on l.file = r.file and l.target_binding = r.binding where l.binding = r.binding;
let receiver_reads = select l.call as call, l.file as file, l.receiver as receiver, r.binding as binding from append_calls as l join "binding-use" as r on l.receiver = r.reference and l.file = r.file;
let same_receiver = select l.call as call, l.file as file, l.receiver as receiver, l.binding as receiver_binding from receiver_reads as l join argument_reads as r on l.call = r.call and l.file = r.file;
let receiver_references = select receiver as reference, file from same_receiver;
let typed_receivers = binding_type(references=receiver_references, builtin="builtins.list", typing="List", atom="list");
let initialized_receivers = select l.call as call, l.file as file, l.receiver as receiver from same_receiver as l join typed_receivers as r on l.receiver = r.reference and l.file = r.file;
let keyword_wrappers = select l.call as call, l.file as file, r.child as keyword from call_argument_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_free_receivers = antijoin(left=initialized_receivers, right=keyword_wrappers, left-on=["call","file"], right-on=["call","file"]);
let reportable_calls = select l.call as id, l.file as file, r.span as span from keyword_free_receivers as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable_calls as l join "source-location" as r on l.id = r.id and l.file = r.file;
let located_matches = observation_matches(candidates=candidate_locations, codes="^(?:PERF402)$");
let located_rows = select id, file, span from candidate_locations;
let located = antijoin(left=located_rows, right=located_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from located_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PERF402"});
observe ruf100_used as noqa_matches;
emit located subject file key(id);
