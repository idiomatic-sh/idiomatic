import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let scope_edges = select child, parent from "scope";
let class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let class_methods = select l.child as function, r.file as file from scope_edges as l join class_nodes as r on l.parent = r.id;
let name_edges = select parent as function, child as name from "semantic-child" where field = "name";
let method_functions = select l.function as function, l.file as file from class_methods as l join functions as r on l.function = r.id and l.file = r.file;
let method_names = select l.function as function, r.name as name, l.file as file from method_functions as l join name_edges as r on l.function = r.function;
let named_methods = select l.function as function, r.name as name, r.id as name_id, r.span as name_span, l.file as file from method_names as l join "identifier" as r on l.name = r.id;
let target_methods = select l.function as function, l.file as file, l.name_id as name_id, l.name_span as name_span from named_methods as l where l.name = "__bool__";
let method_terminals = select l.function as function, l.file as file, r.outcome as outcome from target_methods as l join "function-terminal" as r on l.function = r.id and l.file = r.file;
let active_methods = select function, file from method_terminals where outcome != "raise";
let implicit_methods = select function, file from method_terminals where outcome = "implicit";
let return_nodes = select id, file, span from "semantic-syntax" where kind = "return";
let return_functions = axis(from=return_nodes, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let method_returns = select l.id as return_stmt, l.file as file, l.span as return_span, r.related as function from return_nodes as l join return_functions as r on l.id = r.id and l.file = r.file;
let target_returns = select l.return_stmt as id, l.file as file, l.return_span as span from method_returns as l join active_methods as r on l.function = r.function and l.file = r.file;
let value_fields = select parent, child from "semantic-child" where field = "value";
let explicit_values = select l.id as return_stmt, r.child as value, l.file as file from target_returns as l join value_fields as r on l.id = r.parent;
let empty_returns = antijoin(left=target_returns, right=explicit_values, left-on=["id", "file"], right-on=["return_stmt", "file"]);
let typed_values = select l.value as id, l.file as file, r.resolution as resolution, r.type as type from explicit_values as l join "expression-type" as r on l.value = r.id and l.file = r.file;
let bad_atoms = select id, file from typed_values where resolution = "atom" and type != "boolean";
let union_members = select id, file, type from typed_values where resolution = "union";
let union_groups = group-count(from=union_members, keys=["id", "file"], count="members", distinct="type");
let union_types = select id, file from union_groups;
let type_errors = select id, file from typed_values where resolution = "type-error";
let atom_and_union = union(left=bad_atoms, right=union_types);
let bad_type_values = union(left=atom_and_union, right=type_errors);
let value_nodes = select id, file, span from "semantic-syntax";
let bad_typed_values = select l.value as id, l.file as file from explicit_values as l join bad_type_values as r on l.value = r.id and l.file = r.file;
let bad_typed_returns = select l.id as id, l.file as file, r.span as span from bad_typed_values as l join value_nodes as r on l.id = r.id and l.file = r.file;
let all_bad_returns = select id, file, span from bad_typed_returns;
let bad_returns = select id, file, span from all_bad_returns;
let explicit_candidates = union(left=empty_returns, right=bad_returns);
let body_fields = select parent, child from "semantic-child" where field = "body";
let pass_nodes = select id from "semantic-syntax" where kind = "pass";
let pass_bodies = select l.parent as parent, l.child as child from body_fields as l join pass_nodes as r on l.child = r.id;
let expr_nodes = select id, file from "semantic-syntax" where kind = "expr";
let body_exprs = select l.parent as function, l.child as expression, r.file as file from body_fields as l join expr_nodes as r on l.child = r.id;
let expr_values = select l.function as function, l.expression as expression, l.file as file, r.child as value from body_exprs as l join value_fields as r on l.expression = r.parent;
let stub_literal_values = select id, file from "literal-properties" where kind = "string" or kind = "ellipsis";
let stub_expression_literals = select l.function as function, l.file as file, l.expression as child from expr_values as l join stub_literal_values as r on l.value = r.id and l.file = r.file;
let stub_expr_bodies = select function as parent, child from stub_expression_literals;
let stub_bodies = union(left=pass_bodies, right=stub_expr_bodies);
let body_counts = group-count(from=body_fields, keys=["parent"], count="count", distinct="child");
let stub_counts = group-count(from=stub_bodies, keys=["parent"], count="count", distinct="child");
let all_stub_functions = select l.parent as function from body_counts as l join stub_counts as r on l.parent = r.parent where l.count = r.count;
let implicit_candidates_pre_stub = select r.name_id as id, r.file as file, r.name_span as span, l.function as function from implicit_methods as l join target_methods as r on l.function = r.function and l.file = r.file;
let implicit_non_stub = antijoin(left=implicit_candidates_pre_stub, right=all_stub_functions, left-on=["function"], right-on=["function"]);
let implicit_candidates = select id, file, span from implicit_non_stub;
let candidates = union(left=explicit_candidates, right=implicit_candidates);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE0304(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE0304)(?:,|$)");
emit violations subject file key(id);
