import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let assignments = select id, file, span from "semantic-syntax" where kind = "assign" and matches(file, "\.pyi$");
let targets = select parent, child from "semantic-child" where field = "targets";
let counts = group-count(from=targets, keys=["parent"], count="count", distinct="child");
let singles = select parent from counts where count = 1;
let names = select id from "semantic-syntax" where kind = "name";
let name_targets = select l.parent as parent from targets as l join names as r on l.child = r.id;
let simple = select l.parent as parent from singles as l join name_targets as r on l.parent = r.parent;
let reportable = antijoin(left=assignments, right=simple, left-on=["id"], right-on=["parent"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI017(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI017)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI017)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI017)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI017"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
