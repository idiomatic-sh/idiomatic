import observation_matches from "python/ruff/suppress-matches";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let raises_functions = select id from "qualified-name" where path = "pytest.raises";
let raises_calls = select l.call as call, l.function as function from call_functions as l join raises_functions as r on l.function = r.id;
let call_argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_wrappers = select l.parent as call, r.id as arguments from "semantic-child" as l join call_argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, r.ordinal as ordinal from argument_wrappers as l join positional_fields as r on l.arguments = r.parent;
let later_positionals = select l.argument as argument from positional_arguments as l join positional_arguments as r on l.call = r.call where l.ordinal > r.ordinal;
let first_by_rank = antijoin(left=positional_arguments, right=later_positionals, left-on=["argument"], right-on=["argument"]);
let first_positional = select call from first_by_rank;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_occurrences = select l.call as call, r.child as keyword from argument_wrappers as l join keyword_fields as r on l.arguments = r.parent;
let keyword_name_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_name_wrappers = select l.call as call, l.keyword as keyword, r.child as wrapper from keyword_occurrences as l join keyword_name_fields as r on l.keyword = r.parent;
let keyword_name_tokens = select l.call as call, l.keyword as keyword, r.child as token from keyword_name_wrappers as l join "semantic-child" as r on l.wrapper = r.parent;
let identifier_tokens = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select l.id as id, l.text as text from identifier_tokens as l join name_tokens as r on l.id = r.id;
let keyword_names = select l.call as call, l.keyword as keyword, r.text as name from keyword_name_tokens as l join identifiers as r on l.token = r.id;
let named_expected = select call from keyword_names where name = "expected_exception";
let exception_arguments = union(left=first_positional,right=named_expected);
let without_exception = antijoin(left=raises_calls,right=exception_arguments,left-on=["call"],right-on=["call"]);
let match_or_check = select call from keyword_names where name = "match" or name = "check";
let eligible_calls = antijoin(left=without_exception,right=match_or_check,left-on=["call"],right-on=["call"]);
let reportable = select l.function as id, r.file as file, r.span as span from eligible_calls as l join "semantic-syntax" as r on l.function = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PT010)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PT010"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
