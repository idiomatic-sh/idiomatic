import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for";
let targets = select parent, child, file from "semantic-child" where field = "target";
let loop_targets = select l.id as loop, l.file as file, r.child as target from loops as l join targets as r on l.id = r.parent and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_targets = select l.loop as loop, l.file as file, r.id as target from loop_targets as l join tuples as r on l.target = r.id and l.file = r.file;
let element_fields = select parent, child, file from "semantic-child" where field = "elts";
let elements = select l.loop as loop, l.file as file, r.child as element from tuple_targets as l join element_fields as r on l.target = r.parent and l.file = r.file;
let element_counts = group-count(from=elements, keys=["loop", "file"], count="count", distinct="element");
let pairs = select l.loop as loop, l.file as file, l.element as element from elements as l join element_counts as r on l.loop = r.loop and l.file = r.file where r.count = 2;
let tuple_edges = select l.id as source, r.child as destination, l.file as file from tuples as l join element_fields as r on l.id = r.parent and l.file = r.file;
let tuple_paths = closure(edges=tuple_edges, source="source", destination="destination", keys=["file"]);
let names = select id, file from nodes where kind = "name";
let binding_events = select occurrence as binding, name, scope, ordinal, file from "binding-event" where kind = "bind";
let located_events = select l.binding as binding, l.name as name, l.scope as scope, l.ordinal as ordinal, l.file as file, r."start-byte" as begin from binding_events as l join "source-location" as r on l.binding = r.id and l.file = r.file;
let target_events = select l.id as id, l.file as file, r.name as name, r.scope as scope, r.ordinal as ordinal, r.begin as begin from names as l join located_events as r on l.id = r.binding and l.file = r.file;
let used_bindings = select binding, file from "binding-use";
let used_events = select l.name as name, l.scope as scope, l.file as file, l.begin as begin from located_events as l join used_bindings as r on l.binding = r.binding and l.file = r.file;
let used_names = select l.id as id, l.file as file from target_events as l join used_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.begin >= l.begin;
let used_references = select l.binding as binding, l.file as file, r."start-byte" as point from "binding-use" as l join "source-location" as r on l.reference = r.id and l.file = r.file;
let prior_reference_events = select l.name as name, l.scope as scope, l.file as file, l.ordinal as binding_ordinal, l.begin as binding_begin, r.point as point from located_events as l join used_references as r on l.binding = r.binding and l.file = r.file;
let copied_reference_candidates = select l.id as id, l.name as name, l.scope as scope, l.file as file, l.ordinal as ordinal, l.begin as begin, r.binding_ordinal as binding_ordinal, r.binding_begin as binding_begin from target_events as l join prior_reference_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.point < l.begin and r.binding_begin < l.begin;
let deletion_events = select name, scope, ordinal, file from "binding-event" where kind = "delete" or kind = "cleanup";
let broken_copies = select l.id as id, l.file as file, l.binding_begin as binding_begin from copied_reference_candidates as l join deletion_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.binding_ordinal < r.ordinal and r.ordinal < l.ordinal;
let effective_copies = antijoin(left=copied_reference_candidates, right=broken_copies, left-on=["id","file","binding_begin"], right-on=["id","file","binding_begin"]);
let copied_used_names = select id, file from effective_copies;
let all_used_names = union(left=used_names, right=copied_used_names);
let unused_names = antijoin(left=names, right=all_used_names, left-on=["id","file"], right-on=["id","file"]);
let nonnames = antijoin(left=nodes, right=names, left-on=["id","file"], right-on=["id","file"]);
let bad_nonname_rows = antijoin(left=nonnames, right=tuples, left-on=["id","file"], right-on=["id","file"]);
let bad_nonname_members = select id, file from bad_nonname_rows;
let bad_name_members = antijoin(left=names, right=unused_names, left-on=["id","file"], right-on=["id","file"]);
let bad_members = union(left=bad_nonname_members, right=bad_name_members);
let bad_tuples = select l.source as id, l.file as file from tuple_paths as l join bad_members as r on l.destination = r.id and l.file = r.file;
let unused_tuples = antijoin(left=tuples, right=bad_tuples, left-on=["id","file"], right-on=["id","file"]);
let unused_expressions = union(left=unused_names, right=unused_tuples);
let unused_pair_items = select l.loop as loop, l.file as file, l.element as element from pairs as l join unused_expressions as r on l.element = r.id and l.file = r.file;
let unused_counts = group-count(from=unused_pair_items, keys=["loop","file"], count="unused_count", distinct="element");
let eligible_pairs = select loop, file from unused_counts where unused_count = 1;
let identifiers = select id, name, file from "identifier";
let loop_iter_fields = select parent, child, file from "semantic-child" where field = "iter";
let iterators = select l.loop as loop, l.file as file, r.child as iterator from eligible_pairs as l join loop_iter_fields as r on l.loop = r.parent and l.file = r.file;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let iterator_calls = select l.loop as loop, l.file as file, r.id as call from iterators as l join calls as r on l.iterator = r.id and l.file = r.file;
let functions = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.call as call, l.file as file, r.child as function from iterator_calls as l join functions as r on l.call = r.parent and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_functions = select l.call as call, l.file as file, r.id as attribute from call_functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attribute_names = select parent, child, file from "semantic-child" where field = "attr";
let named_attributes = select l.call as call, l.file as file, l.attribute as attribute, r.child as name from attribute_functions as l join attribute_names as r on l.attribute = r.parent and l.file = r.file;
let items_names = select l.call as call, l.file as file, l.attribute as attribute from named_attributes as l join identifiers as r on l.name = r.id and l.file = r.file where r.name = "items";
let call_arguments = select parent as call, child as wrapper, file from "semantic-child";
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, l.file as file, r.id as wrapper from call_arguments as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let positional_arguments = select parent, child, file from "semantic-child" where field = "args";
let supplied_arguments = select l.call as call, l.file as file, r.child as argument from call_wrappers as l join positional_arguments as r on l.wrapper = r.parent and l.file = r.file;
let calls_with_args = select call, file from supplied_arguments;
let no_arguments = antijoin(left=items_names, right=calls_with_args, left-on=["call", "file"], right-on=["call", "file"]);
let locations = select l.attribute as id, l.file as file, r.span as span from no_arguments as l join "source-location" as r on l.attribute = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from locations as l join "source-location" as r on l.id = r.id and l.file = r.file;
let located_matches = observation_matches(candidates=candidate_locations, codes="^(?:PERF102)$");
let located_rows = select id, file, span from candidate_locations;
let located = antijoin(left=located_rows, right=located_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from located_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PERF102"});
observe ruf100_used as noqa_matches;
emit located subject file key(id);
