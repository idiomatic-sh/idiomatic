import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let qnames = select id, file from "qualified-name" where path = "sys.version";
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let value_fields = select parent, child from "semantic-child" where field = "value";
let values = select l.parent as subscript, l.child as value, r.file as file from value_fields as l join subscripts as r on l.parent = r.id;
let target_subscripts = select l.subscript as subscript, l.file as file from values as l join qnames as r on l.value = r.id and l.file = r.file;
let slice_fields = select parent, child from "semantic-child" where field = "slice";
let indices = select l.parent as subscript, l.child as index, r.file as file from slice_fields as l join target_subscripts as r on l.parent = r.subscript;
let index_literals = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let indexed = select l.subscript as id, l.file as file from indices as l join index_literals as r on l.index = r.id and l.file = r.file;
let selected_subscripts = select r.subscript as subscript, l.file as file from indexed as l join target_subscripts as r on l.id = r.subscript and l.file = r.file;
let selected_values = select r.value as id, l.file as file from selected_subscripts as l join values as r on l.subscript = r.subscript and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from selected_values as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*YTT301(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:YTT301)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:YTT301)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:YTT301)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "YTT301"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
