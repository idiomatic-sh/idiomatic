let handlers = select * from "syntax-tree" where kind = "except-handler";
let typed = select parent from "syntax-child" where field = "type";
let bare = antijoin(left=handlers, right=typed, left-on=["id"], right-on=["parent"]);
let raises = select id from "syntax-tree" where kind = "raise";
let raised_values = select parent from "syntax-child" where field = "exc";
let reraises = antijoin(left=raises, right=raised_values, left-on=["id"], right-on=["parent"]);
let bodies = select parent, child from "syntax-child" where field = "body";
let reraising_handlers = select l.parent as parent from bodies as l join reraises as r on l.child = r.id;
let reportable = antijoin(left=bare, right=reraising_handlers, left-on=["id"], right-on=["parent"]);
let children = select r.child as child from reportable as l join "syntax-child" as r on l.id = r.parent;
let keywords = select * from "syntax-tree" where kind = "name-token" and text = "except";
let keywords_to_report = select r.id as id, r.file as file, r.span as span from children as l join keywords as r on l.child = r.id;
let located = select l.id as id, l.file as file, l.span as span, r."start-line" as line from keywords_to_report as l join "source-location" as r on l.id = r.id;
let inline_noqa = select * from "comment" where matches(text, "(?:^|#)\s*(?i:noqa)(?:$|#|\s+(?:$|[^:\s]))") or matches(text, "(?:^|#)\s*(?i:noqa)\s*:\s*(?:[A-Z]+[0-9]+[\s,]*)*E722(?:$|[\s,#]|[A-Z])");
let line_suppressions = select l.file as file, r."start-line" as line from inline_noqa as l join "source-location" as r on l.id = r.id;
let file_noqa = select * from "comment" where matches(text, "(?:^|#)\s*(?:ruff|flake8)\s*:\s*(?i:noqa)(?:$|#|\s+(?:$|[^:\s]))") or matches(text, "(?:^|#)\s*(?:ruff|flake8)\s*:\s*(?i:noqa)\s*:\s*(?:[A-Z]+[0-9]+[\s,]*)*E722(?:$|[\s,#]|[A-Z])");
let file_directives = select l.file as file, r."start-line" as line from file_noqa as l join "source-location" as r on l.id = r.id;
let code_tokens = select id from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let code_lines = select r.file as file, r."start-line" as line from code_tokens as l join "source-location" as r on l.id = r.id;
let standalone = antijoin(left=file_directives, right=code_lines, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_lines = antijoin(left=located, right=line_suppressions, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_files = antijoin(left=unsuppressed_lines, right=standalone, left-on=["file"], right-on=["file"]);
let violations = select file, span from unsuppressed_files;
emit violations subject file key(span);
