import observation_matches from "python/ruff/suppress-matches";
let handlers = select * from "semantic-syntax" where kind = "except-handler";
let typed = select parent from "semantic-child" where field = "type";
let bare = antijoin(left=handlers, right=typed, left-on=["id"], right-on=["parent"]);
let raises = select id from "semantic-syntax" where kind = "raise";
let raised_values = select parent from "semantic-child" where field = "exc";
let reraises = antijoin(left=raises, right=raised_values, left-on=["id"], right-on=["parent"]);
let bodies = select parent, child from "semantic-child" where field = "body";
let reraising_handlers = select l.parent as parent from bodies as l join reraises as r on l.child = r.id;
let reportable = antijoin(left=bare, right=reraising_handlers, left-on=["id"], right-on=["parent"]);
let children = select r.child as child from reportable as l join "semantic-child" as r on l.id = r.parent;
let keywords = select * from "semantic-syntax" where kind = "name-token" and text = "except";
let keywords_to_report = select r.id as id, r.file as file, r.span as span from children as l join keywords as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from keywords_to_report as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:E722)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "E722"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
