import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let statements = select * from "semantic-syntax" where kind = "break";
let loops = select id from "semantic-syntax" where kind = "for" or kind = "async-for" or kind = "while";
let body_edges = select parent, child from "semantic-child" where field = "body";
let loop_bodies = select r.child as id from loops as l join body_edges as r on l.id = r.parent;
let non_boundaries = select id from "semantic-syntax" where kind != "function-def" and kind != "async-function-def" and kind != "class-def" and kind != "lambda";
let body_nodes = select l.id as id from loop_bodies as l join non_boundaries as r on l.id = r.id;
let scope_nodes = select id from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let boundaries = union(left=body_nodes, right=scope_nodes);
let ancestors = axis(from=statements, relation="semantic-child", direction=nearest-ancestor, domain=boundaries);
let valid_nested = select l.id as id from ancestors as l join body_nodes as r on l.related = r.id;
let valid_direct = select l.id as id from statements as l join body_nodes as r on l.id = r.id;
let valid = union(left=valid_nested, right=valid_direct);
let invalid = antijoin(left=statements, right=valid, left-on=["id"], right-on=["id"]);
let reportable = select id, file, span from invalid;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F701(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F701)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F701(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F701)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "F701"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
