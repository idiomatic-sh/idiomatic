import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let decorators = select id, file, span from "syntax-tree" where kind = "decorator";
let singledispatch_names = select id, file from "qualified-name" where path = "functools.singledispatch";
let decorator_axes = axis(from=singledispatch_names, relation="syntax-child", direction=ancestor, domain=decorators);
let target_decorator_rows = select l.id as expression, r.related as decorator, l.file as file from singledispatch_names as l join decorator_axes as r on l.id = r.id;
let function_axes = axis(from=decorators, relation="syntax-child", direction=ancestor, domain=functions);
let decorator_functions = select l.id as decorator, r.related as function, l.file as file, l.span as span from decorators as l join function_axes as r on l.id = r.id and l.file = r.file;
let target_functions = select l.decorator as decorator, l.function as function, l.file as file, l.span as span from decorator_functions as l join target_decorator_rows as r on l.decorator = r.decorator and l.file = r.file;
let scope_edges = select child, parent from "scope";
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let function_parent_scopes = select l.child as function, l.parent as parent, r.file as file from scope_edges as l join functions as r on l.child = r.id;
let methods = select l.function as function, l.file as file from function_parent_scopes as l join class_scopes as r on l.parent = r.id and l.file = r.file;
let new_name_fields = select parent, child from "semantic-child" where field = "name";
let function_name_edges = select l.id as function, r.child as name, l.file as file from functions as l join new_name_fields as r on l.id = r.parent;
let named_functions = select l.function as function, r.name as name, l.file as file from function_name_edges as l join "identifier" as r on l.name = r.id;
let new_functions = select function, file from named_functions where name = "__new__";
let ordinary_methods = antijoin(left=methods,right=new_functions,left-on=["function","file"],right-on=["function","file"]);
let method_decorators = select l.decorator as id, l.file as file, l.span as span from target_functions as l join ordinary_methods as r on l.function = r.function and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from method_decorators as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1519(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1519)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1519(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1519)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE1519"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
