import suppress from "python/ruff/suppress";
let imported = select occurrence as id, target, file, span from "static-import";
let exact_path = select id, file, span from imported where target = "xml.etree.cElementTree";
let asnames = select parent from "semantic-child" where field = "asname";
let aliased = select l.id as id, l.file as file, l.span as span from exact_path as l join asnames as r on l.id = r.parent;
let members = select id from imported where matches(target, "^xml\.etree\.cElementTree\.");
let names = select parent, child from "semantic-child" where field = "name";
let star_tokens = select id from "semantic-syntax" where text = "*";
let star_identifiers = select l.parent as parent from "semantic-child" as l join star_tokens as r on l.child = r.id;
let star_aliases = select l.parent as id from names as l join star_identifiers as r on l.child = r.parent;
let wildcard = select l.id as id from exact_path as l join star_aliases as r on l.id = r.id;
let imported_members = union(left=members, right=wildcard);
let parents = select l.parent as parent from "semantic-child" as l join imported_members as r on l.child = r.id;
let from_imports = select id, file, span from "semantic-syntax" where kind = "import-from";
let statements = select l.id as id, l.file as file, l.span as span from from_imports as l join parents as r on l.id = r.parent;
let reportable = union(left=aliased, right=statements);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP023(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP023)(?:,|$)");
emit violations subject file key(id);
