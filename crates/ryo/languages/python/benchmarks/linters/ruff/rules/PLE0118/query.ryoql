import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let scope_nodes = select child as id, file from "scope";
let scope_bodies = select l.id as owner, l.file as file, r.child as id from scope_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let comp_scopes = select id, file from nodes where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let comp_roots = select id as owner, file, id from comp_scopes;
let evaluation_roots = union(left=scope_bodies, right=comp_roots);
let events = select occurrence as id, name, scope, kind, file from "binding-event";
let raw_uses = select l.id as id, l.name as name, l.scope as scope, l.kind as kind, l.file as file from events as l join names as r on l.id = r.id and l.file = r.file where l.kind = "read" or l.kind = "bind" or l.kind = "annotation" or l.kind = "delete";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_types = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let return_types = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let classes = select id, file from nodes where kind = "class-def";
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_children = select r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_headers = select l.id as id, l.file as file from class_children as l join argument_nodes as r on l.id = r.id and l.file = r.file;
let type_roots_a = union(left=parameter_types, right=return_types);
let type_roots = union(left=type_roots_a, right=class_headers);
let embedded_roots = select root as id, file from "embedded-expression";
let excluded_roots = union(left=type_roots, right=embedded_roots);
let excluded_descendants = axis(from=excluded_roots, relation="semantic-child", direction=descendant, domain=raw_uses);
let excluded_uses_a = select related as id, file from excluded_descendants;
let excluded_uses_b = select l.id as id, l.file as file from excluded_roots as l join raw_uses as r on l.id = r.id and l.file = r.file;
let excluded_uses = union(left=excluded_uses_a, right=excluded_uses_b);
let prior_uses = antijoin(left=raw_uses, right=excluded_uses, left-on=["id","file"], right-on=["id","file"]);
let read_uses = select id, name, scope, file from prior_uses where kind = "read";
let other_uses = select id, name, file from prior_uses where kind != "read";
let nearest_roots = axis(from=other_uses, relation="semantic-child", direction=nearest-ancestor, domain=evaluation_roots);
let body_uses = select l.id as id, l.name as name, r.owner as scope, l.file as file from nearest_roots as l join evaluation_roots as r on l.related = r.id and l.file = r.file;
let self_body_uses = select l.id as id, l.name as name, r.owner as scope, l.file as file from other_uses as l join evaluation_roots as r on l.id = r.id and l.file = r.file;
let other_lexical_uses = union(left=body_uses, right=self_body_uses);
let lexical_uses = union(left=read_uses, right=other_lexical_uses);
let raw_globals = select id, name, file from events where kind = "global";
let global_owners = axis(from=raw_globals, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let globals = select id, name, related as scope, file from global_owners;
let located_globals = select l.name as name, l.scope as scope, l.file as file, r."start-byte" as point from globals as l join "source-location" as r on l.id = r.id and l.file = r.file;
let located_uses = select l.id as id, l.name as name, l.scope as scope, l.file as file, r.span as span, r."start-byte" as point, r."start-line" as line from lexical_uses as l join "source-location" as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, l.span as span, l.line as line from located_uses as l join located_globals as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.point < r.point;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE0118(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE0118)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLE0118)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLE0118)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE0118"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
