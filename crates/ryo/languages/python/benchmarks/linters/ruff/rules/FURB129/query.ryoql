import observation_matches from "python/ruff/suppress-matches";
import io_base_initializer from "python/ruff/io-base-initializer";
import io_base_binding from "python/ruff/io-base-binding";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for" or kind = "comprehension";
let iter_fields = select parent, child, file from "semantic-child" where field = "iter";
let iterators = select r.child as id, l.file as file from loops as l join iter_fields as r on l.id = r.parent and l.file = r.file;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let iterator_calls = select l.id as call, l.file as file from iterators as l join calls as r on l.id = r.id and l.file = r.file;
let calls_with_arguments = select call, file from "call-argument";
let empty_calls = antijoin(left=iterator_calls, right=calls_with_arguments, left-on=["call","file"], right-on=["call","file"]);
let functions = select parent, child, file from "semantic-child" where field = "func";
let callees = select l.call as call, r.child as function, l.file as file from empty_calls as l join functions as r on l.call = r.parent and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let attr_callees = select l.call as call, l.function as attribute, l.file as file from callees as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let attr_labels = select l.call as call, l.attribute as attribute, r.child as label, l.file as file from attr_callees as l join attr_fields as r on l.attribute = r.parent and l.file = r.file;
let readlines_calls = select l.call as call, l.attribute as attribute, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "readlines";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let receivers = select l.call as call, r.child as receiver, l.file as file from readlines_calls as l join value_fields as r on l.attribute = r.parent and l.file = r.file;
let names = select id, file from nodes where kind = "name";
let named_receivers = select l.receiver as reference, l.file as file from receivers as l join names as r on l.receiver = r.id and l.file = r.file;
let bound_receivers = io_base_binding(references=named_receivers);
let receiver_expressions = select receiver as id, file from receivers;
let direct_receivers = io_base_initializer(expressions=receiver_expressions);
let named_io = select reference as id, file from bound_receivers;
let io_receivers = union(left=named_io, right=direct_receivers);
let matched = select l.call as id, l.file as file from receivers as l join io_receivers as r on l.receiver = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from matched as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:FURB129)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB129"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
