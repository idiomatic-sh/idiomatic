import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let import_statements = select id, file from "semantic-syntax" where kind = "import-from";
let module_fields = select parent, child, file from "semantic-child" where field = "module";
let future_module_names = select id, file from "identifier" where name = "__future__";
let future_statements = select l.parent as id, l.file as file from module_fields as l join future_module_names as r on l.child = r.id and l.file = r.file;
let import_name_fields = select parent, child, file from "semantic-child" where field = "names";
let statement_aliases = select l.parent as stmt, l.child as alias, l.file as file from import_name_fields as l join import_statements as r on l.parent = r.id and l.file = r.file;
let alias_nodes = select id, file from "semantic-syntax" where kind = "alias";
let checked_statement_aliases = select l.stmt as stmt, l.alias as alias, l.file as file from statement_aliases as l join alias_nodes as r on l.alias = r.id and l.file = r.file;
let future_aliases = select l.stmt as stmt, l.alias as alias, l.file as file from checked_statement_aliases as l join future_statements as r on l.stmt = r.id and l.file = r.file;
let level_fields = select parent as stmt, file from "semantic-child" where field = "level";
let relative_future_aliases = select l.stmt as stmt, l.alias as alias, l.file as file from future_aliases as l join level_fields as r on l.stmt = r.stmt and l.file = r.file;
let name_fields = select parent, child, file from "semantic-child" where field = "name";
let feature_identifiers = select l.parent as alias, r.id as name, r.name as normalized, r.file as file, r.span as span from name_fields as l join "identifier" as r on l.child = r.id and l.file = r.file;
let relative_feature_identifiers = select l.stmt as stmt, l.alias as alias, r.name as name, r.normalized as normalized, r.file as file from relative_future_aliases as l join feature_identifiers as r on l.alias = r.alias and l.file = r.file;
let known_relative_features = select stmt, alias, file from relative_feature_identifiers where matches(normalized, "^(?:nested_scopes|generators|division|absolute_import|with_statement|print_function|unicode_literals|barry_as_FLUFL|generator_stop|annotations)$");
let unknown_relative_features = antijoin(left=relative_feature_identifiers,right=known_relative_features,left-on=["alias","file"],right-on=["alias","file"]);
let unknown_relative_alias_nodes = select l.alias as id, l.file as file, r.span as span from unknown_relative_features as l join "semantic-syntax" as r on l.alias = r.id and l.file = r.file;
let unknown_relative_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from unknown_relative_alias_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let future_statement_ranges = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from future_statements as l join "source-location" as r on l.id = r.id and l.file = r.file;
let star_tokens = select id, file from "syntax-tree" where text = "*";
let star_ranges = select l.id as id, l.file as file, r.span as span, r."start-byte" as begin, r."end-byte" as finish, r."start-line" as line from star_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let future_star_tokens = select l.id as statement, l.file as file, r.id as star from future_statement_ranges as l join star_ranges as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let future_wildcard_candidates = select l.star as id, l.file as file, r.span as span, r.line as line from future_star_tokens as l join star_ranges as r on l.star = r.id and l.file = r.file;
let f407_errors = select id, file, span from "syntax-error" where code = "future-feature-not-defined" and phase = "validation" and impact = "preserved";
let error_ranges = select l.id as error, l.file as file, r."start-byte" as begin, r."end-byte" as finish from f407_errors as l join "source-location" as r on l.file = r.file and l.span = r.span;
let imported_name_ranges = select l.name as name, l.alias as alias, l.file as file, r."start-byte" as begin, r."end-byte" as finish from feature_identifiers as l join "source-location" as r on l.name = r.id and l.file = r.file;
let typed_name_hits = select l.error as error, r.alias as alias, r.file as file from error_ranges as l join imported_name_ranges as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let typed_future_aliases = select l.alias as alias, l.file as file from typed_name_hits as l join future_aliases as r on l.alias = r.alias and l.file = r.file;
let typed_future_alias_nodes = select l.alias as id, l.file as file, r.span as span from typed_future_aliases as l join "semantic-syntax" as r on l.alias = r.id and l.file = r.file;
let typed_name_candidates = select l.id as id, l.file as file, l.span as span, r."start-line" as line from typed_future_alias_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let typed_future_candidates = select id, file, span, line from typed_name_candidates;
let relative_union = union(left=unknown_relative_locations,right=future_wildcard_candidates);
let typed_candidate_ids = select id, file from typed_future_candidates;
let relative_candidates = antijoin(left=relative_union,right=typed_candidate_ids,left-on=["id","file"],right-on=["id","file"]);
let candidate_locations = union(left=relative_candidates,right=typed_future_candidates);
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F407(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F407)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:F407)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F407)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "F407"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
