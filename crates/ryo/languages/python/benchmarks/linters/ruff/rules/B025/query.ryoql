import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let handlers = select id from "semantic-syntax" where kind = "except-handler";
let types = select parent, child from "semantic-child" where field = "type";
let handled = select l.id as handler, r.child as child from handlers as l join types as r on l.id = r.parent;
let simple = select l.handler as handler, r.occurrence as id, r.target as target, r.file as file, r.span as span from handled as l join "reference" as r on l.child = r.occurrence;
let simple_positions = extend(from=simple, values={position: 0});
let tuples = select id from "semantic-syntax" where kind = "tuple";
let exception_tuples = select l.handler as handler, r.id as id from handled as l join tuples as r on l.child = r.id;
let elements = select parent, child, ordinal from "semantic-child" where field = "elts";
let named_elements = select l.parent as parent, l.ordinal as position, r.occurrence as id, r.target as target, r.file as file, r.span as span from elements as l join "reference" as r on l.child = r.occurrence;
let tuple_members = select l.handler as handler, r.id as id, r.target as target, r.file as file, r.span as span, r.position as position from exception_tuples as l join named_elements as r on l.id = r.parent;
let all_types = union(left=simple_positions, right=tuple_members);
let later_members = select l.id as id from all_types as l join all_types as r on l.handler = r.handler and l.target = r.target where l.position > r.position;
let first_members = antijoin(left=all_types, right=later_members, left-on=["id"], right-on=["id"]);
let positions = select parent, child, ordinal from "semantic-child" where field = "handlers";
let positioned = select l.id as id, l.target as target, l.file as file, l.span as span, r.parent as parent, r.ordinal as ordinal from first_members as l join positions as r on l.handler = r.child;
let reportable = select l.id as id, l.file as file, l.span as span from positioned as l join positioned as r on l.parent = r.parent and l.target = r.target where l.ordinal > r.ordinal;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B025(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B025)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:B025)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B025)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B025"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
