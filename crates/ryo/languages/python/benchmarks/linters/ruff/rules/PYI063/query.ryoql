import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let targets = select file, major, minor from "language-target" where major > 3 or major = 3 and minor >= 8;
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let function_targets = select l.id as function, l.file as file from functions as l join targets as r on l.file = r.file;
let argument_edges = select parent as function, child as arguments, file from "semantic-child" where field = "args";
let argument_nodes = select id, file from "semantic-syntax" where kind = "arguments";
let function_arguments_edges = select l.function as function, e.arguments as arguments, l.file as file from function_targets as l join argument_edges as e on l.function = e.function and l.file = e.file;
let function_arguments2 = select l.function as function, r.id as arguments, l.file as file from function_arguments_edges as l join argument_nodes as r on l.arguments = r.id and l.file = r.file;
let posonly_fields = select parent as arguments, child as parameter, file from "semantic-child" where field = "posonlyargs";
let functions_with_posonly = select l.function as function, l.file as file from function_arguments2 as l join posonly_fields as r on l.arguments = r.arguments and l.file = r.file;
let functions_without_posonly = antijoin(left=function_arguments2, right=functions_with_posonly, left-on=["function", "file"], right-on=["function", "file"]);
let raw_args = select parent as arguments, child as item, ordinal, file from "semantic-child" where field = "args";
let arg_nodes = select id, file from "semantic-syntax" where kind = "arg";
let parameter_wrappers = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let direct_args = select l.arguments as arguments, l.item as parameter, l.ordinal as ordinal, l.file as file from raw_args as l join arg_nodes as r on l.item = r.id and l.file = r.file;
let wrapper_args = select l.arguments as arguments, l.item as wrapper, l.ordinal as ordinal, l.file as file from raw_args as l join parameter_wrappers as r on l.item = r.id and l.file = r.file;
let wrapper_children = select parent as wrapper, child as parameter, file from "semantic-child";
let unwrapped_args = select l.arguments as arguments, r.parameter as parameter, l.ordinal as ordinal, l.file as file from wrapper_args as l join wrapper_children as r on l.wrapper = r.wrapper and l.file = r.file;
let unwrapped_arg_nodes = select l.arguments as arguments, l.parameter as parameter, l.ordinal as ordinal, l.file as file from unwrapped_args as l join arg_nodes as r on l.parameter = r.id and l.file = r.file;
let parameters_a = union(left=direct_args, right=unwrapped_arg_nodes);
let parameters = select l.arguments as arguments, l.parameter as parameter, l.ordinal as ordinal, l.file as file from parameters_a as l join function_arguments2 as r on l.arguments = r.arguments and l.file = r.file;
let prior_pairs = select l.arguments as arguments, l.parameter as earlier, r.parameter as later, l.file as file from parameters as l join parameters as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let prior_counts = group-count(from=prior_pairs, keys=["arguments", "later", "file"], count="count", distinct="earlier");
let later_than_one = select later as parameter, file from prior_counts where count = 1;
let second_parameters = select l.arguments as arguments, l.parameter as parameter, l.file as file from parameters as l join later_than_one as r on l.parameter = r.parameter and l.file = r.file;
let has_earlier = select l.later as parameter, l.file as file from prior_pairs as l;
let first_parameters = antijoin(left=parameters, right=has_earlier, left-on=["parameter", "file"], right-on=["parameter", "file"]);
let scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let function_scope_nodes = select function as id, file from function_targets;
let nearest_scopes = axis(from=function_scope_nodes, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let function_scope = select l.id as function, r.related as scope, l.file as file from function_scope_nodes as l join nearest_scopes as r on l.id = r.id and l.file = r.file;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_methods = select l.function as function, l.file as file from function_scope as l join class_scopes as r on l.scope = r.id and l.file = r.file;
let decorators = select parent as function, child as list, file from "semantic-child" where field = "decorator-list";
let decorator_items = select l.function as function, r.child as decorator, l.file as file from decorators as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let staticmethod_names = select id, file from "qualified-name" where path = "builtins.staticmethod" or path = "abc.abstractstaticmethod";
let staticmethod_functions = select l.function as function, l.file as file from decorator_items as l join staticmethod_names as r on l.decorator = r.id and l.file = r.file;
let methods_to_skip = antijoin(left=class_methods, right=staticmethod_functions, left-on=["function", "file"], right-on=["function", "file"]);
let first_candidates = select l.function as function, r.parameter as parameter, l.file as file from functions_without_posonly as l join first_parameters as r on l.arguments = r.arguments and l.file = r.file;
let methods_first = select l.function as function, l.file as file from first_candidates as l join methods_to_skip as r on l.function = r.function and l.file = r.file;
let second_candidates = select l.function as function, r.parameter as parameter, l.file as file from functions_without_posonly as l join second_parameters as r on l.arguments = r.arguments and l.file = r.file;
let candidate_methods = select l.function as function, l.parameter as parameter, l.file as file from second_candidates as l join methods_first as r on l.function = r.function and l.file = r.file;
let candidate_nonmethods = antijoin(left=first_candidates, right=methods_first, left-on=["function", "file"], right-on=["function", "file"]);
let candidates = union(left=candidate_methods, right=candidate_nonmethods);
let parameter_identifiers = select l.parameter as parameter, r.child as identifier, l.file as file from candidates as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "arg";
let named_parameters = select l.identifier as id, r.name as name, l.file as file from parameter_identifiers as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let private_prefix = select id, name, file from named_parameters where starts_with(name, "__");
let dunder_names = select id, file from named_parameters where ends_with(name, "__");
let private_names = antijoin(left=private_prefix, right=dunder_names, left-on=["id", "file"], right-on=["id", "file"]);
let locations = select id, file, span, "start-line" as line from "source-location";
let located = select l.id as id, l.file as file, r.span as span, r.line as line from private_names as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI063(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI063)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI063)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI063)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI063"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
