import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let arg_tokens = select l.parent as keyword, r.child as token from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let identifiers = select id, text from semantic_identifiers;
let named_keywords = select l.keyword as id, r.text as name from arg_tokens as l join identifiers as r on l.token = r.id;
let unordered_keyword_names = select l.call as call, l.id as id, r.name as name from keywords as l join named_keywords as r on l.id = r.id;
let ordered_keyword_names = select l.call as call, l.id as id, l.name as name, r."start-byte" as begin from unordered_keyword_names as l join "source-location" as r on l.id = r.id;
let later_keyword_names = select l.id as id from ordered_keyword_names as l join ordered_keyword_names as r on l.call = r.call and l.name = r.name where l.begin > r.begin;
let keyword_names = antijoin(left=unordered_keyword_names, right=later_keyword_names, left-on=["id"], right-on=["id"]);
let qualified = select id, path from qualified_names where (path = "builtins.hasattr" or path = "builtins.getattr") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let builtin_calls = select l.parent as id, r.path as path from functions as l join qualified as r on l.child = r.id;
let counts = group-count(from=positional, keys=["call"], count="count", distinct="id");
let counted = select l.id as id, l.path as path, r.count as count from builtin_calls as l join counts as r on l.id = r.call;
let arity_valid = select id from counted where count = 2 or count = 3 and path = "builtins.getattr";
let no_keywords = antijoin(left=arity_valid, right=keywords, left-on=["id"], right-on=["call"]);
let second_arguments = select call, id from positional where ordinal = 1;
let constants = select id from "semantic-syntax" where kind = "constant";
let string_values = select l.occurrence as id, l.value as value from "string-literal" as l join constants as r on l.occurrence = r.id;
let call_strings = select id from string_values where value = "__call__";
let matching_arguments = select l.call as id from second_arguments as l join call_strings as r on l.id = r.id;
let invalid = select l.id as id from no_keywords as l join matching_arguments as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from calls as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B004(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B004)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:B004)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B004)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B004"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
