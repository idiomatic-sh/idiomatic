import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import boolean_context from "python/ruff/boolean-test-context";
import in_comparison from "python/ruff/in-comparison";
import without_effect from "python/ruff/without-effect";
import type_context from "python/ruff/type-definition-context";
let nodes = select id, kind, file from "semantic-syntax";
let booleans = select id, file from nodes where kind = "bool-op";
let tested_booleans = boolean_context(expressions=booleans);
let visited = type_context(expressions=tested_booleans);
let roots = select l.id as id, l.file as file from tested_booleans as l join visited as r on l.id = r.id and l.file = r.file;
let elements = select l.id as owner, r.child as element, r.ordinal as ordinal, l.file as file from roots as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "values";
let element_counts = group-count(from=elements, keys=["owner","file"], count="count", distinct="element");
let two_elements = select l.owner as owner, l.element as element, l.ordinal as ordinal, l.file as file from elements as l join element_counts as r on l.owner = r.owner and l.file = r.file where r.count = 2;
let ordered_pairs = select l.owner as owner, l.element as left, r.element as right, l.file as file from two_elements as l join two_elements as r on l.owner = r.owner and l.file = r.file where l.ordinal < r.ordinal;
let left_ends = select l.owner as owner, l.left as left, l.right as right, r."end-byte" as start, l.file as file from ordered_pairs as l join "source-location" as r on l.left = r.id and l.file = r.file;
let gaps = select l.owner as owner, l.left as left, l.right as right, l.start as start, r."start-byte" as end, l.file as file from left_ends as l join "source-location" as r on l.right = r.id and l.file = r.file;
let and_tokens = select l.id as id, r."start-byte" as start, r."end-byte" as end, l.file as file from "syntax-tree" as l join "source-location" as r on l.id = r.id and l.file = r.file where l.text = "and";
let and_pairs = select l.owner as owner, l.left as left, l.right as right, l.file as file from gaps as l join and_tokens as r on l.file = r.file where r.start >= l.start and r.end <= l.end;
let left_expressions = select left as id, file from and_pairs;
let memberships = in_comparison(expressions=left_expressions);
let checked_memberships = select l.owner as owner, l.right as right, r.key as key, r.container as container, l.file as file from and_pairs as l join memberships as r on l.left = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let checked_subscripts = select l.owner as owner, l.right as right, l.key as key, l.container as container, l.file as file from checked_memberships as l join subscripts as r on l.right = r.id and l.file = r.file;
let right_objects = select l.owner as owner, l.right as right, l.key as key, l.container as container, r.child as object, l.file as file from checked_subscripts as l join "semantic-child" as r on l.right = r.parent and l.file = r.file where r.field = "value";
let right_keys = select l.owner as owner, l.key as key, l.container as container, l.object as object, r.child as index, l.file as file from right_objects as l join "semantic-child" as r on l.right = r.parent and l.file = r.file where r.field = "slice";
let object_shapes = select l.owner as owner, l.key as key, l.container as container, l.object as object, l.index as index, r.shape as shape, l.file as file from right_keys as l join "expression-shape" as r on l.container = r.id and l.file = r.file;
let same_objects = select l.owner as owner, l.key as key, l.container as container, l.index as index, l.file as file from object_shapes as l join "expression-shape" as r on l.object = r.id and l.shape = r.shape and l.file = r.file;
let key_shapes = select l.owner as owner, l.key as key, l.container as container, l.index as index, r.shape as shape, l.file as file from same_objects as l join "expression-shape" as r on l.key = r.id and l.file = r.file;
let same_keys = select l.owner as owner, l.key as key, l.container as container, l.file as file from key_shapes as l join "expression-shape" as r on l.index = r.id and l.shape = r.shape and l.file = r.file;
let key_inputs = select key as id, file from same_keys;
let object_inputs = select container as id, file from same_keys;
let pure_keys = without_effect(expressions=key_inputs);
let pure_objects = without_effect(expressions=object_inputs);
let allowed_keys = select l.owner as owner, l.container as container, l.file as file from same_keys as l join pure_keys as r on l.key = r.id and l.file = r.file;
let candidates = select l.owner as id, l.file as file from allowed_keys as l join pure_objects as r on l.container = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF019(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF019)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF019)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF019)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF019"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
