import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import typing_match from "python/ruff/typing-match-at-visit";
import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
let nodes = select id, kind, file from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select l.id as subscript, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let typing_inputs = select value as id,file from values;
let literal_names = typing_match(expressions=typing_inputs, member="Literal");
let literal_nodes = select l.subscript as id, l.file as file from values as l join literal_names as r on l.value = r.id and l.file = r.file;
let visited = type_context(expressions=literal_nodes);
let literals = select l.id as id, l.file as file from literal_nodes as l join visited as r on l.id = r.id and l.file = r.file;
let slices = select l.id as literal, r.child as slice, l.file as file from literals as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.literal as literal, l.slice as slice, l.file as file from slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_members = select l.literal as literal, r.child as member, l.file as file from tuple_slices as l join "semantic-child" as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let scalar_slices = antijoin(left=slices, right=tuples, left-on=["slice","file"], right-on=["id","file"]);
let scalar_members = select literal, slice as member, file from scalar_slices;
let members = union(left=tuple_members, right=scalar_members);
let nesting_edges = select l.literal as parent_literal, l.member as child_literal, l.file as file from members as l join literals as r on l.member = r.id and l.file = r.file;
let roots = antijoin(left=literals, right=nesting_edges, left-on=["id","file"], right-on=["child_literal","file"]);
let nesting_paths = closure(edges=nesting_edges, source="parent_literal", destination="child_literal", keys=["file"]);
let nested_literals = select l.id as root, r.child_literal as literal, l.file as file from roots as l join nesting_paths as r on l.id = r.parent_literal and l.file = r.file;
let leaf_members = antijoin(left=members, right=subscripts, left-on=["member","file"], right-on=["id","file"]);
let candidates = select l.root as id, l.file as file from nested_literals as l join leaf_members as r on l.literal = r.literal and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF041(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF041)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF041)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF041)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF041"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
