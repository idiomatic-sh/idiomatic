import suppress from "python/ruff/suppress";
let expression_statements = select id, file from "semantic-syntax" where kind = "expr" and not glob_any(file, "**/*.ipynb");
let values = select parent, child, file from "semantic-child" where field = "value";
let expression_values = select l.id as statement, r.child as value, l.file as file from expression_statements as l join values as r on l.id = r.parent and l.file = r.file;
let value_nodes = select l.value as id, l.file as file, r.kind as kind, r.span as span from expression_values as l join "semantic-syntax" as r on l.value = r.id and l.file = r.file;
let direct_names = select id, file, span from value_nodes where kind = "name";
let direct_attributes = select id, file, span from value_nodes where kind = "attribute";
let safe_expression_nodes = select id, file, span from value_nodes where kind = "bin-op" or kind = "bool-op" or kind = "dict" or kind = "if-exp" or kind = "lambda" or kind = "list" or kind = "set" or kind = "slice" or kind = "starred" or kind = "tuple" or kind = "unary-op";
let primitive_values = select l.value as id, l.file as file from expression_values as l join "literal-properties" as r on l.value = r.id and l.file = r.file where r.kind = "boolean" or r.kind = "bytes" or r.kind = "complex" or r.kind = "float" or r.kind = "integer" or r.kind = "null";
let primitive_roots = select l.id as id, l.file as file, r.span as span from primitive_values as l join "literal-properties" as r on l.id = r.id and l.file = r.file;
let safe_roots_a = union(left=direct_names, right=safe_expression_nodes);
let safe_roots_b = union(left=safe_roots_a, right=primitive_roots);
let all_nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file from all_nodes where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let function_name_nodes = select id from "semantic-syntax" where kind = "name";
let function_identifiers = select l.id as id, l.name as name from "identifier" as l join function_name_nodes as r on l.id = r.id;
let named_functions = select l.call as call, l.function as function, r.name as name, l.file as file from call_functions as l join function_identifiers as r on l.function = r.id;
let builtin_constructor_catalog = select name, file from "implicit-symbol" where kind = "builtin" and (name = "list" or name = "tuple" or name = "set" or name = "dict" or name = "frozenset");
let candidate_builtin_calls = select l.call as call, l.function as function, l.name as name, l.file as file from named_functions as l join builtin_constructor_catalog as r on l.name = r.name and l.file = r.file;
let argument_nodes = select id from all_nodes where kind = "call-arguments";
let argument_wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let positional_call_args = select l.call as call, l.file as file from argument_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let keyword_call_args = select l.call as call, l.file as file from argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let calls_with_positional = select call, file from positional_call_args;
let calls_with_keyword = select call, file from keyword_call_args;
let calls_with_any_argument = union(left=calls_with_positional, right=calls_with_keyword);
let zero_argument_candidate_calls = antijoin(left=candidate_builtin_calls, right=calls_with_any_argument, left-on=["call", "file"], right-on=["call", "file"]);
let call_candidates = select call as id, call, name, file from candidate_builtin_calls;
let owner_call_roots = axis(from=expression_statements, relation="semantic-child", direction=descendant, domain=call_candidates);
let owner_call_candidates = select l.id as owner, r.call as call, r.name as name, r.file as file from owner_call_roots as l join call_candidates as r on l.related = r.call;
let statement_scope_nodes = select child as id, file from "scope";
let statement_scope_ancestors = axis(from=expression_statements, relation="semantic-child", direction=ancestor, domain=statement_scope_nodes);
let statement_scope_rows = select l.id as owner, l.file as file, r.related as scope from expression_statements as l join statement_scope_ancestors as r on l.id = r.id;
let nearest_statement_scopes = axis(from=expression_statements, relation="semantic-child", direction=nearest-ancestor, domain=statement_scope_nodes);
let nearest_statement_scope_rows = select l.id as owner, l.file as file, r.related as scope from expression_statements as l join nearest_statement_scopes as r on l.id = r.id;
let class_scope_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let class_statement_scopes = select l.owner as owner, l.file as file, l.scope as scope from statement_scope_rows as l join class_scope_nodes as r on l.scope = r.id and l.file = r.file;
let nonclass_statement_scopes = antijoin(left=statement_scope_rows, right=class_scope_nodes, left-on=["scope", "file"], right-on=["id", "file"]);
let current_class_statement_scopes = select l.owner as owner, l.file as file, l.scope as scope from nearest_statement_scope_rows as l join class_scope_nodes as r on l.scope = r.id and l.file = r.file;
let visible_class_statement_scopes = select l.owner as owner, l.file as file, l.scope as scope from class_statement_scopes as l join current_class_statement_scopes as r on l.owner = r.owner and l.scope = r.scope and l.file = r.file;
let visible_statement_scopes = union(left=nonclass_statement_scopes, right=visible_class_statement_scopes);
let statement_calls = select l.id as owner, r.call as call, r.name as name, l.file as file from expression_statements as l join owner_call_candidates as r on l.id = r.owner and l.file = r.file;
let statement_locations = select loc.id as owner, loc.file as file, loc."start-byte" as start_byte from "source-location" as loc;
let current_statement_calls = select l.owner as owner, l.call as call, l.name as name, l.file as file, r.scope as current_scope from statement_calls as l join nearest_statement_scope_rows as r on l.owner = r.owner and l.file = r.file;
let statement_calls_scoped = select l.owner as owner, l.call as call, l.name as name, l.file as file, l.current_scope as current_scope, r.scope as lookup_scope from current_statement_calls as l join visible_statement_scopes as r on l.owner = r.owner and l.file = r.file;
let statement_calls_with_scope = select l.owner as owner, l.call as call, l.name as name, l.file as file, l.current_scope as current_scope, l.lookup_scope as lookup_scope, r.start_byte as statement_start from statement_calls_scoped as l join statement_locations as r on l.owner = r.owner and l.file = r.file;
let value_events = select occurrence, name, scope, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let value_event_locations = select l.name as name, l.scope as scope, l.kind as kind, l.file as file, r."start-byte" as event_start from value_events as l join "source-location" as r on l.occurrence = r.id and l.file = r.file;
let same_scope_prior_events = select l.owner as owner, l.call as call from statement_calls_with_scope as l join value_event_locations as r on l.name = r.name and l.lookup_scope = r.scope and l.file = r.file where r.event_start < l.statement_start;
let function_like_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let deferred_scope_rows = select l.owner as owner, l.file as file, l.scope as scope from nearest_statement_scope_rows as l join function_like_scopes as r on l.scope = r.id and l.file = r.file;
let deferred_calls = select l.owner as owner, l.call as call, l.name as name, l.file as file, r.scope as current_scope from current_statement_calls as l join deferred_scope_rows as r on l.owner = r.owner and l.file = r.file;
let deferred_visible_calls = select l.owner as owner, l.call as call, l.name as name, l.file as file, l.current_scope as current_scope, r.scope as lookup_scope from deferred_calls as l join visible_statement_scopes as r on l.owner = r.owner and l.file = r.file;
let deferred_ancestor_events = select l.owner as owner, l.call as call from deferred_visible_calls as l join value_event_locations as r on l.name = r.name and l.lookup_scope = r.scope and l.file = r.file where l.lookup_scope != l.current_scope;
let prior_visible_events = union(left=same_scope_prior_events, right=deferred_ancestor_events);
let shadowed_statement_calls = select owner, call from prior_visible_events;
let unshadowed_statement_calls = antijoin(left=statement_calls, right=shadowed_statement_calls, left-on=["owner", "call"], right-on=["owner", "call"]);
let safe_builtin_statement_calls = select call, file from unshadowed_statement_calls;
let zero_argument_builtin_calls = select l.call as call, l.file as file from safe_builtin_statement_calls as l join zero_argument_candidate_calls as r on l.call = r.call and l.file = r.file;
let safe_builtin_call_roots = select l.call as id, l.file as file, r.span as span from zero_argument_builtin_calls as l join all_nodes as r on l.call = r.id and l.file = r.file;
let safe_roots = union(left=safe_roots_b, right=safe_builtin_call_roots);
let without_excluded = select id, file, span from safe_roots;
let effectful_calls = antijoin(left=calls, right=zero_argument_builtin_calls, left-on=["id", "file"], right-on=["call", "file"]);
let named_expressions = select id, file from all_nodes where kind = "named-expr";
let direct_effect_nodes = select id, file from all_nodes where kind = "await" or kind = "dict-comp" or kind = "generator-exp" or kind = "list-comp" or kind = "set-comp" or kind = "subscript" or kind = "yield" or kind = "yield-from";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binops = select id, file from all_nodes where kind = "bin-op";
let binop_lefts = select l.id as binop, r.child as operand, l.file as file from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, r.child as operand, l.file as file from binops as l join right_fields as r on l.id = r.parent;
let binop_operands = union(left=binop_lefts, right=binop_rights);
let safe_operand_nodes = select id, file from all_nodes where kind = "joined-str" or kind = "list" or kind = "tuple" or kind = "set" or kind = "dict" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp";
let safe_operand_literals = select id, file from "literal-properties";
let safe_operands = union(left=safe_operand_nodes, right=safe_operand_literals);
let safe_binop_operands = select l.binop as binop, l.operand as operand, l.file as file from binop_operands as l join safe_operands as r on l.operand = r.id and l.file = r.file;
let unsafe_binop_operands = antijoin(left=binop_operands, right=safe_binop_operands, left-on=["binop", "operand", "file"], right-on=["binop", "operand", "file"]);
let unsafe_binops = select binop as id, file from unsafe_binop_operands;
let effects_a = union(left=effectful_calls, right=named_expressions);
let effects_b = union(left=effects_a, right=direct_effect_nodes);
let effect_roots = union(left=effects_b, right=unsafe_binops);
let child_edges = select parent as origin, child as destination from "semantic-child";
let child_descendants = closure(edges=child_edges, source="origin", destination="destination");
let descendant_effects = select l.origin as root, r.id as effect, r.file as file from child_descendants as l join effect_roots as r on l.destination = r.id;
let direct_effect_roots = select id as root, id as effect, file from effect_roots;
let all_effects = union(left=descendant_effects, right=direct_effect_roots);
let roots_with_effect = select root as id, file from all_effects;
let pure_roots = antijoin(left=without_excluded, right=roots_with_effect, left-on=["id", "file"], right-on=["id", "file"]);
let pure_attributes = select id, file, span from direct_attributes;
let candidates_before_effect_filter = union(left=pure_roots, right=pure_attributes);
let candidates = select l.id as id, l.file as file, l.span as span from candidates_before_effect_filter as l join value_nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*B018(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B018)(?:,|$)");
emit violations subject file key(id);
