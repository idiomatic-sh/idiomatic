import observation_matches from "python/ruff/suppress-matches";
let shapes = select id, shape, file from "expression-shape";
let comparisons = select id from "semantic-syntax" where kind = "compare";
let right_fields = select parent, child from "semantic-child" where field = "comparators";
let comparison_counts = group-count(from=right_fields, keys=["parent"], count="count", distinct="child");
let single_comparisons = select parent from comparison_counts where count = 1;
let operator_fields = select parent, child from "semantic-child" where field = "ops";
let ordering_tokens = select id from "semantic-syntax" where text = "<" or text = "<=" or text = ">" or text = ">=";
let orderings = select l.parent as id from operator_fields as l join ordering_tokens as r on l.child = r.id;
let single_orderings = select l.id as id from orderings as l join single_comparisons as r on l.id = r.parent;
let left_fields = select parent, child from "semantic-child" where field = "left";
let left_shapes = select l.parent as id, r.shape as left, r.file as file from left_fields as l join shapes as r on l.child = r.id;
let right_shapes = select l.parent as id, r.shape as right, r.file as file from right_fields as l join shapes as r on l.child = r.id;
let comparison_shapes = select l.id as id, l.file as file, l.left as left, r.right as right from left_shapes as l join right_shapes as r on l.id = r.id and l.file = r.file;
let ordered_shapes = select l.id as id, l.file as file, l.left as left, l.right as right from comparison_shapes as l join single_orderings as r on l.id = r.id;
let tests = select parent, child from "semantic-child" where field = "test";
let tested_shapes = select l.parent as id, r.file as file, r.left as left, r.right as right from tests as l join ordered_shapes as r on l.child = r.id;
let ifs = select id, file, span from "semantic-syntax" where kind = "if";
let else_fields = select parent from "semantic-child" where field = "orelse";
let no_else = antijoin(left=ifs, right=else_fields, left-on=["id"], right-on=["parent"]);
let bodies = select parent, child from "semantic-child" where field = "body";
let body_counts = group-count(from=bodies, keys=["parent"], count="count", distinct="child");
let one_body = select parent from body_counts where count = 1;
let single = select l.id as id from no_else as l join one_body as r on l.id = r.parent;
let assignments = select id from "semantic-syntax" where kind = "assign";
let assigned_bodies = select l.parent as owner, r.id as assignment from bodies as l join assignments as r on l.child = r.id;
let eligible_bodies = select l.owner as owner, l.assignment as assignment from assigned_bodies as l join single as r on l.owner = r.id;
let target_fields = select parent, child from "semantic-child" where field = "targets";
let target_counts = group-count(from=target_fields, keys=["parent"], count="count", distinct="child");
let one_target = select parent from target_counts where count = 1;
let targets = select l.parent as assignment, r.shape as target, r.file as file from target_fields as l join shapes as r on l.child = r.id;
let single_targets = select l.assignment as assignment, l.target as target, l.file as file from targets as l join one_target as r on l.assignment = r.parent;
let value_fields = select parent, child from "semantic-child" where field = "value";
let values = select l.parent as assignment, r.shape as value, r.file as file from value_fields as l join shapes as r on l.child = r.id;
let assignment_shapes = select l.assignment as assignment, l.file as file, l.target as target, r.value as value from single_targets as l join values as r on l.assignment = r.assignment and l.file = r.file;
let body_shapes = select l.owner as id, r.file as file, r.target as target, r.value as value from eligible_bodies as l join assignment_shapes as r on l.assignment = r.assignment;
let candidates = select l.id as id from body_shapes as l join tested_shapes as r on l.id = r.id and l.file = r.file where l.target = r.left and l.value = r.right or l.target = r.right and l.value = r.left;
let reportable = select l.id as id, l.file as file, l.span as span from ifs as l join candidates as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:PLR1730)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1730"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
