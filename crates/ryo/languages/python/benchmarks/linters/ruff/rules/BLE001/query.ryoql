import observation_matches from "python/ruff/suppress-matches";
import builtin_match from "python/ruff/builtin-match-at-visit";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, ordinal, file from "semantic-child";
let identifiers = select id, name, file from "identifier";
let handlers = select id, file from nodes where kind = "except-handler";
let tuples = select id, file from nodes where kind = "tuple";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let calls = select id, file from nodes where kind = "call";
let type_roots = select l.id as handler, r.child as root, l.file as file from handlers as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "type";
let tuple_elements = select l.id as source, r.child as destination, l.file as file from tuples as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let tuple_paths = closure(edges=tuple_elements, source="source", destination="destination", keys=["file"]);
let nested_types = select l.handler as handler, r.destination as root, l.file as file from type_roots as l join tuple_paths as r on l.root = r.source and l.file = r.file;
let type_members = union(left=type_roots, right=nested_types);
let exception_checks = select root as check, root, file from type_members;
let exception_matches = builtin_match(checks=exception_checks, builtin="builtins.Exception");
let base_matches = builtin_match(checks=exception_checks, builtin="builtins.BaseException");
let blind_matches = union(left=exception_matches, right=base_matches);
let broad_members = select l.handler as handler, l.root as id, l.file as file from type_members as l join blind_matches as r on l.root = r.check and l.file = r.file;
let broad_locations = select l.handler as handler, l.id as id, l.file as file, r.span as span, r."start-byte" as begin from broad_members as l join "source-location" as r on l.id = r.id and l.file = r.file;
let later_broad_members = select l.handler as handler, l.id as id, l.file as file from broad_locations as l join broad_locations as r on l.handler = r.handler and l.file = r.file where r.begin < l.begin;
let first_broad_members = antijoin(left=broad_locations, right=later_broad_members, left-on=["handler", "id", "file"], right-on=["handler", "id", "file"]);
let visit_barriers = select id, file from nodes where kind = "except-handler" or kind = "try" or kind = "try-star" or kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let raises = select id, file from nodes where kind = "raise";
let raise_owners = axis(from=raises, relation="semantic-child", direction=nearest-ancestor, domain=visit_barriers);
let handler_raises = select l.id as statement, l.related as handler, l.file as file from raise_owners as l join handlers as r on l.related = r.id and l.file = r.file;
let raised_values = select parent as statement, child as value, file from edges where field = "exc";
let raise_causes = select parent as statement, child as value, file from edges where field = "cause";
let any_raise_values = select statement, file from raised_values;
let any_raise_causes = select statement, file from raise_causes;
let bare_raises_a = antijoin(left=handler_raises, right=any_raise_values, left-on=["statement", "file"], right-on=["statement", "file"]);
let bare_raises = antijoin(left=bare_raises_a, right=any_raise_causes, left-on=["statement", "file"], right-on=["statement", "file"]);
let handler_name_fields = select l.id as handler, r.child as token, l.file as file from handlers as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "name";
let handler_names = select l.handler as handler, r.name as name, l.file as file from handler_name_fields as l join identifiers as r on l.token = r.id and l.file = r.file;
let raised_or_caused = union(left=raised_values, right=raise_causes);
let raised_name_values = select l.statement as statement, l.value as value, l.file as file from raised_or_caused as l join names as r on l.value = r.id and l.file = r.file;
let raised_names = select l.statement as statement, r.name as name, l.file as file from raised_name_values as l join identifiers as r on l.value = r.id and l.file = r.file;
let owned_raised_names = select l.handler as handler, r.name as name, l.file as file from handler_raises as l join raised_names as r on l.statement = r.statement and l.file = r.file;
let named_reraises = select l.handler as handler, l.file as file from owned_raised_names as l join handler_names as r on l.handler = r.handler and l.name = r.name and l.file = r.file;
let bare_reraises = select handler, file from bare_raises;
let reraised_handlers = union(left=bare_reraises, right=named_reraises);
let expr_statements = select id, file from nodes where kind = "expr";
let expr_owners = axis(from=expr_statements, relation="semantic-child", direction=nearest-ancestor, domain=visit_barriers);
let visited_exprs = select l.id as statement, l.related as handler, l.file as file from expr_owners as l join handlers as r on l.related = r.id and l.file = r.file;
let expr_values = select l.statement as statement, l.handler as handler, r.child as value, l.file as file from visited_exprs as l join edges as r on l.statement = r.parent and l.file = r.file where r.field = "value";
let handler_calls = select l.handler as handler, l.value as call, l.file as file from expr_values as l join calls as r on l.value = r.id and l.file = r.file;
let call_functions = select l.id as call, r.child as function, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "func";
let attribute_values = select l.id as attribute, r.child as receiver, l.file as file from attributes as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "value";
let attribute_labels = select l.id as attribute, r.child as token, l.file as file from attributes as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let attribute_names = select l.attribute as attribute, r.name as name, l.file as file from attribute_labels as l join identifiers as r on l.token = r.id and l.file = r.file;
let method_names = select attribute, name, file from attribute_names where name = "debug" or name = "info" or name = "warn" or name = "warning" or name = "error" or name = "critical" or name = "log" or name = "exception";
let attribute_calls = select l.call as call, l.function as attribute, r.name as method, l.file as file from call_functions as l join method_names as r on l.function = r.attribute and l.file = r.file;
let receiver_origins = select id, path, file from "qualified-name" where provenance = "import" or provenance = "builtin";
let module_receivers = select l.attribute as attribute, l.file as file from attribute_values as l join receiver_origins as r on l.receiver = r.id and l.file = r.file where r.path = "logging" or r.path = "flask.current_app.logger";
let receiver_call_nodes = select l.attribute as attribute, l.receiver as call, l.file as file from attribute_values as l join calls as r on l.receiver = r.id and l.file = r.file;
let receiver_constructors = select l.attribute as attribute, r.function as function, l.file as file from receiver_call_nodes as l join call_functions as r on l.call = r.call and l.file = r.file;
let inline_receivers = select l.attribute as attribute, l.file as file from receiver_constructors as l join receiver_origins as r on l.function = r.id and l.file = r.file where r.path = "logging.getLogger" or r.path = "logging.Logger";
let receiver_chain_edges = select attribute as source, receiver as destination, file from attribute_values;
let receiver_chain_paths = closure(edges=receiver_chain_edges, source="source", destination="destination", keys=["file"]);
let named_attribute_chains = select l.source as id, l.file as file from receiver_chain_paths as l join names as r on l.destination = r.id and l.file = r.file;
let local_attribute_labels = select l.id as id, r.name as name, l.file as file from named_attribute_chains as l join attribute_names as r on l.id = r.attribute and l.file = r.file;
let local_name_labels = select l.id as id, r.name as name, l.file as file from names as l join identifiers as r on l.id = r.id and l.file = r.file;
let local_receiver_labels = union(left=local_name_labels, right=local_attribute_labels);
let policy_logger_labels = select id, file from local_receiver_labels where matches(name, "(?:^log|logger$|logging$|^LOG|LOGGER$|LOGGING$)");
let unknown_origin_labels = antijoin(left=policy_logger_labels, right=receiver_origins, left-on=["id", "file"], right-on=["id", "file"]);
let heuristic_receivers = select l.attribute as attribute, l.file as file from attribute_values as l join unknown_origin_labels as r on l.receiver = r.id and l.file = r.file;
let proven_receivers = union(left=module_receivers, right=inline_receivers);
let policy_receivers = union(left=proven_receivers, right=heuristic_receivers);
let logging_attribute_calls = select l.call as call, l.method as method, l.file as file from attribute_calls as l join policy_receivers as r on l.attribute = r.attribute and l.file = r.file;
let direct_name_functions = select l.call as call, l.function as function, l.file as file from call_functions as l join names as r on l.function = r.id and l.file = r.file;
let direct_logging_origins = select id, path, file from receiver_origins where matches(path, "^logging[.](?:debug|info|warn|warning|error|critical|log|exception)$");
let direct_logging_calls_a = select l.call as call, r.path as path, l.file as file from direct_name_functions as l join direct_logging_origins as r on l.function = r.id and l.file = r.file;
let direct_logging_calls_b = replace(from=direct_logging_calls_a, text="path", pattern="^logging[.]", replacement="", output="method");
let direct_logging_calls = select call, method, file from direct_logging_calls_b;
let logging_calls = union(left=logging_attribute_calls, right=direct_logging_calls);
let call_wrappers_a = select l.id as call, r.child as wrapper, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file;
let wrappers = select id, file from nodes where kind = "call-arguments";
let call_wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from call_wrappers_a as l join wrappers as r on l.wrapper = r.id and l.file = r.file;
let positionals = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let keywords = select l.call as call, r.child as keyword, r.ordinal as ordinal, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_labels = select l.call as call, l.keyword as keyword, l.ordinal as ordinal, r.child as token, l.file as file from keywords as l join edges as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let exc_info_keywords_a = select l.call as call, l.keyword as keyword, l.ordinal as ordinal, l.file as file from keyword_labels as l join identifiers as r on l.token = r.id and l.file = r.file where r.name = "exc_info";
let later_exc_info = select l.call as call, l.keyword as keyword, l.file as file from exc_info_keywords_a as l join exc_info_keywords_a as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let exc_info_keywords = antijoin(left=exc_info_keywords_a, right=later_exc_info, left-on=["call", "keyword", "file"], right-on=["call", "keyword", "file"]);
let exc_info_values = select l.call as call, r.child as value, l.file as file from exc_info_keywords as l join edges as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let primitive_false = select id, file from "literal-properties" where kind = "null" or kind = "boolean" and boolean = "false" or (kind = "integer" or kind = "float" or kind = "complex") and zero = "true" or (kind = "string" or kind = "bytes") and empty = "true";
let containers = select id, kind, file from nodes where kind = "list" or kind = "tuple" or kind = "set" or kind = "dict";
let container_items = select l.id as id, l.file as file from containers as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "elts" or r.field = "values";
let empty_containers_a = antijoin(left=containers, right=container_items, left-on=["id", "file"], right-on=["id", "file"]);
let empty_containers = select id, file from empty_containers_a;
let fstrings = select id, file from nodes where kind = "joined-str";
let formatted = select id, file from nodes where kind = "formatted-value";
let formatted_owners_a = axis(from=formatted, relation="semantic-child", direction=nearest-ancestor, domain=fstrings);
let formatted_owners = select id as formatted, related as owner, file from formatted_owners_a;
let formatted_values = select l.formatted as formatted, l.owner as owner, r.child as value, l.file as file from formatted_owners as l join edges as r on l.formatted = r.parent and l.file = r.file where r.field = "value";
let empty_strings = select id, file from "literal-properties" where kind = "string" and empty = "true";
let possible_empty_values = union(left=empty_strings, right=fstrings);
let bad_format_values = antijoin(left=formatted_values, right=possible_empty_values, left-on=["value", "file"], right-on=["id", "file"]);
let bad_format_children = select l.formatted as formatted, l.owner as owner, l.file as file from formatted_owners as l join edges as r on l.formatted = r.parent and l.file = r.file where r.field = "conversion" or r.field = "format-spec";
let equals_tokens = select id, file from "semantic-syntax" where text = "=";
let debug_children_a = select l.formatted as formatted, l.owner as owner, r.child as token, l.file as file from formatted_owners as l join edges as r on l.formatted = r.parent and l.file = r.file;
let debug_children = select l.formatted as formatted, l.owner as owner, l.file as file from debug_children_a as l join equals_tokens as r on l.token = r.id and l.file = r.file;
let unsafe_fstrings_a = select owner as id, file from bad_format_values;
let unsafe_fstrings_b = select owner as id, file from bad_format_children;
let unsafe_fstrings_c = select owner as id, file from debug_children;
let nonempty_fstring_parts = select owner as id, file from "interpolated-string-literal" where value != "";
let unsafe_fstrings_ab = union(left=unsafe_fstrings_a, right=unsafe_fstrings_b);
let unsafe_fstrings_cd = union(left=unsafe_fstrings_c, right=nonempty_fstring_parts);
let unsafe_fstrings = union(left=unsafe_fstrings_ab, right=unsafe_fstrings_cd);
let fstring_dependencies = select l.owner as source, l.value as destination, l.file as file from formatted_values as l join fstrings as r on l.value = r.id and l.file = r.file;
let fstring_dependency_paths = closure(edges=fstring_dependencies, source="source", destination="destination", keys=["file"]);
let nested_unsafe_fstrings = select l.source as id, l.file as file from fstring_dependency_paths as l join unsafe_fstrings as r on l.destination = r.id and l.file = r.file;
let all_unsafe_fstrings = union(left=unsafe_fstrings, right=nested_unsafe_fstrings);
let empty_fstrings = antijoin(left=fstrings, right=all_unsafe_fstrings, left-on=["id", "file"], right-on=["id", "file"]);
let direct_false_a = union(left=primitive_false, right=empty_containers);
let direct_false = union(left=direct_false_a, right=empty_fstrings);
let builtin_reads = select reference as id, file from "binding-read" where state = "builtin";
let initializer_labels = select l.id as id, l.file as file from local_name_labels as l join builtin_reads as r on l.id = r.id and l.file = r.file where l.name = "list" or l.name = "tuple" or l.name = "set" or l.name = "dict" or l.name = "frozenset";
let initializer_calls = select l.call as id, l.file as file from call_functions as l join initializer_labels as r on l.function = r.id and l.file = r.file;
let any_positionals = select call as id, file from positionals;
let any_keywords = select call as id, file from keywords;
let keyword_free_initializers = antijoin(left=initializer_calls, right=any_keywords, left-on=["id", "file"], right-on=["id", "file"]);
let empty_initializers = antijoin(left=keyword_free_initializers, right=any_positionals, left-on=["id", "file"], right-on=["id", "file"]);
let multiple_positional_calls = select l.call as id, l.file as file from positionals as l join positionals as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let single_initializer_calls = antijoin(left=keyword_free_initializers, right=multiple_positional_calls, left-on=["id", "file"], right-on=["id", "file"]);
let initializer_arguments = select l.id as source, r.argument as destination, l.file as file from single_initializer_calls as l join positionals as r on l.id = r.call and l.file = r.file;
let excluded_initializer_values_a = select id, file from "literal-properties" where kind = "integer" or kind = "float" or kind = "complex" or kind = "boolean" or kind = "null" or kind = "ellipsis";
let excluded_initializer_values_b = select id, file from nodes where kind = "template-str" or kind = "lambda" or kind = "generator-exp";
let excluded_initializer_values = union(left=excluded_initializer_values_a, right=excluded_initializer_values_b);
let initializer_dependencies = antijoin(left=initializer_arguments, right=excluded_initializer_values, left-on=["destination", "file"], right-on=["id", "file"]);
let initializer_paths = closure(edges=initializer_dependencies, source="source", destination="destination", keys=["file"]);
let false_leaves = union(left=direct_false, right=empty_initializers);
let false_initializer_roots = select l.source as id, l.file as file from initializer_paths as l join false_leaves as r on l.destination = r.id and l.file = r.file;
let false_values = union(left=false_leaves, right=false_initializer_roots);
let false_exc_info = select l.call as call, l.file as file from exc_info_values as l join false_values as r on l.value = r.id and l.file = r.file;
let enabled_exc_info = antijoin(left=exc_info_values, right=false_exc_info, left-on=["call", "file"], right-on=["call", "file"]);
let exception_calls = select call, file from logging_calls where method = "exception";
let trace_logging_calls = select l.call as call, l.file as file from logging_calls as l join enabled_exc_info as r on l.call = r.call and l.file = r.file;
let exempt_logging_calls = union(left=exception_calls, right=trace_logging_calls);
let logging_handlers = select l.handler as handler, l.file as file from handler_calls as l join exempt_logging_calls as r on l.call = r.call and l.file = r.file;
let exempt_handlers = union(left=reraised_handlers, right=logging_handlers);
let reportable = antijoin(left=first_broad_members, right=exempt_handlers, left-on=["handler", "file"], right-on=["handler", "file"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])BLE001(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:BLE001)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])BLE001(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:BLE001)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "BLE001"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
