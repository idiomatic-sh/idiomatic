import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let boolops = select id, file from nodes where kind = "bool-op";
let operators = select parent, child, file from "semantic-child" where field = "op";
let and_tokens = select id, file from "semantic-syntax" where text = "and";
let and_ops = select l.parent as id, l.file as file from operators as l join and_tokens as r on l.child = r.id and l.file = r.file;
let values = select parent as boolop, child as value, ordinal, file from "semantic-child" where field = "values";
let and_values = select l.boolop as boolop, l.value as value, l.ordinal as ordinal, l.file as file from values as l join and_ops as r on l.boolop = r.id and l.file = r.file;
let comparisons = select id, file, span from nodes where kind = "compare";
let noncomparisons = antijoin(left=and_values, right=comparisons, left-on=["value","file"], right-on=["id","file"]);
let eligible_values = antijoin(left=and_values, right=noncomparisons, left-on=["boolop","file"], right-on=["boolop","file"]);
let pairs = select l.boolop as id, l.file as file, l.value as left_compare, r.value as right_compare, l.ordinal as left_ordinal, r.ordinal as right_ordinal from eligible_values as l join eligible_values as r on l.boolop = r.boolop and l.file = r.file where l.ordinal < r.ordinal;
let nonadjacent = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from pairs as l join eligible_values as r on l.id = r.boolop and l.file = r.file where l.left_ordinal < r.ordinal and r.ordinal < l.right_ordinal;
let adjacent = antijoin(left=pairs, right=nonadjacent, left-on=["id","file","left_compare","right_compare"], right-on=["id","file","left_compare","right_compare"]);
let cmp_ops = select parent as comparison, child, file from "semantic-child" where field = "ops";
let cmp_tokens = select l.comparison as comparison, l.file as file, r.text as text from cmp_ops as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file;
let nonascending = select comparison, file from cmp_tokens where text != "<" and text != "<=";
let nondescending = select comparison, file from cmp_tokens where text != ">" and text != ">=";
let ascending = antijoin(left=comparisons, right=nonascending, left-on=["id","file"], right-on=["comparison","file"]);
let descending = antijoin(left=comparisons, right=nondescending, left-on=["id","file"], right-on=["comparison","file"]);
let ascending_left_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from adjacent as l join ascending as r on l.left_compare = r.id and l.file = r.file;
let ascending_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from ascending_left_pairs as l join ascending as r on l.right_compare = r.id and l.file = r.file;
let descending_left_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from adjacent as l join descending as r on l.left_compare = r.id and l.file = r.file;
let descending_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from descending_left_pairs as l join descending as r on l.right_compare = r.id and l.file = r.file;
let monotone_pairs = union(left=ascending_pairs, right=descending_pairs);
let right_members = select parent as comparison, child as value, ordinal, file from "semantic-child" where field = "comparators";
let nonlast_members = select l.comparison as comparison, l.value as value, l.file as file from right_members as l join right_members as r on l.comparison = r.comparison and l.file = r.file where l.ordinal < r.ordinal;
let last_members = antijoin(left=right_members, right=nonlast_members, left-on=["comparison","value","file"], right-on=["comparison","value","file"]);
let left_members = select parent as comparison, child as value, file from "semantic-child" where field = "left";
let names = select id, file from nodes where kind = "name";
let named_identifiers = select l.id as id, l.file as file, r.name as name from names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let last_names = select l.comparison as comparison, l.file as file, r.name as name from last_members as l join named_identifiers as r on l.value = r.id and l.file = r.file;
let first_names = select l.comparison as comparison, l.file as file, r.name as name from left_members as l join named_identifiers as r on l.value = r.id and l.file = r.file;
let left_named_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare, r.name as name from monotone_pairs as l join last_names as r on l.left_compare = r.comparison and l.file = r.file;
let named_pairs = select l.id as id, l.file as file, l.left_compare as left_compare, l.right_compare as right_compare from left_named_pairs as l join first_names as r on l.right_compare = r.comparison and l.file = r.file and l.name = r.name;
let left_locations = select l.id as id, l.file as file, l.right_compare as right_compare, r.span as start_span, r."start-line" as line from named_pairs as l join "source-location" as r on l.left_compare = r.id and l.file = r.file;
let bounds = select l.id as id, l.file as file, l.line as line, l.start_span as start_span, r.span as end_span from left_locations as l join comparisons as r on l.right_compare = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLR1716(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLR1716)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLR1716)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLR1716)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1716"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(span,id);
