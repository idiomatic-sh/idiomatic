import observation_matches from "python/ruff/suppress-matches";
let imports = select id, file, span from "semantic-syntax" where kind = "import-from" and matches(file, "\.pyi$");
let future = select occurrence from "static-import" where matches(target, "^\.*__future__\.annotations$");
let parents = select l.parent as parent from "semantic-child" as l join future as r on l.child = r.occurrence;
let reportable = select l.id as id, l.file as file, l.span as span from imports as l join parents as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI044)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI044"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
