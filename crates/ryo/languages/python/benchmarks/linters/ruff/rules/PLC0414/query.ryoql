import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let aliases = select id, file, span from "semantic-syntax" where kind = "alias";
let asnames = select parent, child from "semantic-child" where field = "asname";
let alias_tokens = select l.parent as alias, r.child as child from asnames as l join "semantic-child" as r on l.child = r.parent;
let name_tokens = select id, text from semantic_identifiers;
let renamed = select l.alias as id, r.text as name from alias_tokens as l join name_tokens as r on l.child = r.id;
let originals = select l.occurrence as id, l.target as target, r.name as name from "static-import" as l join renamed as r on l.occurrence = r.id;
let direct = select id from originals where target = name;
let split_names = capture(from=originals, path="target", pattern="{*prefix}.{imported}", captures=["prefix", "imported"]);
let same_named_member = select id from split_names where imported = name;
let relative_names = capture(from=originals, path="target", pattern=".{imported}", captures=["imported"]);
let same_relative = select id from relative_names where imported = name;
let same_member = union(left=same_named_member, right=same_relative);
let from_imports = select id from "semantic-syntax" where kind = "import-from";
let from_aliases = select r.child as child from from_imports as l join "semantic-child" as r on l.id = r.parent;
let members = select l.id as id from same_member as l join from_aliases as r on l.id = r.child;
let redundant = union(left=direct, right=members);
let candidates = select l.id as id, l.file as file, l.span as span from aliases as l join redundant as r on l.id = r.id;
let init_modules = select id from candidates where matches(file, "(?:^|/)__init__\.py$|\.pyi$");
let reportable = antijoin(left=candidates, right=init_modules, left-on=["id"], right-on=["id"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLC0414(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLC0414)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLC0414)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLC0414)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLC0414"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
