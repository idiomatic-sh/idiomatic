import observation_matches from "python/ruff/suppress-matches";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let raises = select id from "semantic-syntax" where kind = "raise";
let exceptions = select parent, child from "semantic-child" where field = "exc";
let raised = select r.child as id from raises as l join exceptions as r on l.id = r.parent;
let calls = select id from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let called = select l.id as id from raised as l join calls as r on l.id = r.id;
let called_functions = select r.child as id from called as l join functions as r on l.id = r.parent;
let values = union(left=raised, right=called_functions);
let names = select id, file, span from "semantic-syntax" where kind = "name";
let identifiers = select parent, child from "semantic-child" where field = "id";
let not_implemented = select id from semantic_identifiers where text = "NotImplemented";
let matching_names = select l.parent as id from identifiers as l join not_implemented as r on l.child = r.id;
let matching_values = select l.id as id from values as l join matching_names as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from names as l join matching_values as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F901)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F901"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
