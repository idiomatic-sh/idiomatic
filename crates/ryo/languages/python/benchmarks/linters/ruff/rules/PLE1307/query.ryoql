import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let binops = select id, file, span from "semantic-syntax" where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binop_lefts = select l.id as binop, l.file as file, r.child as left from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, l.file as file, r.child as right from binops as l join right_fields as r on l.id = r.parent;
let left_locations = select l.binop as binop, l.left as left, l.file as file, r."end-byte" as left_end from binop_lefts as l join "source-location" as r on l.left = r.id and l.file = r.file;
let right_locations = select l.binop as binop, l.right as right, l.file as file, r."start-byte" as right_start from binop_rights as l join "source-location" as r on l.right = r.id and l.file = r.file;
let ordered_binops = select l.binop as binop, l.left as left, r.right as right, l.file as file, l.left_end as left_end, r.right_start as right_start from left_locations as l join right_locations as r on l.binop = r.binop and l.file = r.file;
let percent_tokens = select l.id as token, r.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "%";
let modulo_candidates = select l.binop as binop, l.left as left, l.right as right, l.file as file from ordered_binops as l join percent_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let format_literals = select l.occurrence as format_id, l.value as value, l.file as file from "string-literal" as l;
let literal_binops = select l.binop as binop, l.left as left, l.right as right, l.file as file, r.format_id as format_id, r.value as format_value from modulo_candidates as l join format_literals as r on l.left = r.format_id and l.file = r.file;
let right_shapes = select l.binop as binop, l.right as right, l.file as file, r.kind as right_kind from literal_binops as l join "semantic-syntax" as r on l.right = r.id and l.file = r.file;
let raw_segments = select id as format_id, segment, file from "raw-format-segment" where dialect = "percent-string";
let raw_expression_counts = group-count(from=raw_segments, keys=["format_id","file"], count="segment_count", distinct="segment");
let literal_with_right_shape = select l.binop as binop, l.left as left, l.right as right, l.format_id as format_id, l.format_value as format_value, l.file as file, r.right_kind as right_kind from literal_binops as l join right_shapes as r on l.binop = r.binop and l.file = r.file;
let raw_formats = select l.binop as binop, l.right as right, l.format_id as format_id, l.file as file, l.right_kind as right_kind from literal_with_right_shape as l join raw_expression_counts as r on l.format_id = r.format_id and l.file = r.file;
let fields = select f.id as format_id, f.ordinal as slot, f."mapping-key" as name, f."argument-kind" as argument_kind, f.conversion as conversion, f.file as file from "raw-format-field" as f;
let positive_field_counts = group-count(from=fields, keys=["format_id","file"], count="field_count", distinct="slot");
let zero_field_formats = antijoin(left=raw_formats, right=positive_field_counts, left-on=["format_id","file"], right-on=["format_id","file"]);
let zero_field_ids = select format_id, file from zero_field_formats;
let zero_field_counts = extend(from=zero_field_ids, values={field_count: 0});
let field_counts = union(left=positive_field_counts, right=zero_field_counts);
let contexts = select l.binop as binop, l.right as right, l.right_kind as right_kind, l.format_id as format_id, l.file as file, r.field_count as field_count from raw_formats as l join field_counts as r on l.format_id = r.format_id and l.file = r.file;
let scalar_contexts = select * from contexts where right_kind != "tuple" and right_kind != "dict" and field_count = 1;
let scalar_bindings = select l.binop as binop, l.file as file, l.right as value, r.conversion as conversion from scalar_contexts as l join fields as r on l.format_id = r.format_id and l.file = r.file;
let element_edges = select parent as tuple, child as value, ordinal, file from "semantic-child" where field = "elts";
let tuple_contexts = select * from contexts where right_kind = "tuple";
let tuple_values = select l.binop as binop, l.right as tuple, l.file as file, l.field_count as field_count, r.value as value, r.ordinal as ordinal from tuple_contexts as l join element_edges as r on l.right = r.tuple and l.file = r.file;
let tuple_sizes = group-count(from=tuple_values, keys=["binop","file","field_count"], count="size", distinct="value");
let valid_tuple_sizes = select binop, file from tuple_sizes where field_count <= size;
let preceding_elements = select l.tuple as tuple, l.value as value, l.ordinal as ordinal, l.file as file, r.value as earlier from element_edges as l join element_edges as r on l.tuple = r.tuple and l.file = r.file where r.ordinal < l.ordinal;
let positive_element_indexes = group-count(from=preceding_elements, keys=["tuple","value","ordinal","file"], count="slot", distinct="earlier");
let first_elements = antijoin(left=element_edges, right=positive_element_indexes, left-on=["tuple","value","file"], right-on=["tuple","value","file"]);
let zero_element_indexes = extend(from=first_elements, values={slot: 0});
let indexed_elements = union(left=positive_element_indexes, right=zero_element_indexes);
let valid_tuple_contexts = select l.binop as binop, l.right as tuple, l.format_id as format_id, l.file as file from tuple_contexts as l join valid_tuple_sizes as r on l.binop = r.binop and l.file = r.file;
let tuple_field_bindings = select l.binop as binop, l.tuple as tuple, l.file as file, r.slot as slot, r.conversion as conversion from valid_tuple_contexts as l join fields as r on l.format_id = r.format_id and l.file = r.file;
let tuple_bindings = select l.binop as binop, l.file as file, r.value as value, l.conversion as conversion from tuple_field_bindings as l join indexed_elements as r on l.tuple = r.tuple and l.file = r.file and l.slot = r.slot;
let dict_nodes = select id as dict, file from "semantic-syntax" where kind = "dict";
let key_edges = select parent as dict, child as key, ordinal as key_order, file from "semantic-child" where field = "keys";
let value_edges = select parent as dict, child as value, ordinal as value_order, file from "semantic-child" where field = "values";
let dict_keys = select l.dict as dict, l.key as key, l.key_order as key_order, l.file as file from key_edges as l join dict_nodes as r on l.dict = r.dict and l.file = r.file;
let dict_values = select l.dict as dict, l.value as value, l.value_order as value_order, l.file as file from value_edges as l join dict_nodes as r on l.dict = r.dict and l.file = r.file;
let dict_items = ordered-match(left=dict_keys, right=dict_values, left-on=["dict","file"], right-on=["dict","file"], left-order="key_order", right-order="value_order", output={dict:[left,dict], file:[left,file], key:[left,key], value:[right,value], value_order:[right,value_order]});
let unpacked_items = antijoin(left=dict_values, right=dict_items, left-on=["dict","value","file"], right-on=["dict","value","file"]);
let named_items = select l.dict as dict, l.file as file, l.value as value, l.value_order as value_order, r.value as name from dict_items as l join "string-literal" as r on l.key = r.occurrence and l.file = r.file;
let dynamic_items = antijoin(left=dict_items, right=named_items, left-on=["dict","value","file"], right-on=["dict","value","file"]);
let unpacked_stops = select dict, file, value_order from unpacked_items;
let dynamic_stops = select dict, file, value_order from dynamic_items;
let unknown_key_stops = union(left=unpacked_stops, right=dynamic_stops);
let named_fields = select * from fields where argument_kind = "mapping";
let shadowed_fields = select l.format_id as format_id, l.file as file, l.slot as slot from named_fields as l join named_fields as r on l.format_id = r.format_id and l.file = r.file and l.name = r.name where r.slot > l.slot;
let final_named_fields = antijoin(left=named_fields, right=shadowed_fields, left-on=["format_id","slot","file"], right-on=["format_id","slot","file"]);
let dict_sizes = group-count(from=dict_values, keys=["dict","file"], count="size", distinct="value");
let dict_contexts = select l.binop as binop, l.right as dict, l.format_id as format_id, l.file as file from contexts as l join dict_sizes as r on l.right = r.dict and l.file = r.file where l.right_kind = "dict" and l.field_count <= r.size;
let contextual_items = select l.binop as binop, l.dict as dict, l.file as file, l.format_id as format_id, r.value as value, r.value_order as value_order, r.name as name from dict_contexts as l join named_items as r on l.dict = r.dict and l.file = r.file;
let mapped_items = select l.binop as binop, l.dict as dict, l.file as file, l.value as value, l.value_order as value_order, r.conversion as conversion from contextual_items as l join final_named_fields as r on l.format_id = r.format_id and l.file = r.file and l.name = r.name;
let missing_items = antijoin(left=contextual_items, right=mapped_items, left-on=["binop","value","file"], right-on=["binop","value","file"]);
let missing_stops = select dict, file, value_order from missing_items;
let dict_stops = union(left=unknown_key_stops, right=missing_stops);
let blocked_items = select l.binop as binop, l.file as file, l.value as value from mapped_items as l join dict_stops as r on l.dict = r.dict and l.file = r.file where r.value_order < l.value_order;
let reachable_items = antijoin(left=mapped_items, right=blocked_items, left-on=["binop","value","file"], right-on=["binop","value","file"]);
let dict_bindings = select binop, file, value, conversion from reachable_items;
let sequence_bindings = union(left=tuple_bindings, right=dict_bindings);
let bindings = union(left=scalar_bindings, right=sequence_bindings);
let typed_bindings = select l.binop as binop, l.file as file, l.value as value, l.conversion as conversion, r.resolution as resolution, r.type as type from bindings as l join "expression-type" as r on l.value = r.id and l.file = r.file where r.resolution = "atom" or r.resolution = "union";
let numeric_mismatches = select binop, file from typed_bindings where (conversion = "d" or conversion = "e" or conversion = "E" or conversion = "f" or conversion = "F" or conversion = "g" or conversion = "G") and type != "integer" and type != "boolean" and type != "float";
let integer_mismatches = select binop, file from typed_bindings where (conversion = "o" or conversion = "x" or conversion = "X") and type != "integer" and type != "boolean";
let char_mismatches = select * from typed_bindings where conversion = "c" and type != "integer" and type != "boolean";
let single_char_literals = select occurrence as id, file from "string-literal" where matches(value, "(?s)^.$");
let valid_literal_chars = select l.binop as binop, l.file as file, l.value as value from char_mismatches as l join single_char_literals as r on l.value = r.id and l.file = r.file where l.resolution = "atom" and l.type = "string";
let invalid_chars = antijoin(left=char_mismatches, right=valid_literal_chars, left-on=["binop","value","file"], right-on=["binop","value","file"]);
let char_reports = select binop, file from invalid_chars;
let numeric_reports = union(left=numeric_mismatches, right=integer_mismatches);
let reports = union(left=numeric_reports, right=char_reports);
let candidates = select l.binop as id, l.file as file, r.span as span from reports as l join binops as r on l.binop = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1307(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1307)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1307(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1307)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE1307"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
