import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let stubs = select id, file, span from "semantic-syntax" where kind = "if" and glob_any(file, "**/*.pyi");
let test_edges = select parent, child, file from "semantic-child" where field = "test";
let raw_tests = select l.parent as owner, l.child as test, l.file as file from test_edges as l join stubs as r on l.parent = r.id and l.file = r.file;
let boolops = select id, file from "semantic-syntax" where kind = "bool-op";
let bool_test_edges = select l.owner as owner, l.test as test, l.file as file from raw_tests as l join boolops as r on l.test = r.id and l.file = r.file;
let bool_values = select parent, child, file from "semantic-child" where field = "values";
let expanded_bool_tests = select l.owner as owner, r.child as test, l.file as file from bool_test_edges as l join bool_values as r on l.test = r.parent and l.file = r.file;
let simple_tests = antijoin(left=raw_tests, right=boolops, left-on=["test", "file"], right-on=["id", "file"]);
let tests = union(left=simple_tests, right=expanded_bool_tests);
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let left_fields = select parent, child from "semantic-child" where field = "left";
let lefts = select l.parent as comparison, l.child as left, r.file as file from left_fields as l join comparisons as r on l.parent = r.id;
let qname = select id, file from "qualified-name" where path = "sys.version_info" or path = "sys.platform";
let supported = select l.comparison as comparison, l.file as file from lefts as l join qname as r on l.left = r.id and l.file = r.file;
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_lefts = select l.comparison as comparison, l.file as file from lefts as l join subscripts as r on l.left = r.id and l.file = r.file;
let unknown_comparisons = antijoin(left=lefts, right=supported, left-on=["comparison", "file"], right-on=["comparison", "file"]);
let unknown_non_subscript = antijoin(left=unknown_comparisons, right=subscript_lefts, left-on=["comparison", "file"], right-on=["comparison", "file"]);
let bad_compare_tests = select l.test as test, l.file as file from tests as l join unknown_non_subscript as r on l.test = r.comparison and l.file = r.file;
let non_comparison_test_rows = antijoin(left=tests, right=comparisons, left-on=["test", "file"], right-on=["id", "file"]);
let non_compare_tests = select test, file from non_comparison_test_rows;
let operator_fields = select parent, child from "semantic-child" where field = "ops";
let operator_counts = group-count(from=operator_fields, keys=["parent"], count="count", distinct="child");
let multi_operator_compares = select parent as id from operator_counts where count != 1;
let multi_operator_tests = select l.test as test, l.file as file from tests as l join multi_operator_compares as r on l.test = r.id;
let non_simple_tests = union(left=bad_compare_tests, right=multi_operator_tests);
let invalid_tests = union(left=non_simple_tests, right=non_compare_tests);
let reportable = select l.test as id, r.file as file, r.span as span from invalid_tests as l join "semantic-syntax" as r on l.test = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI002(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI002)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI002)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI002)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI002"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
