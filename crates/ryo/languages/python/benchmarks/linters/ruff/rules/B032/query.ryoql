import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let annotations = select * from "semantic-syntax" where kind = "ann-assign";
let values = select parent, child from "semantic-child" where field = "value";
let unassigned = antijoin(left=annotations, right=values, left-on=["id"], right-on=["parent"]);
let targets = select parent, child from "semantic-child" where field = "target";
let subscripts = select id from "semantic-syntax" where kind = "subscript";
let attributes = select id from "semantic-syntax" where kind = "attribute";
let names = select id from "semantic-syntax" where kind = "name";
let identifiers = select parent, child from "semantic-child" where field = "id";
let self_tokens = select id from semantic_identifiers where text = "self";
let self_names = select l.parent as id from identifiers as l join self_tokens as r on l.child = r.id;
let other_names = antijoin(left=names, right=self_names, left-on=["id"], right-on=["id"]);
let named_bases = select l.parent as parent from values as l join names as r on l.child = r.id;
let other_bases = select l.parent as parent from values as l join other_names as r on l.child = r.id;
let subscript_targets = select l.id as id from subscripts as l join named_bases as r on l.id = r.parent;
let attribute_targets = select l.id as id from attributes as l join other_bases as r on l.id = r.parent;
let invalid_targets = union(left=subscript_targets, right=attribute_targets);
let invalid = select l.parent as parent from targets as l join invalid_targets as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from unassigned as l join invalid as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B032(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B032)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B032(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B032)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B032"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
