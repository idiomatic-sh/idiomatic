import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let subprocess_run_functions = select id, file from "qualified-name" where path = "subprocess.run";
let subprocess_run_calls = select l.call as call, l.file as file from call_functions as l join subprocess_run_functions as r on l.function = r.id and l.file = r.file;
let call_arguments = select parent as call, child as wrapper from "semantic-child";
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_arguments as l join argument_nodes as r on l.wrapper = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let call_keyword_nodes = select l.call as call, r.child as keyword, l.file as file from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id, file from "semantic-syntax" where kind = "keyword";
let actual_keywords = select l.call as call, l.keyword as keyword, l.file as file from call_keyword_nodes as l join keyword_nodes as r on l.keyword = r.id and l.file = r.file;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let run_keyword_nodes = select l.keyword as keyword, l.file as file from actual_keywords as l join subprocess_run_calls as r on l.call = r.call and l.file = r.file;
let keyword_arg_ids = select l.parent as keyword, l.child as id, r.file as file from keyword_arg_fields as l join run_keyword_nodes as r on l.parent = r.keyword;
let identifiers = select id, name, file from "identifier";
let named_keyword_args = select l.keyword as keyword, l.id as id, r.name as name, l.file as file from keyword_arg_ids as l join identifiers as r on l.id = r.id;
let run_universal_keywords = select keyword, id, file from named_keyword_args where name = "universal_newlines";
let reportable = select l.id as id, l.file as file, r.span as span from run_universal_keywords as l join "identifier" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP021(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP021)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP021(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP021)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP021"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
