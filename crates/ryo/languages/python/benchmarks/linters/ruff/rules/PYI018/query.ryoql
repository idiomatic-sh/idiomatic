import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let assignments = select id, file from "semantic-syntax" where kind = "assign";
let targets = select l.parent as assignment, l.child as target, l.file as file from "semantic-child" as l join assignments as r on l.parent = r.id and l.file = r.file where l.field = "targets";
let private_targets = select l.assignment as assignment, l.target as target, l.file as file from targets as l join "identifier" as r on l.target = r.id and l.file = r.file where starts_with(r.name, "_");
let values = select l.parent as assignment, l.child as value, l.file as file from "semantic-child" as l join assignments as r on l.parent = r.id and l.file = r.file where l.field = "value";
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let call_values = select l.assignment as assignment, l.value as call, l.file as file from values as l join calls as r on l.value = r.id and l.file = r.file;
let function_edges = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_edges as l join calls as r on l.parent = r.id;
let typevar_functions = select id, file from "qualified-name" where path = "typing.TypeVar" or path = "typing.ParamSpec" or path = "typing.TypeVarTuple";
let typevar_calls = select l.call as call, l.file as file from call_functions as l join typevar_functions as r on l.function = r.id and l.file = r.file;
let declaration_calls = select l.target as binding, r.call as call, l.file as file from private_targets as l join call_values as r on l.assignment = r.assignment and l.file = r.file;
let typevar_declarations = select l.binding as binding, l.file as file from declaration_calls as l join typevar_calls as r on l.call = r.call and l.file = r.file;
let uses = select binding, file from "binding-use";
let unused = antijoin(left=typevar_declarations, right=uses, left-on=["binding", "file"], right-on=["binding", "file"]);
let locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from "source-location" as r;
let candidates = select l.binding as id, l.file as file, r.span as span, r.line as line from unused as l join locations as r on l.binding = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PYI018)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI018"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
