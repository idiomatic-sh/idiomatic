import suppress from "python/ruff/suppress";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let bindings = select occurrence as binding, name, scope, phase, file from events where kind = "bind";
let used = select binding from "binding-use";
let unused = antijoin(left=bindings, right=used, left-on=["binding"], right-on=["binding"]);
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_unused = select l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.file as file from unused as l join functions as r on l.scope = r.id and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let builtin_locals = select reference as function, file from "binding-read" where name = "locals" and state = "builtin" and context = "value";
let locals_calls = select l.call as id, l.file as file from call_functions as l join builtin_locals as r on l.function = r.function and l.file = r.file;
let regular_functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let locals_owners = axis(from=locals_calls, relation="semantic-child", direction=nearest-ancestor, domain=regular_functions);
let locals_scopes = select r.related as scope, l.file as file from locals_calls as l join locals_owners as r on l.id = r.id and l.file = r.file;
let uses_locals = select l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.file as file from function_unused as l join locals_scopes as r on l.scope = r.scope and l.file = r.file;
let no_locals = antijoin(left=function_unused, right=uses_locals, left-on=["binding", "file"], right-on=["binding", "file"]);
let nonlocal_statements = select id, file from "semantic-syntax" where kind = "nonlocal";
let declaration_names = select parent, child from "semantic-child" where field = "names";
let nonlocal_name_nodes = select l.id as statement, r.child as name_id, l.file as file from nonlocal_statements as l join declaration_names as r on l.id = r.parent;
let nonlocal_names = select l.statement as statement, r.name as name, l.file as file from nonlocal_name_nodes as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let nonlocal_owners = axis(from=nonlocal_statements, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let owned_nonlocal_names = select l.name as name, l.file as file, r.related as owner from nonlocal_names as l join nonlocal_owners as r on l.statement = r.id and l.file = r.file;
let scope_ancestor_edges = select child as origin, parent as destination from "scope";
let scope_ancestors = closure(edges=scope_ancestor_edges, source="origin", destination="destination");
let nonlocal_outer_scopes = select l.name as name, l.file as file, r.destination as scope from owned_nonlocal_names as l join scope_ancestors as r on l.owner = r.origin;
let nonlocal_unused = select l.binding as binding, l.file as file from no_locals as l join nonlocal_outer_scopes as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let nonlocal_filtered = antijoin(left=no_locals, right=nonlocal_unused, left-on=["binding", "file"], right-on=["binding", "file"]);
let dummy = select binding, file from nonlocal_filtered where matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let non_dummy = antijoin(left=nonlocal_filtered, right=dummy, left-on=["binding","file"], right-on=["binding","file"]);
let magic_unused = select binding, file from non_dummy where name = "__tracebackhide__" or name = "__traceback_info__" or name = "__traceback_supplement__" or name = "__debuggerskip__";
let report_unused = antijoin(left=non_dummy, right=magic_unused, left-on=["binding", "file"], right-on=["binding", "file"]);
let nodes = select id, kind, file, span from "semantic-syntax";
let assignment_nodes = select id, file from nodes where kind = "assign";
let target_fields = select parent, child from "semantic-child" where field = "targets";
let assignment_target_roots = select l.id as statement, r.child as id, l.file as file from assignment_nodes as l join target_fields as r on l.id = r.parent;
let containers = select id, file from nodes where kind = "tuple" or kind = "list";
let unpacked_roots = select l.statement as statement, l.id as id, l.file as file from assignment_target_roots as l join containers as r on l.id = r.id and l.file = r.file;
let edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=edges, source="origin", destination="destination");
let unpacked_descendants = select l.statement as statement, r.destination as id, l.file as file from unpacked_roots as l join descendants as r on l.id = r.origin;
let unpacked_ids = select id, file from unpacked_roots;
let unpacked_children = select id, file from unpacked_descendants;
let unpacked_all = union(left=unpacked_ids, right=unpacked_children);
let unused_unpacked = select l.binding as id, l.file as file from report_unused as l join unpacked_all as r on l.binding = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from unused_unpacked as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF059(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF059)(?:,|$)");
emit violations subject file key(id);
