import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let logging_exception_functions = select id, file from "qualified-name" where path = "logging.exception" or path = "flask.current_app.logger.exception";
let logging_exception_calls = select l.call as call, l.file as file from call_functions as l join logging_exception_functions as r on l.function = r.id and l.file = r.file;
let exception_bindings = select l.occurrence as handler, l.name as name, l.file as file from "binding-event" as l join handlers as r on l.occurrence = r.id and l.file = r.file where l.kind = "bind";
let call_handler_ancestor_axes = axis(from=calls, relation="semantic-child", direction=ancestor, domain=handlers);
let call_handler_ancestors = select l.id as call, r.related as handler, l.file as file from calls as l join call_handler_ancestor_axes as r on l.id = r.id and l.file = r.file;
let argument_wrappers_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_argument_wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_wrappers_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_roots = select l.call as call, r.child as root, l.file as file from call_argument_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_roots = select l.call as call, r.child as keyword, l.file as file from call_argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_value_roots = select l.call as call, r.child as root, l.file as file from keyword_roots as l join keyword_value_fields as r on l.keyword = r.parent;
let argument_roots_union = union(left=positional_roots, right=keyword_value_roots);
let argument_roots = select call, root as id, file from argument_roots_union;
let names = select id, file from "semantic-syntax" where kind = "name";
let attribute_nodes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_calls = select l.call as call, l.function as attribute, l.file as file from call_functions as l join attribute_nodes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_children = select l.parent as attribute, r.child as token from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let identifier_edges = select r.child as id, l.name as name from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let attribute_names = select l.attribute as attribute, r.name as name from attr_children as l join identifiers as r on l.token = r.id;
let exception_attributes = select attribute from attribute_names where name = "exception";
let exception_attribute_calls = select l.call as call, l.attribute as attribute, l.file as file from attribute_calls as l join exception_attributes as r on l.attribute = r.attribute;
let attribute_value_fields = select parent, child from "semantic-child" where field = "value";
let attribute_base_edges = select l.attribute as attribute, r.child as base, l.file as file from exception_attribute_calls as l join attribute_value_fields as r on l.attribute = r.parent;
let name_id_fields = select parent, child from "semantic-child" where field = "id";
let attribute_name_tokens = select l.attribute as attribute, l.base as base, l.file as file, r.child as token from attribute_base_edges as l join name_id_fields as r on l.base = r.parent;
let name_bases = select l.attribute as attribute, l.base as base, l.file as file, r.name as name from attribute_name_tokens as l join identifiers as r on l.token = r.id;
let unqualified_logger_names = select * from name_bases where matches(name, "^(?:log.*|.*logger|.*logging|LOG.*|.*LOGGER|.*LOGGING)$");
let import_alias_nodes = select id, file from "semantic-syntax" where kind = "alias";
let import_bindings = select l.occurrence as binding, l.file as file from "binding-event" as l join import_alias_nodes as r on l.occurrence = r.id and l.file = r.file where l.kind = "bind";
let imported_base_uses = select l.base as base, r.binding as binding, l.file as file from unqualified_logger_names as l join "binding-use" as r on l.base = r.reference and l.file = r.file;
let imported_logger_bases = select l.base as base, l.file as file from imported_base_uses as l join import_bindings as r on l.binding = r.binding and l.file = r.file;
let nonimported_logger_names = antijoin(left=unqualified_logger_names,right=imported_logger_bases,left-on=["base", "file"],right-on=["base", "file"]);
let unresolved_logger_bases = select l.attribute as attribute, l.file as file from nonimported_logger_names as l join "binding-read" as r on l.base = r.reference and l.file = r.file where r.context = "value";
let fallback_logger_calls = select l.call as call, l.file as file from exception_attribute_calls as l join unresolved_logger_bases as r on l.attribute = r.attribute and l.file = r.file;
let expanded_logger_calls = union(left=logging_exception_calls, right=fallback_logger_calls);
let handler_body_fields = select parent, child from "semantic-child" where field = "body";
let handler_body_roots = select l.parent as handler, l.child as id, r.file as file from handler_body_fields as l join handlers as r on l.parent = r.id;
let handler_body_call_axes = axis(from=handler_body_roots, relation="semantic-child", direction=descendant, domain=calls);
let handler_body_calls = select l.handler as handler, r.related as call, l.file as file from handler_body_roots as l join handler_body_call_axes as r on l.id = r.id and l.file = r.file;
let nearest_handler_axes = axis(from=calls, relation="semantic-child", direction=nearest-ancestor, domain=handlers);
let nearest_handler_calls = select l.id as call, r.related as handler, l.file as file from calls as l join nearest_handler_axes as r on l.id = r.id and l.file = r.file;
let calls_in_nearest_handler_body = select l.handler as handler, l.call as call, l.file as file from handler_body_calls as l join nearest_handler_calls as r on l.handler = r.handler and l.call = r.call and l.file = r.file;
let logging_handler_calls = select l.handler as handler, l.call as call, l.file as file from calls_in_nearest_handler_body as l join expanded_logger_calls as r on l.call = r.call and l.file = r.file;
let argument_name_axes = axis(from=argument_roots, relation="semantic-child", direction=descendant, domain=names);
let descendant_argument_names = select l.call as call, r.related as name, l.file as file from argument_roots as l join argument_name_axes as r on l.id = r.id and l.file = r.file;
let direct_argument_names = select l.call as call, l.root as name, l.file as file from argument_roots_union as l join names as r on l.root = r.id and l.file = r.file;
let argument_names = union(left=descendant_argument_names, right=direct_argument_names);
let name_roots = select name as id, file from argument_names;
let name_attribute_axes = axis(from=name_roots, relation="semantic-child", direction=ancestor, domain=attribute_nodes);
let names_under_attributes = select id as name, file from name_attribute_axes;
let bare_argument_names = antijoin(left=argument_names, right=names_under_attributes, left-on=["name", "file"], right-on=["name", "file"]);
let name_uses = select reference as name, binding, file from "binding-use";
let argument_name_uses = select l.call as call, l.name as name, r.binding as binding, l.file as file from bare_argument_names as l join name_uses as r on l.name = r.name and l.file = r.file;
let matched_exception_uses = select l.call as call, l.name as name, l.binding as binding, l.file as file from argument_name_uses as l join logging_handler_calls as r on l.call = r.call and l.file = r.file;
let exception_name_uses = select l.call as call, l.name as name, r.handler as handler, l.file as file from matched_exception_uses as l join exception_bindings as r on l.binding = r.handler and l.file = r.file;
let matched_exception_names = select l.name as id, l.file as file from exception_name_uses as l join call_handler_ancestors as r on l.call = r.call and l.handler = r.handler and l.file = r.file;
let candidates = select l.id as id, r.span as span, l.file as file from matched_exception_names as l join "source-location" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])TRY401(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:TRY401)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TRY401)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY401)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TRY401"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
