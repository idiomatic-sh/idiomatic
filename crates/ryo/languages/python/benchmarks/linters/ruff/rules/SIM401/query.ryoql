import binding_type from "python/ruff/binding-type";
import without_effect from "python/ruff/without-effect";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let ifs = select id, file, span from nodes where kind = "if";
let elif_headers = source-matches(from=ifs, span="span", pattern="^elif\\b", output="header");
let plain_ifs = antijoin(left=ifs, right=elif_headers, left-on=["id","file"], right-on=["id","file"]);
let bodies = select parent, child, file from edges where field = "body";
let alternatives = select parent, child, file from edges where field = "orelse";
let body_counts = group-count(from=bodies, keys=["parent","file"], count="count");
let else_counts = group-count(from=alternatives, keys=["parent","file"], count="count");
let body_single = select l.id as id, l.file as file from plain_ifs as l join body_counts as r on l.id = r.parent and l.file = r.file where r.count = 1;
let both_single = select l.id as id, l.file as file from body_single as l join else_counts as r on l.id = r.parent and l.file = r.file where r.count = 1;
let body_branches = select l.id as id, l.file as file, r.child as body from both_single as l join bodies as r on l.id = r.parent and l.file = r.file;
let branches = select l.id as id, l.file as file, l.body as body, r.child as alternative from body_branches as l join alternatives as r on l.id = r.parent and l.file = r.file;
let assignments = select id, file from nodes where kind = "assign";
let body_assigns = select l.id as id, l.file as file, l.body as body, l.alternative as alternative from branches as l join assignments as r on l.body = r.id and l.file = r.file;
let assignment_pairs = select l.id as id, l.file as file, l.body as body, l.alternative as alternative from body_assigns as l join assignments as r on l.alternative = r.id and l.file = r.file;
let targets = select parent, child, file from edges where field = "targets";
let target_counts = group-count(from=targets, keys=["parent","file"], count="count");
let body_target_counts = select l.id as id, l.file as file, l.body as body, l.alternative as alternative from assignment_pairs as l join target_counts as r on l.body = r.parent and l.file = r.file where r.count = 1;
let one_target_pairs = select l.id as id, l.file as file, l.body as body, l.alternative as alternative from body_target_counts as l join target_counts as r on l.alternative = r.parent and l.file = r.file where r.count = 1;
let with_body_targets = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, r.child as body_target from one_target_pairs as l join targets as r on l.body = r.parent and l.file = r.file;
let with_targets = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.body_target as body_target, r.child as else_target from with_body_targets as l join targets as r on l.alternative = r.parent and l.file = r.file;
let shapes = select id, shape, file from "expression-shape";
let body_target_shapes = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, r.shape as target_shape from with_targets as l join shapes as r on l.body_target = r.id and l.file = r.file;
let else_target_shapes = select l.id as id, l.file as file, r.shape as target_shape from with_targets as l join shapes as r on l.else_target = r.id and l.file = r.file;
let equal_targets = select l.id as id, l.file as file, l.body as body, l.alternative as alternative from body_target_shapes as l join else_target_shapes as r on l.id = r.id and l.file = r.file and l.target_shape = r.target_shape;
let tests = select parent, child, file from edges where field = "test";
let with_tests = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, r.child as test from equal_targets as l join tests as r on l.id = r.parent and l.file = r.file;
let comparisons = select id, file from nodes where kind = "compare";
let comparison_tests = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.test as test from with_tests as l join comparisons as r on l.test = r.id and l.file = r.file;
let operations = select parent, child, file from edges where field = "ops";
let operation_counts = group-count(from=operations, keys=["parent","file"], count="count");
let single_tests = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.test as test from comparison_tests as l join operation_counts as r on l.test = r.parent and l.file = r.file where r.count = 1;
let with_operations = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.test as test, r.child as operation from single_tests as l join operations as r on l.test = r.parent and l.file = r.file;
let membership = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.test as test, r.text as op from with_operations as l join "semantic-syntax" as r on l.operation = r.id and l.file = r.file where r.text = "in" or r.text = "not in";
let lefts = select parent, child, file from edges where field = "left";
let with_keys = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.test as test, l.op as op, r.child as key from membership as l join lefts as r on l.test = r.parent and l.file = r.file;
let comparators = select parent, child, file from edges where field = "comparators";
let with_dicts = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.op as op, l.key as key, r.child as dictionary from with_keys as l join comparators as r on l.test = r.parent and l.file = r.file;
let dict_references = select dictionary as reference, file from with_dicts;
let dict_types = binding_type(references=dict_references, builtin="builtins.dict", typing="Dict", atom="dict");
let known_dicts = select l.id as id, l.file as file, l.body as body, l.alternative as alternative, l.op as op, l.key as key, l.dictionary as dictionary from with_dicts as l join dict_types as r on l.dictionary = r.reference and l.file = r.file;
let positive = select id, file, body as expected, alternative as fallback, key, dictionary from known_dicts where op = "in";
let negative = select id, file, alternative as expected, body as fallback, key, dictionary from known_dicts where op = "not in";
let normalized = union(left=positive, right=negative);
let values = select parent, child, file from edges where field = "value";
let expected_values = select l.id as id, l.file as file, l.fallback as fallback, l.key as key, l.dictionary as dictionary, r.child as value from normalized as l join values as r on l.expected = r.parent and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let expected_subscripts = select l.id as id, l.file as file, l.fallback as fallback, l.key as key, l.dictionary as dictionary, l.value as subscript from expected_values as l join subscripts as r on l.value = r.id and l.file = r.file;
let subscript_dicts = select l.id as id, l.file as file, l.fallback as fallback, l.key as key, l.dictionary as dictionary, l.subscript as subscript, r.child as receiver from expected_subscripts as l join values as r on l.subscript = r.parent and l.file = r.file;
let slices = select parent, child, file from edges where field = "slice";
let subscript_keys = select l.id as id, l.file as file, l.fallback as fallback, l.key as key, l.dictionary as dictionary, l.receiver as receiver, r.child as lookup from subscript_dicts as l join slices as r on l.subscript = r.parent and l.file = r.file;
let test_key_shapes = select l.id as id, l.file as file, r.shape as shape from subscript_keys as l join shapes as r on l.key = r.id and l.file = r.file;
let lookup_key_shapes = select l.id as id, l.file as file, r.shape as shape from subscript_keys as l join shapes as r on l.lookup = r.id and l.file = r.file;
let equal_keys = select l.id as id, l.file as file from test_key_shapes as l join lookup_key_shapes as r on l.id = r.id and l.file = r.file and l.shape = r.shape;
let test_dict_shapes = select l.id as id, l.file as file, r.shape as shape from subscript_keys as l join shapes as r on l.dictionary = r.id and l.file = r.file;
let receiver_shapes = select l.id as id, l.file as file, r.shape as shape from subscript_keys as l join shapes as r on l.receiver = r.id and l.file = r.file;
let equal_dicts = select l.id as id, l.file as file from test_dict_shapes as l join receiver_shapes as r on l.id = r.id and l.file = r.file and l.shape = r.shape;
let matching = select l.id as id, l.file as file from equal_keys as l join equal_dicts as r on l.id = r.id and l.file = r.file;
let matched = select l.id as id, l.file as file, l.fallback as fallback from subscript_keys as l join matching as r on l.id = r.id and l.file = r.file;
let fallback_values = select l.id as id, l.file as file, r.child as fallback from matched as l join values as r on l.fallback = r.parent and l.file = r.file;
let defaults = select fallback as id, file from fallback_values;
let safe_defaults = without_effect(expressions=defaults);
let safe = select l.id as id, l.file as file from fallback_values as l join safe_defaults as r on l.fallback = r.id and l.file = r.file;
let candidate_targets = select l.id as id, l.file as file, r.body_target as target from safe as l join with_targets as r on l.id = r.id and l.file = r.file;
let candidate_parts = select l.id as id, l.file as file, l.target as target, r.dictionary as dictionary, r.key as key from candidate_targets as l join subscript_keys as r on l.id = r.id and l.file = r.file;
let candidate_defaults = select l.id as id, l.file as file, l.target as target, l.dictionary as dictionary, l.key as key, r.value as default_value from candidate_parts as l join fallback_values as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, l.target as target, l.dictionary as dictionary, l.key as key, l.default_value as default_value from candidate_defaults as l join ifs as r on l.id = r.id and l.file = r.file;
let rendered_target = render-syntax(from=candidates, node="target", context="assignment-target", output="target_text");
let rendered_receiver = render-syntax(from=rendered_target, node="dictionary", context="attribute-receiver", output="receiver_text");
let rendered_key = render-syntax(from=rendered_receiver, node="key", context="positional-argument", output="key_text");
let rendered_default = render-syntax(from=rendered_key, node="default_value", context="positional-argument", output="default_text");
let fitting = fits-rendered(from=rendered_default, texts=["target_text", "receiver_text", "key_text", "default_text"], literals=["", " = ", ".get(", ", ", ")"], span="span", max-line=88, tab-width=4);
let located = select l.id as id, l.file as file, l.span as span, r."start-line" as line from fitting as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="(?:^|[^A-Z0-9])SIM401(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM401)(?:,|$)");
emit violations subject file key(id);
