import observation_matches from "python/ruff/suppress-matches";
import class_bases from "python/ruff/class-bases";
import metaclass from "python/ruff/metaclass";
import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let method_scope = select l.child as function, l.parent as class, l.file as file from "scope" as l join classes as r on l.parent = r.id and l.file = r.file;
let name_edges = select parent as function, child as name_id, file from "semantic-child" where field = "name";
let function_names = select l.function as function, l.name_id as name_id, r.name as name, l.file as file from name_edges as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let methods = select l.function as function, l.class as class, r.name as name, r.name_id as name_id, l.file as file from method_scope as l join function_names as r on l.function = r.function and l.file = r.file;
let decorators = select declaration as function, occurrence as decorator, file from "decorates";
let decorator_roots = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_origins = select l.function as function, r.path as path, l.file as file from decorator_roots as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let called_expressions = select l.function as function, r.child as expression, l.file as file from decorator_roots as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "func";
let called_origins = select l.function as function, r.path as path, l.file as file from called_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=called_origins);
let static_methods = select function, file from origins where path = "builtins.staticmethod" or path = "abc.abstractstaticmethod";
let abstract_methods = select function, file from direct_origins where path = "abc.abstractmethod" or path = "abc.abstractclassmethod" or path = "abc.abstractstaticmethod" or path = "abc.abstractproperty";
let overload_methods = select function, file from direct_origins where path = "typing.overload" or path = "typing_extensions.overload";
let excluded_methods0 = union(left=static_methods, right=abstract_methods);
let excluded_methods = union(left=excluded_methods0, right=overload_methods);
let concrete_methods = antijoin(left=methods, right=excluded_methods, left-on=["function", "file"], right-on=["function", "file"]);
let decorated_class_methods = select function, file from origins where path = "builtins.classmethod" or path = "abc.abstractclassmethod";
let implicit_class_methods = select function, file from methods where name = "__new__" or name = "__init_subclass__" or name = "__class_getitem__";
let class_method_kinds = union(left=decorated_class_methods, right=implicit_class_methods);
let class_methods = select l.function as function, l.class as class, l.name_id as name_id, l.file as file from concrete_methods as l join class_method_kinds as r on l.function = r.function and l.file = r.file;
let instance_methods = antijoin(left=concrete_methods, right=class_method_kinds, left-on=["function", "file"], right-on=["function", "file"]);
let args_edges = select parent as function, child as arguments, file from "semantic-child" where field = "args";
let method_args = select l.function as function, l.class as class, l.name_id as name_id, r.arguments as arguments, l.file as file from concrete_methods as l join args_edges as r on l.function = r.function and l.file = r.file;
let positional_edges = select parent as arguments, child as wrapper, ordinal, file from "semantic-child" where field = "args" or field = "posonlyargs";
let earlier_parameters = select l.arguments as arguments, r.wrapper as wrapper, l.file as file from positional_edges as l join positional_edges as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let first_wrappers = antijoin(left=positional_edges, right=earlier_parameters, left-on=["arguments", "wrapper", "file"], right-on=["arguments", "wrapper", "file"]);
let wrapper_parameters = select parent as wrapper, child as parameter, file from "semantic-child" where field = "args" or field = "posonlyargs";
let first_parameters = select l.arguments as arguments, r.parameter as parameter, l.file as file from first_wrappers as l join wrapper_parameters as r on l.wrapper = r.wrapper and l.file = r.file;
let method_first_parameters = select l.function as function, l.class as class, l.name_id as name_id, r.parameter as parameter, l.file as file from method_args as l join first_parameters as r on l.arguments = r.arguments and l.file = r.file;
let annotation_edges = select parent as parameter, child as annotation, file from "semantic-child" where field = "annotation";
let first_annotations = select l.function as function, l.class as class, l.name_id as name_id, r.annotation as annotation, l.file as file from method_first_parameters as l join annotation_edges as r on l.parameter = r.parameter and l.file = r.file;
let parsed_annotations = select l.function as function, l.class as class, l.name_id as name_id, r.root as annotation, l.file as file from first_annotations as l join "embedded-expression" as r on l.annotation = r.host and l.file = r.file;
let all_annotations = union(left=first_annotations, right=parsed_annotations);
let names = select id, file from "semantic-syntax" where kind = "name";
let instance_annotations = select l.function as function, l.class as class, l.name_id as name_id, l.annotation as typevar, l.file as file from all_annotations as l join instance_methods as r on l.function = r.function and l.file = r.file;
let instance_name_annotations = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, l.file as file from instance_annotations as l join names as r on l.typevar = r.id and l.file = r.file;
let class_annotations = select l.function as function, l.class as class, l.name_id as name_id, l.annotation as annotation, l.file as file from all_annotations as l join class_methods as r on l.function = r.function and l.file = r.file;
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let class_subscripts = select l.function as function, l.class as class, l.name_id as name_id, l.annotation as annotation, l.file as file from class_annotations as l join subscript_nodes as r on l.annotation = r.id and l.file = r.file;
let subscript_values = select l.function as function, l.class as class, l.name_id as name_id, l.annotation as annotation, r.child as value, l.file as file from class_subscripts as l join "semantic-child" as r on l.annotation = r.parent and l.file = r.file where r.field = "value";
let bare_type_names = select l.id as id, l.file as file from "qualified-name" as l join "identifier" as r on l.id = r.id and l.file = r.file where l.path = "builtins.type" and r.name = "type";
let class_type_values = select l.function as function, l.class as class, l.name_id as name_id, l.annotation as annotation, l.file as file from subscript_values as l join bare_type_names as r on l.value = r.id and l.file = r.file;
let class_typevar_nodes = select l.function as function, l.class as class, l.name_id as name_id, r.child as typevar, l.file as file from class_type_values as l join "semantic-child" as r on l.annotation = r.parent and l.file = r.file where r.field = "slice";
let class_name_annotations = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, l.file as file from class_typevar_nodes as l join names as r on l.typevar = r.id and l.file = r.file;
let typevar_annotations = union(left=instance_name_annotations, right=class_name_annotations);
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign";
let assign_value_edges = select l.parent as assignment, l.child as call, l.file as file from "semantic-child" as l join assignment_nodes as r on l.parent = r.id and l.file = r.file where l.field = "value";
let call_nodes = select id, file from "semantic-syntax" where kind = "call";
let assign_calls = select l.assignment as assignment, l.call as call, l.file as file from assign_value_edges as l join call_nodes as r on l.call = r.id and l.file = r.file;
let assign_call_functions = select l.assignment as assignment, r.child as func, l.file as file from assign_calls as l join "semantic-child" as r on l.call = r.parent and l.file = r.file where r.field = "func";
let typevar_constructors = select id, file from "qualified-name" where path = "typing.TypeVar" or path = "typing_extensions.TypeVar";
let typevar_assignments = select l.assignment as assignment, l.file as file from assign_call_functions as l join typevar_constructors as r on l.func = r.id and l.file = r.file;
let declarations = select id, file from "defines";
let declaration_ancestors = axis(from=declarations, relation="semantic-child", direction=nearest-ancestor, domain=assignment_nodes);
let declaration_assignments = select l.id as binding, r.related as assignment, l.file as file from declarations as l join declaration_ancestors as r on l.id = r.id and l.file = r.file;
let old_typevars = select l.binding as binding, l.file as file from declaration_assignments as l join typevar_assignments as r on l.assignment = r.assignment and l.file = r.file;
let annotated_typevar_names = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, r.name as name, l.file as file from typevar_annotations as l join "identifier" as r on l.typevar = r.id and l.file = r.file;
let new_typevars = select id as binding, name as name, owner as function, file from "defines" where refinement = "type-var";
let own_type_parameters = select l.function as function, l.typevar as typevar, l.file as file from annotated_typevar_names as l join new_typevars as r on l.name = r.name and l.function = r.function and l.file = r.file;
let stub_annotations = select function, typevar, file from annotated_typevar_names where matches(file, "\.pyi$");
let future_annotations = select file from "static-import" where target = "__future__.annotations";
let future_method_annotations = select l.function as function, l.typevar as typevar, l.file as file from annotated_typevar_names as l join future_annotations as r on l.file = r.file;
let embedded_annotation_axes = axis(from=names, relation="semantic-child", direction=ancestor, domain=names);
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_name_descendants = axis(from=embedded_roots, relation="semantic-child", direction=descendant, domain=names);
let embedded_name_roots = select id as related, file from embedded_roots;
let embedded_descendant_rows = select related, file from embedded_name_descendants;
let embedded_names = union(left=embedded_name_roots, right=embedded_descendant_rows);
let embedded_method_annotations = select l.function as function, l.typevar as typevar, l.file as file from annotated_typevar_names as l join embedded_names as r on l.typevar = r.related and l.file = r.file;
let deferred_annotations0 = union(left=stub_annotations, right=future_method_annotations);
let deferred_annotations = union(left=deferred_annotations0, right=embedded_method_annotations);
let ordinary_deferred_annotations = antijoin(left=deferred_annotations, right=own_type_parameters, left-on=["function", "typevar", "file"], right-on=["function", "typevar", "file"]);
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_events = select l.occurrence as binding, l.name as name, l.scope as scope, l.kind as kind, l.ordinal as ordinal, l.file as file from "binding-event" as l join modules as r on l.scope = r.id and l.file = r.file where l.kind = "bind" or l.kind = "delete" or l.kind = "cleanup";
let replaced_module_events = select l.binding as binding, l.file as file from module_events as l join module_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.ordinal < r.ordinal;
let final_module_events = antijoin(left=module_events, right=replaced_module_events, left-on=["binding", "file"], right-on=["binding", "file"]);
let module_bindings = select binding, name, file from final_module_events where kind = "bind";
let annotation_module_bindings = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, r.binding as binding, l.file as file from annotated_typevar_names as l join module_bindings as r on l.name = r.name and l.file = r.file;
let preferred_module_bindings = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, l.binding as binding, l.file as file from annotation_module_bindings as l join ordinary_deferred_annotations as r on l.function = r.function and l.typevar = r.typevar and l.file = r.file;
let lexical_typevars = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, r.binding as binding, l.file as file from typevar_annotations as l join "binding-use" as r on l.typevar = r.reference and l.file = r.file;
let nonpreferred_lexical_typevars = antijoin(left=lexical_typevars, right=preferred_module_bindings, left-on=["function", "typevar", "file"], right-on=["function", "typevar", "file"]);
let initially_resolved_typevars = union(left=nonpreferred_lexical_typevars, right=preferred_module_bindings);
let unresolved_deferred_annotations = antijoin(left=ordinary_deferred_annotations, right=initially_resolved_typevars, left-on=["function", "typevar", "file"], right-on=["function", "typevar", "file"]);
let unresolved_deferred_names = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, l.name as name, l.file as file from annotated_typevar_names as l join unresolved_deferred_annotations as r on l.function = r.function and l.typevar = r.typevar and l.file = r.file;
let lexical_scopes0 = union(left=classes, right=functions);
let lexical_scopes = union(left=lexical_scopes0, right=modules);
let scope_ancestor_axes = axis(from=lexical_scopes, relation="scope", direction=ancestor, domain=lexical_scopes);
let scope_ancestors = select id as inner_scope, related as outer_scope, file from scope_ancestor_axes;
let class_outer_scopes = select l.id as class, r.outer_scope as scope, l.file as file from classes as l join scope_ancestors as r on l.id = r.inner_scope and l.file = r.file;
let class_self_scopes = select id as class, id as scope, file from classes;
let class_visible_scopes = union(left=class_outer_scopes, right=class_self_scopes);
let scoped_events = select occurrence as binding, name, scope, kind, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let replaced_scoped_events = select l.binding as binding, l.file as file from scoped_events as l join scoped_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.ordinal < r.ordinal;
let final_scoped_events = antijoin(left=scoped_events, right=replaced_scoped_events, left-on=["binding", "file"], right-on=["binding", "file"]);
let deferred_search_scopes = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, l.name as name, r.scope as scope, l.file as file from unresolved_deferred_names as l join class_visible_scopes as r on l.class = r.class and l.file = r.file;
let deferred_binding_options = select l.function as function, l.class as class, l.name_id as name_id, l.typevar as typevar, r.binding as binding, r.scope as scope, r.kind as kind, l.file as file from deferred_search_scopes as l join final_scoped_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let option_ancestor_scopes = select l.function as function, l.typevar as typevar, l.scope as nearer_scope, r.outer_scope as outer_scope, l.file as file from deferred_binding_options as l join scope_ancestors as r on l.scope = r.inner_scope and l.file = r.file;
let farther_options = select l.function as function, l.typevar as typevar, l.binding as binding, l.file as file from deferred_binding_options as l join option_ancestor_scopes as r on l.function = r.function and l.typevar = r.typevar and l.scope = r.outer_scope and l.file = r.file;
let nearest_deferred_options = antijoin(left=deferred_binding_options, right=farther_options, left-on=["function", "typevar", "binding", "file"], right-on=["function", "typevar", "binding", "file"]);
let forward_deferred_typevars = select function, class, name_id, typevar, binding, file from nearest_deferred_options where kind = "bind";
let resolved_typevars = union(left=initially_resolved_typevars, right=forward_deferred_typevars);
let old_typevar_methods = select l.function as function, l.class as class, l.name_id as name_id, l.file as file from resolved_typevars as l join old_typevars as r on l.binding = r.binding and l.file = r.file;
let new_typevar_methods = select l.function as function, l.class as class, l.name_id as name_id, l.file as file from annotated_typevar_names as l join new_typevars as r on l.name = r.name and l.function = r.function and l.file = r.file;
let typevar_methods = union(left=old_typevar_methods, right=new_typevar_methods);
let module_event_ordinals = select l.id as initial_scope, l.file as file, r.ordinal as point from modules as l join "binding-event" as r on l.id = r.scope and l.file = r.file;
let prior_module_ordinals = select l.initial_scope as initial_scope, l.point as point, l.file as file from module_event_ordinals as l join module_event_ordinals as r on l.initial_scope = r.initial_scope and l.file = r.file where l.point < r.point;
let last_module_ordinals = antijoin(left=module_event_ordinals, right=prior_module_ordinals, left-on=["initial_scope", "point", "file"], right-on=["initial_scope", "point", "file"]);
let ordered_contexts = select l.function as context, r.initial_scope as initial_scope, r.point as point, l.file as file from typevar_methods as l join last_module_ordinals as r on l.file = r.file;
let contextual_class_bases = class_bases(ordered_contexts=ordered_contexts);
let metaclass_root_classes = select function as context, class, file from typevar_methods;
let metaclass_mode_rows = extend(from=ordered_contexts, values={mode: 1});
let metaclass_modes = select context, mode, file from metaclass_mode_rows;
let metaclass_classifications = metaclass(ordered_contexts=ordered_contexts, resolved_base_edges=contextual_class_bases, modes=metaclass_modes, root_classes=metaclass_root_classes);
let all_metaclasses = select context, class, file from metaclass_classifications where certainty = "yes";
let nonmetaclass_methods = antijoin(left=typevar_methods, right=all_metaclasses, left-on=["function", "class", "file"], right-on=["context", "class", "file"]);
let locations = select id, span, "start-line", "start-byte", "end-byte", file from "source-location";
let return_edges = select parent as function, child as annotation, file from "semantic-child" where field = "returns";
let annotated_ends = select l.function as function, l.class as class, l.name_id as name_id, r.annotation as end_node, l.file as file from nonmetaclass_methods as l join return_edges as r on l.function = r.function and l.file = r.file;
let methods_without_return = antijoin(left=nonmetaclass_methods, right=return_edges, left-on=["function", "file"], right-on=["function", "file"]);
let parameter_ends = select l.function as function, l.class as class, l.name_id as name_id, r.arguments as end_node, l.file as file from methods_without_return as l join args_edges as r on l.function = r.function and l.file = r.file;
let all_end_nodes = union(left=annotated_ends, right=parameter_ends);
let physical_tokens = select l.id as token, l.file as file, r.span as span, r."start-byte" as start_byte from "syntax-tree" as l join locations as r on l.id = r.id and l.file = r.file;
let name_ends = select l.function as id, l.end_node as end_node, l.file as file, r."end-byte" as name_end, r."start-line" as line from all_end_nodes as l join locations as r on l.name_id = r.id and l.file = r.file;
let name_bounds = select l.id as id, l.end_node as end_node, l.file as file, r.span as name_span, l.line as line from name_ends as l join physical_tokens as r on l.name_end = r.start_byte and l.file = r.file;
let bounds = select l.id as id, l.file as file, l.name_span as name_span, l.line as line, r.span as end_span from name_bounds as l join locations as r on l.end_node = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="name_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations = suppress(candidates=candidates, inline-pattern="PYI019($|[, #])", range-pattern="(?:^|,)PYI019(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="PYI019($|[, #])", range-pattern="(?:^|,)PYI019(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI019"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
