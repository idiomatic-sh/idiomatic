import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let body_counts = group-count(from=bodies, keys=["parent"], count="count", distinct="ordinal");
let multiple = select parent as id from body_counts where count > 1;
let single = antijoin(left=bodies, right=multiple, left-on=["parent"], right-on=["id"]);
let ellipsis_tokens = select id from "semantic-syntax" where text = "...";
let ellipsis_values = select r.parent as id from ellipsis_tokens as l join "semantic-child" as r on l.id = r.child;
let values = select parent, child from "semantic-child" where field = "value";
let expressions = select id from "semantic-syntax" where kind = "expr";
let raw_ellipsis = select l.parent as id from values as l join ellipsis_values as r on l.child = r.id;
let ellipsis_statements = select l.id as id from raw_ellipsis as l join expressions as r on l.id = r.id;
let functions = select id from "semantic-syntax" where (kind = "function-def" or kind = "async-function-def") and glob_any(file, "**/*.pyi");
let scoped = select r.child as id from functions as l join single as r on l.id = r.parent;
let constants = select id from "semantic-syntax" where kind = "constant";
let string_values = select l.id as id from constants as l join "string-literal" as r on l.id = r.occurrence;
let raw_strings = select l.parent as id from values as l join string_values as r on l.child = r.id;
let strings = select l.id as id from raw_strings as l join expressions as r on l.id = r.id;
let passes = select id from "semantic-syntax" where kind = "pass";
let empty = union(left=ellipsis_statements, right=passes);
let allowed = union(left=empty, right=strings);
let invalid = antijoin(left=scoped, right=allowed, left-on=["id"], right-on=["id"]);
let reportable = select r.id as id, r.file as file, r.span as span from invalid as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="PYI010");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PYI010") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
