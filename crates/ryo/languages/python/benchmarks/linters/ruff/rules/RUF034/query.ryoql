import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let shapes = select id, shape, file from "expression-shape";
let body_fields = select parent, child from "semantic-child" where field = "body";
let else_fields = select parent, child from "semantic-child" where field = "orelse";
let body_shapes = select l.parent as id, r.shape as body, r.file as file from body_fields as l join shapes as r on l.child = r.id;
let else_shapes = select l.parent as id, r.shape as other, r.file as file from else_fields as l join shapes as r on l.child = r.id;
let branches = select l.id as id, l.file as file, l.body as body, r.other as other from body_shapes as l join else_shapes as r on l.id = r.id and l.file = r.file;
let conditionals = select id, file, span from "semantic-syntax" where kind = "if-exp";
let matching = select id from branches where body = other;
let reportable = select l.id as id, l.file as file, l.span as span from conditionals as l join matching as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:RUF034)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF034"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
