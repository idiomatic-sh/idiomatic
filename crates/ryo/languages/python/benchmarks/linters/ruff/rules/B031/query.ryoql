import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, ordinal, file from "semantic-child";
let ancestry_edges = select child as origin, parent as destination from edges;
let ancestry = closure(edges=ancestry_edges, source="origin", destination="destination");
let loops = select id, file from nodes where kind = "for";
let calls = select id, file from nodes where kind = "call";
let call_functions = select l.id as call, r.child as function, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "func";
let groupby_names = select id, file from "qualified-name" where path = "itertools.groupby";
let groupby_calls = select l.call as id, l.file as file from call_functions as l join groupby_names as r on l.function = r.id and l.file = r.file;
let loop_iterables = select l.id as loop, r.child as iterable, l.file as file from loops as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "iter";
let group_loops = select l.loop as loop, l.file as file from loop_iterables as l join groupby_calls as r on l.iterable = r.id and l.file = r.file;
let targets = select l.loop as loop, r.child as target, l.file as file from group_loops as l join edges as r on l.loop = r.parent and l.file = r.file where r.field = "target";
let tuple_nodes = select id, file from nodes where kind = "tuple";
let tuple_targets = select l.loop as loop, l.target as target, l.file as file from targets as l join tuple_nodes as r on l.target = r.id and l.file = r.file;
let tuple_members = select l.loop as loop, r.child as id, r.ordinal as ordinal, l.file as file from tuple_targets as l join edges as r on l.target = r.parent and l.file = r.file where r.field = "elts";
let earlier_tuple_members = select l.loop as loop, l.id as id, r.id as earlier, l.file as file from tuple_members as l join tuple_members as r on l.loop = r.loop and l.file = r.file where r.ordinal < l.ordinal;
let tuple_ranks = group-count(from=earlier_tuple_members, keys=["loop","id","file"], count="rank", distinct="earlier");
let excess_members = select loop, file from tuple_ranks where rank > 1;
let second_members = select loop, id, file from tuple_ranks where rank = 1;
let exact_second = antijoin(left=second_members, right=excess_members, left-on=["loop","file"], right-on=["loop","file"]);
let names = select id, file from nodes where kind = "name";
let group_targets = select l.loop as loop, l.id as id, l.file as file from exact_second as l join names as r on l.id = r.id and l.file = r.file;
let events = select occurrence, name, scope, phase, ordinal, kind, file from "binding-event";
let groups = select l.loop as loop, l.id as binding, r.name as name, r.scope as scope, r.phase as phase, r.ordinal as point, l.file as file from group_targets as l join events as r on l.id = r.occurrence and l.file = r.file where r.kind = "bind";
let uses = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, r.phase as phase, r.reference as id, l.file as file from groups as l join "binding-use" as r on l.binding = r.binding and l.file = r.file;
let body_roots = select l.loop as loop, r.child as root, l.file as file from group_loops as l join edges as r on l.loop = r.parent and l.file = r.file where r.field = "body";
let body_members = select l.loop as loop, r.origin as id, l.file as file from body_roots as l join ancestry as r on l.root = r.destination;
let direct_body_members = select loop, root as id, file from body_roots;
let all_body_members = union(left=body_members, right=direct_body_members);
let body_uses = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.id as id, l.file as file from uses as l join all_body_members as r on l.loop = r.loop and l.id = r.id and l.file = r.file;
let wrapper_nodes = select id, file from nodes where kind = "call-arguments";
let call_wrapper_candidates = select l.id as call, r.child as wrapper, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file ;
let call_wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from call_wrapper_candidates as l join wrapper_nodes as r on l.wrapper = r.id and l.file = r.file;
let positional_arguments = select l.call as call, r.child as id, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let keyword_arguments = select l.call as call, r.child as keyword, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_values = select l.call as call, r.child as id, l.file as file from keyword_arguments as l join edges as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let call_arguments = union(left=positional_arguments, right=keyword_values);
let harmless_functions = select id, file from "qualified-name" where provenance = "builtin" and (path = "builtins.print" or path = "builtins.repr" or path = "builtins.id" or path = "builtins.type" or path = "builtins.bool" or path = "builtins.isinstance" or path = "builtins.iter" or path = "builtins.next");
let harmless_calls = select l.call as call, l.file as file from call_functions as l join harmless_functions as r on l.function = r.id and l.file = r.file;
let consuming_arguments = antijoin(left=call_arguments, right=harmless_calls, left-on=["call","file"], right-on=["call","file"]);
let forwarding_uses = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.id as id, l.file as file from body_uses as l join consuming_arguments as r on l.id = r.id and l.file = r.file;
let iteration_edges = select child as id, file from edges where field = "iter";
let iteration_uses = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.id as id, l.file as file from body_uses as l join iteration_edges as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let starred_values = select r.child as id, l.file as file from starred_nodes as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "value";
let unpacking_uses = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.id as id, l.file as file from body_uses as l join starred_values as r on l.id = r.id and l.file = r.file;
let call_and_iteration_uses = union(left=forwarding_uses, right=iteration_uses);
let potential_uses = union(left=call_and_iteration_uses, right=unpacking_uses);
let points = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.phase as phase, l.id as id, r.ordinal as point, l.file as file from potential_uses as l join events as r on l.id = r.occurrence and l.file = r.file where r.kind = "read";
let pairs = select l.loop as loop, l.id as previous, r.id as current, l.point as previous_point, r.point as current_point, l.phase as phase, l.file as file from points as l join points as r on l.loop = r.loop and l.file = r.file and l.phase = r.phase where l.point < r.point;
let branch_nodes = select id, kind, file from nodes where kind = "if" or kind = "if-exp" or kind = "match";
let branch_edges = select l.id as owner, l.kind as kind, r.child as root, r.field as field, l.file as file from branch_nodes as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body" or r.field = "orelse" or r.field = "cases";
let branch_members = select l.owner as owner, l.kind as kind, l.root as root, l.field as field, r.origin as id, l.file as file from branch_edges as l join ancestry as r on l.root = r.destination;
let direct_branch_members = select owner, kind, root, field, root as id, file from branch_edges;
let all_branch_members = union(left=branch_members, right=direct_branch_members);
let branch_paths = select owner, owner as arm, id, file from all_branch_members where (kind = "if" or kind = "if-exp") and field = "body";
let alternate_paths = select owner, root as arm, id, file from all_branch_members where kind = "match" or field = "orelse";
let paths = union(left=branch_paths, right=alternate_paths);
let previous_paths = select p.loop as loop, p.previous as previous, p.current as current, b.owner as owner, b.arm as arm, p.file as file from pairs as p join paths as b on p.previous = b.id and p.file = b.file;
let exclusive = select p.loop as loop, p.previous as previous, p.current as current, p.file as file from previous_paths as p join paths as b on p.current = b.id and p.owner = b.owner and p.file = b.file where p.arm != b.arm;
let repeated_pairs = antijoin(left=pairs, right=exclusive, left-on=["loop","previous","current","file"], right-on=["loop","previous","current","file"]);
let phase_owners = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let ordinary_phase_roots = select l.id as phase, r.child as id, l.file as file from phase_owners as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body";
let generator_owners = select id, file from nodes where kind = "generator-exp";
let generator_phase_roots = select l.id as phase, r.child as id, l.file as file from generator_owners as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "elt";
let phase_roots = union(left=ordinary_phase_roots, right=generator_phase_roots);
let exit_nodes = select id, kind, file from nodes where kind = "break" or kind = "continue" or kind = "return";
let exit_positions = select l.id as id, l.kind as kind, l.file as file, r."start-byte" as start from exit_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let loop_nodes = select id, file from nodes where kind = "for" or kind = "while" or kind = "async-for";
let exit_phase_axes = axis(from=exit_nodes, relation="semantic-child", direction=nearest-ancestor, domain=phase_roots);
let inherited_exit_phases0 = select l.id as id, r.phase as phase, l.file as file from exit_phase_axes as l join phase_roots as r on l.related = r.id and l.file = r.file;
let direct_exit_phases = select l.id as id, r.phase as phase, l.file as file from exit_nodes as l join phase_roots as r on l.id = r.id and l.file = r.file;
let inherited_exit_phases = antijoin(left=inherited_exit_phases0, right=direct_exit_phases, left-on=["id","file"], right-on=["id","file"]);
let exit_phases = union(left=inherited_exit_phases, right=direct_exit_phases);
let phased_exits = select l.id as id, l.kind as kind, l.file as file, l.start as start, r.phase as phase from exit_positions as l join exit_phases as r on l.id = r.id and l.file = r.file;
let exit_loops = axis(from=exit_nodes, relation="semantic-child", direction=nearest-ancestor, domain=loop_nodes);
let jumps_with_loop = select l.id as id, l.kind as kind, l.file as file, l.start as start, l.phase as phase, r.related as loop from phased_exits as l join exit_loops as r on l.id = r.id and l.file = r.file;
let pair_start = select l.loop as loop, l.previous as previous, l.current as current, l.phase as phase, l.file as file, r."start-byte" as start from repeated_pairs as l join "source-location" as r on l.previous = r.id and l.file = r.file;
let pair_positions = select l.loop as loop, l.previous as previous, l.current as current, l.phase as phase, l.file as file, l.start as start, r."start-byte" as end from pair_start as l join "source-location" as r on l.current = r.id and l.file = r.file;
let possible_exits = select p.loop as loop, p.previous as previous, p.current as current, e.id as exit, p.file as file from pair_positions as p join jumps_with_loop as e on p.file = e.file and p.phase = e.phase where p.start < e.start and e.start < p.end and (e.kind = "return" or e.loop = p.loop);
let exit_paths = select e.loop as loop, e.previous as previous, e.current as current, e.exit as exit, b.owner as owner, b.arm as arm, e.file as file from possible_exits as e join paths as b on e.exit = b.id and e.file = b.file;
let prior_exit_paths = select e.loop as loop, e.previous as previous, e.current as current, e.exit as exit, b.owner as owner, b.arm as arm, e.file as file from possible_exits as e join paths as b on e.previous = b.id and e.file = b.file;
let contingent_exit_paths = antijoin(left=exit_paths, right=prior_exit_paths, left-on=["loop","previous","current","exit","owner","arm","file"], right-on=["loop","previous","current","exit","owner","arm","file"]);
let contingent_exits = select loop, previous, current, exit, file from contingent_exit_paths;
let certain_exits = antijoin(left=possible_exits, right=contingent_exits, left-on=["loop","previous","current","exit","file"], right-on=["loop","previous","current","exit","file"]);
let surviving_pairs = antijoin(left=repeated_pairs, right=certain_exits, left-on=["loop","previous","current","file"], right-on=["loop","previous","current","file"]);
let repeated = select current as id, file from surviving_pairs;
let repeated_regions0 = select id, file from nodes where kind = "for" or kind = "while" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let literal_sequences = select id, file from nodes where kind = "list" or kind = "tuple" or kind = "set";
let literal_members = select l.id as sequence, r.child as member, l.file as file from literal_sequences as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let literal_sizes = group-count(from=literal_members, keys=["sequence","file"], count="count", distinct="member");
let many_literal_members = select sequence as id, file from literal_sizes where count > 1;
let expanded_literal_members = select l.sequence as id, l.file as file from literal_members as l join starred_nodes as r on l.member = r.id and l.file = r.file;
let potentially_many_literals = union(left=many_literal_members, right=expanded_literal_members);
let at_most_one_literals = antijoin(left=literal_sequences, right=potentially_many_literals, left-on=["id","file"], right-on=["id","file"]);
let direct_region_iterables = select l.id as region, r.child as iterable, l.file as file from repeated_regions0 as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "iter";
let small_statement_regions = select l.region as id, l.file as file from direct_region_iterables as l join at_most_one_literals as r on l.iterable = r.id and l.file = r.file;
let comprehension_regions = select id, file from nodes where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let all_comp_clauses = select l.id as region, r.child as clause, l.file as file from comprehension_regions as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let comp_iterables = select l.region as region, l.clause as clause, r.child as iterable, l.file as file from all_comp_clauses as l join edges as r on l.clause = r.parent and l.file = r.file where r.field = "iter";
let small_comp_clauses = select l.region as region, l.clause as clause, l.file as file from comp_iterables as l join at_most_one_literals as r on l.iterable = r.id and l.file = r.file;
let possibly_many_comp_clauses = antijoin(left=all_comp_clauses, right=small_comp_clauses, left-on=["region","clause","file"], right-on=["region","clause","file"]);
let small_comprehension_regions = antijoin(left=comprehension_regions, right=possibly_many_comp_clauses, left-on=["id","file"], right-on=["region","file"]);
let small_regions = union(left=small_statement_regions, right=small_comprehension_regions);
let repeated_regions = antijoin(left=repeated_regions0, right=small_regions, left-on=["id","file"], right-on=["id","file"]);
let basic_repeated_roots = select l.id as region, r.child as root, l.file as file from repeated_regions as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body" or r.field = "elt" or r.field = "key" or r.field = "value";
let repeated_clauses = select l.id as region, r.child as clause, r.ordinal as ordinal, l.file as file from repeated_regions as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let potentially_repeating_clauses = select l.region as region, l.clause as clause, l.ordinal as ordinal, l.file as file from repeated_clauses as l join possibly_many_comp_clauses as r on l.region = r.region and l.clause = r.clause and l.file = r.file;
let later_clauses = select l.region as region, l.clause as clause, l.file as file from repeated_clauses as l join potentially_repeating_clauses as r on l.region = r.region and l.file = r.file where r.ordinal < l.ordinal;
let later_iterables = select l.region as region, r.child as root, l.file as file from later_clauses as l join edges as r on l.clause = r.parent and l.file = r.file where r.field = "iter";
let repeated_filter_clauses = select l.region as region, l.clause as clause, l.file as file from repeated_clauses as l join potentially_repeating_clauses as r on l.region = r.region and l.file = r.file where r.ordinal <= l.ordinal;
let repeated_filters = select l.region as region, r.child as root, l.file as file from repeated_filter_clauses as l join edges as r on l.clause = r.parent and l.file = r.file where r.field = "ifs";
let repeated_clause_roots = union(left=later_iterables, right=repeated_filters);
let repeated_roots = union(left=basic_repeated_roots, right=repeated_clause_roots);
let repeated_members = select l.region as region, r.origin as id, l.file as file from repeated_roots as l join ancestry as r on l.root = r.destination;
let direct_repeated_members = select region, root as id, file from repeated_roots;
let all_repeated_members = union(left=repeated_members, right=direct_repeated_members);
let region_phase_axes = axis(from=repeated_regions, relation="semantic-child", direction=nearest-ancestor, domain=phase_roots);
let inherited_region_phases0 = select l.id as region, r.phase as phase, l.file as file from region_phase_axes as l join phase_roots as r on l.related = r.id and l.file = r.file;
let direct_region_phases = select l.id as region, r.phase as phase, l.file as file from repeated_regions as l join phase_roots as r on l.id = r.id and l.file = r.file;
let inherited_region_phases = antijoin(left=inherited_region_phases0, right=direct_region_phases, left-on=["region","file"], right-on=["region","file"]);
let ordinary_region_phases = union(left=inherited_region_phases, right=direct_region_phases);
let generator_region_phases = select id as region, id as phase, file from generator_owners;
let non_generator_region_phases = antijoin(left=ordinary_region_phases, right=generator_region_phases, left-on=["region","file"], right-on=["region","file"]);
let region_phases = union(left=non_generator_region_phases, right=generator_region_phases);
let inner_regions = select l.loop as loop, r.id as region, l.file as file from all_body_members as l join repeated_regions as r on l.id = r.id and l.file = r.file;
let repeated_uses0 = select l.loop as loop, l.id as id, l.phase as phase, r.region as region, l.file as file from points as l join all_repeated_members as r on l.id = r.id and l.file = r.file where l.loop != r.region;
let repeated_uses = select l.id as id, l.phase as phase, l.region as region, l.file as file from repeated_uses0 as l join inner_regions as r on l.loop = r.loop and l.region = r.region and l.file = r.file;
let nested_repeat = select l.id as id, l.file as file from repeated_uses as l join region_phases as r on l.region = r.region and l.phase = r.phase and l.file = r.file;
let report_ids = union(left=repeated, right=nested_repeat);
let candidates = select l.id as id, l.file as file, r.span as span from report_ids as l join nodes as r on l.id = r.id and l.file = r.file;
let locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B031(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B031)(?:,|$)");
let ruf100_matches = observation_matches(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B031(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B031)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B031"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
