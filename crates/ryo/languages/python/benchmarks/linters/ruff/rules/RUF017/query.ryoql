import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = call_syntax();
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let sums = select call, file from qualified_calls where path = "builtins.sum";
let positional_sums = select l.call as call, l.file as file from sums as l join positional_counts as r on l.call = r.call and l.file = r.file;
let start_keywords = select call, file, value from named_keyword_values where name = "start";
let preceding_arguments = select l.call as call, l.file as file, l.value as value, l.position as position, r.value as earlier from positional_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where r.position < l.position;
let preceding_counts = group-count(from=preceding_arguments, keys=["call","file","value","position"], count="count", distinct="earlier");
let second_arguments = select call, file, value, position from preceding_counts where count = 1;
let starred_arguments = select l.call as call, l.file as file, l.position as position from positional_arguments as l join starred_nodes as r on l.value = r.id and l.file = r.file;
let blocked_arguments = select l.call as call, l.file as file, l.value as value from second_arguments as l join starred_arguments as r on l.call = r.call and l.file = r.file where r.position <= l.position;
let unstarred_second_arguments = antijoin(left=second_arguments, right=blocked_arguments, left-on=["call","file","value"], right-on=["call","file","value"]);
let positional_starts = antijoin(left=unstarred_second_arguments, right=start_keywords, left-on=["call","file"], right-on=["call","file"]);
let projected_positional_starts = select call, file, value from positional_starts;
let start_arguments = union(left=start_keywords, right=projected_positional_starts);
let lists = select id, file from nodes where kind = "list";
let nonempty_lists = select parent as id, file from element_edges;
let empty_lists = antijoin(left=lists, right=nonempty_lists, left-on=["id","file"], right-on=["id","file"]);
let list_constructors = select call, file from qualified_calls where path = "builtins.list";
let empty_list_constructors = select l.call as id, l.file as file from list_constructors as l join empty_calls as r on l.call = r.id and l.file = r.file;
let empty_list_values = union(left=empty_lists, right=empty_list_constructors);
let empty_starts = select l.call as call, l.file as file from start_arguments as l join empty_list_values as r on l.value = r.id and l.file = r.file;
let summations = select l.call as call, l.file as file from positional_sums as l join empty_starts as r on l.call = r.call and l.file = r.file;
let candidates = select l.call as id, l.file as file, r.span as span from summations as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:RUF017)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF017"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
