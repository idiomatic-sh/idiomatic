import suppress from "python/ruff/suppress";
let assertions = select id, file from "semantic-syntax" where kind = "assert";
let message_fields = select parent, child from "semantic-child" where field = "msg";
let calls = select id, file from "semantic-syntax" where kind = "call";
let message_calls = select l.parent as assertion, r.id as call, r.file as file from message_fields as l join calls as r on l.child = r.id;
let asserted_calls = select l.call as call, l.file as file from message_calls as l join assertions as r on l.assertion = r.id and l.file = r.file;
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join asserted_calls as r on l.parent = r.call;
let builtin_prints = select id, file from "qualified-name" where path = "builtins.print" and (provenance = "builtin" or provenance = "import");
let print_calls = select l.call as id, l.file as file from call_functions as l join builtin_prints as r on l.function = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from print_calls as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF030(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF030)(?:,|$)");
emit violations subject file key(id);
