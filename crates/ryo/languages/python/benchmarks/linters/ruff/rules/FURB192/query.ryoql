import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = call_syntax();
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let sorted_calls = select call, file from qualified_calls where path = "builtins.sorted";
let single_sorted_calls = select l.call as call, l.file as file from sorted_calls as l join single_arguments as r on l.call = r.call and l.file = r.file;
let good_keyword_names = select keyword, call, file from keyword_names where name = "reverse" or name = "key";
let bad_keyword_occurrences = antijoin(left=keyword_owners, right=good_keyword_names, left-on=["id","related","file"], right-on=["keyword","call","file"]);
let invalid_keywords = select related as call, file from bad_keyword_occurrences;
let boolean_values = select id, file from "literal-properties" where kind = "boolean";
let reverse_keywords = select call, file, value from named_keyword_values where name = "reverse";
let unknown_reverse_values = antijoin(left=reverse_keywords, right=boolean_values, left-on=["value","file"], right-on=["id","file"]);
let known_keywords = antijoin(left=single_sorted_calls, right=invalid_keywords, left-on=["call","file"], right-on=["call","file"]);
let supported_sorts = antijoin(left=known_keywords, right=unknown_reverse_values, left-on=["call","file"], right-on=["call","file"]);
let one_tokens = select id, file from "semantic-syntax" where kind = "number" and matches(text, "^(?:1|0[xXoObB][0_]*1)$");
let numeric_children = select l.parent as id, l.file as file from "semantic-child" as l join one_tokens as r on l.child = r.id and l.file = r.file;
let ones = select l.id as id, l.file as file from constants as l join numeric_children as r on l.id = r.id and l.file = r.file;
let unary_nodes = select id, file from nodes where kind = "unary-op";
let op_edges = select parent, child, file from "semantic-child" where field = "op";
let unary_ops = select l.id as id, l.file as file, r.child as op from unary_nodes as l join op_edges as r on l.id = r.parent and l.file = r.file;
let minuses = select l.id as id, l.file as file from unary_ops as l join "semantic-syntax" as r on l.op = r.id and l.file = r.file where r.text = "-";
let operand_edges = select parent, child, file from "semantic-child" where field = "operand";
let minus_operands = select l.id as id, l.file as file, r.child as operand from minuses as l join operand_edges as r on l.id = r.parent and l.file = r.file;
let minus_ones = select l.id as id, l.file as file from minus_operands as l join ones as r on l.operand = r.id and l.file = r.file;
let supported_indices = union(left=plain_zero, right=minus_ones);
let subscripts = select id, file, span from nodes where kind = "subscript";
let slice_edges = select parent, child, file from "semantic-child" where field = "slice";
let subscript_indices = select l.id as id, l.file as file, l.span as span, r.child as index from subscripts as l join slice_edges as r on l.id = r.parent and l.file = r.file;
let end_subscripts = select l.id as id, l.file as file, l.span as span from subscript_indices as l join supported_indices as r on l.index = r.id and l.file = r.file;
let indexed_values = select l.id as id, l.file as file, l.span as span, r.child as value from end_subscripts as l join value_edges as r on l.id = r.parent and l.file = r.file;
let sorted_end_values = select l.id as id, l.file as file, l.span as span from indexed_values as l join supported_sorts as r on l.value = r.call and l.file = r.file;
let target_roots = select child as id, file from "semantic-child" where field = "target" or field = "targets" or field = "optional-vars";
let unpacking_nodes = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "starred";
let unpacking_edges = select l.id as origin, r.child as destination from unpacking_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts" or r.field = "value";
let unpacking_paths = closure(edges=unpacking_edges, source="origin", destination="destination");
let nested_target_roots = select r.destination as id, l.file as file from target_roots as l join unpacking_paths as r on l.id = r.origin;
let all_target_roots = union(left=target_roots, right=nested_target_roots);
let candidates = antijoin(left=sorted_end_values, right=all_target_roots, left-on=["id","file"], right-on=["id","file"]);
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB192)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB192"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
