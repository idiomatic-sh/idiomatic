import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let wait_functions = select id from "qualified-name" where path = "os.wait" or path = "os.wait3" or path = "os.wait4" or path = "os.waitid" or path = "os.waitpid";
let wait_calls = select l.call as id, l.call as call, l.function as function from call_functions as l join wait_functions as r on l.function = r.id;
let scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let nearest_scopes = axis(from=wait_calls, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let async_scopes = select id from "semantic-syntax" where kind = "async-function-def";
let call_nearest_scopes = select l.call as call, l.function as function, r.related as scope from wait_calls as l join nearest_scopes as r on l.call = r.id;
let async_context_calls = select l.call as call, l.function as function from call_nearest_scopes as l join async_scopes as r on l.scope = r.id;
let reportable = select l.function as id, r.file as file, r.span as span from async_context_calls as l join "semantic-syntax" as r on l.function = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC222(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC222)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC222(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC222)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "ASYNC222"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
