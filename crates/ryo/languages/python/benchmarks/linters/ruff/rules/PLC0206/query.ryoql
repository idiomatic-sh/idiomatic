import observation_matches from "python/ruff/suppress-matches";
import assigned_values from "python/ruff/assigned-values";
import qualified_origins from "python/ruff/qualified-origins";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for";
let iteration_edges = select l.id as loop, r.child as iter, l.file as file from loops as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "iter";
let names = select id, file from nodes where kind = "name";
let direct_iterations = select l.loop as loop, l.iter as iter, l.iter as dict_name, l.file as file from iteration_edges as l join names as r on l.iter = r.id and l.file = r.file;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let call_iterations = select l.loop as loop, l.iter as iter, l.file as file from iteration_edges as l join calls as r on l.iter = r.id and l.file = r.file;
let iter_call_functions = select l.loop as loop, l.iter as iter, r.child as attribute, l.file as file from call_iterations as l join "semantic-child" as r on l.iter = r.parent and l.file = r.file where r.field = "func";
let attributes = select id, file from nodes where kind = "attribute";
let iter_attributes = select l.loop as loop, l.iter as iter, l.attribute as attribute, l.file as file from iter_call_functions as l join attributes as r on l.attribute = r.id and l.file = r.file;
let attr_labels = select l.loop as loop, l.iter as iter, l.attribute as attribute, r.child as label, l.file as file from iter_attributes as l join "semantic-child" as r on l.attribute = r.parent and l.file = r.file where r.field = "attr";
let keys_attributes = select l.loop as loop, l.iter as iter, l.attribute as attribute, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "keys";
let keys_values = select l.loop as loop, l.iter as iter, r.child as dict_name, l.file as file from keys_attributes as l join "semantic-child" as r on l.attribute = r.parent and l.file = r.file where r.field = "value";
let keys_iterations = select l.loop as loop, l.iter as iter, l.dict_name as dict_name, l.file as file from keys_values as l join names as r on l.dict_name = r.id and l.file = r.file;
let inferred_iterations = union(left=direct_iterations, right=keys_iterations);
let named_nodes = select id, file from nodes where kind = "named-expr";
let walrus_iterations = select l.loop as loop, l.iter as iter, l.file as file from iteration_edges as l join named_nodes as r on l.iter = r.id and l.file = r.file;
let walrus_values = select l.loop as loop, l.iter as iter, r.child as value, l.file as file from walrus_iterations as l join "semantic-child" as r on l.iter = r.parent and l.file = r.file where r.field = "value";
let dict_literals = select id, file from nodes where kind = "dict";
let literal_walrus_iterations = select l.loop as loop, l.iter as iter, l.file as file from walrus_values as l join dict_literals as r on l.value = r.id and l.file = r.file;
let walrus_names0 = select l.loop as loop, l.iter as iter, r.child as dict_name, l.file as file from literal_walrus_iterations as l join "semantic-child" as r on l.iter = r.parent and l.file = r.file where r.field = "target";
let literal_iterations = select l.loop as loop, l.iter as iter, l.dict_name as dict_name, l.file as file from walrus_names0 as l join names as r on l.dict_name = r.id and l.file = r.file;
let iteration_bindings = select l.loop as loop, l.iter as iter, l.dict_name as dict_name, r.binding as binding, l.file as file from inferred_iterations as l join "binding-use" as r on l.dict_name = r.reference and l.file = r.file;
let replacements = select binding, file from "binding-shadow" where relationship = "replacement";
let unreplaced_iterations = antijoin(left=iteration_bindings, right=replacements, left-on=["binding", "file"], right-on=["binding", "file"]);
let definitions = select id as binding, name, owner as scope, file from "defines";
let modules = select id, file from nodes where kind = "module";
let module_definitions = select l.binding as binding, l.name as name, l.scope as scope, l.file as file from definitions as l join modules as r on l.scope = r.id and l.file = r.file;
let builtin_names = select name, scope, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let builtin_replacements = select l.binding as binding, l.file as file from module_definitions as l join builtin_names as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let single_binding_iterations = antijoin(left=unreplaced_iterations, right=builtin_replacements, left-on=["binding", "file"], right-on=["binding", "file"]);
let read_events = select occurrence as reference, phase, ordinal, file from "binding-event" where kind = "read";
let iteration_phases = select l.loop as loop, r.phase as phase, l.file as file from inferred_iterations as l join read_events as r on l.dict_name = r.reference and l.file = r.file;
let scope_nodes = select id, file from nodes where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let loop_scope_axes = axis(from=loops, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let loop_scopes = select id as loop, related as initial_scope, file from loop_scope_axes;
let all_edges = select parent, child, file from "semantic-child";
let all_paths = closure(edges=all_edges, source="parent", destination="child", keys=["file"]);
let loop_event_nodes = select l.id as loop, r.child as event, l.file as file from loops as l join all_paths as r on l.id = r.parent and l.file = r.file;
let loop_events0 = select l.loop as loop, r.ordinal as point, r.phase as phase, l.file as file from loop_event_nodes as l join "binding-event" as r on l.event = r.occurrence and l.file = r.file;
let loop_events = select l.loop as loop, l.point as point, l.file as file from loop_events0 as l join iteration_phases as r on l.loop = r.loop and l.phase = r.phase and l.file = r.file;
let older_loop_points = select l.loop as loop, l.point as point, l.file as file from loop_events as l join loop_events as r on l.loop = r.loop and l.file = r.file where l.point < r.point;
let final_loop_points = antijoin(left=loop_events, right=older_loop_points, left-on=["loop", "point", "file"], right-on=["loop", "point", "file"]);
let file_event_points = select ordinal as point, file from "binding-event";
let older_file_points = ordered-match(left=file_event_points, right=file_event_points, left-on=["file"], right-on=["file"], left-order="point", right-order="point", output={point:[left,point],file:[left,file]});
let final_file_points = antijoin(left=file_event_points, right=older_file_points, left-on=["point", "file"], right-on=["point", "file"]);
let loop_context_points = select l.loop as context, r.point as point, r.point as header_point, l.initial_scope as initial_scope, l.file as file from loop_scopes as l join final_file_points as r on l.file = r.file;
let loop_context_rows = extend(from=loop_context_points, values={stage: 0});
let loop_contexts = select context, initial_scope, point, header_point, stage, file from loop_context_rows;
let initializers = assigned_values();
let dict_types = select id, file from "expression-type" as t where t.resolution = "atom" and t.type = "dict";
let literal_dict_bindings = select l.binding as binding, l.file as file from initializers as l join dict_types as r on l.value = r.id and l.file = r.file;
let call_initializers = select l.binding as binding, l.value as call, l.file as file from initializers as l join calls as r on l.value = r.id and l.file = r.file;
let constructor_values = select l.binding as binding, r.child as expression, l.file as file from call_initializers as l join "semantic-child" as r on l.call = r.parent and l.file = r.file where r.field = "func";
let ann_assignments = select id, file from nodes where kind = "ann-assign";
let ann_targets = select l.id as owner, r.child as binding, l.file as file from ann_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let ann_values = select parent as owner, child as annotation, file from "semantic-child" where field = "annotation";
let assigned_annotations = select l.binding as binding, r.annotation as annotation, l.file as file from ann_targets as l join ann_values as r on l.owner = r.owner and l.file = r.file;
let parameters = select id, file from nodes where kind = "arg";
let parameter_annotations = select l.id as binding, r.child as annotation, l.file as file from parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let function_annotations = select l.id as binding, r.child as annotation, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let annotations0 = union(left=assigned_annotations, right=parameter_annotations);
let annotations = union(left=annotations0, right=function_annotations);
let direct_annotations = select binding, annotation as expression, file from annotations;
let subscripts = select id, file from nodes where kind = "subscript";
let annotation_subscripts = select l.binding as binding, l.annotation as annotation, l.file as file from annotations as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let mapped_annotations = select l.binding as binding, r.child as expression, l.file as file from annotation_subscripts as l join "semantic-child" as r on l.annotation = r.parent and l.file = r.file where r.field = "value";
let annotation_expressions = union(left=direct_annotations, right=mapped_annotations);
let typing_dict_names = select id, file from "qualified-name" where path = "typing.Dict" or path = "typing_extensions.Dict";
let typing_dict_bindings = select l.binding as binding, l.file as file from annotation_expressions as l join typing_dict_names as r on l.expression = r.id and l.file = r.file;
let origin_expressions = union(left=constructor_values, right=annotation_expressions);
let builtin_origin_expressions = select expression as id, file from origin_expressions;
let current_origins = qualified_origins(symbol_contexts=loop_contexts, expressions=builtin_origin_expressions);
let current_dict_origins = select context, expression, file from current_origins where path = "builtins.dict";
let builtin_imports = select occurrence as binding, file from "static-import" where target = "builtins" or starts_with(target, "builtins.");
let builtin_import_events = select l.binding as binding, r.ordinal as point, l.file as file from builtin_imports as l join "binding-event" as r on l.binding = r.occurrence and l.file = r.file where r.kind = "bind";
let seen_builtin_contexts = select l.context as context, l.file as file from loop_contexts as l join builtin_import_events as r on l.file = r.file where r.point <= l.point;
let fast_dict_origins = antijoin(left=current_dict_origins, right=seen_builtin_contexts, left-on=["context", "file"], right-on=["context", "file"]);
let cached_dict_names = select id as expression, file from "qualified-name" where path = "builtins.dict";
let slow_dict_origins = select l.context as context, r.expression as expression, l.file as file from seen_builtin_contexts as l join cached_dict_names as r on l.file = r.file;
let dict_origins = union(left=fast_dict_origins, right=slow_dict_origins);
let constructor_bindings = select l.binding as binding, r.context as context, l.file as file from constructor_values as l join dict_origins as r on l.expression = r.expression and l.file = r.file;
let builtin_annotation_bindings = select l.binding as binding, r.context as context, l.file as file from annotation_expressions as l join dict_origins as r on l.expression = r.expression and l.file = r.file;
let contextual_typed_bindings = union(left=constructor_bindings, right=builtin_annotation_bindings);
let kwargs = select child as binding, file from "semantic-child" where field = "kwarg";
let simple_dict_bindings0 = union(left=literal_dict_bindings, right=typing_dict_bindings);
let simple_dict_bindings = union(left=simple_dict_bindings0, right=kwargs);
let simply_typed_iterations = select l.loop as loop, l.iter as iter, l.dict_name as dict_name, l.file as file from single_binding_iterations as l join simple_dict_bindings as r on l.binding = r.binding and l.file = r.file;
let contextually_typed_iterations = select l.loop as loop, l.iter as iter, l.dict_name as dict_name, l.file as file from single_binding_iterations as l join contextual_typed_bindings as r on l.loop = r.context and l.binding = r.binding and l.file = r.file;
let inferred_dict_iterations = union(left=simply_typed_iterations, right=contextually_typed_iterations);
let dict_iterations = union(left=inferred_dict_iterations, right=literal_iterations);
let labeled_iterations = select l.loop as loop, l.iter as iter, r.name as dict_label, l.file as file from dict_iterations as l join "identifier" as r on l.dict_name = r.id and l.file = r.file;
let loop_targets = select l.loop as loop, l.iter as iter, l.dict_label as dict_label, r.child as target, l.file as file from labeled_iterations as l join "semantic-child" as r on l.loop = r.parent and l.file = r.file where r.field = "target";
let target_shapes = select l.loop as loop, l.iter as iter, l.target as target, l.dict_label as dict_label, r.shape as target_shape, l.file as file from loop_targets as l join "expression-shape" as r on l.target = r.id and l.file = r.file;
let store_roots = select child as id, file from "semantic-child" where field = "targets" or field = "target" or field = "optional-vars";
let target_containers = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "starred";
let store_edges = select l.parent as origin, l.child as destination, l.file as file from "semantic-child" as l join target_containers as r on l.parent = r.id and l.file = r.file where l.field = "elts" or l.field = "value";
let store_paths = closure(edges=store_edges, source="origin", destination="destination", keys=["file"]);
let nested_store_nodes = select r.destination as id, l.file as file from store_roots as l join store_paths as r on l.id = r.origin and l.file = r.file;
let all_store_nodes = union(left=store_roots, right=nested_store_nodes);
let load_subscripts = antijoin(left=subscripts, right=all_store_nodes, left-on=["id", "file"], right-on=["id", "file"]);
let subscript_value_edges = select l.id as subscript, r.child as value, l.file as file from load_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let subscript_names = select l.subscript as subscript, r.name as dict_label, l.file as file from subscript_value_edges as l join "identifier" as r on l.value = r.id and l.file = r.file;
let subscript_slice_edges = select l.subscript as subscript, l.dict_label as dict_label, r.child as slice, l.file as file from subscript_names as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let subscript_shapes = select l.subscript as subscript, l.dict_label as dict_label, r.shape as target_shape, l.file as file from subscript_slice_edges as l join "expression-shape" as r on l.slice = r.id and l.file = r.file;
let subscript_walk_boundaries = select l.parent as parent, l.child as child, l.file as file from all_edges as l join load_subscripts as r on l.parent = r.id and l.file = r.file;
let physical_walk_edges = antijoin(left=all_edges, right=subscript_walk_boundaries, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let embedded_edges = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=physical_walk_edges, right=embedded_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let walk_paths = closure(edges=walk_edges, source="parent", destination="child", keys=["file"]);
let loop_body_roots = select l.loop as loop, r.child as member, l.file as file from target_shapes as l join "semantic-child" as r on l.loop = r.parent and l.file = r.file where r.field = "body";
let loop_body_children = select l.loop as loop, r.child as member, l.file as file from loop_body_roots as l join walk_paths as r on l.member = r.parent and l.file = r.file;
let loop_members = union(left=loop_body_roots, right=loop_body_children);
let matching_subscripts = select l.loop as loop, r.subscript as subscript, l.file as file from target_shapes as l join subscript_shapes as r on l.dict_label = r.dict_label and l.target_shape = r.target_shape and l.file = r.file;
let visited_matches = select l.loop as loop, l.file as file from matching_subscripts as l join loop_members as r on l.loop = r.loop and l.subscript = r.member and l.file = r.file;
let matched_loops0 = group-count(from=visited_matches, keys=["loop", "file"], count="count", distinct="loop");
let matched_loops = select l.loop as id, l.iter as iter, l.target as target, l.file as file from target_shapes as l join matched_loops0 as r on l.loop = r.loop and l.file = r.file;
let locations = select id, span, "start-line", "start-byte", "end-byte", file from "source-location";
let loop_locations = select l.id as id, l.iter as iter, l.target as target, r."start-byte" as loop_start, l.file as file from matched_loops as l join locations as r on l.id = r.id and l.file = r.file;
let target_locations = select l.id as id, l.iter as iter, l.target as target, l.loop_start as loop_start, r."start-byte" as target_start, r.span as target_span, r."start-line" as line, l.file as file from loop_locations as l join locations as r on l.target = r.id and l.file = r.file;
let opening_tokens = select id, file from "syntax-tree" where text = "(";
let opening_locations = select l.id as token, r."start-byte" as position, r.span as span, r."start-line" as line, l.file as file from opening_tokens as l join locations as r on l.id = r.id and l.file = r.file;
let target_openings = select l.id as id, l.iter as iter, r.token as token, r.position as position, r.span as target_span, r.line as line, l.file as file from target_locations as l join opening_locations as r on l.file = r.file where r.position >= l.loop_start and r.position < l.target_start;
let later_openings = select l.id as id, l.token as token, l.file as file from target_openings as l join target_openings as r on l.id = r.id and l.file = r.file where r.position < l.position;
let first_openings0 = antijoin(left=target_openings, right=later_openings, left-on=["id", "token", "file"], right-on=["id", "token", "file"]);
let first_openings = select id, iter, target_span, line, file from first_openings0;
let bare_target_locations0 = antijoin(left=target_locations, right=first_openings, left-on=["id", "file"], right-on=["id", "file"]);
let bare_target_locations = select id, iter, target_span, line, file from bare_target_locations0;
let target_bounds = union(left=first_openings, right=bare_target_locations);
let bounds = select l.id as id, l.target_span as target_span, r.span as iter_span, l.line as line, l.file as file from target_bounds as l join locations as r on l.iter = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="target_span", end="iter_span", output="span");
let candidates = select id, file, span, line from composed;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PLC0206)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLC0206"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
