import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import literal_members from "python/ruff/literal-members";
let members = literal_members();
let shaped_members = select l.root as root, l.member as member, r.shape as shape, l.file as file from members as l join "expression-shape" as r on l.member = r.id and l.file = r.file;
let located_members = select l.root as root, l.member as member, l.shape as shape, r."start-byte" as position, l.file as file from shaped_members as l join "source-location" as r on l.member = r.id and l.file = r.file;
let repeated_members = select r.member as id, r.file as file from located_members as l join located_members as r on l.root = r.root and l.shape = r.shape and l.file = r.file where l.position < r.position;
let unique_repeated = group-count(from=repeated_members, keys=["id", "file"], count="count", distinct="id");
let reportable = select id, file from unique_repeated;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PYI062($|[, #])", range-pattern="(?:^|,)PYI062(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI062)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI062)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI062"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
