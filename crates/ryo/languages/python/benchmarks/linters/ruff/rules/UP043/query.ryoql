import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select parent, child, file from "semantic-child" where field = "value";
let origins_join_1 = select l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from subscripts as l join values as e on l.id = e.parent and l.file = e.file;
let origins = select l.l_id as id, r.path as path, l.l_file as file from origins_join_1 as l join "qualified-name" as r on l.e_child = r.id and l.e_file = r.file;
let generators = select id, file from origins where path = "typing.Generator" or path = "typing_extensions.Generator" or path = "collections.abc.Generator";
let async_generators = select id, file from origins where path = "typing.AsyncGenerator" or path = "typing_extensions.AsyncGenerator" or path = "collections.abc.AsyncGenerator";
let tuples = select id, file from nodes where kind = "tuple";
let slices = select parent, child, file from "semantic-child" where field = "slice";
let tuple_slices = select l.parent as id, l.child as tuple, l.file as file from slices as l join tuples as r on l.child = r.id and l.file = r.file;
let element_edges = select parent, child, ordinal, file from "semantic-child" where field = "elts";
let elements = select l.id as id, r.child as element, r.ordinal as ordinal, l.file as file from tuple_slices as l join element_edges as r on l.tuple = r.parent and l.file = r.file;
let counts = group-count(from=elements, keys=["id","file"], count="count", distinct="element");
let sync_counts = select l.id as id, l.file as file from generators as l join counts as r on l.id = r.id and l.file = r.file where r.count = 2 or r.count = 3;
let async_counts = select l.id as id, l.file as file from async_generators as l join counts as r on l.id = r.id and l.file = r.file where r.count = 2;
let valid_counts = union(left=sync_counts, right=async_counts);
let earlier_elements = select l.element as element, l.file as file from elements as l join elements as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal;
let last_elements = antijoin(left=elements, right=earlier_elements, left-on=["element","file"], right-on=["element","file"]);
let none_literals = select id, file from "literal-properties" where kind = "null";
let last_none = select l.id as id, l.file as file from last_elements as l join none_literals as r on l.element = r.id and l.file = r.file;
let selected0 = select l.id as id, l.file as file from valid_counts as l join last_none as r on l.id = r.id and l.file = r.file;
let target_files = select file from "language-target" where major = 3 and minor >= 13;
let native_selected = select l.id as id, l.file as file from selected0 as l join target_files as r on l.file = r.file;
let stub_candidates = select id, file from selected0 where matches(file, "[.]pyi$");
let stub_selected = antijoin(left=stub_candidates, right=native_selected, left-on=["id","file"], right-on=["id","file"]);
let selected = union(left=native_selected, right=stub_selected);
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP043(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP043)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP043)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP043)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP043"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
