import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import union_members from "python/ruff/union-members";
let members = union_members();
let union_roots0 = group-count(from=members, keys=["root", "file"], count="count", distinct="member");
let union_roots = select root as id, file from union_roots0;
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let annotation_edges = select parent as owner, child as id, file from "semantic-child" where field = "annotation" or field = "returns";
let delayed_files = select file from "static-import" where target = "__future__.annotations";
let stub_annotation_roots = select id, file from annotation_edges where matches(file, "\.pyi$");
let future_annotation_roots = select l.id as id, l.file as file from annotation_edges as l join delayed_files as r on l.file = r.file;
let assignments = select id, file from nodes where kind = "ann-assign";
let annotation_scope_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let assignment_scope_axes = axis(from=assignments, relation="semantic-child", direction=nearest-ancestor, domain=annotation_scope_nodes);
let assignment_function_axes = select l.id as id, l.related as related, l.file as file from assignment_scope_axes as l join functions as r on l.related = r.id and l.file = r.file;
let local_annotation_roots = select l.id as id, l.file as file from annotation_edges as l join assignment_function_axes as r on l.owner = r.id and l.file = r.file;
let embedded_roots = select root as id, file from "embedded-expression";
let type_aliases = select id, file from nodes where kind = "type-alias";
let type_alias_values = select l.id as owner, r.child as id, l.file as file from type_aliases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let type_param_roots = select child as id, file from "semantic-child" where field = "type-params";
let ifs = select id, file from nodes where kind = "if";
let if_tests = select l.id as owner, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let tc_names = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_origins = select id, file from "qualified-name" where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let tc_flags = union(left=tc_names, right=tc_origins);
let simple_tc_ifs = select l.owner as owner, l.file as file from if_tests as l join tc_flags as r on l.test = r.id and l.file = r.file;
let attribute_labels = select parent as attribute, child as label, file from "semantic-child" where field = "attr";
let tc_attributes = select l.attribute as id, l.file as file from attribute_labels as l join tc_names as r on l.label = r.id and l.file = r.file;
let attribute_tc_ifs = select l.owner as owner, l.file as file from if_tests as l join tc_attributes as r on l.test = r.id and l.file = r.file;
let tc_ifs = union(left=simple_tc_ifs, right=attribute_tc_ifs);
let tc_bodies = select r.child as id, l.file as file from tc_ifs as l join "semantic-child" as r on l.owner = r.parent and l.file = r.file where r.field = "body";
let typing_roots0 = union(left=stub_annotation_roots, right=future_annotation_roots);
let typing_roots1 = union(left=typing_roots0, right=local_annotation_roots);
let typing_roots2 = union(left=typing_roots1, right=embedded_roots);
let alias_roots = select id, file from type_alias_values;
let typing_roots3 = union(left=typing_roots2, right=alias_roots);
let typing_roots4 = union(left=typing_roots3, right=type_param_roots);
let typing_roots = union(left=typing_roots4, right=tc_bodies);
let typing_union_axes = axis(from=typing_roots, relation="semantic-child", direction=descendant, domain=union_roots);
let typing_union_children = select related as id, file from typing_union_axes;
let typing_union_self = select l.id as id, l.file as file from typing_roots as l join union_roots as r on l.id = r.id and l.file = r.file;
let typing_unions = union(left=typing_union_children, right=typing_union_self);
let subscript_nodes = select id, file from nodes where kind = "subscript";
let type_values = select l.id as subscript, r.child as value, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let type_names = select id, file from "qualified-name" where path = "builtins.type";
let type_subscripts = select l.subscript as subscript, l.file as file from type_values as l join type_names as r on l.value = r.id and l.file = r.file;
let type_slices = select l.subscript as subscript, r.child as slice, l.file as file from type_subscripts as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let scalar_type_slices = antijoin(left=type_slices, right=tuples, left-on=["slice", "file"], right-on=["id", "file"]);
let type_members = select l.root as root, l.member as member, l.file as file from members as l join scalar_type_slices as r on l.member = r.subscript and l.file = r.file;
let type_counts = group-count(from=type_members, keys=["root", "file"], count="count", distinct="member");
let redundant_type_unions = select root as id, file from type_counts where count >= 2;
let reportable = select l.id as id, l.file as file from redundant_type_unions as l join typing_unions as r on l.id = r.id and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PYI055($|[, #])", range-pattern="(?:^|,)PYI055(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="PYI055($|[, #])", range-pattern="(?:^|,)PYI055(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI055"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
