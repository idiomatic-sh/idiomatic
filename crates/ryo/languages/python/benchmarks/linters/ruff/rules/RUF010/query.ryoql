import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let fstring_parts = select id, file from nodes where kind = "f-string-part";
let formatted_values = select id, file from nodes where kind = "formatted-value";
let part_children = select l.id as part, r.child as formatted, l.file as file from fstring_parts as l join edges as r on l.id = r.parent and l.file = r.file;
let top_level_values = select l.formatted as formatted, l.file as file from part_children as l join formatted_values as r on l.formatted = r.id and l.file = r.file;
let conversions = select parent as formatted, file from edges where field = "conversion";
let without_conversion = antijoin(left=top_level_values, right=conversions, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let child_tokens = select l.formatted as formatted, r.child as token, l.file as file from without_conversion as l join edges as r on l.formatted = r.parent and l.file = r.file;
let debug_values = select l.formatted as formatted, l.file as file from child_tokens as l join "semantic-syntax" as r on l.token = r.id and l.file = r.file where r.text = "=";
let eligible_values = antijoin(left=without_conversion, right=debug_values, left-on=["formatted", "file"], right-on=["formatted", "file"]);
let values = select l.formatted as formatted, r.child as call, l.file as file from eligible_values as l join edges as r on l.formatted = r.parent and l.file = r.file where r.field = "value";
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let call_values = select l.formatted as formatted, l.call as call, l.file as file from values as l join calls as r on l.call = r.id and l.file = r.file;
let functions = select l.formatted as formatted, l.call as call, r.child as function, l.file as file from call_values as l join edges as r on l.call = r.parent and l.file = r.file where r.field = "func";
let builtin_functions = select q.id as id, q.path as path, q.file as file from "qualified-name" as q where (q.path = "builtins.str" or q.path = "builtins.repr" or q.path = "builtins.ascii") and (q.provenance != "builtin" or q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10);
let builtin_calls = select l.call as call, r.path as path, l.file as file from functions as l join builtin_functions as r on l.function = r.id and l.file = r.file;
let wrappers = select id, file from nodes where kind = "call-arguments";
let call_children = select l.call as call, l.path as path, r.child as wrapper, l.file as file from builtin_calls as l join edges as r on l.call = r.parent and l.file = r.file;
let call_wrappers = select l.call as call, l.path as path, l.wrapper as wrapper, l.file as file from call_children as l join wrappers as r on l.wrapper = r.id and l.file = r.file;
let positional = select l.call as call, l.path as path, r.child as argument, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let keywords = select l.call as call, l.path as path, r.child as keyword, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let position_count_inputs = select call, argument, file from positional;
let keyword_count_inputs = select call, keyword as argument, file from keywords;
let all_arguments = union(left=position_count_inputs, right=keyword_count_inputs);
let counts = group-count(from=all_arguments, keys=["call", "file"], count="count", distinct="argument");
let single_positional = select l.call as call, l.argument as argument, l.file as file from positional as l join counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let starred = select id, file from nodes where kind = "starred";
let safe_positional = antijoin(left=single_positional, right=starred, left-on=["argument", "file"], right-on=["id", "file"]);
let single_keywords = select l.call as call, l.keyword as keyword, l.file as file from keywords as l join counts as r on l.call = r.call and l.file = r.file where l.path = "builtins.str" and r.count = 1;
let keyword_names = select l.call as call, l.keyword as keyword, r.child as name, l.file as file from single_keywords as l join edges as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let object_keywords = select l.call as call, l.file as file from keyword_names as l join "identifier" as r on l.name = r.id and l.file = r.file where r.name = "object";
let positional_calls = select call, file from safe_positional;
let eligible_calls = union(left=positional_calls, right=object_keywords);
let reportable = select l.call as id, l.file as file from eligible_calls as l join call_values as r on l.call = r.call and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:RUF010)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF010"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
