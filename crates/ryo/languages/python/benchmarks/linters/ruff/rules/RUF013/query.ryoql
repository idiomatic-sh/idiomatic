import annotation_origins from "python/ruff/annotation-origins";
import suppress from "python/ruff/suppress";

let nodes = select id, kind, file from "semantic-syntax";
let wrappers = select id, file from nodes where kind = "parameter-with-default";
let defaults = select l.id as wrapper, r.child as value, l.file as file from wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "defaults" or r.field = "kw-defaults";
let nulls = select id, file from "literal-properties" where kind = "null";
let null_defaults = select l.wrapper as wrapper, l.file as file from defaults as l join nulls as r on l.value = r.id and l.file = r.file;
let parameters = select l.id as wrapper, r.child as parameter, l.file as file from wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "args" or r.field = "posonlyargs" or r.field = "kwonlyargs";
let annotations = select l.wrapper as wrapper, r.child as annotation, l.file as file from parameters as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let candidates = select l.wrapper as wrapper, r.annotation as annotation, l.file as file from null_defaults as l join annotations as r on l.wrapper = r.wrapper and l.file = r.file;
let embedded = select host, root, file from "embedded-expression";
let root_quotes = select l.wrapper as wrapper, r.root as annotation, l.file as file from candidates as l join embedded as r on l.annotation = r.host and l.file = r.file;
let unquoted_roots = antijoin(left=candidates, right=root_quotes, left-on=["wrapper", "file"], right-on=["wrapper", "file"]);
let unquoted = select wrapper, annotation, file from unquoted_roots;
let effective_roots = union(left=unquoted, right=root_quotes);
let roots = select annotation as id, file from effective_roots;
let origins = annotation_origins(expressions=roots);
let subscript_nodes = select id, file from nodes where kind = "subscript";
let subscript_bases = select l.id as subscript, r.child as base, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let subscript_paths = select l.subscript as subscript, r.path as path, l.file as file from subscript_bases as l join origins as r on l.base = r.id and l.file = r.file;
let optional_nodes = select subscript as id, file from subscript_paths where path = "typing.Optional" or path = "typing_extensions.Optional";
let union_nodes = select subscript as id, file from subscript_paths where path = "typing.Union" or path = "typing_extensions.Union";
let literal_nodes = select subscript as id, file from subscript_paths where path = "typing.Literal" or path = "typing_extensions.Literal";
let annotated_nodes = select subscript as id, file from subscript_paths where path = "typing.Annotated" or path = "typing_extensions.Annotated";
let direct_special = select id, path, file from origins where path = "typing.Optional" or path = "typing_extensions.Optional" or path = "typing.Any" or path = "typing_extensions.Any" or path = "builtins.object" or path = "typing.Hashable" or path = "typing_extensions.Hashable" or path = "collections.abc.Hashable";
let direct_nullable = select id, file from direct_special;
let nullable_seeds_0 = union(left=nulls, right=direct_nullable);
let nullable_seeds = union(left=nullable_seeds_0, right=optional_nodes);

let selected_subscripts_0 = union(left=union_nodes, right=literal_nodes);
let selected_subscripts = union(left=selected_subscripts_0, right=annotated_nodes);
let slice_roots = select l.id as parent, r.child as slice, l.file as file from selected_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.parent as parent, l.slice as tuple, l.file as file from slice_roots as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_elements = select l.parent as parent, r.child as child, r.ordinal as ordinal, l.file as file from tuple_slices as l join "semantic-child" as r on l.tuple = r.parent and l.file = r.file where r.field = "elts";
let non_tuple_slices = antijoin(left=slice_roots, right=tuple_slices, left-on=["parent", "slice", "file"], right-on=["parent", "tuple", "file"]);
let direct_slices = select parent, slice as child, file from non_tuple_slices;
let tuple_edges = select parent, child, file from tuple_elements;
let all_slices = union(left=tuple_edges, right=direct_slices);
let ordinary_slices = antijoin(left=all_slices, right=annotated_nodes, left-on=["parent", "file"], right-on=["id", "file"]);
let later_tuple_elements = select l.parent as parent, l.child as child, l.ordinal as ordinal, l.file as file from tuple_elements as l join tuple_elements as r on l.parent = r.parent and l.file = r.file where l.ordinal > r.ordinal;
let first_tuple_elements = antijoin(left=tuple_elements, right=later_tuple_elements, left-on=["parent", "child", "ordinal", "file"], right-on=["parent", "child", "ordinal", "file"]);
let first_tuple_edges = select l.parent as parent, l.child as child, l.file as file from first_tuple_elements as l join annotated_nodes as r on l.parent = r.id and l.file = r.file;
let direct_annotated_edges = select l.parent as parent, l.child as child, l.file as file from direct_slices as l join annotated_nodes as r on l.parent = r.id and l.file = r.file;
let annotated_edges = union(left=first_tuple_edges, right=direct_annotated_edges);
let subscript_edges = union(left=ordinary_slices, right=annotated_edges);
let union_slices = select l.parent as parent, l.child as child, l.file as file from all_slices as l join union_nodes as r on l.parent = r.id and l.file = r.file;
let strings = select id, file from "literal-properties" where kind = "string";
let unparsed_strings = antijoin(left=strings, right=embedded, left-on=["id", "file"], right-on=["host", "file"]);
let invalid_unions = select l.parent as id, l.file as file from union_slices as l join unparsed_strings as r on l.child = r.id and l.file = r.file;

let binops = select id, file from nodes where kind = "bin-op";
let lefts = select l.id as binop, r.child as child, l.file as file from binops as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "left";
let rights = select l.id as binop, r.child as child, l.file as file from binops as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "right";
let left_spans = select l.binop as binop, r."end-byte" as boundary, l.file as file from lefts as l join "source-location" as r on l.child = r.id and l.file = r.file;
let right_spans = select l.binop as binop, r."start-byte" as boundary, l.file as file from rights as l join "source-location" as r on l.child = r.id and l.file = r.file;
let operand_bounds = select l.binop as binop, l.boundary as left_end, r.boundary as right_start, l.file as file from left_spans as l join right_spans as r on l.binop = r.binop and l.file = r.file;
let pipe_tokens = select l.id as token, r."start-byte" as start, r."end-byte" as end, r.file as file from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "|";
let pipe_binops = select l.binop as id, l.file as file from operand_bounds as l join pipe_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let pipe_lefts = select l.id as parent, r.child as child, l.file as file from pipe_binops as l join lefts as r on l.id = r.binop and l.file = r.file;
let pipe_rights = select l.id as parent, r.child as child, l.file as file from pipe_binops as l join rights as r on l.id = r.binop and l.file = r.file;
let pipes = union(left=pipe_lefts, right=pipe_rights);
let quote_edges = select host as parent, root as child, file from embedded;
let flow_0 = union(left=subscript_edges, right=pipes);
let flow = union(left=flow_0, right=quote_edges);
let descendants = closure(edges=flow, source="parent", destination="child", keys=["file"]);
let nullable_descendants = select l.parent as id, l.file as file from descendants as l join nullable_seeds as r on l.child = r.id and l.file = r.file;
let nullable_all = union(left=nullable_seeds, right=nullable_descendants);

let nullable_wrappers = select l.wrapper as wrapper, l.file as file from effective_roots as l join nullable_all as r on l.annotation = r.id and l.file = r.file;
let nonnullable_roots = antijoin(left=effective_roots, right=nullable_wrappers, left-on=["wrapper", "file"], right-on=["wrapper", "file"]);
let invalid_descendant_roots = select l.parent as id, l.file as file from descendants as l join invalid_unions as r on l.child = r.id and l.file = r.file;
let invalid_all = union(left=invalid_unions, right=invalid_descendant_roots);
let invalid_wrappers = select l.wrapper as wrapper, l.file as file from effective_roots as l join invalid_all as r on l.annotation = r.id and l.file = r.file;
let valid_roots = antijoin(left=nonnullable_roots, right=invalid_wrappers, left-on=["wrapper", "file"], right-on=["wrapper", "file"]);
let known_direct = select id, file from origins where matches(path, "^(?:builtins|typing|typing_extensions|collections[.]abc)[.]");
let known_subscripts = select subscript as id, file from subscript_paths where matches(path, "^(?:builtins|typing|typing_extensions|collections[.]abc)[.]");
let known_0 = union(left=known_direct, right=known_subscripts);
let known = union(left=known_0, right=pipe_binops);
let name_nodes = select id, file from nodes where kind = "name" or kind = "attribute";
let unknown_names = antijoin(left=name_nodes, right=known_direct, left-on=["id", "file"], right-on=["id", "file"]);
let typed_edges_0 = union(left=union_slices, right=annotated_edges);
let typed_edges_1 = union(left=typed_edges_0, right=pipes);
let typed_edges = union(left=typed_edges_1, right=quote_edges);
let typed_paths = closure(edges=typed_edges, source="parent", destination="child", keys=["file"]);
let uncertain_ancestors = select l.parent as id, l.file as file from typed_paths as l join unknown_names as r on l.child = r.id and l.file = r.file;
let uncertain_wrappers = select l.wrapper as wrapper, l.file as file from effective_roots as l join uncertain_ancestors as r on l.annotation = r.id and l.file = r.file;
let certain_roots = antijoin(left=valid_roots, right=uncertain_wrappers, left-on=["wrapper", "file"], right-on=["wrapper", "file"]);
let diagnostic_roots = select l.wrapper as wrapper, l.annotation as annotation, l.file as file from certain_roots as l join known as r on l.annotation = r.id and l.file = r.file;
let annotated_paths = closure(edges=annotated_edges, source="parent", destination="child", keys=["file"]);
let annotation_inner = select l.wrapper as wrapper, r.child as annotation, l.file as file from diagnostic_roots as l join annotated_paths as r on l.annotation = r.parent and l.file = r.file;
let terminal_inner = antijoin(left=annotation_inner, right=annotated_nodes, left-on=["annotation", "file"], right-on=["id", "file"]);
let ordinary_diagnostics = antijoin(left=diagnostic_roots, right=annotated_nodes, left-on=["annotation", "file"], right-on=["id", "file"]);
let diagnostics = union(left=ordinary_diagnostics, right=terminal_inner);
let located = select l.annotation as id, l.file as file, r.span as span, r."start-line" as line from diagnostics as l join "source-location" as r on l.annotation = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="(?:^|[^A-Z0-9])RUF013(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF013)(?:,|$)");
emit violations subject file key(id);
