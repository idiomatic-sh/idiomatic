let dictionaries = select id, file, span from "syntax-tree" where kind = "dict";
let children = select parent, child, ordinal from "syntax-child";
let members = select parent, child, ordinal from "syntax-child" where field = "keys" or field = "values";
let stars = select id from "syntax-tree" where text = "**";
let star_positions = select l.parent as parent, l.ordinal as ordinal from children as l join stars as r on l.child = r.id;
let nested = select l.parent as parent, l.ordinal as ordinal, r.id as id, r.file as file, r.span as span from members as l join dictionaries as r on l.child = r.id;
let pairs = select l.id as id, l.parent as parent, l.ordinal as ending, r.ordinal as beginning from nested as l join star_positions as r on l.parent = r.parent where r.ordinal < l.ordinal;
let between = select l.id as id, l.beginning as beginning from pairs as l join members as r on l.parent = r.parent where l.beginning < r.ordinal and r.ordinal < l.ending;
let adjacent = antijoin(left=pairs, right=between, left-on=["id", "beginning"], right-on=["id", "beginning"]);
let dict_spreads = select l.id as id from adjacent as l join dictionaries as r on l.parent = r.id;
let reportable = select r.id as id, r.file as file, r.span as span from dict_spreads as l join dictionaries as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let quoted = select id from "syntax-tree" where kind = "string-part" or kind = "bytes-part" or kind = "f-string-part";
let quoted_locations = select r.file as file, r."start-line" as line, r."end-line" as endline from quoted as l join "source-location" as r on l.id = r.id where r."start-line" < r."end-line";
let earlier_endings = select l.file as file, l.line as line, l.endline as endline from quoted_locations as l join quoted_locations as r on l.file = r.file and l.line = r.line where l.endline < r.endline;
let mappings = antijoin(left=quoted_locations, right=earlier_endings, left-on=["file", "line", "endline"], right-on=["file", "line", "endline"]);
let unchanged_locations = antijoin(left=candidate_locations, right=mappings, left-on=["file", "line"], right-on=["file", "line"]);
let remapped_locations = select l.id as id, l.file as file, l.span as span, r.endline as line from candidate_locations as l join mappings as r on l.file = r.file and l.line = r.line;
let located = union(left=unchanged_locations, right=remapped_locations);
let comments = select * from "comment" where matches(text, "(?i:noqa)");
let internal_markers = capture(from=comments, path="text", pattern="{*before}#{*tail}", captures=["before", "tail"]);
let leading_markers = capture(from=comments, path="text", pattern="#{*tail}", captures=["tail"]);
let later_inline_markers = select * from internal_markers where matches(before, "(?:^|#)\s*(?i:noqa)");
let first_inline_markers = antijoin(left=internal_markers, right=later_inline_markers, left-on=["id", "tail"], right-on=["id", "tail"]);
let initial_inline = select id, file, span, text as directive from comments where matches(text, "^\s*(?i:noqa)");
let internal_inline = select id, file, span, tail as directive from first_inline_markers where matches(tail, "^\s*(?i:noqa)");
let leading_inline = select id, file, span, tail as directive from leading_markers where matches(tail, "^\s*(?i:noqa)");
let inline_with_internal = union(left=initial_inline, right=internal_inline);
let all_inline = union(left=inline_with_internal, right=leading_inline);
let inline_directives = extend(from=all_inline, values={scope: 0});
let later_file_markers = select * from internal_markers where matches(before, "(?:^|#)\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let first_file_markers = antijoin(left=internal_markers, right=later_file_markers, left-on=["id", "tail"], right-on=["id", "tail"]);
let initial_file = select id, file, span, text as directive from comments where matches(text, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let internal_file = select id, file, span, tail as directive from first_file_markers where matches(tail, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let leading_file = select id, file, span, tail as directive from leading_markers where matches(tail, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let file_with_internal = union(left=initial_file, right=internal_file);
let all_file = union(left=file_with_internal, right=leading_file);
let file_parts = capture(from=all_file, path="directive", pattern="{*tool}:{*directive_text}", captures=["tool", "directive_text"]);
let normalized_file = select id, file, span, directive_text as directive from file_parts where matches(tool, "^\s*(?:ruff|flake8)\s*$");
let file_directives = extend(from=normalized_file, values={scope: 1});
let directives = union(left=inline_directives, right=file_directives);
let blanket = select id, file, span, scope from directives where matches(directive, "^\s*(?i:noqa)(?:$|#|\s+(?:$|[^:\s]))");
let code_parts = capture(from=directives, path="directive", pattern="{*prefix}:{*codes}", captures=["prefix", "codes"]);
let code_directives = select * from code_parts where matches(prefix, "^\s*(?i:noqa)\s*$");
let valid_codes = select * from code_directives where matches(codes, "^[\s,]*[A-Z]+[0-9]+(?:[A-Z]+[0-9]+|[\s,]+[A-Z]+[0-9]+)*(?:$|#.*|[\s,]+(?:$|[^\s,A-Z].*|[A-Z]+(?:$|[^A-Z0-9].*)))$");
let matching_codes = select id, file, span, scope from valid_codes where matches(codes, "^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PIE800(?:$|[\s,#]|[A-Z])");
let suppressions = union(left=blanket, right=matching_codes);
let line_noqa = select id, file from suppressions where scope = 0;
let line_suppressions = select l.file as file, r."start-line" as line from line_noqa as l join "source-location" as r on l.id = r.id;
let file_noqa = select id, file from suppressions where scope = 1;
let file_suppressions = select l.file as file, r."start-line" as line from file_noqa as l join "source-location" as r on l.id = r.id;
let code_tokens = select id from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let code_lines = select r.file as file, r."start-line" as line from code_tokens as l join "source-location" as r on l.id = r.id;
let standalone = antijoin(left=file_suppressions, right=code_lines, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_lines = antijoin(left=located, right=line_suppressions, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_files = antijoin(left=unsuppressed_lines, right=standalone, left-on=["file"], right-on=["file"]);
let violations = select file, span from unsuppressed_files;
emit violations subject file key(span);
