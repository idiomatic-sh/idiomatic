import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let statements = select id from "semantic-syntax" where kind = "expr";
let values = select parent, child from "semantic-child" where field = "value";
let named = select * from "semantic-syntax" where kind = "named-expr";
let discarded = select r.child as child from statements as l join values as r on l.id = r.parent;
let reportable = select r.id as id, r.file as file, r.span as span from discarded as l join named as r on l.child = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="PLW0131");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PLW0131") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
