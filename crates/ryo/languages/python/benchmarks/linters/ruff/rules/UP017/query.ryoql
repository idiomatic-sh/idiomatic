import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let utc_names = select id, file, span from "qualified-name" where path = "datetime.timezone.utc";
let supported_targets = select file from "language-target" where major > 3 or major = 3 and minor >= 11;
let candidates = select l.id as id, l.file as file, l.span as span from utc_names as l join supported_targets as r on l.file = r.file;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, code="UP017");
let violations = antijoin(left=candidates, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","UP017") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
