import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let io_open_functions = select id, file from "qualified-name" where path = "io.open";
let matched_call_functions = select l.call as call, l.file as file from call_functions as l join io_open_functions as r on l.function = r.id and l.file = r.file;
let io_open_calls = select l.call as id, l.file as file, r.span as span from matched_call_functions as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from io_open_calls as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP020(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP020)(?:,|$)");
emit violations subject file key(id);
