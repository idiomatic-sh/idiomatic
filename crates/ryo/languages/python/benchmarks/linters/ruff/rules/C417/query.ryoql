import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, r.file as file, r.span as span, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let qualified_functions = select id, file, path from "qualified-name";
let map_functions = select id, file from qualified_functions where path = "builtins.map";
let map_call_functions = select l.call as call, l.file as file, l.span as span from call_functions as l join map_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let argument_wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional = select l.call as call, l.file as file, r.child as argument, r.ordinal as ordinal from argument_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let earlier_args = select l.call as call, l.file as file, l.argument as argument from positional as l join positional as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let first_args = antijoin(left=positional, right=earlier_args, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let map_first_args = select l.call as call, l.file as file, l.span as span, r.argument as lambda, r.ordinal as ordinal from map_call_functions as l join first_args as r on l.call = r.call and l.file = r.file;
let lambdas = select id, file, span from "semantic-syntax" where kind = "lambda";
let map_lambdas = select l.call as map_call, l.file as file, l.span as span, l.ordinal as ordinal, r.id as lambda from map_first_args as l join lambdas as r on l.lambda = r.id and l.file = r.file;
let map_positional_counts = group-count(from=positional, keys=["call", "file"], count="argument_count", distinct="argument");
let at_least_two_map_args = select l.map_call as map_call, l.file as file, l.span as span, l.lambda as lambda, l.ordinal as first_ordinal from map_lambdas as l join map_positional_counts as r on l.map_call = r.call and l.file = r.file where r.argument_count > 1;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, l.file as file, r.child as keyword from argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyworded_calls = select call, file from keywords;
let valid_map_calls = antijoin(left=at_least_two_map_args, right=keyworded_calls, left-on=["map_call", "file"], right-on=["call", "file"]);
let lambda_argument_fields = select parent, child from "semantic-child" where field = "args";
let lambda_argument_wrappers = select l.lambda as lambda, l.file as file, r.child as wrapper from valid_map_calls as l join lambda_argument_fields as r on l.lambda = r.parent;
let regular_parameter_fields = select parent, child from "semantic-child" where field = "args";
let positional_only_parameter_fields = select parent, child from "semantic-child" where field = "posonlyargs";
let keyword_only_parameter_fields = select parent, child from "semantic-child" where field = "kwonlyargs";
let vararg_parameter_fields = select parent, child from "semantic-child" where field = "vararg";
let kwarg_parameter_fields = select parent, child from "semantic-child" where field = "kwarg";
let regular_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from lambda_argument_wrappers as l join regular_parameter_fields as r on l.wrapper = r.parent;
let positional_only_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from lambda_argument_wrappers as l join positional_only_parameter_fields as r on l.wrapper = r.parent;
let keyword_only_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from lambda_argument_wrappers as l join keyword_only_parameter_fields as r on l.wrapper = r.parent;
let vararg_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from lambda_argument_wrappers as l join vararg_parameter_fields as r on l.wrapper = r.parent;
let kwarg_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from lambda_argument_wrappers as l join kwarg_parameter_fields as r on l.wrapper = r.parent;
let all_parameters_a = union(left=regular_parameters, right=positional_only_parameters);
let all_parameters_b = union(left=keyword_only_parameters, right=vararg_parameters);
let all_parameters_c = union(left=all_parameters_a, right=all_parameters_b);
let all_parameters = union(left=all_parameters_c, right=kwarg_parameters);
let parameter_counts = group-count(from=all_parameters, keys=["lambda", "file"], count="parameter_count", distinct="parameter");
let regular_parameter_counts = group-count(from=regular_parameters, keys=["lambda", "file"], count="regular_count", distinct="parameter");
let one_parameter_lambdas = select l.lambda as lambda, l.file as file from parameter_counts as l join regular_parameter_counts as r on l.lambda = r.lambda and l.file = r.file where l.parameter_count = 1 and r.regular_count = 1;
let default_wrappers = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let parameter_unwrapping = select parent, child, file from "semantic-child" where field = "args" or field = "posonlyargs" or field = "kwonlyargs";
let inner_lambda_parameters = select l.lambda as lambda, l.file as file, r.child as parameter from regular_parameters as l join parameter_unwrapping as r on l.parameter = r.parent and l.file = r.file;
let default_edges = select parent, file from "semantic-child" where field = "defaults";
let lambda_default_edges = select l.lambda as lambda, l.file as file from regular_parameters as l join default_edges as r on l.parameter = r.parent and l.file = r.file;
let defaulted_parameters = select lambda, file from lambda_default_edges;
let no_defaults = antijoin(left=one_parameter_lambdas, right=defaulted_parameters, left-on=["lambda", "file"], right-on=["lambda", "file"]);
let lambda_body_fields = select parent, child from "semantic-child" where field = "body";
let lambda_bodies = select l.lambda as lambda, l.file as file, r.child as body from no_defaults as l join lambda_body_fields as r on l.lambda = r.parent;
let yields = select id, file from "semantic-syntax" where kind = "yield" or kind = "yield-from";
let lambda_bodies_for_axis = select body as id, lambda as owner, file from lambda_bodies;
let lambda_yield_descendants = axis(from=lambda_bodies_for_axis, relation="semantic-child", direction=descendant, domain=yields);
let direct_yields = select l.lambda as lambda, l.file as file from lambda_bodies as l join yields as r on l.body = r.id and l.file = r.file;
let nested_yields = select l.owner as lambda, l.file as file from lambda_bodies_for_axis as l join lambda_yield_descendants as r on l.id = r.id;
let lambdas_with_yield = union(left=direct_yields, right=nested_yields);
let no_lambda_yield = antijoin(left=no_defaults, right=lambdas_with_yield, left-on=["lambda", "file"], right-on=["lambda", "file"]);
let lambda_parameter_binds = select l.lambda as lambda, l.file as file, r.occurrence as binding, r.name as name from inner_lambda_parameters as l join "binding-event" as r on l.parameter = r.occurrence and l.file = r.file where r.kind = "bind";
let nested_lambda_roots = axis(from=lambda_bodies_for_axis, relation="semantic-child", direction=descendant, domain=lambdas);
let nested_lambda_descendants = select l.owner as lambda, r.related as nested_lambda, l.file as file from lambda_bodies_for_axis as l join nested_lambda_roots as r on l.id = r.id;
let nested_lambda_direct = select l.owner as lambda, l.file as file, r.id as nested_lambda from lambda_bodies_for_axis as l join lambdas as r on l.id = r.id and l.file = r.file;
let nested_lambdas = union(left=nested_lambda_descendants, right=nested_lambda_direct);
let nested_lambda_bodies = select l.lambda as outer_lambda, l.nested_lambda as nested_lambda, l.file as file, r.child as body from nested_lambdas as l join lambda_body_fields as r on l.nested_lambda = r.parent;
let nested_lambda_body_roots = select body as id, outer_lambda, nested_lambda, file from nested_lambda_bodies;
let nested_read_nodes = select reference as id, file from "binding-read";
let nested_body_read_roots = axis(from=nested_lambda_body_roots, relation="semantic-child", direction=descendant, domain=nested_read_nodes);
let nested_body_descendant_reads = select l.outer_lambda as outer_lambda, l.nested_lambda as nested_lambda, l.file as file, r.related as reference from nested_lambda_body_roots as l join nested_body_read_roots as r on l.id = r.id;
let nested_body_direct_reads = select l.outer_lambda as outer_lambda, l.nested_lambda as nested_lambda, l.file as file, r.reference as reference from nested_lambda_bodies as l join "binding-read" as r on l.body = r.reference and l.file = r.file;
let nested_body_reads = union(left=nested_body_descendant_reads, right=nested_body_direct_reads);
let nested_body_uses = select l.outer_lambda as outer_lambda, l.file as file, r.binding as binding from nested_body_reads as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let late_bound_lambdas = select l.lambda as lambda, l.file as file from lambda_parameter_binds as l join nested_body_uses as r on l.lambda = r.outer_lambda and l.file = r.file and l.binding = r.binding;
let no_late_binding = antijoin(left=no_lambda_yield, right=late_bound_lambdas, left-on=["lambda", "file"], right-on=["lambda", "file"]);
let iterable_args = select l.call as map_call, l.file as file, l.argument as iterable from positional as l join valid_map_calls as r on l.call = r.map_call and l.file = r.file where l.ordinal > r.first_ordinal;
let starred_iterables = select l.map_call as map_call, l.file as file from iterable_args as l join "semantic-syntax" as r on l.iterable = r.id and l.file = r.file where r.kind = "starred";
let named_expressions = select id, file from "semantic-syntax" where kind = "named-expr";
let iterable_roots = select iterable as id, map_call, file from iterable_args;
let iterable_named_expr_descendants = axis(from=iterable_roots, relation="semantic-child", direction=descendant, domain=named_expressions);
let descendant_named_expr_iterables = select l.map_call as map_call, l.file as file from iterable_roots as l join iterable_named_expr_descendants as r on l.id = r.id;
let direct_named_expr_iterables = select l.map_call as map_call, l.file as file from iterable_roots as l join named_expressions as r on l.id = r.id and l.file = r.file;
let named_expr_iterables = union(left=descendant_named_expr_iterables, right=direct_named_expr_iterables);
let invalid_iterable_map_calls = union(left=starred_iterables,right=named_expr_iterables);
let map_after_lambda_checks = select l.map_call as map_call, l.file as file, l.span as span, l.lambda as lambda, l.first_ordinal as first_ordinal from valid_map_calls as l join no_late_binding as r on l.lambda = r.lambda and l.file = r.file;
let safe_map_calls = antijoin(left=map_after_lambda_checks, right=invalid_iterable_map_calls, left-on=["map_call", "file"], right-on=["map_call", "file"]);
let direct_map_candidates = select map_call as id, file, span from safe_map_calls;
let container_functions = select id, file, path from qualified_functions where path = "builtins.list" or path = "builtins.set" or path = "builtins.dict";
let container_calls = select l.call as call, l.file as file, l.span as span, r.path as path from call_functions as l join container_functions as r on l.function = r.id and l.file = r.file;
let container_counts = group-count(from=positional, keys=["call", "file"], count="argument_count", distinct="argument");
let one_argument_containers = select l.call as call, l.file as file, l.span as span, l.path as path from container_calls as l join container_counts as r on l.call = r.call and l.file = r.file where r.argument_count = 1;
let valid_containers = antijoin(left=one_argument_containers, right=keyworded_calls, left-on=["call", "file"], right-on=["call", "file"]);
let container_argument_nodes = select l.call as call, l.file as file, r.argument as argument, l.span as span, l.path as path from valid_containers as l join positional as r on l.call = r.call and l.file = r.file;
let wrapped_map_calls = select l.call as outer_call, l.file as file, l.span as span, l.path as path, r.map_call as map_call, r.lambda as lambda from container_argument_nodes as l join safe_map_calls as r on l.argument = r.map_call and l.file = r.file;
let lambda_body_nodes = select l.outer_call as outer_call, l.file as file, l.span as span, l.path as path, l.lambda as lambda, r.child as body from wrapped_map_calls as l join lambda_body_fields as r on l.lambda = r.parent;
let tuple_bodies = select l.outer_call as outer_call, l.file as file, l.span as span, l.path as path, l.lambda as lambda, l.body as body from lambda_body_nodes as l join "semantic-syntax" as r on l.body = r.id and l.file = r.file where r.kind = "tuple" or r.kind = "list";
let element_fields = select parent, child from "semantic-child" where field = "elts";
let body_elements = select l.outer_call as outer_call, l.file as file, l.span as span, l.path as path, l.body as body, r.child as element from tuple_bodies as l join element_fields as r on l.body = r.parent;
let body_element_counts = group-count(from=body_elements, keys=["outer_call", "file", "span", "path", "body"], count="element_count", distinct="element");
let two_element_dict_bodies = select outer_call as id, file, span from body_element_counts where path = "builtins.dict" and element_count = 2;
let list_set_container_candidates = select outer_call as id, file, span from wrapped_map_calls where path = "builtins.list" or path = "builtins.set";
let container_candidates = union(left=list_set_container_candidates, right=two_element_dict_bodies);
let contained_map_calls = select map_call as call, file from wrapped_map_calls;
let direct_only_map_calls = antijoin(left=safe_map_calls, right=contained_map_calls, left-on=["map_call", "file"], right-on=["call", "file"]);
let direct_candidates = select map_call as id, file, span from direct_only_map_calls;
let raw_candidates = union(left=direct_candidates, right=container_candidates);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from raw_candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let located = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])C417(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:C417)(?:,|$)");
let ruf100_candidates = select file, span from located;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:C417)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:C417)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "C417"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=located, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
