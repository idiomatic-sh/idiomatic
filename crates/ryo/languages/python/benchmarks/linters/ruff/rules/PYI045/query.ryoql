import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let names = select parent as function, child as name, file from "semantic-child" where field = "name";
let identifiers = select id, name, file from "identifier";
let named_functions = select l.function as function, r.name as name, l.file as file from names as l join identifiers as r on l.name = r.id and l.file = r.file;
let iter_methods = select l.function as function, l.file as file from named_functions as l join functions as r on l.function = r.id and l.file = r.file where l.name = "__iter__";
let aiter_methods = select l.function as function, l.file as file from named_functions as l join functions as r on l.function = r.id and l.file = r.file where l.name = "__aiter__";
let returns = select parent as function, child as annotation, file from "semantic-child" where field = "returns";
let iter_return_roots = select l.function as function, l.annotation as annotation, l.file as file from returns as l join iter_methods as r on l.function = r.function and l.file = r.file;
let aiter_return_roots = select l.function as function, l.annotation as annotation, l.file as file from returns as l join aiter_methods as r on l.function = r.function and l.file = r.file;
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_values = select parent as subscript, child as value, file from "semantic-child" where field = "value";
let iter_root_subscript_annotations = select l.function as function, l.annotation as annotation, l.file as file from iter_return_roots as l join subscript_nodes as r on l.annotation = r.id and l.file = r.file;
let root_subscripts = select l.annotation as annotation, r.value as base, l.function as function, l.file as file from iter_root_subscript_annotations as l join subscript_values as r on l.annotation = r.subscript and l.file = r.file;
let async_root_subscript_annotations = select l.function as function, l.annotation as annotation, l.file as file from aiter_return_roots as l join subscript_nodes as r on l.annotation = r.id and l.file = r.file;
let async_root_subscripts = select l.annotation as annotation, r.value as base, l.function as function, l.file as file from async_root_subscript_annotations as l join subscript_values as r on l.annotation = r.subscript and l.file = r.file;
let iter_direct_qnames = select l.annotation as annotation, l.function as function, l.file as file, q.path as path from iter_return_roots as l join "qualified-name" as q on l.annotation = q.id and l.file = q.file;
let iter_subscript_qnames = select l.annotation as annotation, l.function as function, l.file as file, q.path as path from root_subscripts as l join "qualified-name" as q on l.base = q.id and l.file = q.file;
let aiter_direct_qnames = select l.annotation as annotation, l.function as function, l.file as file, q.path as path from aiter_return_roots as l join "qualified-name" as q on l.annotation = q.id and l.file = q.file;
let aiter_subscript_qnames = select l.annotation as annotation, l.function as function, l.file as file, q.path as path from async_root_subscripts as l join "qualified-name" as q on l.base = q.id and l.file = q.file;
let iter_qnames = union(left=iter_direct_qnames, right=iter_subscript_qnames);
let aiter_qnames = union(left=aiter_direct_qnames, right=aiter_subscript_qnames);
let iterable_returns = select annotation, function, file from iter_qnames where path = "typing.Iterable" or path = "collections.abc.Iterable";
let async_iterable_returns = select annotation, function, file from aiter_qnames where path = "typing.AsyncIterable" or path = "collections.abc.AsyncIterable";
let methods = select function, file from iter_methods;
let async_methods = select function, file from aiter_methods;
let method_axis = select function as id, file from iter_methods;
let async_method_axis = select function as id, file from aiter_methods;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let method_classes = axis(from=method_axis, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let async_method_classes = axis(from=async_method_axis, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let class_iter_methods = select l.function as function, l.file as file from methods as l join method_classes as c on l.function = c.id and l.file = c.file;
let class_aiter_methods = select l.function as function, l.file as file from async_methods as l join async_method_classes as c on l.function = c.id and l.file = c.file;
let iter_candidates = select l.annotation as id, l.file as file from iterable_returns as l join class_iter_methods as r on l.function = r.function and l.file = r.file;
let aiter_candidates = select l.annotation as id, l.file as file from async_iterable_returns as l join class_aiter_methods as r on l.function = r.function and l.file = r.file;
let all_candidates = union(left=iter_candidates, right=aiter_candidates);
let locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from all_candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI045(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI045(?:,|$)");
let ruf100_matches = observation_matches(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI045(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI045(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI045"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
