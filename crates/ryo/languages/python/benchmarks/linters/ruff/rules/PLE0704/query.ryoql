import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let raises = select id, file from nodes where kind = "raise";
let exception_edges = select parent, file from "semantic-child" where field = "exc";
let bare_raises = antijoin(left=raises, right=exception_edges, left-on=["id", "file"], right-on=["parent", "file"]);
let scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda" or kind = "module";
let handlers = select id, file from nodes where kind = "except-handler";
let scope_or_handler = union(left=scopes, right=handlers);
let raise_contexts = axis(from=bare_raises, relation="semantic-child", direction=nearest-ancestor, domain=scope_or_handler);
let handled_raises = select l.id as id, l.file as file from raise_contexts as l join handlers as r on l.related = r.id and l.file = r.file;
let unhandled_raises = antijoin(left=bare_raises, right=handled_raises, left-on=["id", "file"], right-on=["id", "file"]);
let raise_scopes = axis(from=unhandled_raises, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let classes = select id, file from nodes where kind = "class-def";
let method_scopes = select l.child as function, l.file as file from "scope" as l join classes as r on l.parent = r.id and l.file = r.file;
let exit_names = select id as function, file from "defines" where name = "__exit__";
let exit_methods = select l.function as function, l.file as file from method_scopes as l join exit_names as r on l.function = r.function and l.file = r.file;
let decorators = select declaration as function, occurrence as decorator, file from "decorates";
let decorator_expressions = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_origins = select l.function as function, r.path as path, l.file as file from decorator_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let called_expressions = select l.function as function, r.child as expression, l.file as file from decorator_expressions as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "func";
let called_origins = select l.function as function, r.path as path, l.file as file from called_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=called_origins);
let non_instance_decorators = select function, file from origins where path = "builtins.staticmethod" or path = "builtins.classmethod" or path = "abc.abstractstaticmethod" or path = "abc.abstractclassmethod";
let instance_exit_methods = antijoin(left=exit_methods, right=non_instance_decorators, left-on=["function", "file"], right-on=["function", "file"]);
let allowed_exit_raises = select l.id as id, l.file as file from raise_scopes as l join instance_exit_methods as r on l.related = r.function and l.file = r.file;
let reportable = antijoin(left=unhandled_raises, right=allowed_exit_raises, left-on=["id", "file"], right-on=["id", "file"]);
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PLE0704($|[, #])", range-pattern="(?:^|,)PLE0704(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="PLE0704($|[, #])", range-pattern="(?:^|,)PLE0704(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE0704"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
