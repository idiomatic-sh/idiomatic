import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let attributes = select id, file from nodes where kind = "attribute";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let named_attributes_join_1 = select l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from attributes as l join attr_edges as e on l.id = e.parent and l.file = e.file;
let named_attributes = select l.l_id as id, r.name as name, l.l_file as file from named_attributes_join_1 as l join "identifier" as r on l.e_child = r.id and l.e_file = r.file;
let dictionaries = select id, file from named_attributes where name = "__dict__";
let gets = select id, file from named_attributes where name = "get";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let get_receivers = select l.id as id, r.child as receiver, l.file as file from gets as l join value_edges as r on l.id = r.parent and l.file = r.file;
let dictionary_gets = select l.id as id, l.file as file from get_receivers as l join dictionaries as r on l.receiver = r.id and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let get_calls_join_1 = select l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from calls as l join func_edges as e on l.id = e.parent and l.file = e.file;
let get_calls = select l.l_id as id, l.l_file as file from get_calls_join_1 as l join dictionary_gets as r on l.e_child = r.id and l.e_file = r.file;
let arguments = select call, expression, position, file from "call-argument";
let counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="expression");
let short_calls = select l.id as id, l.file as file from get_calls as l join counts as r on l.id = r.call and l.file = r.file where r.count <= 2;
let keywords = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keywords, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_calls = select related as id, file from keyword_owners;
let positional_calls = antijoin(left=short_calls, right=keyword_calls, left-on=["id","file"], right-on=["id","file"]);
let string_nodes = select id, file from "literal-properties" where kind = "string";
let annotation_keys = select l.id as id, l.file as file from string_nodes as l join "string-literal" as r on l.id = r.occurrence and l.file = r.file where r.value = "__annotations__";
let first_arguments = select call, expression, file from arguments where position = 0;
let keyed_calls_join_1 = select l.id as l_id, l.file as l_file, a.call as a_call, a.file as a_file, a.expression as a_expression from positional_calls as l join first_arguments as a on l.id = a.call and l.file = a.file;
let keyed_calls = select l.l_id as id, l.l_file as file from keyed_calls_join_1 as l join annotation_keys as r on l.a_expression = r.id and l.a_file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_receivers = select l.id as id, r.child as receiver, l.file as file from subscripts as l join value_edges as r on l.id = r.parent and l.file = r.file;
let dictionary_subscripts = select l.id as id, l.file as file from subscript_receivers as l join dictionaries as r on l.receiver = r.id and l.file = r.file;
let slices = select parent, child, file from "semantic-child" where field = "slice";
let keyed_subscripts_join_1 = select l.id as l_id, l.file as l_file, s.parent as s_parent, s.file as s_file, s.child as s_child from dictionary_subscripts as l join slices as s on l.id = s.parent and l.file = s.file;
let keyed_subscripts = select l.l_id as id, l.l_file as file from keyed_subscripts_join_1 as l join annotation_keys as r on l.s_child = r.id and l.s_file = r.file;
let selected = union(left=keyed_calls, right=keyed_subscripts);
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF063(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF063)(?:,|$)");
emit violations subject file key(id);
