import suppress from "python/ruff/suppress";
let deprecated_text_names = select id, file from "qualified-name" where path = "typing.Text" or path = "typing_extensions.Text";
let reportable = select l.id as id, l.file as file, r.span as span from deprecated_text_names as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP019(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP019)(?:,|$)");
emit violations subject file key(id);
