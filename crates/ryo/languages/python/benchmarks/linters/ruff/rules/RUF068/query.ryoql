import suppress from "python/ruff/suppress";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let assignments = select id, kind, file from nodes where kind = "assign" or kind = "ann-assign" or kind = "aug-assign";
let plain_assignments = select id, file from assignments where kind = "assign";
let plain_targets = select l.id as assignment, r.child as target, l.file as file from plain_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets";
let target_counts = group-count(from=plain_targets, keys=["assignment","file"], count="count", distinct="target");
let single_plain_targets = select l.assignment as assignment, l.target as target, l.file as file from plain_targets as l join target_counts as r on l.assignment = r.assignment and l.file = r.file where r.count = 1;
let other_assignments = select id, file from assignments where kind = "ann-assign" or kind = "aug-assign";
let other_targets = select l.id as assignment, r.child as target, l.file as file from other_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let all_targets = union(left=single_plain_targets, right=other_targets);
let all_names = select id, file from nodes where kind = "name";
let name_targets = select l.assignment as assignment, l.target as target, l.file as file from all_targets as l join all_names as r on l.target = r.id and l.file = r.file;
let dunder_targets = select l.assignment as id, l.file as file from name_targets as l join "identifier" as r on l.target = r.id and l.file = r.file where r.name = "__all__";
let add_tokens = select id, file from nodes where text = "+" or text = "+=";
let add_operators = select l.parent as id, l.file as file from "semantic-child" as l join add_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let augments = select id, file from assignments where kind = "aug-assign";
let non_add_augments = antijoin(left=augments, right=add_operators, left-on=["id","file"], right-on=["id","file"]);
let eligible_targets = antijoin(left=dunder_targets, right=non_add_augments, left-on=["id","file"], right-on=["id","file"]);
let scope_nodes = select id, kind, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let assignment_scopes = axis(from=eligible_targets, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let module_assignments = select l.id as id, l.file as file from assignment_scopes as l join scope_nodes as r on l.related = r.id and l.file = r.file where r.kind = "module";
let assignment_values = select l.id as owner, r.child as value, l.file as file from module_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let calls = select id, file from nodes where kind = "call";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let call_funcs = select l.id as call, r.child as func, l.file as file from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let call_attrs = select l.call as call, l.func as attribute, l.file as file from call_funcs as l join attributes as r on l.func = r.id and l.file = r.file;
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_names_join_1 = select l.call as l_call, l.attribute as l_attribute, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from call_attrs as l join attr_edges as e on l.attribute = e.parent and l.file = e.file;
let attr_names = select l.l_call as call, l.l_attribute as attribute, l.l_file as file, r.name as name from attr_names_join_1 as l join "identifier" as r on l.e_child = r.id and l.e_file = r.file;
let extend_attrs = select call, attribute, file from attr_names where name = "extend";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let receivers = select l.call as call, r.child as receiver, l.file as file from extend_attrs as l join value_edges as r on l.attribute = r.parent and l.file = r.file;
let name_receivers = select l.call as call, l.receiver as receiver, l.file as file from receivers as l join all_names as r on l.receiver = r.id and l.file = r.file;
let dunder_calls = select l.call as id, l.file as file from name_receivers as l join "identifier" as r on l.receiver = r.id and l.file = r.file where r.name = "__all__";
let call_scopes = axis(from=dunder_calls, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let module_calls = select l.id as id, l.file as file from call_scopes as l join scope_nodes as r on l.related = r.id and l.file = r.file where r.kind = "module";
let arguments = select call, expression as value, position, file from "call-argument";
let argument_counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="value");
let one_argument_calls = select l.id as call, l.file as file from module_calls as l join argument_counts as r on l.id = r.call and l.file = r.file where r.count = 1;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_calls = select related as call, file from keyword_owners;
let positional_calls = antijoin(left=one_argument_calls, right=keyword_calls, left-on=["call","file"], right-on=["call","file"]);
let extend_values = select l.call as owner, r.value as value, l.file as file from positional_calls as l join arguments as r on l.call = r.call and l.file = r.file where r.position = 0;
let all_values = union(left=assignment_values, right=extend_values);
let collections = select id, file from nodes where kind = "list" or kind = "tuple";
let collection_values = select l.owner as owner, l.value as collection, l.file as file from all_values as l join collections as r on l.value = r.id and l.file = r.file;
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let elements = select l.collection as collection, r.child as id, l.file as file from collection_values as l join element_edges as r on l.collection = r.parent and l.file = r.file;
let strings = select id, file from "literal-properties" where kind = "string";
let string_elements = select l.collection as collection, l.id as id, l.file as file from elements as l join strings as r on l.id = r.id and l.file = r.file;
let keyed = select l.collection as collection, l.id as id, r.key as key, l.file as file from string_elements as l join "constant-key" as r on l.id = r.id and l.file = r.file;
let ordered = select l.collection as collection, l.id as id, l.key as key, l.file as file, r."start-byte" as begin from keyed as l join "source-location" as r on l.id = r.id and l.file = r.file;
let repeated = ordered-match(left=ordered, right=ordered, left-on=[collection,file,key], right-on=[collection,file,key], left-order="begin", right-order="begin", output={id:[right,id],file:[right,file]});
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from repeated as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF068(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF068)(?:,|$)");
emit violations subject file key(id);
