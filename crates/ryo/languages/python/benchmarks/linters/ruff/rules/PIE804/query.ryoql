import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners0 = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let argument_owners = select l.call as call, l.wrapper as wrapper, l.file as file from argument_owners0 as l join calls as r on l.call = r.id and l.file = r.file;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from argument_owners as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id, file, span from "semantic-syntax" where kind = "keyword";
let keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id and l.file = r.file;
let keyword_arg_fields = select parent as keyword from "semantic-child" where field = "arg";
let anonymous_keywords = antijoin(left=keywords, right=keyword_arg_fields, left-on=["keyword"], right-on=["keyword"]);
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_values = select l.call as call, l.keyword as keyword, l.file as file, r.child as value from anonymous_keywords as l join keyword_value_fields as r on l.keyword = r.parent;
let dictionaries = select id, file from "semantic-syntax" where kind = "dict";
let dictionary_values = select parent as dict, child as value, file from "semantic-child" where field = "values";
let dictionary_keys = select parent as dict, child as key, file from "semantic-child" where field = "keys";
let string_keys0 = select l.dict as dict, l.key as key, l.file as file, r.value as value from dictionary_keys as l join "string-literal" as r on l.key = r.occurrence and l.file = r.file;
let literal_strings = select id, file from "literal-properties" where kind = "string";
let string_keys = select l.dict as dict, l.key as key, l.file as file, l.value as value from string_keys0 as l join literal_strings as r on l.key = r.id and l.file = r.file;
let identifier_string_keys = select dict, key, file, value from string_keys where matches(value, "^[_\p{XID_Start}][_\p{XID_Continue}]*$");
let keyword_string_keys = select dict, key, file, value from string_keys where value = "False" or value = "None" or value = "True" or value = "and" or value = "as" or value = "assert" or value = "async" or value = "await" or value = "break" or value = "class" or value = "continue" or value = "def" or value = "del" or value = "elif" or value = "else" or value = "except" or value = "finally" or value = "for" or value = "from" or value = "global" or value = "if" or value = "import" or value = "in" or value = "is" or value = "lambda" or value = "nonlocal" or value = "not" or value = "or" or value = "pass" or value = "raise" or value = "return" or value = "try" or value = "while" or value = "with" or value = "yield";
let nonkeyword_identifier_keys = antijoin(left=identifier_string_keys, right=keyword_string_keys, left-on=["key", "file"], right-on=["key", "file"]);
let invalid_keys = antijoin(left=dictionary_keys, right=nonkeyword_identifier_keys, left-on=["key", "file"], right-on=["key", "file"]);
let invalid_key_dicts = select dict, file from invalid_keys;
let dictionaries_with_invalid_keys = select l.id as id, l.file as file from dictionaries as l join invalid_key_dicts as r on l.id = r.dict and l.file = r.file;
let keys_per_dictionary = group-count(from=dictionary_keys, keys=["dict", "file"], count="key_count", distinct="key");
let dictionaries_with_keys = select dict as id, file from keys_per_dictionary;
let empty_key_dictionaries = antijoin(left=dictionaries, right=dictionaries_with_keys, left-on=["id", "file"], right-on=["id", "file"]);
let value_counts = group-count(from=dictionary_values, keys=["dict", "file"], count="value_count", distinct="value");
let paired_dict_counts = select l.dict as dict, l.file as file from value_counts as l join keys_per_dictionary as r on l.dict = r.dict and l.file = r.file where l.value_count = r.key_count;
let spread_dicts = antijoin(left=value_counts, right=paired_dict_counts, left-on=["dict", "file"], right-on=["dict", "file"]);
let one_value_dicts = select dict, file from value_counts where value_count = 1;
let exact_nested_spread0 = antijoin(left=one_value_dicts, right=dictionaries_with_keys, left-on=["dict", "file"], right-on=["id", "file"]);
let exact_nested_spread = select dict as id, file from exact_nested_spread0;
let not_spread_dictionaries = antijoin(left=dictionaries, right=spread_dicts, left-on=["id", "file"], right-on=["dict", "file"]);
let valid_key_dictionaries = antijoin(left=not_spread_dictionaries, right=dictionaries_with_invalid_keys, left-on=["id", "file"], right-on=["id", "file"]);
let candidate_dicts = union(left=valid_key_dictionaries, right=exact_nested_spread);
let candidate_keywords = select l.keyword as keyword, l.file as file from keyword_values as l join candidate_dicts as r on l.value = r.id and l.file = r.file;
let candidates = select l.keyword as id, l.file as file, r.span as span from candidate_keywords as l join keyword_nodes as r on l.keyword = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PIE804(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PIE804)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PIE804(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PIE804)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PIE804"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
