import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/suppression-edges";
let module_roots = select id, file, span from "semantic-syntax" where kind = "module";
let modules = extend(from=module_roots, values={base_line: 1});
let captured_lines = source-matches(from=modules, span="span", base-line="base_line", pattern="(?m)^(?P<line>[^\r\n]+)", output="whole", line-output="whole_line", capture="line", capture-output="line_span", capture-text-output="text", capture-line-output="line");
let raw_lines = select id, file, line_span as span, text, line from captured_lines;
let line_positions = span-bounds(from=raw_lines, span="span", start-output="begin", end-output="finish");
let comments = select id, file, span from "comment";
let pragma_comments = source-matches(from=comments, span="span", pattern="#[^\S\r\n]*(?:(?i:noqa)(?:$|\s|:)|type:[^\S\r\n]*ignore).*", output="pragma_span");
let pragma_positions = span-bounds(from=pragma_comments, span="pragma_span", start-output="begin", end-output="finish");
let pragma_points = source-matches(from=pragma_positions, span="pragma_span", pattern="^", output="point");
let pragma_lines = select l.id as id, l.file as file, l.span as span, l.line as line, r.point as point from line_positions as l join pragma_points as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let prefixes = span-between(from=pragma_lines, start="span", end="point", output="prefix_span");
let trimmed = source-matches(from=prefixes, span="prefix_span", pattern="(?s)^(?P<body>.*\S)[ \t]*$", output="prefix_whole", capture="body", capture-output="body_span", capture-text-output="body_text");
let normal_lines = antijoin(left=raw_lines, right=pragma_lines, left-on=[id, file, span], right-on=[id, file, span]);
let content_lines = select id, file, body_span as span, body_text as text, line from trimmed;
let lines = union(left=normal_lines, right=content_lines);
let fitting = fits-rendered(from=lines, texts=[text], literals=["", ""], span="span", max-line=88, tab-width=4);
let long = antijoin(left=lines, right=fitting, left-on=[id, file, span], right-on=[id, file, span]);
let words = select id, file, span from long where matches(text, "^\s*\S+\s*$");
let license_headers = select id, file, span from long where matches(text, "^\s*#\s*SPDX-(?:License-Identifier|FileCopyrightText):");
let urls = source-matches(from=long, span="span", pattern="(?P<url>https?://\S+)\s*$", output="url_whole", capture="url", capture-output="url_span");
let url_prefixes = extend(from=urls, values={empty_text: ""});
let fitting_urls = fits-rendered(from=url_prefixes, texts=[empty_text], literals=["", ""], span="url_span", max-line=88, tab-width=4);
let url_lines = select id, file, span from fitting_urls;
let exceptions_a = union(left=words, right=license_headers);
let exceptions = union(left=exceptions_a, right=url_lines);
let reportable_lines = antijoin(left=long, right=exceptions, left-on=[id, file, span], right-on=[id, file, span]);
let characters = source-matches(from=reportable_lines, span="span", pattern="(?P<char>.)", output="whole_char", capture="char", capture-output="char_span", capture-text-output="char_text");
let fitting_chars = fits-rendered(from=characters, texts=[char_text], literals=["", ""], span="char_span", max-line=88, tab-width=4);
let overflow_chars = antijoin(left=characters, right=fitting_chars, left-on=[id, file, char_span], right-on=[id, file, char_span]);
let positions = span-bounds(from=overflow_chars, span="char_span", start-output="begin", end-output="finish");
let later_chars = select l.id as id, l.file as file, l.char_span as char_span from positions as l join positions as r on l.id = r.id and l.file = r.file and l.span = r.span where l.begin > r.begin;
let first_chars = antijoin(left=positions, right=later_chars, left-on=[id, file, char_span], right-on=[id, file, char_span]);
let tails = span-between(from=first_chars, start="char_span", end="span", output="violation_span");
let candidates = select id, file, violation_span as span, line from tails;
let mappings = noqa_line_map();
let locations = noqa_locations(candidates=candidates, mappings=mappings);
let additional = select id, file, line from candidates where id != id;
let matches = suppression_edges(candidates=candidates, locations=locations, additional_locations=additional, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:E501)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:E501)(?:,|$)");
let violations = antijoin(left=locations, right=matches, left-on=[id, span], right-on=[id, span]);
let matched = select directive, file from matches where scope = 0 or scope = 1;
let noqa_matches = extend(from=matched, values={code: "E501"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id, span);
