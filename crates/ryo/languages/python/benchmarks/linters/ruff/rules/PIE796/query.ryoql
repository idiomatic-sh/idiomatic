import observation_matches from "python/ruff/suppress-matches";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let arg_tokens = select l.parent as keyword, r.child as token from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let identifiers = select id, text from semantic_identifiers;
let named_keywords = select l.keyword as id, r.text as name from arg_tokens as l join identifiers as r on l.token = r.id;
let unordered_keyword_names = select l.call as call, l.id as id, r.name as name from keywords as l join named_keywords as r on l.id = r.id;
let ordered_keyword_names = select l.call as call, l.id as id, l.name as name, r."start-byte" as begin from unordered_keyword_names as l join "source-location" as r on l.id = r.id;
let later_keyword_names = select l.id as id from ordered_keyword_names as l join ordered_keyword_names as r on l.call = r.call and l.name = r.name where l.begin > r.begin;
let keyword_names = antijoin(left=unordered_keyword_names, right=later_keyword_names, left-on=["id"], right-on=["id"]);
let enum_names = select id from qualified_names where path = "enum.Enum";
let classes = select id from "semantic-syntax" where kind = "class-def";
let class_arguments = select l.id as owner, r.id as id from classes as l join call_arguments as r on l.id = r.call;
let base_fields = select parent, child from "semantic-child" where field = "bases";
let class_bases = select l.owner as owner, r.child as id from class_arguments as l join base_fields as r on l.id = r.parent;
let enums = select l.owner as id from class_bases as l join enum_names as r on l.id = r.id;
let body_fields = select parent, child from "semantic-child" where field = "body";
let statements = select l.id as owner, r.child as id from enums as l join body_fields as r on l.id = r.parent;
let assignments = select id, file, span from "semantic-syntax" where kind = "assign";
let enum_assignments = select l.owner as owner, r.id as id, r.file as file, r.span as span from statements as l join assignments as r on l.id = r.id;
let value_fields = select parent, child from "semantic-child" where field = "value";
let values = select l.owner as owner, l.id as statement, r.child as id, l.file as file from enum_assignments as l join value_fields as r on l.id = r.parent;
let auto_names = select id from qualified_names where path = "enum.auto";
let auto_calls = select l.parent as id from functions as l join auto_names as r on l.child = r.id;
let tuple_nodes = select id from "semantic-syntax" where kind = "tuple";
let element_fields = select parent, child from "semantic-child" where field = "elts";
let tuple_elements = select l.id as owner, r.child as id from tuple_nodes as l join element_fields as r on l.id = r.parent;
let auto_tuples = select l.owner as id from tuple_elements as l join auto_calls as r on l.id = r.id;
let auto_values = union(left=auto_calls, right=auto_tuples);
let explicit_values = antijoin(left=values, right=auto_values, left-on=["id"], right-on=["id"]);
let constants = select id from "semantic-syntax" where kind = "constant";
let ellipsis_tokens = select id from "semantic-syntax" where text = "...";
let ellipsis_fields = select l.parent as id from "semantic-child" as l join ellipsis_tokens as r on l.child = r.id;
let ellipses = select l.id as id from constants as l join ellipsis_fields as r on l.id = r.id;
let cast_names = select id from qualified_names where path = "typing.cast" or path = "typing_extensions.cast";
let cast_calls = select l.parent as id from functions as l join cast_names as r on l.child = r.id;
let counts = group-count(from=positional, keys=["call"], count="count", distinct="id");
let two_arguments = select call from counts where count = 2;
let binary_casts = select l.id as id from cast_calls as l join two_arguments as r on l.id = r.call;
let no_keywords = antijoin(left=binary_casts, right=keywords, left-on=["id"], right-on=["call"]);
let second_arguments = select call, id from positional where ordinal = 1;
let unknown_arguments = select l.call as id from second_arguments as l join ellipses as r on l.id = r.id;
let cast_ellipses = select l.id as id from no_keywords as l join unknown_arguments as r on l.id = r.id;
let stub_unknowns = union(left=ellipses, right=cast_ellipses);
let stub_values = select * from explicit_values where matches(file, "\.pyi$");
let unknown_statements = select l.statement as id from stub_values as l join stub_unknowns as r on l.id = r.id;
let known_values = antijoin(left=explicit_values, right=unknown_statements, left-on=["statement"], right-on=["id"]);
let shaped = select l.owner as owner, l.statement as id, r.shape as shape, r.file as file from known_values as l join "expression-shape" as r on l.id = r.id;
let ordered = select l.owner as owner, l.id as id, l.shape as shape, l.file as file, r."start-byte" as begin from shaped as l join "source-location" as r on l.id = r.id;
let duplicates = select l.id as id from ordered as l join ordered as r on l.owner = r.owner and l.file = r.file and l.shape = r.shape where l.begin > r.begin;
let reportable = select l.id as id, l.file as file, l.span as span from enum_assignments as l join duplicates as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:PIE796)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PIE796"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
