import suppress from "python/ruff/suppress";
import without_effect from "python/ruff/without-effect";
let b_calls = select id, file, span from "semantic-syntax" where kind = "call";
let b_function_fields = select parent, child from "semantic-child" where field = "func";
let b_call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from b_function_fields as l join b_calls as r on l.parent = r.id;
let b_attributes = select id, file from "semantic-syntax" where kind = "attribute";
let b_value_fields = select parent, child from "semantic-child" where field = "value";
let b_attr_values = select l.id as attribute, l.file as file, r.child as receiver from b_attributes as l join b_value_fields as r on l.id = r.parent;
let b_string_values = select occurrence as receiver, file from "string-literal";
let b_literal_receivers = select l.attribute as attribute, l.file as file, r.receiver as receiver from b_attr_values as l join b_string_values as r on l.receiver = r.receiver and l.file = r.file;
let b_attr_fields = select parent, child from "semantic-child" where field = "attr";
let b_attr_children = select l.attribute as attribute, l.file as file, r.child as name_id from b_literal_receivers as l join b_attr_fields as r on l.attribute = r.parent;
let b_format_attributes = select l.attribute as attribute, l.file as file from b_attr_children as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "format";
let b_format_calls = select l.call as call, l.function as function, l.file as file, l.span as span from b_call_functions as l join b_format_attributes as r on l.function = r.attribute and l.file = r.file;
let b_argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let b_argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join b_argument_nodes as r on l.child = r.id;
let b_positional_fields = select parent, child from "semantic-child" where field = "args";
let b_positional_arguments = select l.call as call, r.child as argument, l.file as file from b_argument_owners as l join b_positional_fields as r on l.wrapper = r.parent;
let b_format_calls_with_literal = select l.call as call, l.file as file, l.span as span, r.receiver as format_id from b_format_calls as l join b_literal_receivers as r on l.function = r.attribute and l.file = r.file;
let parsed = select p.id as format_id, p.file as file from "brace-format-parse" as p where p.outcome = "parsed" and p."nested-field-count" = 0;
let calls0 = select l.call as call, l.format_id as format_id, l.file as file, l.span as span from b_format_calls_with_literal as l join parsed as r on l.format_id = r.format_id and l.file = r.file;
let call_args = select l.call as call, r.expression as argument, r.position as position, r.file as file, r.span as span from calls0 as l join "call-argument" as r on l.call = r.call and l.file = r.file;
let argument_counts = group-count(from=call_args, keys=["call","file"], count="argument_count");
let with_arguments = select call, file from argument_counts;
let calls1 = select l.call as call, l.format_id as format_id, l.file as file, l.span as span from calls0 as l join with_arguments as r on l.call = r.call and l.file = r.file;
let argument_text_restrictions = source-matches(from=call_args, span="span", pattern="[\x22\x27\r\n]", output="forbidden");
let starred = select id, file from "semantic-syntax" where kind = "starred";
let starred_calls = select l.call as call, l.file as file from call_args as l join starred as r on l.argument = r.id and l.file = r.file;
let wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from b_argument_owners as l join calls1 as r on l.call = r.call and l.file = r.file;
let keyword_nodes = select l.call as call, r.child as keyword, l.file as file from wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let keyword_labels = select l.call as call, l.keyword as keyword, r.child as label, l.file as file from keyword_nodes as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let unpacked = antijoin(left=keyword_nodes, right=keyword_labels, left-on=[keyword,file], right-on=[keyword,file]);
let bad_text = select call, file from argument_text_restrictions;
let bad_unpacking = select call, file from unpacked;
let rejected0 = union(left=starred_calls, right=bad_text);
let rejected = union(left=rejected0, right=bad_unpacking);
let calls2 = antijoin(left=calls1, right=rejected, left-on=[call,file], right-on=[call,file]);
let positional = select l.call as call, l.argument as argument, l.file as file, r.position as position from b_positional_arguments as l join call_args as r on l.call = r.call and l.argument = r.argument and l.file = r.file;
let named_keywords = select l.call as call, l.keyword as keyword, l.file as file, r.name as name from keyword_labels as l join "identifier" as r on l.label = r.id and l.file = r.file;
let keywords = select l.call as call, l.name as name, l.file as file, r.child as argument from named_keywords as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let fields = select id as format_id, ordinal, "selector-kind" as kind, "selector-index" as position, "selector-name" as name, "index-overflow" as overflow, file from "brace-format-field" where context = "literal";
let call_fields = select l.call as call, r.ordinal as ordinal, r.kind as kind, r.position as position, r.name as name, r.overflow as overflow, l.file as file from calls2 as l join fields as r on l.format_id = r.format_id and l.file = r.file;
let indexed_fields = select l.call as call, l.ordinal as ordinal, l.file as file, r.argument as argument from call_fields as l join positional as r on l.call = r.call and l.position = r.position and l.file = r.file where l.overflow = "false" and (l.kind = "automatic" or l.kind = "index");
let keyword_fields = select l.call as call, l.ordinal as ordinal, l.file as file, r.argument as argument from call_fields as l join keywords as r on l.call = r.call and l.name = r.name and l.file = r.file where l.kind = "keyword";
let resolved_fields = union(left=indexed_fields, right=keyword_fields);
let missing = antijoin(left=call_fields, right=resolved_fields, left-on=[call,ordinal,file], right-on=[call,ordinal,file]);
let uses = group-count(from=resolved_fields, keys=[call,argument,file], count="uses");
let repeated = select call, argument, file from uses where uses > 1;
let argument_ids = select argument as id, file from call_args;
let pure0 = without_effect(expressions=argument_ids);
let all_calls = select id, file from "semantic-syntax" where kind = "call";
let called_descendants = axis(from=argument_ids, relation="semantic-child", direction=descendant, domain=all_calls);
let root_calls = select l.id as id, l.file as file from argument_ids as l join all_calls as r on l.id = r.id and l.file = r.file;
let descendant_calls = select id, file from called_descendants;
let called = union(left=root_calls, right=descendant_calls);
let pure = antijoin(left=pure0, right=called, left-on=[id,file], right-on=[id,file]);
let unsafe_repeat = antijoin(left=repeated, right=pure, left-on=[argument,file], right-on=[id,file]);
let missing_calls = select call, file from missing;
let repeat_calls = select call, file from unsafe_repeat;
let rejected_fields = union(left=missing_calls, right=repeat_calls);
let calls3 = antijoin(left=calls2, right=rejected_fields, left-on=[call,file], right-on=[call,file]);
let translation_functions = select id, file from "qualified-name" where path = "django.utils.translation.gettext" or path = "django.utils.translation.gettext_lazy";
let translated_calls = select l.call as id, l.file as file from b_call_functions as l join translation_functions as r on l.function = r.id and l.file = r.file;
let call_ids = select call as id, file from calls3;
let translated_ancestors = axis(from=call_ids, relation="semantic-child", direction=ancestor, domain=translated_calls);
let in_translation = select id, file from translated_ancestors;
let selected = antijoin(left=calls3, right=in_translation, left-on=[call,file], right-on=[id,file]);
let locations = select l.call as id, l.file as file, l.span as span, r."start-line" as line from selected as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="(?:^|[^A-Z0-9])UP032(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP032(?:,|$)");
emit violations subject file key(id);
