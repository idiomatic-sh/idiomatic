import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let sleep_targets = select id, path from "qualified-name" where path = "trio.sleep" or path = "anyio.sleep";
let sleep_calls = select l.call as call, r.path as path, r.id as function from call_functions as l join sleep_targets as r on l.function = r.id;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_argument_nodes = select l.parent as call, r.id as arguments from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_argument_ids = select l.call as call, r.child as id from call_argument_nodes as l join positional_fields as r on l.arguments = r.parent;
let positional_argument_rows = select l.call as call, l.id as id, r.path as path from positional_argument_ids as l join sleep_calls as r on l.call = r.call;
let positional_arguments = extend(from=positional_argument_rows, values={name: ""});
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_arguments = select l.call as call, r.child as id from call_argument_nodes as l join keyword_fields as r on l.arguments = r.parent;
let keyword_values = select parent, child from "semantic-child" where field = "value";
let keyword_value_arguments = select l.call as call, l.id as keyword, r.child as id from keyword_arguments as l join keyword_values as r on l.id = r.parent;
let keyword_name_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_name_ids = select l.keyword as keyword, r.child as id from keyword_value_arguments as l join keyword_name_fields as r on l.keyword = r.parent;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as name from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let identifiers = select l.id as id, l.name as name from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let keyword_argument_name_ids = select l.call as call, l.id as id, r.id as name_id from keyword_value_arguments as l join keyword_name_ids as r on l.keyword = r.keyword;
let keyword_argument_names = select l.call as call, l.id as id, r.name as name from keyword_argument_name_ids as l join "identifier" as r on l.name_id = r.id;
let keyword_named_sleep_arguments = select l.call as call, l.id as id, s.path as path, l.name as name from keyword_argument_names as l join sleep_calls as s on l.call = s.call;
let candidate_arguments = union(left=positional_arguments, right=keyword_named_sleep_arguments);
let all_positional_argument_ids = select call, id from positional_argument_rows;
let all_keyword_argument_ids = select call, id from keyword_value_arguments;
let all_argument_ids = union(left=all_positional_argument_ids, right=all_keyword_argument_ids);
let argument_counts = group-count(from=all_argument_ids, keys=["call"], count="count", distinct="id");
let one_arguments = select call from argument_counts where count = 1;
let single_arguments = select l.call as call, l.id as id, l.path as path, l.name as name from candidate_arguments as l join one_arguments as r on l.call = r.call;
let relevant_positional = select l.call as call, l.id as id from single_arguments as l where l.name = "";
let relevant_keyword = select l.call as call, l.id as id from single_arguments as l where (l.path = "trio.sleep" and l.name = "seconds") or (l.path = "anyio.sleep" and l.name = "delay");
let eligible_arguments = union(left=relevant_positional, right=relevant_keyword);
let zero_integer_literals = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let zero_sleep_calls = select l.call as id from eligible_arguments as l join zero_integer_literals as r on l.id = r.id;
let reportable = select l.id as id, r.file as file, r.span as span from zero_sleep_calls as l join calls as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC115(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC115)(?:,|$)");
emit violations subject file key(id);
