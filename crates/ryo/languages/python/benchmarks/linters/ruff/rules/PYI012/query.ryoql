import suppress from "python/ruff/suppress";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let multiple = select l.parent as id from bodies as l join bodies as r on l.parent = r.parent where l.ordinal != r.ordinal;
let single = antijoin(left=bodies, right=multiple, left-on=["parent"], right-on=["id"]);
let classes = select id from "semantic-syntax" where kind = "class-def" and glob_any(file, "**/*.pyi");
let nonempty = select l.id as id from classes as l join multiple as r on l.id = r.id;
let scoped = select r.child as id from nonempty as l join bodies as r on l.id = r.parent;
let passes = select id, file, span from "semantic-syntax" where kind = "pass";
let reportable = select r.id as id, r.file as file, r.span as span from scoped as l join passes as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI012(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI012)(?:,|$)");
emit violations subject file key(id);
