import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";

let syntax = select id, kind, file from "semantic-syntax";
let tries = select id, file from syntax where kind = "try" or kind = "try-star";
let returns = select id, file from syntax where kind = "return";
let handlers = select id, file from syntax where kind = "except-handler";
let body_edges = select parent, child, ordinal, file from "semantic-child" where field = "body";
let handler_edges = select parent as try_node, child as handler, file from "semantic-child" where field = "handlers";
let final_edges = select parent as try_node, child as statement, ordinal, file from "semantic-child" where field = "finalbody";

let try_bodies = select l.id as try_node, r.child as statement, l.file as file from tries as l join body_edges as r on l.id = r.parent and l.file = r.file;
let try_returns = select l.try_node as try_node, l.file as file from try_bodies as l join returns as r on l.statement = r.id and l.file = r.file;
let try_handlers0 = select l.id as try_node, r.handler as handler, l.file as file from tries as l join handler_edges as r on l.id = r.try_node and l.file = r.file;
let try_handlers = select l.try_node as try_node, l.handler as handler, l.file as file from try_handlers0 as l join handlers as r on l.handler = r.id and l.file = r.file;
let handler_bodies = select l.try_node as try_node, r.child as statement, l.file as file from try_handlers as l join body_edges as r on l.handler = r.parent and l.file = r.file;
let handler_returns = select l.try_node as try_node, l.file as file from handler_bodies as l join returns as r on l.statement = r.id and l.file = r.file;
let earlier_returns = union(left=try_returns, right=handler_returns);

let final_statements = select l.id as try_node, r.statement as statement, r.ordinal as ordinal, l.file as file from tries as l join final_edges as r on l.id = r.try_node and l.file = r.file;
let final_returns = select l.try_node as try_node, l.statement as id, l.ordinal as ordinal, l.file as file from final_statements as l join returns as r on l.statement = r.id and l.file = r.file;
let later_final_returns = select l.id as id, l.file as file from final_returns as l join final_returns as r on l.try_node = r.try_node and l.file = r.file where l.ordinal > r.ordinal;
let first_final_returns = antijoin(left=final_returns, right=later_final_returns, left-on=["id", "file"], right-on=["id", "file"]);
let reportable = select l.id as id, l.file as file from first_final_returns as l join earlier_returns as r on l.try_node = r.try_node and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*SIM107(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM107)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM107)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM107)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM107"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
