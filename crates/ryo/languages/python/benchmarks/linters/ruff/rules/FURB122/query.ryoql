import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import io_base_binding from "python/ruff/io-base-binding";
import lookup_symbol_events from "python/ruff/lookup-symbol-events";
import modernization_symbols from "python/ruff/modernization-symbols";
let nodes = select id, kind, file from "semantic-syntax";
let loops = select id, file from nodes where kind = "for";
let else_parents = select parent as id, file from "semantic-child" where field = "orelse";
let plain_loops = antijoin(left=loops, right=else_parents, left-on=["id","file"], right-on=["id","file"]);
let body_fields = select parent, child, file from "semantic-child" where field = "body";
let bodies = select l.id as loop, r.child as statement, l.file as file from plain_loops as l join body_fields as r on l.id = r.parent and l.file = r.file;
let body_counts = group-count(from=bodies, keys=["loop","file"], count="count", distinct="statement");
let single_bodies = select l.loop as loop, l.statement as statement, l.file as file from bodies as l join body_counts as r on l.loop = r.loop and l.file = r.file where r.count = 1;
let expression_statements = select l.loop as loop, l.statement as statement, l.file as file from single_bodies as l join nodes as r on l.statement = r.id and l.file = r.file where r.kind = "expr";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let expressions = select l.loop as loop, r.child as value, l.file as file from expression_statements as l join value_fields as r on l.statement = r.parent and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let body_calls = select l.loop as loop, l.value as call, l.file as file from expressions as l join calls as r on l.value = r.id and l.file = r.file;
let arguments = select call, expression, passes, file from "call-argument";
let argument_counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="expression");
let one_arg_calls = select l.loop as loop, l.call as call, l.file as file from body_calls as l join argument_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let keyword_values = select r.child as expression, l.file as file from nodes as l join value_fields as r on l.id = r.parent and l.file = r.file where l.kind = "keyword";
let keyword_arguments = select l.call as call, l.file as file from arguments as l join keyword_values as r on l.expression = r.expression and l.file = r.file;
let positional_calls = antijoin(left=one_arg_calls, right=keyword_arguments, left-on=["call","file"], right-on=["call","file"]);
let function_fields = select parent, child, file from "semantic-child" where field = "func";
let functions = select l.loop as loop, l.call as call, r.child as function, l.file as file from positional_calls as l join function_fields as r on l.call = r.parent and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let attr_functions = select l.loop as loop, l.function as attribute, l.file as file from functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let labels = select l.loop as loop, l.attribute as attribute, r.child as label, l.file as file from attr_functions as l join attr_fields as r on l.attribute = r.parent and l.file = r.file;
let write_functions = select l.loop as loop, l.attribute as attribute, l.file as file from labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "write";
let receiver_values = select l.loop as loop, r.child as receiver, l.file as file from write_functions as l join value_fields as r on l.attribute = r.parent and l.file = r.file;
let names = select id, file from nodes where kind = "name";
let receiver_names = select l.loop as loop, l.receiver as receiver, l.file as file from receiver_values as l join names as r on l.receiver = r.id and l.file = r.file;
let receiver_references = select receiver as reference, file from receiver_names;
let io_receivers = io_base_binding(references=receiver_references);
let shaped_loops = select l.loop as id, l.file as file from receiver_names as l join io_receivers as r on l.receiver = r.reference and l.file = r.file;
let target_fields = select parent, child, file from "semantic-child" where field = "target";
let targets = select l.id as loop, r.child as target, l.file as file from shaped_loops as l join target_fields as r on l.id = r.parent and l.file = r.file;
let collection_nodes = select id, file from nodes where kind = "tuple" or kind = "list";
let collection_edges = select l.id as source, r.child as destination, l.file as file from collection_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let starred_nodes = select id, file from nodes where kind = "starred";
let starred_edges = select l.id as source, r.child as destination, l.file as file from starred_nodes as l join value_fields as r on l.id = r.parent and l.file = r.file;
let target_edges = union(left=collection_edges, right=starred_edges);
let target_paths = closure(edges=target_edges, source="source", destination="destination", keys=["file"]);
let nested_targets = select l.loop as loop, r.destination as target, l.file as file from targets as l join target_paths as r on l.target = r.source and l.file = r.file;
let all_targets = union(left=targets, right=nested_targets);
let target_names = select l.loop as loop, l.target as id, l.file as file from all_targets as l join names as r on l.target = r.id and l.file = r.file;
let implicit_origins = select name, file from "implicit-symbol" as catalog where catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10;
let target_spellings = select l.loop as loop, r.name as name, l.file as file from target_names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let implicit_targets = select l.loop as id, l.file as file from target_spellings as l join implicit_origins as r on l.name = r.name and l.file = r.file;
let name_locations = select l.loop as loop, l.id as id, l.file as file, r."start-byte" as start from target_names as l join "source-location" as r on l.id = r.id and l.file = r.file;
let later_names = select l.loop as loop, l.id as id, l.file as file from name_locations as l join name_locations as r on l.loop = r.loop and l.file = r.file where l.start > r.start;
let first_names = antijoin(left=name_locations, right=later_names, left-on=["loop","id","file"], right-on=["loop","id","file"]);
let bind_events = select occurrence as id, phase, ordinal, file from "binding-event" where kind = "bind";
let loop_bindings = select l.loop as loop, l.file as file, r.phase as phase, r.ordinal as ordinal from first_names as l join bind_events as r on l.id = r.id and l.file = r.file;
let loop_ranges = select l.loop as loop, l.phase as phase, l.ordinal as ordinal, l.file as file, r."start-byte" as start, r."end-byte" as end from loop_bindings as l join "source-location" as r on l.loop = r.id and l.file = r.file;
let scopes = select child as id, file from "scope";
let loop_scopes = axis(from=shaped_loops, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let scoped_loops = select l.loop as loop, l.phase as phase, l.ordinal as ordinal, l.start as start, l.end as end, r.related as initial_scope, l.file as file from loop_ranges as l join loop_scopes as r on l.loop = r.id and l.file = r.file;
let all_events = select occurrence as id, phase, ordinal, file from "binding-event";
let event_locations = select l.id as id, l.phase as phase, l.ordinal as ordinal, l.file as file, r."start-byte" as start, r."end-byte" as end from all_events as l join "source-location" as r on l.id = r.id and l.file = r.file;
let prior_events = select l.loop as context, l.initial_scope as initial_scope, l.file as file, r.ordinal as point from scoped_loops as l join event_locations as r on l.file = r.file where r.ordinal < l.ordinal and (r.phase != l.phase or r.end <= l.start);
let zero_prior_rows = select loop as context, initial_scope, file from scoped_loops;
let zero_prior = extend(from=zero_prior_rows, values={point: 0});
let all_prior = union(left=prior_events, right=zero_prior);
let earlier_prior = select l.context as context, l.point as point, l.file as file from all_prior as l join all_prior as r on l.context = r.context and l.file = r.file where l.point < r.point;
let last_prior = antijoin(left=all_prior, right=earlier_prior, left-on=["context","point","file"], right-on=["context","point","file"]);
let prior_rows = select context, initial_scope, point, point as header_point, file from last_prior;
let prior_stages = extend(from=prior_rows, values={stage: 0});
let prior_contexts = select context, initial_scope, point, header_point, stage, file from prior_stages;
let name_expressions = select id, file from target_names;
let prior_lookups = lookup_symbol_events(ordered_contexts=prior_contexts, expressions=name_expressions);
let target_namespaces = select l.loop as loop, l.id as target, r.owner as scope, l.file as file from target_names as l join "defines" as r on l.id = r.id and l.file = r.file;
let if_nodes = select id, file from nodes where kind = "if";
let if_tests = select l.id as guard, r.child as test, l.file as file from if_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let test_inputs = select test as id, file from if_tests;
let test_symbols = modernization_symbols(expressions=test_inputs);
let recognized_false_guards = select l.guard as guard, l.test as test, l.file as file from if_tests as l join test_symbols as r on l.test = r.id and l.file = r.file where r.kind = "type-checking";
let attribute_nodes = select id, file from nodes where kind = "attribute";
let attribute_target_fields = select child, file from "semantic-child" where field = "target" or field = "targets";
let attribute_targets = select l.id as id, l.file as file from attribute_nodes as l join attribute_target_fields as r on l.id = r.child and l.file = r.file;
let assignment_symbols = modernization_symbols(expressions=attribute_targets);
let checking_attribute_writes = select l.id as id, l.file as file from attribute_targets as l join assignment_symbols as r on l.id = r.id and l.file = r.file where r.kind = "type-checking";
let write_locations = select l.id as id, r."end-byte" as end, l.file as file from checking_attribute_writes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let guard_locations = select l.guard as guard, l.file as file, r."start-byte" as start from recognized_false_guards as l join "source-location" as r on l.test = r.id and l.file = r.file;
let tainted_guards = select l.guard as guard, l.file as file from guard_locations as l join write_locations as r on l.file = r.file where r.end <= l.start;
let false_guards0 = select guard, file from recognized_false_guards;
let false_guards = antijoin(left=false_guards0, right=tainted_guards, left-on=["guard","file"], right-on=["guard","file"]);
let false_guard_bodies = select r.child as id, l.file as file from false_guards as l join "semantic-child" as r on l.guard = r.parent and l.file = r.file where r.field = "body";
let bind_nodes = select occurrence as id, file from "binding-event" where kind = "bind";
let body_ancestors = axis(from=bind_nodes, relation="semantic-child", direction=ancestor, domain=false_guard_bodies);
let type_only_binds = select id, file from body_ancestors;
let prior_same_namespace0 = select l.context as id, l.occurrence as binding, l.file as file from prior_lookups as l join target_namespaces as r on l.context = r.loop and l.expression = r.target and l.scope = r.scope and l.file = r.file where l.kind = "bind";
let prior_same_namespace1 = antijoin(left=prior_same_namespace0, right=type_only_binds, left-on=["binding","file"], right-on=["id","file"]);
let prior_same_namespace = select id, file from prior_same_namespace1;
let target_names_with_scope = select l.loop as loop, l.scope as scope, r.name as name, l.file as file from target_namespaces as l join "identifier" as r on l.target = r.id and l.file = r.file;
let target_history_points = select l.loop as loop, l.scope as scope, l.name as name, r.ordinal as loop_ordinal, r.phase as loop_phase, l.file as file from target_names_with_scope as l join loop_bindings as r on l.loop = r.loop and l.file = r.file;
let target_history_ranges = select l.loop as loop, l.scope as scope, l.name as name, l.loop_ordinal as loop_ordinal, l.loop_phase as loop_phase, r.start as loop_start, l.file as file from target_history_points as l join loop_ranges as r on l.loop = r.loop and l.file = r.file;
let prior_history0 = select l.loop as id, r.occurrence as binding, r.phase as phase, l.loop_phase as loop_phase, l.loop_start as loop_start, l.file as file from target_history_ranges as l join "binding-event" as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.kind = "bind" and r.ordinal < l.loop_ordinal;
let prior_history_locations = select l.id as id, l.binding as binding, l.phase as phase, l.loop_phase as loop_phase, l.loop_start as loop_start, r."end-byte" as binding_end, l.file as file from prior_history0 as l join "source-location" as r on l.binding = r.id and l.file = r.file;
let prior_history1 = select id, binding, file from prior_history_locations where phase != loop_phase or binding_end <= loop_start;
let prior_history2 = antijoin(left=prior_history1, right=type_only_binds, left-on=["binding","file"], right-on=["id","file"]);
let prior_history = select id, file from prior_history2;
let prior_directives = select l.context as id, l.file as file from prior_lookups as l join target_names as r on l.context = r.loop and l.expression = r.id and l.file = r.file where l.kind = "global" or l.kind = "nonlocal";
let prior_known_values = union(left=prior_same_namespace, right=prior_history);
let prior_bound = union(left=prior_known_values, right=prior_directives);
let inner_events = select l.loop as context, l.initial_scope as initial_scope, l.file as file, r.ordinal as point from scoped_loops as l join event_locations as r on l.file = r.file and l.phase = r.phase where r.ordinal >= l.ordinal and r.start >= l.start and r.end <= l.end;
let earlier_inner = select l.context as context, l.point as point, l.file as file from inner_events as l join inner_events as r on l.context = r.context and l.file = r.file where l.point < r.point;
let last_inner = antijoin(left=inner_events, right=earlier_inner, left-on=["context","point","file"], right-on=["context","point","file"]);
let post_rows = select context, initial_scope, point, point as header_point, file from last_inner;
let post_stages = extend(from=post_rows, values={stage: 0});
let post_contexts = select context, initial_scope, point, header_point, stage, file from post_stages;
let post_lookups = lookup_symbol_events(ordered_contexts=post_contexts, expressions=name_expressions);
let post_bindings = select l.context as loop, l.occurrence as binding, l.file as file from post_lookups as l join target_names as r on l.context = r.loop and l.expression = r.id and l.file = r.file where l.kind = "bind";
let associated_references = select l.loop as loop, r.reference as reference, l.file as file from post_bindings as l join "binding-use" as r on l.binding = r.binding and l.file = r.file;
let lexical_references = select l.loop as loop, r.occurrence as reference, l.file as file from target_names as l join "resolves" as r on l.id = r.definition and l.file = r.file;
let bound_references = union(left=associated_references, right=lexical_references);
let reference_locations = select l.loop as loop, l.file as file, r."start-byte" as start, r."end-byte" as end from bound_references as l join "source-location" as r on l.reference = r.id and l.file = r.file;
let outside_references = select l.loop as id, l.file as file from reference_locations as l join loop_ranges as r on l.loop = r.loop and l.file = r.file where l.start < r.start or l.end > r.end;
let known_rejected = union(left=prior_bound, right=outside_references);
let rejected = union(left=known_rejected, right=implicit_targets);
let matched = antijoin(left=shaped_loops, right=rejected, left-on=["id","file"], right-on=["id","file"]);
let unique_matches = group-count(from=matched, keys=["id","file"], count="count", distinct="id");
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from unique_matches as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])FURB122(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB122)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:FURB122)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:FURB122)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB122"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
