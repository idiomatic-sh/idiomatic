import suppress from "python/ruff/suppress";
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let comparator_fields = select parent, child from "semantic-child" where field = "comparators";
let comparator_counts = group-count(from=comparator_fields, keys=["parent"], count="count", distinct="child");
let one_comparators = select parent from comparator_counts where count = 1;
let comparator_rows = select l.parent as comparison, l.child as comparator, r.file as file from comparator_fields as l join comparisons as r on l.parent = r.id;
let single_comparators = select l.comparison as comparison, l.comparator as comparator, l.file as file from comparator_rows as l join one_comparators as r on l.comparison = r.parent;
let operator_fields = select parent, child from "semantic-child" where field = "ops";
let operator_counts = group-count(from=operator_fields, keys=["parent"], count="count", distinct="child");
let one_operators = select parent from operator_counts where count = 1;
let operator_rows = select l.parent as comparison, l.child as operator, r.file as file from operator_fields as l join comparisons as r on l.parent = r.id;
let single_operators = select l.comparison as comparison, l.operator as operator, l.file as file from operator_rows as l join one_operators as r on l.comparison = r.parent;
let comparison_shapes = select l.comparison as comparison, l.comparator as comparator, l.file as file, r.operator as operator from single_comparators as l join single_operators as r on l.comparison = r.comparison and l.file = r.file;
let left_fields = select parent, child from "semantic-child" where field = "left";
let left_rows = select l.parent as comparison, l.child as left, r.file as file from left_fields as l join comparisons as r on l.parent = r.id;
let sys_version = select id, file from "qualified-name" where path = "sys.version";
let sys_version_lefts = select l.comparison as comparison, l.left as left, l.file as file, r.comparator as comparator, r.operator as operator from left_rows as l join comparison_shapes as r on l.comparison = r.comparison and l.file = r.file;
let qualified_lefts = select l.comparison as comparison, l.left as left, l.file as file, l.comparator as comparator, l.operator as operator from sys_version_lefts as l join sys_version as r on l.left = r.id and l.file = r.file;
let relational_tokens = select id from "semantic-syntax" where text = "<" or text = "<=" or text = ">" or text = ">=";
let relational_comparisons = select l.comparison as comparison, l.left as left, l.comparator as comparator, l.file as file from qualified_lefts as l join relational_tokens as r on l.operator = r.id;
let short_strings = select occurrence as id, file from "string-literal" where matches(value, "(?s)^[\x00-\x7f]$");
let matches = select l.comparison as comparison, l.left as left, l.file as file from relational_comparisons as l join short_strings as r on l.comparator = r.id and l.file = r.file;
let reportable = select l.left as id, l.file as file, r.span as span from matches as l join "semantic-syntax" as r on l.left = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*YTT302(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:YTT302)(?:,|$)");
emit violations subject file key(id);
