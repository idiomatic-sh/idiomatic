import observation_matches from "python/ruff/suppress-matches";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from functions as l join calls as r on l.parent = r.id;
let logger_functions = select id, path from "qualified-name" where matches(path, "^logging\.(?:debug|info|warn|warning|error|critical|exception)$");
let log_functions = select q.id as id, q.path as path from "qualified-name" as q join "semantic-syntax" as s on q.id = s.id where q.path = "logging.log" and s.kind = "name";
let logger_targets = union(left=logger_functions, right=log_functions);
let logger_calls = select l.call as call, l.function as function from call_functions as l join logger_targets as r on l.function = r.id;
let arguments = select parent as call, child as wrapper from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.call as call, r.id as wrapper from arguments as l join argument_nodes as r on l.wrapper = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keywords = select l.call as call, r.child as keyword from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let actual_keywords = select l.call as call, l.keyword as keyword from call_keywords as l join keyword_nodes as r on l.keyword = r.id;
let argument_names = select parent as keyword, child as identifier from "semantic-child" where field = "arg";
let identifiers = select id, name from "identifier";
let keyword_name_edges = select l.keyword as keyword, r.name as name from argument_names as l join identifiers as r on l.identifier = r.id;
let exc_info_keywords = select keyword from keyword_name_edges where name = "exc_info";
let keyword_values = select parent as keyword, child as value from "semantic-child" where field = "value";
let exc_info_keyword_calls = select l.call as call, l.keyword as keyword from actual_keywords as l join exc_info_keywords as r on l.keyword = r.keyword;
let exc_info_values = select l.call as call, l.keyword as keyword, r.value as value from exc_info_keyword_calls as l join keyword_values as r on l.keyword = r.keyword;
let literals = select id, file, kind, zero, empty, boolean from "literal-properties";
let truthy_booleans = select id, file from literals where boolean = "true";
let truthy_ellipsis = select id, file from literals where kind = "ellipsis";
let nonzero_numbers = select id, file from literals where (kind = "integer" or kind = "float" or kind = "complex") and zero = "false";
let nonempty_strings = select id, file from literals where (kind = "string" or kind = "bytes") and empty = "false";
let truthy_scalar_a = union(left=truthy_booleans, right=truthy_ellipsis);
let truthy_scalar_b = union(left=nonzero_numbers, right=nonempty_strings);
let truthy_literals = union(left=truthy_scalar_a, right=truthy_scalar_b);
let true_exc_info = select l.call as call, l.keyword as keyword from exc_info_values as l join truthy_literals as r on l.value = r.id;
let valid_calls = select l.call as id, r.keyword as keyword from logger_calls as l join true_exc_info as r on l.call = r.call;
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let handler_ancestors = axis(from=valid_calls, relation="semantic-child", direction=ancestor, domain=handlers);
let calls_in_handlers = select l.id as id, l.keyword as keyword from valid_calls as l join handler_ancestors as r on l.id = r.id;
let outside_handler_calls = antijoin(left=valid_calls, right=calls_in_handlers, left-on=["id", "keyword"], right-on=["id", "keyword"]);
let selected_keyword_locations = select l.call as call, r.id as id, r.file as file, r.span as span from actual_keywords as l join "semantic-syntax" as r on l.keyword = r.id;
let exc_keyword_locations = select l.call as call, l.id as id, l.file as file, l.span as span from selected_keyword_locations as l join exc_info_keywords as r on l.id = r.keyword;
let reportable = select r.id as id, r.file as file, r.span as span from outside_handler_calls as l join exc_keyword_locations as r on l.id = r.call;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:LOG014)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "LOG014"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
