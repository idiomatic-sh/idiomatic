import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import dataclass_decorators from "python/ruff/dataclass-decorators";
import suppress from "python/ruff/suppress";

let decorators = dataclass_decorators();
let standard_decorators = select class, file from decorators where path = "dataclasses.dataclass";
let class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let standard_dataclasses = select l.class as class, l.file as file from standard_decorators as l join class_nodes as r on l.class = r.id and l.file = r.file;
let class_body = select l.class as class, r.child as method, l.file as file from standard_dataclasses as l join "semantic-child" as r on l.class = r.parent and l.file = r.file where r.field = "body";
let function_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let body_functions = select l.method as method, l.file as file from class_body as l join function_nodes as r on l.method = r.id and l.file = r.file;
let post_init_methods = select l.method as method, l.file as file from body_functions as l join "defines" as r on l.method = r.id and l.file = r.file where r.name = "__post_init__";

let argument_wrappers = select l.method as method, r.child as arguments, l.file as file from post_init_methods as l join "semantic-child" as r on l.method = r.parent and l.file = r.file where r.field = "args";
let parameter_fields = select l.method as method, r.child as wrapper, l.file as file from argument_wrappers as l join "semantic-child" as r on l.arguments = r.parent and l.file = r.file where r.field = "posonlyargs" or r.field = "args" or r.field = "kwonlyargs";
let default_wrapper_nodes = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let default_wrappers = select l.method as method, l.wrapper as wrapper, l.file as file from parameter_fields as l join default_wrapper_nodes as r on l.wrapper = r.id and l.file = r.file;
let defaults = select r.child as id, l.file as file from default_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "defaults" or r.field = "kw-defaults";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from defaults as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*RUF033(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF033)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF033)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF033)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF033"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
