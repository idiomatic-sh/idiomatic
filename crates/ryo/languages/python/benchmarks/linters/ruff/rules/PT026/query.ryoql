import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let decorators = select id, file, span from "syntax-tree" where kind = "decorator";
let decorator_locations = select l.id as decorator, l.file as file, r."start-byte" as begin, r."end-byte" as finish from decorators as l join "source-location" as r on l.id = r.id and l.file = r.file;
let at_tokens = select id, file from "syntax-tree" where text = "@";
let at_locations = select l.id as token, l.file as file, r."start-byte" as begin, r."end-byte" as finish from at_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let at_in_decorators = select l.decorator as decorator, l.file as file, l.begin as begin, l.finish as decorator_finish, r.finish as after_at from decorator_locations as l join at_locations as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let source_tokens = select id, file, kind, text from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let token_locations = select l.id as token, l.file as file, l.kind as kind, l.text as text, r."start-byte" as begin, r."end-byte" as finish from source_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let expression_tokens = select l.decorator as decorator, l.file as file, r.token as token, r.begin as begin from at_in_decorators as l join token_locations as r on l.file = r.file where r.begin >= l.after_at and r.begin < l.decorator_finish and r.text != "(";
let later_expression_tokens = select l.decorator as decorator, l.token as token from expression_tokens as l join expression_tokens as r on l.decorator = r.decorator where l.begin > r.begin;
let first_expression_tokens = antijoin(left=expression_tokens, right=later_expression_tokens, left-on=["decorator", "token"], right-on=["decorator", "token"]);
let names = select id, file from "qualified-name" where path = "pytest.mark.usefixtures";
let name_locations = select l.id as qname, l.file as file, r."start-byte" as begin from names as l join "source-location" as r on l.id = r.id and l.file = r.file;
let root_names = select l.qname as qname, r.decorator as decorator from name_locations as l join first_expression_tokens as r on l.begin = r.begin and l.file = r.file;
let name_ancestors = axis(from=names, relation="syntax-child", direction=nearest-ancestor, domain=decorators);
let matching_name_decorators = select l.qname as qname, l.decorator as decorator from root_names as l join name_ancestors as r on l.qname = r.id and l.decorator = r.related;
let pytest_mark_usefixtures = select occurrence as decorator from "decorates" where matches(target, "mark.usefixtures$");
let matching_decorators = select l.qname as qname, l.decorator as decorator from matching_name_decorators as l join pytest_mark_usefixtures as r on l.decorator = r.decorator;
let call_nodes = select id from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let qname_calls = select l.child as qname, r.id as call from function_fields as l join call_nodes as r on l.parent = r.id;
let call_arguments_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_argument_owners = select l.parent as call, r.id as arguments from "semantic-child" as l join call_arguments_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let positional_calls = select l.call as call from call_argument_owners as l join positional_fields as r on l.arguments = r.parent;
let keyword_calls = select l.call as call from call_argument_owners as l join keyword_fields as r on l.arguments = r.parent;
let nonempty_calls = union(left=positional_calls, right=keyword_calls);
let nonempty_qnames = select l.qname as qname from qname_calls as l join nonempty_calls as r on l.call = r.call;
let nonempty_matches = select l.qname as qname, l.decorator as decorator from matching_decorators as l join nonempty_qnames as r on l.qname = r.qname;
let eligible_decorators = antijoin(left=matching_decorators, right=nonempty_matches, left-on=["qname", "decorator"], right-on=["qname", "decorator"]);
let matching_decorator_ids = select decorator as id from eligible_decorators;
let matching_decorator_rows = select l.id as id, r.file as file, r.span as span from matching_decorator_ids as l join decorators as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from matching_decorator_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PT026(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PT026)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PT026(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PT026)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PT026"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
