import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let classes = select id, file from nodes where kind = "class-def";
let nulls = select id, file from "literal-properties" where kind = "null";
let returns = select id, file from nodes where kind = "return";
let return_values = select l.id as id, r.child as value, l.file as file from returns as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let null_returns = select l.id as id, l.file as file from return_values as l join nulls as r on l.value = r.id and l.file = r.file;
let function_bodies = select l.id as parent, r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let class_bodies = select l.id as parent, r.child as id, l.file as file from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let def_bodies = union(left=function_bodies, right=class_bodies);
let body_statements = select id, file from def_bodies;
let null_direct = select l.id as id, r.parent as function, l.file as file from null_returns as l join function_bodies as r on l.id = r.id and l.file = r.file;
let null_nested = antijoin(left=null_returns, right=body_statements, left-on=["id", "file"], right-on=["id", "file"]);
let null_up = axis(from=null_nested, relation="semantic-child", direction=nearest-ancestor, domain=body_statements);
let null_lifted = select l.id as id, r.parent as function, l.file as file from null_up as l join function_bodies as r on l.related = r.id and l.file = r.file;
let null_owned = union(left=null_direct, right=null_lifted);
let candidates0 = select function as id, file from null_owned;
let candidate_bodies = select l.id as function, r.child as child, l.file as file from candidates0 as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=candidate_bodies, keys=["function", "file"], count="count", distinct="child");
let single_statement_functions = select function, file from body_counts where count = 1;
let single_return_functions = select l.function as function, l.file as file from candidate_bodies as l join returns as r on l.child = r.id and l.file = r.file;
let trivial_functions = select l.function as function, l.file as file from single_return_functions as l join single_statement_functions as r on l.function = r.function and l.file = r.file;
let nontrivial_functions = antijoin(left=candidates0, right=trivial_functions, left-on=["id", "file"], right-on=["function", "file"]);
let candidate_members = axis(from=nontrivial_functions, relation="semantic-child", direction=descendant, domain=nodes);
let member_returns = select l.id as function, l.related as id, l.file as file from candidate_members as l join return_values as r on l.related = r.id and l.file = r.file;
let member_yields = select l.id as function, l.related as id, l.file as file from candidate_members as l join nodes as r on l.related = r.id and l.file = r.file where r.kind = "yield" or r.kind = "yield-from";
let owned_returns_direct = select l.function as function, l.id as id, l.file as file from member_returns as l join function_bodies as r on l.id = r.id and l.function = r.parent and l.file = r.file;
let nested_returns = antijoin(left=member_returns, right=body_statements, left-on=["id", "file"], right-on=["id", "file"]);
let nested_returns_up = axis(from=nested_returns, relation="semantic-child", direction=nearest-ancestor, domain=body_statements);
let owned_returns_lifted = select l.function as function, l.id as id, l.file as file from nested_returns_up as l join def_bodies as r on l.related = r.id and l.function = r.parent and l.file = r.file;
let owned_returns = union(left=owned_returns_direct, right=owned_returns_lifted);
let owned_values = select l.function as function, l.id as id, r.value as value, l.file as file from owned_returns as l join return_values as r on l.id = r.id and l.file = r.file;
let nonnull_owned = antijoin(left=owned_values, right=nulls, left-on=["value", "file"], right-on=["id", "file"]);
let yields_up = axis(from=member_yields, relation="semantic-child", direction=nearest-ancestor, domain=body_statements);
let owned_yields0 = select l.function as function, l.id as id, l.file as file from yields_up as l join def_bodies as r on l.related = r.id and l.function = r.parent and l.file = r.file;
let def_nodes = union(left=functions, right=classes);
let def_children = select l.id as parent, r.child as id, r.field as field, l.file as file from def_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let walked_def_children = select parent, id, file from def_children where field = "decorator-list" or field = "body";
let walked_function_children = select l.parent as parent, l.id as id, l.file as file from def_children as l join functions as r on l.parent = r.id and l.file = r.file where l.field = "returns" or l.field = "args";
let walked_children0 = union(left=walked_def_children, right=walked_function_children);
let walked_children = select id, file from walked_children0;
let child_domain = select id, file from def_children;
let yield_def_child = axis(from=owned_yields0, relation="semantic-child", direction=nearest-ancestor, domain=child_domain);
let reference_skips_unwalked_fields = antijoin(left=yield_def_child, right=walked_children, left-on=["related", "file"], right-on=["id", "file"]);
let embedded_roots = select root as id, file from "embedded-expression";
let yield_embedded = axis(from=owned_yields0, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let generator_functions0 = antijoin(left=owned_yields0, right=reference_skips_unwalked_fields, left-on=["function", "id", "file"], right-on=["function", "id", "file"]);
let generator_functions = antijoin(left=generator_functions0, right=yield_embedded, left-on=["function", "id", "file"], right-on=["function", "id", "file"]);
let nongenerator_functions = antijoin(left=nontrivial_functions, right=generator_functions, left-on=["id", "file"], right-on=["function", "file"]);
let none_only_functions = antijoin(left=nongenerator_functions, right=nonnull_owned, left-on=["id", "file"], right-on=["function", "file"]);
let annotations = select l.id as function, r.child as annotation, l.file as file from none_only_functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let nonnull_annotations = antijoin(left=annotations, right=nulls, left-on=["annotation", "file"], right-on=["id", "file"]);
let annotated_functions = antijoin(left=none_only_functions, right=nonnull_annotations, left-on=["id", "file"], right-on=["function", "file"]);
let decorators = select l.id as function, r.occurrence as decorator, l.file as file from annotated_functions as l join "decorates" as r on l.id = r.declaration and l.file = r.file;
let decorator_expressions = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_origins = select l.function as function, r.path as path, l.file as file from decorator_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let called_expressions = select l.function as function, r.child as expression, l.file as file from decorator_expressions as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "func";
let called_origins = select l.function as function, r.path as path, l.file as file from called_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=called_origins);
let properties = select function, file from origins where path in ["builtins.property", "enum.property", "functools.cached_property", "abc.abstractproperty", "types.DynamicClassAttribute"];
let checked_functions = antijoin(left=annotated_functions, right=properties, left-on=["id", "file"], right-on=["function", "file"]);
let reportable = select l.id as id, l.file as file from null_owned as l join checked_functions as r on l.function = r.id and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:R501|RET501)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "RET501"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
