import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let strings = select id, file, span from "syntax-tree" where kind = "string" or kind = "fstring-middle" or kind = "tstring-middle";
let token_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as base_line from strings as l join "source-location" as r on l.id = r.id and l.file = r.file;
let occurrences = source-matches(from=token_locations, span="span", base-line="base_line", pattern="\x08", output="occurrence", line-output="line");
let candidates = select id, file, occurrence as span, line from occurrences;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE2510(?:$|[^A-Z0-9])", range-pattern="(?:^|,)PLE2510(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE2510(?:$|[^A-Z0-9])", range-pattern="(?:^|,)PLE2510(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE2510"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id, span);
