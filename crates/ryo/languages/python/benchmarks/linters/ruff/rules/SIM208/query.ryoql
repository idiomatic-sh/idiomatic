import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let unary = select id, file, span from "semantic-syntax" where kind = "unary-op";
let operators = select parent, child from "semantic-child" where field = "op";
let signs = select id, text from "semantic-syntax" where text = "not";
let signed = select l.parent as id, r.text as sign from operators as l join signs as r on l.child = r.id;
let operands = select parent, child from "semantic-child" where field = "operand";
let inner_signs = select l.parent as id, r.sign as sign from operands as l join signed as r on l.child = r.id;
let doubled = select l.id as id from signed as l join inner_signs as r on l.id = r.id and l.sign = r.sign;
let reportable = select l.id as id, l.file as file, l.span as span from unary as l join doubled as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*SIM208(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM208)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM208)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM208)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM208"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
