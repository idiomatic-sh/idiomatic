import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let assertions = select id from "semantic-syntax" where kind = "assert";
let tests = select parent, child from "semantic-child" where field = "test";
let parts = select id from "semantic-syntax" where kind = "string-part" or kind = "bytes-part";
let literal_parents = select l.parent as id from "semantic-child" as l join parts as r on l.child = r.id;
let literals = select r.id as id, r.file as file, r.span as span from literal_parents as l join "semantic-syntax" as r on l.id = r.id;
let fstrings = select id, file, span from "semantic-syntax" where kind = "joined-str";
let strings = union(left=literals, right=fstrings);
let asserted = select r.child as child from assertions as l join tests as r on l.id = r.parent;
let reportable = select r.id as id, r.file as file, r.span as span from asserted as l join strings as r on l.child = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLW0129)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0129"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
