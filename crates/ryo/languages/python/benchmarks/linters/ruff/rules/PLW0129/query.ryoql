import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let assertions = select id from "semantic-syntax" where kind = "assert";
let tests = select parent, child from "semantic-child" where field = "test";
let parts = select id from "semantic-syntax" where kind = "string-part" or kind = "bytes-part";
let literal_parents = select l.parent as id from "semantic-child" as l join parts as r on l.child = r.id;
let literals = select r.id as id, r.file as file, r.span as span from literal_parents as l join "semantic-syntax" as r on l.id = r.id;
let fstrings = select id, file, span from "semantic-syntax" where kind = "joined-str";
let strings = union(left=literals, right=fstrings);
let asserted = select r.child as child from assertions as l join tests as r on l.id = r.parent;
let reportable = select r.id as id, r.file as file, r.span as span from asserted as l join strings as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0129(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0129)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLW0129)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0129)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0129"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
