import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let factory_calls = select call, file from qualified_calls where path = "builtins.list" or path = "builtins.tuple";
let single_factory_calls = select l.call as id, l.file as file from factory_calls as l join single_arguments as r on l.call = r.call and l.file = r.file;
let comprehensions = select id, file from nodes where kind = "list-comp";
let lists = select id, file from nodes where kind = "list";
let list_elements = select l.id as list, l.file as file, r.child as id from lists as l join element_edges as r on l.id = r.parent and l.file = r.file;
let list_counts = group-count(from=list_elements, keys=["list","file"], count="count", distinct="id");
let single_list_elements = select l.list as list, l.id as id, l.file as file from list_elements as l join list_counts as r on l.list = r.list and l.file = r.file where r.count = 1;
let starred_lists = select l.list as id, l.file as file from single_list_elements as l join starred_nodes as r on l.id = r.id and l.file = r.file;
let allocation_calls_and_comps = union(left=single_factory_calls, right=comprehensions);
let allocations = union(left=allocation_calls_and_comps, right=starred_lists);
let subscripts = select id, file, span from nodes where kind = "subscript";
let slice_edges = select parent, child, file from "semantic-child" where field = "slice";
let indexed_values = select l.id as id, l.file as file, l.span as span, r.child as index from subscripts as l join slice_edges as r on l.id = r.parent and l.file = r.file;
let zero_indices = select l.id as id, l.file as file, l.span as span from indexed_values as l join plain_zero as r on l.index = r.id and l.file = r.file;
let indexed_allocations = select l.id as id, l.file as file, l.span as span, r.child as allocation from zero_indices as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_calls = select related as call, file from keyword_owners;
let no_keyword_pop_arguments = antijoin(left=single_arguments, right=keyword_calls, left-on=["call","file"], right-on=["call","file"]);
let zero_pop_arguments = select l.call as call, l.file as file from no_keyword_pop_arguments as l join plain_zero as r on l.value = r.id and l.file = r.file;
let pop_callees = select l.call as call, l.file as file, r.callee as callee from zero_pop_arguments as l join callee_nodes as r on l.call = r.call and l.file = r.file;
let attribute_nodes = select id, file from nodes where kind = "attribute";
let pop_attributes = select l.call as call, l.file as file, l.callee as callee from pop_callees as l join attribute_nodes as r on l.callee = r.id and l.file = r.file;
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_ids = select l.call as call, l.callee as callee, l.file as file, r.child as identifier from pop_attributes as l join attr_edges as r on l.callee = r.parent and l.file = r.file;
let pop_names = select l.call as call, l.callee as callee, l.file as file from attr_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file where r.name = "pop";
let pop_allocations = select l.call as id, l.file as file, r.child as allocation from pop_names as l join value_edges as r on l.callee = r.parent and l.file = r.file;
let located_pops = select l.id as id, l.file as file, r.span as span, l.allocation as allocation from pop_allocations as l join calls as r on l.id = r.id and l.file = r.file;
let outer_expressions = union(left=indexed_allocations, right=located_pops);
let candidates = select l.id as id, l.file as file, l.span as span from outer_expressions as l join allocations as r on l.allocation = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF015(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF015)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF015(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF015)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF015"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
