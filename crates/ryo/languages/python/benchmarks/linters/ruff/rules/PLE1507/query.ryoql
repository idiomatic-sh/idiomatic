import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let getenv_functions = select id, file from "qualified-name" where path = "os.getenv";
let getenv_calls = select l.call as call, l.file as file from call_functions as l join getenv_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, r.ordinal as ordinal, l.file as file from wrappers as l join positional_fields as r on l.wrapper = r.parent;
let earlier_positional_pairs = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from positional_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let first_positional = antijoin(left=positional_arguments,right=earlier_positional_pairs,left-on=["call","value","ordinal","file"],right-on=["call","value","ordinal","file"]);
let after_first_pairs = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from first_positional as l join positional_arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let later_after_first = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from after_first_pairs as l join after_first_pairs as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let second_positional = antijoin(left=after_first_pairs,right=later_after_first,left-on=["call","value","ordinal","file"],right-on=["call","value","ordinal","file"]);
let positional_defaults = select call, value, file from first_positional;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let arg_edges = select l.parent as keyword, r.child as identifier from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifier_edges = select l.child as id, r.name as name from "semantic-child" as l join "identifier" as r on l.parent = r.id;
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name from arg_edges as l join identifiers as r on l.identifier = r.id;
let default_keywords = select keyword from keyword_names where name = "key";
let default_keyword_edges = select l.call as call, l.keyword as keyword, l.file as file from keywords as l join default_keywords as r on l.keyword = r.keyword;
let value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_defaults = select l.call as call, r.child as value, l.file as file from default_keyword_edges as l join value_fields as r on l.keyword = r.parent;
let all_defaults = union(left=positional_defaults,right=keyword_defaults);
let primitive_invalid_defaults = select l.call as call, l.value as id, l.file as file, r.span as span from all_defaults as l join "literal-properties" as r on l.value = r.id and l.file = r.file where r.kind != "string";
let known_container_nodes = select id, file, span from "semantic-syntax" where kind = "list" or kind = "tuple" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "dict-comp" or kind = "set-comp" or kind = "generator-exp";
let container_invalid_defaults = select l.call as call, l.value as id, l.file as file, r.span as span from all_defaults as l join known_container_nodes as r on l.value = r.id and l.file = r.file;
let invalid_default_ids = union(left=primitive_invalid_defaults,right=container_invalid_defaults);
let candidates = select l.id as id, l.file as file, l.span as span from invalid_default_ids as l join getenv_calls as r on l.call = r.call and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1507(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1507)(?:,|$)");
emit violations subject file key(id);
