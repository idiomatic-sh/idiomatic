import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let expressions = select id, file, span from "semantic-syntax" where kind = "if-exp";
let body_fields = select parent, child from "semantic-child" where field = "body";
let else_fields = select parent, child from "semantic-child" where field = "orelse";
let body_tokens = select id from "semantic-syntax" where kind = "name-token" and text = "False";
let else_tokens = select id from "semantic-syntax" where kind = "name-token" and text = "True";
let body_literals = select l.parent as id from "semantic-child" as l join body_tokens as r on l.child = r.id;
let else_literals = select l.parent as id from "semantic-child" as l join else_tokens as r on l.child = r.id;
let matching_body = select l.parent as id from body_fields as l join body_literals as r on l.child = r.id;
let matching_else = select l.parent as id from else_fields as l join else_literals as r on l.child = r.id;
let matching = select l.id as id from matching_body as l join matching_else as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from expressions as l join matching as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*SIM211(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM211)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM211)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM211)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM211"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
