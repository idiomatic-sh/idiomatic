import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let class_definitions = select id, owner, name, file from "defines" where kind = "class";
let attributes = select id, file from nodes where kind = "attribute";
let name_nodes = select id, file from nodes where kind = "name";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let decorators = select occurrence as decorator, declaration as declaration, file, span from "decorates";
let decorator_roots = select l.decorator as decorator, l.declaration as declaration, l.file as file, l.span as span, r.child as expression from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_decorator_origins = select l.decorator as decorator, l.declaration as declaration, l.file as file, l.span as span, r.path as path from decorator_roots as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let callable_edges = select parent, child, file from "semantic-child" where field = "func";
let decorator_callables = select l.decorator as decorator, l.declaration as declaration, l.file as file, l.span as span, r.child as callable from decorator_roots as l join callable_edges as r on l.expression = r.parent and l.file = r.file;
let called_decorator_origins = select l.decorator as decorator, l.declaration as declaration, l.file as file, l.span as span, r.path as path from decorator_callables as l join "qualified-name" as r on l.callable = r.id and l.file = r.file;
let decorator_origins = union(left=direct_decorator_origins, right=called_decorator_origins);
let recognized_decorators = select * from decorator_origins where path = "dataclasses.dataclass" or path = "attr.define" or path = "attr.frozen" or path = "attr.mutable" or path = "attrs.define" or path = "attrs.frozen" or path = "attrs.mutable" or path = "attr.s" or path = "attr.attributes" or path = "attr.attrs";
let ordered_decorators = select l.decorator as decorator, l.declaration as declaration, l.file as file, l.span as span, l.path as path, r."start-byte" as begin from recognized_decorators as l join "source-location" as r on l.decorator = r.id and l.file = r.file;
let later_decorators = select l.decorator as decorator, l.file as file from ordered_decorators as l join ordered_decorators as r on l.declaration = r.declaration and l.file = r.file where l.begin > r.begin;
let first_recognized_decorators = antijoin(left=ordered_decorators, right=later_decorators, left-on=["decorator","file"], right-on=["decorator","file"]);
let dataclass_decorators = select decorator, declaration, file, span from first_recognized_decorators where path = "dataclasses.dataclass";
let context_rows = select declaration as context, declaration as class, file from dataclass_decorators;
let contexts = project(from=context_rows,columns=["context","class","file"]);
let attribute_name_ids = select l.id as id, l.file as file, r.child as identifier from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let attribute_names = select l.id as id, l.file as file, r.name as name from attribute_name_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let scope_nodes_for_events = select child as id, file from "scope";
let redirect_events = select occurrence as id, name, ordinal, kind, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_owners = axis(from=redirect_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let redirect_namespaces = select id as occurrence, name, ordinal, kind, file, related as scope from redirect_owners;
let all_raw_namespace_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let scope_body_roots = select l.id as scope, l.file as file, r.child as id from scope_nodes_for_events as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let type_function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_header_children = select l.id as owner, l.file as file, r.child as id from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.owner as owner, l.file as file from class_header_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_annotation_roots = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_type_owners = axis(from=parameter_annotation_roots,relation="semantic-child",direction=nearest-ancestor,domain=type_function_nodes);
let parameter_type_roots = select id, related as owner, file from parameter_type_owners;
let return_type_roots = select r.child as id, l.id as owner, l.file as file from type_function_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_type_roots = union(left=parameter_type_roots,right=return_type_roots);
let type_scope_roots = union(left=class_type_roots,right=function_type_roots);
let body_evaluation_roots = select id, scope as owner, file from scope_body_roots;
let evaluation_roots = union(left=body_evaluation_roots,right=type_scope_roots);
let nearest_evaluations = axis(from=all_raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=evaluation_roots);
let type_namespace_events = select l.id as id, l.name as name, r.owner as owner, l.ordinal as ordinal, l.file as file from nearest_evaluations as l join type_scope_roots as r on l.related = r.id and l.file = r.file;
let raw_namespace_events = antijoin(left=all_raw_namespace_events,right=type_namespace_events,left-on=["id","file"],right-on=["id","file"]);
let lexical_event_owners = axis(from=raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let event_body_ancestors = axis(from=raw_namespace_events,relation="semantic-child",direction=ancestor,domain=scope_body_roots);
let ancestor_body_owners = select l.id as id, l.file as file, r.scope as scope from event_body_ancestors as l join scope_body_roots as r on l.related = r.id and l.file = r.file;
let self_body_owners = select l.id as id, l.file as file, r.scope as scope from raw_namespace_events as l join scope_body_roots as r on l.id = r.id and l.file = r.file;
let event_body_owners = union(left=ancestor_body_owners,right=self_body_owners);
let lexical_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from lexical_event_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let named_expressions = select id, file from nodes where kind = "named-expr";
let walrus_targets = select r.child as id, l.file as file from named_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let walrus_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from raw_namespace_events as l join walrus_targets as r on l.id = r.id and l.file = r.file;
let non_comprehension_scopes = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let walrus_lexical_owners = axis(from=walrus_events,relation="semantic-child",direction=nearest-ancestor,domain=non_comprehension_scopes);
let walrus_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from walrus_lexical_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let owned_namespace_events = union(left=lexical_body_events,right=walrus_body_events);
let redirected_namespace_events = select l.id as occurrence, l.name as name, l.related as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from owned_namespace_events as l join redirect_namespaces as r on l.related = r.scope and l.name = r.name and l.file = r.file;
let normal_namespace_rows = antijoin(left=raw_namespace_events,right=redirected_namespace_events,left-on=["id","file"],right-on=["occurrence","file"]);
let normal_namespace_events = select id as occurrence, name, scope, ordinal, kind, file from normal_namespace_rows;
let corrected_namespace_events = union(left=normal_namespace_events,right=redirected_namespace_events);
let namespace_events = union(left=corrected_namespace_events,right=redirect_namespaces);
let member_events = select l.occurrence as id, l.scope as owner, l.name as name, l.ordinal as ordinal, l.file as file from namespace_events as l join classes as r on l.scope = r.id and l.file = r.file;
let shadowed_members = select l.id as id, l.ordinal as ordinal, l.file as file from member_events as l join member_events as r on l.owner = r.owner and l.name = r.name and l.file = r.file where l.ordinal < r.ordinal;
let last_members = antijoin(left=member_events,right=shadowed_members,left-on=["id","ordinal","file"],right-on=["id","ordinal","file"]);
let member_classes = select l.id as id, l.owner as owner, l.name as name, l.file as file from last_members as l join classes as r on l.id = r.id and l.file = r.file;
let namespace_edges = select owner as origin, id as destination from member_classes;
let class_self_edges = select id as origin, id as destination from classes;
let class_edges = union(left=namespace_edges, right=class_self_edges);
let class_paths = closure(edges=class_edges, source="origin", destination="destination");
let class_intervals = select l.origin as root, r.destination as end, l.destination as middle from class_paths as l join class_paths as r on l.destination = r.origin;
let class_depths = group-count(from=class_intervals, keys=["root","end"], count="depth", distinct="middle");
let named_or_attributed = union(left=name_nodes, right=attributes);
let attribute_value_edges = select r.child as origin, l.id as destination, l.file as file from attributes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let contiguous_attribute_edges = select l.origin as origin, l.destination as destination from attribute_value_edges as l join named_or_attributed as r on l.origin = r.id and l.file = r.file;
let expression_self_edges = select id as origin, id as destination from named_or_attributed;
let expression_edges = union(left=contiguous_attribute_edges, right=expression_self_edges);
let expression_paths = closure(edges=expression_edges, source="origin", destination="destination");
let expression_intervals = select l.origin as root, r.destination as end, l.destination as middle from expression_paths as l join expression_paths as r on l.destination = r.origin;
let expression_depths = group-count(from=expression_intervals, keys=["root","end"], count="depth", distinct="middle");
let bases = select declaration as class, occurrence as expression, file from "inherits";
let subscript_nodes = select id, file from nodes where kind = "subscript";
let subscript_bases = select l.class as class, l.file as file, l.expression as expression from bases as l join subscript_nodes as r on l.expression = r.id and l.file = r.file;
let ordinary_bases = antijoin(left=bases, right=subscript_nodes, left-on=["expression","file"], right-on=["id","file"]);
let unwrapped_bases = select l.class as class, l.file as file, r.child as expression from subscript_bases as l join value_edges as r on l.expression = r.parent and l.file = r.file;
let mapped_bases = union(left=ordinary_bases, right=unwrapped_bases);
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges,source="origin",destination="destination",keys=["file"]);
let context_initial_scopes = select l.context as context, l.class as class, l.file as file, r.parent as initial_scope from contexts as l join "scope" as r on l.context = r.child and l.file = r.file;
let bind_events = select occurrence, scope, ordinal, file from "binding-event" where kind = "bind";
let ordered_contexts = select l.context as context, l.class as class, l.file as file, l.initial_scope as initial_scope, r.ordinal as point from context_initial_scopes as l join bind_events as r on l.context = r.occurrence and l.file = r.file;
let outer_lookup_scopes = select l.context as context, l.initial_scope as initial_scope, l.point as point, l.file as file, r.destination as lookup_scope from ordered_contexts as l join scope_paths as r on l.initial_scope = r.origin and l.file = r.file;
let ancestor_class_scopes = select l.context as context, l.lookup_scope as lookup_scope, l.file as file from outer_lookup_scopes as l join classes as r on l.lookup_scope = r.id and l.file = r.file where l.lookup_scope != l.initial_scope;
let visible_outer_scopes = antijoin(left=outer_lookup_scopes,right=ancestor_class_scopes,left-on=["context","lookup_scope","file"],right-on=["context","lookup_scope","file"]);
let self_lookup_scopes = select context, initial_scope, point, file, initial_scope as lookup_scope from ordered_contexts;
let lookup_scopes = union(left=visible_outer_scopes,right=self_lookup_scopes);
let base_root_paths = select r.origin as expression, l.file as file from mapped_bases as l join expression_paths as r on l.expression = r.destination;
let base_name_roots = select l.expression as expression, l.file as file from base_root_paths as l join name_nodes as r on l.expression = r.id and l.file = r.file;
let root_names = select l.expression as expression, l.file as file, r.name as name from base_name_roots as l join "identifier" as r on l.expression = r.id and l.file = r.file;
let context_names = select l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from lookup_scopes as l join root_names as r on l.file = r.file;
let scope_nodes = select child as id, file from "scope";
let all_preceding_bindings = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.occurrence as definition, r.ordinal as ordinal, r.kind as kind from context_names as l join namespace_events as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let cleanup_events = select occurrence, name, scope, ordinal, file from namespace_events where kind = "cleanup";
let handler_binds = select occurrence, name, scope, ordinal, file from namespace_events where kind = "bind";
let handler_intervals = select l.occurrence as handler, l.name as name, l.scope as scope, l.file as file, l.ordinal as finish, r.ordinal as begin from cleanup_events as l join handler_binds as r on l.occurrence = r.occurrence and l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let restorable_handlers = select l.handler as handler, l.name as name, l.scope as scope, l.file as file, l.begin as begin, l.finish as finish from handler_intervals as l join namespace_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.begin;
let finished_context_handlers = select l.context as context, l.file as file, r.name as name, r.scope as scope, r.begin as begin, r.finish as finish from ordered_contexts as l join restorable_handlers as r on l.file = r.file where r.finish <= l.point;
let restored_handler_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.ordinal as ordinal, l.file as file from all_preceding_bindings as l join finished_context_handlers as r on l.context = r.context and l.file = r.file and l.lookup_scope = r.scope and l.name = r.name where l.ordinal >= r.begin and l.ordinal <= r.finish;
let preceding_bindings = antijoin(left=all_preceding_bindings,right=restored_handler_bindings,left-on=["context","expression","definition","ordinal","file"],right-on=["context","expression","definition","ordinal","file"]);
let older_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from preceding_bindings as l join preceding_bindings as r on l.context = r.context and l.expression = r.expression and l.lookup_scope = r.lookup_scope and l.file = r.file where l.ordinal < r.ordinal;
let last_bindings = antijoin(left=preceding_bindings,right=older_bindings,left-on=["context","expression","definition","file"],right-on=["context","expression","definition","file"]);
let competing_scopes = select l.context as context, l.expression as expression, l.definition as definition, l.lookup_scope as farther, r.lookup_scope as closer, l.file as file from last_bindings as l join last_bindings as r on l.context = r.context and l.expression = r.expression and l.file = r.file where l.lookup_scope != r.lookup_scope;
let farther_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from competing_scopes as l join scope_paths as r on l.closer = r.origin and l.farther = r.destination and l.file = r.file;
let nearest_bindings = antijoin(left=last_bindings,right=farther_bindings,left-on=["context","expression","definition","file"],right-on=["context","expression","definition","file"]);
let raw_name_class_resolutions = select l.context as context, l.expression as expression, l.definition as class, l.lookup_scope as lookup_scope, l.file as file from nearest_bindings as l join classes as r on l.definition = r.id and l.file = r.file where l.kind = "bind";
let type_lookup_scopes = union(left=outer_lookup_scopes,right=self_lookup_scopes);
let type_context_names = select l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from type_lookup_scopes as l join root_names as r on l.file = r.file;
let active_type_barriers = select l.context as context, l.expression as expression, l.lookup_scope as owner, l.file as file from type_context_names as l join type_namespace_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let candidate_type_barriers = select l.context as context, l.expression as expression, l.class as class, l.lookup_scope as lookup_scope, l.file as file, r.owner as owner from raw_name_class_resolutions as l join active_type_barriers as r on l.context = r.context and l.expression = r.expression and l.file = r.file where l.lookup_scope != r.owner;
let type_shadowed_classes = select l.context as context, l.expression as expression, l.class as class, l.file as file from candidate_type_barriers as l join scope_paths as r on l.owner = r.origin and l.lookup_scope = r.destination and l.file = r.file;
let visible_name_class_resolutions = antijoin(left=raw_name_class_resolutions,right=type_shadowed_classes,left-on=["context","expression","class","file"],right-on=["context","expression","class","file"]);
let name_class_resolutions = select context, expression, class, file from visible_name_class_resolutions;
let rooted_expression_paths = select l.context as context, r.root as root, r.end as expression, r.depth as depth, l.class as root_class, l.file as file from name_class_resolutions as l join expression_depths as r on l.expression = r.root;
let candidate_class_paths = select l.context as context, l.root as root, l.expression as expression, l.depth as depth, l.root_class as root_class, l.file as file, r.end as class from rooted_expression_paths as l join class_depths as r on l.root_class = r.root and l.depth = r.depth;
let candidate_attributes = select l.context as context, l.root as root, l.expression as expression, l.root_class as root_class, l.class as class, l.file as file from candidate_class_paths as l join attributes as r on l.expression = r.id and l.file = r.file;
let expression_steps = select l.root as root, l.end as expression, l.middle as step, r.name as name, r.file as file from expression_intervals as l join attribute_names as r on l.middle = r.id;
let expression_step_depths = select l.root as root, l.expression as expression, l.step as step, l.name as name, l.file as file, r.depth as depth from expression_steps as l join expression_depths as r on l.root = r.root and l.step = r.end;
let class_steps = select l.root as root_class, l.end as class, l.middle as step, r.name as name, r.file as file from class_intervals as l join class_definitions as r on l.middle = r.id;
let class_step_depths = select l.root_class as root_class, l.class as class, l.step as step, l.name as name, l.file as file, r.depth as depth from class_steps as l join class_depths as r on l.root_class = r.root and l.step = r.end;
let candidate_expression_steps = select l.context as context, l.expression as expression, l.root_class as root_class, l.class as class, l.file as file, r.step as step, r.name as name, r.depth as depth from candidate_attributes as l join expression_step_depths as r on l.root = r.root and l.expression = r.expression and l.file = r.file;
let matched_steps = select l.context as context, l.expression as expression, l.class as class, l.file as file, l.step as step from candidate_expression_steps as l join class_step_depths as r on l.root_class = r.root_class and l.class = r.class and l.file = r.file and l.depth = r.depth and l.name = r.name;
let required_step_counts = group-count(from=candidate_expression_steps, keys=["context","expression","class","file"], count="count", distinct="step");
let matched_step_counts = group-count(from=matched_steps, keys=["context","expression","class","file"], count="count", distinct="step");
let attribute_class_resolutions = select l.context as context, l.expression as expression, l.class as class, l.file as file from required_step_counts as l join matched_step_counts as r on l.context = r.context and l.expression = r.expression and l.class = r.class and l.file = r.file where l.count = r.count;
let class_resolutions = union(left=name_class_resolutions, right=attribute_class_resolutions);
let enum_names = select id, file from "qualified-name" where path = "enum.Enum" or path = "enum.Flag" or path = "enum.IntEnum" or path = "enum.IntFlag" or path = "enum.StrEnum" or path = "enum.ReprEnum" or path = "enum.CheckEnum";
let direct_enum_classes = select l.class as id, l.file as file from mapped_bases as l join enum_names as r on l.expression = r.id and l.file = r.file;
let local_ancestry_edges = select r.context as context, l.class as origin, r.class as destination, l.file as file from mapped_bases as l join class_resolutions as r on l.expression = r.expression and l.file = r.file;
let class_ancestry = closure(edges=local_ancestry_edges,source="origin",destination="destination",keys=["context","file"]);
let indirect_enum_classes = select l.context as context, l.origin as id, l.file as file from class_ancestry as l join direct_enum_classes as r on l.destination = r.id and l.file = r.file;
let direct_context_enum_classes = select l.context as context, r.id as id, l.file as file from contexts as l join direct_enum_classes as r on l.file = r.file;
let enum_classes = union(left=direct_context_enum_classes,right=indirect_enum_classes);
let candidates = select l.decorator as id, l.file as file, l.span as span from dataclass_decorators as l join enum_classes as r on l.declaration = r.context and l.declaration = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF049(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF049)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF049)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF049)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF049"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
