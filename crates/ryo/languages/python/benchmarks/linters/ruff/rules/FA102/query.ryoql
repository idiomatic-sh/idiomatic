import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import annotation_context from "python/ruff/annotation-evaluation-context";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select parent, child, file from "semantic-child" where field = "value";
let generic_origins = select id, file from "qualified-name" where matches(path, "^(?:builtins[.](?:dict|frozenset|list|set|tuple|type)|collections[.](?:deque|defaultdict|ChainMap|Counter|OrderedDict)|asyncio[.](?:Future|Task)|contextlib[.](?:AbstractAsyncContextManager|AbstractContextManager)|dataclasses[.]Field|functools[.](?:cached_property|partialmethod)|os[.]PathLike|queue[.](?:LifoQueue|PriorityQueue|Queue|SimpleQueue)|re[.](?:Match|Pattern)|shelve[.](?:BsdDbShelf|DbfilenameShelf|Shelf)|types[.]MappingProxyType|weakref[.](?:WeakKeyDictionary|WeakMethod|WeakSet|WeakValueDictionary)|collections[.]abc[.](?:AsyncGenerator|AsyncIterable|AsyncIterator|Awaitable|ByteString|Callable|Collection|Container|Coroutine|Generator|ItemsView|Iterable|Iterator|KeysView|Mapping|MappingView|MutableMapping|MutableSequence|MutableSet|Reversible|Sequence|Set|ValuesView))$");
let subscript_values = select l.id as id, r.child as value, l.file as file from subscripts as l join values as r on l.id = r.parent and l.file = r.file;
let pep585 = select l.id as id, l.file as file from subscript_values as l join generic_origins as r on l.value = r.id and l.file = r.file;
let pipe_tokens = select id, file from nodes where text = "|";
let pep604 = select l.parent as id, l.file as file from "semantic-child" as l join pipe_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let old_generic_files = select file from "language-target" where major = 3 and minor >= 7 and minor < 9;
let old_union_files = select file from "language-target" where major = 3 and minor >= 7 and minor < 10;
let generic_candidates = select l.id as id, l.file as file from pep585 as l join old_generic_files as r on l.file = r.file;
let union_candidates = select l.id as id, l.file as file from pep604 as l join old_union_files as r on l.file = r.file;
let possible = union(left=generic_candidates, right=union_candidates);
let contexts = annotation_context(expressions=possible);
let eager = select id, file from contexts where evaluation = "eager";
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as id, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let tc_origins = select id, file from "qualified-name" where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let tc_plain = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_flags = union(left=tc_origins, right=tc_plain);
let tc_ifs = select l.id as id, l.file as file from tests as l join tc_flags as r on l.test = r.id and l.file = r.file;
let tc_bodies = select r.child as id, l.file as file from tc_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let tc_axes = axis(from=eager, relation="semantic-child", direction=ancestor, domain=tc_bodies);
let tc_members = select id, file from tc_axes;
let runtime = antijoin(left=eager, right=tc_members, left-on=["id","file"], right-on=["id","file"]);
let selected = select id, file from runtime where matches(file, "[.]py$");
let candidates = select l.id as id, l.file as file, r.span as span from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let located = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="(?:^|[^A-Z0-9])FA102(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FA102)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:FA102)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:FA102)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FA102"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
