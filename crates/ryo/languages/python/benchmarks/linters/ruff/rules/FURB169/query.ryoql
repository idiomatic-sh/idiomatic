import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let starred_nodes = select id, file from nodes where kind = "starred";
let argument_counts = group-count(from=all_arguments, keys=["call","file"], count="count", distinct="value");
let one_total_argument = select call, file from argument_counts where count = 1;
let first_arguments = select call, file, value from positional_arguments where position = 0;
let type_calls = select call, file from qualified_calls where path = "builtins.type";
let one_argument_type_calls = select l.call as call, l.file as file from type_calls as l join one_total_argument as r on l.call = r.call and l.file = r.file;
let positional_type_calls = select l.call as id, l.file as file, r.value as value from one_argument_type_calls as l join first_arguments as r on l.call = r.call and l.file = r.file;
let type_call_values = antijoin(left=positional_type_calls, right=starred_nodes, left-on=["value","file"], right-on=["id","file"]);
let null_values = select id, file from "literal-properties" where kind = "null";
let none_type_calls = select l.id as id, l.file as file from type_call_values as l join null_values as r on l.value = r.id and l.file = r.file;
let comparisons = select id, file, span from nodes where kind = "compare";
let comparator_edges = select parent, child, file from "semantic-child" where field = "comparators";
let comparator_counts = group-count(from=comparator_edges, keys=["parent","file"], count="count", distinct="child");
let single_comparisons = select l.id as id, l.file as file, l.span as span from comparisons as l join comparator_counts as r on l.id = r.parent and l.file = r.file where r.count = 1;
let op_edges = select parent, child, file from "semantic-child" where field = "ops";
let comparison_ops = select l.id as id, l.file as file, l.span as span, r.child as op from single_comparisons as l join op_edges as r on l.id = r.parent and l.file = r.file;
let identity_comparisons = select l.id as id, l.file as file, l.span as span from comparison_ops as l join nodes as r on l.op = r.id and l.file = r.file where r.kind = "is" or r.kind = "is-not" or r.text = "is" or r.text = "is not" or r.text = "==" or r.text = "!=";
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let left_operands = select l.id as id, l.file as file, l.span as span, r.child as left from identity_comparisons as l join left_edges as r on l.id = r.parent and l.file = r.file;
let paired_operands = select l.id as id, l.file as file, l.span as span, l.left as left, r.child as right from left_operands as l join comparator_edges as r on l.id = r.parent and l.file = r.file;
let type_left = select l.id as id, l.file as file, l.span as span, l.left as left, l.right as right from paired_operands as l join type_call_values as r on l.left = r.id and l.file = r.file;
let type_both = select l.id as id, l.file as file, l.span as span, l.left as left, l.right as right from type_left as l join type_call_values as r on l.right = r.id and l.file = r.file;
let none_left = select l.id as id, l.file as file, l.span as span from type_both as l join none_type_calls as r on l.left = r.id and l.file = r.file;
let none_right = select l.id as id, l.file as file, l.span as span from type_both as l join none_type_calls as r on l.right = r.id and l.file = r.file;
let candidates = union(left=none_left, right=none_right);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB169(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB169)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB169(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB169)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB169"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
