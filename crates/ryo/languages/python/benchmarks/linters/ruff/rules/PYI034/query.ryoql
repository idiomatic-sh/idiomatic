import observation_matches from "python/ruff/suppress-matches";
import class_bases from "python/ruff/class-bases";
import metaclass from "python/ruff/metaclass";

let classes = select id, file from "semantic-syntax" where kind = "class-def";
let sync_functions = select id, file from "semantic-syntax" where kind = "function-def";
let async_functions = select id, file from "semantic-syntax" where kind = "async-function-def";
let functions = union(left=sync_functions, right=async_functions);
let scopes = union(left=classes, right=functions);
let lambda_scopes = select id, file from "semantic-syntax" where kind = "lambda";
let all_scopes = union(left=scopes, right=lambda_scopes);
let nearest_scope_axes = axis(from=functions, relation="semantic-child", direction=nearest-ancestor, domain=all_scopes);
let function_nearest_scopes = select l.id as function, r.related as scope, l.file as file from functions as l join nearest_scope_axes as r on l.id = r.id and l.file = r.file;
let class_methods = select l.function as function, r.id as class, l.file as file from function_nearest_scopes as l join classes as r on l.scope = r.id and l.file = r.file;
let class_bases = select occurrence as base, declaration as class, target, file from "inherits";
let class_name_edges = select parent as class, child as name, file from "semantic-child" where field = "name";
let class_names = select l.class as class, r.name as name, l.file as file from class_name_edges as l join "identifier" as r on l.name = r.id and l.file = r.file;
let function_name_edges = select parent as function, child as name_id, file from "semantic-child" where field = "name";
let function_names = select l.function as function, l.name_id as name_id, r.name as name, l.file as file from function_name_edges as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let method_names = select l.function as function, l.class as class, n.name as method, n.name_id as name_id, l.file as file from class_methods as l join function_names as n on l.function = n.function and l.file = n.file;
let class_method_names = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, r.name as class_name, l.file as file from method_names as l join class_names as r on l.class = r.class and l.file = r.file;
let sync_class_methods = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.class_name as class_name, l.file as file from class_method_names as l join sync_functions as r on l.function = r.id and l.file = r.file;
let async_class_methods = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.class_name as class_name, l.file as file from class_method_names as l join async_functions as r on l.function = r.id and l.file = r.file;
let sync_fixed_methods = select * from sync_class_methods where method = "__enter__" or method = "__new__" or method = "__iadd__" or method = "__isub__" or method = "__imul__" or method = "__imatmul__" or method = "__itruediv__" or method = "__ifloordiv__" or method = "__imod__" or method = "__ipow__" or method = "__ilshift__" or method = "__irshift__" or method = "__iand__" or method = "__ixor__" or method = "__ior__";
let async_fixed_methods = select * from async_class_methods where method = "__aenter__";
let all_fixed_methods = union(left=sync_fixed_methods, right=async_fixed_methods);
let iterator_base_names = select id, file from "qualified-name" where path = "typing.Iterator" or path = "collections.abc.Iterator";
let async_iterator_base_names = select id, file from "qualified-name" where path = "typing.AsyncIterator" or path = "collections.abc.AsyncIterator";
let direct_base_names = select class, base as name, file from class_bases;
let subscript_base_values = select l.class as class, r.child as name, l.file as file from class_bases as l join "semantic-child" as r on l.base = r.parent and l.file = r.file where r.field = "value";
let all_base_names = union(left=direct_base_names, right=subscript_base_values);
let direct_iterator_classes = select l.class as class, l.file as file from all_base_names as l join iterator_base_names as r on l.name = r.id and l.file = r.file;
let direct_async_iterator_classes = select l.class as class, l.file as file from all_base_names as l join async_iterator_base_names as r on l.name = r.id and l.file = r.file;
let method_context_scopes = select l.function as context, l.class as initial_scope, l.file as file from class_method_names;
let method_bind_events = select occurrence, ordinal, file from "binding-event" where kind = "bind";
let method_contexts = select l.context as context, l.initial_scope as initial_scope, r.ordinal as point, l.file as file from method_context_scopes as l join method_bind_events as r on l.context = r.occurrence and l.file = r.file;
let contextual_class_bases = class_bases(ordered_contexts=method_contexts);
let contextual_class_paths = closure(edges=contextual_class_bases, source="child_class", destination="parent_class", keys=["context", "file"]);
let indirect_iterator_classes = select l.context as context, l.child_class as class, l.file as file from contextual_class_paths as l join direct_iterator_classes as r on l.parent_class = r.class and l.file = r.file;
let indirect_async_iterator_classes = select l.context as context, l.child_class as class, l.file as file from contextual_class_paths as l join direct_async_iterator_classes as r on l.parent_class = r.class and l.file = r.file;
let direct_context_iterator_classes = select l.context as context, r.class as class, l.file as file from method_contexts as l join direct_iterator_classes as r on l.file = r.file;
let direct_context_async_iterator_classes = select l.context as context, r.class as class, l.file as file from method_contexts as l join direct_async_iterator_classes as r on l.file = r.file;
let all_iterator_classes = union(left=direct_context_iterator_classes, right=indirect_iterator_classes);
let all_async_iterator_classes = union(left=direct_context_async_iterator_classes, right=indirect_async_iterator_classes);
let sync_iter_methods = select * from sync_class_methods where method = "__iter__";
let sync_aiter_methods = select * from sync_class_methods where method = "__aiter__";
let iterator_methods = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.file as file from sync_iter_methods as l join all_iterator_classes as r on l.function = r.context and l.class = r.class and l.file = r.file;
let async_iterator_methods = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.file as file from sync_aiter_methods as l join all_async_iterator_classes as r on l.function = r.context and l.class = r.class and l.file = r.file;
let iterator_method_rows = union(left=iterator_methods, right=async_iterator_methods);
let positional_argument_lists = select parent as function, child as arguments, file from "semantic-child" where field = "args";
let argument_structures = select l.function as function, l.arguments as arguments, l.file as file from positional_argument_lists as l join "semantic-syntax" as r on l.arguments = r.id and l.file = r.file where r.kind = "arguments";
let positional_parameters = select parent as arguments, child as parameter, file from "semantic-child" where field = "args" or field = "posonlyargs";
let functions_with_positional_parameters = select l.function as function, l.file as file from argument_structures as l join positional_parameters as r on l.arguments = r.arguments and l.file = r.file;
let methods_with_positional_parameters = select l.function as function, l.file as file from all_fixed_methods as l join functions_with_positional_parameters as r on l.function = r.function and l.file = r.file;
let methods_with_parameters = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.class_name as class_name, l.file as file from all_fixed_methods as l join methods_with_positional_parameters as r on l.function = r.function and l.file = r.file;
let return_edges = select parent as function, child as annotation, file from "semantic-child" where field = "returns";
let method_returns = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.class_name as class_name, r.annotation as annotation, l.file as file from methods_with_parameters as l join return_edges as r on l.function = r.function and l.file = r.file;
let direct_return_names = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.annotation as annotation, l.file as file from method_returns as l join "identifier" as r on l.annotation = r.id and l.class_name = r.name and l.file = r.file;
let string_values = select occurrence as annotation, value, file from "string-literal";
let stringized_return_names = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.annotation as annotation, l.file as file from method_returns as l join string_values as r on l.annotation = r.annotation and l.class_name = r.value and l.file = r.file;
let matching_returns = union(left=direct_return_names, right=stringized_return_names);
let class_decorators = select parent as class, child as list, file from "semantic-child" where field = "decorator-list";
let class_decorator_items = select l.class as class, r.child as decorator, l.file as file from class_decorators as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let final_decorator_names = select id, file from "qualified-name" where path = "typing.final" or path = "typing_extensions.final";
let final_classes = select l.class as class, l.file as file from class_decorator_items as l join final_decorator_names as r on l.decorator = r.id and l.file = r.file;
let final_sensitive_methods = select * from matching_returns where method = "__enter__" or method = "__new__" or method = "__aenter__";
let final_safe_methods = select * from matching_returns where method = "__iadd__" or method = "__isub__" or method = "__imul__" or method = "__imatmul__" or method = "__itruediv__" or method = "__ifloordiv__" or method = "__imod__" or method = "__ipow__" or method = "__ilshift__" or method = "__irshift__" or method = "__iand__" or method = "__ixor__" or method = "__ior__";
let nonfinal_sensitive_methods = antijoin(left=final_sensitive_methods, right=final_classes, left-on=["class", "file"], right-on=["class", "file"]);
let final_checked_methods = union(left=nonfinal_sensitive_methods, right=final_safe_methods);
let decorators = select parent as function, child as list, file from "semantic-child" where field = "decorator-list";
let decorator_items = select l.function as function, r.child as decorator, l.file as file from decorators as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let abstract_overload_names = select id, file from "qualified-name" where path = "abc.abstractmethod" or path = "typing.abstractmethod" or path = "typing_extensions.abstractmethod" or path = "typing.overload" or path = "typing_extensions.overload";
let abstract_or_overload_methods = select l.function as function, l.file as file from decorator_items as l join abstract_overload_names as r on l.decorator = r.id and l.file = r.file;
let concrete_methods = antijoin(left=final_checked_methods, right=abstract_or_overload_methods, left-on=["function", "file"], right-on=["function", "file"]);
let metaclass_root_classes = select function as context, class, file from class_method_names;
let metaclass_mode_rows = extend(from=method_contexts, values={mode: 0});
let metaclass_modes = select context, mode, file from metaclass_mode_rows;
let all_metaclasses = metaclass(ordered_contexts=method_contexts, resolved_base_edges=contextual_class_bases, modes=metaclass_modes, root_classes=metaclass_root_classes);
let nonmetaclass_methods = antijoin(left=concrete_methods, right=all_metaclasses, left-on=["function", "class", "file"], right-on=["context", "class", "file"]);
let iterator_methods_with_parameters = select l.function as function, l.class as class, l.method as method, l.name_id as name_id, l.file as file from iterator_method_rows as l join functions_with_positional_parameters as r on l.function = r.function and l.file = r.file;
let iterator_concrete_methods = antijoin(left=iterator_methods_with_parameters, right=abstract_or_overload_methods, left-on=["function", "file"], right-on=["function", "file"]);
let iterator_nonmetaclass_methods = antijoin(left=iterator_concrete_methods, right=all_metaclasses, left-on=["function", "class", "file"], right-on=["context", "class", "file"]);
let iterator_subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let iterator_return_subscripts = select l.function as function, l.annotation as annotation, l.file as file from return_edges as l join iterator_subscript_nodes as r on l.annotation = r.id and l.file = r.file;
let iterator_subscript_bases = select l.parent as annotation, l.child as base, l.file as file from "semantic-child" as l join iterator_subscript_nodes as r on l.parent = r.id and l.file = r.file where l.field = "value";
let iterator_return_base_rows = select l.function as function, r.base as base, l.file as file from iterator_return_subscripts as l join iterator_subscript_bases as r on l.annotation = r.annotation and l.file = r.file;
let iterator_return_types = select id, file from "qualified-name" where path = "typing.Iterator" or path = "collections.abc.Iterator" or path = "typing.Iterable" or path = "collections.abc.Iterable";
let async_iterator_return_types = select id, file from "qualified-name" where path = "typing.AsyncIterator" or path = "collections.abc.AsyncIterator" or path = "typing.AsyncIterable" or path = "collections.abc.AsyncIterable";
let direct_iter_return_rows = select l.function as function, l.file as file from return_edges as l join iterator_return_types as r on l.annotation = r.id and l.file = r.file;
let subscript_iter_return_rows = select l.function as function, l.file as file from iterator_return_base_rows as l join iterator_return_types as r on l.base = r.id and l.file = r.file;
let direct_aiter_return_rows = select l.function as function, l.file as file from return_edges as l join async_iterator_return_types as r on l.annotation = r.id and l.file = r.file;
let subscript_aiter_return_rows = select l.function as function, l.file as file from iterator_return_base_rows as l join async_iterator_return_types as r on l.base = r.id and l.file = r.file;
let iter_return_rows = union(left=direct_iter_return_rows, right=subscript_iter_return_rows);
let aiter_return_rows = union(left=direct_aiter_return_rows, right=subscript_aiter_return_rows);
let typed_iterator_methods = select l.name_id as id, l.file as file from iterator_nonmetaclass_methods as l join iter_return_rows as r on l.function = r.function and l.file = r.file where l.method = "__iter__";
let typed_async_iterator_methods = select l.name_id as id, l.file as file from iterator_nonmetaclass_methods as l join aiter_return_rows as r on l.function = r.function and l.file = r.file where l.method = "__aiter__";
let typed_iterator_candidates = union(left=typed_iterator_methods, right=typed_async_iterator_methods);
let fixed_method_candidates = select name_id as id, file from nonmetaclass_methods;
let all_method_candidates = union(left=fixed_method_candidates, right=typed_iterator_candidates);
let locations = select id, file, span, "start-line" from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from all_method_candidates as l join locations as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PYI034)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI034"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
