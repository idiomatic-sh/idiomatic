import suppress from "python/ruff/suppress";
let handlers = select id from "semantic-syntax" where kind = "except-handler";
let types = select parent, child from "semantic-child" where field = "type";
let booleans = select id, file, span from "semantic-syntax" where kind = "bool-op";
let handled = select r.child as child from handlers as l join types as r on l.id = r.parent;
let reportable = select r.id as id, r.file as file, r.span as span from handled as l join booleans as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0711(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0711)(?:,|$)");
emit violations subject file key(id);
