import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let called_values = select l.id as call, r.child as function, l.file as file from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let attributes = select id, file from nodes where kind = "attribute";
let attr_calls = select l.call as call, l.function as attribute, l.file as file from called_values as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let attr_labels = select l.call as call, l.attribute as attribute, r.child as label, l.file as file from attr_calls as l join attr_fields as r on l.attribute = r.parent and l.file = r.file;
let encode_calls = select l.call as call, l.attribute as attribute, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "encode";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let receivers = select l.call as call, r.child as receiver, l.file as file from encode_calls as l join value_fields as r on l.attribute = r.parent and l.file = r.file;
let arguments = select call, expression, file from "call-argument";
let empty_calls = antijoin(left=receivers, right=arguments, left-on=["call","file"], right-on=["call","file"]);
let counts = group-count(from=arguments, keys=["call","file"], count="count");
let one_argument = select l.call as call, l.expression as expression, l.file as file from arguments as l join counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, r.child as expression, l.file as file from keyword_nodes as l join value_fields as r on l.id = r.parent and l.file = r.file;
let keyword_fields = select parent, child, file from "semantic-child" where field = "arg";
let keyword_names = select l.keyword as keyword, l.expression as expression, l.file as file, r.child as label from keyword_values as l join keyword_fields as r on l.keyword = r.parent and l.file = r.file;
let encoding_keywords = select l.expression as expression, l.file as file from keyword_names as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "encoding";
let keyword_arguments = select l.call as call, l.expression as expression, l.file as file from one_argument as l join encoding_keywords as r on l.expression = r.expression and l.file = r.file;
let positional_arguments = antijoin(left=one_argument, right=keyword_values, left-on=["expression","file"], right-on=["expression","file"]);
let starred_nodes = select id, file from nodes where kind = "starred";
let starred_calls = select l.parent as call, l.file as file from "semantic-child" as l join starred_nodes as r on l.child = r.id and l.file = r.file where l.field = "args";
let unstarred_arguments = antijoin(left=positional_arguments, right=starred_calls, left-on=["call","file"], right-on=["call","file"]);
let shape_arguments = union(left=unstarred_arguments, right=keyword_arguments);
let utf8_literals = select occurrence as id, file from "string-literal" where matches(value, "(?i)^(?:utf-8|utf8|utf_8|u8|utf|cp65001)$");
let plain_encoding_strings = select id, file from "literal-properties" where kind = "string";
let literal_utf8 = select l.id as id, l.file as file from utf8_literals as l join plain_encoding_strings as r on l.id = r.id and l.file = r.file;
let utf8_arguments = select l.call as call, l.file as file from shape_arguments as l join literal_utf8 as r on l.expression = r.id and l.file = r.file;
let explicit_receivers = select l.call as call, l.receiver as receiver, l.file as file from receivers as l join utf8_arguments as r on l.call = r.call and l.file = r.file;
let string_values = select occurrence as id, value, file from "string-literal";
let plain_strings = select id, file from "literal-properties" where kind = "string";
let plain_receivers = select l.call as call, l.receiver as receiver, l.file as file from receivers as l join plain_strings as r on l.receiver = r.id and l.file = r.file;
let safe_receivers = select call, receiver, file from plain_receivers;
let ascii_strings = select id, file from string_values where matches(value, "^[[:ascii:]]*$");
let empty_ascii = select l.call as call, l.receiver as receiver, l.file as file from empty_calls as l join ascii_strings as r on l.receiver = r.id and l.file = r.file;
let plain_shapes = union(left=empty_ascii, right=explicit_receivers);
let plain_matches = select l.call as id, l.file as file from plain_shapes as l join safe_receivers as r on l.call = r.call and l.receiver = r.receiver and l.file = r.file;
let formatted = select id, file from nodes where kind = "joined-str";
let formatted_matches = select l.call as id, l.file as file from explicit_receivers as l join formatted as r on l.receiver = r.id and l.file = r.file;
let all_matches = union(left=plain_matches, right=formatted_matches);
let unique_matches = group-count(from=all_matches, keys=["id","file"], count="count");
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from unique_matches as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP012(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP012)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP012(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP012)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP012"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
