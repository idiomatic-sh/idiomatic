import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let binops = select id, file, span from "semantic-syntax" where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binop_lefts = select l.id as binop, l.file as file, r.child as left from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, l.file as file, r.child as right from binops as l join right_fields as r on l.id = r.parent;
let percent_tokens = select id as token from "semantic-syntax" where text = "%";
let modulo_operators = select l.parent as binop from "semantic-child" as l join percent_tokens as r on l.child = r.token;
let operands = select l.binop as binop, l.left as left, r.right as right, l.file as file from binop_lefts as l join binop_rights as r on l.binop = r.binop and l.file = r.file;
let modulo_candidates = select l.binop as binop, l.left as left, l.right as right, l.file as file from operands as l join modulo_operators as r on l.binop = r.binop;
let format_literals = select l.occurrence as format_id, l.value as value, l.file as file from "string-literal" as l;
let literal_binops = select l.binop as binop, l.left as left, l.right as right, l.file as file, r.format_id as format_id, r.value as format_value from modulo_candidates as l join format_literals as r on l.left = r.format_id and l.file = r.file;
let right_shapes = select l.binop as binop, l.format_id as format_id, l.right as right, l.file as file, r.kind as right_kind from literal_binops as l join "semantic-syntax" as r on l.right = r.id and l.file = r.file;
let segments = select id as format_id, "segment-ordinal" as ordinal, outcome, file from "raw-format-segment" where dialect = "percent-string";
let fields = select id as format_id, "segment-ordinal" as ordinal, "argument-kind" as argument_kind, "mapping-key" as mapping_key, conversion, "width-mode" as width, "precision-mode" as precision, flags, file from "raw-format-field";
let fixed_unsupported_fields = select format_id, ordinal, file from fields where width = "star" or precision = "star" or conversion = "d" or conversion = "i" or conversion = "u" or conversion = "c" or argument_kind = "mapping" and mapping_key = "";
let modifier_fields = select format_id, ordinal, conversion, file from fields where flags != "" or width != "none" or precision != "none";
let unsupported_conversions = select format_id, ordinal, file from modifier_fields where conversion = "r" or conversion = "a";
let width_strings = select format_id, ordinal, file from fields where conversion = "s" and width != "none";
let dictionary_operands = select binop, format_id, right, file from right_shapes where right_kind = "dict";
let dictionary_positional_fields = select l.format_id as format_id, r.ordinal as ordinal, l.file as file from dictionary_operands as l join fields as r on l.format_id = r.format_id and l.file = r.file where r.argument_kind = "positional";
let unsupported0 = union(left=fixed_unsupported_fields, right=unsupported_conversions);
let unsupported1 = union(left=unsupported0, right=width_strings);
let unsupported = union(left=unsupported1, right=dictionary_positional_fields);
let unsupported_events = extend(from=unsupported, values={kind:"literal"});
let invalid_segments = select format_id, ordinal, file from segments where outcome != "parsed";
let invalid_events = extend(from=invalid_segments, values={kind:"invalid"});
let terminals = union(left=unsupported_events, right=invalid_events);
let later_terminals = select l.format_id as format_id, l.ordinal as ordinal, l.file as file from terminals as l join terminals as r on l.format_id = r.format_id and l.file = r.file where r.ordinal < l.ordinal;
let first_terminals = antijoin(left=terminals, right=later_terminals, left-on=["format_id","ordinal","file"], right-on=["format_id","ordinal","file"]);
let fallback_formats = select format_id, file from first_terminals where kind = "literal";
let parsed_format_ids = select format_id, file from segments;
let convertible_formats = antijoin(left=parsed_format_ids, right=terminals, left-on=["format_id","file"], right-on=["format_id","file"]);
let key_fields = select l.right as dictionary, r.child as key, l.file as file from dictionary_operands as l join "semantic-child" as r on l.right = r.parent and l.file = r.file where r.field = "keys";
let string_keys = select l.dictionary as dictionary, l.key as key, r.value as value, l.file as file from key_fields as l join "string-literal" as r on l.key = r.occurrence and l.file = r.file;
let nonstring_keys = antijoin(left=key_fields, right=string_keys, left-on=["dictionary","key","file"], right-on=["dictionary","key","file"]);
let identifier_keys = select dictionary, key, value, file from string_keys where matches(value,"^(?:_|\p{XID_Start})\p{XID_Continue}*$");
let nonidentifier_keys = antijoin(left=string_keys, right=identifier_keys, left-on=["dictionary","key","file"], right-on=["dictionary","key","file"]);
let keyword_keys = select dictionary, key, file from string_keys where matches(value,"^(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$");
let duplicated_keys = select l.dictionary as dictionary, l.key as key, l.file as file from string_keys as l join string_keys as r on l.dictionary = r.dictionary and l.value = r.value and l.file = r.file where l.key != r.key;
let dictionary_values = select l.right as dictionary, l.file as file from dictionary_operands as l join "semantic-child" as r on l.right = r.parent and l.file = r.file where r.field = "values";
let empty_dictionaries = antijoin(left=dictionary_operands, right=dictionary_values, left-on=["right","file"], right-on=["dictionary","file"]);
let bad_dict0 = select dictionary, file from nonstring_keys;
let bad_dict1 = select dictionary, file from nonidentifier_keys;
let bad_dict2 = select dictionary, file from keyword_keys;
let bad_dict3 = select dictionary, file from duplicated_keys;
let bad_dict4 = select right as dictionary, file from empty_dictionaries;
let bad_dict01 = union(left=bad_dict0, right=bad_dict1);
let bad_dict23 = union(left=bad_dict2, right=bad_dict3);
let bad_dict0123 = union(left=bad_dict01, right=bad_dict23);
let bad_dicts = union(left=bad_dict0123, right=bad_dict4);
let complete_operands = select l.binop as binop, l.format_id as format_id, l.right as right, l.right_kind as right_kind, l.file as file from right_shapes as l join convertible_formats as r on l.format_id = r.format_id and l.file = r.file;
let dictionary_fallbacks = select l.binop as binop, l.format_id as format_id, l.file as file from complete_operands as l join bad_dicts as r on l.right = r.dictionary and l.file = r.file where l.right_kind = "dict";
let eligible_operands = select binop, format_id, file from complete_operands where right_kind = "constant" or right_kind = "joined-str" or right_kind = "name" or right_kind = "attribute" or right_kind = "subscript" or right_kind = "call" or right_kind = "tuple" or right_kind = "dict";
let normal_operands = antijoin(left=eligible_operands, right=dictionary_fallbacks, left-on=["binop","file"], right-on=["binop","file"]);
let early_fallback_operands = select l.binop as binop, l.format_id as format_id, l.file as file from literal_binops as l join fallback_formats as r on l.format_id = r.format_id and l.file = r.file;
let fallback_operands = union(left=early_fallback_operands, right=dictionary_fallbacks);
let normal_candidates = select binop as id, file from normal_operands;
let fallback_candidates = select format_id as id, file from fallback_operands;
let candidates = union(left=normal_candidates, right=fallback_candidates);
let locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="(?:^|[^A-Z0-9])UP031(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP031(?:,|$)");
let ruf100_matches = observation_matches(candidates=locations, inline-pattern="(?:^|[^A-Z0-9])UP031(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP031(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP031"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
