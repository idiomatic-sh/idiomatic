import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let arg_tokens = select l.parent as keyword, r.child as token from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let identifiers = select id, text from semantic_identifiers;
let named_keywords = select l.keyword as id, r.text as name from arg_tokens as l join identifiers as r on l.token = r.id;
let unordered_keyword_names = select l.call as call, l.id as id, r.name as name from keywords as l join named_keywords as r on l.id = r.id;
let ordered_keyword_names = select l.call as call, l.id as id, l.name as name, r."start-byte" as begin from unordered_keyword_names as l join "source-location" as r on l.id = r.id;
let later_keyword_names = select l.id as id from ordered_keyword_names as l join ordered_keyword_names as r on l.call = r.call and l.name = r.name where l.begin > r.begin;
let keyword_names = antijoin(left=unordered_keyword_names, right=later_keyword_names, left-on=["id"], right-on=["id"]);
let broad_exceptions = select id from qualified_names where (path = "builtins.Exception" or path = "builtins.BaseException") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let assert_raises_tokens = select id from semantic_identifiers where text = "assertRaises";
let assert_raises_attributes = select l.parent as id from attr_tokens as l join assert_raises_tokens as r on l.child = r.id;
let unittest_calls = select l.parent as id from functions as l join assert_raises_attributes as r on l.child = r.id;
let pytest_functions = select id from qualified_names where path = "pytest.raises";
let pytest_calls = select l.parent as id from functions as l join pytest_functions as r on l.child = r.id;
let pytest_match = select call as id from keyword_names where name = "match";
let no_match = antijoin(left=pytest_calls, right=pytest_match, left-on=["id"], right-on=["id"]);
let stars = select id from "semantic-syntax" where kind = "starred";
let star_positions = select l.call as call, l.ordinal as ordinal from positional as l join stars as r on l.id = r.id;
let obscured = select l.id as id from positional as l join star_positions as r on l.call = r.call where l.ordinal >= r.ordinal;
let known_positional = antijoin(left=positional, right=obscured, left-on=["id"], right-on=["id"]);
let constants = select id from "semantic-syntax" where kind = "constant";
let strings = select l.occurrence as id from "string-literal" as l join constants as r on l.occurrence = r.id;
let byte_tokens = select id from "semantic-syntax" where kind = "string" and matches(text, "(?i)^(?:b|br|rb)[\x22']");
let byte_owners = axis(from=byte_tokens, relation="semantic-child", direction=nearest-ancestor, domain=constants);
let bytes = select related as id from byte_owners;
let textual = union(left=strings, right=bytes);
let second_args = select call, id from known_positional where ordinal = 1;
let string_second = select l.call as id from second_args as l join textual as r on l.id = r.id;
let pytest_candidates = antijoin(left=no_match, right=string_second, left-on=["id"], right-on=["id"]);
let unittest_arguments = select l.id as call, r.id as keyword from unittest_calls as l join keyword_names as r on l.id = r.call where r.name = "exception";
let pytest_arguments = select l.id as call, r.id as keyword from pytest_candidates as l join keyword_names as r on l.id = r.call where r.name = "expected_exception";
let named_arguments = union(left=unittest_arguments, right=pytest_arguments);
let values = select parent, child from "semantic-child" where field = "value";
let named_values = select l.call as call, r.child as id from named_arguments as l join values as r on l.keyword = r.parent;
let eligible_calls = union(left=unittest_calls, right=pytest_candidates);
let first_arguments = select call, id from known_positional where ordinal = 0;
let positional_values = select l.call as call, l.id as id from first_arguments as l join eligible_calls as r on l.call = r.id;
let positional_fallback = antijoin(left=positional_values, right=named_values, left-on=["call"], right-on=["call"]);
let exception_values = union(left=named_values, right=positional_fallback);
let blind_calls = select l.call as id from exception_values as l join broad_exceptions as r on l.id = r.id;
let arg_counts = group-count(from=positional, keys=["call"], count="count", distinct="id");
let multiple_args = select call as id from arg_counts where count >= 2;
let func_keywords = select call as id from keyword_names where name = "func";
let call_forms = union(left=multiple_args, right=func_keywords);
let invalid_calls = select l.id as id from blind_calls as l join call_forms as r on l.id = r.id;
let call_reports = select l.id as id, l.file as file, l.span as span from calls as l join invalid_calls as r on l.id = r.id;
let withitems = select id, file, span from "semantic-syntax" where kind = "withitem";
let bound_items = select parent from "semantic-child" where field = "optional-vars";
let unbound_items = antijoin(left=withitems, right=bound_items, left-on=["id"], right-on=["parent"]);
let contexts = select parent, child from "semantic-child" where field = "context-expr";
let blind_contexts = select l.parent as id from contexts as l join blind_calls as r on l.child = r.id;
let context_reports = select l.id as id, l.file as file, l.span as span from unbound_items as l join blind_contexts as r on l.id = r.id;
let reportable = union(left=call_reports, right=context_reports);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B017(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B017)(?:,|$)");
emit violations subject file key(id);
