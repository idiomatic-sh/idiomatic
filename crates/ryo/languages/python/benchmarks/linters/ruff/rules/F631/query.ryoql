import suppress from "python/ruff/suppress";
let statements = select * from "semantic-syntax" where kind = "assert";
let tests = select parent, child from "semantic-child" where field = "test";
let tuples = select id from "semantic-syntax" where kind = "tuple";
let elements = select parent from "semantic-child" where field = "elts";
let nonempty = select l.id as id from tuples as l join elements as r on l.id = r.parent;
let tuple_tests = select l.parent as parent from tests as l join nonempty as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from statements as l join tuple_tests as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F631(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F631)(?:,|$)");
emit violations subject file key(id);
