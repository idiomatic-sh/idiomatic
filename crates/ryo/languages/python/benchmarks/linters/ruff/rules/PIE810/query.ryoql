import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let bool_ops = select id, file, span from "semantic-syntax" where kind = "bool-op";
let op_fields = select parent, child from "semantic-child" where field = "op";
let or_tokens = select id from "semantic-syntax" where text = "or";
let or_ops = select l.parent as id from op_fields as l join or_tokens as r on l.child = r.id;
let owners = select l.id as id, l.file as file, l.span as span from bool_ops as l join or_ops as r on l.id = r.id;
let value_fields = select parent, child, ordinal from "semantic-child" where field = "values";
let values = select l.id as owner, l.file as file, l.span as span, r.child as value, r.ordinal as ordinal from owners as l join value_fields as r on l.id = r.parent;
let calls = select id, file from "semantic-syntax" where kind = "call";
let call_values = select l.owner as owner, l.file as file, l.span as span, l.value as call, l.ordinal as ordinal from values as l join calls as r on l.value = r.id and l.file = r.file;
let argument_wrappers = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file where r.kind = "call-arguments";
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as argument, l.file as file from argument_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let positional_counts = group-count(from=positional, keys=["call", "file"], count="n", distinct="argument");
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as keyword, l.file as file from argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let named_keyword_fields = select parent as keyword from "semantic-child" where field = "arg";
let spreads = antijoin(left=keywords, right=named_keyword_fields, left-on=["keyword"], right-on=["keyword"]);
let keyworded_calls = select call, file from keywords;
let attrs = select id, file from "semantic-syntax" where kind = "attribute";
let functions = select parent, child from "semantic-child" where field = "func";
let call_func = select l.parent as call, l.child as function, r.file as file from functions as l join calls as r on l.parent = r.id;
let attr_funcs = select l.call as call, l.function as attribute, l.file as file from call_func as l join attrs as r on l.function = r.id and l.file = r.file;
let attr_values = select parent, child from "semantic-child" where field = "value";
let receivers = select l.call as call, l.attribute as attribute, l.file as file, r.child as receiver from attr_funcs as l join attr_values as r on l.attribute = r.parent;
let names = select id, name, file from "identifier";
let receiver_names = select l.call as call, l.attribute as attribute, l.file as file, r.name as receiver from receivers as l join names as r on l.receiver = r.id and l.file = r.file;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.call as call, l.file as file, l.receiver as receiver, r.child as token from receiver_names as l join attr_fields as r on l.attribute = r.parent;
let attrs_named = select l.call as call, l.file as file, l.receiver as receiver, r.name as method from attr_tokens as l join names as r on l.token = r.id and l.file = r.file;
let one_argument_calls = select l.call as call, l.file as file from positional_counts as l where l.n = 1;
let eligible_calls_a = select l.owner as owner, l.file as file, l.span as span, l.call as call, l.ordinal as ordinal, r.receiver as receiver, r.method as method from call_values as l join attrs_named as r on l.call = r.call and l.file = r.file;
let eligible_calls_args = select l.owner as owner, l.file as file, l.span as span, l.call as call, l.ordinal as ordinal, l.receiver as receiver, l.method as method, r.argument as argument from eligible_calls_a as l join positional as r on l.call = r.call and l.file = r.file;
let eligible_calls_b = select l.owner as owner, l.file as file, l.span as span, l.call as call, l.ordinal as ordinal, l.receiver as receiver, l.method as method, l.argument as argument from eligible_calls_args as l join one_argument_calls as r on l.call = r.call and l.file = r.file;
let eligible_calls_c = antijoin(left=eligible_calls_b, right=keyworded_calls, left-on=["call", "file"], right-on=["call", "file"]);
let eligible_methods_a = select owner, file, span, call, ordinal, receiver, method, argument from eligible_calls_c where method = "startswith" or method = "endswith";
let argument_names = select id from "semantic-syntax" where kind = "name";
let named_arguments = select l.call as call, l.file as file, l.argument as argument from eligible_methods_a as l join argument_names as r on l.argument = r.id;
let argument_bindings = select l.call as call, l.file as file, r.binding as binding from named_arguments as l join "binding-use" as r on l.argument = r.reference and l.file = r.file;
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let target_fields_a = select parent, child from "semantic-child" where field = "targets";
let target_fields_b = select parent, child from "semantic-child" where field = "target";
let target_fields = union(left=target_fields_a, right=target_fields_b);
let value_fields_assignment = select parent, child from "semantic-child" where field = "value";
let assignment_targets = select l.id as assignment, l.file as file, r.child as target from assignment_nodes as l join target_fields as r on l.id = r.parent;
let bind_events = select occurrence, file from "binding-event" where kind = "bind";
let bound_target_nodes = select l.assignment as assignment, l.file as file, l.target as binding from assignment_targets as l join bind_events as r on l.target = r.occurrence and l.file = r.file;
let assignment_values = select l.id as assignment, l.file as file, r.child as value from assignment_nodes as l join value_fields_assignment as r on l.id = r.parent;
let tuple_nodes = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_assignment_values_a = select l.assignment as assignment, l.file as file from assignment_values as l join tuple_nodes as r on l.value = r.id and l.file = r.file;
let value_calls = select l.assignment as assignment, l.file as file, r.child as function from assignment_values as l join functions as r on l.value = r.parent;
let tuple_constructor_names = select id, file from "qualified-name" where path = "builtins.tuple";
let tuple_call_values = select l.assignment as assignment, l.file as file from value_calls as l join tuple_constructor_names as r on l.function = r.id and l.file = r.file;
let tuple_value_initializers = union(left=tuple_assignment_values_a, right=tuple_call_values);
let annotation_fields = select parent, child from "semantic-child" where field = "annotation";
let annotated_assignments = select l.id as assignment, l.file as file, r.child as annotation from assignment_nodes as l join annotation_fields as r on l.id = r.parent;
let tuple_annotation_names = select id, file from "qualified-name" where path = "builtins.tuple" or path = "typing.Tuple" or path = "typing_extensions.Tuple";
let annotation_value_fields = select parent, child from "semantic-child" where field = "value";
let annotation_bases = select l.assignment as assignment, l.file as file, r.child as base from annotated_assignments as l join annotation_value_fields as r on l.annotation = r.parent;
let tuple_annotated_assignments_a = select l.assignment as assignment, l.file as file from annotated_assignments as l join tuple_annotation_names as r on l.annotation = r.id and l.file = r.file;
let tuple_annotated_assignments_b = select l.assignment as assignment, l.file as file from annotation_bases as l join tuple_annotation_names as r on l.base = r.id and l.file = r.file;
let tuple_annotated_assignments = union(left=tuple_annotated_assignments_a, right=tuple_annotated_assignments_b);
let tuple_assignment_values = union(left=tuple_value_initializers, right=tuple_annotated_assignments);
let tuple_assignment_targets = select l.binding as binding, l.file as file from bound_target_nodes as l join tuple_assignment_values as r on l.assignment = r.assignment and l.file = r.file;
let vararg_fields = select parent, child from "semantic-child" where field = "vararg";
let vararg_bind_events = select occurrence, file from "binding-event" where kind = "bind";
let tuple_vararg_targets = select l.child as binding, r.file as file from vararg_fields as l join vararg_bind_events as r on l.child = r.occurrence;
let tuple_bindings = union(left=tuple_assignment_targets, right=tuple_vararg_targets);
let tuple_bound_references = select l.call as call, l.file as file from argument_bindings as l join tuple_bindings as r on l.binding = r.binding and l.file = r.file;
let tuple_arguments = select call, file from tuple_bound_references;
let non_tuple_methods = antijoin(left=eligible_methods_a, right=tuple_arguments, left-on=["call", "file"], right-on=["call", "file"]);
let eligible_methods = select owner, file, span, call, ordinal, receiver, method from non_tuple_methods;
let earlier_members = select l.owner as owner, l.file as file, l.call as call from eligible_methods as l join eligible_methods as r on l.owner = r.owner and l.file = r.file and l.receiver = r.receiver and l.method = r.method where r.ordinal < l.ordinal;
let first_members = antijoin(left=eligible_methods, right=earlier_members, left-on=["owner", "file", "call"], right-on=["owner", "file", "call"]);
let method_group_counts = group-count(from=eligible_methods, keys=["owner", "file", "receiver", "method"], count="member_count");
let repeated_method_groups = select owner, file, receiver, method from method_group_counts where member_count > 1;
let first_repeated_members = select l.owner as owner, l.file as file, l.span as span, l.call as id from first_members as l join repeated_method_groups as r on l.owner = r.owner and l.file = r.file and l.receiver = r.receiver and l.method = r.method;
let duplicate_owners = select l.id as id, l.file as file, r.span as span, l.owner as owner from first_repeated_members as l join owners as r on l.owner = r.id and l.file = r.file;
let owner_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from duplicate_owners as l join "source-location" as r on l.owner = r.id and l.file = r.file;
let located = suppress(candidates=owner_locations, inline-pattern="(?:^|[^A-Z0-9])PIE810(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PIE810)(?:,|$)");
let ruf100_matches = observation_matches(candidates=owner_locations, inline-pattern="(?:^|[^A-Z0-9])PIE810(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PIE810)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PIE810"});
observe ruf100_used as noqa_matches;
emit located subject file key(id);
