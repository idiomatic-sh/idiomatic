import conditional_deletions from "python/ruff/conditional-deletions";
import latest_before from "python/ruff/latest-before";
import ordinary_uses_of from "python/ruff/ordinary-read-uses";
import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
import deferred_resolutions from "python/ruff/deferred-read-resolutions";
import eager_before_future from "python/ruff/eager-before-future";
import line_located from "python/ruff/candidate-locations";
let read_rows = select reference, name, scope, phase, context, state, "since-major" as since_major, "since-minor" as since_minor, file, span from "binding-read";
let unbound_missing = select reference as id, name, scope, phase, file, span from read_rows where state = "unbound" and context != "deletion";
let provider_resolved_reads = select l.reference as reference, l.file as file from read_rows as l join "binding-use" as r on l.reference = r.reference and l.file = r.file where l.context = "value";
let resolved_value_reads = select reference, file from provider_resolved_reads;
let lookup_reads = select reference, file from read_rows where state = "unbound" and context = "value";
let merged_lookup_reads = union(left=resolved_value_reads, right=lookup_reads);
let merged_lookups = ordinary_uses_of(reads=merged_lookup_reads);
let resolved_lookups = select l.reference as reference, l.binding as binding, l.kind as kind, l.file as file from merged_lookups as l join resolved_value_reads as r on l.reference = r.reference and l.file = r.file;
let resolved_hit_ids = select reference, file from resolved_lookups;
let lookup_missed = antijoin(left=resolved_value_reads, right=resolved_hit_ids, left-on=["reference", "file"], right-on=["reference", "file"]);
let missed_rows = select l.reference as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from read_rows as l join lookup_missed as r on l.reference = r.reference and l.file = r.file;
let ordinary_missing0 = union(left=unbound_missing, right=missed_rows);
let replay_reads = select reference as id, name, scope, phase, file from read_rows where context != "deletion";
let eager_missing = eager_before_future(reads=replay_reads);
let replay_missing = select l.reference as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from read_rows as l join eager_missing as r on l.reference = r.id and l.file = r.file;
let ordinary_missing = union(left=ordinary_missing0, right=replay_missing);
let global_declarations = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "global";
let global_scope_owner_nodes = select id, file from "semantic-syntax" where kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let global_function_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let global_declaration_owners = axis(from=global_declarations, relation="semantic-child", direction=nearest-ancestor, domain=global_scope_owner_nodes);
let global_owner_rows = select l.id as declaration, l.name as name, r.related as func, l.file as file from global_declarations as l join global_declaration_owners as r on l.id = r.id;
let global_owner_inputs = select func as id, file from global_owner_rows;
let global_outer_axis = axis(from=global_owner_inputs, relation="semantic-child", direction=ancestor, domain=global_function_nodes);
let global_nested_owners = select id as func, file from global_outer_axis;
let eager_global_owners = antijoin(left=global_owner_rows, right=global_nested_owners, left-on=["func", "file"], right-on=["func", "file"]);
let global_positions = select id, "start-byte" as at, file from "source-location";
let global_declared_names = select l.name as name, l.file as file, r.at as declared_at from global_owner_rows as l join global_positions as r on l.declaration = r.id and l.file = r.file;
let eager_global_names = select l.name as name, l.file as file, r.at as declared_at from eager_global_owners as l join global_positions as r on l.declaration = r.id and l.file = r.file;
let global_module_phases = select id, file from "semantic-syntax" where kind = "module";
let missing_read_rows = select l.reference as reference, l.name as name, l.phase as phase, l.scope as scope, l.file as file from read_rows as l join ordinary_missing as r on l.reference = r.id and l.file = r.file;
let unbound_reads = select l.reference as id, l.name as name, l.phase as phase, l.file as file, r.at as read_at from missing_read_rows as l join global_positions as r on l.reference = r.id and l.file = r.file;
let eager_unbound_reads = select l.id as id, l.name as name, l.file as file, l.read_at as read_at from unbound_reads as l join global_module_phases as r on l.phase = r.id and l.file = r.file;
let deferred_unbound_reads = antijoin(left=unbound_reads, right=eager_unbound_reads, left-on=["id", "file"], right-on=["id", "file"]);
let global_declared_name_keys = select name, file from global_declared_names;
let deferred_global_reads = select l.id as id from deferred_unbound_reads as l join global_declared_name_keys as r on l.name = r.name and l.file = r.file;
let eager_global_events = select m.id as scope, m.id as phase, l.name as name, l.file as file, l.declared_at as ordinal from eager_global_names as l join global_module_phases as m on l.file = m.file;
let eager_global_probes = select m.id as scope, m.id as phase, l.name as name, l.file as file, l.read_at as ordinal from eager_unbound_reads as l join global_module_phases as m on l.file = m.file;
let eager_global_hits = latest_before(events=eager_global_events, probes=eager_global_probes);
let eager_global_reads = select l.id as id from eager_unbound_reads as l join eager_global_hits as r on l.name = r.name and l.file = r.file and l.read_at = r.point;
let same_scope_declarations = select name, func as owner, file from global_owner_rows;
let same_scope_global_reads = select l.reference as id from missing_read_rows as l join same_scope_declarations as r on l.name = r.name and l.scope = r.owner and l.file = r.file;
let global_reads0 = union(left=deferred_global_reads, right=eager_global_reads);
let explicit_global_reads = union(left=global_reads0, right=same_scope_global_reads);
let ordinary_missing_without_global = antijoin(left=ordinary_missing, right=explicit_global_reads, left-on=["id"], right-on=["id"]);
let read_events = select occurrence as id, ordinal, scope, phase, name, file from "binding-event" where kind = "read";
let local_declarations = select name, scope, phase, ordinal, file from "binding-event" where kind = "bind" or kind = "annotation";
let conditional_delete_effects = conditional_deletions();
let removal_candidates = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "delete" or kind = "cleanup";
let unconditional_removals = antijoin(left=removal_candidates, right=conditional_delete_effects, left-on=["id", "file"], right-on=["id", "file"]);
let removal_owner_axis = axis(from=unconditional_removals, relation="semantic-child", direction=nearest-ancestor, domain=global_scope_owner_nodes);
let removal_class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let class_removal_owners = select l.id as id, l.related as owner, l.file as file from removal_owner_axis as l join removal_class_nodes as r on l.related = r.id and l.file = r.file;
let class_removal_ids = select id, file from class_removal_owners;
let outer_removals = antijoin(left=unconditional_removals, right=class_removal_ids, left-on=["id", "file"], right-on=["id", "file"]);
let removal_events = select name, scope, phase, ordinal, file from outer_removals;
let class_removals = select l.name as name, r.owner as owner, l.phase as phase, l.ordinal as ordinal, l.file as file from unconditional_removals as l join class_removal_owners as r on l.id = r.id and l.file = r.file;
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let missing_read_events = select l.id as id, r.ordinal as ordinal, r.scope as scope, r.phase as phase, r.name as name, r.file as file from ordinary_missing as l join read_events as r on l.id = r.id and l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let outer_prior_removals = select l.id as id from missing_read_events as l join removal_events as d on l.name = d.name and l.phase = d.phase and l.file = d.file where d.ordinal < l.ordinal;
let class_prior_removals = select l.id as id from missing_read_events as l join class_removals as d on l.name = d.name and l.scope = d.owner and l.file = d.file where d.ordinal < l.ordinal;
let prior_removals = union(left=outer_prior_removals, right=class_prior_removals);
let deletion_reads = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from ordinary_missing as l join prior_removals as r on l.id = r.id;
let delete_events = select occurrence as id, name, scope, phase, ordinal, file, span from "binding-event" where kind = "delete";
let local_delete_candidates = select id, name, scope, phase, ordinal, file, span from delete_events;
let parameter_declarations = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let declaration_scope_nodes = select id, file from "semantic-syntax" where kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let declaration_inputs = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "global" or kind = "nonlocal";
let declaration_owners = axis(from=declaration_inputs, relation="semantic-child", direction=nearest-ancestor, domain=declaration_scope_nodes);
let owned_declarations = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file from declaration_inputs as l join declaration_owners as r on l.id = r.id;
let declaration_binds = extend(from=owned_declarations, values={kind: "bind"});
let declaration_effects = select id, name, scope, phase, ordinal, kind, file from declaration_binds;
let value_namespace_effects = select occurrence as id, name, scope, phase, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let raw_namespace_effects = union(left=value_namespace_effects, right=declaration_effects);
let nonparameter_namespace_effects = antijoin(left=raw_namespace_effects, right=parameter_declarations, left-on=["id", "file"], right-on=["id", "file"]);
let namespace_effects = antijoin(left=nonparameter_namespace_effects, right=conditional_delete_effects, left-on=["id", "file"], right-on=["id", "file"]);
let effect_successors = ordered-match(left=namespace_effects, right=namespace_effects, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="ordinal", right-order="ordinal", output={deletion:[right,id], deletion_order:[right,ordinal], prior:[left,ordinal], prior_kind:[left,kind], name:[left,name], scope:[left,scope], phase:[left,phase], file:[left,file]});
let direct_prior_effects = select l.deletion as deletion, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.prior as prior, l.prior_kind as prior_kind from effect_successors as l join delete_events as r on l.deletion = r.id and l.deletion_order = r.ordinal and l.file = r.file;
let conditional_delete_rows = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file from local_delete_candidates as l join conditional_delete_effects as r on l.id = r.id and l.file = r.file;
let effect_events = select scope, phase, name, file, ordinal from namespace_effects;
let conditional_probes = select scope, phase, name, file, ordinal from conditional_delete_rows;
let conditional_latest = latest_before(events=effect_events, probes=conditional_probes);
let conditional_hits = select l.id as deletion, l.name as name, l.scope as scope, l.phase as phase, l.file as file, r.event_ordinal as prior from conditional_delete_rows as l join conditional_latest as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.ordinal = r.point;
let conditional_prior_effects = select l.deletion as deletion, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.prior as prior, r.kind as prior_kind from conditional_hits as l join namespace_effects as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.prior = r.ordinal;
let latest_prior_effects = union(left=direct_prior_effects, right=conditional_prior_effects);
let latest_prior_bindings = select deletion as id from latest_prior_effects where prior_kind = "bind";
let deletion_scope_owners = axis(from=local_delete_candidates, relation="semantic-child", direction=nearest-ancestor, domain=global_scope_owner_nodes);
let nested_deletion_ids = select id, file from deletion_scope_owners;
let module_level_deletions = antijoin(left=local_delete_candidates, right=nested_deletion_ids, left-on=["id", "file"], right-on=["id", "file"]);
let module_phase_deletions = select l.id as id, l.name as name, l.file as file from module_level_deletions as l join global_module_phases as r on l.phase = r.id and l.file = r.file;
let module_phase_deletion_positions = select l.id as id, l.name as name, l.file as file, r.at as at from module_phase_deletions as l join global_positions as r on l.id = r.id and l.file = r.file;
let synthetic_global_deletions = select l.id as id from module_phase_deletion_positions as l join eager_global_names as r on l.name = r.name and l.file = r.file where r.declared_at < l.at;
let unbound_candidates = antijoin(left=local_delete_candidates, right=latest_prior_bindings, left-on=["id"], right-on=["id"]);
let missing_prior_bindings = antijoin(left=unbound_candidates, right=synthetic_global_deletions, left-on=["id"], right-on=["id"]);
let builtin_modules = select id, file from "semantic-syntax" where kind = "module";
let no_prior_effect_deletions = antijoin(left=missing_prior_bindings, right=latest_prior_effects, left-on=["id", "file"], right-on=["deletion", "file"]);
let builtin_deletions0 = select l.id as id, l.name as name, l.file as file from no_prior_effect_deletions as l join builtin_modules as r on l.scope = r.id and l.file = r.file;
let builtin_catalog = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let first_builtin_deletions = select l.id as id, l.file as file from builtin_deletions0 as l join builtin_catalog as r on l.name = r.name and l.file = r.file;
let actually_missing_deletions = antijoin(left=missing_prior_bindings, right=first_builtin_deletions, left-on=["id", "file"], right-on=["id", "file"]);
let inferred_unresolved_deletions = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from actually_missing_deletions as l;
let all_unresolved_deletions = select * from inferred_unresolved_deletions;
let unavailable_builtins = select reference as id, name, scope, phase, file, span from read_rows where state = "builtin" and context != "deletion" and (since_major > 3 or since_major = 3 and since_minor > 10);
let pre_environment_candidates = union(left=ordinary_missing_without_global, right=unavailable_builtins);
let module_environment = select catalog.name as name, catalog.scope as scope, catalog.file as file from "implicit-symbol" as catalog where catalog.kind = "module-global" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let ordinary_candidates = antijoin(left=pre_environment_candidates, right=prior_removals, left-on=["id"], right-on=["id"]);
let module_environment_reads = select l.id as id from ordinary_candidates as l join module_environment as r on l.name = r.name and l.file = r.file;
let without_module_environment = antijoin(left=ordinary_candidates, right=module_environment_reads, left-on=["id"], right-on=["id"]);
let platform_environment = select name, file from "implicit-symbol" where kind = "platform-builtin";
let platform_environment_reads = select l.id as id from without_module_environment as l join platform_environment as r on l.name = r.name and l.file = r.file;
let without_platform_environment = antijoin(left=without_module_environment, right=platform_environment_reads, left-on=["id"], right-on=["id"]);
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_candidate_reads = select l.id as id, r.name as name, r.scope as scope, r.file as file from without_platform_environment as l join read_rows as r on l.id = r.reference and l.file = r.file;
let class_magic_reads = select l.id as id from class_candidate_reads as l join class_scopes as c on l.scope = c.id and l.file = c.file where (l.name = "__module__" or l.name = "__qualname__");
let class_cell_candidate_reads = select l.id as id, r.scope as scope, r.file as file from without_platform_environment as l join read_rows as r on l.id = r.reference and l.file = r.file where r.name = "__class__";
let function_class_cell_reads = select l.id as id, l.file as file from class_cell_candidate_reads as l join function_scopes as f on l.scope = f.id and l.file = f.file;
let class_ancestors = axis(from=function_class_cell_reads, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let class_cell_reads = select l.id as id from class_ancestors as l join class_scopes as c on l.related = c.id and l.file = c.file;
let class_implicit_reads = union(left=class_magic_reads, right=class_cell_reads);
let without_class_implicit = antijoin(left=without_platform_environment, right=class_implicit_reads, left-on=["id"], right-on=["id"]);
let known_deletions = union(left=deletion_reads, right=all_unresolved_deletions);
let pre_suppression_candidates = union(left=without_class_implicit, right=known_deletions);
let semantic_paths = closure(edges="semantic-child", source="parent", destination="child");
let tries = select id, file from "semantic-syntax" where kind = "try";
let try_body_roots = select l.parent as attempt, l.child as child from "semantic-child" as l join tries as r on l.parent = r.id where l.field = "body";
let try_body_nodes = select l.attempt as attempt, r.child as id from try_body_roots as l join semantic_paths as r on l.child = r.parent;
let try_body_root_nodes = select attempt, child as id from try_body_roots;
let all_try_body_nodes = union(left=try_body_nodes, right=try_body_root_nodes);
let handler_edges = select parent, child as handler from "semantic-child" where field = "handlers";
let try_handlers = select l.parent as attempt, l.handler as handler, r.file as file from handler_edges as l join tries as r on l.parent = r.id;
let handler_type_roots = select parent as handler, child as id from "semantic-child" where field = "type";
let handler_type_descendants = select l.handler as handler, r.child as id from handler_type_roots as l join semantic_paths as r on l.id = r.parent;
let handler_type_nodes = union(left=handler_type_roots, right=handler_type_descendants);
let name_error_type_nodes = select l.handler as handler from handler_type_nodes as l join "qualified-name" as r on l.id = r.id where r.path = "builtins.NameError";
let name_error_attempts = select l.attempt as id, l.file as file from try_handlers as l join name_error_type_nodes as r on l.handler = r.handler;
let name_error_body_reads = select r.attempt as attempt, l.id as id from pre_suppression_candidates as l join all_try_body_nodes as r on l.id = r.id;
let name_error_candidates = select l.attempt as attempt, l.id as id from name_error_body_reads as l join name_error_attempts as r on l.attempt = r.id;
let phase_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "generator-exp";
let try_phase_ancestors = axis(from=tries, relation="semantic-child", direction=nearest-ancestor, domain=phase_scopes);
let try_phase_rows = select id as attempt, related as phase, file from try_phase_ancestors;
let module_roots = select id as phase, file from "semantic-syntax" where kind = "module";
let tries_without_callable_phase = antijoin(left=tries, right=try_phase_rows, left-on=["id"], right-on=["attempt"]);
let module_phase_tries = select l.id as attempt, r.phase as phase, l.file as file from tries_without_callable_phase as l join module_roots as r on l.file = r.file;
let all_try_phases = union(left=try_phase_rows, right=module_phase_tries);
let name_error_reads_with_phase = select l.attempt as attempt, l.id as id, r.phase as phase, r.file as file from name_error_candidates as l join read_rows as r on l.id = r.reference;
let same_phase_name_errors = select l.id as id from name_error_reads_with_phase as l join all_try_phases as r on l.attempt = r.attempt and l.phase = r.phase and l.file = r.file;
let without_name_error_handlers = antijoin(left=pre_suppression_candidates, right=same_phase_name_errors, left-on=["id"], right-on=["id"]);
let candidates = select * from without_name_error_handlers;
let package_init_files = select path as file from "filesystem.file" where path = "__init__.py" or ends_with(path, "/__init__.py");
let package_path_reads = select l.reference as id, l.file as file from "binding-read" as l join package_init_files as r on l.file = r.file where l.name = "__path__" and l.state = "unbound" and l.context = "value";
let report_candidates = antijoin(left=candidates, right=package_path_reads, left-on=["id", "file"], right-on=["id", "file"]);
let unresolved_reads = select id, name, scope, phase, file from ordinary_missing;
let deferred_known = deferred_resolutions(missing=unresolved_reads);
let lookup_hits = select l.reference as reference, l.binding as binding, l.kind as kind, l.file as file from merged_lookups as l join lookup_reads as r on l.reference = r.reference and l.file = r.file;
let lookup_known = select reference as id, file from lookup_hits where kind != "unresolved";
let resolved_later = union(left=deferred_known, right=lookup_known);
let final_candidates = antijoin(left=report_candidates, right=resolved_later, left-on=["id", "file"], right-on=["id", "file"]);
let reportable = select id, file, span from final_candidates;
let candidate_locations = line_located(candidates=reportable);
let suppression_mappings = noqa_line_map();
let suppression_locations = noqa_locations(candidates=candidate_locations, mappings=suppression_mappings);
let suppression_parents = select id, file, line from candidate_locations where id != id;
let suppression_matches = suppression_edges(candidates=candidate_locations, locations=suppression_locations, additional_locations=suppression_parents, codes="^(?:F821)$");
let suppression_candidates = select id, file, span from suppression_locations;
let violations = antijoin(left=suppression_candidates, right=suppression_matches, left-on=[id, span], right-on=[id, span]);
let matched_directives = select directive, file from suppression_matches where scope < 2;
let noqa_matches = extend(from=matched_directives, values={code: "F821"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
