import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
let nodes = select id, kind, file from "semantic-syntax";
let children = select parent, child, field, ordinal, file from "semantic-child";
let binary_nodes = select id, file from nodes where kind = "bin-op";
let pipe_tokens = select id, file from "semantic-syntax" where text = "|";
let pipe_ops = select l.parent as id, l.file as file from children as l join pipe_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let binary_unions = select l.id as id, l.file as file from binary_nodes as l join pipe_ops as r on l.id = r.id and l.file = r.file;
let binary_edges = select l.id as source, r.child as destination, r.child as edge, r.ordinal as position, l.file as file from binary_unions as l join children as r on l.id = r.parent and l.file = r.file where r.field = "left" or r.field = "right";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select l.id as subscript, r.child as value, r.ordinal as position, l.file as file from subscripts as l join children as r on l.id = r.parent and l.file = r.file where r.field = "value";
let union_names = select id, file from "qualified-name" where path = "typing.Union" or path = "typing_extensions.Union" or path = "_typeshed.Union";
let optional_names = select id, file from "qualified-name" where path = "typing.Optional" or path = "typing_extensions.Optional" or path = "_typeshed.Optional";
let typed_unions = select l.subscript as id, l.file as file from values as l join union_names as r on l.value = r.id and l.file = r.file;
let optionals = select l.subscript as id, l.file as file from values as l join optional_names as r on l.value = r.id and l.file = r.file;
let slices = select parent as subscript, child as slice, ordinal as position, file from children where field = "slice";
let union_slices = select l.id as source, r.slice as slice, r.position as position, l.file as file from typed_unions as l join slices as r on l.id = r.subscript and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.source as source, l.slice as slice, l.file as file from union_slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_edges = select l.source as source, r.child as destination, r.child as edge, r.ordinal as position, l.file as file from tuple_slices as l join children as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let scalar_slices = antijoin(left=union_slices, right=tuples, left-on=["slice","file"], right-on=["id","file"]);
let scalar_edges = select source, slice as destination, slice as edge, position, file from scalar_slices;
let optional_value_edges = select l.id as source, r.value as destination, r.value as edge, r.position as position, l.file as file from optionals as l join values as r on l.id = r.subscript and l.file = r.file;
let optional_slice_edges = select l.id as source, r.slice as destination, r.slice as edge, r.position as position, l.file as file from optionals as l join slices as r on l.id = r.subscript and l.file = r.file;
let typed_edges = union(left=tuple_edges, right=scalar_edges);
let optional_edges = union(left=optional_value_edges, right=optional_slice_edges);
let edges_a = union(left=binary_edges, right=typed_edges);
let edges = union(left=edges_a, right=optional_edges);
let union_containers = union(left=binary_unions, right=typed_unions);
let containers = union(left=union_containers, right=optionals);
let contexts = type_context(expressions=containers);
let typed_binary_roots = select l.id as id, l.file as file from binary_unions as l join contexts as r on l.id = r.id and l.file = r.file where r.kind = "type";
let subscript_roots = union(left=typed_unions, right=optionals);
let visited_typed_roots = select l.id as id, l.file as file from subscript_roots as l join contexts as r on l.id = r.id and l.file = r.file;
let possible_roots = union(left=typed_binary_roots, right=visited_typed_roots);
let nested_roots = select destination as id, file from edges;
let selected_roots = antijoin(left=possible_roots, right=nested_roots, left-on=["id","file"], right-on=["id","file"]);
let roots = select id as root, file from selected_roots;
let visits = ordered-dfs(from=roots, root="root", edges=edges, source="source", destination="destination", order="position", edge="edge", keys=["file"], output="visit");
let leaves = antijoin(left=visits, right=containers, left-on=["destination","file"], right-on=["id","file"]);
let constants = select id, file from nodes where kind = "constant";
let null_constants = select l.id as id, l.file as file from "literal-properties" as l join constants as r on l.id = r.id and l.file = r.file where l.kind = "null";
let null_nodes = union(left=null_constants, right=optional_names);
let null_members = select l.root as root, l.destination as id, l.visit as visit, l.file as file from leaves as l join null_nodes as r on l.destination = r.id and l.file = r.file;
let ordinary_members = antijoin(left=leaves, right=null_nodes, left-on=["destination","file"], right-on=["id","file"]);
let shaped_members = select l.root as root, l.destination as id, l.visit as visit, l.file as file, r.shape as shape from ordinary_members as l join "expression-shape" as r on l.destination = r.id and l.file = r.file;
let duplicate_ordinary = select l.id as id, l.file as file from shaped_members as l join shaped_members as r on l.root = r.root and l.shape = r.shape and l.file = r.file where r.visit < l.visit;
let duplicate_nulls = select l.id as id, l.file as file from null_members as l join null_members as r on l.root = r.root and l.file = r.file where r.visit < l.visit;
let duplicate_ids = union(left=duplicate_ordinary, right=duplicate_nulls);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from duplicate_ids as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PYI016(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PYI016)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PYI016(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PYI016)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI016"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
