import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let logging_functions = select id from "qualified-name" where matches(path, "^logging\.(?:Logger\.)?(?:debug|info|warn|warning|error|critical|exception|log)$");
let direct_logging_calls = select l.call as call from call_functions as l join logging_functions as r on l.function = r.id;
let attribute_fields = select parent, child from "semantic-child" where field = "attr";
let identifiers = select id, name from "identifier";
let logger_method_nodes = select l.parent as function from attribute_fields as l join identifiers as r on l.child = r.id where r.name = "debug" or r.name = "info" or r.name = "warn" or r.name = "warning" or r.name = "error" or r.name = "critical" or r.name = "exception" or r.name = "log";
let logger_attribute_calls = select l.call as call, l.function as function from call_functions as l join logger_method_nodes as r on l.function = r.function;
let receiver_fields = select parent, child from "semantic-child" where field = "value";
let receiver_names = select l.call as call, r.child as reference from logger_attribute_calls as l join receiver_fields as r on l.function = r.parent;
let attribute_receiver_ids = select parent as reference, child as identifier from attribute_fields;
let name_receiver_names = select l.call as call, r.name as name from receiver_names as l join identifiers as r on l.reference = r.id;
let attribute_receiver_label_ids = select l.call as call, r.identifier as identifier from receiver_names as l join attribute_receiver_ids as r on l.reference = r.reference;
let attribute_receiver_names = select l.call as call, r.name as name from attribute_receiver_label_ids as l join identifiers as r on l.identifier = r.id;
let receiver_namespaces = union(left=name_receiver_names, right=attribute_receiver_names);
let heuristic_logger_calls = select call from receiver_namespaces where matches(name, "(?:^log|logger$|logging$|^LOG|LOGGER$|LOGGING$)");
let logging_calls = union(left=direct_logging_calls, right=heuristic_logger_calls);
let argument_edges = select parent, child from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as wrapper from argument_edges as l join argument_nodes as r on l.child = r.id;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keyword_edges = select l.call as call, r.child as keyword from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let call_keywords = select l.call as call, l.keyword as keyword from call_keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let keyword_arg_edges = select parent as keyword, child as identifier from "semantic-child" where field = "arg";
let keyword_arg_names = select l.keyword as keyword, r.name as name from keyword_arg_edges as l join identifiers as r on l.identifier = r.id;
let extra_keywords = select keyword from keyword_arg_names where name = "extra";
let call_extra_keywords = select l.call as call, l.keyword as keyword from call_keywords as l join extra_keywords as r on l.keyword = r.keyword;
let keyword_value_edges = select parent as keyword, child as value from "semantic-child" where field = "value";
let extra_values = select l.call as call, l.keyword as keyword, r.value as value from call_extra_keywords as l join keyword_value_edges as r on l.keyword = r.keyword;
let selected_extra_values = select l.call as call, l.keyword as keyword, l.value as value from extra_values as l join logging_calls as r on l.call = r.call;
let dictionaries = select id, file from "semantic-syntax" where kind = "dict";
let dict_extras = select l.call as call, l.keyword as keyword, l.value as dictionary from selected_extra_values as l join dictionaries as r on l.value = r.id;
let dict_key_edges = select parent as dictionary, child as key from "semantic-child" where field = "keys";
let dict_keys = select l.call as call, l.keyword as keyword, r.key as key from dict_extras as l join dict_key_edges as r on l.dictionary = r.dictionary;
let strings = select occurrence, value from "string-literal";
let literal_keys = select l.call as call, l.keyword as keyword, l.key as key, r.value as value from dict_keys as l join strings as r on l.key = r.occurrence;
let reserved = select * from literal_keys where value = "args" or value = "asctime" or value = "created" or value = "exc_info" or value = "exc_text" or value = "filename" or value = "funcName" or value = "levelname" or value = "levelno" or value = "lineno" or value = "module" or value = "msecs" or value = "message" or value = "msg" or value = "name" or value = "pathname" or value = "process" or value = "processName" or value = "relativeCreated" or value = "stack_info" or value = "thread" or value = "threadName";
let key_locations = select l.key as id, r.file as file, r.span as span from reserved as l join "semantic-syntax" as r on l.key = r.id;
let dict_call_extras = select l.call as call, l.keyword as keyword, r.id as dictionary_call from selected_extra_values as l join calls as r on l.value = r.id;
let dict_call_functions = select l.dictionary_call as dictionary_call, r.child as function from dict_call_extras as l join function_fields as r on l.dictionary_call = r.parent;
let builtin_dict_names = select id from "qualified-name" where path = "builtins.dict";
let builtin_dict_calls = select l.dictionary_call as dictionary_call from dict_call_functions as l join builtin_dict_names as r on l.function = r.id;
let dict_call_wrappers = select l.dictionary_call as dictionary_call, r.wrapper as wrapper from dict_call_extras as l join call_arguments as r on l.dictionary_call = r.call;
let dict_call_keyword_edges = select l.dictionary_call as dictionary_call, r.child as keyword from dict_call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let dict_call_keywords = select l.dictionary_call as dictionary_call, l.keyword as keyword from dict_call_keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let dict_kwarg_names = select l.keyword as keyword, r.name as name from keyword_arg_edges as l join identifiers as r on l.identifier = r.id;
let reserved_dict_keywords = select l.dictionary_call as dictionary_call, l.keyword as keyword from dict_call_keywords as l join dict_kwarg_names as r on l.keyword = r.keyword where r.name = "args" or r.name = "asctime" or r.name = "created" or r.name = "exc_info" or r.name = "exc_text" or r.name = "filename" or r.name = "funcName" or r.name = "levelname" or r.name = "levelno" or r.name = "lineno" or r.name = "module" or r.name = "msecs" or r.name = "message" or r.name = "msg" or r.name = "name" or r.name = "pathname" or r.name = "process" or r.name = "processName" or r.name = "relativeCreated" or r.name = "stack_info" or r.name = "thread" or r.name = "threadName";
let valid_dict_call_keywords = select l.dictionary_call as dictionary_call, l.keyword as keyword from dict_call_keywords as l join builtin_dict_calls as r on l.dictionary_call = r.dictionary_call;
let reserved_dict_call_candidates = select l.keyword as id from valid_dict_call_keywords as l join reserved_dict_keywords as k on l.dictionary_call = k.dictionary_call and l.keyword = k.keyword;
let dict_call_candidates = select l.id as id, r.file as file, r.span as span from reserved_dict_call_candidates as l join "semantic-syntax" as r on l.id = r.id;
let all_candidates = union(left=key_locations, right=dict_call_candidates);
let reportable = select id, file, span from all_candidates;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*G101(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:G101)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*G101(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:G101)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "G101"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
