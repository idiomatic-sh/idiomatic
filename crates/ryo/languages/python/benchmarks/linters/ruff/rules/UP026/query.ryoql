import observation_matches from "python/ruff/suppress-unmapped-matches";
import line_located from "python/ruff/candidate-locations";
let imports = select occurrence as alias, target, file from "static-import";
let aliases = select parent as statement, child as alias from "semantic-child" where field = "names";
let import_statements = select id, kind, file, span from "semantic-syntax" where kind = "import" or kind = "import-from";
let alias_statements = select l.statement as statement, l.alias as alias, r.kind as kind, r.file as file from aliases as l join import_statements as r on l.statement = r.id;
let imported_aliases = select l.statement as statement, l.alias as alias, l.kind as kind, l.file as file, r.target as target from alias_statements as l join imports as r on l.alias = r.alias and l.file = r.file;
let direct_imports = select l.alias as id, l.file as file, r.span as span from imported_aliases as l join "semantic-syntax" as r on l.alias = r.id and l.file = r.file where l.kind = "import" and (l.target = "mock" or l.target = "mock.mock");
let module_fields = select parent as statement, child as module, file from "semantic-child" where field = "module";
let mock_modules = select id, file from "identifier" where name = "mock";
let mock_from_statements = select l.statement as id, l.file as file from module_fields as l join mock_modules as r on l.module = r.id and l.file = r.file;
let from_imports = select l.id as id, l.file as file, r.span as span from mock_from_statements as l join import_statements as r on l.id = r.id and l.file = r.file where r.kind = "import-from";
let level_fields = select parent as statement, file from "semantic-child" where field = "level";
let absolute_from_imports = antijoin(left=from_imports,right=level_fields,left-on=["id", "file"],right-on=["statement", "file"]);
let static_mock_aliases = select occurrence as alias, file from "static-import" where matches(target, "^mock(?:\.|$)");
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let attribute_value_fields = select parent as attribute, child as base from "semantic-child" where field = "value";
let attribute_base_names = select l.attribute as attribute, r.id as name, r.file as file from attribute_value_fields as l join name_nodes as r on l.base = r.id;
let named_base_attributes = select l.attribute as attribute, l.file as file from attribute_base_names as l join "identifier" as r on l.name = r.id and l.file = r.file where r.name = "mock";
let attr_fields = select parent as attribute, child as attr from "semantic-child" where field = "attr";
let mock_attr_names = select l.attribute as attribute, r.file as file from attr_fields as l join mock_modules as r on l.attr = r.id;
let mock_mock_attributes = select l.attribute as attribute, l.file as file from named_base_attributes as l join mock_attr_names as r on l.attribute = r.attribute and l.file = r.file;
let base_reads = select l.attribute as attribute, l.name as name, l.file as file from attribute_base_names as l join mock_mock_attributes as r on l.attribute = r.attribute and l.file = r.file;
let read_events = select occurrence, ordinal, file from "binding-event" where kind = "read";
let dated_reads = select l.attribute as attribute, l.file as file, r.ordinal as ordinal from base_reads as l join read_events as r on l.name = r.occurrence and l.file = r.file;
let bind_events = select occurrence, ordinal, file from "binding-event" where kind = "bind";
let mock_import_events = select l.alias as alias, l.file as file, r.ordinal as ordinal from static_mock_aliases as l join bind_events as r on l.alias = r.occurrence and l.file = r.file;
let first_mock = group-min(from=mock_import_events,keys=[file],order="ordinal");
let imported_before = select l.attribute as id,l.file as file from dated_reads as l join first_mock as r on l.file=r.file where r.ordinal<l.ordinal;
let reportable_mock_attributes = select id, file from imported_before;
let attribute_reports = select l.id as id, l.file as file, r.span as span from reportable_mock_attributes as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let import_reports = union(left=direct_imports,right=absolute_from_imports);
let reportable = union(left=import_reports,right=attribute_reports);
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="UP026");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","UP026") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
