import observation_matches from "python/ruff/suppress-unmapped-matches";
let imports = select occurrence as alias, target, file from "static-import";
let aliases = select parent as statement, child as alias from "semantic-child" where field = "names";
let import_statements = select id, kind, file, span from "semantic-syntax" where kind = "import" or kind = "import-from";
let alias_statements = select l.statement as statement, l.alias as alias, r.kind as kind, r.file as file from aliases as l join import_statements as r on l.statement = r.id;
let imported_aliases = select l.statement as statement, l.alias as alias, l.kind as kind, l.file as file, r.target as target from alias_statements as l join imports as r on l.alias = r.alias and l.file = r.file;
let direct_imports = select l.alias as id, l.file as file, r.span as span from imported_aliases as l join "semantic-syntax" as r on l.alias = r.id and l.file = r.file where l.kind = "import" and (l.target = "mock" or l.target = "mock.mock");
let from_import_targets = select * from imported_aliases where kind = "import-from" and matches(target, "^mock\.");
let from_imports = select l.statement as id, l.file as file, r.span as span from from_import_targets as l join import_statements as r on l.statement = r.id and l.file = r.file;
let level_fields = select parent as statement, file from "semantic-child" where field = "level";
let relative_from_imports = select l.statement as id, l.file as file from imported_aliases as l join level_fields as r on l.statement = r.statement and l.file = r.file where l.kind = "import-from";
let from_statement_counts = group-count(from=from_imports, keys=["id", "file"], count="count", distinct="id");
let unique_from_statements = select l.id as id, l.file as file, r.span as span from from_statement_counts as l join import_statements as r on l.id = r.id and l.file = r.file;
let absolute_from_imports = antijoin(left=unique_from_statements,right=relative_from_imports,left-on=["id", "file"],right-on=["id", "file"]);
let static_mock_aliases = select occurrence as alias, file from "static-import" where matches(target, "^mock(?:\.|$)");
let imported_mock_modules = select l.alias as alias, r.file as file from aliases as l join static_mock_aliases as r on l.alias = r.alias;
let imported_mock_files = group-count(from=imported_mock_modules, keys=["file"], count="count", distinct="alias");
let qualified_mock_mock = select id, file from "qualified-name" where path = "mock.mock";
let mock_mock_values = select l.id as id, l.file as file from qualified_mock_mock as l join imported_mock_files as r on l.file = r.file;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let attribute_value_fields = select parent as attribute, child as base from "semantic-child" where field = "value";
let attribute_base_names = select l.attribute as attribute, r.id as name, r.file as file from attribute_value_fields as l join name_nodes as r on l.base = r.id;
let named_base_attributes = select l.attribute as attribute, l.file as file from attribute_base_names as l join "identifier" as r on l.name = r.id and l.file = r.file where r.name = "mock";
let reportable_mock_attributes = select l.id as id, l.file as file from mock_mock_values as l join named_base_attributes as r on l.id = r.attribute and l.file = r.file;
let attribute_reports = select l.id as id, l.file as file, r.span as span from reportable_mock_attributes as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let import_reports = union(left=direct_imports,right=absolute_from_imports);
let reportable = union(left=import_reports,right=attribute_reports);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:UP026)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP026"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
