import suppress from "python/ruff/suppress";
let strings = select id, file, span from "syntax-tree" where kind = "string" or kind = "fstring-middle" or kind = "tstring-middle";
let token_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as base_line from strings as l join "source-location" as r on l.id = r.id and l.file = r.file;
let occurrences = source-matches(from=token_locations, span="span", base-line="base_line", pattern="\x00", output="occurrence", line-output="line");
let candidates = select id, file, occurrence as span, line from occurrences;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE2514(?:$|[^A-Z0-9])", range-pattern="(?:^|,)PLE2514(?:,|$)");
emit violations subject file key(id, span);
