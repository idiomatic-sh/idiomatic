import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let strings = select id, file, span from "syntax-tree" where kind = "string" or kind = "fstring-middle" or kind = "tstring-middle";
let token_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as base_line from strings as l join "source-location" as r on l.id = r.id and l.file = r.file;
let occurrences = source-matches(from=token_locations, span="span", base-line="base_line", pattern="\x00", output="occurrence", line-output="line");
let candidates = select id, file, occurrence as span, line from occurrences;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE2514(?:$|[^A-Z0-9])", range-pattern="(?:^|,)PLE2514(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLE2514)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLE2514)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE2514"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id, span);
