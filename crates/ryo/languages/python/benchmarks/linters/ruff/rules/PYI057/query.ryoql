import observation_matches from "python/ruff/suppress-matches";
let imports = select occurrence as id, target, file, span from "static-import" where target = "typing.ByteString" or target = "collections.abc.ByteString";
let attributes = select id, path, file, span from "qualified-name" where path = "typing.ByteString" or path = "collections.abc.ByteString";
let attribute_nodes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_rows = select l.id as id, l.file as file, l.span as span from attributes as l join attribute_nodes as r on l.id = r.id and l.file = r.file;
let import_rows = select id, file, span from imports;
let locations = union(left=import_rows, right=attribute_rows);
let with_line = select l.id as id, l.file as file, l.span as span, r."start-line" as line from locations as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=with_line, code="PYI057");
let violations = antijoin(left=locations, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PYI057") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
