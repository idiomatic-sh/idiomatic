import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let timeout_names = select id, file, span from "qualified-name" where path = "socket.timeout" and provenance = "import";
let call_nodes = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join call_nodes as r on l.parent = r.id;
let called_timeout = select l.function as id, l.file as file from call_functions as l join timeout_names as r on l.function = r.id and l.file = r.file;
let raise_nodes = select id, file from "semantic-syntax" where kind = "raise";
let exception_fields = select parent, child from "semantic-child" where field = "exc";
let raised_timeout = select l.child as id, r.file as file from exception_fields as l join raise_nodes as r on l.parent = r.id;
let direct_raises = select l.id as id, l.file as file from raised_timeout as l join timeout_names as r on l.id = r.id and l.file = r.file;
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let type_fields = select parent, child from "semantic-child" where field = "type";
let handler_types = select l.parent as handler, l.child as type, r.file as file from type_fields as l join handlers as r on l.parent = r.id;
let direct_handler_types = select l.type as id, l.file as file from handler_types as l join timeout_names as r on l.type = r.id and l.file = r.file;
let tuple_nodes = select id, file, span from "semantic-syntax" where kind = "tuple";
let handler_tuple_roots = select l.handler as handler, l.type as tuple, l.file as file from handler_types as l join tuple_nodes as r on l.type = r.id and l.file = r.file;
let element_fields = select parent, child from "semantic-child" where field = "elts";
let tuple_elements = select l.parent as tuple, l.child as element, r.file as file from element_fields as l join handler_tuple_roots as r on l.parent = r.tuple;
let timeout_tuple_elements = select l.tuple as id, l.file as file, r.id as timeout from tuple_elements as l join timeout_names as r on l.element = r.id and l.file = r.file;
let tuple_counts = group-count(from=timeout_tuple_elements, keys=["id", "file"], count="count", distinct="timeout");
let tuple_reports = select l.id as id, l.file as file from tuple_counts as l join tuple_nodes as r on l.id = r.id and l.file = r.file;
let direct_reports = union(left=called_timeout,right=direct_raises);
let handler_reports = union(left=direct_handler_types,right=tuple_reports);
let all_reports = union(left=direct_reports,right=handler_reports);
let reportable = select l.id as id, l.file as file, r.span as span from all_reports as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:UP041)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP041"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
