import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let calls = select id, file from nodes where kind = "call";
let funcs = select l.id as call, r.child as func, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "func";
let origins = select l.call as call, l.func as func, r.path as path, l.file as file from funcs as l join "qualified-name" as r on l.func = r.id and l.file = r.file;
let direct = select call, func, file from origins where path = "builtins.open" or path = "bz2.open" or path = "codecs.open" or path = "dbm.open" or path = "gzip.open" or path = "tarfile.open" or path = "shelve.open" or path = "tokenize.open" or path = "wave.open" or path = "dbm.gnu.open" or path = "dbm.ndbm.open" or path = "dbm.dumb.open" or path = "dbm.sqlite3.open" or path = "io.open" or path = "lzma.open" or path = "fileinput.FileInput" or path = "fileinput.input" or path = "io.open_code" or path = "lzma.LZMAFile" or path = "tarfile.TarFile.taropen" or path = "tempfile.TemporaryFile" or path = "tempfile.NamedTemporaryFile" or path = "tempfile.SpooledTemporaryFile";
let attrs = select id, file from nodes where kind = "attribute";
let attr_labels = select l.id as attr, r.child as label, l.file as file from attrs as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let named_attrs = select l.attr as attr, r.name as name, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file;
let attr_values = select l.attr as attr, l.name as name, r.child as value, l.file as file from named_attrs as l join edges as r on l.attr = r.parent and l.file = r.file where r.field = "value";
let called_attrs = select l.call as call, l.func as func, r.value as value, r.name as name, l.file as file from funcs as l join attr_values as r on l.func = r.attr and l.file = r.file;
let constructor_methods = select l.call as call, l.func as func, l.name as name, r.path as path, l.file as file from called_attrs as l join origins as r on l.value = r.call and l.file = r.file;
let constructed = select call, func, file from constructor_methods where (name = "open" and (path = "pathlib.Path" or path = "zipfile.ZipFile" or path = "lzma.LZMAFile")) or (path = "tarfile.TarFile" and (name = "open" or name = "taropen" or name = "gzopen" or name = "bz2open" or name = "xzopen"));
let opened = union(left=direct, right=constructed);
let open_nodes = select call as id, file from opened;
let statements = select id, kind, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "return" or kind = "delete" or kind = "assign" or kind = "type-alias" or kind = "aug-assign" or kind = "ann-assign" or kind = "for" or kind = "async-for" or kind = "while" or kind = "if" or kind = "with" or kind = "async-with" or kind = "match" or kind = "raise" or kind = "try" or kind = "try-star" or kind = "assert" or kind = "import" or kind = "import-from" or kind = "global" or kind = "nonlocal" or kind = "expr" or kind = "pass" or kind = "break" or kind = "continue";
let nearest_statements = axis(from=open_nodes, relation="semantic-child", direction=nearest-ancestor, domain=statements);
let statement_kinds = select l.id as call, r.kind as kind, l.file as file from nearest_statements as l join statements as r on l.related = r.id and l.file = r.file;
let excluded_statements = select call, file from statement_kinds where kind = "return" or kind = "with" or kind = "async-with";
let arguments = select call, expression, file from "call-argument";
let nonempty_calls = select call, file from arguments;
let empty_calls = antijoin(left=calls, right=nonempty_calls, left-on=["id", "file"], right-on=["call", "file"]);
let closing = select l.value as call, l.file as file from called_attrs as l join empty_calls as r on l.call = r.id and l.file = r.file where l.name = "close";
let expressions = select id, kind, file from nodes where kind = "bool-op" or kind = "named-expr" or kind = "bin-op" or kind = "unary-op" or kind = "lambda" or kind = "if-exp" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp" or kind = "await" or kind = "yield" or kind = "yield-from" or kind = "compare" or kind = "call" or kind = "formatted-value" or kind = "joined-str" or kind = "template-str" or kind = "constant" or kind = "attribute" or kind = "subscript" or kind = "starred" or kind = "name" or kind = "list" or kind = "tuple" or kind = "slice";
let parent_expressions = axis(from=open_nodes, relation="semantic-child", direction=nearest-ancestor, domain=expressions);
let parent_calls = select l.id as opened, r.call as enclosing, r.value as receiver, r.name as name, l.file as file from parent_expressions as l join called_attrs as r on l.related = r.call and l.file = r.file;
let named_receivers = select l.opened as call, l.name as name, r.name as receiver, l.file as file from parent_calls as l join "identifier" as r on l.receiver = r.id and l.file = r.file;
let unittest_contexts = select call, file from named_receivers where (receiver = "cls" and name = "enterClassContext") or (receiver = "self" and (name = "enterContext" or name = "enterAsyncContext"));
let withs = select id, file from nodes where kind = "with" or kind = "async-with";
let with_items = select l.id as owner, r.child as item, l.file as file from withs as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "items";
let contexts = select l.owner as owner, r.child as context, l.file as file from with_items as l join edges as r on l.item = r.parent and l.file = r.file where r.field = "context-expr";
let stack_withs = select l.owner as id, r.path as path, l.file as file from contexts as l join origins as r on l.context = r.call and l.file = r.file where r.path = "contextlib.ExitStack" or r.path = "contextlib.AsyncExitStack";
let ancestor_stacks = axis(from=open_nodes, relation="semantic-child", direction=ancestor, domain=stack_withs);
let stack_kinds = select l.id as call, r.path as path, l.file as file from ancestor_stacks as l join stack_withs as r on l.related = r.id and l.file = r.file;
let sync_stacks = select l.opened as call, l.file as file from parent_calls as l join stack_kinds as r on l.opened = r.call and l.file = r.file where l.name = "enter_context" and r.path = "contextlib.ExitStack";
let awaits = select id, file from nodes where kind = "await";
let await_values = select l.id as awaited, r.child as value, l.file as file from awaits as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "value";
let awaited_contexts = select l.opened as call, l.file as file from parent_calls as l join await_values as r on l.enclosing = r.value and l.file = r.file where l.name = "enter_async_context";
let async_stacks = select l.call as call, l.file as file from awaited_contexts as l join stack_kinds as r on l.call = r.call and l.file = r.file where r.path = "contextlib.AsyncExitStack";
let scopes = select child as id, file from "scope";
let nearest_scopes = axis(from=open_nodes, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let function_names = select l.id as id, r.child as label, l.file as file from nodes as l join edges as r on l.id = r.parent and l.file = r.file where (l.kind = "function-def" or l.kind = "async-function-def") and r.field = "name";
let enter_functions = select l.id as id, l.file as file from function_names as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "__enter__";
let scoped_enter_calls = select l.id as call, l.file as file from nearest_scopes as l join enter_functions as r on l.related = r.id and l.file = r.file;
let enter_bodies = select r.child as id, l.file as file from enter_functions as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body";
let within_enter_bodies = axis(from=open_nodes, relation="semantic-child", direction=ancestor, domain=enter_bodies);
let enter_calls = select l.call as call, l.file as file from scoped_enter_calls as l join within_enter_bodies as r on l.call = r.id and l.file = r.file;
let excluded0 = union(left=excluded_statements, right=closing);
let excluded1 = union(left=excluded0, right=unittest_contexts);
let excluded2 = union(left=excluded1, right=sync_stacks);
let excluded3 = union(left=excluded2, right=async_stacks);
let excluded4 = union(left=excluded3, right=enter_calls);
let reportable = antijoin(left=opened, right=excluded4, left-on=["call", "file"], right-on=["call", "file"]);
let candidates = select l.call as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.func = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])SIM115(?:$|[^A-Z0-9])", range-pattern="(?:^|,)SIM115(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM115)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM115)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM115"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
