import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_fields as l join calls as r on l.parent = r.id;
let logging_function_names = select id, file from "qualified-name" where path = "logging.debug" or path = "logging.critical" or path = "logging.error" or path = "logging.exception" or path = "logging.info" or path = "logging.warn" or path = "logging.warning";
let qname_logging_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join logging_function_names as r on l.function = r.id and l.file = r.file;
let attribute_functions = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_value_fields = select parent, child from "semantic-child" where field = "value";
let attribute_receivers = select l.id as attribute, l.file as file, r.child as receiver from attribute_functions as l join attribute_value_fields as r on l.id = r.parent;
let receiver_names = select r.id as id, r.name as name, r.file as file from "identifier" as r;
let receiver_name_tokens = select r.child as id, l.name as name, r.file as file from receiver_names as l join "semantic-child" as r on l.id = r.parent;
let receiver_name_nodes = select l.id as id, l.file as file, r.name as name from "semantic-syntax" as l join receiver_name_tokens as r on l.id = r.id and l.file = r.file where l.kind = "name-token";
let receiver_name_fields = select parent, child from "semantic-child" where field = "id";
let receiver_name_roots = select l.receiver as id, r.child as token, l.file as file from attribute_receivers as l join receiver_name_fields as r on l.receiver = r.parent;
let name_receiver_rows = select l.id as id, r.name as name, l.file as file from receiver_name_roots as l join receiver_name_nodes as r on l.token = r.id and l.file = r.file;
let receiver_attributes = select l.receiver as receiver, l.file as file from attribute_receivers as l join attribute_functions as r on l.receiver = r.id and l.file = r.file;
let receiver_attr_fields = select parent, child from "semantic-child" where field = "attr";
let receiver_attr_identifiers = select l.receiver as receiver, l.file as file, r.child as identifier from receiver_attributes as l join receiver_attr_fields as r on l.receiver = r.parent;
let receiver_attr_tokens = select l.receiver as receiver, l.file as file, r.child as token from receiver_attr_identifiers as l join "semantic-child" as r on l.identifier = r.parent;
let attr_receiver_names = select l.receiver as id, l.file as file, r.name as name from receiver_attr_tokens as l join receiver_name_nodes as r on l.token = r.id and l.file = r.file;
let all_receiver_names = union(left=name_receiver_rows, right=attr_receiver_names);
let common_logger_receivers = select l.attribute as attribute, l.file as file from attribute_receivers as l join all_receiver_names as r on l.receiver = r.id and l.file = r.file where matches(r.name, "(?:^log|logger$|logging$|^LOG|LOGGER$|LOGGING$)");
let qualified_receivers = select id, file from "qualified-name" where provenance = "import" or provenance = "builtin";
let qualified_attribute_receivers = select l.attribute as attribute, l.file as file from attribute_receivers as l join qualified_receivers as r on l.receiver = r.id and l.file = r.file;
let named_common_logger_receivers = antijoin(left=common_logger_receivers, right=qualified_attribute_receivers, left-on=["attribute", "file"], right-on=["attribute", "file"]);
let receiver_calls = select l.attribute as attribute, l.file as file, r.id as receiver_call from attribute_receivers as l join calls as r on l.receiver = r.id and l.file = r.file;
let receiver_call_functions = select l.attribute as attribute, l.file as file, r.child as function from receiver_calls as l join function_fields as r on l.receiver_call = r.parent;
let getlogger_functions = select id, file from "qualified-name" where path = "logging.getLogger" or path = "logging.Logger";
let inline_logger_receivers = select l.attribute as attribute, l.file as file from receiver_call_functions as l join getlogger_functions as r on l.function = r.id and l.file = r.file;
let module_logger_receivers = select l.attribute as attribute, l.file as file from attribute_receivers as l join "qualified-name" as r on l.receiver = r.id and l.file = r.file where r.path = "logging" or r.path = "flask.current_app.logger";
let acceptable_attribute_receivers_a = union(left=named_common_logger_receivers, right=inline_logger_receivers);
let acceptable_attribute_receivers_b = union(left=acceptable_attribute_receivers_a, right=module_logger_receivers);
let method_tokens = select id, file, text from "syntax-tree" where text = "debug" or text = "critical" or text = "error" or text = "exception" or text = "info" or text = "warn" or text = "warning";
let attribute_ranges = select l.attribute as attribute, l.file as file, r."end-byte" as end_byte from attribute_receivers as l join "source-location" as r on l.attribute = r.id and l.file = r.file;
let receiver_ranges = select l.attribute as attribute, l.file as file, r."end-byte" as end_byte from attribute_receivers as l join "source-location" as r on l.receiver = r.id and l.file = r.file;
let receiver_and_attribute_ranges = select l.attribute as attribute, l.file as file, l.end_byte as receiver_end, r.end_byte as attribute_end from receiver_ranges as l join attribute_ranges as r on l.attribute = r.attribute and l.file = r.file;
let method_token_ranges = select l.id as token, l.text as text, r.file as file, r."start-byte" as start_byte, r."end-byte" as end_byte from method_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let valid_method_tokens = select l.attribute as attribute, l.file as file from receiver_and_attribute_ranges as l join method_token_ranges as r on l.file = r.file where r.start_byte > l.receiver_end and r.end_byte <= l.attribute_end;
let accepted_attributes = select l.attribute as attribute, l.file as file from acceptable_attribute_receivers_b as l join valid_method_tokens as r on l.attribute = r.attribute and l.file = r.file;
let accepted_attribute_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join accepted_attributes as r on l.function = r.attribute and l.file = r.file;
let logging_calls_a = union(left=qname_logging_calls, right=accepted_attribute_calls);
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_argument_wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from call_argument_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let positional_counts = group-count(from=positional_arguments, keys=["call", "file"], count="total_positional", distinct="argument");
let positional_starred = select l.call as call, l.file as file from positional_arguments as l join "semantic-syntax" as r on l.argument = r.id and l.file = r.file where r.kind = "starred";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_arguments = select l.call as call, r.child as keyword, l.file as file from call_argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_names = select parent as keyword, child as name_node from "semantic-child" where field = "arg";
let keyword_spreads = antijoin(left=keyword_arguments, right=keyword_names, left-on=["keyword"], right-on=["keyword"]);
let keyword_spread_calls = select call, file from keyword_spreads;
let any_keyword_calls = select call, file from keyword_arguments;
let first_arguments = select call, argument, file from positional_arguments;
let first_arg_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from first_arguments as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let earlier_arg_pairs = select l.call as call, l.argument as later_argument, r.argument as earlier_argument, l.file as file from first_arg_locations as l join first_arg_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let args_with_prior = select l.call as call, l.later_argument as argument, l.file as file from earlier_arg_pairs as l;
let first_positional_arguments = antijoin(left=first_arguments, right=args_with_prior, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let first_string_arguments = select l.call as call, l.argument as format_id, l.file as file from first_positional_arguments as l join "string-literal" as r on l.argument = r.occurrence and l.file = r.file;
let logging_parse_rows = select p.id as id, p.file as file, p.outcome as outcome, p."positional-consumption" as positional_consumption, p."dynamic-width" as dynamic_width, p."dynamic-precision" as dynamic_precision from "format-parse" as p where p.dialect = "percent-string" and p.representation = "decoded-string";
let logging_parsed_formats = select l.call as call, l.file as file, l.format_id as format_id, r.positional_consumption as positional_consumption, r.dynamic_width as dynamic_width, r.dynamic_precision as dynamic_precision from first_string_arguments as l join logging_parse_rows as r on l.format_id = r.id and l.file = r.file where r.outcome = "parsed";
let logging_mapping_fields = select f.id as format_id, f.file as file from "format-field" as f where f."argument-kind" = "mapping";
let logging_mapping_formats = select l.call as call, l.file as file from logging_parsed_formats as l join logging_mapping_fields as r on l.format_id = r.format_id and l.file = r.file;
let logging_star_fields = select f.id as format_id, f.file as file from "format-field" as f where f."width-mode" = "star" or f."precision-mode" = "star";
let logging_dynamic_formats = select l.call as call, l.file as file from logging_parsed_formats as l join logging_star_fields as r on l.format_id = r.format_id and l.file = r.file;
let invalid_logger_calls_a = union(left=positional_starred, right=keyword_spread_calls);
let invalid_logger_calls_b = union(left=invalid_logger_calls_a, right=logging_mapping_formats);
let invalid_logger_calls = union(left=invalid_logger_calls_b, right=logging_dynamic_formats);
let checked_logging_calls = antijoin(left=logging_calls_a, right=invalid_logger_calls, left-on=["call", "file"], right-on=["call", "file"]);
let checked_logging_formats = select l.call as call, l.file as file, l.positional_consumption as positional_consumption from logging_parsed_formats as l join checked_logging_calls as r on l.call = r.call and l.file = r.file;
let remaining_call_arguments = antijoin(left=positional_arguments, right=first_string_arguments, left-on=["call", "argument", "file"], right-on=["call", "format_id", "file"]);
let remaining_argument_counts = group-count(from=remaining_call_arguments, keys=["call", "file"], count="provided_count", distinct="argument");
let calls_with_keywords = select call, file from any_keyword_calls;
let no_keyword_calls = antijoin(left=checked_logging_formats, right=calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let no_remaining_arguments = antijoin(left=no_keyword_calls, right=remaining_argument_counts, left-on=["call", "file"], right-on=["call", "file"]);
let no_remaining_call_rows = select call, file from no_remaining_arguments;
let zero_remaining_counts = extend(from=no_remaining_call_rows, values={provided_count: 0});
let all_remaining_counts = union(left=remaining_argument_counts, right=zero_remaining_counts);
let compared_argument_counts = select l.call as call, l.file as file, l.positional_consumption as positional_consumption, r.provided_count as provided_count from no_keyword_calls as l join all_remaining_counts as r on l.call = r.call and l.file = r.file;
let too_few_calls = select call, file from compared_argument_counts where provided_count > 0 and provided_count < positional_consumption;
let too_few_functions = select r.function as id, l.file as file from too_few_calls as l join call_functions as r on l.call = r.call and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span from too_few_functions as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1206(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1206)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE1206(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1206)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE1206"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
