import observation_matches from "python/ruff/suppress-matches";
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let types = select parent, child, file from "semantic-child" where field = "type";
let type_roots = select l.id as handler, r.child as type, l.file as file from handlers as l join types as r on l.id = r.parent and l.file = r.file;
let child_edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=child_edges, source="origin", destination="destination");
let type_descendants = select l.handler as handler, r.destination as id, l.file as file from type_roots as l join descendants as r on l.type = r.origin;
let type_nodes = select l.handler as handler, l.type as id, l.file as file from type_roots as l;
let nested_nodes = select handler, id, file from type_descendants;
let all_type_nodes = union(left=type_nodes, right=nested_nodes);
let syntax_nodes = select id, kind, file, span from "semantic-syntax";
let invalid_kinds = select id, file, span from syntax_nodes where kind = "constant" or kind = "list" or kind = "set" or kind = "dict" or kind = "bin-op" or kind = "bool-op";
let tuple_type_nodes = select l.id as id, l.file as file, r.span as span from all_type_nodes as l join syntax_nodes as r on l.id = r.id and l.file = r.file where r.kind = "tuple";
let tuple_type_roots = select l.type as id, l.file as file from type_roots as l join syntax_nodes as r on l.type = r.id and l.file = r.file where r.kind = "tuple";
let nested_tuple_types = antijoin(left=tuple_type_nodes, right=tuple_type_roots, left-on=["id", "file"], right-on=["id", "file"]);
let invalid_nodes = union(left=invalid_kinds, right=nested_tuple_types);
let invalid_exception_items = select l.id as id, l.file as file, r.span as span from all_type_nodes as l join invalid_nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from invalid_exception_items as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B030)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "B030"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
