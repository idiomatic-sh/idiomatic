import observation_matches from "python/ruff/suppress-matches";
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let types = select parent, child, file from "semantic-child" where field = "type";
let type_roots = select l.id as handler, r.child as type, l.file as file from handlers as l join types as r on l.id = r.parent and l.file = r.file;
let tree_children = select child as id from "semantic-child";
let type_starts = select handler, type as id, file from type_roots;
let type_walk = axis(from=type_starts, relation="semantic-child", direction=descendant, domain=tree_children);
let type_descendants = select handler, related as id, file from type_walk;
let type_nodes = select l.handler as handler, l.type as id, l.file as file from type_roots as l;
let nested_nodes = select handler, id, file from type_descendants;
let all_type_nodes = union(left=type_nodes, right=nested_nodes);
let syntax_nodes = select id, kind, file, span from "semantic-syntax";
let typed_nodes = select l.handler as handler, l.id as id, r.kind as kind, l.file as file, r.span as span from all_type_nodes as l join syntax_nodes as r on l.id = r.id and l.file = r.file;
let typed_edges = select l.handler as handler, r.parent as parent, l.id as child, r.field as field, l.file as file from typed_nodes as l join "semantic-child" as r on l.id = r.child and l.file = r.file;
let parented_edges = select l.handler as handler, l.parent as parent, r.kind as parent_kind, l.child as child, l.field as field, l.file as file from typed_edges as l join typed_nodes as r on l.parent = r.id and l.file = r.file;
let unpacked_edges = select handler, child, file from parented_edges where (parent_kind = "bin-op" and (field = "left" or field = "right")) or (parent_kind = "starred" and field = "value");
let root_tuples = select l.handler as handler, l.type as id, l.file as file from type_roots as l join syntax_nodes as r on l.type = r.id and l.file = r.file where r.kind = "tuple";
let unpacked_containers = select l.handler as handler, l.child as id, l.file as file from unpacked_edges as l join typed_nodes as r on l.child = r.id and l.file = r.file where r.kind = "tuple" or r.kind = "list";
let unpacked_lists = select l.handler as handler, l.child as id, l.file as file from parented_edges as l join typed_nodes as r on l.child = r.id and l.file = r.file where l.parent_kind = "starred" and l.field = "value" and r.kind = "list";
let unpacked_tuples0 = select l.handler as handler, l.id as id, l.file as file from unpacked_containers as l join typed_nodes as r on l.id = r.id and l.file = r.file where r.kind = "tuple";
let unpacked_tuples = union(left=root_tuples, right=unpacked_tuples0);
let expanding = union(left=unpacked_tuples, right=unpacked_lists);
let element_edges = select l.handler as handler, l.child as child, l.file as file from parented_edges as l join expanding as r on l.parent = r.id and l.file = r.file where l.field = "elts";
let transparent = union(left=unpacked_edges, right=element_edges);
let transparent_nodes = select handler, child as id, file from transparent;
let opaque_nodes0 = antijoin(left=all_type_nodes, right=transparent_nodes, left-on=["id", "file"], right-on=["id", "file"]);
let opaque_nodes = select id, file from opaque_nodes0;
let transparent_ids = select id, file from transparent_nodes;
let boundaries = axis(from=transparent_ids, relation="semantic-child", direction=nearest-ancestor, domain=opaque_nodes);
let root_ids = select type as id, file from type_roots;
let reached_below = select l.id as id, l.file as file from boundaries as l join root_ids as r on l.related = r.id and l.file = r.file;
let reached = union(left=root_ids, right=reached_below);
let leaves = select l.id as id, l.file as file, r.kind as kind, r.span as span from reached as l join syntax_nodes as r on l.id = r.id and l.file = r.file;
let invalid_kinds = select id, file, span from leaves where kind in ["constant", "set", "dict", "bool-op", "list", "tuple"];
let expanding_ids = select id, file from expanding;
let invalid_exception_items = antijoin(left=invalid_kinds, right=expanding_ids, left-on=["id", "file"], right-on=["id", "file"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from invalid_exception_items as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B030)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "B030"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
