import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let decimal_functions = select id, file from "qualified-name" where path = "decimal.Decimal";
let decimal_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join decimal_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_edges = select parent, child, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, r.child as argument, l.file as file from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let argument_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from positional_args as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let prior_argument_pairs = select l.call as call, l.argument as later, r.argument as earlier, l.file as file from argument_locations as l join argument_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let later_arguments = select call, later as argument, file from prior_argument_pairs;
let first_arguments = antijoin(left=positional_args, right=later_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let call_keyword_rows = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_name_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_rows = select l.call as call, l.file as file, l.keyword as keyword, r.child as name_id from call_keyword_rows as l join keyword_name_edges as r on l.keyword = r.parent and l.file = r.file;
let value_named_keywords = select l.call as call, l.file as file, l.keyword as keyword from named_keyword_rows as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "value";
let keyword_value_edges = select parent, child, file from "semantic-child" where field = "value";
let keyword_value_candidates = select l.call as call, l.file as file, r.child as argument from value_named_keywords as l join keyword_value_edges as r on l.keyword = r.parent and l.file = r.file;
let calls_with_value_keyword = select call, file from keyword_value_candidates;
let positional_without_value_keyword = antijoin(left=first_arguments, right=calls_with_value_keyword, left-on=["call", "file"], right-on=["call", "file"]);
let starred_nodes = select id, file from "semantic-syntax" where kind = "starred";
let starred_first_arguments = select l.call as call, l.file as file from first_arguments as l join starred_nodes as r on l.argument = r.id and l.file = r.file;
let positional_value_arguments = antijoin(left=positional_without_value_keyword, right=starred_first_arguments, left-on=["call", "file"], right-on=["call", "file"]);
let keyword_values = select call, argument, file from keyword_value_candidates;
let decimal_value_arguments = union(left=positional_value_arguments, right=keyword_values);
let string_literals = select occurrence as id, file, value, span from "string-literal";
let decimal_string_args = select l.call as call, l.argument as id, l.file as file, r.value as value, r.span as span from decimal_value_arguments as l join string_literals as r on l.argument = r.id and l.file = r.file;
let decimal_integer_strings_unbounded = select call, id, file, span from decimal_string_args where matches(value, "^[ \t\x0c]*_*[+]?_*[0-9](?:_*[0-9])*_*[ \t\x0c]*$") or matches(value, "^[ \t\x0c]*_*-_*[0-9_]*[1-9][0-9_]*_*[ \t\x0c]*$");
let overlong_decimal_strings = select id, file from string_literals where matches(value, "^(?:[^0-9]*[0-9]){641}");
let decimal_integer_strings = antijoin(left=decimal_integer_strings_unbounded, right=overlong_decimal_strings, left-on=["id", "file"], right-on=["id", "file"]);
let decimal_calls_with_integer_string = select l.id as id, l.file as file, l.span as span from decimal_integer_strings as l join decimal_calls as r on l.call = r.call and l.file = r.file;
let float_functions = select id, file from "qualified-name" where path = "builtins.float";
let float_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join float_functions as r on l.function = r.id and l.file = r.file;
let decimal_float_arguments = select l.call as decimal_call, l.file as file, r.argument as float_call from decimal_calls as l join decimal_value_arguments as r on l.call = r.call and l.file = r.file;
let float_argument_counts = group-count(from=positional_args, keys=["call", "file"], count="argument_count", distinct="argument");
let one_float_argument_calls = select l.call as call, l.file as file from float_argument_counts as l where l.argument_count = 1;
let float_keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let float_keyword_rows = select l.call as call, l.file as file, r.child as keyword from wrappers as l join float_keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let float_calls_with_keywords = select call, file from float_keyword_rows;
let float_calls_without_keywords = antijoin(left=one_float_argument_calls, right=float_calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let valid_float_calls = select l.call as call, l.file as file, l.span as span from float_calls as l join float_calls_without_keywords as r on l.call = r.call and l.file = r.file;
let float_string_arguments = select l.call as call, l.file as file, r.argument as argument from valid_float_calls as l join positional_args as r on l.call = r.call and l.file = r.file;
let nonfinite_strings = select id, file from string_literals where matches(value, "(?i)^\s*[+-]?(?:inf|infinity|nan)\s*$");
let float_calls_with_nonfinite = select l.call as call, l.file as file from float_string_arguments as l join nonfinite_strings as r on l.argument = r.id and l.file = r.file;
let decimal_calls_with_float = select l.decimal_call as call, l.file as file, l.float_call as float_call from decimal_float_arguments as l join float_calls_with_nonfinite as r on l.float_call = r.call and l.file = r.file;
let float_call_nodes = select id, file, span from calls;
let float_candidates = select l.float_call as id, l.file as file, r.span as span from decimal_calls_with_float as l join float_call_nodes as r on l.float_call = r.id and l.file = r.file;
let candidates = union(left=decimal_calls_with_integer_string, right=float_candidates);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB157(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB157)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:FURB157)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:FURB157)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB157"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
