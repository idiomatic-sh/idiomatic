import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let assignments = select id from "semantic-syntax" where kind = "assign";
let target_fields = select parent, child from "semantic-child" where field = "targets";
let roots = select l.id as assignment, r.child as id from assignments as l join target_fields as r on l.id = r.parent;
let containers = select id from "semantic-syntax" where kind = "tuple" or kind = "list";
let elements = select parent, child from "semantic-child" where field = "elts";
let container_edges = select l.id as parent, r.child as child from containers as l join elements as r on l.id = r.parent;
let stars = select id from "semantic-syntax" where kind = "starred";
let values = select parent, child from "semantic-child" where field = "value";
let star_edges = select l.id as parent, r.child as child from stars as l join values as r on l.id = r.parent;
let edges = union(left=container_edges, right=star_edges);
let paths = closure(edges=edges, source="parent", destination="child");
let descendants = select l.assignment as assignment, r.child as id from roots as l join paths as r on l.id = r.parent;
let all_targets = union(left=roots, right=descendants);
let names = select id, file, span from "semantic-syntax" where kind = "name";
let id_fields = select parent, child from "semantic-child" where field = "id";
let identifier_tokens = select id, text from semantic_identifiers;
let dummy_identifiers = select id from identifier_tokens where matches(text, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let identifiers = antijoin(left=identifier_tokens, right=dummy_identifiers, left-on=["id"], right-on=["id"]);
let spelling = select l.parent as id, r.text as name from id_fields as l join identifiers as r on l.child = r.id;
let named_targets = select l.assignment as assignment, l.id as id, r.name as name from all_targets as l join spelling as r on l.id = r.id;
let ordered = select l.assignment as assignment, l.id as id, l.name as name, r."start-byte" as begin from named_targets as l join "source-location" as r on l.id = r.id;
let duplicates = select l.id as id from ordered as l join ordered as r on l.assignment = r.assignment and l.name = r.name where l.begin > r.begin;
let reportable = select l.id as id, l.file as file, l.span as span from names as l join duplicates as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0128(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0128)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLW0128)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0128)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0128"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
