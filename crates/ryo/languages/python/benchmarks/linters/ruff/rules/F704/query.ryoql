import suppress from "python/ruff/suppress";
let statements = select * from "semantic-syntax" where kind = "yield" or kind = "yield-from" or kind = "await";
let scopes = select id, kind from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let bodies = select parent, child from "semantic-child" where field = "body";
let regions = select r.child as id, l.kind as kind from scopes as l join bodies as r on l.id = r.parent;
let boundaries = select id from regions;
let functions = select id from regions where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let comprehensions = select id from "semantic-syntax" where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let result_edges = select parent, child from "semantic-child" where field = "elt" or field = "key" or field = "value";
let results = select r.child as id from comprehensions as l join result_edges as r on l.id = r.parent;
let clauses = select parent, child, ordinal from "semantic-child" where field = "generators";
let later_clauses = select l.child as id from clauses as l join clauses as r on l.parent = r.parent where l.ordinal > r.ordinal;
let iters = select parent, child from "semantic-child" where field = "iter";
let later_iters = select r.child as id from later_clauses as l join iters as r on l.id = r.parent;
let filters = select child as id from "semantic-child" where field = "ifs";
let generator_regions = union(left=results, right=later_iters);
let all_generator_regions = union(left=generator_regions, right=filters);
let yield_boundaries = union(left=boundaries, right=all_generator_regions);
let yield_statements = select * from statements where kind != "await";
let awaits = select * from statements where kind = "await";
let yield_ancestors = axis(from=yield_statements, relation="semantic-child", direction=nearest-ancestor, domain=yield_boundaries);
let generator_nodes = select id from "semantic-syntax" where kind = "generator-exp";
let generator_results = select r.child as id from generator_nodes as l join result_edges as r on l.id = r.parent;
let generator_clauses = select r.child as id from generator_nodes as l join clauses as r on l.id = r.parent;
let generator_later_clauses = select l.id as id from later_clauses as l join generator_clauses as r on l.id = r.id;
let generator_later_iters = select r.child as id from generator_later_clauses as l join iters as r on l.id = r.parent;
let filter_edges = select parent, child from "semantic-child" where field = "ifs";
let generator_filters = select r.child as id from generator_clauses as l join filter_edges as r on l.id = r.parent;
let generator_values = union(left=generator_results, right=generator_later_iters);
let await_regions = union(left=generator_values, right=generator_filters);
let await_functions = union(left=functions, right=await_regions);
let await_boundaries = union(left=boundaries, right=await_regions);
let await_ancestors = axis(from=awaits, relation="semantic-child", direction=nearest-ancestor, domain=await_boundaries);
let yield_nested = select l.id as id from yield_ancestors as l join functions as r on l.related = r.id;
let await_nested = select l.id as id from await_ancestors as l join await_functions as r on l.related = r.id;
let yield_direct = select l.id as id from yield_statements as l join functions as r on l.id = r.id;
let await_direct = select l.id as id from awaits as l join await_functions as r on l.id = r.id;
let nested = union(left=yield_nested, right=await_nested);
let direct = union(left=yield_direct, right=await_direct);
let nested_only = antijoin(left=nested, right=regions, left-on=["id"], right-on=["id"]);
let function_valid = union(left=nested_only, right=direct);
let direct_generator_yields = select l.id as id from yield_statements as l join all_generator_regions as r on l.id = r.id;
let valid = antijoin(left=function_valid, right=direct_generator_yields, left-on=["id"], right-on=["id"]);
let invalid = antijoin(left=statements, right=valid, left-on=["id"], right-on=["id"]);
let reportable = select id, file, span from invalid;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F704(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F704)(?:,|$)");
emit violations subject file key(id);
