import suppress from "python/ruff/suppress";
let utc_names = select id, file, span from "qualified-name" where path = "datetime.timezone.utc";
let supported_targets = select file from "language-target" where major > 3 or major = 3 and minor >= 11;
let candidates = select l.id as id, l.file as file, l.span as span from utc_names as l join supported_targets as r on l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP017(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP017)(?:,|$)");
emit violations subject file key(id);
