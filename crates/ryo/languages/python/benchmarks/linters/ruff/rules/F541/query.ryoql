import suppress from "python/ruff/suppress";
let expressions = select id from "semantic-syntax" where kind = "joined-str";
let parts = select id, file, span from "semantic-syntax" where kind = "f-string-part";
let parented_parts = select l.parent as parent, r.id as id, r.file as file, r.span as span from "semantic-child" as l join parts as r on l.child = r.id;
let placeholders = select id from "semantic-syntax" where kind = "formatted-value";
let interpolated_parts = select l.parent as parent from "semantic-child" as l join placeholders as r on l.child = r.id;
let interpolated_expressions = select l.parent as parent from parented_parts as l join interpolated_parts as r on l.id = r.parent;
let static_expressions = antijoin(left=expressions, right=interpolated_expressions, left-on=["id"], right-on=["parent"]);
let reportable = select r.id as id, r.file as file, r.span as span from static_expressions as l join parented_parts as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F541(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F541)(?:,|$)");
emit violations subject file key(id);
