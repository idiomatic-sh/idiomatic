import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
import line_located from "python/ruff/candidate-locations";
let expressions = select id from "semantic-syntax" where kind = "joined-str";
let parts = select id, file, span from "semantic-syntax" where kind = "f-string-part";
let parented_parts = select l.parent as parent, r.id as id, r.file as file, r.span as span from "semantic-child" as l join parts as r on l.child = r.id;
let placeholders = select id from "semantic-syntax" where kind = "formatted-value";
let interpolated_parts = select l.parent as parent from "semantic-child" as l join placeholders as r on l.child = r.id;
let interpolated_expressions = select l.parent as parent from parented_parts as l join interpolated_parts as r on l.id = r.parent;
let static_expressions = antijoin(left=expressions, right=interpolated_expressions, left-on=["id"], right-on=["parent"]);
let reportable = select r.id as id, r.file as file, r.span as span from static_expressions as l join parented_parts as r on l.id = r.parent;
let candidate_locations = line_located(candidates=reportable);
let suppression_mappings = noqa_line_map();
let suppression_locations = noqa_locations(candidates=candidate_locations, mappings=suppression_mappings);
let suppression_parents = select id, file, line from candidate_locations where id != id;
let suppression_matches = suppression_edges(candidates=candidate_locations, locations=suppression_locations, additional_locations=suppression_parents, codes="^(?:F541)$");
let suppression_candidates = select id, file, span from suppression_locations;
let violations = antijoin(left=suppression_candidates, right=suppression_matches, left-on=[id, span], right-on=[id, span]);
let matched_directives = select directive, file from suppression_matches where scope < 2;
let noqa_matches = extend(from=matched_directives, values={code: "F541"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
