import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file, span from "semantic-syntax";
let assignments = select id, file from nodes where kind = "assign";
let target_edges = select parent, child, file from "semantic-child" where field = "targets";
let targets = select l.id as assignment, r.child as target, l.file as file from assignments as l join target_edges as r on l.id = r.parent and l.file = r.file;
let target_counts = group-count(from=targets, keys=["assignment","file"], count="count", distinct="target");
let names = select id, file from nodes where kind = "name";
let single_targets_join_1 = select l.assignment as l_assignment, l.file as l_file, c.assignment as c_assignment, c.file as c_file, l.target as l_target, c.count as c_count from targets as l join target_counts as c on l.assignment = c.assignment and l.file = c.file;
let single_targets = select l.l_assignment as assignment, l.l_file as file from single_targets_join_1 as l join names as r on l.l_target = r.id and l.l_file = r.file where l.c_count = 1;
let values = select parent, child, file from "semantic-child" where field = "value";
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let assigned_calls_join_1 = select l.assignment as l_assignment, e.child as e_child, l.file as l_file, e.parent as e_parent, e.file as e_file from single_targets as l join values as e on l.assignment = e.parent and l.file = e.file;
let assigned_calls = select l.l_assignment as assignment, l.e_child as call, l.l_file as file from assigned_calls_join_1 as l join calls as r on l.e_child = r.id and l.e_file = r.file;
let functions = select parent, child, file from "semantic-child" where field = "func";
let named_tuple_names = select id, file from "qualified-name" where path = "typing.NamedTuple" or path = "typing_extensions.NamedTuple";
let named_tuple_calls_join_1 = select l.assignment as l_assignment, l.call as l_call, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from assigned_calls as l join functions as e on l.call = e.parent and l.file = e.file;
let named_tuple_calls = select l.l_assignment as assignment, l.l_call as call, l.l_file as file from named_tuple_calls_join_1 as l join named_tuple_names as r on l.e_child = r.id and l.e_file = r.file;
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let wrappers_join_1 = select l.call as l_call, e.child as e_child, l.file as l_file, e.parent as e_parent, e.file as e_file from named_tuple_calls as l join "semantic-child" as e on l.call = e.parent and l.file = e.file;
let wrappers = select l.l_call as call, l.e_child as wrapper, l.l_file as file from wrappers_join_1 as l join argument_nodes as r on l.e_child = r.id and l.e_file = r.file;
let arguments = select call, expression, position, file from "call-argument";
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id, l.file as file from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_values = select l.call as call, r.child as expression, l.file as file from keywords as l join values as r on l.id = r.parent and l.file = r.file;
let positional = antijoin(left=arguments, right=keyword_values, left-on=["expression","file"], right-on=["expression","file"]);
let positional_counts = group-count(from=positional, keys=["call","file"], count="count", distinct="expression");
let one_positional = select call, file from positional_counts where count = 1;
let two_positionals = select call, file from positional_counts where count = 2;
let keyword_args = select parent, child, file from "semantic-child" where field = "arg";
let named_keywords = select l.call as call, l.id as id, l.file as file from keywords as l join keyword_args as r on l.id = r.parent and l.file = r.file;
let unnamed_keywords = antijoin(left=keywords, right=named_keywords, left-on=["id","file"], right-on=["id","file"]);
let valid_one_positional = antijoin(left=one_positional, right=unnamed_keywords, left-on=["call","file"], right-on=["call","file"]);
let two_without_keywords = antijoin(left=two_positionals, right=keywords, left-on=["call","file"], right-on=["call","file"]);
let lists = select id, file from nodes where kind = "list";
let field_lists_join_1 = select l.call as l_call, a.expression as a_expression, l.file as l_file, a.call as a_call, a.file as a_file, a.position as a_position from two_without_keywords as l join positional as a on l.call = a.call and l.file = a.file;
let field_lists = select l.l_call as call, l.a_expression as list, l.l_file as file from field_lists_join_1 as l join lists as r on l.a_expression = r.id and l.a_file = r.file where l.a_position = 1;
let element_edges = select parent, child, ordinal, file from "semantic-child" where field = "elts";
let field_entries = select l.call as call, r.child as entry, l.file as file from field_lists as l join element_edges as r on l.list = r.parent and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_entries = select l.call as call, l.entry as entry, l.file as file from field_entries as l join tuples as r on l.entry = r.id and l.file = r.file;
let tuple_elements = select l.call as call, l.entry as entry, r.child as element, r.ordinal as ordinal, l.file as file from tuple_entries as l join element_edges as r on l.entry = r.parent and l.file = r.file;
let element_counts = group-count(from=tuple_elements, keys=["entry","file"], count="count", distinct="element");
let pair_entries = select l.call as call, l.entry as entry, l.file as file from tuple_entries as l join element_counts as r on l.entry = r.entry and l.file = r.file where r.count = 2;
let earlier_elements = select l.entry as entry, l.element as element, l.file as file from tuple_elements as l join tuple_elements as r on l.entry = r.entry and l.file = r.file where l.ordinal > r.ordinal;
let first_elements = antijoin(left=tuple_elements, right=earlier_elements, left-on=["entry","element","file"], right-on=["entry","element","file"]);
let plain_strings = select id, file from "literal-properties" where kind = "string";
let first_string_elements = select l.entry as entry, l.element as element, l.file as file from first_elements as l join plain_strings as r on l.element = r.id and l.file = r.file;
let first_strings = select l.entry as entry, r.value as name, l.file as file from first_string_elements as l join "string-literal" as r on l.element = r.occurrence and l.file = r.file;
let identifier_names = select entry, file from first_strings where matches(name, "^[_\p{XID_Start}][_\p{XID_Continue}]*$");
let keyword_names = select entry, file from first_strings where glob_any(name, "{False,None,True,and,as,assert,async,await,break,class,continue,def,del,elif,else,except,finally,for,from,global,if,import,in,is,lambda,nonlocal,not,or,pass,raise,return,try,while,with,yield}") or (starts_with(name, "__") and ends_with(name, "__"));
let valid_names = antijoin(left=identifier_names, right=keyword_names, left-on=["entry","file"], right-on=["entry","file"]);
let starred = select id, file from nodes where kind = "starred";
let starred_annotations = select l.entry as entry, l.file as file from earlier_elements as l join starred as r on l.element = r.id and l.file = r.file;
let valid_pair_names = select l.call as call, l.entry as entry, l.file as file from pair_entries as l join valid_names as r on l.entry = r.entry and l.file = r.file;
let valid_entries = antijoin(left=valid_pair_names, right=starred_annotations, left-on=["entry","file"], right-on=["entry","file"]);
let invalid_entries = antijoin(left=field_entries, right=valid_entries, left-on=["entry","file"], right-on=["entry","file"]);
let valid_lists = antijoin(left=field_lists, right=invalid_entries, left-on=["call","file"], right-on=["call","file"]);
let list_calls = select call, file from valid_lists;
let accepted_calls = union(left=valid_one_positional, right=list_calls);
let selected = select l.assignment as id, l.file as file from named_tuple_calls as l join accepted_calls as r on l.call = r.call and l.file = r.file;
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:U014|UP014)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP014"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
