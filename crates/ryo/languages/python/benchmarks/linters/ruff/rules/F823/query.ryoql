import suppress from "python/ruff/suppress";
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let local_events = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event" where scope = phase and (kind = "bind" or kind = "annotation" or kind = "delete" or kind = "cleanup");
let deletion_nodes = select occurrence as id from local_events where kind = "delete";
let conditional_statements = select id from "semantic-syntax" where kind = "if" or kind = "while" or kind = "match";
let conditional_deletions = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=conditional_statements);
let conditional_delete_ids = select l.id as id from conditional_deletions as l join conditional_statements as r on l.related = r.id;
let else_roots = select child as id from "semantic-child" where field = "orelse";
let else_deletions = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=else_roots);
let else_delete_ids = select l.id as id from else_deletions as l join else_roots as r on l.related = r.id;
let handler_boundaries = select id, kind from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "except-handler";
let nearest_handler_boundary = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=handler_boundaries);
let handler_delete_ids = select l.id as id from nearest_handler_boundary as l join handler_boundaries as r on l.related = r.id where r.kind = "except-handler";
let conditional_or_else_deletes = union(left=conditional_delete_ids, right=else_delete_ids);
let handler_nodes = select id from "semantic-syntax" where kind = "except-handler";
let handler_target_events = select l.occurrence as id from local_events as l join handler_nodes as r on l.occurrence = r.id;
let ignored_delete_ids = union(left=conditional_or_else_deletes, right=handler_delete_ids);
let ignored_events = union(left=ignored_delete_ids, right=handler_target_events);
let active_local_events = antijoin(left=local_events, right=ignored_events, left-on=["occurrence"], right-on=["id"]);
let function_events = select l.occurrence as occurrence, l.name as name, l.scope as scope, l.phase as phase, l.kind as kind, l.ordinal as ordinal, l.file as file from active_local_events as l join function_scopes as r on l.scope = r.id and l.file = r.file;
let declarations = select occurrence, name, scope, phase, ordinal, file from function_events where kind = "bind" or kind = "annotation";
let declarations_with_prior_binding = select l.occurrence as occurrence from declarations as l join function_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let first_declarations = antijoin(left=declarations, right=declarations_with_prior_binding, left-on=["occurrence"], right-on=["occurrence"]);
let replacements = select occurrence, name, scope, ordinal, file from function_events where kind = "bind" or kind = "delete" or kind = "cleanup";
let later_replacements = select l.occurrence as occurrence from first_declarations as l join replacements as r on l.scope = r.scope and l.name = r.name and l.file = r.file where l.ordinal < r.ordinal;
let final_declarations = antijoin(left=first_declarations, right=later_replacements, left-on=["occurrence"], right-on=["occurrence"]);
let shadow_edges = select s.binding as binding, s.previous as previous, s.scope as scope, s."previous-scope" as previous_scope, s.phase as phase, s.relationship as relationship, s.file as file from "binding-shadow" as s;
let direct_outer_shadows = select binding, previous, scope, phase, file from shadow_edges where relationship = "lexical" and scope != previous_scope;
let shadowing_declarations = select l.occurrence as binding, l.scope as scope, l.ordinal as store_order, l.file as file, r.previous as previous from final_declarations as l join direct_outer_shadows as r on l.occurrence = r.binding and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let outer_uses = select l.binding as binding, l.scope as scope, l.store_order as store_order, l.file as file, r.reference as id from shadowing_declarations as l join "binding-use" as r on l.previous = r.binding and l.scope = r.phase and l.file = r.file;
let read_rows = select r.reference as reference, r.name as name, r.scope as scope, r.phase as phase, r.context as context, r.state as state, r."since-major" as since_major, r."since-minor" as since_minor, r.file as file, r.span as span from "binding-read" as r;
let reads = select reference, name, scope, phase, state, since_major, since_minor, file, span from read_rows where scope = phase and context != "deletion";
let outer_reads = select l.binding as binding, l.id as id, l.store_order as store_order, l.file as file, r.span as span from outer_uses as l join reads as r on l.id = r.reference and l.scope = r.scope and l.file = r.file;
let available_builtins = select reference, name, scope, phase, file, span from reads where state = "builtin" and (since_major < 3 or (since_major = 3 and since_minor <= 10));
let builtin_reads = select l.occurrence as binding, r.reference as id, l.ordinal as store_order, l.file as file, r.span as span from final_declarations as l join available_builtins as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let implicit_names = select name, file from "implicit-symbol" where kind = "module-global" or kind = "builtin" or kind = "platform-builtin";
let unbound_local_read_candidates = select l.occurrence as binding, r.reference as id, l.name as name, l.ordinal as store_order, l.file as file, r.span as span from final_declarations as l join reads as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where r.state = "unbound";
let unbound_local_reads = select l.binding as binding, l.id as id, l.store_order as store_order, l.file as file, l.span as span from unbound_local_read_candidates as l join implicit_names as r on l.name = r.name and l.file = r.file;
let associated_reads_before_local = union(left=outer_reads, right=builtin_reads);
let associated_reads = union(left=associated_reads_before_local, right=unbound_local_reads);
let read_events = select occurrence, ordinal, file from "binding-event" where kind = "read";
let earlier_reads = select l.binding as binding, l.id as id, l.file as file, l.span as span, r.ordinal as read_order from associated_reads as l join read_events as r on l.id = r.occurrence and l.file = r.file where r.ordinal < l.store_order;
let later_reads = select l.binding as binding, l.id as id from earlier_reads as l join earlier_reads as r on l.binding = r.binding where r.read_order < l.read_order;
let first_reads = antijoin(left=earlier_reads, right=later_reads, left-on=["binding", "id"], right-on=["binding", "id"]);
let reportable = select id, file, span from first_reads;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F823(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F823)(?:,|$)");
emit violations subject file key(id);
