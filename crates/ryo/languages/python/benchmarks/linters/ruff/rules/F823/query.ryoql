import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let local_events = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event" where scope = phase and (kind = "bind" or kind = "annotation" or kind = "delete" or kind = "cleanup");
let deletion_nodes = select occurrence as id from local_events where kind = "delete";
let conditional_statements = select id from "semantic-syntax" where kind = "if" or kind = "while" or kind = "match";
let conditional_deletions = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=conditional_statements);
let conditional_delete_ids = select l.id as id from conditional_deletions as l join conditional_statements as r on l.related = r.id;
let else_roots = select child as id from "semantic-child" where field = "orelse";
let else_deletions = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=else_roots);
let else_delete_ids = select l.id as id from else_deletions as l join else_roots as r on l.related = r.id;
let handler_boundaries = select id, kind from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "except-handler";
let nearest_handler_boundary = axis(from=deletion_nodes, relation="semantic-child", direction=nearest-ancestor, domain=handler_boundaries);
let handler_delete_ids = select l.id as id from nearest_handler_boundary as l join handler_boundaries as r on l.related = r.id where r.kind = "except-handler";
let conditional_or_else_deletes = union(left=conditional_delete_ids, right=else_delete_ids);
let handler_nodes = select id from "semantic-syntax" where kind = "except-handler";
let handler_target_events = select l.occurrence as id from local_events as l join handler_nodes as r on l.occurrence = r.id;
let ignored_delete_ids = union(left=conditional_or_else_deletes, right=handler_delete_ids);
let ignored_events = union(left=ignored_delete_ids, right=handler_target_events);
let active_local_events = antijoin(left=local_events, right=ignored_events, left-on=["occurrence"], right-on=["id"]);
let loaded_slots = select occurrence as reference, definition as binding, name, file from "resolves";
let augmented = select id, file from "semantic-syntax" where kind = "aug-assign";
let targets = select r.child as reference, l.file as file from augmented as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let augmented_slots = select l.reference as reference, l.reference as binding, r.name as name, l.file as file from targets as l join "binding-read" as r on l.reference = r.reference and l.file = r.file;
let local_slots = union(left=loaded_slots, right=augmented_slots);
let leading_reads = select reference,scope,phase,ordinal,file from "pre-declaration-read" where scope=phase;
let ignored_declarations = select l.occurrence as occurrence,l.scope as scope,l.phase as phase,l.name as name,l.file as file from local_events as l join ignored_events as r on l.occurrence=r.id where l.kind="bind" or l.kind="annotation";
let reads_in_exceptional_slots = select r.occurrence as reference,r.scope as scope,r.phase as phase,r.ordinal as ordinal,r.file as file from ignored_declarations as l join "binding-event" as r on l.name=r.name and l.scope=r.scope and l.phase=r.phase and l.file=r.file where r.kind="read";
let read_points = union(left=leading_reads,right=reads_in_exceptional_slots);
let local_reads = select l.reference as reference,r.binding as binding,r.name as name,l.scope as scope,l.phase as phase,l.ordinal as read_order,l.file as file from read_points as l join local_slots as r on l.reference=r.reference and l.file=r.file;
let candidate_slots = select scope,name,file from local_reads;
let events_in_slots = select r.occurrence as occurrence,r.name as name,r.scope as scope,r.phase as phase,r.kind as kind,r.ordinal as ordinal,r.file as file from candidate_slots as l join active_local_events as r on l.scope=r.scope and l.name=r.name and l.file=r.file;
let function_events = select l.occurrence as occurrence, l.name as name, l.scope as scope, l.phase as phase, l.kind as kind, l.ordinal as ordinal, l.file as file from events_in_slots as l join function_scopes as r on l.scope = r.id and l.file = r.file;
let early = select l.reference as reference, r.occurrence as binding, r.name as name, r.scope as scope, r.phase as phase, r.ordinal as ordinal, l.file as file from local_reads as l join function_events as r on l.binding = r.occurrence and l.scope = r.scope and l.name = r.name and l.file = r.file where l.read_order < r.ordinal and (r.kind = "bind" or r.kind = "annotation");
let declarations = select binding as occurrence, name, scope, phase, ordinal, file from early;
let ineligible = select l.occurrence as occurrence, l.file as file from declarations as l join function_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal or (l.ordinal < r.ordinal and r.kind != "annotation");
let final_declarations = antijoin(left=declarations, right=ineligible, left-on=[occurrence,file], right-on=[occurrence,file]);
let direct_outer_shadows = select binding,previous,scope,phase,file from "binding-shadow" as s where relationship="lexical" and s.scope!=s."previous-scope";
let shadowing_declarations = select l.occurrence as binding, l.scope as scope, l.ordinal as store_order, l.file as file, r.previous as previous from final_declarations as l join direct_outer_shadows as r on l.occurrence = r.binding and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let reachable_outer = select l.binding as binding, l.scope as scope, l.store_order as store_order, l.file as file, r.reference as id from shadowing_declarations as l join "binding-use" as r on l.previous = r.binding and l.scope = r.phase and l.file = r.file;
let lexical_outer = select l.binding as binding,l.scope as scope,l.store_order as store_order,l.file as file,r.reference as id from shadowing_declarations as l join "binding-resolution" as r on l.previous = r.event and l.file = r.file where r.depth > 0 and r.kind = "bind";
let outer_uses = union(left=reachable_outer,right=lexical_outer);
let reads = select r.reference as reference,r.name as name,r.scope as scope,r.phase as phase,r.state as state,r."since-major" as since_major,r."since-minor" as since_minor,r.file as file,r.span as span from "binding-read" as r where r.scope=r.phase and r.context!="deletion";
let outer_reads = select l.binding as binding, l.id as id, l.store_order as store_order, l.file as file, r.span as span from outer_uses as l join reads as r on l.id = r.reference and l.scope = r.scope and l.file = r.file;
let available_builtins = select reference, name, scope, phase, file, span from reads where state = "builtin" and (since_major < 3 or (since_major = 3 and since_minor <= 10));
let builtin_reads = select l.occurrence as binding, r.reference as id, l.ordinal as store_order, l.file as file, r.span as span from final_declarations as l join available_builtins as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let implicit_names = select name, file from "implicit-symbol" as n where n.kind = "module-global" or n.kind = "platform-builtin" or n.kind = "builtin" and (n."since-major" < 3 or n."since-major" = 3 and n."since-minor" <= 10);
let unbound_local_read_candidates = select l.occurrence as binding, r.reference as id, l.name as name, l.ordinal as store_order, l.file as file, r.span as span from final_declarations as l join reads as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where r.state = "unbound";
let unbound_local_reads = select l.binding as binding, l.id as id, l.store_order as store_order, l.file as file, l.span as span from unbound_local_read_candidates as l join implicit_names as r on l.name = r.name and l.file = r.file;
let associated_reads_before_local = union(left=outer_reads, right=builtin_reads);
let associated_reads = union(left=associated_reads_before_local, right=unbound_local_reads);
let read_events = select occurrence, ordinal, file from "binding-event" where kind = "read";
let earlier_reads = select l.binding as binding, l.id as id, l.file as file, l.span as span, r.ordinal as read_order from associated_reads as l join read_events as r on l.id = r.occurrence and l.file = r.file where r.ordinal < l.store_order;
let first_reads = group-min(from=earlier_reads, keys=["binding"], order="read_order");
let reportable = select id, file, span from first_reads;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="F823");
let violations = antijoin(left=first_reads, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","F823") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
