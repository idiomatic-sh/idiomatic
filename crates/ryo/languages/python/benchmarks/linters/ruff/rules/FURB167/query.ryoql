import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let aliases = select id, file from "qualified-name" where path = "re.A" or path = "re.I" or path = "re.L" or path = "re.M" or path = "re.S" or path = "re.T" or path = "re.U" or path = "re.X";
let syntax = select id, file, span from "semantic-syntax";
let candidates = select l.id as id, l.file as file, r.span as span from aliases as l join syntax as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB167(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB167)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:FURB167)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:FURB167)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB167"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
