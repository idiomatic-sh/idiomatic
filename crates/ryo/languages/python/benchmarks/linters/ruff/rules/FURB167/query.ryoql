import observation_matches from "python/ruff/suppress-matches";
let aliases = select id, file from "qualified-name" where path = "re.A" or path = "re.I" or path = "re.L" or path = "re.M" or path = "re.S" or path = "re.T" or path = "re.U" or path = "re.X";
let syntax = select id, file, span from "semantic-syntax";
let candidates = select l.id as id, l.file as file, r.span as span from aliases as l join syntax as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB167)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB167"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
