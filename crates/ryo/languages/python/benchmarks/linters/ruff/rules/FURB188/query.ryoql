import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let nodes = select id, file, kind, text, span from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let shapes = select id, shape, file from "expression-shape";
let ternaries = select id, file from nodes where kind = "if-exp";
let ternary_bodies = select l.id as id, r.child as sliced, l.file as file from ternaries as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body";
let ternary_tests = select l.id as id, l.sliced as sliced, r.child as test, l.file as file from ternary_bodies as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "test";
let ternary_patterns = select l.id as id, l.sliced as sliced, l.test as test, r.child as other, l.file as file from ternary_tests as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "orelse";
let ifs = select id, file from nodes where kind = "if";
let else_edges = select parent as id, file from edges where field = "orelse";
let no_else = antijoin(left=ifs, right=else_edges, left-on=["id","file"], right-on=["id","file"]);
let bodies = select l.id as id, r.child as member, l.file as file from no_else as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=bodies, keys=["id","file"], count="count", distinct="member");
let single_bodies = select l.id as id, l.member as member, l.file as file from bodies as l join body_counts as r on l.id = r.id and l.file = r.file where r.count = 1;
let assignments = select l.id as id, l.member as assignment, l.file as file from single_bodies as l join nodes as r on l.member = r.id and l.file = r.file where r.kind = "assign";
let targets = select l.id as id, l.assignment as assignment, r.child as other, l.file as file from assignments as l join edges as r on l.assignment = r.parent and l.file = r.file where r.field = "targets";
let target_counts = group-count(from=targets, keys=["id","file"], count="count", distinct="other");
let single_targets = select l.id as id, l.assignment as assignment, l.other as other, l.file as file from targets as l join target_counts as r on l.id = r.id and l.file = r.file where r.count = 1;
let assign_values = select l.id as id, l.other as other, r.child as sliced, l.file as file from single_targets as l join edges as r on l.assignment = r.parent and l.file = r.file where r.field = "value";
let statement_patterns = select l.id as id, l.sliced as sliced, r.child as test, l.other as other, l.file as file from assign_values as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "test";
let patterns = union(left=ternary_patterns, right=statement_patterns);
let subscript_patterns = select l.id as id, l.sliced as sliced, l.test as test, l.other as other, l.file as file from patterns as l join nodes as r on l.sliced = r.id and l.file = r.file where r.kind = "subscript";
let texts = select l.id as id, l.sliced as sliced, l.test as test, l.other as other, r.child as value, l.file as file from subscript_patterns as l join edges as r on l.sliced = r.parent and l.file = r.file where r.field = "value";
let text_shapes = select l.id as id, l.sliced as sliced, l.test as test, l.other as other, l.value as value, r.shape as shape, l.file as file from texts as l join shapes as r on l.value = r.id and l.file = r.file;
let same_other = select l.id as id, l.sliced as sliced, l.test as test, l.value as value, l.shape as shape, l.file as file from text_shapes as l join shapes as r on l.other = r.id and l.shape = r.shape and l.file = r.file;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let funcs = select l.id as call, r.child as func, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "func";
let attrs = select id, file from nodes where kind = "attribute";
let attr_labels = select l.id as attr, r.child as label, l.file as file from attrs as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let named_attrs = select l.attr as attr, r.name as method, l.file as file from attr_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "startswith" or r.name = "endswith";
let method_values = select l.attr as attr, l.method as method, r.child as receiver, l.file as file from named_attrs as l join edges as r on l.attr = r.parent and l.file = r.file where r.field = "value";
let test_methods = select l.call as test, r.receiver as receiver, r.method as method, l.file as file from funcs as l join method_values as r on l.func = r.attr and l.file = r.file;
let test_shapes = select l.test as test, l.method as method, r.shape as shape, l.file as file from test_methods as l join shapes as r on l.receiver = r.id and l.file = r.file;
let matched_tests = select l.id as id, l.sliced as sliced, l.test as test, r.method as method, l.file as file from same_other as l join test_shapes as r on l.test = r.test and l.shape = r.shape and l.file = r.file;
let arg_wrappers = select id, file from nodes where kind = "call-arguments";
let call_wrappers = select l.id as call, r.child as wrapper, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file;
let wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from call_wrappers as l join arg_wrappers as r on l.wrapper = r.id and l.file = r.file;
let positional = select l.call as call, r.child as argument, l.file as file from wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let positional_counts = group-count(from=positional, keys=["call","file"], count="count", distinct="argument");
let single_positional = select l.call as call, l.argument as argument, l.file as file from positional as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let affixes = select l.id as id, l.sliced as sliced, l.test as test, l.method as method, r.argument as affix, l.file as file from matched_tests as l join single_positional as r on l.test = r.call and l.file = r.file;
let slice_fields = select l.id as id, l.method as method, l.affix as affix, r.child as slice, l.file as file from affixes as l join edges as r on l.sliced = r.parent and l.file = r.file where r.field = "slice";
let slices = select l.id as id, l.method as method, l.affix as affix, l.slice as slice, l.file as file from slice_fields as l join nodes as r on l.slice = r.id and l.file = r.file where r.kind = "slice";
let steps = select parent as slice, child as step, file from edges where field = "step";
let no_steps = antijoin(left=slices, right=steps, left-on=["slice","file"], right-on=["slice","file"]);
let primitive_steps = select id, file from "literal-properties" where kind = "null" or kind = "boolean" and boolean = "true";
let numeric_steps = select id, file from "numeric-literal" where kind = "integer" and value = "1";
let allowed_steps = union(left=primitive_steps, right=numeric_steps);
let good_steps = select l.slice as slice, l.file as file from steps as l join allowed_steps as r on l.step = r.id and l.file = r.file;
let with_steps = select l.id as id, l.method as method, l.affix as affix, l.slice as slice, l.file as file from slices as l join good_steps as r on l.slice = r.slice and l.file = r.file;
let step_valid = union(left=no_steps, right=with_steps);
let lowers = select parent as slice, child as bound, file from edges where field = "lower";
let uppers = select parent as slice, child as bound, file from edges where field = "upper";
let prefix_slices = select * from step_valid where method = "startswith";
let prefix_no_upper = antijoin(left=prefix_slices, right=uppers, left-on=["slice","file"], right-on=["slice","file"]);
let prefix_bounds = select l.id as id, l.method as method, l.affix as affix, r.bound as bound, l.file as file from prefix_no_upper as l join lowers as r on l.slice = r.slice and l.file = r.file;
let suffix_slices = select * from step_valid where method = "endswith";
let suffix_no_lower = antijoin(left=suffix_slices, right=lowers, left-on=["slice","file"], right-on=["slice","file"]);
let suffix_bounds = select l.id as id, l.method as method, l.affix as affix, r.bound as bound, l.file as file from suffix_no_lower as l join uppers as r on l.slice = r.slice and l.file = r.file;
let minus_ops = select l.parent as unary, l.file as file from edges as l join nodes as r on l.child = r.id and l.file = r.file where l.field = "op" and r.text = "-";
let negative_operands = select l.unary as unary, r.child as operand, l.file as file from minus_ops as l join edges as r on l.unary = r.parent and l.file = r.file where r.field = "operand";
let suffix_operands = select l.id as id, l.method as method, l.affix as affix, r.operand as bound, l.file as file from suffix_bounds as l join negative_operands as r on l.bound = r.unary and l.file = r.file;
let unfiltered_bounds = union(left=prefix_bounds, right=suffix_operands);
let empty_suffixes = select l.id as id, l.file as file from unfiltered_bounds as l join "literal-properties" as r on l.affix = r.id and l.file = r.file where l.method = "endswith" and r.kind = "string" and r.empty = "true";
let bounds = antijoin(left=unfiltered_bounds, right=empty_suffixes, left-on=["id","file"], right-on=["id","file"]);
let integers = select id, value, file from "numeric-literal" where kind = "integer";
let literal_bounds = select l.id as id, l.affix as affix, r.value as value, l.file as file from bounds as l join integers as r on l.bound = r.id and l.file = r.file where numeric_gte(r.value, 0);
let primitive_strings = select id, file from "literal-properties" where kind = "string";
let literal_affixes = select l.affix as id, l.file as file from literal_bounds as l join primitive_strings as r on l.affix = r.id and l.file = r.file;
let strings = select l.id as id, r.value as value, l.file as file from literal_affixes as l join "string-literal" as r on l.id = r.occurrence and l.file = r.file;
let middle_parts = capture(from=strings, path="value", pattern="{*before}{*character}{*after}", captures=["before","character","after"]);
let middle_chars = select id, before, file from middle_parts where matches(character, "(?s)^.$");
let first_parts = capture(from=strings, path="value", pattern="{*character}{*after}", captures=["character","after"]);
let first_chars0 = select id, file from first_parts where matches(character, "(?s)^.$");
let first_extended = extend(from=first_chars0, values={before: ""});
let first_chars = select id, before, file from first_extended;
let last_parts = capture(from=strings, path="value", pattern="{*before}{*character}", captures=["before","character"]);
let last_chars = select id, before, file from last_parts where matches(character, "(?s)^.$");
let edge_chars = union(left=first_chars, right=last_chars);
let outer_characters = union(left=middle_chars, right=edge_chars);
let singleton_values = select id, file from strings where matches(value, "(?s)^.$");
let singleton_extended = extend(from=singleton_values, values={before: ""});
let singleton_characters = select id, before, file from singleton_extended;
let characters = union(left=outer_characters, right=singleton_characters);
let lengths0 = group-count(from=characters, keys=["id","file"], count="length", distinct="before");
let empty_strings = select id, file from strings where value = "";
let empty_lengths = extend(from=empty_strings, values={length: 0});
let lengths = union(left=lengths0, right=empty_lengths);
let literal_matches = select l.id as id, l.file as file from literal_bounds as l join lengths as r on l.affix = r.id and l.file = r.file where numeric_gte(l.value, r.length) and numeric_gte(r.length, l.value);
let origins = select l.call as call, r.path as path, l.file as file from funcs as l join "qualified-name" as r on l.func = r.id and l.file = r.file where r.path = "builtins.len";
let arguments = select call, expression, file from "call-argument";
let argument_counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="expression");
let len_single = select l.call as call, r.argument as argument, l.file as file from origins as l join single_positional as r on l.call = r.call and l.file = r.file;
let len_args = select l.call as call, l.argument as argument, l.file as file from len_single as l join argument_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let len_shapes = select l.call as call, r.shape as shape, l.file as file from len_args as l join shapes as r on l.argument = r.id and l.file = r.file;
let len_bounds = select l.id as id, l.affix as affix, r.shape as shape, l.file as file from bounds as l join len_shapes as r on l.bound = r.call and l.file = r.file;
let len_matches = select l.id as id, l.file as file from len_bounds as l join shapes as r on l.affix = r.id and l.shape = r.shape and l.file = r.file;
let matches = union(left=literal_matches, right=len_matches);
let supported_targets = select file from "language-target" where major > 3 or major = 3 and minor >= 9;
let supported = select l.id as id, l.file as file from matches as l join supported_targets as r on l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from supported as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:FURB188)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB188"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
