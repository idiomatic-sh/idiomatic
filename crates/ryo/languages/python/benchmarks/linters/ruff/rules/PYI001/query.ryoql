import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let assignments = select id, file, span from "semantic-syntax" where kind = "assign";
let targets = select parent, child from "semantic-child" where field = "targets";
let counts = group-count(from=targets, keys=["parent"], count="count", distinct="child");
let single = select parent from counts where count = 1;
let assignment_targets = select l.id as assignment, r.child as target from assignments as l join targets as r on l.id = r.parent;
let single_targets = select l.assignment as assignment, l.target as target from assignment_targets as l join single as r on l.assignment = r.parent;
let id_fields = select parent, child from "semantic-child" where field = "id";
let identifiers = select id, text from semantic_identifiers;
let names = select l.parent as id, r.text as name from id_fields as l join identifiers as r on l.child = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let private_names = select id from names where matches(name, "^_");
let private_targets = select l.assignment as assignment from single_targets as l join private_names as r on l.target = r.id;
let public_targets = antijoin(left=single_targets, right=private_targets, left-on=["assignment"], right-on=["assignment"]);
let functions_scope = select id from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let paths = closure(edges="semantic-child", source="parent", destination="child");
let function_descendants = select r.child as id from functions_scope as l join paths as r on l.id = r.parent;
let outside_functions = antijoin(left=public_targets, right=function_descendants, left-on=["assignment"], right-on=["id"]);
let stub_assignments = select id from assignments where glob_any(file, "**/*.pyi");
let eligible_assignments = select l.assignment as id from outside_functions as l join stub_assignments as r on l.assignment = r.id;
let factories = select id from "qualified-name" where matches(path, "^(?:typing|typing_extensions)\.(?:TypeVar|ParamSpec|TypeVarTuple)$");
let type_calls = select l.parent as id from functions as l join factories as r on l.child = r.id;
let assignment_values = select l.parent as assignment, l.child as id from values as l join type_calls as r on l.child = r.id;
let invalid = select l.id as id from assignment_values as l join eligible_assignments as r on l.assignment = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from calls as l join invalid as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI001)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI001"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
