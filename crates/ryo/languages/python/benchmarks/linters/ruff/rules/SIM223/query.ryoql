import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let boolean_nodes = select id, file, span from "semantic-syntax" where kind = "bool-op";
let operator_edges = select parent, child, file from "semantic-child" where field = "op";
let operator_tokens = select id, file from "semantic-syntax" where text = "and";
let wanted_ops = select l.parent as id, l.file as file from operator_edges as l join operator_tokens as r on l.child = r.id and l.file = r.file;
let value_edges = select parent, child, ordinal, file from "semantic-child" where field = "values";
let boolean_values = select l.id as boolop, l.file as file, r.child as value, r.ordinal as ordinal from wanted_ops as l join value_edges as r on l.id = r.parent and l.file = r.file;
let literals = select id, file, kind, zero, empty, boolean from "literal-properties";
let falsey_booleans = select id, file from literals where boolean = "false";
let falsey_numbers = select id, file from literals where (kind = "integer" or kind = "float" or kind = "complex") and zero = "true";
let falsey_strings = select id, file from literals where (kind = "string" or kind = "bytes") and empty = "true";
let falsey_nulls = select id, file from literals where kind = "null";
let falsey_a = union(left=falsey_booleans,right=falsey_numbers);
let falsey_b = union(left=falsey_strings,right=falsey_nulls);
let truthy_values = union(left=falsey_a,right=falsey_b);
let prior_values = select l.boolop as boolop, l.file as file, l.value as value, l.ordinal as ordinal from boolean_values as l join boolean_values as r on l.boolop = r.boolop and l.file = r.file where l.ordinal < r.ordinal;
let selected_values = select l.boolop as boolop, l.file as file, l.value as value, l.ordinal as ordinal from boolean_values as l join truthy_values as r on l.value = r.id and l.file = r.file;
let later_selected_values = select l.boolop as boolop, l.file as file, l.value as value from selected_values as l join selected_values as r on l.boolop = r.boolop and l.file = r.file where r.ordinal < l.ordinal;
let chosen_values = antijoin(left=selected_values, right=later_selected_values, left-on=["boolop","value","file"], right-on=["boolop","value","file"]);
let unknown_values = antijoin(left=boolean_values, right=literals, left-on=["value","file"], right-on=["id","file"]);
let possible_starts = select l.boolop as boolop, l.file as file, l.value as value, l.ordinal as ordinal, r.value as start_value, r.ordinal as start_ordinal from chosen_values as l join boolean_values as r on l.boolop = r.boolop and l.file = r.file where r.ordinal <= l.ordinal;
let blocked_starts = select l.boolop as boolop, l.file as file, l.start_value as start_value from possible_starts as l join unknown_values as r on l.boolop = r.boolop and l.file = r.file where r.ordinal >= l.start_ordinal and r.ordinal < l.ordinal;
let unblocked_starts = antijoin(left=possible_starts, right=blocked_starts, left-on=["boolop","start_value","file"], right-on=["boolop","start_value","file"]);
let later_starts = select l.boolop as boolop, l.file as file, l.start_value as start_value from unblocked_starts as l join unblocked_starts as r on l.boolop = r.boolop and l.file = r.file where r.start_ordinal < l.start_ordinal;
let starts = antijoin(left=unblocked_starts, right=later_starts, left-on=["boolop","start_value","file"], right-on=["boolop","start_value","file"]);
let known_prefixes = select boolop, file, start_value from starts where start_ordinal < ordinal;
let suffix_starts = select l.boolop as boolop, l.file as file, l.start_value as start_value from starts as l join prior_values as r on l.boolop = r.boolop and l.file = r.file and l.value = r.value;
let reportable_starts = union(left=known_prefixes, right=suffix_starts);
let literal_locations = select l.boolop as id, l.file as file, r.span as literal_span, r."start-line" as line from reportable_starts as l join "source-location" as r on l.start_value = r.id and l.file = r.file;
let literal_offsets = span-bounds(from=literal_locations, span="literal_span", start-output="literal_begin", end-output="literal_end");
let opening_parens = select id, file, span from "semantic-syntax" where text = "(";
let opening_offsets = span-bounds(from=opening_parens, span="span", start-output="opening_begin", end-output="opening_end");
let wrapped_literals = select l.id as id, l.file as file, l.literal_span as original_literal_span, r.span as literal_span, l.line as line from literal_offsets as l join opening_offsets as r on l.literal_begin = r.opening_end and l.file = r.file;
let plain_literals = antijoin(left=literal_locations, right=wrapped_literals, left-on=["id","file","literal_span"], right-on=["id","file","original_literal_span"]);
let wrapped_locations = select id, file, literal_span, line from wrapped_literals;
let selected_locations = union(left=plain_literals, right=wrapped_locations);
let candidate_bounds = select l.id as id, l.file as file, l.literal_span as literal_span, l.line as line, r.span as expression_span from selected_locations as l join boolean_nodes as r on l.id = r.id and l.file = r.file;
let test_edges = select child, file from "semantic-child" where field = "test";
let tested_values = select l.boolop as boolop, l.file as file from chosen_values as l join test_edges as r on l.boolop = r.child and l.file = r.file;
let ordinary_bounds = antijoin(left=candidate_bounds, right=tested_values, left-on=["id","file"], right-on=["boolop","file"]);
let composed = span-between(from=ordinary_bounds, start="literal_span", end="expression_span", output="span");
let test_locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from tested_values as l join "source-location" as r on l.boolop = r.id and l.file = r.file;
let ordinary_locations = select id, file, span, line from composed;
let candidate_locations = union(left=ordinary_locations, right=test_locations);
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])SIM223(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM223)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM223)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM223)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM223"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(span, id);
