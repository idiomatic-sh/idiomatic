import suppress from "python/ruff/suppress";
import symbols from "python/ruff/modernization-symbols";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as owner, r.child as id, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let test_expressions = select id, file from tests;
let test_symbols = symbols(expressions=test_expressions);
let type_guards = select id, file from test_symbols where kind = "type-checking";
let guarded_ifs = select l.owner as id, l.file as file from tests as l join type_guards as r on l.id = r.id and l.file = r.file;
let guarded_bodies = select r.child as id, l.file as file from guarded_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let definition_rows = select id, owner, name, file from "defines";
let definition_nodes = select id, file from definition_rows;
let guarded_definition_axes = axis(from=definition_nodes, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_definition_nested = select id, file from guarded_definition_axes;
let guarded_definition_self = select l.id as id, l.file as file from definition_nodes as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_definition_ids = union(left=guarded_definition_nested, right=guarded_definition_self);
let guarded_definitions = select l.id as id, l.owner as owner, l.name as name, l.file as file from definition_rows as l join guarded_definition_ids as r on l.id = r.id and l.file = r.file;
let all_assignments = select id, file from nodes where kind = "ann-assign";
let stub_assignments = select id, file from all_assignments where ends_with(file, ".pyi");
let assignments = antijoin(left=all_assignments, right=stub_assignments, left-on=["id","file"], right-on=["id","file"]);
let annotation_edges = select l.id as assignment, r.child as annotation, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let alias_markers = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let explicit_aliases = select l.assignment as id, l.file as file from annotation_edges as l join alias_markers as r on l.annotation = r.id and l.file = r.file;
let scope_nodes = select child as id, file from "scope";
let alias_scopes = axis(from=explicit_aliases, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let function_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let function_aliases = select l.id as id, l.file as file from alias_scopes as l join function_scopes as r on l.related = r.id and l.file = r.file;
let supported_aliases = antijoin(left=explicit_aliases, right=function_aliases, left-on=["id","file"], right-on=["id","file"]);
let guarded_alias_axes = axis(from=supported_aliases, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_alias_nested = select id, file from guarded_alias_axes;
let guarded_alias_self = select l.id as id, l.file as file from supported_aliases as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_alias_ids = union(left=guarded_alias_nested, right=guarded_alias_self);
let runtime_aliases = antijoin(left=supported_aliases, right=guarded_alias_ids, left-on=["id","file"], right-on=["id","file"]);
let alias_values = select r.child as id, l.file as file from runtime_aliases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let names = select id, file from nodes where kind = "name";
let nested_name_axes = axis(from=alias_values, relation="semantic-child", direction=descendant, domain=names);
let nested_names = select related as id, file from nested_name_axes;
let root_names = select l.id as id, l.file as file from alias_values as l join names as r on l.id = r.id and l.file = r.file;
let all_names = union(left=nested_names, right=root_names);
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_name_axes = axis(from=all_names, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let embedded_names_nested = select id, file from embedded_name_axes;
let embedded_names_self = select l.id as id, l.file as file from all_names as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let embedded_names = union(left=embedded_names_nested, right=embedded_names_self);
let physical_names = antijoin(left=all_names, right=embedded_names, left-on=["id","file"], right-on=["id","file"]);
let unsupported_expressions = select id, file from nodes where kind = "call" or kind = "lambda" or kind = "named-expr" or kind = "unary-op" or kind = "bool-op" or kind = "compare" or kind = "if-exp" or kind = "dict" or kind = "set" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp" or kind = "await" or kind = "yield" or kind = "yield-from" or kind = "joined-str" or kind = "template-str";
let unsupported_axes = axis(from=physical_names, relation="semantic-child", direction=ancestor, domain=unsupported_expressions);
let unsupported_names = select id, file from unsupported_axes;
let expression_names = antijoin(left=physical_names, right=unsupported_names, left-on=["id","file"], right-on=["id","file"]);
let subscript_nodes = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as subscript, r.child as value, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let literal_values = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let literal_subscripts = select l.subscript as id, l.file as file from subscript_values as l join literal_values as r on l.value = r.id and l.file = r.file;
let literal_slices = select r.child as id, l.file as file from literal_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let annotated_values = select id, file from "qualified-name" where path = "typing.Annotated" or path = "typing_extensions.Annotated";
let annotated_subscripts = select l.subscript as id, l.file as file from subscript_values as l join annotated_values as r on l.value = r.id and l.file = r.file;
let annotated_slices = select r.child as id, l.file as file from annotated_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let annotated_tuples = select l.id as id, l.file as file from annotated_slices as l join tuples as r on l.id = r.id and l.file = r.file;
let malformed_annotated = antijoin(left=annotated_slices, right=annotated_tuples, left-on=["id","file"], right-on=["id","file"]);
let annotated_elements = select l.id as owner, r.child as element, r.ordinal as ordinal, l.file as file from annotated_tuples as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let annotated_metadata = select l.element as id, l.file as file from annotated_elements as l join annotated_elements as r on l.owner = r.owner and l.file = r.file where r.ordinal < l.ordinal;
let value_roots0 = union(left=literal_slices, right=annotated_metadata);
let value_roots = union(left=value_roots0, right=malformed_annotated);
let value_name_axes = axis(from=expression_names, relation="semantic-child", direction=ancestor, domain=value_roots);
let value_names_nested = select id, file from value_name_axes;
let value_names_self = select l.id as id, l.file as file from expression_names as l join value_roots as r on l.id = r.id and l.file = r.file;
let value_names = union(left=value_names_nested, right=value_names_self);
let type_names = antijoin(left=expression_names, right=value_names, left-on=["id","file"], right-on=["id","file"]);
let reads = select reference as id, name, scope, phase, state, file from "binding-read" where context != "deletion";
let alias_reads = select l.id as id, r.name as name, r.scope as scope, r.phase as phase, r.state as state, l.file as file from type_names as l join reads as r on l.id = r.id and l.file = r.file;
let uses = select reference, binding, file from "binding-use";
let read_uses = select l.id as id, l.name as name, l.phase as phase, l.file as file, r.binding as binding from alias_reads as l join uses as r on l.id = r.reference and l.file = r.file;
let bind_nodes = select occurrence as id, file from "binding-event" where kind = "bind";
let guarded_value_definitions = select l.id as id, l.owner as owner, l.name as name, l.file as file from guarded_definitions as l join bind_nodes as r on l.id = r.id and l.file = r.file;
let associated_guarded_reads = select l.id as id, l.name as name, l.phase as phase, l.binding as binding, r.owner as owner, l.file as file from read_uses as l join guarded_value_definitions as r on l.binding = r.id and l.file = r.file;
let unbound_alias_reads = select id, name, scope, phase, file from alias_reads where state = "unbound" or state = "possibly-unbound";
let known_guarded_reads = select l.id as id, l.name as name, l.phase as phase, r.id as binding, r.owner as owner, l.file as file from unbound_alias_reads as l join guarded_value_definitions as r on l.scope = r.owner and l.name = r.name and l.file = r.file;
let associated_reads = union(left=associated_guarded_reads, right=known_guarded_reads);
let read_events = select occurrence as id, ordinal, file from "binding-event" where kind = "read";
let candidate_reads = select l.id as id, l.name as name, l.phase as phase, l.owner as owner, l.file as file, r.ordinal as point from associated_reads as l join read_events as r on l.id = r.id and l.file = r.file;
let value_events = select occurrence as id, name, scope, phase, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let event_nodes = select id, file from value_events;
let guarded_event_axes = axis(from=event_nodes, relation="semantic-child", direction=ancestor, domain=guarded_bodies);
let guarded_event_nested = select id, file from guarded_event_axes;
let guarded_event_self = select l.id as id, l.file as file from event_nodes as l join guarded_bodies as r on l.id = r.id and l.file = r.file;
let guarded_event_ids = union(left=guarded_event_nested, right=guarded_event_self);
let runtime_events = antijoin(left=value_events, right=guarded_event_ids, left-on=["id","file"], right-on=["id","file"]);
let preceding_options = select l.id as id, l.file as file, r.id as event, r.ordinal as ordinal, r.kind as kind from candidate_reads as l join runtime_events as r on l.owner = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.point or r.phase != l.phase;
let superseded_options = select l.id as id, l.file as file, l.event as event from preceding_options as l join preceding_options as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal;
let terminal_options = antijoin(left=preceding_options, right=superseded_options, left-on=["id","file","event"], right-on=["id","file","event"]);
let available_same_namespace = select id, file from terminal_options where kind = "bind";
let other_uses = antijoin(left=read_uses, right=guarded_definition_ids, left-on=["binding","file"], right-on=["id","file"]);
let other_bindings = select l.id as id, l.name as name, l.phase as phase, l.file as file, r.phase as binding_phase, r.scope as runtime_scope, r.ordinal as ordinal from other_uses as l join runtime_events as r on l.binding = r.id and l.file = r.file where r.kind = "bind";
let earlier_other_bindings = select l.id as id, l.file as file, l.runtime_scope as runtime_scope from other_bindings as l join read_events as r on l.id = r.id and l.file = r.file where l.ordinal < r.ordinal or l.binding_phase != l.phase;
let available_other_namespace = select l.id as id, l.file as file from earlier_other_bindings as l join candidate_reads as r on l.id = r.id and l.file = r.file where l.runtime_scope != r.owner;
let builtin_catalog = select name, file, "since-major" as since_major, "since-minor" as since_minor from "implicit-symbol" where kind = "builtin";
let builtin_eligible = select l.name as name, l.file as file from builtin_catalog as l join "language-target" as r on l.file = r.file where l.since_major < r.major or l.since_major = r.major and l.since_minor <= r.minor;
let local_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let nonlocal_candidates = antijoin(left=candidate_reads, right=local_scopes, left-on=["owner","file"], right-on=["id","file"]);
let available_builtins = select l.id as id, l.file as file from nonlocal_candidates as l join builtin_eligible as r on l.name = r.name and l.file = r.file;
let available0 = union(left=available_same_namespace, right=available_other_namespace);
let available = union(left=available0, right=available_builtins);
let missing = antijoin(left=candidate_reads, right=available, left-on=["id","file"], right-on=["id","file"]);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from missing as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])TC007(?:$|[^A-Z0-9])", range-pattern="(?:^|,)TC007(?:,|$)");
emit violations subject file key(id);
