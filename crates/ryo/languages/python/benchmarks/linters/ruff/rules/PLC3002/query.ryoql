import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let lambdas = select id from "semantic-syntax" where kind = "lambda";
let direct = select l.parent as parent from functions as l join lambdas as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from calls as l join direct as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLC3002(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLC3002)(?:,|$)");
emit violations subject file key(id);
