import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, file, kind, span, text from "semantic-syntax";
let children = select parent, child, field, ordinal, file from "semantic-child";
let if_nodes = select id, file from nodes where kind = "if" or kind = "elif-else-clause";
let tests = select r.child as id, l.file as file from if_nodes as l join children as r on l.id = r.parent and l.file = r.file where r.field = "test";
let compare_nodes = select id, file from nodes where kind = "compare";
let comparisons = select l.id as id, l.file as file from tests as l join compare_nodes as r on l.id = r.id and l.file = r.file;
let operators = select parent as comparison, child as op, file from children where field = "ops";
let operator_counts = group-count(from=operators, keys=["comparison", "file"], count="count", distinct="op");
let single_ops = select l.comparison as comparison, l.op as op, l.file as file from operators as l join operator_counts as r on l.comparison = r.comparison and l.file = r.file where r.count = 1;
let op_texts = select l.comparison as comparison, r.text as op, l.file as file from single_ops as l join nodes as r on l.op = r.id and l.file = r.file;
let lefts = select parent as comparison, child as left, file from children where field = "left";
let rights = select parent as comparison, child as right, file from children where field = "comparators";
let compared_lefts = select l.id as comparison, l.file as file, r.left as left from comparisons as l join lefts as r on l.id = r.comparison and l.file = r.file;
let compared_both = select l.comparison as comparison, l.left as left, r.right as right, l.file as file from compared_lefts as l join rights as r on l.comparison = r.comparison and l.file = r.file;
let compared = select l.comparison as comparison, l.left as left, l.right as right, r.op as op, l.file as file from compared_both as l join op_texts as r on l.comparison = r.comparison and l.file = r.file;
let version_names = select id, file from "qualified-name" where path = "sys.version_info";
let major_names = select id, file from "qualified-name" where path = "sys.version_info.major";
let numbers = select id, file, value from "numeric-literal" where kind = "integer";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select parent, child, file from children where field = "value";
let based_subscripts = select l.id as id, r.child as base, l.file as file from subscripts as l join values as r on l.id = r.parent and l.file = r.file;
let version_subscripts = select l.id as id, l.file as file from based_subscripts as l join version_names as r on l.base = r.id and l.file = r.file;
let slice_fields = select parent, child, file from children where field = "slice";
let indexed_versions = select l.id as id, r.child as index, l.file as file from version_subscripts as l join slice_fields as r on l.id = r.parent and l.file = r.file;
let zeroes = select id, file from numbers where value = "0";
let major_indexes = select l.id as id, l.file as file from indexed_versions as l join zeroes as r on l.index = r.id and l.file = r.file;
let major_forms = union(left=major_names, right=major_indexes);
let slice_nodes = select id, file from nodes where kind = "slice";
let slices = select l.id as id, l.index as slice, l.file as file from indexed_versions as l join slice_nodes as r on l.index = r.id and l.file = r.file;
let lower_step = select parent, file from children where field = "lower" or field = "step";
let prefix_slices = antijoin(left=slices, right=lower_step, left-on=["slice", "file"], right-on=["parent", "file"]);
let upper_fields = select parent, child, file from children where field = "upper";
let prefix_upper = select l.id as id, l.file as file, r.child as upper from prefix_slices as l join upper_fields as r on l.slice = r.parent and l.file = r.file;
let supported_upper = select id, file from numbers where value = "2" or value = "3";
let version_slices = select l.id as id, l.file as file from prefix_upper as l join supported_upper as r on l.upper = r.id and l.file = r.file;
let version_forms = union(left=version_names, right=version_slices);
let any_forms = union(left=version_forms, right=major_forms);
let known_comparisons = select l.comparison as comparison, l.left as left, l.right as right, l.op as op, l.file as file from compared as l join any_forms as r on l.left = r.id and l.file = r.file;
let tuple_lefts = select l.comparison as comparison, l.right as right, l.op as op, l.file as file from compared as l join version_forms as r on l.left = r.id and l.file = r.file where l.op = "<" or l.op = "<=" or l.op = ">" or l.op = ">=";
let tuple_nodes = select id, file from nodes where kind = "tuple";
let tuples = select l.comparison as comparison, l.right as tuple, l.op as op, l.file as file from tuple_lefts as l join tuple_nodes as r on l.right = r.id and l.file = r.file;
let elements = select parent as tuple, child as element, ordinal, file from children where field = "elts";
let element_predecessors = select l.tuple as tuple, l.element as element, l.file as file, r.element as earlier from elements as l join elements as r on l.tuple = r.tuple and l.file = r.file where r.ordinal <= l.ordinal;
let element_positions = group-count(from=element_predecessors, keys=["tuple", "element", "file"], count="position", distinct="earlier");
let noninteger_elements = antijoin(left=elements, right=numbers, left-on=["element", "file"], right-on=["id", "file"]);
let extra_elements = select tuple, element, file from element_positions where position >= 4;
let noninteger_element_keys = select tuple, element, file from noninteger_elements;
let unsupported_elements = union(left=noninteger_element_keys, right=extra_elements);
let integer_tuples = antijoin(left=tuples, right=unsupported_elements, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let major_elements = select tuple, element, file from element_positions where position = 1;
let minor_elements = select tuple, element, file from element_positions where position = 2;
let micro_elements = select tuple, element, file from element_positions where position = 3;
let majors = select l.tuple as tuple, l.file as file, r.value as major from major_elements as l join numbers as r on l.element = r.id and l.file = r.file;
let minors = select l.tuple as tuple, l.file as file, r.value as minor from minor_elements as l join numbers as r on l.element = r.id and l.file = r.file;
let micros = select l.tuple as tuple, l.file as file, r.value as micro from micro_elements as l join numbers as r on l.element = r.id and l.file = r.file;
let with_major = select l.comparison as comparison, l.tuple as tuple, l.file as file, l.op as op, r.major as major from integer_tuples as l join majors as r on l.tuple = r.tuple and l.file = r.file;
let major_invalid = select tuple as id, file from with_major where numeric_gte(major, 256) or (numeric_gte(0, major) and major != "0");
let major_older = select comparison as id, file from with_major where numeric_gte(2, major) and numeric_gte(major, 0);
let major_three = select comparison, tuple, file, op from with_major where major = "3";
let only_major = antijoin(left=major_three, right=minors, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let major_only_reports = select comparison as id, file from only_major;
let with_minor = select l.comparison as comparison, l.tuple as tuple, l.file as file, l.op as op, r.minor as minor from major_three as l join minors as r on l.tuple = r.tuple and l.file = r.file;
let minor_invalid = select tuple as id, file from with_minor where numeric_gte(minor, 256) or (numeric_gte(0, minor) and minor != "0");
let minor_valid = select * from with_minor where numeric_gte(255, minor) and numeric_gte(minor, 0);
let with_micro = select l.comparison as comparison, l.tuple as tuple, l.file as file, l.op as op, l.minor as minor, r.micro as micro from minor_valid as l join micros as r on l.tuple = r.tuple and l.file = r.file;
let micro_invalid = select tuple as id, file from with_micro where numeric_gte(micro, 256) or (numeric_gte(0, micro) and micro != "0");
let invalid_micro_tuples = select tuple, file from with_micro where numeric_gte(micro, 256) or (numeric_gte(0, micro) and micro != "0");
let valid_components = antijoin(left=minor_valid, right=invalid_micro_tuples, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let targets = select file, minor from "language-target" where major = 3;
let targeted = select l.comparison as comparison, l.tuple as tuple, l.file as file, l.op as op, l.minor as minor, r.minor as target_minor from valid_components as l join targets as r on l.file = r.file;
let inclusive_minors = select comparison as id, file from targeted where numeric_gte(target_minor, minor);
let same_minor_versions = select comparison as id, file from targeted where numeric_gte(target_minor, minor) and numeric_gte(minor, target_minor);
let older_minors = antijoin(left=inclusive_minors, right=same_minor_versions, left-on=["id", "file"], right-on=["id", "file"]);
let equal_minors = select comparison, tuple, file from targeted where numeric_gte(target_minor, minor) and numeric_gte(minor, target_minor) and (op = "<" or op = ">=");
let without_micro = antijoin(left=equal_minors, right=micros, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let no_micro_reports = select comparison as id, file from without_micro;
let zero_micro_reports = select l.comparison as id, l.file as file from equal_minors as l join micros as r on l.tuple = r.tuple and l.file = r.file where r.micro = "0";
let major_scalar_lefts = select l.comparison as comparison, l.right as right, l.file as file, l.op as op from known_comparisons as l join major_forms as r on l.left = r.id and l.file = r.file;
let version_scalar_lefts = select l.comparison as comparison, l.right as right, l.file as file, l.op as op from known_comparisons as l join version_forms as r on l.left = r.id and l.file = r.file where l.op = "==" or l.op = "!=";
let scalar_lefts = union(left=major_scalar_lefts, right=version_scalar_lefts);
let scalar_values = select l.comparison as comparison, l.file as file, l.op as op, r.value as value from scalar_lefts as l join numbers as r on l.right = r.id and l.file = r.file;
let scalar_reports = select comparison as id, file from scalar_values where (value = "2" or value = "3") and (op = "==" or op = "!=" or op = "<" or op = "<=" or op = ">" or op = ">=");
let numeric_comparators = select l.right as id, l.file as file, r.value as value from known_comparisons as l join numbers as r on l.right = r.id and l.file = r.file;
let scalar_invalid = select id, file from numeric_comparators where numeric_gte(value, 256) or (numeric_gte(0, value) and value != "0");
let reports_0 = union(left=major_invalid, right=major_older);
let reports_1 = union(left=reports_0, right=major_only_reports);
let reports_2 = union(left=reports_1, right=minor_invalid);
let reports_3 = union(left=reports_2, right=micro_invalid);
let reports_4 = union(left=reports_3, right=older_minors);
let reports_5 = union(left=reports_4, right=no_micro_reports);
let reports_6 = union(left=reports_5, right=zero_micro_reports);
let reports_7 = union(left=reports_6, right=scalar_reports);
let reports_8 = union(left=reports_7, right=scalar_invalid);
let reportable = select l.id as id, l.file as file, r.span as span from reports_8 as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:UP036)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP036"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
