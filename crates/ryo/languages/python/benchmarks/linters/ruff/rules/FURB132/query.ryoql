import observation_matches from "python/ruff/suppress-matches";
import without_effect from "python/ruff/without-effect";
import binding_type from "python/ruff/binding-type";
let ifs = select id, file, span from "semantic-syntax" where kind = "if";
let tests = select parent, child, file from "semantic-child" where field = "test";
let if_tests = select l.id as if_stmt, l.file as file, r.child as test from ifs as l join tests as r on l.id = r.parent and l.file = r.file;
let compares = select id, file from "semantic-syntax" where kind = "compare";
let compare_tests = select l.if_stmt as if_stmt, l.file as file, r.id as compare from if_tests as l join compares as r on l.test = r.id and l.file = r.file;
let operator_edges = select parent, child, file from "semantic-child" where field = "ops";
let all_in_operators = select l.parent as compare, l.file as file from operator_edges as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file where r.text = "in";
let op_counts = group-count(from=operator_edges, keys=["parent","file"], count="count", distinct="child");
let in_operators = select l.compare as compare, l.file as file from all_in_operators as l join op_counts as r on l.compare = r.parent and l.file = r.file where r.count = 1;
let comparator_edges = select parent, child, file from "semantic-child" where field = "comparators";
let right_edges = select l.compare as compare, l.file as file, r.child as element from compare_tests as l join comparator_edges as r on l.compare = r.parent and l.file = r.file;
let names = select id, file from "semantic-syntax" where kind = "name";
let right_names = select l.compare as compare, l.file as file, l.element as set_name from right_edges as l join names as r on l.element = r.id and l.file = r.file;
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let compare_lefts = select l.if_stmt as if_stmt, l.compare as compare, l.file as file, r.child as element from compare_tests as l join left_edges as r on l.compare = r.parent and l.file = r.file;
let test_elements = select l.if_stmt as if_stmt, l.compare as compare, l.file as file, l.element as element, r.set_name as set_name from compare_lefts as l join right_names as r on l.compare = r.compare and l.file = r.file;
let membership_tests = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name from test_elements as l join in_operators as r on l.compare = r.compare and l.file = r.file;
let element_roots = select element as id, file from membership_tests;
let safe_elements = without_effect(expressions=element_roots);
let safe_membership_tests = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name from membership_tests as l join safe_elements as r on l.element = r.id and l.file = r.file;
let else_edges = select parent as if_stmt, file from "semantic-child" where field = "orelse";
let ifs_without_else = antijoin(left=safe_membership_tests, right=else_edges, left-on=["if_stmt", "file"], right-on=["if_stmt", "file"]);
let bodies = select parent, child, file from "semantic-child" where field = "body";
let if_body_items = select l.if_stmt as if_stmt, l.file as file, r.child as statement from ifs_without_else as l join bodies as r on l.if_stmt = r.parent and l.file = r.file;
let body_counts = group-count(from=if_body_items, keys=["if_stmt", "file"], count="count", distinct="statement");
let single_bodies = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.statement as statement from ifs_without_else as l join if_body_items as r on l.if_stmt = r.if_stmt and l.file = r.file;
let one_body = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.statement as statement from single_bodies as l join body_counts as r on l.if_stmt = r.if_stmt and l.file = r.file where r.count = 1;
let expression_statements = select id, file from "semantic-syntax" where kind = "expr";
let expr_bodies = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.id as statement from one_body as l join expression_statements as r on l.statement = r.id and l.file = r.file;
let values = select parent, child, file from "semantic-child" where field = "value";
let body_values = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.child as call from expr_bodies as l join values as r on l.statement = r.parent and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let remove_calls = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.call as call from body_values as l join calls as r on l.call = r.id and l.file = r.file;
let funcs = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.child as function from remove_calls as l join funcs as r on l.call = r.parent and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attr_functions = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.id as attribute from call_functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_values = select parent, child, file from "semantic-child" where field = "value";
let receivers = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.attribute as attribute, r.child as receiver from attr_functions as l join attr_values as r on l.attribute = r.parent and l.file = r.file;
let attr_names = select parent, child, file from "semantic-child" where field = "attr";
let named_attrs = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.receiver as receiver, r.child as attr_name from receivers as l join attr_names as r on l.attribute = r.parent and l.file = r.file;
let identifiers = select id, name, file from "identifier";
let remove_attributes = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.receiver as receiver from named_attrs as l join identifiers as r on l.attr_name = r.id and l.file = r.file where r.name = "remove";
let receiver_names = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.id as receiver from remove_attributes as l join names as r on l.receiver = r.id and l.file = r.file;
let receiver_bindings = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, r.binding as set_binding from membership_tests as l join "binding-use" as r on l.set_name = r.reference and l.file = r.file;
let remove_receiver_bindings = select l.if_stmt as if_stmt, l.file as file, r.binding as set_binding from receiver_names as l join "binding-use" as r on l.receiver = r.reference and l.file = r.file;
let same_set_bindings = select l.if_stmt as if_stmt, l.file as file, l.element as element, l.set_name as set_name, l.set_binding as set_binding from receiver_bindings as l join remove_receiver_bindings as r on l.if_stmt = r.if_stmt and l.file = r.file and l.set_binding = r.set_binding;
let argument_wrappers = select parent, child, file from "semantic-child";
let call_argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let remove_calls2 = select if_stmt, file, call from remove_calls;
let remove_call_edges = select l.if_stmt as if_stmt, l.file as file, r.child as child from remove_calls2 as l join argument_wrappers as r on l.call = r.parent and l.file = r.file;
let call_wrappers = select l.if_stmt as if_stmt, l.file as file, r.id as wrapper from remove_call_edges as l join call_argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_args = select parent, child, file from "semantic-child" where field = "args";
let remove_arguments = select l.if_stmt as if_stmt, l.file as file, r.child as argument from call_wrappers as l join positional_args as r on l.wrapper = r.parent and l.file = r.file;
let keyword_fields = select parent, child, file from "semantic-child" where field = "keywords";
let keyword_wrappers = select l.if_stmt as if_stmt, l.file as file, r.child as keyword from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent and l.file = r.file;
let calls_with_keywords = select if_stmt, file from keyword_wrappers;
let calls_without_keywords = antijoin(left=remove_arguments, right=calls_with_keywords, left-on=["if_stmt", "file"], right-on=["if_stmt", "file"]);
let argument_counts = group-count(from=calls_without_keywords, keys=["if_stmt", "file"], count="count", distinct="argument");
let one_remove_arg_ids = select if_stmt, file from argument_counts where count = 1;
let one_remove_args = select l.if_stmt as if_stmt, l.file as file, l.argument as argument from calls_without_keywords as l join one_remove_arg_ids as r on l.if_stmt = r.if_stmt and l.file = r.file;
let element_shapes = select id, shape, file from "expression-shape";
let check_element_shapes = select l.if_stmt as if_stmt, l.file as file, r.shape as shape from receiver_bindings as l join element_shapes as r on l.element = r.id and l.file = r.file;
let remove_element_shapes = select l.if_stmt as if_stmt, l.file as file, r.shape as shape from one_remove_args as l join element_shapes as r on l.argument = r.id and l.file = r.file;
let matching_elements = select l.if_stmt as if_stmt, l.file as file from check_element_shapes as l join remove_element_shapes as r on l.if_stmt = r.if_stmt and l.file = r.file and l.shape = r.shape;
let receiver_references = select set_name as reference, file from same_set_bindings;
let typed_receivers = binding_type(references=receiver_references, builtin="builtins.set", typing="Set", atom="set");
let valid_set_bindings = select l.if_stmt as if_stmt, l.file as file from same_set_bindings as l join typed_receivers as r on l.set_name = r.reference and l.file = r.file;
let matched_valid_cases = select l.if_stmt as if_stmt, l.file as file from matching_elements as l join valid_set_bindings as r on l.if_stmt = r.if_stmt and l.file = r.file;
let reportable = select l.if_stmt as id, l.file as file, r.span as span from matched_valid_cases as l join ifs as r on l.if_stmt = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let located_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB132)$");
let located_rows = select id, file, span from candidate_locations;
let located = antijoin(left=located_rows, right=located_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from located_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB132"});
observe ruf100_used as noqa_matches;
emit located subject file key(id);
