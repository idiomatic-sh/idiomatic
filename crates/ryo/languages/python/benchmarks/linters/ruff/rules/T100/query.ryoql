import observation_matches from "python/ruff/suppress-matches";
let debugger_calls = select id, file from "qualified-name" where path = "pdb.set_trace" or path = "pudb.set_trace" or path = "ipdb.set_trace" or path = "ipdb.sset_trace" or path = "IPython.terminal.embed.InteractiveShellEmbed" or path = "IPython.frontend.terminal.embed.InteractiveShellEmbed" or path = "celery.contrib.rdb.set_trace" or path = "builtins.breakpoint" or path = "debugpy.breakpoint" or path = "debugpy.listen" or path = "debugpy.wait_for_client" or path = "ptvsd.break_into_debugger" or path = "ptvsd.wait_for_attach" or path = "sys.breakpointhook" or path = "sys.__breakpointhook__" or path = "breakpoint" and provenance = "builtin";
let call_nodes = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, l.file as file from function_fields as l join call_nodes as r on l.parent = r.id and l.file = r.file;
let matched_call_functions = select l.call as call, l.file as file from call_functions as l join debugger_calls as r on l.function = r.id and l.file = r.file;
let call_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from call_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let call_candidates = select l.call as id, l.file as file, r.span as span, r.line as line from matched_call_functions as l join call_locations as r on l.call = r.id and l.file = r.file;
let import_statements = select id, file, span from "semantic-syntax" where kind = "import";
let from_import_statements = select id, file, span from "semantic-syntax" where kind = "import-from";
let import_name_fields = select parent, child, file from "semantic-child" where field = "names";
let plain_import_edges = select l.parent as statement, l.child as alias, l.file as file from import_name_fields as l join import_statements as r on l.parent = r.id and l.file = r.file;
let from_import_edges = select l.parent as statement, l.child as alias, l.file as file from import_name_fields as l join from_import_statements as r on l.parent = r.id and l.file = r.file;
let aliases = select id, file from "semantic-syntax" where kind = "alias";
let plain_aliases = select l.statement as statement, l.alias as alias, l.file as file from plain_import_edges as l join aliases as r on l.alias = r.id and l.file = r.file;
let from_aliases = select l.statement as statement, l.alias as alias, l.file as file from from_import_edges as l join aliases as r on l.alias = r.id and l.file = r.file;
let imports = select occurrence, target, file from "static-import";
let plain_static_imports = select l.occurrence as occurrence, l.target as target, l.file as file from imports as l join plain_aliases as r on l.occurrence = r.alias and l.file = r.file;
let from_static_imports = select l.occurrence as occurrence, l.target as target, l.file as file from imports as l join from_aliases as r on l.occurrence = r.alias and l.file = r.file;
let debugger_import_modules = select occurrence, target, file from plain_static_imports where target = "pdb" or target = "pudb" or target = "ipdb" or target = "debugpy" or target = "ptvsd" or target = "IPython.terminal.embed" or target = "IPython.frontend.terminal.embed" or target = "celery.contrib.rdb";
let debugger_from_imports = select occurrence, target, file from from_static_imports where target = "pdb.set_trace" or target = "pudb.set_trace" or target = "ipdb.set_trace" or target = "ipdb.sset_trace" or target = "IPython.terminal.embed.InteractiveShellEmbed" or target = "IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = "celery.contrib.rdb.set_trace" or target = "builtins.breakpoint" or target = "debugpy.breakpoint" or target = "debugpy.listen" or target = "debugpy.wait_for_client" or target = "ptvsd.break_into_debugger" or target = "ptvsd.wait_for_attach" or target = "sys.breakpointhook" or target = "sys.__breakpointhook__" or target = "breakpoint" or target = "pdb" or target = "pudb" or target = "ipdb" or target = "debugpy" or target = "ptvsd" or target = ".pdb.set_trace" or target = ".pudb.set_trace" or target = ".ipdb.set_trace" or target = ".ipdb.sset_trace" or target = ".IPython.terminal.embed.InteractiveShellEmbed" or target = ".IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = ".celery.contrib.rdb.set_trace" or target = ".debugpy.breakpoint" or target = ".debugpy.listen" or target = ".debugpy.wait_for_client" or target = ".ptvsd.break_into_debugger" or target = ".ptvsd.wait_for_attach" or target = ".sys.breakpointhook" or target = ".sys.__breakpointhook__" or target = ".breakpoint" or target = ".pdb" or target = ".pudb" or target = ".ipdb" or target = ".debugpy" or target = ".ptvsd" or target = "..pdb.set_trace" or target = "..pudb.set_trace" or target = "..ipdb.set_trace" or target = "..ipdb.sset_trace" or target = "..IPython.terminal.embed.InteractiveShellEmbed" or target = "..IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = "..celery.contrib.rdb.set_trace" or target = "..debugpy.breakpoint" or target = "..debugpy.listen" or target = "..debugpy.wait_for_client" or target = "..ptvsd.break_into_debugger" or target = "..ptvsd.wait_for_attach" or target = "..sys.breakpointhook" or target = "..sys.__breakpointhook__" or target = "..breakpoint" or target = "..pdb" or target = "..pudb" or target = "..ipdb" or target = "..debugpy" or target = "..ptvsd" or target = "...pdb.set_trace" or target = "...pudb.set_trace" or target = "...ipdb.set_trace" or target = "...ipdb.sset_trace" or target = "...IPython.terminal.embed.InteractiveShellEmbed" or target = "...IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = "...celery.contrib.rdb.set_trace" or target = "...debugpy.breakpoint" or target = "...debugpy.listen" or target = "...debugpy.wait_for_client" or target = "...ptvsd.break_into_debugger" or target = "...ptvsd.wait_for_attach" or target = "...sys.breakpointhook" or target = "...sys.__breakpointhook__" or target = "...breakpoint" or target = "...pdb" or target = "...pudb" or target = "...ipdb" or target = "...debugpy" or target = "...ptvsd" or target = "....pdb.set_trace" or target = "....pudb.set_trace" or target = "....ipdb.set_trace" or target = "....ipdb.sset_trace" or target = "....IPython.terminal.embed.InteractiveShellEmbed" or target = "....IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = "....celery.contrib.rdb.set_trace" or target = "....debugpy.breakpoint" or target = "....debugpy.listen" or target = "....debugpy.wait_for_client" or target = "....ptvsd.break_into_debugger" or target = "....ptvsd.wait_for_attach" or target = "....sys.breakpointhook" or target = "....sys.__breakpointhook__" or target = "....breakpoint" or target = "....pdb" or target = "....pudb" or target = "....ipdb" or target = "....debugpy" or target = "....ptvsd" or target = ".....pdb.set_trace" or target = ".....pudb.set_trace" or target = ".....ipdb.set_trace" or target = ".....ipdb.sset_trace" or target = ".....IPython.terminal.embed.InteractiveShellEmbed" or target = ".....IPython.frontend.terminal.embed.InteractiveShellEmbed" or target = ".....celery.contrib.rdb.set_trace" or target = ".....debugpy.breakpoint" or target = ".....debugpy.listen" or target = ".....debugpy.wait_for_client" or target = ".....ptvsd.break_into_debugger" or target = ".....ptvsd.wait_for_attach" or target = ".....sys.breakpointhook" or target = ".....sys.__breakpointhook__" or target = ".....breakpoint" or target = ".....pdb" or target = ".....pudb" or target = ".....ipdb" or target = ".....debugpy" or target = ".....ptvsd";
let debugger_import_occurrences = union(left=debugger_import_modules,right=debugger_from_imports);
let import_occurrence_statements = select l.occurrence as occurrence, r.statement as statement, l.file as file from debugger_import_occurrences as l join plain_aliases as r on l.occurrence = r.alias and l.file = r.file;
let from_occurrence_statements = select l.occurrence as occurrence, r.statement as statement, l.file as file from debugger_from_imports as l join from_aliases as r on l.occurrence = r.alias and l.file = r.file;
let all_occurrence_statements = union(left=import_occurrence_statements,right=from_occurrence_statements);
let import_statement_spans = select id, file, span from import_statements;
let from_statement_spans = select id, file, span from from_import_statements;
let all_statement_spans = union(left=import_statement_spans,right=from_statement_spans);
let all_statement_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from all_statement_spans as l join "source-location" as r on l.id = r.id and l.file = r.file;
let import_candidates = select l.occurrence as id, l.file as file, r.span as span, r.line as line from all_occurrence_statements as l join all_statement_locations as r on l.statement = r.id and l.file = r.file;
let candidate_locations = union(left=call_candidates,right=import_candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:T100)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "T100"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
