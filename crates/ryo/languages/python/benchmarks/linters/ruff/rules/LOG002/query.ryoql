import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let logger_functions = select id, file from "qualified-name" where path = "logging.getLogger";
let logger_calls = select l.call as call, l.function as function, r.file as file from call_functions as l join logger_functions as r on l.function = r.id;
let call_arguments = select parent as call, child as wrapper from "semantic-child";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper from call_arguments as l join argument_nodes as r on l.wrapper = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_without_file = select l.call as call, r.child as argument, r.ordinal as ordinal from call_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let positional = select l.call as call, l.argument as argument, l.ordinal as ordinal, r.file as file from positional_without_file as l join calls as r on l.call = r.id;
let later_positional_arguments = select l.call as call, l.argument as argument, l.file as file from positional as l join positional as r on l.call = r.call and l.file = r.file where l.ordinal > r.ordinal;
let first_positional_rows = antijoin(left=positional, right=later_positional_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let first_positional = select call, argument from first_positional_rows;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keywords = select l.call as call, r.child as keyword from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let actual_keywords = select l.call as call, l.keyword as keyword from call_keywords as l join keyword_nodes as r on l.keyword = r.id;
let keyword_names = select parent as keyword, child from "semantic-child" where field = "arg";
let name_identifiers = select l.keyword as keyword, r.name as name from keyword_names as l join "identifier" as r on l.child = r.id;
let name_keywords = select keyword from name_identifiers where name = "name";
let keyword_values = select parent as keyword, child as value from "semantic-child" where field = "value";
let named_values = select l.call as call, l.keyword as keyword, r.value as argument from actual_keywords as l join keyword_values as r on l.keyword = r.keyword;
let named_name_values = select l.call as call, l.argument as argument from named_values as l join name_keywords as r on l.keyword = r.keyword;
let supplied = union(left=first_positional, right=named_name_values);
let selected = select l.call as call, l.argument as argument, r.file as file from supplied as l join logger_calls as r on l.call = r.call;
let identifier_edges = select parent, child from "semantic-child" where field = "id";
let names = select id, file, span from "semantic-syntax" where kind = "name";
let name_values = select l.parent as id, r.name as name from identifier_edges as l join "identifier" as r on l.parent = r.id;
let selected_names = select l.call as call, l.argument as id, r.name as name, l.file as file from selected as l join name_values as r on l.argument = r.id;
let special_names = select l.call as call, l.id as id, l.name as name, l.file as file, r.span as span from selected_names as l join names as r on l.id = r.id where l.name = "__file__" or l.name = "__cached__";
let catalog = select catalog.name as name, catalog.file as file from "implicit-symbol" as catalog where catalog.kind = "module-global" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let candidates = select l.call as call, l.id as id, l.name as name, l.file as file, l.span as span from special_names as l join catalog as r on l.name = r.name and l.file = r.file;
let read_events = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "read";
let anchored = select l.call as call, l.id as id, l.name as name, l.file as file, l.span as span, r.scope as scope, r.phase as phase, r.ordinal as ordinal from candidates as l join read_events as r on l.id = r.id and l.name = r.name and l.file = r.file;
let scopes = select child as id, file from "scope";
let scope_ancestors = axis(from=anchored, relation="semantic-child", direction=ancestor, domain=scopes);
let visible_scopes = select l.call as call, l.id as id, l.name as name, l.file as file, l.span as span, r.related as lookup_scope, l.phase as phase, l.ordinal as ordinal from anchored as l join scope_ancestors as r on l.id = r.id and l.file = r.file;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_ancestors = select l.call as call, l.id as id, l.name as name, l.file as file, l.span as span, l.lookup_scope as lookup_scope, l.phase as phase, l.ordinal as ordinal from visible_scopes as l join class_scopes as r on l.lookup_scope = r.id and l.file = r.file;
let nearest_scope = axis(from=anchored, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let current_class = select l.id as id, r.related as lookup_scope, l.file as file from anchored as l join nearest_scope as r on l.id = r.id and l.file = r.file;
let visible_current_class = select l.call as call, l.id as id, l.name as name, l.file as file, l.span as span, l.lookup_scope as lookup_scope, l.phase as phase, l.ordinal as ordinal from class_ancestors as l join current_class as r on l.id = r.id and l.file = r.file and l.lookup_scope = r.lookup_scope;
let nonclass_scopes = antijoin(left=visible_scopes, right=class_scopes, left-on=["lookup_scope", "file"], right-on=["id", "file"]);
let lookup_scopes = union(left=nonclass_scopes, right=visible_current_class);
let prior_events = select name, scope, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let shadowed = select l.call as call, l.id as id from lookup_scopes as l join prior_events as r on l.name = r.name and l.lookup_scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let unshadowed = antijoin(left=candidates, right=shadowed, left-on=["call", "id"], right-on=["call", "id"]);
let reportable = select id, file, span from unshadowed;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*LOG002(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:LOG002)(?:,|$)");
emit violations subject file key(id);
