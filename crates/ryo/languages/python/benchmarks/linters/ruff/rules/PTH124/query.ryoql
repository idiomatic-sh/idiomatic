import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let py_path_local = select id, file from "qualified-name" where path = "py.path.local";
let matched_functions = select l.function as id from call_functions as l join py_path_local as r on l.function = r.id;
let functions = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, r.file as file, r.span as span from matched_functions as l join functions as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PTH124)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PTH124"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
