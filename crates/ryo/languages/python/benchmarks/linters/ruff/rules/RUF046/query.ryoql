import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import round_values from "python/ruff/round-values";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let funcs = select parent, child, file from "semantic-child" where field = "func";
let call_origins_join_1 = select l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from calls as l join funcs as e on l.id = e.parent and l.file = e.file;
let call_origins = select l.l_id as id, r.path as path, l.l_file as file from call_origins_join_1 as l join "qualified-name" as r on l.e_child = r.id and l.e_file = r.file;
let round_calls = select id, file from call_origins where path = "builtins.round";
let rounded = round_values(calls=round_calls);
let int_calls = select id, file from call_origins where path = "builtins.int";
let arguments = select call, expression, position, file from "call-argument";
let counts = group-count(from=arguments, keys=["call","file"], count="count", distinct="expression");
let one_argument_calls = select l.id as id, l.file as file from int_calls as l join counts as r on l.id = r.call and l.file = r.file where r.count = 1;
let keywords = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keywords, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_calls = select related as id, file from keyword_owners;
let positional_calls = antijoin(left=one_argument_calls, right=keyword_calls, left-on=["id","file"], right-on=["id","file"]);
let outer_values = select l.id as call, r.expression as expression, l.file as file from positional_calls as l join arguments as r on l.id = r.call and l.file = r.file where r.position = 0;
let integer_atoms = select id, file from "expression-type" where resolution = "atom" and type = "integer";
let direct_integers = select l.call as id, l.file as file from outer_values as l join integer_atoms as r on l.expression = r.id and l.file = r.file;
let integer_functions = select id, file from call_origins where path = "builtins.len" or path = "builtins.id" or path = "builtins.hash" or path = "builtins.ord" or path = "builtins.int" or path = "math.comb" or path = "math.factorial" or path = "math.gcd" or path = "math.lcm" or path = "math.isqrt" or path = "math.perm" or path = "math.ceil" or path = "math.floor" or path = "math.trunc";
let round_results = select call as id, file from rounded where ndigits = "none" or integer = "true";
let integer_call_values = union(left=integer_functions, right=round_results);
let called_integers = select l.call as id, l.file as file from outer_values as l join integer_call_values as r on l.expression = r.id and l.file = r.file;
let selected = union(left=direct_integers, right=called_integers);
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF046(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF046)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:RUF046)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:RUF046)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF046"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
