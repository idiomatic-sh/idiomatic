import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let blocking_functions = select id from "qualified-name" where path = "urllib.request.urlopen" or path = "urllib3.request" or path = "httpx.request" or path = "httpx.get" or path = "httpx.post" or path = "httpx.delete" or path = "httpx.patch" or path = "httpx.put" or path = "httpx.head" or path = "httpx.connect" or path = "httpx.options" or path = "httpx.trace" or path = "requests.request" or path = "requests.get" or path = "requests.post" or path = "requests.delete" or path = "requests.patch" or path = "requests.put" or path = "requests.head" or path = "requests.connect" or path = "requests.options" or path = "requests.trace";
let blocking_calls = select l.call as id, l.call as call, l.function as function from call_functions as l join blocking_functions as r on l.function = r.id;
let scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let nearest_scopes = axis(from=blocking_calls, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let async_scopes = select id from "semantic-syntax" where kind = "async-function-def";
let call_nearest_scopes = select l.call as call, l.function as function, r.related as scope from blocking_calls as l join nearest_scopes as r on l.call = r.id;
let async_context_calls = select l.call as call, l.function as function from call_nearest_scopes as l join async_scopes as r on l.scope = r.id;
let reportable = select l.function as id, r.file as file, r.span as span from async_context_calls as l join "semantic-syntax" as r on l.function = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC210(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC210)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC210(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:ASYNC210)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "ASYNC210"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
