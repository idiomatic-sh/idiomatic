let known_tokens = select id, file, code, canonical, token_span from catalog_union_66;
let used_codes = select l.id as id, l.file as file, l.code as code from known_tokens as l join enabled_matches as r on l.id = r.directive and l.file = r.file and l.canonical = r.code;
let keyed_tokens = extend(from=known_tokens, values={pair: 0});
let keyed_external = extend(from="config.external", values={pair: 0});
let external = select l.id as id, l.file as file, l.code as code from keyed_tokens as l join keyed_external as r on l.pair = r.pair where starts_with(l.canonical, r.prefix);
let self_suppressed = select id, file from known_tokens where canonical = "RUF100";
let recognized_usage = union(left=used_codes, right=external);
let unused_codes = antijoin(left=known_tokens, right=recognized_usage, left-on=[id, file, code], right-on=[id, file, code]);
let extents = span-between(from=codes, start="marker", end="codes_span", output="directive_span");
let coded_directives = select id, file, directive_span as span from extents;
let coded_unused = select r.id as id, r.file as file, r.span as span from unused_codes as l join coded_directives as r on l.id = r.id and l.file = r.file;
let duplicate_counts = group-count(from=tokens, keys=[id, file, code], count="occurrences");
let duplicate_ids = select id, file from duplicate_counts where occurrences > 1;
let duplicates = select r.id as id, r.file as file, r.span as span from duplicate_ids as l join coded_directives as r on l.id = r.id and l.file = r.file;
let unused_coded = union(left=coded_unused, right=duplicates);
let unused = union(left=unused_blanket, right=unused_coded);
let file_self = select l.file as file from known_tokens as l join file_heads as r on l.id = r.id and l.file = r.file where l.canonical = "RUF100";
let file_enabled = antijoin(left=unused, right=file_self, left-on=[file], right-on=[file]);
let unsuppressed = antijoin(left=file_enabled, right=self_suppressed, left-on=[id, file], right-on=[id, file]);
let grouped = group-count(from=unsuppressed, keys=[id, file, span], count="matches");
let violations = select id, file, span from grouped;
emit violations subject file key(id, span);
