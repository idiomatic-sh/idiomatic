import active from "python/ruff/directive-active-file";
import code_aliases from "python/ruff/suppression-code-aliases";
import canonical_codes from "python/ruff/suppression-catalog";
import noqa_heads from "python/ruff/noqa-heads";
import noqa_codes from "python/ruff/noqa-codes";
import noqa_blankets from "python/ruff/noqa-blankets";
let heads = noqa_heads();
let file_heads = select id, file from heads where scope = 1;
let blanket_rows = noqa_blankets();
let blanket = select id, file, span from blanket_rows;
let codes = noqa_codes();
let tokens = select id, file, code, code_span as token_span from codes;
let catalog = canonical_codes();
let catalog_plain = select l.id as id,l.file as file,l.code as code,r.canonical as canonical,l.token_span as token_span from tokens as l join catalog as r on l.code=r.canonical;
let catalog_aliases = code_aliases();
let catalog_renamed = select l.id as id, l.file as file, l.code as code, r.canonical as canonical, l.token_span as token_span from tokens as l join catalog_aliases as r on l.code = r.code;
let catalog_union_66 = union(left=catalog_plain, right=catalog_renamed);
let known_tokens = select id, file, code, canonical, token_span from catalog_union_66;
let file_self_named = select l.file as file from known_tokens as l join file_heads as r on l.id = r.id and l.file = r.file where l.canonical = "RUF100";
let file_blanket_rows = select file from blanket_rows where scope = 1;
let file_self = union(left=file_self_named, right=file_blanket_rows);
let creditable_tokens = antijoin(left=known_tokens,right=file_self,left-on=[file],right-on=[file]);
let named = select file, canonical as code from creditable_tokens;
let named_enabled = select l.file as file, l.code as code from named as l join "config.selected" as r on l.code=r.code;
let creditable_blanket = antijoin(left=blanket,right=file_self,left-on=[file],right-on=[file]);
let named_matches = select r.directive as directive,r.file as file,r.code as code from named_enabled as l join suppression_matches as r on l.code=r.code and l.file=r.file;
let blanket_matches = select r.directive as directive,r.file as file,r.code as code from creditable_blanket as l join suppression_matches as r on l.id=r.directive and l.file=r.file;
let selected_blankets = select l.directive as directive,l.file as file,l.code as code from blanket_matches as l join "config.selected" as r on l.code=r.code;
let selected_matches = union(left=named_matches,right=selected_blankets);
let enabled_matches = antijoin(left=selected_matches, right="config.disabled", left-on=[file, code], right-on=[file, code]);
let used = select directive as id, file from enabled_matches;
let unused_blanket = antijoin(left=blanket, right=used, left-on=[id, file], right-on=[id, file]);
let used_codes = select l.id as id, l.file as file, l.code as code from known_tokens as l join enabled_matches as r on l.id = r.directive and l.file = r.file and l.canonical = r.code;
let keyed_tokens = extend(from=known_tokens, values={pair: 0});
let keyed_external = extend(from="config.external", values={pair: 0});
let external = select l.id as id, l.file as file, l.code as code from keyed_tokens as l join keyed_external as r on l.pair = r.pair where starts_with(l.canonical, r.prefix);
let self_suppressed = select id, file from known_tokens where canonical = "RUF100";
let recognized_usage = union(left=used_codes, right=external);
let unused_codes = antijoin(left=known_tokens, right=recognized_usage, left-on=[id, file, code], right-on=[id, file, code]);
let extents = span-between(from=codes, start="marker", end="codes_span", output="directive_span");
let coded_directives = select id, file, directive_span as span from extents;
let coded_unused = select r.id as id, r.file as file, r.span as span from unused_codes as l join coded_directives as r on l.id = r.id and l.file = r.file;
let duplicate_counts = group-count(from=tokens, keys=[id, file, code], count="occurrences");
let duplicate_ids = select id, file from duplicate_counts where occurrences > 1;
let duplicates = select r.id as id, r.file as file, r.span as span from duplicate_ids as l join coded_directives as r on l.id = r.id and l.file = r.file;
let unused_coded = union(left=coded_unused, right=duplicates);
let unused = union(left=unused_blanket, right=unused_coded);
let file_enabled = antijoin(left=unused, right=file_self, left-on=[file], right-on=[file]);
let unsuppressed = antijoin(left=file_enabled, right=self_suppressed, left-on=[id, file], right-on=[id, file]);
let grouped = group-count(from=unsuppressed, keys=[id, file, span], count="matches");
let violations = select id, file, span from grouped;
let active_files=active();
let active_violations=select r.id as id,r.file as file,r.span as span from active_files as l join violations as r on l.file=r.file;
emit active_violations subject file key(id, span);
