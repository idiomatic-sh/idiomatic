import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let int_functions = select id, file from "qualified-name" where path = "builtins.int";
let int_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join int_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_edges = select parent, child, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, r.child as argument, l.file as file from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let argument_counts = group-count(from=positional_args, keys=["call", "file"], count="argument_count", distinct="argument");
let two_argument_calls = select call, file from argument_counts where argument_count = 2;
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let keyword_rows = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let calls_with_keywords = select call, file from keyword_rows;
let no_keyword_calls = antijoin(left=two_argument_calls, right=calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let argument_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from positional_args as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let prior_argument_pairs = select l.call as call, l.argument as later, r.argument as earlier, l.file as file from argument_locations as l join argument_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let later_arguments = select call, later as argument, file from prior_argument_pairs;
let first_arguments = antijoin(left=positional_args, right=later_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let second_arguments = select l.call as call, l.later as argument, l.file as file from prior_argument_pairs as l;
let positional_base_candidates = select call, file, argument as base from second_arguments;
let single_argument_calls = select call, file from argument_counts where argument_count = 1;
let call_keywords = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_name_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_rows = select l.call as call, l.file as file, l.keyword as keyword, r.child as name_id from call_keywords as l join keyword_name_edges as r on l.keyword = r.parent and l.file = r.file;
let named_base_keywords = select l.call as call, l.file as file, l.keyword as keyword from named_keyword_rows as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "base";
let keyword_value_edges = select parent, child, file from "semantic-child" where field = "value";
let named_base_values = select l.call as call, l.file as file, r.child as base from named_base_keywords as l join keyword_value_edges as r on l.keyword = r.parent and l.file = r.file;
let keyword_counts = group-count(from=call_keywords, keys=["call", "file"], count="keyword_count", distinct="keyword");
let one_base_keyword_calls = select l.call as call, l.file as file from single_argument_calls as l join keyword_counts as r on l.call = r.call and l.file = r.file where r.keyword_count = 1;
let positional_eligible_calls = select l.call as call, l.file as file, l.span as span from int_calls as l join no_keyword_calls as r on l.call = r.call and l.file = r.file;
let keyword_eligible_calls = select l.call as call, l.file as file, l.span as span from int_calls as l join one_base_keyword_calls as r on l.call = r.call and l.file = r.file;
let eligible_calls = union(left=positional_eligible_calls, right=keyword_eligible_calls);
let keyword_base_candidates = select l.call as call, l.file as file, l.base as base from named_base_values as l join one_base_keyword_calls as r on l.call = r.call and l.file = r.file;
let all_base_candidates = union(left=positional_base_candidates, right=keyword_base_candidates);
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let first_subscripts = select l.call as call, l.file as file, l.argument as subscript from first_arguments as l join subscript_nodes as r on l.argument = r.id and l.file = r.file;
let slice_edges = select parent, child, file from "semantic-child" where field = "slice";
let call_slices = select l.call as call, l.file as file, r.child as slice from first_subscripts as l join slice_edges as r on l.subscript = r.parent and l.file = r.file;
let slice_nodes = select id, file from "semantic-syntax" where kind = "slice";
let valid_slices = select l.call as call, l.file as file, l.slice as slice from call_slices as l join slice_nodes as r on l.slice = r.id and l.file = r.file;
let lower_edges = select parent, child, file from "semantic-child" where field = "lower";
let lower_values = select l.call as call, l.file as file, r.child as lower from valid_slices as l join lower_edges as r on l.slice = r.parent and l.file = r.file;
let literal_properties = select id, file, span, kind from "literal-properties" where kind = "integer";
let number_tokens = select id, file, span, text from "semantic-syntax" where kind = "number";
let integer_values = select l.id as id, l.file as file, r.text as text from literal_properties as l join number_tokens as r on l.span = r.span and l.file = r.file;
let lower_twos = select l.call as call, l.file as file from lower_values as l join integer_values as r on l.lower = r.id and l.file = r.file where matches(r.text, "^(?:2|0[xX]_?2|0[oO]_?2|0[bB]_?1_?0)$");
let upper_edges = select parent, child, file from "semantic-child" where field = "upper";
let step_edges = select parent, child, file from "semantic-child" where field = "step";
let slices_with_upper = select l.call as call, l.file as file from valid_slices as l join upper_edges as r on l.slice = r.parent and l.file = r.file;
let slices_with_step = select l.call as call, l.file as file from valid_slices as l join step_edges as r on l.slice = r.parent and l.file = r.file;
let empty_upper = antijoin(left=valid_slices, right=slices_with_upper, left-on=["call", "file"], right-on=["call", "file"]);
let empty_step = antijoin(left=valid_slices, right=slices_with_step, left-on=["call", "file"], right-on=["call", "file"]);
let unbounded_slices = select l.call as call, l.file as file from empty_upper as l join empty_step as r on l.call = r.call and l.file = r.file;
let valid_slice_calls = select l.call as call, l.file as file from lower_twos as l join unbounded_slices as r on l.call = r.call and l.file = r.file;
let base_arguments = select l.call as call, l.file as file, l.base as base from all_base_candidates as l join integer_values as r on l.base = r.id and l.file = r.file where matches(r.text, "^(?:2|8|16|0[xX]_?(?:2|8|10)|0[oO]_?(?:2|10|20)|0[bB]_?(?:1_?0|1_?0_?0|1_?0_?0_?0))$");
let valid_base_calls = select l.call as call, l.file as file from base_arguments as l join valid_slice_calls as r on l.call = r.call and l.file = r.file;
let candidates_rows = select l.call as call, l.file as file, r.span as span from valid_base_calls as l join eligible_calls as r on l.call = r.call and l.file = r.file;
let candidate_locations = select l.call as id, l.file as file, l.span as span, r."start-line" as line from candidates_rows as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB166(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB166)(?:,|$)");
emit violations subject file key(id);
