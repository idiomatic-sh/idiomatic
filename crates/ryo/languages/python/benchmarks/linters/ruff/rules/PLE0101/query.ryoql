import suppress from "python/ruff/suppress";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let name_edges = select parent as function, child as name from "semantic-child" where field = "name";
let function_name_nodes = select l.id as function, l.file as file, r.name as name_node from functions as l join name_edges as r on l.id = r.function;
let named_functions = select l.function as function, l.file as file, r.name as name, r.id as name_id, r.span as name_span from function_name_nodes as l join "identifier" as r on l.name_node = r.id and l.file = r.file;
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let scope_edges = select child, parent, file from "scope";
let method_scopes = select l.child as function, l.file as file from scope_edges as l join classes as r on l.parent = r.id and l.file = r.file;
let named_methods = select l.function as function, l.file as file, l.name as name, l.name_id as name_id, l.name_span as name_span from named_functions as l join method_scopes as r on l.function = r.function and l.file = r.file;
let decorators = select occurrence as decorator, declaration as function, file from "decorates";
let decorator_roots = select l.function as function, l.file as file, r.child as expression from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_decorator_origins = select l.function as function, l.file as file, r.path as path from decorator_roots as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let callable_edges = select parent, child from "semantic-child" where field = "func";
let decorator_callables = select l.function as function, l.file as file, r.child as callable from decorator_roots as l join callable_edges as r on l.expression = r.parent;
let called_decorator_origins = select l.function as function, l.file as file, r.path as path from decorator_callables as l join "qualified-name" as r on l.callable = r.id and l.file = r.file;
let decorator_origins = union(left=direct_decorator_origins, right=called_decorator_origins);
let static_decorators = select function, file from decorator_origins where path = "builtins.staticmethod" or path = "abc.abstractstaticmethod";
let class_decorators = select function, file from decorator_origins where path = "builtins.classmethod" or path = "abc.abstractclassmethod";
let non_instance_decorators = union(left=static_decorators, right=class_decorators);
let instance_methods = antijoin(left=named_methods, right=non_instance_decorators, left-on=["function","file"], right-on=["function","file"]);
let init_methods = select function, file from instance_methods where name = "__init__";
let lexical_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let body_edges = select parent as owner, child as id, file from "semantic-child" where field = "body";
let body_scopes = select l.id as id, l.owner as owner, l.file as file from body_edges as l join lexical_scopes as r on l.owner = r.id and l.file = r.file;
let call_argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let class_argument_edges = select l.child as id, l.file as file from "semantic-child" as l join classes as r on l.parent = r.id and l.file = r.file;
let class_type_roots = select l.id as id, l.id as owner, l.file as file from class_argument_edges as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from "semantic-syntax" where kind = "arg";
let annotation_roots = select l.child as id, l.child as owner, l.file as file from "semantic-child" as l join parameter_nodes as r on l.parent = r.id and l.file = r.file where l.field = "annotation";
let return_annotation_roots = select l.child as id, l.child as owner, l.file as file from "semantic-child" as l join functions as r on l.parent = r.id and l.file = r.file where l.field = "returns";
let function_type_roots = union(left=annotation_roots, right=return_annotation_roots);
let type_roots = union(left=class_type_roots, right=function_type_roots);
let scope_bodies = union(left=body_scopes, right=type_roots);
let returns = select id, file, span from "semantic-syntax" where kind = "return";
let value_edges = select parent, child from "semantic-child" where field = "value";
let valued_returns = select l.id as id, l.file as file, l.span as span, r.child as value from returns as l join value_edges as r on l.id = r.parent;
let null_literals = select id, file from "literal-properties" where kind = "null";
let nonnull_returns = antijoin(left=valued_returns, right=null_literals, left-on=["value","file"], right-on=["id","file"]);
let raw_candidates = select id, file, span from nonnull_returns;
let direct_owners = select l.id as id, l.file as file, l.span as span, r.owner as function from raw_candidates as l join scope_bodies as r on l.id = r.id and l.file = r.file;
let nearest_bodies = axis(from=raw_candidates, relation="semantic-child", direction=nearest-ancestor, domain=scope_bodies);
let ancestor_owners = select l.id as id, l.file as file, l.span as span, r.owner as function from nearest_bodies as l join scope_bodies as r on l.related = r.id and l.file = r.file;
let indirect_owners = antijoin(left=ancestor_owners, right=direct_owners, left-on=["id","file"], right-on=["id","file"]);
let evaluated_owners = union(left=direct_owners, right=indirect_owners);
let candidates = select l.id as id, l.file as file, l.span as span from evaluated_owners as l join init_methods as r on l.function = r.function and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLE0101(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE0101)(?:,|$)");
emit violations subject file key(id);
