import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let edges = select parent, child, field, file from "semantic-child";
let calls = select id, file from nodes where kind = "call";
let attributes = select id, file from nodes where kind = "attribute";
let call_functions = select l.id as call, r.child as attribute, l.file as file from calls as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "func";
let attribute_calls = select l.call as call, l.attribute as attribute, l.file as file from call_functions as l join attributes as r on l.attribute = r.id and l.file = r.file;
let attribute_names = select l.call as call, l.attribute as attribute, r.child as name, l.file as file from attribute_calls as l join edges as r on l.attribute = r.parent and l.file = r.file where r.field = "attr";
let keys_calls = select l.call as call, l.attribute as attribute, l.file as file from attribute_names as l join "identifier" as r on l.name = r.id and l.file = r.file where r.name = "keys";
let receivers = select l.call as call, r.child as receiver, l.file as file from keys_calls as l join edges as r on l.attribute = r.parent and l.file = r.file where r.field = "value";
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let call_children = select l.call as call, r.child as wrapper, l.file as file from receivers as l join edges as r on l.call = r.parent and l.file = r.file;
let call_wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from call_children as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let nonempty = select l.call as call, l.file as file from call_wrappers as l join edges as r on l.wrapper = r.parent and l.file = r.file where r.field = "args" or r.field = "keywords";
let empty_calls = antijoin(left=receivers, right=nonempty, left-on=["call", "file"], right-on=["call", "file"]);
let names = select id, file from nodes where kind = "name";
let self_names = select l.id as name, l.file as file from names as l join "identifier" as r on l.id = r.id and l.file = r.file where r.name = "self";
let self_calls = select l.call as call, l.file as file from empty_calls as l join self_names as r on l.receiver = r.name and l.file = r.file;
let eligible_calls = antijoin(left=empty_calls, right=self_calls, left-on=["call", "file"], right-on=["call", "file"]);
let comparisons = select id, file, span from nodes where kind = "compare";
let comparison_ops = select l.id as id, r.child as op, l.file as file from comparisons as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "ops";
let in_ops = select l.id as id, l.file as file from comparison_ops as l join "semantic-syntax" as r on l.op = r.id and l.file = r.file where r.text = "in";
let comparison_rights = select l.id as id, r.child as call, l.file as file from comparisons as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "comparators";
let right_counts = group-count(from=comparison_rights, keys=["id", "file"], count="count", distinct="call");
let one_right = select l.id as id, l.call as call, l.file as file from comparison_rights as l join right_counts as r on l.id = r.id and l.file = r.file where r.count = 1;
let valid_rights = select l.id as id, l.file as file from one_right as l join eligible_calls as r on l.call = r.call and l.file = r.file;
let valid_compares = select l.id as id, l.file as file from valid_rights as l join in_ops as r on l.id = r.id and l.file = r.file;
let compare_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from valid_compares as l join "source-location" as r on l.id = r.id and l.file = r.file;
let iterators = select id, file from nodes where kind = "for" or kind = "comprehension";
let iterator_targets = select l.id as id, r.child as target, l.file as file from iterators as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "target";
let iterator_values = select l.id as id, r.child as call, l.file as file from iterators as l join edges as r on l.id = r.parent and l.file = r.file where r.field = "iter";
let valid_iters = select l.id as id, l.target as target, r.call as call, l.file as file from iterator_targets as l join iterator_values as r on l.id = r.id and l.file = r.file;
let reportable_iters = select l.id as id, l.target as target, l.call as call, l.file as file from valid_iters as l join eligible_calls as r on l.call = r.call and l.file = r.file;
let target_spans = select l.id as id, l.call as call, l.file as file, r.span as first_span, r."start-line" as line from reportable_iters as l join "source-location" as r on l.target = r.id and l.file = r.file;
let bounds = select l.id as id, l.file as file, l.first_span as first_span, r.span as last_span, l.line as line from target_spans as l join nodes as r on l.call = r.id and l.file = r.file;
let raw_iter_candidates = span-between(from=bounds, start="first_span", end="last_span", output="span");
let loop_nodes = select id, file from nodes where kind = "for";
let loop_iters = select l.id as id, l.call as call, l.file as file from reportable_iters as l join loop_nodes as r on l.id = r.id and l.file = r.file;
let loop_children = select l.id as statement, l.call as call, r.child as child, l.file as file from loop_iters as l join "syntax-child" as r on l.id = r.parent and l.file = r.file;
let closing_tokens = select id, file from "syntax-tree" where text = ")";
let colon_tokens = select id, file from "syntax-tree" where text = ":";
let loop_closings = select l.statement as statement, l.call as call, l.child as closing, l.file as file from loop_children as l join closing_tokens as r on l.child = r.id and l.file = r.file;
let loop_colons = select l.statement as statement, l.child as colon, l.file as file from loop_children as l join colon_tokens as r on l.child = r.id and l.file = r.file;
let closing_positions = select l.statement as statement, l.call as call, r."start-byte" as start, r."end-byte" as end, r.span as span, l.file as file from loop_closings as l join "source-location" as r on l.closing = r.id and l.file = r.file;
let colon_positions = select l.statement as statement, r."start-byte" as start, l.file as file from loop_colons as l join "source-location" as r on l.colon = r.id and l.file = r.file;
let call_ends = select l.id as statement, r."end-byte" as end, l.file as file from loop_iters as l join "source-location" as r on l.call = r.id and l.file = r.file;
let after_call_closings = select l.statement as statement, l.end as end, l.span as span, l.file as file from closing_positions as l join call_ends as r on l.statement = r.statement and l.file = r.file where l.start >= r.end;
let header_closings = select l.statement as statement, l.end as end, l.span as span, l.file as file from after_call_closings as l join colon_positions as r on l.statement = r.statement and l.file = r.file where l.end <= r.start;
let earlier_closings = select l.statement as statement, l.end as end, l.file as file from header_closings as l join header_closings as r on l.statement = r.statement and l.file = r.file where l.end < r.end;
let last_closings = antijoin(left=header_closings, right=earlier_closings, left-on=["statement", "end", "file"], right-on=["statement", "end", "file"]);
let wrapped_bounds = select l.id as id, l.file as file, l.first_span as first_span, r.span as last_span, l.line as line from target_spans as l join last_closings as r on l.id = r.statement and l.file = r.file;
let wrapped_candidates = span-between(from=wrapped_bounds, start="first_span", end="last_span", output="span");
let wrapped_ids = select id, file from wrapped_candidates;
let plain_candidates = antijoin(left=raw_iter_candidates, right=wrapped_ids, left-on=["id", "file"], right-on=["id", "file"]);
let plain_iter_candidates = select id, file, span, line from plain_candidates;
let wrapped_iter_candidates = select id, file, span, line from wrapped_candidates;
let iter_candidates = union(left=plain_iter_candidates, right=wrapped_iter_candidates);
let all_candidates = union(left=compare_candidates, right=iter_candidates);
let violations = suppress(candidates=all_candidates, inline-pattern="(?:^|[^A-Z0-9])SIM118(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM118)(?:,|$)");
let ruf100_matches = observation_matches(candidates=all_candidates, inline-pattern="(?:^|[^A-Z0-9])SIM118(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM118)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM118"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
