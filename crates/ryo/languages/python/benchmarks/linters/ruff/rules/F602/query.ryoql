import observation_matches from "python/ruff/suppress-matches";
let dictionaries = select id, file from "semantic-syntax" where kind = "dict";
let key_fields = select parent, child, ordinal from "semantic-child" where field = "keys";
let dictionary_keys = select l.id as dictionary, r.child as key, r.ordinal as ordinal from dictionaries as l join key_fields as r on l.id = r.parent;
let ordered_key_pairs = select l.dictionary as dictionary, l.key as earlier, r.key as later from dictionary_keys as l join dictionary_keys as r on l.dictionary = r.dictionary where l.ordinal < r.ordinal;
let name_nodes = select id from "semantic-syntax" where kind = "name";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let name_fields = select parent, child from "semantic-child" where field = "id";
let named_nodes = select l.parent as id, r.text as name from name_fields as l join semantic_identifiers as r on l.child = r.id;
let earlier_named_keys = select l.dictionary as dictionary, l.earlier as earlier, l.later as later, r.name as name from ordered_key_pairs as l join named_nodes as r on l.earlier = r.id;
let repeated_name_pairs = select l.later as id from earlier_named_keys as l join named_nodes as r on l.later = r.id and l.name = r.name;
let repeated_name_counts = group-count(from=repeated_name_pairs, keys=["id"], count="count", distinct="id");
let repeated_names = select id from repeated_name_counts;
let reportable = select l.id as id, r.file as file, r.span as span from repeated_names as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F602)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F602"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
