import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_fields as l join calls as r on l.parent = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let attr_values = select l.id as attribute, l.file as file, r.child as receiver from attributes as l join value_fields as r on l.id = r.parent and l.file = r.file;
let string_values = select occurrence as receiver, file from "string-literal";
let literal_receivers = select l.attribute as attribute, l.file as file, r.receiver as receiver from attr_values as l join string_values as r on l.receiver = r.receiver and l.file = r.file;
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let attr_children = select l.attribute as attribute, l.file as file, r.child as name_id from literal_receivers as l join attr_fields as r on l.attribute = r.parent and l.file = r.file;
let format_attributes = select l.attribute as attribute, l.file as file from attr_children as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "format";
let format_calls = select l.call as call, l.function as function, l.file as file, l.span as span from call_functions as l join format_attributes as r on l.function = r.attribute and l.file = r.file;
let literal_links = select l.attribute as attribute, r.receiver as format_id, l.file as file from format_attributes as l join literal_receivers as r on l.attribute = r.attribute and l.file = r.file;
let format_calls_with_literal = select l.call as call, l.file as file, l.span as span, r.format_id as format_id from format_calls as l join literal_links as r on l.function = r.attribute and l.file = r.file;
let parse_all = select id, file, representation, outcome, "automatic-count" as automatic_count, "keyword-count" as keyword_count, "nested-field-count" as nested_count, "indexed-count" as indexed_count from "brace-format-parse";
let parse_rows = select id, file from parse_all where representation = "decoded-string" and outcome = "parsed" and automatic_count = 0 and keyword_count = 0 and nested_count = 0 and indexed_count > 0;
let parsed_calls = select l.call as call, l.file as file, l.span as span, l.format_id as format_id from format_calls_with_literal as l join parse_rows as r on l.format_id = r.id and l.file = r.file;
let fields_all = select id as format_id, ordinal, "selector-index" as position, file, "selector-kind" as selector_kind, "index-overflow" as index_overflow from "brace-format-field";
let fields = select format_id, ordinal, position, file from fields_all where selector_kind = "index" and index_overflow = "false";
let counts = group-count(from=fields, keys=["format_id", "file"], count="count", distinct="ordinal");
let unique_counts = group-count(from=fields, keys=["format_id", "file"], count="unique_count", distinct="position");
let all_counts = select l.format_id as format_id, l.file as file, l.count as count, r.unique_count as unique_count from counts as l join unique_counts as r on l.format_id = r.format_id and l.file = r.file;
let high_fields = select l.format_id as format_id, l.file as file from fields as l join counts as r on l.format_id = r.format_id and l.file = r.file where l.position >= r.count;
let distinct_fields = select format_id, file, count from all_counts where count = unique_count;
let contiguous = antijoin(left=distinct_fields, right=high_fields, left-on=["format_id", "file"], right-on=["format_id", "file"]);
let overflow = select format_id, file from fields_all where index_overflow = "true";
let no_overflow = antijoin(left=contiguous, right=overflow, left-on=["format_id", "file"], right-on=["format_id", "file"]);
let possible_calls = select l.call as call, l.file as file, l.span as span, l.format_id as format_id, r.count as count from parsed_calls as l join no_overflow as r on l.format_id = r.format_id and l.file = r.file;
let out_of_order_fields = select format_id, file from fields where ordinal != position;
let reordered = select l.call as call, l.file as file, l.span as span, l.count as count from possible_calls as l join out_of_order_fields as r on l.format_id = r.format_id and l.file = r.file;
let ordered = antijoin(left=possible_calls, right=reordered, left-on=["call", "file"], right-on=["call", "file"]);
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let call_wrappers = select l.call as call, r.wrapper as wrapper, l.file as file, l.count as count from reordered as l join argument_owners as r on l.call = r.call and l.file = r.file;
let positional = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file, l.count as count from call_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let keywords = select l.call as call, l.file as file from call_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let arg_counts = group-count(from=positional, keys=["call", "file"], count="arg_count", distinct="argument");
let enough = select l.call as call, l.file as file from reordered as l join arg_counts as r on l.call = r.call and l.file = r.file where r.arg_count >= l.count;
let earlier = select l.call as call, l.argument as argument, r.argument as predecessor, l.file as file from positional as l join positional as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let ranks = group-count(from=earlier, keys=["call", "argument", "file"], count="rank", distinct="predecessor");
let firsts0 = antijoin(left=positional, right=ranks, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let firsts1 = select call, argument, file from firsts0;
let firsts = extend(from=firsts1, values={rank: 0});
let ranked = union(left=ranks, right=firsts);
let early_args = select l.call as call, l.argument as argument, l.file as file from ranked as l join reordered as r on l.call = r.call and l.file = r.file where l.rank < r.count;
let stars = select id, file from "semantic-syntax" where kind = "starred";
let early_stars = select l.call as call, l.file as file from early_args as l join stars as r on l.argument = r.id and l.file = r.file;
let invalid0 = union(left=keywords, right=early_stars);
let safe_reorder = antijoin(left=enough, right=invalid0, left-on=["call", "file"], right-on=["call", "file"]);
let ordered_ids = select call as id, file from ordered;
let reorder_ids = select call as id, file from safe_reorder;
let ids = union(left=ordered_ids, right=reorder_ids);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from ids as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP030(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP030)(?:,|$)");
emit violations subject file key(id);
