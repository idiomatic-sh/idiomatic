import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let nodes = select id, kind, file from "semantic-syntax";
let stop_names = select id, file from "qualified-name" where path = "builtins.StopIteration";
let exc_fields = select parent, child, file from "semantic-child" where field = "exc";
let raises = select id, file from nodes where kind = "raise";
let raise_exceptions = select l.parent as raise, l.child as exception, l.file as file from exc_fields as l join raises as r on l.parent = r.id and l.file = r.file;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let bare_exceptions = antijoin(left=raise_exceptions, right=calls, left-on=["exception", "file"], right-on=["id", "file"]);
let bare_values = select raise, exception as value, file from bare_exceptions;
let called_values = select l.raise as raise, r.child as value, l.file as file from raise_exceptions as l join "semantic-child" as r on l.exception = r.parent and l.file = r.file where r.field = "func";
let exception_values = union(left=bare_values, right=called_values);
let stop_identifiers = select id, file from "identifier" where name = "StopIteration";
let name_nodes = select id, file from nodes where kind = "name";
let stop_name_ids = select l.id as id, l.file as file from stop_identifiers as l join name_nodes as r on l.id = r.id and l.file = r.file;
let name_values = select l.raise as raise, l.file as file from exception_values as l join stop_name_ids as r on l.value = r.id and l.file = r.file;
let other_values = antijoin(left=exception_values, right=stop_name_ids, left-on=["value", "file"], right-on=["id", "file"]);
let qualified_values = select l.raise as raise, l.value as value, l.file as file from other_values as l join stop_names as r on l.value = r.id and l.file = r.file;
let value_fields = select parent, child, file from "semantic-child" where field = "value";
let attribute_roots = select l.raise as raise, r.child as root, l.file as file from qualified_values as l join value_fields as r on l.value = r.parent and l.file = r.file;
let plain_roots = select l.raise as raise, l.value as root, l.file as file from qualified_values as l join name_nodes as r on l.value = r.id and l.file = r.file;
let qualified_roots = union(left=attribute_roots, right=plain_roots);
let root_events = select l.raise as raise, r.scope as scope, r.ordinal as ordinal, l.file as file from qualified_roots as l join "binding-resolution" as r on l.root = r.reference and l.file = r.file;
let name_raises = select raise as id, file from name_values;
let qualified_raises = select raise as id, file from qualified_values;
let stop_raises = union(left=name_raises, right=qualified_raises);
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let lambdas = select id, file from nodes where kind = "lambda";
let boundaries = union(left=functions, right=lambdas);
let body_statements = select l.id as function, r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_ids = select id, file from body_statements;
let embedded_roots = select root as id, file from "embedded-expression";
let walls = union(left=boundaries, right=embedded_roots);
let member_marks = union(left=walls, right=body_ids);
let raise_axes = axis(from=stop_raises, relation="semantic-child", direction=nearest-ancestor, domain=member_marks);
let raise_marks0 = select id, related as mark, file from raise_axes;
let raise_marks = antijoin(left=raise_marks0, right=walls, left-on=["mark", "file"], right-on=["id", "file"]);
let own_marks = select l.id as id, l.id as mark, l.file as file from stop_raises as l join body_ids as r on l.id = r.id and l.file = r.file;
let raise_statements = union(left=raise_marks, right=own_marks);
let raise_owners = select l.id as id, r.function as function, l.file as file from raise_statements as l join body_statements as r on l.mark = r.id and l.file = r.file;
let yield_nodes = select id, file from nodes where kind = "yield" or kind = "yield-from";
let yields = antijoin(left=yield_nodes, right=embedded_roots, left-on=["id", "file"], right-on=["id", "file"]);
let yield_axes = axis(from=yields, relation="semantic-child", direction=nearest-ancestor, domain=member_marks);
let yield_marks0 = select id, related as mark, file from yield_axes;
let yield_marks = antijoin(left=yield_marks0, right=walls, left-on=["mark", "file"], right-on=["id", "file"]);
let yield_owners = select l.id as id, r.function as function, l.file as file from yield_marks as l join body_statements as r on l.mark = r.id and l.file = r.file;
let generator_functions = select function, file from yield_owners;
let def_events = select occurrence as function, scope, ordinal as point, file from "binding-event" where kind = "bind";
let generator_raises = select l.id as id, l.function as function, l.file as file from raise_owners as l join generator_functions as r on l.function = r.function and l.file = r.file;
let qualified_reports0 = select l.id as id, l.function as function, l.file as file from generator_raises as l join qualified_raises as r on l.id = r.id and l.file = r.file;
let qualified_points = select l.id as id, l.function as function, r.point as point, l.file as file from qualified_reports0 as l join def_events as r on l.function = r.function and l.file = r.file;
let unseen_roots = select l.id as id, l.file as file from qualified_points as l join root_events as r on l.id = r.raise and l.file = r.file where r.scope = l.function or r.ordinal > l.point;
let qualified_reports1 = select id, file from qualified_reports0;
let qualified_reports = antijoin(left=qualified_reports1, right=unseen_roots, left-on=["id", "file"], right-on=["id", "file"]);
let name_reports0 = select l.id as id, l.function as function, l.file as file from generator_raises as l join name_raises as r on l.id = r.id and l.file = r.file;
let name_points = select l.id as id, l.function as function, r.scope as scope, r.point as point, l.file as file from name_reports0 as l join def_events as r on l.function = r.function and l.file = r.file;
let stop_events = select occurrence, scope, ordinal, file from "binding-event" where name = "StopIteration" and kind = "bind";
let shadowed_here = select l.id as id, l.file as file from name_points as l join stop_events as r on l.scope = r.scope and l.file = r.file where r.ordinal < l.point;
let stop_scopes = select scope as id, file from stop_events;
let classes = select id, file from nodes where kind = "class-def";
let name_functions = select function as id, file from name_points;
let enclosing_axes = axis(from=name_functions, relation="semantic-child", direction=ancestor, domain=stop_scopes);
let enclosing0 = select id as function, related as scope, file from enclosing_axes;
let enclosing = antijoin(left=enclosing0, right=classes, left-on=["scope", "file"], right-on=["id", "file"]);
let enclosing_points = select l.id as id, r.scope as scope, l.point as point, l.file as file from name_points as l join enclosing as r on l.function = r.function and l.file = r.file;
let shadowed_above = select l.id as id, l.file as file from enclosing_points as l join stop_events as r on l.scope = r.scope and l.file = r.file where r.ordinal < l.point;
let shadowed = union(left=shadowed_here, right=shadowed_above);
let name_reports1 = select id, file from name_reports0;
let name_reports = antijoin(left=name_reports1, right=shadowed, left-on=["id", "file"], right-on=["id", "file"]);
let reportable_rows = union(left=qualified_reports, right=name_reports);
let reportable_groups = group-count(from=reportable_rows, keys=["id", "file"], count="count", distinct="id");
let reportable = select id, file from reportable_groups;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PLR1708)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1708"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
