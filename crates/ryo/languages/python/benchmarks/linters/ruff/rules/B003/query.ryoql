import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let assignments = select id from "semantic-syntax" where kind = "assign";
let targets = select parent, child from "semantic-child" where field = "targets";
let target_counts = group-count(from=targets, keys=["parent"], count="count", distinct="child");
let single = select parent from target_counts where count = 1;
let assignment_targets = select r.parent as parent, r.child as child from assignments as l join targets as r on l.id = r.parent;
let single_targets = select l.child as id from assignment_targets as l join single as r on l.parent = r.parent;
let attributes = select id, file, span from "semantic-syntax" where kind = "attribute";
let values = select parent, child from "semantic-child" where field = "value";
let names = select parent, child from "semantic-child" where field = "id";
let os_tokens = select id from semantic_identifiers where text = "os";
let os_names = select l.parent as id from names as l join os_tokens as r on l.child = r.id;
let on_os = select l.parent as id from values as l join os_names as r on l.child = r.id;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let environ_tokens = select id from semantic_identifiers where text = "environ";
let environ_attributes = select l.parent as id from attr_tokens as l join environ_tokens as r on l.child = r.id;
let os_environ = select l.id as id from on_os as l join environ_attributes as r on l.id = r.id;
let invalid = select l.id as id from single_targets as l join os_environ as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from attributes as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B003(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B003)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:B003)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B003)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B003"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
