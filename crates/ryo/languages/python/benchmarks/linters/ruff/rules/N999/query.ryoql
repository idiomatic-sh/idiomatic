import observation_matches from "python/ruff/suppress-matches";
let identities = select file, "module-name" as module_name, "package-name" as package_name, "package-root-name" as root_name from "module-identity";
let python_sources = select file, module_name, package_name, root_name from identities where matches(file, "[.]pyi?$");
let ordinary = select file, module_name as name from python_sources where module_name != "__init__" and module_name != "__main__";
let package_files = select file, root_name as name from python_sources where module_name = "__init__" or module_name = "__main__";
let names = union(left=ordinary, right=package_files);
let migration_files = select file from python_sources where package_name = "migrations" or package_name = "versions";
let migrations = select l.file as file, l.name as name from names as l join migration_files as r on l.file = r.file;
let regular = antijoin(left=names, right=migration_files, left-on=["file"], right-on=["file"]);
let valid_regular = select file, name from regular where matches(name, "^[a-z_][a-z0-9_]*$");
let invalid_regular = antijoin(left=regular, right=valid_regular, left-on=["file","name"], right-on=["file","name"]);
let valid_migrations = select file, name from migrations where matches(name, "^[a-z0-9_]*$");
let invalid_migrations = antijoin(left=migrations, right=valid_migrations, left-on=["file","name"], right-on=["file","name"]);
let keywords = select file, name from names where matches(name, "^(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$");
let invalid0 = union(left=invalid_regular, right=invalid_migrations);
let invalid = union(left=invalid0, right=keywords);
let allowed_defaults = select file from invalid where matches(name, "^(?:setUp|tearDown|setUpClass|tearDownClass|setUpModule|tearDownModule|asyncSetUp|asyncTearDown|setUpTestData|failureException|longMessage|maxDiff)$");
let reportable = antijoin(left=invalid, right=allowed_defaults, left-on=["file"], right-on=["file"]);
let modules = select id, file, span from "syntax-tree" where kind = "module";
let origins = source-matches(from=modules, span="span", pattern="^", output="point");
let points = select id, file, point as span from origins;
let located_points = extend(from=points, values={line: 1});
let candidates = select l.id as id, l.file as file, l.span as span, l.line as line from located_points as l join reportable as r on l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:N999)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "N999"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
