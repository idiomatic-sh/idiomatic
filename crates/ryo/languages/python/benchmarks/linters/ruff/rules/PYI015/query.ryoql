import observation_matches from "python/ruff/suppress-matches";
import simple_defaults from "python/ruff/simple-stub-defaults";
let nodes = select id, kind, file from "semantic-syntax";
let stubs = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let assignments0 = select l.id as id, l.kind as kind, l.file as file from nodes as l join stubs as r on l.file = r.file where l.kind = "assign" or l.kind = "ann-assign";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let in_functions = axis(from=assignments0, relation="semantic-child", direction=ancestor, domain=functions);
let assignments = antijoin(left=assignments0, right=in_functions, left-on=["id", "file"], right-on=["id", "file"]);
let targets = select l.id as assignment, r.child as target, l.kind as kind, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets" or r.field = "target";
let plain_targets = select assignment, target, file from targets where kind = "assign";
let multiple_targets = select l.assignment as assignment, l.file as file from plain_targets as l join plain_targets as r on l.assignment = r.assignment and l.file = r.file where l.target != r.target;
let single_targets = antijoin(left=plain_targets, right=multiple_targets, left-on=["assignment", "file"], right-on=["assignment", "file"]);
let named_plain = select l.assignment as assignment, l.target as target, l.file as file from single_targets as l join nodes as r on l.target = r.id and l.file = r.file where r.kind = "name";
let annotated_targets = select assignment, target, file from targets where kind = "ann-assign";
let eligible = union(left=named_plain, right=annotated_targets);
let values = select l.assignment as assignment, l.target as target, r.child as value, l.file as file from eligible as l join "semantic-child" as r on l.assignment = r.parent and l.file = r.file where r.field = "value";
let target_names = select l.assignment as assignment, r.name as name, l.file as file from values as l join "identifier" as r on l.target = r.id and l.file = r.file;
let namespaces = select id, kind, file from nodes where kind = "module" or kind = "class-def";
let owner_inputs = select assignment as id, file from values;
let owners = axis(from=owner_inputs, relation="semantic-child", direction=nearest-ancestor, domain=namespaces);
let namespace_assignments = select l.id as assignment, r.kind as kind, l.file as file from owners as l join namespaces as r on l.related = r.id and l.file = r.file;
let special_assignments = select l.assignment as assignment, l.file as file from target_names as l join namespace_assignments as r on l.assignment = r.assignment and l.file = r.file where l.name = "__all__" and r.kind = "module" or (l.name = "__slots__" or l.name = "__match_args__") and r.kind = "class-def";
let annotations = select l.assignment as assignment, r.child as annotation, l.file as file from annotated_targets as l join "semantic-child" as r on l.assignment = r.parent and l.file = r.file where r.field = "annotation";
let alias_names = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let type_alias_assignments = select l.assignment as assignment, l.file as file from annotations as l join alias_names as r on l.annotation = r.id and l.file = r.file;
let final_names = select id, file from "qualified-name" where path = "typing.Final" or path = "typing_extensions.Final";
let final_annotations = select l.assignment as assignment, l.file as file from annotations as l join final_names as r on l.annotation = r.id and l.file = r.file;
let final_value_kinds = select id, file from nodes where kind = "name" or kind = "attribute";
let final_values = select l.assignment as assignment, l.file as file from values as l join final_value_kinds as r on l.value = r.id and l.file = r.file;
let final_assignments = select l.assignment as assignment, l.file as file from final_annotations as l join final_values as r on l.assignment = r.assignment and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let call_functions = select l.id as call, r.child as function, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let typevar_names = select id, file from "qualified-name" where path = "typing.TypeVar" or path = "typing.ParamSpec" or path = "typing.TypeVarTuple" or path = "typing.NewType" or path = "typing_extensions.TypeVar" or path = "typing_extensions.ParamSpec" or path = "typing_extensions.TypeVarTuple" or path = "typing_extensions.NewType";
let typevar_calls = select l.call as id, l.file as file from call_functions as l join typevar_names as r on l.function = r.id and l.file = r.file;
let typevar_assignments = select l.assignment as assignment, l.file as file from values as l join typevar_calls as r on l.value = r.id and l.file = r.file;
let plain_value_kinds = select id, file from nodes where kind = "call" or kind = "name" or kind = "attribute" or kind = "subscript";
let plain_values = select l.assignment as assignment, r.value as value, l.file as file from named_plain as l join values as r on l.assignment = r.assignment and l.file = r.file;
let accepted_plain = select l.assignment as assignment, l.file as file from plain_values as l join plain_value_kinds as r on l.value = r.id and l.file = r.file;
let pipe_tokens = select id, file from "syntax-tree" where text = "|";
let pipes = select l.parent as id, l.file as file from "semantic-child" as l join pipe_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let pipe_edges = select l.id as parent, r.child as child, l.file as file from pipes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "left" or r.field = "right";
let pipe_nesting = select l.parent as parent, l.child as child, l.file as file from pipe_edges as l join pipes as r on l.child = r.id and l.file = r.file;
let pipe_paths = closure(edges=pipe_nesting, source="parent", destination="child", keys=["file"]);
let pipe_self = select id as root, id as pipe, file from pipes;
let pipe_descendants = select parent as root, child as pipe, file from pipe_paths;
let pipe_memberships = union(left=pipe_self, right=pipe_descendants);
let all_pipe_members = select l.root as root, r.child as member, l.file as file from pipe_memberships as l join pipe_edges as r on l.pipe = r.parent and l.file = r.file;
let pipe_leaves = antijoin(left=all_pipe_members, right=pipes, left-on=["member", "file"], right-on=["id", "file"]);
let union_atoms0 = select id, file from nodes where kind = "name" or kind = "attribute" or kind = "subscript";
let none_literals = select id, file from "literal-properties" where kind = "null";
let union_atoms = union(left=union_atoms0, right=none_literals);
let invalid_union_members = antijoin(left=pipe_leaves, right=union_atoms, left-on=["member", "file"], right-on=["id", "file"]);
let bad_unions = select root as id, file from invalid_union_members;
let valid_unions = antijoin(left=pipes, right=bad_unions, left-on=["id", "file"], right-on=["id", "file"]);
let union_assignments = select l.assignment as assignment, l.file as file from plain_values as l join valid_unions as r on l.value = r.id and l.file = r.file;
let value_expressions = select value as id, file from values;
let simple_values = simple_defaults(expressions=value_expressions);
let simple_assignments = select l.assignment as assignment, l.file as file from values as l join simple_values as r on l.value = r.id and l.file = r.file;
let exempt0 = union(left=special_assignments, right=type_alias_assignments);
let exempt1 = union(left=final_assignments, right=typevar_assignments);
let exempt2 = union(left=accepted_plain, right=union_assignments);
let exempt3 = union(left=exempt0, right=exempt1);
let exempt4 = union(left=exempt2, right=simple_assignments);
let exempt = union(left=exempt3, right=exempt4);
let invalid = antijoin(left=values, right=exempt, left-on=["assignment", "file"], right-on=["assignment", "file"]);
let candidates = select l.value as id, l.file as file, r.span as span, r."start-line" as line from invalid as l join "source-location" as r on l.value = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PYI015)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI015"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
