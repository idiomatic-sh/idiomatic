import suppress from "python/ruff/suppress";
let decorators = select id, file, span from "syntax-tree" where kind = "decorator";
let decorator_locations = select l.id as decorator, l.file as file, r."start-byte" as begin, r."end-byte" as finish from decorators as l join "source-location" as r on l.id = r.id and l.file = r.file;
let at_tokens = select id, file from "syntax-tree" where text = "@";
let at_locations = select l.id as token, l.file as file, r."start-byte" as begin, r."end-byte" as finish from at_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let at_in_decorators = select l.decorator as decorator, l.file as file, l.begin as begin, l.finish as decorator_finish, r.finish as after_at from decorator_locations as l join at_locations as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let source_tokens = select id, file, kind, text from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let token_locations = select l.id as token, l.file as file, l.kind as kind, l.text as text, r."start-byte" as begin, r."end-byte" as finish from source_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let expression_tokens = select l.decorator as decorator, r.token as token, r.begin as begin from at_in_decorators as l join token_locations as r on l.file = r.file where r.begin >= l.after_at and r.begin < l.decorator_finish and r.text != "(";
let later_expression_tokens = select l.decorator as decorator, l.token as token from expression_tokens as l join expression_tokens as r on l.decorator = r.decorator where l.begin > r.begin;
let first_expression_tokens = antijoin(left=expression_tokens, right=later_expression_tokens, left-on=["decorator", "token"], right-on=["decorator", "token"]);
let target_names = select id, path from "qualified-name" where path = "pytest.fixture" or path = "pytest.yield_fixture" or path = "pytest.mark.usefixtures";
let name_locations = select l.id as qname, l.path as path, r."start-byte" as begin from target_names as l join "source-location" as r on l.id = r.id;
let root_names = select l.qname as qname, l.path as path, r.decorator as decorator from name_locations as l join first_expression_tokens as r on l.begin = r.begin;
let name_ancestors = axis(from=target_names, relation="syntax-child", direction=nearest-ancestor, domain=decorators);
let matching_decorators = select l.qname as qname, l.path as path, l.decorator as decorator from root_names as l join name_ancestors as r on l.qname = r.id and l.decorator = r.related;
let decorator_facts = select l.decorator as decorator, l.path as path, r.declaration as declaration from matching_decorators as l join "decorates" as r on l.decorator = r.occurrence;
let function_declarations = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let regular_fixture_facts = select decorator, declaration from decorator_facts where path = "pytest.fixture";
let regular_fixture_decorators = select l.decorator as decorator, l.declaration as declaration from regular_fixture_facts as l join function_declarations as r on l.declaration = r.id;
let yield_fixture_facts = select decorator, declaration from decorator_facts where path = "pytest.yield_fixture";
let yield_fixture_decorators = select l.decorator as decorator, l.declaration as declaration from yield_fixture_facts as l join function_declarations as r on l.declaration = r.id;
let fixture_decorators = union(left=regular_fixture_decorators, right=yield_fixture_decorators);
let fixture_declarations = select declaration from fixture_decorators;
let usefixtures_facts = select decorator, declaration from decorator_facts where path = "pytest.mark.usefixtures";
let usefixtures_decorators = select l.decorator as decorator, l.declaration as declaration from usefixtures_facts as l join function_declarations as r on l.declaration = r.id;
let reportable = select l.decorator as id from usefixtures_decorators as l join fixture_declarations as r on l.declaration = r.declaration;
let reportable_rows = select l.id as id, r.file as file, r.span as span from reportable as l join decorators as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PT025(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PT025)(?:,|$)");
emit violations subject file key(id);
