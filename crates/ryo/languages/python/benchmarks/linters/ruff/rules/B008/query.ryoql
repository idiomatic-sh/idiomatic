import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import immutable_annotations from "python/ruff/immutable-annotations";
let default_roots = select parent as function, child as value, file from "semantic-child" where field = "defaults" or field = "kw-defaults";
let default_wrappers = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let wrapper_defaults = select l.id as wrapper, l.file as file, r.child as value from default_wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "defaults" or r.field = "kw-defaults";
let wrapper_parameters = select l.id as wrapper, l.file as file, r.child as parameter from default_wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "args" or r.field = "posonlyargs" or r.field = "kwonlyargs";
let parameter_annotations0 = select l.wrapper as wrapper, l.file as file, r.child as annotation from wrapper_parameters as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let factory_calls = select id, file from "semantic-syntax" where kind = "call";
let factory_functions = select l.id as call, r.child as function, l.file as file from factory_calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let newtype_names = select id, file from "qualified-name" where provenance = "import" and (path = "typing.NewType" or path = "typing_extensions.NewType");
let newtype_calls = select l.call as call, l.file as file from factory_functions as l join newtype_names as r on l.function = r.id and l.file = r.file;
let factory_arguments = select call, expression as value, position, file from "call-argument";
let factory_counts = group-count(from=factory_arguments, keys=["call", "file"], count="count", distinct="value");
let two_argument_factories = select l.call as call, l.file as file from newtype_calls as l join factory_counts as r on l.call = r.call and l.file = r.file where r.count = 2;
let factory_keywords = select id, file from "semantic-syntax" where kind = "keyword";
let factory_keyword_values = select l.id as keyword, r.child as value, l.file as file from factory_keywords as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let factory_keyword_owners = axis(from=factory_keywords, relation="semantic-child", direction=nearest-ancestor, domain=factory_calls);
let keyword_labels = select l.id as keyword, r.child as label, l.file as file from factory_keywords as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "arg";
let tp_labels = select l.keyword as keyword, l.file as file from keyword_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "tp";
let tp_values0 = select l.keyword as keyword, l.value as value, l.file as file from factory_keyword_values as l join tp_labels as r on l.keyword = r.keyword and l.file = r.file;
let tp_values1 = select r.related as call, l.value as value, l.file as file from tp_values0 as l join factory_keyword_owners as r on l.keyword = r.id and l.file = r.file;
let ordered_tp_values = select l.call as call, l.value as value, r.position as position, l.file as file from tp_values1 as l join factory_arguments as r on l.call = r.call and l.value = r.value and l.file = r.file;
let later_tp_values = select l.call as call, l.value as value, l.file as file from ordered_tp_values as l join ordered_tp_values as r on l.call = r.call and l.file = r.file where r.position < l.position;
let first_tp_values = antijoin(left=ordered_tp_values, right=later_tp_values, left-on=["call", "value", "file"], right-on=["call", "value", "file"]);
let tp_values = select call, value, file from first_tp_values;
let positional_factory_arguments = antijoin(left=factory_arguments, right=factory_keyword_values, left-on=["value", "file"], right-on=["value", "file"]);
let factory_predecessors = select l.call as call, l.value as value, r.value as previous, l.file as file from positional_factory_arguments as l join positional_factory_arguments as r on l.call = r.call and l.file = r.file where r.position < l.position;
let factory_ranks = group-count(from=factory_predecessors, keys=["call", "value", "file"], count="rank", distinct="previous");
let second_factory_arguments0 = select call, value, file from factory_ranks where rank = 1;
let second_factory_arguments = antijoin(left=second_factory_arguments0, right=tp_values, left-on=["call", "file"], right-on=["call", "file"]);
let original_type_arguments = union(left=tp_values, right=second_factory_arguments);
let newtype_annotations = select l.call as wrapper, l.file as file, r.value as annotation from two_argument_factories as l join original_type_arguments as r on l.call = r.call and l.file = r.file;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let call_function_nodes = select l.id as call, r.child as function, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let mutable_function_names = select id, file from "qualified-name" where (provenance = "builtin" or provenance = "import") and (path = "builtins.dict" or path = "builtins.list" or path = "builtins.set" or path = "collections.Counter" or path = "collections.OrderedDict" or path = "collections.defaultdict" or path = "collections.deque");
let mutable_calls = select l.call as id, l.file as file from call_function_nodes as l join mutable_function_names as r on l.function = r.id and l.file = r.file;
let callable_subscripts = select l.call as call, l.function as function, l.file as file from call_function_nodes as l join subscript_nodes as r on l.function = r.id and l.file = r.file;
let subscript_functions = select l.call as call, l.file as file, r.child as function from callable_subscripts as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "value";
let normalized_function_nodes = union(left=call_function_nodes, right=subscript_functions);
let implicit_immutable_names = select id, file from "qualified-name" as q where q.provenance = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10) and (q.path = "builtins.bool" or q.path = "builtins.bytes" or q.path = "builtins.complex" or q.path = "builtins.float" or q.path = "builtins.frozenset" or q.path = "builtins.int" or q.path = "builtins.range" or q.path = "builtins.str" or q.path = "builtins.tuple" or q.path = "builtins.slice" or q.path = "builtins.frozendict");
let library_immutable_names = select id, file from "qualified-name" where provenance = "import" and (path = "datetime.date" or path = "datetime.datetime" or path = "datetime.time" or path = "datetime.timedelta" or path = "datetime.timezone" or path = "datetime.tzinfo" or path = "decimal.Decimal" or path = "fractions.Fraction" or path = "operator.attrgetter" or path = "operator.itemgetter" or path = "operator.methodcaller" or path = "pathlib.Path" or path = "types.MappingProxyType" or path = "re.compile");
let immutable_function_names = union(left=implicit_immutable_names, right=library_immutable_names);
let immutable_calls = select l.call as id, l.file as file from normalized_function_nodes as l join immutable_function_names as r on l.function = r.id and l.file = r.file;
let assignment_statements = select id, file from "semantic-syntax" where kind = "assign";
let assignment_values = select l.id as assignment, r.child as value, l.file as file from assignment_statements as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let newtype_assignments = select l.assignment as assignment, r.wrapper as factory, l.file as file from assignment_values as l join newtype_annotations as r on l.value = r.wrapper and l.file = r.file;
let variable_bindings = select id, name, owner as scope, file from "defines" where kind = "variable";
let assignment_boundaries = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign" or kind = "named-expr";
let variable_owners = axis(from=variable_bindings, relation="semantic-child", direction=nearest-ancestor, domain=assignment_boundaries);
let newtype_bindings0 = select l.id as binding, l.name as name, l.scope as scope, r.related as assignment, l.file as file from variable_bindings as l join variable_owners as r on l.id = r.id and l.file = r.file;
let newtype_bindings1 = select l.binding as binding, l.name as name, l.scope as scope, r.factory as factory, l.file as file from newtype_bindings0 as l join newtype_assignments as r on l.assignment = r.assignment and l.file = r.file;
let binding_points = select occurrence as id, scope, name, ordinal, file from "binding-event" where kind = "bind";
let newtype_bindings = select l.binding as binding, l.name as name, l.scope as scope, l.factory as factory, r.ordinal as point, l.file as file from newtype_bindings1 as l join binding_points as r on l.binding = r.id and l.file = r.file;
let prior_namespace_events = select occurrence, name, scope, ordinal, file from "binding-event" where kind = "bind" or kind = "annotation" or kind = "delete" or kind = "cleanup" or kind = "global" or kind = "nonlocal";
let shadowed_newtypes = select l.binding as binding, l.file as file from newtype_bindings as l join prior_namespace_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.point;
let only_newtypes0 = antijoin(left=newtype_bindings, right=shadowed_newtypes, left-on=["binding", "file"], right-on=["binding", "file"]);
let builtin_names_for_binding = select name, file from "implicit-symbol" as q where q.kind = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10);
let module_scopes = select id, file from "semantic-syntax" where kind = "module";
let module_newtypes = select l.binding as binding, l.name as name, l.file as file from only_newtypes0 as l join module_scopes as r on l.scope = r.id and l.file = r.file;
let shadowing_builtin_newtypes = select l.binding as binding, l.file as file from module_newtypes as l join builtin_names_for_binding as r on l.name = r.name and l.file = r.file;
let only_newtypes = antijoin(left=only_newtypes0, right=shadowing_builtin_newtypes, left-on=["binding", "file"], right-on=["binding", "file"]);
let callable_uses = select reference, binding, file from "binding-use";
let use_counts = group-count(from=callable_uses, keys=["reference", "file"], count="count", distinct="binding");
let unique_uses0 = select l.reference as reference, l.binding as binding, l.file as file from callable_uses as l join use_counts as r on l.reference = r.reference and l.file = r.file where r.count = 1;
let unique_newtype_uses = select l.reference as reference, r.factory as factory, l.file as file from unique_uses0 as l join only_newtypes as r on l.binding = r.binding and l.file = r.file;
let bare_functions = select id, file from "semantic-syntax" where kind = "name";
let bare_newtype_uses = select l.reference as id, l.factory as factory, l.file as file from unique_newtype_uses as l join bare_functions as r on l.reference = r.id and l.file = r.file;
let bare_newtype_calls = select l.call as call, r.factory as factory, l.file as file from call_function_nodes as l join bare_newtype_uses as r on l.function = r.id and l.file = r.file;
let newtype_annotation_requests = select l.call as check, r.annotation as root, l.file as file from bare_newtype_calls as l join newtype_annotations as r on l.factory = r.wrapper and l.file = r.file;
let parameter_annotation_requests = select wrapper as check, annotation as root, file from parameter_annotations0;
let annotation_requests = union(left=parameter_annotation_requests, right=newtype_annotation_requests);
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let request_sites = select check as id, file from annotation_requests;
let request_scope_axes = axis(from=request_sites, relation="semantic-child", direction=nearest-ancestor, domain=function_scopes);
let scoped_requests = select l.check as check, l.root as root, r.related as scope, l.file as file from annotation_requests as l join request_scope_axes as r on l.check = r.id and l.file = r.file;
let file_points = select ordinal as point, file from "binding-event";
let earlier_file_points = select l.point as point, l.file as file from file_points as l join file_points as r on l.file = r.file where l.point < r.point;
let final_file_points = antijoin(left=file_points, right=earlier_file_points, left-on=["point", "file"], right-on=["point", "file"]);
let annotation_checks = select l.check as check, l.root as root, l.scope as scope, r.point as point, l.file as file from scoped_requests as l join final_file_points as r on l.file = r.file;
let immutable_checks = immutable_annotations(checks=annotation_checks);
let immutable_annotation_defaults = select l.value as id, l.file as file from wrapper_defaults as l join immutable_checks as r on l.wrapper = r.check and l.file = r.file;
let immutable_newtype_calls = select l.call as id, l.file as file from bare_newtype_calls as l join immutable_checks as r on l.call = r.check and l.file = r.file;
let unannotated_default_roots = antijoin(left=default_roots, right=immutable_annotation_defaults, left-on=["value","file"], right-on=["id","file"]);
let edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=edges, source="origin", destination="destination");
let values_below_default = select l.function as function, l.value as value, l.file as file from unannotated_default_roots as l;
let nested_values = select l.function as function, r.destination as value, l.file as file from unannotated_default_roots as l join descendants as r on l.value = r.origin;
let all_values_a = union(left=values_below_default, right=nested_values);
let calls_in_defaults = select l.function as function, r.id as id, r.file as file, r.span as span from all_values_a as l join calls as r on l.value = r.id and l.file = r.file;
let all_default_values = union(left=values_below_default, right=nested_values);
let lambda_nodes = select id, file from "semantic-syntax" where kind = "lambda";
let lambdas_in_defaults = select l.function as function, l.value as id, l.file as file from all_default_values as l join lambda_nodes as r on l.value = r.id and l.file = r.file;
let lambda_descendants = select l.function as function, l.id as lambda, r.destination as id, l.file as file from lambdas_in_defaults as l join descendants as r on l.id = r.origin;
let calls_in_lambdas = select l.function as function, l.id as id, l.file as file from lambda_descendants as l join calls as r on l.id = r.id and l.file = r.file;
let calls_outside_lambdas = antijoin(left=calls_in_defaults, right=calls_in_lambdas, left-on=["function","id","file"], right-on=["function","id","file"]);
let safe_calls0 = union(left=mutable_calls, right=immutable_calls);
let safe_calls = union(left=safe_calls0, right=immutable_newtype_calls);
let checked_calls0 = antijoin(left=calls_outside_lambdas, right=safe_calls, left-on=["id", "file"], right-on=["id", "file"]);
let checked_calls = select id, file, span from checked_calls0;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from checked_calls as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*B008(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B008)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*B008(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B008)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B008"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
