import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import pep604 from "python/ruff/pep604-candidates";
import suppress from "python/ruff/suppress";
let inputs = select id, file from "semantic-syntax" where kind = "subscript";
let selected = pep604(source_nodes=inputs);
let candidates0 = select id, file from selected where operator = "optional";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP045(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP045)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP045)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP045)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP045"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
