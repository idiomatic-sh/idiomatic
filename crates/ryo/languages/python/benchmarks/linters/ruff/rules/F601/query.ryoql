import observation_matches from "python/ruff/suppress-matches";
let dictionaries = select id, file from "semantic-syntax" where kind = "dict";
let dictionary_keys = select l.parent as dictionary, l.child as id, r.file as file from "semantic-child" as l join dictionaries as r on l.parent = r.id where l.field = "keys";
let constant_keys = select id, key, file from "constant-key";
let constant_keyed = select l.dictionary as dictionary, l.id as id, r.key as key, l.file as file from dictionary_keys as l join constant_keys as r on l.id = r.id and l.file = r.file;
let constant_locations = select l.dictionary as dictionary, l.id as id, l.key as key, l.file as file, r."start-byte" as begin from constant_keyed as l join "source-location" as r on l.id = r.id and l.file = r.file;
let constant_duplicates = ordered-match(left=constant_locations, right=constant_locations, left-on=[dictionary,file,key], right-on=[dictionary,file,key], left-order="begin", right-order="begin", output={id:[right,id]});
let tuple_and_fstring_keys = select l.dictionary as dictionary, l.id as id, l.file as file from dictionary_keys as l join "semantic-syntax" as r on l.id = r.id where r.kind = "tuple" or r.kind = "joined-str";
let unary_nodes = select id, file from "semantic-syntax" where kind = "unary-op";
let unary_operands = select l.parent as unary, l.child as operand, r.file as file from "semantic-child" as l join unary_nodes as r on l.parent = r.id where l.field = "operand";
let signs = select id, file from "syntax-tree" where text = "+" or text = "-";
let signed_operator_owners = axis(from=signs, relation="syntax-child", direction=nearest-ancestor, domain=unary_nodes);
let signed_operator_nodes = group-count(from=signed_operator_owners, keys=["related"], count="count");
let signed_unary_ops = select l.unary as unary, l.operand as operand, l.file as file from unary_operands as l join signed_operator_nodes as r on l.unary = r.related;
let numeric_nodes = select l.id as id, l.file as file from "literal-properties" as l where l.kind = "integer" or l.kind = "float" or l.kind = "complex";
let direct_signed_numeric = select l.unary as id, l.file as file from signed_unary_ops as l join numeric_nodes as r on l.operand = r.id and l.file = r.file;
let signed_unary_children = select l.unary as origin, r.unary as destination from signed_unary_ops as l join signed_unary_ops as r on l.operand = r.unary and l.file = r.file;
let signed_unary_paths = closure(edges=signed_unary_children, source="origin", destination="destination");
let signed_numeric_leaves = select l.unary as unary, r.file as file from signed_unary_ops as l join numeric_nodes as r on l.operand = r.id and l.file = r.file;
let nested_signed_numeric = select l.origin as id, r.file as file from signed_unary_paths as l join signed_numeric_leaves as r on l.destination = r.unary;
let signed_numeric_roots = union(left=direct_signed_numeric, right=nested_signed_numeric);
let signed_dictionary_keys = select l.dictionary as dictionary, l.id as id, l.file as file from dictionary_keys as l join signed_numeric_roots as r on l.id = r.id and l.file = r.file;
let dynamic_key_nodes = union(left=tuple_and_fstring_keys, right=signed_dictionary_keys);
let dynamic_unkeyed = antijoin(left=dynamic_key_nodes, right=constant_keys, left-on=["id", "file"], right-on=["id", "file"]);
let dynamic_shapes = select l.dictionary as dictionary, l.id as id, l.file as file, r.shape as shape from dynamic_unkeyed as l join "expression-shape" as r on l.id = r.id and l.file = r.file;
let dynamic_locations = select l.dictionary as dictionary, l.id as id, l.file as file, l.shape as shape, r."start-byte" as begin from dynamic_shapes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let dynamic_duplicates = ordered-match(left=dynamic_locations, right=dynamic_locations, left-on=[dictionary,file,shape], right-on=[dictionary,file,shape], left-order="begin", right-order="begin", output={id:[right,id]});
let duplicate_keys = union(left=constant_duplicates, right=dynamic_duplicates);
let reportable = select l.id as id, r.file as file, r.span as span from duplicate_keys as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F601)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F601"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
