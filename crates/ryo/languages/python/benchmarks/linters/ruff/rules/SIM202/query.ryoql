import suppress from "python/ruff/suppress";
let unary_nodes = select id, file, span from "semantic-syntax" where kind = "unary-op";
let op_edges = select parent, child, file from "semantic-child" where field = "op";
let not_tokens = select id, file from "semantic-syntax" where text = "not";
let not_unaries = select l.parent as unary, l.file as file from op_edges as l join not_tokens as r on l.child = r.id and l.file = r.file;
let operand_edges = select parent, child, file from "semantic-child" where field = "operand";
let compare_nodes = select id, file from "semantic-syntax" where kind = "compare";
let unary_compares = select l.unary as id, l.file as file, r.child as compare from not_unaries as l join operand_edges as r on l.unary = r.parent and l.file = r.file;
let direct_compares = select l.id as unary, l.file as file, l.compare as compare from unary_compares as l join compare_nodes as r on l.compare = r.id and l.file = r.file;
let comparison_ops = select parent, child, file from "semantic-child" where field = "ops";
let compare_operator_rows = select l.unary as unary, l.file as file, r.child as operator from direct_compares as l join comparison_ops as r on l.compare = r.parent and l.file = r.file;
let wanted_ops = select id, file from "semantic-syntax" where text = "!=";
let wanted_comparisons = select l.unary as id, l.file as file from compare_operator_rows as l join wanted_ops as r on l.operator = r.id and l.file = r.file;
let op_counts = group-count(from=compare_operator_rows, keys=["unary", "file"], count="operator_count", distinct="operator");
let single_op_comparisons = select unary as id, file from op_counts where operator_count = 1;
let exact_comparisons = select l.id as id, l.file as file from wanted_comparisons as l join single_op_comparisons as r on l.id = r.id and l.file = r.file;
let if_nodes = select id, file from "semantic-syntax" where kind = "if";
let test_edges = select parent, child, file from "semantic-child" where field = "test";
let if_test_rows = select l.parent as statement, l.file as file, l.child as test from test_edges as l join if_nodes as r on l.parent = r.id and l.file = r.file;
let if_test_unaries = select l.statement as statement, l.file as file, r.id as unary from if_test_rows as l join exact_comparisons as r on l.test = r.id and l.file = r.file;
let body_edges = select parent, child, file from "semantic-child" where field = "body";
let if_body_rows = select l.parent as statement, l.file as file, l.child as body from body_edges as l join if_nodes as r on l.parent = r.id and l.file = r.file;
let body_counts = group-count(from=if_body_rows, keys=["statement", "file"], count="body_count", distinct="body");
let single_body_ifs = select statement, file from body_counts where body_count = 1;
let raise_nodes = select id, file from "semantic-syntax" where kind = "raise";
let single_raise_bodies = select l.statement as statement, l.file as file from if_body_rows as l join raise_nodes as r on l.body = r.id and l.file = r.file;
let exception_ifs = select l.statement as statement, l.file as file from single_raise_bodies as l join single_body_ifs as r on l.statement = r.statement and l.file = r.file;
let exception_test_rows = select l.unary as id, l.file as file from if_test_unaries as l join exception_ifs as r on l.statement = r.statement and l.file = r.file;
let no_exception_candidates = antijoin(left=exact_comparisons, right=exception_test_rows, left-on=["id", "file"], right-on=["id", "file"]);
let function_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let function_name_edges = select parent, child, file from "semantic-child" where field = "name";
let function_names = select l.parent as function, l.file as file, r.name as name from function_name_edges as l join "identifier" as r on l.child = r.id and l.file = r.file;
let dunder_names = select function, file from function_names where matches(name, "^__[A-Za-z0-9_]+__$");
let dunder_functions = select l.function as id, l.file as file from dunder_names as l join function_nodes as r on l.function = r.id and l.file = r.file;
let parent_edges = select child as origin, parent as destination from "semantic-child";
let ancestor_paths = closure(edges=parent_edges, source="origin", destination="destination");
let candidate_ancestors = select l.id as candidate, r.destination as ancestor, l.file as file from no_exception_candidates as l join ancestor_paths as r on l.id = r.origin;
let dunder_candidates = select l.candidate as id, l.file as file from candidate_ancestors as l join dunder_functions as r on l.ancestor = r.id and l.file = r.file;
let no_dunder_candidates = antijoin(left=no_exception_candidates, right=dunder_candidates, left-on=["id", "file"], right-on=["id", "file"]);
let exact_nodes = select l.id as id, l.file as file, r.span as span from no_dunder_candidates as l join unary_nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from exact_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])SIM202(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM202)(?:,|$)");
emit violations subject file key(id);
