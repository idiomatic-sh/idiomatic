import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare" and glob_any(file, "**/*.pyi");
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let version = select id, file from "qualified-name" where path = "sys.version_info";
let subscript_bases = select parent as subscript, child as base from "semantic-child" where field = "value";
let version_subscripts = select l.subscript as subscript, r.file as file from subscript_bases as l join version as r on l.base = r.id;
let comparison_subscripts = select l.parent as comparison, r.subscript as subscript, l.file as file from left_edges as l join version_subscripts as r on l.child = r.subscript;
let slice_edges = select parent as subscript, child as slice, file from "semantic-child" where field = "slice";
let slice_rows = select l.comparison as comparison, r.slice as slice, l.file as file from comparison_subscripts as l join slice_edges as r on l.subscript = r.subscript and l.file = r.file;
let slice_syntax = select id, file from "semantic-syntax" where kind = "slice";
let slices = select l.comparison as comparison, l.slice as slice, l.file as file from slice_rows as l join slice_syntax as r on l.slice = r.id and l.file = r.file;
let lower_edges = select parent as slice, child, file from "semantic-child" where field = "lower";
let step_edges = select parent as slice, child, file from "semantic-child" where field = "step";
let with_lower = select l.slice as slice, l.file as file from slices as l join lower_edges as r on l.slice = r.slice and l.file = r.file;
let with_step = select l.slice as slice, l.file as file from slices as l join step_edges as r on l.slice = r.slice and l.file = r.file;
let with_bounds = union(left=with_lower, right=with_step);
let simple_slices = antijoin(left=slices, right=with_bounds, left-on=["slice", "file"], right-on=["slice", "file"]);
let upper_edges = select parent, child, file from "semantic-child" where field = "upper";
let uppers = select l.comparison as comparison, r.child as upper, l.file as file from simple_slices as l join upper_edges as r on l.slice = r.parent and l.file = r.file;
let upper_locations = select l.comparison as comparison, l.upper as upper, r."start-byte" as start, r."end-byte" as end, l.file as file from uppers as l join "source-location" as r on l.upper = r.id and l.file = r.file;
let one_tokens = select id, file, text from "semantic-syntax" where matches(text, "(?i)^(?:1|0x(?:_?0)*_?1|0b(?:_?0)*_?1|0o(?:_?0)*_?1)$");
let two_tokens = select id, file, text from "semantic-syntax" where matches(text, "(?i)^(?:2|0x(?:_?0)*_?2|0b(?:_?0)*_?1_?0|0o(?:_?0)*_?2)$");
let one_locations = select l.id as token, l.file as file, r."start-byte" as start, r."end-byte" as end from one_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let two_locations = select l.id as token, l.file as file, r."start-byte" as start, r."end-byte" as end from two_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let one_uppers = select l.comparison as comparison, l.file as file from upper_locations as l join one_locations as r on l.start = r.start and l.end = r.end and l.file = r.file;
let two_uppers = select l.comparison as comparison, l.file as file from upper_locations as l join two_locations as r on l.start = r.start and l.end = r.end and l.file = r.file;
let comparator_edges = select parent, child, file from "semantic-child" where field = "comparators";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let comparator_rows = select l.parent as comparison, l.child as tuple, l.file as file from comparator_edges as l join tuples as r on l.child = r.id and l.file = r.file;
let tuple_elements = select parent, child, file from "semantic-child" where field = "elts";
let element_rows = select l.parent as tuple, l.child as element, l.file as file from tuple_elements as l join tuples as r on l.parent = r.id and l.file = r.file;
let tuple_counts = group-count(from=element_rows, keys=["tuple", "file"], count="count", distinct="element");
let tuple_ids = select id as tuple, file from tuples;
let empty_tuples = antijoin(left=tuple_ids, right=tuple_counts, left-on=["tuple", "file"], right-on=["tuple", "file"]);
let empty_tuple_counts = extend(from=empty_tuples, values={count: 0});
let all_tuple_counts = union(left=tuple_counts, right=empty_tuple_counts);
let one_tuples = select tuple as id, file from all_tuple_counts where count != 1;
let two_tuples = select tuple as id, file from all_tuple_counts where count != 2;
let wrong_one_tuple_rows = select l.comparison as comparison, l.file as file from comparator_rows as l join one_tuples as r on l.tuple = r.id and l.file = r.file;
let one_mismatches = select l.comparison as comparison, l.file as file from wrong_one_tuple_rows as l join one_uppers as u on l.comparison = u.comparison and l.file = u.file;
let wrong_two_tuple_rows = select l.comparison as comparison, l.file as file from comparator_rows as l join two_tuples as r on l.tuple = r.id and l.file = r.file;
let two_mismatches = select l.comparison as comparison, l.file as file from wrong_two_tuple_rows as l join two_uppers as u on l.comparison = u.comparison and l.file = u.file;
let mismatches = union(left=one_mismatches, right=two_mismatches);
let reportable = select l.comparison as id, r.file as file, r.span as span from mismatches as l join comparisons as r on l.comparison = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI005)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI005"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
