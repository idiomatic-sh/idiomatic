import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let comparisons = select id from "semantic-syntax" where kind = "compare";
let fields = select parent, child, ordinal from "semantic-child" where field = "left" or field = "comparators";
let operands = select r.parent as parent, r.child as child, r.ordinal as ordinal from comparisons as l join fields as r on l.id = r.parent;
let pairs = select l.parent as parent, l.child as first, r.child as second, l.ordinal as before, r.ordinal as after from operands as l join operands as r on l.parent = r.parent where l.ordinal < r.ordinal;
let intervening = select l.first as first, l.second as second from pairs as l join operands as r on l.parent = r.parent where l.before < r.ordinal and r.ordinal < l.after;
let adjacent = antijoin(left=pairs, right=intervening, left-on=["first", "second"], right-on=["first", "second"]);
let literals = select id, file, span from "semantic-syntax" where kind = "constant";
let right_literal = select l.first as first from adjacent as l join literals as r on l.second = r.id;
let reportable = select r.id as id, r.file as file, r.span as span from right_literal as l join literals as r on l.first = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLR0133)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR0133"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
