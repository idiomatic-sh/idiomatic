import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let imports = select occurrence as id, file, span from "static-import" where target = "collections.abc.Set" and binding != "AbstractSet";
let statements = select id from "semantic-syntax" where kind = "import-from";
let aliases = select r.child as child from statements as l join "semantic-child" as r on l.id = r.parent;
let candidates = select l.id as id, l.file as file, l.span as span from imports as l join aliases as r on l.id = r.child;
let asnames = select parent, child from "semantic-child" where field = "asname";
let unaliased = antijoin(left=candidates, right=asnames, left-on=["id"], right-on=["parent"]);
let aliased = select r.child as child from candidates as l join asnames as r on l.id = r.parent;
let bindings = select r.id as id, r.file as file, r.span as span from aliased as l join "semantic-syntax" as r on l.child = r.id;
let reportable = union(left=unaliased, right=bindings);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI025(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI025)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI025(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI025)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI025"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
