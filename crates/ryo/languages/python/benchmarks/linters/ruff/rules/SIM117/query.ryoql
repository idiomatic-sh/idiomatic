import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, file from "semantic-syntax";
let withs = select id, kind, file from nodes where kind = "with" or kind = "async-with";
let bodies = select l.id as owner, r.child as member, l.file as file from withs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=bodies, keys=["owner", "file"], count="count", distinct="member");
let single_bodies = select l.owner as outer, l.member as inner, l.file as file from bodies as l join body_counts as r on l.owner = r.owner and l.file = r.file where r.count = 1;
let nested_withs = select l.outer as outer, l.inner as inner, r.kind as inner_kind, l.file as file from single_bodies as l join withs as r on l.inner = r.id and l.file = r.file;
let same_mode = select l.outer as outer, l.inner as inner, l.file as file from nested_withs as l join withs as r on l.outer = r.id and l.file = r.file where l.inner_kind = r.kind;
let parented = select l.id as outer, l.file as file from withs as l join single_bodies as r on l.id = r.inner and l.file = r.file;
let top_nested = antijoin(left=same_mode, right=parented, left-on=["outer", "file"], right-on=["outer", "file"]);
let items = select l.id as owner, r.child as item, r.ordinal as ordinal, l.file as file from withs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "items";
let item_counts = group-count(from=items, keys=["owner", "file"], count="count", distinct="item");
let single_items = select l.owner as owner, l.item as item, l.file as file from items as l join item_counts as r on l.owner = r.owner and l.file = r.file where r.count = 1;
let contexts = select l.owner as owner, r.child as expression, l.file as file from single_items as l join "semantic-child" as r on l.item = r.parent and l.file = r.file where r.field = "context-expr";
let calls = select id, file from nodes where kind = "call";
let called_contexts = select l.owner as owner, l.expression as expression, l.file as file from contexts as l join calls as r on l.expression = r.id and l.file = r.file;
let functions = select l.owner as owner, r.child as function, l.file as file from called_contexts as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "func";
let explicit_functions = select id, file from "qualified-name" where path = "asyncio.timeout" or path = "asyncio.timeout_at" or path = "anyio.CancelScope" or path = "anyio.fail_after" or path = "anyio.move_on_after" or path = "trio.fail_after" or path = "trio.fail_at" or path = "trio.move_on_after" or path = "trio.move_on_at";
let explicit_owners = select l.owner as owner, l.file as file from functions as l join explicit_functions as r on l.function = r.id and l.file = r.file;
let explicit_outers = select l.outer as outer, l.file as file from top_nested as l join explicit_owners as r on l.outer = r.owner and l.file = r.file;
let explicit_inners = select l.outer as outer, l.file as file from top_nested as l join explicit_owners as r on l.inner = r.owner and l.file = r.file;
let excluded = union(left=explicit_outers, right=explicit_inners);
let reportable = antijoin(left=top_nested, right=excluded, left-on=["outer", "file"], right-on=["outer", "file"]);
let earlier_items = select l.owner as owner, l.item as item, l.file as file from items as l join items as r on l.owner = r.owner and l.file = r.file where l.ordinal < r.ordinal;
let last_items = antijoin(left=items, right=earlier_items, left-on=["owner", "item", "file"], right-on=["owner", "item", "file"]);
let inner_items = select l.outer as id, r.item as item, l.file as file from reportable as l join last_items as r on l.inner = r.owner and l.file = r.file;
let locations = select id, span, "start-byte", "end-byte", "start-line", file from "source-location";
let item_ends = select l.id as id, r."end-byte" as item_end, l.file as file from inner_items as l join locations as r on l.item = r.id and l.file = r.file;
let colon_tokens = select id, file from "syntax-tree" where text = ":";
let colons = select l.id as colon, r.span as colon_span, r."start-byte" as position, l.file as file from colon_tokens as l join locations as r on l.id = r.id and l.file = r.file;
let later_colons = select l.id as id, r.colon as colon, r.colon_span as colon_span, r.position as position, l.file as file from item_ends as l join colons as r on l.file = r.file where r.position >= l.item_end;
let not_first = select l.id as id, l.colon as colon, l.file as file from later_colons as l join later_colons as r on l.id = r.id and l.file = r.file where r.position < l.position;
let first_colons = antijoin(left=later_colons, right=not_first, left-on=["id", "colon", "file"], right-on=["id", "colon", "file"]);
let bounds = select l.id as id, r.span as start_span, l.colon_span as end_span, r."start-line" as line, l.file as file from first_colons as l join locations as r on l.id = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:SIM117)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM117"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
