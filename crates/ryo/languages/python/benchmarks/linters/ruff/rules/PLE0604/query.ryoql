import observation_matches from "python/ruff/suppress-matches";
let assignments = select id, file, span, kind from "semantic-syntax" where kind = "assign" or kind = "ann-assign" or kind = "aug-assign";
let modules = select id, file from "semantic-syntax" where kind = "module";
let scopes = select id, file from "semantic-syntax" where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let scope_ancestry = axis(from=assignments, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let assignment_scopes = select l.id as statement, l.file as file, r.related as scope from assignments as l join scope_ancestry as r on l.id = r.id and l.file = r.file;
let module_assignments = select l.statement as statement, l.file as file from assignment_scopes as l join modules as r on l.scope = r.id and l.file = r.file;
let target_fields = select parent, child from "semantic-child" where field = "targets" or field = "target";
let target_edges = select l.statement as statement, r.child as target, l.file as file from module_assignments as l join target_fields as r on l.statement = r.parent;
let export_names = select id, file, span from "identifier" where name = "__all__";
let export_targets = select l.statement as statement, r.id as id, r.file as file, r.span as span from target_edges as l join export_names as r on l.target = r.id and l.file = r.file;
let value_fields = select parent, child from "semantic-child" where field = "value";
let assignment_values = select l.statement as statement, l.file as file, r.child as value from module_assignments as l join value_fields as r on l.statement = r.parent;
let export_values = select l.id as target, l.file as file, l.span as target_span, r.value as value from export_targets as l join assignment_values as r on l.statement = r.statement and l.file = r.file;
let sequences = select id, file from "semantic-syntax" where kind = "list" or kind = "tuple" or kind = "set";
let direct_sequence_values = select l.target as target, l.file as file, l.target_span as target_span, l.value as sequence from export_values as l join sequences as r on l.value = r.id and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let sequence_constructors = select q.id as id, q.file as file from "qualified-name" as q where (q.path = "builtins.list" or q.path = "builtins.tuple") and (q.provenance = "import" or q.provenance = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10));
let constructor_calls = select l.call as call, l.file as file from call_functions as l join sequence_constructors as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as arguments, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, l.file as file from argument_owners as l join positional_fields as r on l.arguments = r.parent;
let positional_counts = group-count(from=positional_arguments, keys=["call"], count="count", distinct="value");
let excess_positional = select call from positional_counts where count > 1;
let keyword_fields = select parent from "semantic-child" where field = "keywords";
let calls_with_keywords = select l.call as call from argument_owners as l join keyword_fields as r on l.arguments = r.parent;
let invalid_constructor_calls = union(left=excess_positional, right=calls_with_keywords);
let valid_constructor_calls = antijoin(left=constructor_calls, right=invalid_constructor_calls, left-on=["call"], right-on=["call"]);
let one_argument_calls = select l.call as call, l.file as file, r.count as count from valid_constructor_calls as l join positional_counts as r on l.call = r.call where r.count = 1;
let call_argument_sequences = select l.call as call, r.value as value, l.file as file from one_argument_calls as l join positional_arguments as r on l.call = r.call and l.file = r.file;
let exported_call_sequences = select l.target as target, l.file as file, l.target_span as target_span, r.value as sequence from export_values as l join call_argument_sequences as r on l.value = r.call and l.file = r.file;
let constructed_sequence_values = select l.target as target, l.file as file, l.target_span as target_span, l.sequence as sequence from exported_call_sequences as l join sequences as r on l.sequence = r.id and l.file = r.file;
let binary_nodes = select id, file from "semantic-syntax" where kind = "bin-op";
let binary_values = select l.target as target, l.file as file, l.target_span as target_span, l.value as root from export_values as l join binary_nodes as r on l.value = r.id and l.file = r.file;
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let left_edges = select l.parent as origin, l.child as destination from left_fields as l join binary_nodes as r on l.parent = r.id;
let right_edges = select l.parent as origin, l.child as destination from right_fields as l join binary_nodes as r on l.parent = r.id;
let binary_edges = union(left=left_edges, right=right_edges);
let binary_paths = closure(edges=binary_edges, source="origin", destination="destination");
let binary_descendants = select l.target as target, l.file as file, l.target_span as target_span, r.destination as value from binary_values as l join binary_paths as r on l.root = r.origin;
let inner_binary_values = select l.target as target, l.file as file, l.target_span as target_span, l.value as value from binary_descendants as l join binary_nodes as r on l.value = r.id and l.file = r.file;
let binary_leaves = antijoin(left=binary_descendants, right=inner_binary_values, left-on=["target", "file", "target_span", "value"], right-on=["target", "file", "target_span", "value"]);
let binary_sequence_values = select l.target as target, l.file as file, l.target_span as target_span, l.value as sequence from binary_leaves as l join sequences as r on l.value = r.id and l.file = r.file;
let direct_and_binary_sequences = union(left=direct_sequence_values, right=binary_sequence_values);
let sequence_values = union(left=direct_and_binary_sequences, right=constructed_sequence_values);
let elements = select parent, child from "semantic-child" where field = "elts";
let sequence_elements = select l.target as target, l.file as file, l.target_span as target_span, r.child as element from sequence_values as l join elements as r on l.sequence = r.parent;
let string_literals = select id, file from "literal-properties" where kind = "string";
let invalid_elements = antijoin(left=sequence_elements, right=string_literals, left-on=["element", "file"], right-on=["id", "file"]);
let candidates = select target as id, file, target_span as span from invalid_elements;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLE0604)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE0604"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
