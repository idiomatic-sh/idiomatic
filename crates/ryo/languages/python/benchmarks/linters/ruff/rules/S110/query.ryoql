import observation_matches from "python/ruff/suppress-matches";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let broad_exceptions = select id from qualified_names where (path = "builtins.Exception" or path = "builtins.BaseException") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let handlers = select id, file, span from "semantic-syntax" where kind = "except-handler";
let bodies = select parent, child from "semantic-child" where field = "body";
let counts = group-count(from=bodies, keys=["parent"], count="count", distinct="child");
let single = select parent from counts where count = 1;
let statements = select id from "semantic-syntax" where kind = "pass";
let statement_bodies = select l.parent as id from bodies as l join statements as r on l.child = r.id;
let single_statements = select l.id as id from statement_bodies as l join single as r on l.id = r.parent;
let type_fields = select parent, child from "semantic-child" where field = "type";
let bare_handlers = antijoin(left=handlers, right=type_fields, left-on=["id"], right-on=["parent"]);
let direct_broad = select l.parent as id from type_fields as l join broad_exceptions as r on l.child = r.id;
let tuples = select id from "semantic-syntax" where kind = "tuple";
let elements = select parent, child from "semantic-child" where field = "elts";
let broad_elements = select l.parent as id from elements as l join broad_exceptions as r on l.child = r.id;
let broad_tuples = select l.id as id from tuples as l join broad_elements as r on l.id = r.id;
let tuple_broad = select l.parent as id from type_fields as l join broad_tuples as r on l.child = r.id;
let typed_broad = union(left=direct_broad, right=tuple_broad);
let bare_ids = select id from bare_handlers;
let untyped = union(left=bare_ids, right=typed_broad);
let invalid = select l.id as id from single_statements as l join untyped as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from handlers as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:S110)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "S110"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
