import observation_matches from "python/ruff/suppress-matches";
let ifs = select id, file from "semantic-syntax" where kind = "if" and matches(file, "\.pyi$");
let clauses = select l.id as owner, r.child as clause, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "orelse";
let clause_nodes = select id, file from "semantic-syntax" where kind = "elif-else-clause";
let else_clauses = select l.owner as owner, l.clause as clause, l.file as file from clauses as l join clause_nodes as r on l.clause = r.id and l.file = r.file;
let test_edges = select parent, child, file from "semantic-child" where field = "test";
let unconditional_clauses = antijoin(left=else_clauses, right=test_edges, left-on=["clause", "file"], right-on=["parent", "file"]);
let ifs_with_else = select l.id as owner, l.file as file from ifs as l join unconditional_clauses as r on l.id = r.owner and l.file = r.file;
let main_tests = select l.owner as owner, r.child as test, l.file as file from ifs_with_else as l join test_edges as r on l.owner = r.parent and l.file = r.file;
let conditional_clauses = select l.owner as owner, r.clause as clause, l.file as file from ifs_with_else as l join clauses as r on l.owner = r.owner and l.file = r.file;
let elif_tests = select l.owner as owner, r.child as test, l.file as file from conditional_clauses as l join test_edges as r on l.clause = r.parent and l.file = r.file;
let raw_tests = union(left=main_tests, right=elif_tests);
let boolops = select id, file from "semantic-syntax" where kind = "bool-op";
let bool_tests = select l.owner as owner, l.test as test, l.file as file from raw_tests as l join boolops as r on l.test = r.id and l.file = r.file;
let bool_values = select l.owner as owner, r.child as test, l.file as file from bool_tests as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "values";
let simple_tests = antijoin(left=raw_tests, right=boolops, left-on=["test", "file"], right-on=["id", "file"]);
let tests = union(left=simple_tests, right=bool_values);
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let tested_comparisons = select l.test as comparison, l.file as file from tests as l join comparisons as r on l.test = r.id and l.file = r.file;
let op_edges = select parent as comparison, child as op, file from "semantic-child" where field = "ops";
let op_counts = group-count(from=op_edges, keys=["comparison", "file"], count="count", distinct="op");
let single_ops = select l.comparison as comparison, l.op as op, l.file as file from op_edges as l join op_counts as r on l.comparison = r.comparison and l.file = r.file where r.count = 1;
let lt_ops = select id, file from "semantic-syntax" where text = "<";
let lt_comparisons = select l.comparison as comparison, l.file as file from single_ops as l join lt_ops as r on l.op = r.id and l.file = r.file;
let tested_lt = select l.comparison as comparison, l.file as file from tested_comparisons as l join lt_comparisons as r on l.comparison = r.comparison and l.file = r.file;
let lhs = select l.comparison as comparison, r.child as left, l.file as file from tested_lt as l join "semantic-child" as r on l.comparison = r.parent and l.file = r.file where r.field = "left";
let versions = select id, file from "qualified-name" where path = "sys.version_info";
let reportable = select l.comparison as id, l.file as file from lhs as l join versions as r on l.left = r.id and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PYI066)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI066"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
