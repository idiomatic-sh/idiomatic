import observation_matches from "python/ruff/suppress-unmapped-matches";
import line_located from "python/ruff/candidate-locations";
let subscript_nodes = select id, file, span from "semantic-syntax" where kind = "subscript";
let value_fields = select parent, child from "semantic-child" where field = "value";
let slice_fields = select parent, child from "semantic-child" where field = "slice";
let subscript_values = select l.parent as subscript, l.child as value, r.file as file from value_fields as l join subscript_nodes as r on l.parent = r.id;
let subscript_slices = select l.parent as subscript, l.child as index, r.file as file from slice_fields as l join subscript_nodes as r on l.parent = r.id;
let value_exprs = select id, file from "semantic-syntax" where kind = "list" or kind = "list-comp" or kind = "tuple" or kind = "joined-str";
let literal_values = select id, file, kind from "literal-properties" where kind = "string" or kind = "bytes";
let valid_values_a = select l.subscript as subscript, l.file as file from subscript_values as l join value_exprs as r on l.value = r.id and l.file = r.file;
let valid_values_b = select l.subscript as subscript, l.file as file from subscript_values as l join literal_values as r on l.value = r.id and l.file = r.file;
let valid_values = union(left=valid_values_a,right=valid_values_b);
let checked_subscripts = select l.subscript as subscript, l.file as file, l.index as index from subscript_slices as l join valid_values as r on l.subscript = r.subscript and l.file = r.file;
let invalid_simple_literals = select id, file from "literal-properties" where kind != "integer" and kind != "boolean";
let checked_nodes = select id, file, kind from "semantic-syntax" where kind = "list" or kind = "list-comp" or kind = "tuple" or kind = "joined-str" or kind = "template-str" or kind = "dict" or kind = "dict-comp" or kind = "set" or kind = "set-comp" or kind = "slice" or kind = "generator-exp" or kind = "lambda";
let invalid_simple_a = select l.index as id, l.file as file from checked_subscripts as l join invalid_simple_literals as r on l.index = r.id and l.file = r.file;
let invalid_simple_b = select l.index as id, l.file as file from checked_subscripts as l join checked_nodes as r on l.index = r.id and l.file = r.file where r.kind != "slice";
let invalid_simple = union(left=invalid_simple_a,right=invalid_simple_b);
let slice_nodes = select id, file from "semantic-syntax" where kind = "slice";
let slice_lower = select parent, child from "semantic-child" where field = "lower";
let slice_upper = select parent, child from "semantic-child" where field = "upper";
let slice_step = select parent, child from "semantic-child" where field = "step";
let slice_bounds_a = select l.parent as slice, l.child as bound from slice_lower as l join slice_nodes as r on l.parent = r.id;
let slice_bounds_b = select l.parent as slice, l.child as bound from slice_upper as l join slice_nodes as r on l.parent = r.id;
let slice_bounds_c = select l.parent as slice, l.child as bound from slice_step as l join slice_nodes as r on l.parent = r.id;
let slice_bounds_ab = union(left=slice_bounds_a,right=slice_bounds_b);
let slice_bounds = union(left=slice_bounds_ab,right=slice_bounds_c);
let valid_slice_roots = select index as slice, file from checked_subscripts;
let checked_bounds = select l.bound as id, l.slice as slice, r.file as file from slice_bounds as l join valid_slice_roots as r on l.slice = r.slice;
let invalid_slice_literals = select id, file from "literal-properties" where kind != "integer" and kind != "boolean" and kind != "null";
let invalid_slice_a = select l.id as id, l.file as file from checked_bounds as l join invalid_slice_literals as r on l.id = r.id and l.file = r.file;
let invalid_slice_b = select l.id as id, l.file as file from checked_bounds as l join checked_nodes as r on l.id = r.id and l.file = r.file;
let invalid_slice = union(left=invalid_slice_a,right=invalid_slice_b);
let invalid_rows = union(left=invalid_simple,right=invalid_slice);
let reportable = select l.id as id, l.file as file, r.span as span from invalid_rows as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:RUF016)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF016"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
