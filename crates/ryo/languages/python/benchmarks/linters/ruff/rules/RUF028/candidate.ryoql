import suppress from "python/ruff/suppress";
let tree = select id, kind, text, file from "syntax-tree";
let ids = select id, file from tree;
let children = select parent, child, ordinal, file from "syntax-child";
let parent_counts = group-count(from=children, keys=["parent","file"], count="children", distinct="child");
let branch_ids = select parent as id, file from parent_counts;
let branches = select l.id as id, r.kind as kind, l.file as file from branch_ids as l join tree as r on l.id = r.id and l.file = r.file where r.kind != "identifier";
let leaves = antijoin(left=ids, right=branches, left-on=["id","file"], right-on=["id","file"]);
let raw_comments = select id, text, span, file from "comment";
let off0 = select id, text, span, file from raw_comments where matches(text, "^[ \t\x0c]*(?:fmt:[ \t\x0c]*off|yapf:[ \t\x0c]*disable)[ \t\x0c]*$");
let on0 = select id, text, span, file from raw_comments where matches(text, "^[ \t\x0c]*(?:fmt:[ \t\x0c]*on|yapf:[ \t\x0c]*enable)[ \t\x0c]*$");
let skip0 = select id, text, span, file from raw_comments where matches(text, "(?:^|#)[ \t\x0c]*fmt:[ \t\x0c]*skip[ \t\x0c]*(?:#|$)");
let off = extend(from=off0, values={directive: "off"});
let on = extend(from=on0, values={directive: "on"});
let skip = extend(from=skip0, values={directive: "skip"});
let switches = union(left=off, right=on);
let directives = union(left=switches, right=skip);
let comment_places = select l.id as id, l.text as text, l.span as span, l.file as file, r."start-byte" as start, r."end-byte" as end, r."start-line" as line, r."start-column" as column from raw_comments as l join "source-location" as r on l.id = r.id and l.file = r.file;
let directive_places = select l.id as id, l.span as span, l.file as file, l.directive as directive, r.start as start, r.end as end, r.line as line, r.column as column from directives as l join comment_places as r on l.id = r.id and l.file = r.file;
let call_argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_argument_ends = select l.file as file, r."end-line" as line, r."end-byte" as end from call_argument_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let skip_places = select id, start, line, file from directive_places where directive = "skip";
let trailing_call_skips = select l.id as id, l.file as file from skip_places as l join call_argument_ends as r on l.file = r.file and l.line = r.line where r.end <= l.start;
let content = select id, file from tree where matches(text, "[^ \t\r\n\x0c][^\r\n]*$");
let content_ends = select l.id as id, l.file as file, r."end-line" as line, r."end-column" as column, r."end-byte" as end from content as l join "source-location" as r on l.id = r.id and l.file = r.file;
let structural_ends = select l.id as id, l.file as file, r."end-line" as line, r."end-column" as column, r."end-byte" as end from branches as l join "source-location" as r on l.id = r.id and l.file = r.file;
let code_ends = union(left=content_ends, right=structural_ends);
let inline_ids = select l.id as id, l.file as file from comment_places as l join code_ends as r on l.file = r.file and l.line = r.line where r.end <= l.start and r.column > 1;
let own_comments = antijoin(left=comment_places, right=inline_ids, left-on=["id","file"], right-on=["id","file"]);
let own_directives = antijoin(left=directive_places, right=inline_ids, left-on=["id","file"], right-on=["id","file"]);
let inline_directives = select l.id as id, l.directive as directive, l.file as file from directive_places as l join inline_ids as r on l.id = r.id and l.file = r.file;
let bad_own_skips = select id, file from own_directives where directive = "skip";
let bad_inline_ons = select id, file from inline_directives where directive = "on";
let parents = axis(from=directive_places, relation="syntax-child", direction=nearest-ancestor, domain=branches);
let physical_owners = select id, related as owner, file from parents;
let next_items = axis(from=ids, relation="syntax-child", direction=next-sibling, domain=ids);
let following_pairs = select id as source, related as destination, file from next_items;
let branch_next = select l.source as previous, l.destination as first, l.file as file from following_pairs as l join branches as r on l.source = r.id and l.file = r.file;
let gap_starts0 = select l.previous as previous, l.first as first, l.file as file from branch_next as l join leaves as r on l.first = r.id and l.file = r.file;
let gap_starts = select l.previous as previous, l.first as first, r.parent as owner, l.file as file from gap_starts0 as l join children as r on l.previous = r.child and l.file = r.file;
let leaf_steps0 = select l.source as source, l.destination as destination, l.file as file from following_pairs as l join leaves as r on l.source = r.id and l.file = r.file;
let leaf_steps = select l.source as source, l.destination as destination, l.destination as edge, r.ordinal as position, l.file as file from leaf_steps0 as l join children as r on l.destination = r.child and l.file = r.file;
let gap_roots = select first, file from gap_starts;
let gap_walks = ordered-dfs(from=gap_roots, root="first", edges=leaf_steps, source="source", destination="destination", order="position", edge="edge", keys=["file"], output="visit");
let gap_seed_members = select first, first as item, file from gap_roots;
let gap_walk_members = select first, destination as item, file from gap_walks;
let gap_members = union(left=gap_seed_members, right=gap_walk_members);
let gap_comments = select l.first as first, r.id as id, r.start as start, r.end as end, r.line as line, r.column as column, l.file as file from gap_members as l join comment_places as r on l.item = r.id and l.file = r.file;
let gap_own_comments = select l.first as first, l.id as id, l.start as start, l.line as line, l.column as column, l.file as file from gap_comments as l join own_comments as r on l.id = r.id and l.file = r.file;
let all_gap_directives = select l.first as first, l.id as id, l.start as start, l.end as end, l.line as line, l.column as column, r.directive as directive, l.file as file from gap_comments as l join directive_places as r on l.id = r.id and l.file = r.file;
let previous_places = select l.first as first, l.previous as previous, l.owner as owner, l.file as file, r."start-line" as previous_line, r."start-column" as previous_column, r."end-line" as previous_end_line from gap_starts as l join "source-location" as r on l.previous = r.id and l.file = r.file;
let prefix_space0 = select l.id as id, l.file as file, l.text as text, r."start-line" as start_line, r."end-line" as line, r."start-column" as start_column, r."end-column" as column from tree as l join "source-location" as r on l.id = r.id and l.file = r.file where l.kind = "whitespace" or l.kind = "indent";
let prefix_spaces = select file, line, column from prefix_space0 where (start_column = 1 or line > start_line) and matches(text, "(?:^|[\r\n])[ \t\x0c]*$");
let previous_indents0 = select l.first as first, l.previous as previous, l.owner as owner, l.previous_end_line as previous_end_line, r.column as indent, l.file as file from previous_places as l join prefix_spaces as r on l.file = r.file and l.previous_line = r.line;
let indented_previous = select first, file from previous_indents0;
let unindented_previous0 = antijoin(left=previous_places, right=indented_previous, left-on=["first","file"], right-on=["first","file"]);
let unindented_previous1 = extend(from=unindented_previous0, values={indent: 1});
let unindented_previous = select first, previous, owner, previous_end_line, indent, file from unindented_previous1;
let previous_indents = union(left=previous_indents0, right=unindented_previous);
let gap_trivia = select id, file from tree where kind = "comment" or kind = "whitespace" or kind = "newline" or kind = "nl" or kind = "indent" or kind = "dedent" or kind = "endmarker";
let nontrivia_leaves = antijoin(left=leaves, right=gap_trivia, left-on=["id","file"], right-on=["id","file"]);
let gap_code0 = select l.first as first, l.item as item, l.file as file from gap_members as l join nontrivia_leaves as r on l.item = r.id and l.file = r.file;
let code_bad0 = select item as id, file from gap_code0;
let code_bad = extend(from=code_bad0, values={category: "code"});
let not_deeper_bad0 = select l.id as id, l.file as file from gap_own_comments as l join previous_indents as r on l.first = r.first and l.file = r.file where l.line > r.previous_end_line and l.column <= r.indent;
let not_deeper_bad = extend(from=not_deeper_bad0, values={category: "not-deeper"});
let shallower_bad0 = select l.id as id, l.file as file from gap_own_comments as l join previous_indents as r on l.first = r.first and l.file = r.file where l.line > r.previous_end_line and l.column < r.indent;
let shallower_bad = extend(from=shallower_bad0, values={category: "shallower"});
let indent_bad = union(left=not_deeper_bad, right=shallower_bad);
let prefix_bad = union(left=code_bad, right=indent_bad);
let code_steps = extend(from=leaf_steps, values={category: "code"});
let not_deeper_steps = extend(from=leaf_steps, values={category: "not-deeper"});
let shallower_steps = extend(from=leaf_steps, values={category: "shallower"});
let indent_steps = union(left=not_deeper_steps, right=shallower_steps);
let all_prefix_steps = union(left=code_steps, right=indent_steps);
let prefix_barriers = select id as source, category, file from prefix_bad;
let prefix_steps = antijoin(left=all_prefix_steps, right=prefix_barriers, left-on=["source","category","file"], right-on=["source","category","file"]);
let prefix_roots = select r.destination as seed, l.category as category, l.file as file from prefix_bad as l join following_pairs as r on l.id = r.source and l.file = r.file;
let prefix_walks = ordered-dfs(from=prefix_roots, root="seed", edges=prefix_steps, source="source", destination="destination", order="position", edge="edge", keys=["category","file"], output="visit");
let prefix_bad_members = select id as item, category, file from prefix_bad;
let prefix_seed_members = select seed as item, category, file from prefix_roots;
let prefix_walk_members = select destination as item, category, file from prefix_walks;
let prefix_members0 = union(left=prefix_bad_members, right=prefix_seed_members);
let prefix_members = union(left=prefix_members0, right=prefix_walk_members);
let blocked_trailing = select item as id, file from prefix_members where category = "code";
let unblocked_directives = antijoin(left=all_gap_directives, right=blocked_trailing, left-on=["id","file"], right-on=["id","file"]);
let indented_directives = select l.id as id, l.first as first, l.start as start, r.previous as previous, r.owner as owner, r.previous_end_line as previous_end_line, r.indent as indent, l.file as file from unblocked_directives as l join previous_indents as r on l.first = r.first and l.file = r.file;
let shallower_prefix = select item as id, file from prefix_members where category = "not-deeper";
let deeper_trailing = antijoin(left=indented_directives, right=shallower_prefix, left-on=["id","file"], right-on=["id","file"]);
let own_deeper_trailing = select l.id as id, l.previous as owner, l.file as file from deeper_trailing as l join own_directives as r on l.id = r.id and l.file = r.file;
let inline_trailing0 = select l.id as id, r.previous as owner, l.file as file from unblocked_directives as l join gap_starts as r on l.first = r.first and l.file = r.file;
let inline_trailing = select l.id as id, l.owner as owner, l.file as file from inline_trailing0 as l join inline_ids as r on l.id = r.id and l.file = r.file;
let trailing_owners = union(left=own_deeper_trailing, right=inline_trailing);
let unchanged_owners = antijoin(left=physical_owners, right=trailing_owners, left-on=["id","file"], right-on=["id","file"]);
let effective_owners = union(left=unchanged_owners, right=trailing_owners);
let valid_nodes = select id, file from branches where kind = "module" or kind = "expression" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "return" or kind = "delete" or kind = "type-alias" or kind = "assign" or kind = "aug-assign" or kind = "ann-assign" or kind = "for" or kind = "async-for" or kind = "while" or kind = "if" or kind = "with" or kind = "async-with" or kind = "match" or kind = "raise" or kind = "try" or kind = "try-star" or kind = "assert" or kind = "import" or kind = "import-from" or kind = "global" or kind = "nonlocal" or kind = "expr" or kind = "pass" or kind = "break" or kind = "continue" or kind = "ipy-escape-command" or kind = "except-handler" or kind = "match-case" or kind = "decorator" or kind = "elif-else-clause";
let valid_owners = select l.id as id, l.file as file from effective_owners as l join valid_nodes as r on l.owner = r.id and l.file = r.file;
let bad_enclosing = antijoin(left=effective_owners, right=valid_owners, left-on=["id","file"], right-on=["id","file"]);
let own_switches = select id, start, column, file from own_directives where directive = "off" or directive = "on";
let declaration_owners0 = select l.id as id, l.owner as declaration, l.file as file from effective_owners as l join branches as r on l.owner = r.id and l.file = r.file where r.kind = "function-def" or r.kind = "async-function-def" or r.kind = "class-def";
let declaration_owners = select l.id as id, l.declaration as declaration, r.start as start, l.file as file from declaration_owners0 as l join own_switches as r on l.id = r.id and l.file = r.file;
let name_fields = select parent as declaration, child as name, file from "semantic-child" where field = "name";
let name_starts = select l.declaration as declaration, l.file as file, r."start-byte" as start from name_fields as l join "source-location" as r on l.name = r.id and l.file = r.file;
let before_declaration_name = select l.id as id, l.declaration as declaration, l.start as start, l.file as file from declaration_owners as l join name_starts as r on l.declaration = r.declaration and l.file = r.file where l.start < r.start;
let decorator_gaps = select l.first as first, l.owner as declaration, l.file as file from gap_starts as l join branches as r on l.previous = r.id and l.file = r.file where r.kind = "decorator";
let decorator_gap_directives = select l.id as id, r.declaration as declaration, l.file as file from all_gap_directives as l join decorator_gaps as r on l.first = r.first and l.file = r.file;
let bad_decorator_gaps = select l.id as id, l.file as file from before_declaration_name as l join decorator_gap_directives as r on l.id = r.id and l.declaration = r.declaration and l.file = r.file;
let decorator_lists = select parent as declaration, child as list, file from "semantic-child" where field = "decorator-list";
let decorator_items = select l.declaration as declaration, r.child as decorator, l.file as file from decorator_lists as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let decorator_ranges = select l.declaration as declaration, l.decorator as decorator, l.file as file, r."start-byte" as start, r."end-byte" as end, r."start-column" as column from decorator_items as l join "source-location" as r on l.decorator = r.id and l.file = r.file;
let after_decorators = select l.id as id, r.declaration as declaration, l.start as start, l.file as file from own_switches as l join decorator_ranges as r on l.file = r.file where l.start >= r.end and l.column <= r.column;
let before_names = select l.id as id, l.declaration as declaration, l.file as file, l.start as start from after_decorators as l join name_starts as r on l.declaration = r.declaration and l.file = r.file where l.start < r.start;
let inside_decorators = select l.id as id, l.declaration as declaration, l.file as file from before_names as l join decorator_ranges as r on l.declaration = r.declaration and l.file = r.file where l.start >= r.start and l.start < r.end;
let full_decorator_gaps = antijoin(left=before_names, right=inside_decorators, left-on=["id","declaration","file"], right-on=["id","declaration","file"]);
let bad_full_decorator_gaps = select id, file from full_decorator_gaps;
let following_branches = select l.first as first, r.id as following, r.kind as following_kind, l.file as file from gap_members as l join branches as r on l.item = r.id and l.file = r.file;
let gap_keyword0 = select l.first as first, r.text as word, l.file as file from gap_members as l join tree as r on l.item = r.id and l.file = r.file where r.text = "else" or r.text = "finally";
let gap_keyword = group-count(from=gap_keyword0, keys=["first","file"], count="count", distinct="word");
let alternate_owners = select id, kind, file from branches where kind = "for" or kind = "async-for" or kind = "while" or kind = "try" or kind = "try-star" or kind = "if";
let alternate_gaps0 = select l.first as first, l.previous as previous, l.owner as owner, r.kind as owner_kind, l.file as file from gap_starts as l join alternate_owners as r on l.owner = r.id and l.file = r.file;
let keyword_alternates = select l.first as first, l.owner as owner, l.file as file from alternate_gaps0 as l join gap_keyword as r on l.first = r.first and l.file = r.file where l.owner_kind = "for" or l.owner_kind = "async-for" or l.owner_kind = "while";
let finally_gaps = select first, file from gap_keyword0 where word = "finally";
let try_finally_alternates = select l.first as first, l.owner as owner, l.file as file from alternate_gaps0 as l join finally_gaps as r on l.first = r.first and l.file = r.file where l.owner_kind = "try" or l.owner_kind = "try-star";
let wrapped_alternates0 = select l.first as first, l.owner as owner, l.previous as previous, l.owner_kind as owner_kind, r.following_kind as following_kind, l.file as file from alternate_gaps0 as l join following_branches as r on l.first = r.first and l.file = r.file;
let wrapped_alternates = select l.first as first, l.owner as owner, l.file as file from wrapped_alternates0 as l join branches as r on l.previous = r.id and l.file = r.file where (l.owner_kind = "if" and l.following_kind = "elif-else-clause" and r.kind != "elif-else-clause") or ((l.owner_kind = "try" or l.owner_kind = "try-star") and l.following_kind = "except-handler" and r.kind != "except-handler");
let alternate_gaps0a = union(left=keyword_alternates, right=try_finally_alternates);
let alternate_gaps = union(left=alternate_gaps0a, right=wrapped_alternates);
let own_offs = select id, file from own_directives where directive = "off";
let alternate_directives0 = select l.id as id, l.first as first, l.start as start, r.owner as owner, l.file as file from all_gap_directives as l join alternate_gaps as r on l.first = r.first and l.file = r.file;
let alternate_directives1 = select l.id as id, l.first as first, l.start as start, l.owner as owner, l.file as file from alternate_directives0 as l join own_offs as r on l.id = r.id and l.file = r.file;
let alternate_directives2 = select l.id as id, l.first as first, l.start as start, l.file as file from alternate_directives1 as l join effective_owners as r on l.id = r.id and l.file = r.file;
let alternate_directives = select l.id as id, l.first as first, l.start as start, r.indent as indent, r.previous_end_line as previous_end_line, l.file as file from alternate_directives2 as l join previous_indents as r on l.first = r.first and l.file = r.file;
let smaller_prefix = select item as id, file from prefix_members where category = "shallower";
let bad_alternate_prefix = select l.id as id, l.file as file from alternate_directives as l join smaller_prefix as r on l.id = r.id and l.file = r.file;
let alternate_owner_columns = select l.id as id, l.owner as owner, l.file as file, r."start-column" as owner_column from alternate_directives1 as l join "source-location" as r on l.owner = r.id and l.file = r.file;
let alternate_comment_columns = select l.id as id, l.file as file, l.owner_column as owner_column, r.column as comment_column from alternate_owner_columns as l join directive_places as r on l.id = r.id and l.file = r.file;
let bad_alternate_owner_indent = select id, file from alternate_comment_columns where comment_column <= owner_column;
let bad_alternate_gaps = union(left=bad_alternate_prefix, right=bad_alternate_owner_indent);
let bad_positions = union(left=bad_own_skips, right=bad_inline_ons);
let bad_owners = select id, file from bad_enclosing;
let bad_contexts0 = union(left=bad_owners, right=bad_decorator_gaps);
let bad_contexts = union(left=bad_contexts0, right=bad_full_decorator_gaps);
let bad0 = union(left=bad_positions, right=bad_contexts);
let bad_all = union(left=bad0, right=bad_alternate_gaps);
let bad = antijoin(left=bad_all, right=trailing_call_skips, left-on=["id","file"], right-on=["id","file"]);
let distinct_bad = group-count(from=bad, keys=["id","file"], count="reasons", distinct="id");
let candidates = select l.id as id, l.file as file, r.span as span, r.line as line from distinct_bad as l join directive_places as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])RUF028(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF028)(?:,|$)");
emit violations subject file key(id);
