import suppress from "python/ruff/suppress";
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let left_fields = select parent, child from "semantic-child" where field = "left";
let comparison_lefts = select l.id as comparison, r.child as operand, l.file as file from comparisons as l join left_fields as r on l.id = r.parent;
let comparator_fields = select parent, child from "semantic-child" where field = "comparators";
let comparison_rights = select l.id as comparison, r.child as operand, l.file as file from comparisons as l join comparator_fields as r on l.id = r.parent;
let comparison_operands = union(left=comparison_lefts,right=comparison_rights);
let operand_locations = select l.comparison as comparison, l.operand as operand, l.file as file, r."start-byte" as begin from comparison_operands as l join "source-location" as r on l.operand = r.id;
let ordered_pairs = select l.comparison as comparison, l.file as file, l.operand as left, r.operand as right, l.begin as left_begin, r.begin as right_begin from operand_locations as l join operand_locations as r on l.comparison = r.comparison and l.file = r.file where l.begin < r.begin;
let between_pairs = select l.comparison as comparison, l.left as left, l.right as right from ordered_pairs as l join operand_locations as r on l.comparison = r.comparison and l.file = r.file where r.begin > l.left_begin and r.begin < l.right_begin;
let adjacent_pairs = antijoin(left=ordered_pairs,right=between_pairs,left-on=["comparison","left","right"],right-on=["comparison","left","right"]);
let pair_union = select comparison, file, left, right from adjacent_pairs;
let name_nodes = select id from "semantic-syntax" where kind = "name";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let name_fields = select parent, child from "semantic-child" where field = "id";
let named_nodes = select l.parent as id, r.text as name from name_fields as l join semantic_identifiers as r on l.child = r.id;
let left_named_pairs = select l.comparison as comparison, l.left as left, l.right as right, r.name as name from pair_union as l join named_nodes as r on l.left = r.id;
let name_pairs = select l.comparison as comparison, l.left as left, l.right as right from left_named_pairs as l join named_nodes as r on l.right = r.id and l.name = r.name;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let call_args_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_args = select l.parent as call, l.child as args from "semantic-child" as l join call_args_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as arg from call_args as l join positional_fields as r on l.args = r.parent;
let positional_counts = group-count(from=positional, keys=["call"], count="count", distinct="arg");
let single_positional = select l.call as call, r.arg as arg from positional_counts as l join positional as r on l.call = r.call where l.count = 1;
let keyword_fields = select parent from "semantic-child" where field = "keywords";
let calls_with_keywords = select l.call as call from call_args as l join keyword_fields as r on l.args = r.parent;
let calls_without_keywords = antijoin(left=single_positional, right=calls_with_keywords, left-on=["call"], right-on=["call"]);
let call_functions = select parent, child from "semantic-child" where field = "func";
let named_call_arguments = select l.call as call, l.arg as arg, r.name as name from calls_without_keywords as l join named_nodes as r on l.arg = r.id;
let left_call_functions = select l.call as call, r.child as function from calls_without_keywords as l join call_functions as r on l.call = r.parent;
let function_symbols = select l.call as call, r.path as path, r.provenance as provenance from left_call_functions as l join "qualified-name" as r on l.function = r.id;
let allowed_pure_functions = select call, path from function_symbols where provenance = "builtin" and (path = "builtins.id" or path = "builtins.len" or path = "builtins.type" or path = "builtins.int" or path = "builtins.bool" or path = "builtins.str" or path = "builtins.repr" or path = "builtins.bytes");
let left_call_pairs = select l.comparison as comparison, l.left as left, l.right as right from pair_union as l join "semantic-syntax" as a on l.left = a.id where a.kind = "call";
let call_pairs = select l.comparison as comparison, l.left as left, l.right as right from left_call_pairs as l join "semantic-syntax" as r on l.right = r.id where r.kind = "call";
let left_call_args = select l.comparison as comparison, l.left as left, l.right as right, a.arg as arg from call_pairs as l join calls_without_keywords as a on l.left = a.call;
let both_call_args = select l.comparison as comparison, l.left as left, l.right as right, l.arg as left_arg, r.arg as right_arg from left_call_args as l join calls_without_keywords as r on l.right = r.call;
let left_named_call_args = select l.comparison as comparison, l.left as left, l.right as right, l.right_arg as right_arg, r.name as name from both_call_args as l join named_nodes as r on l.left_arg = r.id;
let equivalent_call_args = select l.comparison as comparison, l.left as left, l.right as right from left_named_call_args as l join named_nodes as r on l.right_arg = r.id and l.name = r.name;
let left_allowed_calls = select l.comparison as comparison, l.left as left, l.right as right, r.path as path from equivalent_call_args as l join allowed_pure_functions as r on l.left = r.call;
let equivalent_call_names = select l.comparison as comparison, l.left as left, l.right as right from left_allowed_calls as l join allowed_pure_functions as r on l.right = r.call and l.path = r.path;
let call_reports = select l.left as id, r.file as file, r.span as span from equivalent_call_names as l join "semantic-syntax" as r on l.left = r.id;
let reportable_names = select * from name_pairs;
let reportable = select l.left as id, r.file as file, r.span as span from reportable_names as l join "semantic-syntax" as r on l.left = r.id;
let all_reportable = union(left=reportable, right=call_reports);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from all_reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLR0124(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLR0124)(?:,|$)");
emit violations subject file key(id);
