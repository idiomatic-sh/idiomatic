import observation_matches from "python/ruff/suppress-matches";
let type_comments = select id, file, span from "comment" where matches(file, "\.pyi$") and matches(text, "^\s*type:\s*([^#]+)(\s*#.*?)?$");
let ignores = select id from "comment" where matches(text, "^\s*type:\s*ignore([^#]+)?(\s*#.*?)?$");
let reportable = antijoin(left=type_comments, right=ignores, left-on=["id"], right-on=["id"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppressed_candidates_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI033)$");
let suppressed_candidates_rows = select id, file, span from candidate_locations;
let suppressed_candidates = antijoin(left=suppressed_candidates_rows, right=suppressed_candidates_matches, left-on=[id, span], right-on=[id, span]);
let violations = select file, span from suppressed_candidates;
let ruf100_directives = select directive, file from suppressed_candidates_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI033"});
observe ruf100_used as noqa_matches;
emit violations subject file key(span);
