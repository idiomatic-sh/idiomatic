import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let parameters = select id, name, owner, ordinal, file from "parameter" where ordinal = 0;
let functions = select id, name, file from "function";
let first_parameter = select l.id as parameter, l.name as name, l.owner as function, l.file as file from parameters as l join functions as r on l.owner = r.id and l.file = r.file where l.name = "self" or l.name = "cls";
let classmethod_decorators = select declaration as function, file from "decorates" where target = "classmethod";
let eligible_classmethod = select l.parameter as parameter, l.name as name, l.function as function, l.file as file from first_parameter as l join classmethod_decorators as r on l.function = r.function and l.file = r.file where l.name = "cls";
let new_methods = select * from first_parameter where name = "cls";
let eligible_new = select l.parameter as parameter, l.name as name, l.function as function, l.file as file from new_methods as l join functions as r on l.function = r.id and l.file = r.file where r.name = "__new__";
let eligible_cls = union(left=eligible_classmethod, right=eligible_new);
let staticmethod_decorators = select declaration as function, file from "decorates" where target = "staticmethod";
let self_parameters = select * from first_parameter where name = "self";
let eligible_self = antijoin(left=self_parameters, right=staticmethod_decorators, left-on=["function","file"], right-on=["function","file"]);
let eligible = union(left=eligible_self, right=eligible_cls);
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign" or kind = "aug-assign";
let targets = select parent, child from "semantic-child" where field = "targets" or field = "target";
let target_roots = select l.id as assignment, r.child as id, l.file as file from assignment_nodes as l join targets as r on l.id = r.parent;
let edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=edges, source="origin", destination="destination");
let target_descendants = select l.assignment as assignment, r.destination as id, l.file as file from target_roots as l join descendants as r on l.id = r.origin;
let roots = select assignment, id, file from target_roots;
let children = select assignment, id, file from target_descendants;
let target_nodes = union(left=roots, right=children);
let binds = select occurrence as binding, name, scope, file from "binding-event" where kind = "bind";
let assigned_parameters = select r.binding as id, r.file as file, r.scope as scope, r.name as name from target_nodes as l join binds as r on l.id = r.binding and l.file = r.file;
let parameter_binds = select l.id as binding, l.file as file, l.scope as scope, l.name as name, r.function as function from assigned_parameters as l join eligible as r on l.scope = r.function and l.name = r.name and l.file = r.file;
let definitions = select id, file, span from "defines";
let located = select l.binding as id, l.file as file, r.span as span from parameter_binds as l join definitions as r on l.binding = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from located as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PLW0642(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0642)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PLW0642(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0642)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0642"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
