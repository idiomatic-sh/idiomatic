import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
let strings = select id, file from "literal-properties" where kind = "string" and ends_with(file, ".pyi");
let contexts = type_context(expressions=strings);
let typed_strings = select l.id as id, l.file as file from strings as l join contexts as r on l.id = r.id and l.file = r.file where r.kind = "type";
let literal_names = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let literal_subscripts = select l.parent as id, l.file as file from "semantic-child" as l join literal_names as r on l.child = r.id and l.file = r.file where l.field = "value";
let literal_strings = axis(from=literal_subscripts, relation="semantic-child", direction=descendant, domain=strings);
let literal_ids = select related as id, file from literal_strings;
let hosts = antijoin(left=typed_strings, right=literal_ids, left-on=["id","file"], right-on=["id","file"]);
let parsed = select id, file from "literal-expression-parse" where dialect = "python-string-annotation" and outcome = "parsed";
let valid_hosts = select l.id as id, l.file as file from hosts as l join parsed as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from valid_hosts as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PYI020(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PYI020)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PYI020(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PYI020)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI020"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
