import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let receiver_edges = select parent, child, file from "semantic-child" where field = "value";
let attribute_receivers = select l.id as attribute, l.file as file, r.child as receiver from attributes as l join receiver_edges as r on l.id = r.parent and l.file = r.file;
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_names = select l.parent as attribute, l.file as file, r.name as name from attr_edges as l join "identifier" as r on l.child = r.id and l.file = r.file;
let split_methods = select attribute, file from attr_names where name = "split" or name = "rsplit";
let split_calls_with_attribute = select l.call as call, l.file as file, l.span as span, l.function as attribute from call_functions as l join split_methods as r on l.function = r.attribute and l.file = r.file;
let split_calls = select l.call as call, l.file as file, l.span as span, r.receiver as receiver from split_calls_with_attribute as l join attribute_receivers as r on l.attribute = r.attribute and l.file = r.file;
let literal_occurrences = select occurrence as id, file, span from "string-literal";
let static_string_receivers = select l.call as call, l.file as file, l.span as span from split_calls as l join literal_occurrences as r on l.receiver = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_edges = select parent, child, ordinal, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, l.file as file, r.child as argument, r.ordinal as ordinal from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let positional_pairs = select l.call as call, l.file as file, l.argument as later, r.argument as earlier, l.ordinal as later_ordinal, r.ordinal as earlier_ordinal from positional_args as l join positional_args as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let prior_counts = group-count(from=positional_pairs, keys=["call", "file", "later"], count="prior_count", distinct="earlier");
let second_positional = select call, file, later as argument from prior_counts where prior_count = 1;
let later_arguments = select l.call as call, l.file as file, l.later as argument from positional_pairs as l;
let first_positional = antijoin(left=positional_args, right=later_arguments, left-on=["call","file","argument"], right-on=["call","file","argument"]);
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let call_keyword_rows = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_name_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_rows = select l.call as call, l.file as file, l.keyword as keyword, r.child as name_id from call_keyword_rows as l join keyword_name_edges as r on l.keyword = r.parent and l.file = r.file;
let named_keywords = select l.call as call, l.file as file, l.keyword as keyword, r.name as name from named_keyword_rows as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let maxsplit_keywords = select call, file, keyword from named_keywords where name = "maxsplit";
let sep_keywords = select call, file, keyword from named_keywords where name = "sep";
let keyword_value_edges = select parent, child, file from "semantic-child" where field = "value";
let maxsplit_keyword_values = select l.call as call, l.file as file, r.child as value from maxsplit_keywords as l join keyword_value_edges as r on l.keyword = r.parent and l.file = r.file;
let sep_keyword_values = select l.call as call, l.file as file, r.child as value from sep_keywords as l join keyword_value_edges as r on l.keyword = r.parent and l.file = r.file;
let integer_literals = select id, file, span from "literal-properties" where kind = "integer";
let number_tokens = select id, file, span, text from "semantic-syntax" where kind = "number";
let integer_spellings = select l.id as id, l.file as file, r.text as text from integer_literals as l join number_tokens as r on l.span = r.span and l.file = r.file;
let positive_integer_values = select id, file from integer_spellings where matches(text, "^(?:[0-9][0-9_]*|0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+)$");
let unary_nodes = select id, file from "semantic-syntax" where kind = "unary-op";
let unary_operand_edges = select parent, child, file from "semantic-child" where field = "operand";
let unary_operator_edges = select parent, child, file from "semantic-child" where field = "op";
let minus_tokens = select id, file from "semantic-syntax" where text = "-";
let unary_minuses = select l.parent as unary, l.file as file from unary_operator_edges as l join minus_tokens as r on l.child = r.id and l.file = r.file;
let minus_operands = select l.parent as unary, l.file as file, l.child as operand from unary_operand_edges as l join unary_nodes as r on l.parent = r.id and l.file = r.file;
let negative_integer_rows = select l.unary as unary, l.file as file, r.operand as operand from unary_minuses as l join minus_operands as r on l.unary = r.unary and l.file = r.file;
let negative_integer_values = select l.unary as id, l.file as file from negative_integer_rows as l join positive_integer_values as r on l.operand = r.id and l.file = r.file;
let integer_values = union(left=positive_integer_values,right=negative_integer_values);
let positional_maxsplit_values = select l.call as call, l.file as file, l.argument as value from second_positional as l;
let keyword_maxsplit_rows = select call, file, value from maxsplit_keyword_values;
let maxsplit_calls = select call, file from maxsplit_keyword_values;
let positional_maxsplit_only = antijoin(left=positional_maxsplit_values,right=maxsplit_calls,left-on=["call","file"],right-on=["call","file"]);
let selected_maxsplit_values = union(left=keyword_maxsplit_rows,right=positional_maxsplit_only);
let valid_explicit_maxsplit = select l.call as call, l.file as file from selected_maxsplit_values as l join integer_values as r on l.value = r.id and l.file = r.file;
let calls_with_maxsplit = select call, file from selected_maxsplit_values;
let default_maxsplit_calls = antijoin(left=static_string_receivers,right=calls_with_maxsplit,left-on=["call","file"],right-on=["call","file"]);
let positional_sep_values = select call, file, argument as value from first_positional;
let sep_values = union(left=sep_keyword_values,right=positional_sep_values);
let valid_sep_values = select l.call as call, l.file as file from sep_values as l join literal_occurrences as r on l.value = r.id and l.file = r.file;
let null_literals = select id, file from "literal-properties" where kind = "null";
let valid_null_sep_values = select l.call as call, l.file as file from sep_values as l join null_literals as r on l.value = r.id and l.file = r.file;
let any_sep_values = select call, file from sep_values;
let calls_with_sep = union(left=valid_sep_values,right=valid_null_sep_values);
let calls_with_invalid_sep = antijoin(left=any_sep_values,right=calls_with_sep,left-on=["call","file"],right-on=["call","file"]);
let valid_sep_calls = antijoin(left=static_string_receivers,right=calls_with_invalid_sep,left-on=["call","file"],right-on=["call","file"]);
let default_sep_candidates = select l.call as call, l.file as file, l.span as span from valid_sep_calls as l join default_maxsplit_calls as r on l.call = r.call and l.file = r.file;
let explicit_candidates = select l.call as call, l.file as file, l.span as span from valid_sep_calls as l join valid_explicit_maxsplit as r on l.call = r.call and l.file = r.file;
let candidates = union(left=default_sep_candidates,right=explicit_candidates);
let candidate_locations = select l.call as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])SIM905(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM905)(?:,|$)");
emit violations subject file key(id);
