import observation_matches from "python/ruff/suppress-matches";
import annotation_origins from "python/ruff/annotation-origins";
import dataclass_decorators from "python/ruff/dataclass-decorators";
import immutable_annotation from "python/ruff/immutable-annotation";
import lookup_symbol_events from "python/ruff/lookup-symbol-events";
import call_syntax from "python/ruff/calls";
let dataclasses = dataclass_decorators();
let nodes = select id, kind, file from "semantic-syntax";
let annotated = select id, file from nodes where kind = "ann-assign";
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let body_edges = select parent, child, file from "semantic-child" where field = "body";
let class_body = select l.class as class, l.file as file, r.child as statement from dataclasses as l join body_edges as r on l.class = r.parent and l.file = r.file;
let assignments = select l.statement as statement, l.file as file from class_body as l join annotated as r on l.statement = r.id and l.file = r.file;
let values = select parent, child, file from "semantic-child" where field = "value";
let annotation_edges = select parent, child, file from "semantic-child" where field = "annotation";
let defaults = select l.statement as statement, l.file as file, r.child as value from assignments as l join values as r on l.statement = r.parent and l.file = r.file;
let called = select l.statement as statement, l.value as value, l.file as file from defaults as l join calls as r on l.value = r.id and l.file = r.file;
let annotations = select l.statement as statement, l.value as value, l.file as file, r.child as annotation from called as l join annotation_edges as r on l.statement = r.parent and l.file = r.file;
let annotation_roots = select annotation as id, file from annotations;
let immutable = immutable_annotation(expressions=annotation_roots);
let immutable_statements = select l.statement as statement, l.file as file from annotations as l join immutable as r on l.annotation = r.id and l.file = r.file;
let annotation_names = annotation_origins(expressions=annotation_roots);
let direct_origins = select l.statement as statement, l.file as file, r.path as path from annotations as l join annotation_names as r on l.annotation = r.id and l.file = r.file;
let subscript_nodes = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as id, l.file as file, r.child as value from subscript_nodes as l join values as r on l.id = r.parent and l.file = r.file;
let subscript_origins = select l.id as id, l.file as file, r.path as path from subscript_values as l join annotation_names as r on l.value = r.id and l.file = r.file;
let mapped_origins = select l.statement as statement, l.file as file, r.path as path from annotations as l join subscript_origins as r on l.annotation = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=mapped_origins);
let class_variables0 = select statement, file from origins where path = "typing.ClassVar" or path = "typing_extensions.ClassVar";
let direct_subscript_origins = select l.id as subscript, l.file as file, r.path as path from subscript_values as l join "qualified-name" as r on l.value = r.id and l.file = r.file;
let direct_classvars = select l.statement as statement, l.file as file from annotations as l join direct_subscript_origins as r on l.annotation = r.subscript and l.file = r.file where r.path = "typing.ClassVar" or r.path = "typing_extensions.ClassVar";
let late_classvar_bases = select l.statement as statement, r.value as base, l.file as file from annotations as l join subscript_values as r on l.annotation = r.id and l.file = r.file;
let late_classvar_named = select l.statement as statement, l.base as base, l.file as file from late_classvar_bases as l join "identifier" as r on l.base = r.id and l.file = r.file where r.name = "ClassVar";
let classvar_reads = select l.statement as statement, l.base as context, r.scope as initial_scope, l.file as file from late_classvar_named as l join "binding-read" as r on l.base = r.reference and l.file = r.file;
let event_ordinals = select ordinal as point, file from "binding-event";
let older_ordinals = select l.point as point, l.file as file from event_ordinals as l join event_ordinals as r on l.file = r.file where l.point < r.point;
let final_ordinals = antijoin(left=event_ordinals, right=older_ordinals, left-on=["point","file"], right-on=["point","file"]);
let classvar_points = select l.statement as statement, l.context as context, l.initial_scope as initial_scope, r.point as point, r.point as header_point, l.file as file from classvar_reads as l join final_ordinals as r on l.file = r.file;
let classvar_contexts0 = extend(from=classvar_points, values={stage: 0});
let classvar_contexts = select context, initial_scope, point, header_point, stage, file from classvar_contexts0;
let classvar_expressions = select context as id, file from classvar_contexts;
let classvar_events = lookup_symbol_events(ordered_contexts=classvar_contexts, expressions=classvar_expressions);
let late_imports = select l.context as context, l.file as file, r.target as target from classvar_events as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let late_classvars = select l.statement as statement, l.file as file from classvar_reads as l join late_imports as r on l.context = r.context and l.file = r.file where r.target = "typing.ClassVar" or r.target = "typing_extensions.ClassVar";
let class_variables1 = union(left=class_variables0, right=direct_classvars);
let class_variables = union(left=class_variables1, right=late_classvars);
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callees = select l.statement as statement, l.file as file, r.child as func from annotations as l join func_edges as r on l.value = r.parent and l.file = r.file;
let functions = select l.statement as statement, l.file as file, r.path as path from callees as l join "qualified-name" as r on l.func = r.id and l.file = r.file;
let function_classes = select l.statement as statement, l.file as file, l.path as function_path, r.class as class from functions as l join class_body as r on l.statement = r.statement and l.file = r.file;
let class_field_functions = select l.statement as statement, l.file as file, l.function_path as function_path, r.path as decorator_path from function_classes as l join dataclasses as r on l.class = r.class and l.file = r.file;
let stdlib_fields = select statement, file from class_field_functions where decorator_path = "dataclasses.dataclass" and function_path = "dataclasses.field";
let attrs_fields = select statement, file from class_field_functions where decorator_path != "dataclasses.dataclass" and (function_path = "attr.ib" or function_path = "attr.attrib" or function_path = "attr.field" or function_path = "attrs.field" or function_path = "attr.Factory" or function_path = "attrs.Factory" or function_path = "attr.attr");
let fields = union(left=stdlib_fields, right=attrs_fields);
let immutable_functions = select statement, file from functions where path = "pathlib.Path" or path = "datetime.date" or path = "datetime.datetime" or path = "datetime.time" or path = "datetime.timedelta" or path = "datetime.timezone" or path = "datetime.tzinfo" or path = "decimal.Decimal" or path = "fractions.Fraction" or path = "operator.attrgetter" or path = "operator.itemgetter" or path = "operator.methodcaller" or path = "types.MappingProxyType" or path = "re.compile" or path = "builtins.bool" or path = "builtins.bytes" or path = "builtins.complex" or path = "builtins.float" or path = "builtins.frozenset" or path = "builtins.int" or path = "builtins.range" or path = "builtins.str" or path = "builtins.tuple" or path = "builtins.slice" or path = "builtins.frozendict";
let class_definitions = select id as class, file from "defines" where kind = "class";
let class_references = select l.statement as statement, l.file as file, r.definition as class from callees as l join "resolves" as r on l.func = r.occurrence and l.file = r.file;
let class_calls = select l.statement as statement, l.file as file, l.class as class from class_references as l join class_definitions as r on l.class = r.class and l.file = r.file;
let descriptor_methods = select owner as class, file from "defines" where (kind = "function" or kind = "method") and (name = "__get__" or name = "__set__" or name = "__delete__");
let descriptor_calls = select l.statement as statement, l.file as file from class_calls as l join descriptor_methods as r on l.class = r.class and l.file = r.file;
let frozen_attrs = select class, file from dataclasses where path = "attrs.frozen" or path = "attr.frozen";
let frozen_attrs_calls = select l.statement as statement, l.file as file from class_calls as l join frozen_attrs as r on l.class = r.class and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "arg";
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let keyword_values = select l.keyword as keyword, l.call as call, l.name as name, l.file as file, r.child as value from keyword_names as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let true_literals = select id, file from "literal-properties" where kind = "boolean" and boolean = "true";
let false_literals = select id, file from "literal-properties" where kind = "boolean" and boolean = "false";
let frozen_keywords = select call, file from keyword_values as k join true_literals as t on k.value = t.id and k.file = t.file where k.name = "frozen";
let frozen_stdlib = select l.class as class, l.file as file from dataclasses as l join frozen_keywords as r on l.expression = r.call and l.file = r.file where l.path = "dataclasses.dataclass";
let frozen_classes = union(left=frozen_attrs, right=frozen_stdlib);
let frozen_class_calls = select l.statement as statement, l.file as file from class_calls as l join frozen_classes as r on l.class = r.class and l.file = r.file;
let simple_decorators = antijoin(left=dataclasses, right=calls, left-on=["expression","file"], right-on=["id","file"]);
let attrs_s_direct = select class, file from simple_decorators where path = "attr.s";
let scalar_auto_values = select id, file from "literal-properties" where kind = "boolean" or kind = "null" or kind = "integer" or kind = "float" or kind = "complex" or kind = "string" or kind = "bytes";
let auto_keywords = select call, value, file from keyword_values where name = "auto_attribs";
let auto_unknown_keywords = antijoin(left=auto_keywords, right=scalar_auto_values, left-on=["value","file"], right-on=["id","file"]);
let auto_false_literals = select id, file from "literal-properties" where kind = "boolean" and boolean = "false" or kind = "integer" or kind = "float" or kind = "complex" or kind = "string" or kind = "bytes";
let auto_false_keywords = select l.call as call, l.file as file from auto_keywords as l join auto_false_literals as r on l.value = r.id and l.file = r.file;
let attrs_false_explicit = select l.class as class, l.file as file from dataclasses as l join auto_false_keywords as r on l.expression = r.call and l.file = r.file where l.path = "attr.s" or l.path = "attr.define" or l.path = "attr.frozen" or l.path = "attr.mutable" or l.path = "attrs.define" or l.path = "attrs.frozen" or l.path = "attrs.mutable";
let attrs_false = union(left=attrs_s_direct, right=attrs_false_explicit);
let attrs_unknown = select l.class as class, l.file as file from dataclasses as l join auto_unknown_keywords as r on l.expression = r.call and l.file = r.file where l.path != "dataclasses.dataclass";
let attrs_unknown_statements = select l.statement as statement, l.file as file from class_body as l join attrs_unknown as r on l.class = r.class and l.file = r.file;
let attrs_false_statements = select l.statement as statement, l.file as file from class_body as l join attrs_false as r on l.class = r.class and l.file = r.file;
let attrs_false_nonfields = antijoin(left=attrs_false_statements, right=fields, left-on=["statement","file"], right-on=["statement","file"]);
let class_exemptions_a = union(left=descriptor_calls, right=frozen_attrs_calls);
let class_exemptions_b = union(left=class_exemptions_a, right=frozen_class_calls);
let class_exemptions_c = union(left=class_exemptions_b, right=attrs_false_nonfields);
let class_exemptions = union(left=class_exemptions_c, right=attrs_unknown_statements);
let all_callees = select l.id as call, l.file as file, r.child as func from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let all_call_paths = select l.call as call, l.file as file, r.path as path from all_callees as l join "qualified-name" as r on l.func = r.id and l.file = r.file;
let newtype_factories = select call, file from all_call_paths where path = "typing.NewType" or path = "typing_extensions.NewType";
let factory_args = select call, expression as value, position, file from "call-argument";
let factory_counts = group-count(from=factory_args, keys=["call","file"], count="count", distinct="value");
let two_arg_factories = select l.call as call, l.file as file from newtype_factories as l join factory_counts as r on l.call = r.call and l.file = r.file where r.count = 2;
let second_factory_args = select call, value as id, file from factory_args where position = 1;
let original_type_roots = select l.call as factory, l.file as file, r.id as root from two_arg_factories as l join second_factory_args as r on l.call = r.call and l.file = r.file;
let original_type_ids = select root as id, file from original_type_roots;
let immutable_originals = immutable_annotation(expressions=original_type_ids);
let immutable_newtype_factories = select l.factory as factory, l.file as file from original_type_roots as l join immutable_originals as r on l.root = r.id and l.file = r.file;
let assign_nodes = select id, file from nodes where kind = "assign";
let assigned_values = select l.id as assignment, l.file as file, r.child as value from assign_nodes as l join values as r on l.id = r.parent and l.file = r.file;
let immutable_newtype_assignments = select l.assignment as assignment, l.file as file from assigned_values as l join immutable_newtype_factories as r on l.value = r.factory and l.file = r.file;
let variables = select id, file from "defines" where kind = "variable";
let variable_owners = axis(from=variables, relation="semantic-child", direction=nearest-ancestor, domain=assign_nodes);
let newtype_aliases = select l.id as alias, l.file as file from variable_owners as l join immutable_newtype_assignments as r on l.related = r.assignment and l.file = r.file;
let resolved_defaults = select l.statement as statement, l.file as file, r.definition as alias from callees as l join "resolves" as r on l.func = r.occurrence and l.file = r.file;
let immutable_newtype_defaults = select l.statement as statement, l.file as file from resolved_defaults as l join newtype_aliases as r on l.alias = r.alias and l.file = r.file;
let exemptions_a = union(left=immutable_statements, right=class_variables);
let exemptions_b = union(left=exemptions_a, right=fields);
let exemptions_c = union(left=exemptions_b, right=immutable_functions);
let exemptions_d = union(left=exemptions_c, right=class_exemptions);
let exemptions = union(left=exemptions_d, right=immutable_newtype_defaults);
let eligible = antijoin(left=annotations, right=exemptions, left-on=["statement","file"], right-on=["statement","file"]);
let candidate_locations = select l.value as id, l.file as file, r.span as span, r."start-line" as line from eligible as l join "source-location" as r on l.value = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:RUF009)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF009"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
