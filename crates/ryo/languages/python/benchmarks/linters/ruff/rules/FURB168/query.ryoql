import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let argument_counts = group-count(from=all_arguments, keys=["call","file"], count="count", distinct="value");
let one_total_argument = select call, file from argument_counts where count = 1;
let two_total_arguments = select call, file from argument_counts where count = 2;
let keyword_calls = select related as call, file from keyword_owners;
let no_keyword_calls = antijoin(left=calls, right=keyword_calls, left-on=["id","file"], right-on=["call","file"]);
let two_positional_calls = select l.id as call, l.file as file from no_keyword_calls as l join two_total_arguments as r on l.id = r.call and l.file = r.file;
let first_arguments = select call, file, value from positional_arguments where position = 0;
let second_arguments = select call, file, value from positional_arguments where position = 1;
let null_values = select id, file from "literal-properties" where kind = "null";
let type_calls = select call, file from qualified_calls where path = "builtins.type";
let single_type_calls = select l.call as call, l.file as file from type_calls as l join one_total_argument as r on l.call = r.call and l.file = r.file;
let type_call_values = select l.call as id, l.file as file, r.value as value from single_type_calls as l join first_arguments as r on l.call = r.call and l.file = r.file;
let none_type_calls = select l.id as id, l.file as file from type_call_values as l join null_values as r on l.value = r.id and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_edges = select l.id as origin, r.child as destination, l.file as file from tuples as l join element_edges as r on l.id = r.parent and l.file = r.file;
let tuple_counts = group-count(from=tuple_edges, keys=["origin","file"], count="count", distinct="destination");
let nonempty_tuples = select origin as id, file from tuple_counts;
let binary_nodes = select id, file from nodes where kind = "bin-op";
let op_edges = select parent, child, file from "semantic-child" where field = "op";
let binary_ops = select l.id as id, l.file as file, r.child as op from binary_nodes as l join op_edges as r on l.id = r.parent and l.file = r.file;
let bitors = select l.id as id, l.file as file from binary_ops as l join nodes as r on l.op = r.id and l.file = r.file where r.text = "|";
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let right_edges = select parent, child, file from "semantic-child" where field = "right";
let bitor_left = select l.id as origin, l.file as file, r.child as destination from bitors as l join left_edges as r on l.id = r.parent and l.file = r.file;
let bitor_right = select l.id as origin, l.file as file, r.child as destination from bitors as l join right_edges as r on l.id = r.parent and l.file = r.file;
let null_left = select l.origin as id, l.file as file from bitor_left as l join null_values as r on l.destination = r.id and l.file = r.file;
let null_right = select l.origin as id, l.file as file from bitor_right as l join null_values as r on l.destination = r.id and l.file = r.file;
let null_both = select l.id as id, l.file as file from null_left as l join null_right as r on l.id = r.id and l.file = r.file;
let eligible_bitors = antijoin(left=bitors, right=null_both, left-on=["id","file"], right-on=["id","file"]);
let bitor_edges = union(left=bitor_left, right=bitor_right);
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as id, l.file as file, r.child as value from subscripts as l join value_edges as r on l.id = r.parent and l.file = r.file;
let typing_unions = select l.id as id, l.file as file from subscript_values as l join "qualified-name" as r on l.value = r.id and l.file = r.file where r.path = "typing.Union" or r.path = "typing_extensions.Union" or r.path = "_typeshed.Union";
let slice_edges = select parent, child, file from "semantic-child" where field = "slice";
let union_slices = select l.id as id, l.file as file, r.child as slice from typing_unions as l join slice_edges as r on l.id = r.parent and l.file = r.file;
let tuple_union_slices = select l.id as id, l.file as file, l.slice as slice from union_slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let single_union_slices = antijoin(left=union_slices, right=tuple_union_slices, left-on=["id","file"], right-on=["id","file"]);
let union_single_edges = select id as origin, slice as destination, file from single_union_slices;
let union_tuple_edges = select l.id as origin, l.file as file, r.child as destination from tuple_union_slices as l join element_edges as r on l.slice = r.parent and l.file = r.file;
let union_edges = union(left=union_single_edges, right=union_tuple_edges);
let union_counts = group-count(from=union_edges, keys=["origin","file"], count="count", distinct="destination");
let nonempty_unions = select origin as id, file from union_counts;
let tuple_or_type_roots = union(left=none_type_calls, right=nonempty_tuples);
let bitor_or_union_roots = union(left=eligible_bitors, right=nonempty_unions);
let eligible_roots = union(left=tuple_or_type_roots, right=bitor_or_union_roots);
let union_context_edges = union(left=bitor_edges, right=union_edges);
let grammar_edges = union(left=tuple_edges, right=union_context_edges);
let structural_good_edges = select l.origin as origin, l.destination as destination, l.file as file from grammar_edges as l join eligible_roots as r on l.destination = r.id and l.file = r.file;
let null_good_edges = select l.origin as origin, l.destination as destination, l.file as file from union_context_edges as l join null_values as r on l.destination = r.id and l.file = r.file;
let locally_good_edges = union(left=structural_good_edges, right=null_good_edges);
let invalid_edges = antijoin(left=grammar_edges, right=locally_good_edges, left-on=["origin","destination","file"], right-on=["origin","destination","file"]);
let local_invalid_roots = select origin as id, file from invalid_edges;
let grammar_paths = closure(edges=grammar_edges, source="origin", destination="destination");
let recursive_invalid_roots = select l.origin as id, r.file as file from grammar_paths as l join local_invalid_roots as r on l.destination = r.id;
let all_invalid_roots = union(left=local_invalid_roots, right=recursive_invalid_roots);
let valid_none_roots = antijoin(left=eligible_roots, right=all_invalid_roots, left-on=["id","file"], right-on=["id","file"]);
let instance_calls = select call, file from qualified_calls where path = "builtins.isinstance";
let binary_instance_calls = select l.call as call, l.file as file from instance_calls as l join two_positional_calls as r on l.call = r.call and l.file = r.file;
let instance_types = select l.call as call, l.file as file, r.value as types from binary_instance_calls as l join second_arguments as r on l.call = r.call and l.file = r.file;
let none_instance_calls = select l.call as call, l.file as file from instance_types as l join valid_none_roots as r on l.types = r.id and l.file = r.file;
let candidates = select l.call as id, l.file as file, r.span as span from none_instance_calls as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB168)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB168"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
