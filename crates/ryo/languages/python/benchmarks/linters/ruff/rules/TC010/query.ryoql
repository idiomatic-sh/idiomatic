import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
import deferred_reads from "python/ruff/deferred-type-reads";
import annotation_context from "python/ruff/annotation-evaluation-context";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let pipe_tokens = select id, file from nodes where text = "|";
let pipes = select l.parent as id, l.file as file from "semantic-child" as l join pipe_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let contexts = type_context(expressions=pipes);
let type_pipes = select id, file from contexts where kind = "type";
let delayed = deferred_reads(expressions=type_pipes);
let annotations = annotation_context(expressions=type_pipes);
let unevaluated = select id, file from annotations where evaluation = "unevaluated";
let visited0 = antijoin(left=type_pipes, right=delayed, left-on=["id","file"], right-on=["id","file"]);
let visited = antijoin(left=visited0, right=unevaluated, left-on=["id","file"], right-on=["id","file"]);
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as id, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let tc_names = select id, file from "qualified-name" where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let tc_plain = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_flags = union(left=tc_names, right=tc_plain);
let tc_ifs = select l.id as id, l.file as file from tests as l join tc_flags as r on l.test = r.id and l.file = r.file;
let tc_bodies = select r.child as id, l.file as file from tc_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let tc_axes = axis(from=visited, relation="semantic-child", direction=ancestor, domain=tc_bodies);
let tc_nested = select id, file from tc_axes;
let tc_self = select l.id as id, l.file as file from visited as l join tc_bodies as r on l.id = r.id and l.file = r.file;
let typing_only = union(left=tc_nested, right=tc_self);
let runtime_pipes = antijoin(left=visited, right=typing_only, left-on=["id","file"], right-on=["id","file"]);
let operands = select parent, child, file from "semantic-child" where field = "left" or field = "right";
let pipe_operands = select l.id as parent, r.child as child, l.file as file from pipes as l join operands as r on l.id = r.parent and l.file = r.file;
let nested_pipe_edges = select l.parent as parent, l.child as child, l.file as file from pipe_operands as l join pipes as r on l.child = r.id and l.file = r.file;
let pipe_paths = closure(edges=nested_pipe_edges, source="parent", destination="child", keys=["file"]);
let nested_pipes = select l.id as root, r.child as pipe, l.file as file from runtime_pipes as l join pipe_paths as r on l.id = r.parent and l.file = r.file;
let own_pipes = select id as root, id as pipe, file from runtime_pipes;
let traversed_pipes = union(left=nested_pipes, right=own_pipes);
let string_literals = select id, file from "literal-properties" where kind = "string" or kind = "bytes";
let string_members_join_1 = select l.root as l_root, e.child as e_child, l.file as l_file, l.pipe as l_pipe, e.parent as e_parent, e.file as e_file from traversed_pipes as l join pipe_operands as e on l.pipe = e.parent and l.file = e.file;
let string_members = select l.l_root as root, l.e_child as id, l.l_file as file from string_members_join_1 as l join string_literals as r on l.e_child = r.id and l.e_file = r.file;
let distinct_members = group-count(from=string_members, keys=["id","file"], count="count", distinct="root");
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from distinct_members as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])TC010(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:TC010)(?:,|$)");
emit violations subject file key(id);
