import suppress from "python/ruff/suppress";
let continues = select id, file, span from "semantic-syntax" where kind = "continue";
let final_roots = select child as id from "semantic-child" where field = "finalbody";
let body_owners = select id from "semantic-syntax" where kind = "if" or kind = "try" or kind = "try-star" or kind = "with" or kind = "async-with" or kind = "match-case" or kind = "elif-else-clause";
let body_fields = select parent, child from "semantic-child" where field = "body";
let body_edges = select r.parent as parent, r.child as child from body_owners as l join body_fields as r on l.id = r.parent;
let else_owners = select id from "semantic-syntax" where kind = "if" or kind = "try" or kind = "try-star" or kind = "for" or kind = "async-for" or kind = "while";
let else_fields = select parent, child from "semantic-child" where field = "orelse";
let else_edges = select r.parent as parent, r.child as child from else_owners as l join else_fields as r on l.id = r.parent;
let case_edges = select parent, child from "semantic-child" where field = "cases";
let body_else = union(left=body_edges, right=else_edges);
let traversal = union(left=body_else, right=case_edges);
let paths = closure(edges=traversal, source="parent", destination="child");
let descendants = select r.child as id from final_roots as l join paths as r on l.id = r.parent;
let reachable = union(left=final_roots, right=descendants);
let reportable = select l.id as id, l.file as file, l.span as span from continues as l join reachable as r on l.id = r.id;
let old_targets = select file from "language-target" where major = 3 and minor < 8;
let versioned = select l.id as id, l.file as file, l.span as span from reportable as l join old_targets as r on l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from versioned as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLE0116(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLE0116)(?:,|$)");
emit violations subject file key(id);
