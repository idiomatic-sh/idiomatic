import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let assignments = select id, kind, file from nodes where kind = "assign" or kind = "ann-assign";
let plain_assignments = select id, file from assignments where kind = "assign";
let plain_targets = select l.id as assignment, r.child as target, l.file as file from plain_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets";
let target_counts = group-count(from=plain_targets, keys=["assignment","file"], count="count", distinct="target");
let single_plain_targets = select l.assignment as assignment, l.target as target, l.file as file from plain_targets as l join target_counts as r on l.assignment = r.assignment and l.file = r.file where r.count = 1;
let other_assignments = select id, file from assignments where kind = "ann-assign" or kind = "aug-assign";
let other_targets = select l.id as assignment, r.child as target, l.file as file from other_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let all_targets = union(left=single_plain_targets, right=other_targets);
let all_names = select id, file from nodes where kind = "name";
let name_targets = select l.assignment as assignment, l.target as target, l.file as file from all_targets as l join all_names as r on l.target = r.id and l.file = r.file;
let dunder_targets = select l.assignment as id, l.file as file from name_targets as l join "identifier" as r on l.target = r.id and l.file = r.file where r.name = "__slots__";
let add_tokens = select id, file from nodes where text = "+" or text = "+=";
let add_operators = select l.parent as id, l.file as file from "semantic-child" as l join add_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let augments = select id, file from assignments where kind = "aug-assign";
let non_add_augments = antijoin(left=augments, right=add_operators, left-on=["id","file"], right-on=["id","file"]);
let eligible_targets = antijoin(left=dunder_targets, right=non_add_augments, left-on=["id","file"], right-on=["id","file"]);
let scope_nodes = select id, kind, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let assignment_scopes = axis(from=eligible_targets, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let module_assignments = select l.id as id, l.file as file from assignment_scopes as l join scope_nodes as r on l.related = r.id and l.file = r.file where r.kind = "class-def";
let assignment_values = select l.id as owner, r.child as value, l.file as file from module_assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let all_values = select owner, value, file from assignment_values;
let collections = select id, file from nodes where kind = "list" or kind = "tuple" or kind = "set" or kind = "dict";
let collection_values = select l.owner as owner, l.value as collection, l.file as file from all_values as l join collections as r on l.value = r.id and l.file = r.file;
let element_edges = select parent, child, ordinal, file from "semantic-child" where field = "elts" or field = "keys";
let elements = select l.collection as collection, r.child as id, r.ordinal as ordinal, l.file as file from collection_values as l join element_edges as r on l.collection = r.parent and l.file = r.file;
let strings = select id, file from "literal-properties" where kind = "string";
let nonstrings = antijoin(left=elements, right=strings, left-on=["id","file"], right-on=["id","file"]);
let nonstring_collections = select collection, file from nonstrings;
let string_collections = antijoin(left=collection_values, right=nonstring_collections, left-on=["collection","file"], right-on=["collection","file"]);
let dictionaries = select id, file from nodes where kind = "dict";
let dictionary_keys = select l.id as collection, r.child as child, l.file as file from dictionaries as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "keys";
let dictionary_values = select l.id as collection, r.child as child, l.file as file from dictionaries as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "values";
let key_counts = group-count(from=dictionary_keys, keys=["collection","file"], count="keys");
let value_counts = group-count(from=dictionary_values, keys=["collection","file"], count="values");
let unpacked_dictionaries = select l.collection as collection, l.file as file from value_counts as l join key_counts as r on l.collection = r.collection and l.file = r.file where l.values != r.keys;
let eligible_collections = antijoin(left=string_collections, right=unpacked_dictionaries, left-on=["collection","file"], right-on=["collection","file"]);
let eligible_elements = select l.collection as collection, r.id as id, r.ordinal as ordinal, l.file as file from eligible_collections as l join elements as r on l.collection = r.collection and l.file = r.file;
let decoded = select l.collection as collection, l.id as id, l.ordinal as ordinal, r.value as value, l.file as file from eligible_elements as l join "string-literal" as r on l.id = r.occurrence and l.file = r.file;
let unsorted = select l.collection as id, l.file as file from decoded as l join decoded as r on l.collection = r.collection and l.file = r.file where l.ordinal < r.ordinal and natural_lt(r.value, l.value);
let unique_unsorted = group-count(from=unsorted, keys=["id","file"], count="inversions");
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from unique_unsorted as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:RUF023)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF023"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
