import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let if_nodes = select id, file from "semantic-syntax" where kind = "if";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let type_check_functions = select id, file from "qualified-name" where path = "builtins.isinstance" or path = "builtins.issubclass" or path = "builtins.callable";
let type_check_calls = select l.call as call, l.file as file from call_functions as l join type_check_functions as r on l.function = r.id and l.file = r.file;
let test_fields = select parent, child from "semantic-child" where field = "test";
let clause_nodes = select id, file from "semantic-syntax" where kind = "elif-else-clause";
let condition_owners = union(left=if_nodes,right=clause_nodes);
let if_test_calls = select l.parent as owner, l.child as test, r.file as file from test_fields as l join condition_owners as r on l.parent = r.id;
let value_child_fields = select parent as source, child as destination from "semantic-child" where field = "values";
let operand_child_fields = select parent as source, child as destination from "semantic-child" where field = "operand";
let test_child_edges = union(left=value_child_fields,right=operand_child_fields);
let test_child_paths = closure(edges=test_child_edges,source="source",destination="destination");
let test_descendants = select l.owner as owner, r.destination as node, l.file as file from if_test_calls as l join test_child_paths as r on l.test = r.source;
let test_roots = select owner, test as node, file from if_test_calls;
let test_expression_nodes = union(left=test_roots,right=test_descendants);
let boolop_nodes = select id, file from "semantic-syntax" where kind = "bool-op";
let unary_nodes = select id, file from "semantic-syntax" where kind = "unary-op";
let unary_operator_fields = select parent, child from "semantic-child" where field = "op";
let not_operator_tokens = select id from "semantic-syntax" where text = "not";
let unary_operator_nodes = select l.parent as unary, l.child as token, r.file as file from unary_operator_fields as l join unary_nodes as r on l.parent = r.id;
let not_unaries = select l.unary as id, l.file as file from unary_operator_nodes as l join not_operator_tokens as r on l.token = r.id;
let allowed_test_nodes_a = union(left=boolop_nodes,right=not_unaries);
let type_check_node_rows = select call as id, file from type_check_calls;
let allowed_test_nodes = union(left=allowed_test_nodes_a,right=type_check_node_rows);
let invalid_test_nodes = antijoin(left=test_expression_nodes,right=allowed_test_nodes,left-on=["node","file"],right-on=["id","file"]);
let invalid_test_owners = select owner, file from invalid_test_nodes;
let type_calls_in_test = select l.owner as owner, l.file as file from test_expression_nodes as l join type_check_calls as r on l.node = r.call and l.file = r.file;
let test_calls_without_invalid = antijoin(left=type_calls_in_test,right=invalid_test_owners,left-on=["owner","file"],right-on=["owner","file"]);
let checked_ifs = select owner as if_node, file from test_calls_without_invalid;
let raise_nodes = select id, file, span from "semantic-syntax" where kind = "raise";
let raise_value_fields = select parent, child from "semantic-child" where field = "exc";
let raise_values = select r.parent as raise, r.child as value, l.file as file from raise_value_fields as r join raise_nodes as l on r.parent = l.id;
let direct_raise_values = antijoin(left=raise_values, right=calls, left-on=["value", "file"], right-on=["id", "file"]);
let builtin_exceptions = select id, file from "qualified-name" where path = "builtins.ArithmeticError" or path = "builtins.AssertionError" or path = "builtins.AttributeError" or path = "builtins.BufferError" or path = "builtins.EOFError" or path = "builtins.Exception" or path = "builtins.ImportError" or path = "builtins.LookupError" or path = "builtins.MemoryError" or path = "builtins.NameError" or path = "builtins.ReferenceError" or path = "builtins.RuntimeError" or path = "builtins.SyntaxError" or path = "builtins.SystemError" or path = "builtins.ValueError";
let bound_exception_references = select reference from "binding-use";
let valid_builtin_exceptions = antijoin(left=builtin_exceptions,right=bound_exception_references,left-on=["id"],right-on=["reference"]);
let direct_builtin_raises = select l.raise as raise, l.file as file from direct_raise_values as l join valid_builtin_exceptions as r on l.value = r.id and l.file = r.file;
let raise_call_values = select l.raise as raise, l.value as call, l.file as file from raise_values as l join calls as r on l.value = r.id and l.file = r.file;
let raise_call_functions = select l.raise as raise, r.function as function, l.file as file from raise_call_values as l join call_functions as r on l.call = r.call and l.file = r.file;
let called_builtin_raises = select l.raise as raise, l.file as file from raise_call_functions as l join valid_builtin_exceptions as r on l.function = r.id and l.file = r.file;
let bad_builtin_raises = union(left=direct_builtin_raises,right=called_builtin_raises);
let body_fields = select parent, child from "semantic-child" where field = "body";
let if_body_roots = select l.parent as owner, l.child as statement, r.file as file from body_fields as l join if_nodes as r on l.parent = r.id;
let orelse_fields = select parent, child from "semantic-child" where field = "orelse";
let if_clause_edges = select r.parent as owner, r.child as clause, l.file as file from orelse_fields as r join if_nodes as l on r.parent = l.id;
let else_clauses = antijoin(left=if_clause_edges,right=test_fields,left-on=["clause"],right-on=["parent"]);
let checked_if_parents = select if_node as parent, file from checked_ifs;
let checked_clause_tests = select l.if_node as clause, l.file as file from checked_ifs as l join clause_nodes as r on l.if_node = r.id and l.file = r.file;
let clauses_with_checked_parent = select l.parent as parent, r.clause as clause, l.file as file from checked_if_parents as l join checked_clause_tests as r on l.file = r.file;
let typed_clause_edges = select l.owner as parent, l.clause as clause, l.file as file from if_clause_edges as l join clauses_with_checked_parent as r on l.owner = r.parent and l.clause = r.clause and l.file = r.file;
let tested_clause_edges = select l.owner as parent, l.clause as clause, l.file as file from if_clause_edges as l join test_fields as r on l.clause = r.parent;
let invalid_typed_clauses = antijoin(left=tested_clause_edges,right=checked_clause_tests,left-on=["clause","file"],right-on=["clause","file"]);
let invalid_clause_parents = select parent, file from invalid_typed_clauses;
let eligible_else_clauses = antijoin(left=else_clauses,right=invalid_clause_parents,left-on=["owner","file"],right-on=["parent","file"]);
let invalid_clause_locations = select l.parent as parent, l.clause as clause, l.file as file, r."start-byte" as start from invalid_typed_clauses as l join "source-location" as r on l.clause = r.id and l.file = r.file;
let tested_clause_locations = select l.parent as parent, l.clause as clause, l.file as file, r."start-byte" as start from tested_clause_edges as l join "source-location" as r on l.clause = r.id and l.file = r.file;
let clauses_after_invalid = select l.parent as parent, r.clause as clause, l.file as file from invalid_clause_locations as l join tested_clause_locations as r on l.parent = r.parent and l.file = r.file where l.start < r.start;
let valid_chain_clauses = antijoin(left=typed_clause_edges,right=clauses_after_invalid,left-on=["parent","clause","file"],right-on=["parent","clause","file"]);
let clause_body_fields = select parent, child from "semantic-child" where field = "body";
let clause_body_roots = select l.owner as owner, r.child as statement, l.file as file from eligible_else_clauses as l join clause_body_fields as r on l.clause = r.parent;
let elif_body_roots = select l.parent as owner, r.child as statement, l.file as file from valid_chain_clauses as l join clause_body_fields as r on l.clause = r.parent;
let branches_with_elif = union(left=if_body_roots,right=elif_body_roots);
let branch_roots = union(left=branches_with_elif,right=clause_body_roots);
let nested_if_branches = select l.owner as parent, r.id as child, l.file as file from branch_roots as l join if_nodes as r on l.statement = r.id and l.file = r.file;
let invalid_parent_if_children = antijoin(left=nested_if_branches,right=checked_ifs,left-on=["parent", "file"],right-on=["if_node", "file"]);
let eligible_ifs = antijoin(left=checked_ifs,right=invalid_parent_if_children,left-on=["if_node", "file"],right-on=["child", "file"]);
let direct_raise_branches = select l.owner as owner, l.statement as raise, l.file as file from branch_roots as l join raise_nodes as r on l.statement = r.id and l.file = r.file;
let branch_statement_roots = select owner, statement as id, file from branch_roots;
let flow_nodes = select id, file from "semantic-syntax" where kind = "return" or kind = "break" or kind = "continue";
let branch_flow_axes = axis(from=branch_statement_roots, relation="semantic-child", direction=descendant, domain=flow_nodes);
let branch_flow_descendants = select l.owner as owner, l.id as statement, r.related as flow, l.file as file from branch_statement_roots as l join branch_flow_axes as r on l.id = r.id and l.file = r.file;
let branch_flow_roots = select l.owner as owner, l.id as statement, r.id as flow, l.file as file from branch_statement_roots as l join flow_nodes as r on l.id = r.id and l.file = r.file;
let branch_flow_rows = union(left=branch_flow_descendants,right=branch_flow_roots);
let nested_scope_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let branch_nested_scope_axes = axis(from=branch_statement_roots, relation="semantic-child", direction=descendant, domain=nested_scope_nodes);
let branch_descendant_scopes = select l.owner as owner, l.id as statement, r.related as scope, l.file as file from branch_statement_roots as l join branch_nested_scope_axes as r on l.id = r.id and l.file = r.file;
let root_scope_rows = select l.owner as owner, l.id as statement, r.id as scope, l.file as file from branch_statement_roots as l join nested_scope_nodes as r on l.id = r.id and l.file = r.file;
let branch_scopes = union(left=branch_descendant_scopes,right=root_scope_rows);
let flow_scope_axes = axis(from=flow_nodes, relation="semantic-child", direction=ancestor, domain=nested_scope_nodes);
let flow_scope_rows = select l.id as flow, r.related as scope, l.file as file from flow_nodes as l join flow_scope_axes as r on l.id = r.id and l.file = r.file;
let branch_flows_with_scope = select l.owner as owner, l.statement as statement, l.flow as flow, r.scope as scope, l.file as file from branch_flow_rows as l join flow_scope_rows as r on l.flow = r.flow and l.file = r.file;
let nested_scope_flows = select l.owner as owner, l.statement as statement, l.flow as flow, l.file as file from branch_flows_with_scope as l join branch_scopes as r on l.statement = r.statement and l.scope = r.scope and l.file = r.file;
let same_scope_flows = antijoin(left=branch_flow_rows,right=nested_scope_flows,left-on=["owner","statement","flow","file"],right-on=["owner","statement","flow","file"]);
let flow_statements = select owner, statement, file from same_scope_flows;
let flow_statement_locations = select l.owner as owner, l.statement as statement, l.file as file, r."start-byte" as start from flow_statements as l join "source-location" as r on l.statement = r.id and l.file = r.file;
let direct_raise_locations = select l.owner as owner, l.raise as raise, l.file as file, r."start-byte" as start from direct_raise_branches as l join "source-location" as r on l.raise = r.id and l.file = r.file;
let prior_flow_pairs = select l.owner as owner, r.raise as raise, l.file as file from flow_statement_locations as l join direct_raise_locations as r on l.owner = r.owner and l.file = r.file where l.start < r.start;
let raises_before_flow = antijoin(left=direct_raise_branches,right=prior_flow_pairs,left-on=["owner","raise","file"],right-on=["owner","raise","file"]);
let accepted_branches = select l.owner as owner, l.raise as raise, l.file as file from raises_before_flow as l join bad_builtin_raises as r on l.raise = r.raise and l.file = r.file;
let accepted_ifs = select l.owner as if_node, l.raise as raise, l.file as file from accepted_branches as l join eligible_ifs as r on l.owner = r.if_node and l.file = r.file;
let reportable = select l.raise as id, r.span as span, l.file as file from accepted_ifs as l join raise_nodes as r on l.raise = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])TRY004(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:TRY004)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TRY004)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY004)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TRY004"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
