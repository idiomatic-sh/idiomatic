import suppress from "python/ruff/suppress";
let scopes = select id from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let later = select l.child as child from bodies as l join bodies as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first = antijoin(left=bodies, right=later, left-on=["child"], right-on=["child"]);
let first_in_scope = select r.child as child from scopes as l join first as r on l.id = r.parent;
let statements = select id, file, span from "semantic-syntax" where kind = "expr";
let candidates = select r.id as id, r.file as file, r.span as span from first_in_scope as l join statements as r on l.child = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let first_values = select l.id as parent, r.child as child from candidates as l join values as r on l.id = r.parent;
let fstrings = select * from "semantic-syntax" where kind = "joined-str";
let bad = select l.parent as parent from first_values as l join fstrings as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from candidates as l join bad as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B021(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B021)(?:,|$)");
emit violations subject file key(id);
