import deferred_context from "python/ruff/deferred-type-reads";
import import_aliases from "python/ruff/import-aliases";
import early_reads from "python/ruff/direct-binding-reads";
import counted_reads from "python/ruff/counted-binding-reads";
import latest_before from "python/ruff/latest-before";
import observation_matches from "python/ruff/suppress-matches";
import deferred_binds from "python/ruff/deferred-binding-targets";
import skipped_reads from "python/ruff/type-definition-skipped";
let alias_parts = import_aliases();
let nodes = select id, kind, file, span from "semantic-syntax";
let definitions0 = select l.id as binding, l.kind as declaration_kind, l.refinement as refinement, l.name as name, l.owner as scope, l.file as file, l.span as span from "defines" as l;
let import_origins = select occurrence as id, target, file from "static-import";
let submodule_definitions = select l.binding as binding,l.file as file from definitions0 as l join alias_parts as r on l.binding=r.alias and l.file=r.file where l.refinement="import" and r.rename="" and matches(r.target,"[.]");
let non_submodule_definitions = antijoin(left=definitions0, right=submodule_definitions, left-on=["binding", "file"], right-on=["binding", "file"]);
let full_import_definitions0 = select r.binding as binding, r.declaration_kind as declaration_kind, r.refinement as refinement, r.name as name, r.scope as scope, r.file as file from submodule_definitions as l join definitions0 as r on l.binding = r.binding and l.file = r.file;
let full_import_definitions = select l.binding as binding, l.declaration_kind as declaration_kind, l.refinement as refinement, l.name as name, l.scope as scope, l.file as file, r.span as span from full_import_definitions0 as l join nodes as r on l.binding = r.id and l.file = r.file;
let definitions = union(left=non_submodule_definitions, right=full_import_definitions);
let events = select occurrence, name, scope, phase, kind, ordinal, file, span from "binding-event";
let all_bindings = select l.occurrence as binding, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file, r.declaration_kind as declaration_kind, r.refinement as refinement, r.span as span from events as l join definitions as r on l.occurrence = r.binding and l.name = r.name and l.file = r.file where l.kind = "bind";
let functions_for_types = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let arguments_for_types = select id, file from nodes where kind = "arg";
let parameter_type_roots = select r.child as id, l.file as file from arguments_for_types as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let return_type_roots = select r.child as id, l.file as file from functions_for_types as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let class_nodes = select id, file from nodes where kind = "class-def";
let call_arguments = select id, file from nodes where kind = "call-arguments";
let class_header_children = select r.child as id, l.file as file from class_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.file as file from class_header_children as l join call_arguments as r on l.id = r.id and l.file = r.file;
let function_type_roots = union(left=parameter_type_roots, right=return_type_roots);
let transient_type_roots = union(left=function_type_roots, right=class_type_roots);
let binding_inputs = select binding as id, file from all_bindings;
let binds_in_header = axis(from=transient_type_roots,relation="semantic-child",direction=descendant,domain=binding_inputs);
let transient_bindings = select related as id,file from binds_in_header;
let bindings = antijoin(left=all_bindings, right=transient_bindings, left-on=["binding", "file"], right-on=["id", "file"]);
let all_reads = select reference as id, name, scope, phase, file from "binding-read";
let read_ids_for_types = select id, file from all_reads;
let ignored_in_calls = skipped_reads(expressions=read_ids_for_types);
let ignored_reference_ids = select id as reference, file from ignored_in_calls;
let delay_inputs = select reference as id,file from "binding-read";
let delayed_reads = deferred_context(expressions=delay_inputs);
let delayed_reference_ids = select id as reference,file from delayed_reads where visit="deferred";
let postponed_or_skipped = union(left=delayed_reference_ids, right=ignored_reference_ids);
let early_reads0 = early_reads(deferred=postponed_or_skipped);
let deferred_resolutions = deferred_binds(reads=all_reads, skipped=ignored_in_calls);
let site_steps = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let site_binds = select occurrence as binding, name, scope, phase, ordinal, file from site_steps where kind = "bind";
let site_last = group-max(from=site_steps, keys=["scope","name","phase","file"], order="ordinal");
let site_last_binds = select occurrence as binding, file from site_last where kind = "bind";
let site_counts = group-count(from=site_binds, keys=["scope","name","phase","file"], count="stores");
let site_repeated_groups = select scope, name, phase, file from site_counts where stores > 1;
let repeated_steps = select l.occurrence as occurrence, l.name as name, l.scope as scope, l.phase as phase, l.kind as kind, l.ordinal as ordinal, l.file as file from site_steps as l join site_repeated_groups as r on l.scope = r.scope and l.name = r.name and l.phase = r.phase and l.file = r.file;
let repeated_binds = select occurrence as binding, name, scope, phase, ordinal, file from repeated_steps where kind = "bind";
let site_following = as-of(left=repeated_steps, right=repeated_steps, left-on=[scope,name,phase,file], right-on=[scope,name,phase,file], left-order="ordinal", right-order="ordinal", bound=after, output={binding:[left,occurrence], kind:[left,kind], next:[right,occurrence], next_kind:[right,kind], file:[left,file]});
let site_followed = select binding, next, file from site_following where kind = "bind" and next_kind = "bind";
let site_ends = antijoin(left=repeated_binds, right=site_followed, left-on=[binding,file], right-on=[binding,file]);
let site_series = as-of(left=repeated_binds, right=site_ends, left-on=[scope,name,phase,file], right-on=[scope,name,phase,file], left-order="ordinal", right-order="ordinal", bound=at-or-after, output={binding:[left,binding], endpoint:[right,binding], scope:[left,scope], name:[left,name], phase:[left,phase], ordinal:[left,ordinal], file:[left,file]});
let site_bind_ids = select binding, file from site_binds;
let timeline_candidates = select l.binding as binding,l.file as file from site_binds as l join site_repeated_groups as r on l.scope=r.scope and l.name=r.name and l.phase=r.phase and l.file=r.file;
let global_name_rows = select name, file from "binding-event" where kind = "global";
let global_name_counts = group-count(from=global_name_rows, keys=["name","file"], count="count");
let global_names = select name, file from global_name_counts;
let global_candidates = select r.binding as binding, r.file as file from global_names as l join bindings as r on l.name = r.name and l.file = r.file;
let shadowed_previous = select previous as binding, file from "binding-shadow" where relationship = "lexical";
let shadow_candidates = select r.binding as binding, r.file as file from shadowed_previous as l join bindings as r on l.binding = r.binding and l.file = r.file;
let candidate_bindings0 = union(left=timeline_candidates, right=global_candidates);
let candidate_bindings = union(left=candidate_bindings0, right=shadow_candidates);
let ordinary_uses = counted_reads(deferred=postponed_or_skipped, bindings=candidate_bindings);
let ordinary_use_points = select l.reference as reference, l.binding as binding, r.ordinal as point, l.file as file from ordinary_uses as l join events as r on l.reference = r.occurrence and l.file = r.file where r.kind = "read";
let deferred_use_points = select reference, occurrence as binding, point, file from deferred_resolutions where kind = "bind";
let actual_use_points = union(left=ordinary_use_points, right=deferred_use_points);
let actual_uses = select binding, file from actual_use_points;
let ordinary_use_keys = select r.scope as scope, r.phase as phase, r.name as name, l.file as file, l.point as ordinal from ordinary_use_points as l join bindings as r on l.binding = r.binding and l.file = r.file;
let use_stream = select scope, phase, name, file, ordinal from ordinary_use_keys;
let ending_stream = select scope, phase, name, file, ordinal from events where kind = "delete" or kind = "cleanup";
let break_stream = union(left=use_stream, right=ending_stream);
let replace_edges = select previous,binding,file from "binding-shadow" where relationship="replacement";
let lexical_edges = select previous,binding,file from "binding-shadow" where relationship="lexical";
let import_sources = select id,file from "defines" where kind="import";
let nonvariable_sources = select id,file from "defines" where kind in ["function","method","class","import"];
let lexical_import_sources = select l.previous as binding,l.file as file from lexical_edges as l join import_sources as r on l.previous=r.id and l.file=r.file;
let ordinary_previous = select l.previous as binding,l.file as file from replace_edges as l join nonvariable_sources as r on l.previous=r.id and l.file=r.file;
let unusual_variables = select id,file from "defines" where kind!="variable" or refinement="exception";
let with_statements = select id,file from "semantic-syntax" where kind in ["with","async-with"];
let site_statements = select id, file from "semantic-syntax" where kind in ["function-def", "async-function-def", "class-def", "return", "delete", "type-alias", "assign", "aug-assign", "ann-assign", "for", "async-for", "while", "if", "with", "async-with", "match", "raise", "try", "try-star", "assert", "import", "import-from", "global", "nonlocal", "expr", "pass", "break", "continue"];
let site_bind_nodes = select binding as id, file from replace_edges;
let site_self_statements = select l.id as id, l.id as related, l.file as file from site_bind_nodes as l join site_statements as r on l.id = r.id and l.file = r.file;
let site_inner_nodes = antijoin(left=site_bind_nodes, right=site_self_statements, left-on=[id,file], right-on=[id,file]);
let site_enclosing = axis(from=site_inner_nodes, relation="semantic-child", direction=nearest-ancestor, domain=site_statements);
let site_enclosing_rows = select id, related, file from site_enclosing;
let site_statement_roots = union(left=site_self_statements, right=site_enclosing_rows);
let possible_with_targets = select l.id as id,l.file as file from site_statement_roots as l join with_statements as r on l.related=r.id and l.file=r.file;
let unusual_currents = union(left=unusual_variables,right=possible_with_targets);
let other_previous = select l.previous as binding,l.file as file from replace_edges as l join unusual_currents as r on l.binding=r.id and l.file=r.file;
let previous_redefinitions = union(left=ordinary_previous,right=other_previous);
let shadowed_sources = union(left=previous_redefinitions,right=lexical_import_sources);
let inspected_previous = union(left=shadowed_sources,right=global_candidates);
let binding_probes = select r.scope as scope,r.phase as phase,r.name as name,r.file as file,r.ordinal as ordinal from inspected_previous as l join bindings as r on l.binding=r.binding and l.file=r.file;
let latest_breaks = latest_before(events=break_stream, probes=binding_probes);
let latest_use_hits = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point from latest_breaks as l join use_stream as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.event_ordinal = r.ordinal;
let inherited_uses = select r.binding as binding, r.file as file from latest_use_hits as l join bindings as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.point = r.ordinal;
let used_binding_rows = union(left=actual_uses, right=inherited_uses);
let used_bindings = select binding from used_binding_rows;
let possible_predecessors = select b.binding as binding,b.scope as scope,b.phase as phase,b.name as name,b.file as file,b.ordinal as ordinal,b.declaration_kind as declaration_kind,b.refinement as refinement,b.span as span from shadowed_sources as l join bindings as b on l.binding=b.binding and l.file=b.file;
let load_events = select occurrence as reference,file from "binding-event" where kind = "read";
let direct_loads = select l.binding as binding,l.file as file from early_reads0 as l join load_events as r on l.reference = r.reference and l.file = r.file;
let maybe_unused = antijoin(left=possible_predecessors,right=direct_loads,left-on=[binding,file],right-on=[binding,file]);
let unused = antijoin(left=maybe_unused,right=used_bindings,left-on=["binding"],right-on=["binding"]);
let loop_kinds = select id, file from nodes where kind = "for" or kind = "async-for";
let loop_target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select l.child as target, r.file as file from loop_target_fields as l join loop_kinds as r on l.parent = r.id;
let tree_children = select child as id from "semantic-child";
let loop_target_starts = select target as id, file from loop_target_roots;
let loop_target_walk = axis(from=loop_target_starts, relation="semantic-child", direction=descendant, domain=tree_children);
let loop_target_paths = select id as target, related as member, file from loop_target_walk;
let loop_target_descendant_members = select member, file from loop_target_paths;
let direct_loop_targets = select target as member, file from loop_target_roots;
let all_loop_targets = union(left=direct_loop_targets, right=loop_target_descendant_members);
let loop_variable_bindings = select l.binding as binding from bindings as l join all_loop_targets as r on l.binding = r.member and l.file = r.file;
let with_item_nodes = select id, file from nodes where kind = "withitem";
let with_target_fields = select parent, child from "semantic-child" where field = "optional-vars";
let with_target_roots = select l.child as target, r.file as file from with_target_fields as l join with_item_nodes as r on l.parent = r.id;
let with_target_starts = select target as id, file from with_target_roots;
let with_target_walk = axis(from=with_target_starts, relation="semantic-child", direction=descendant, domain=tree_children);
let with_target_paths = select id as target, related as member, file from with_target_walk;
let with_target_descendants = select member, file from with_target_paths;
let direct_with_targets = select target as member, file from with_target_roots;
let all_with_targets = union(left=direct_with_targets, right=with_target_descendants);
let with_variable_bindings = select l.binding as binding from bindings as l join all_with_targets as r on l.binding = r.member and l.file = r.file;
let eligible_previous0 = select * from unused where declaration_kind in ["variable", "function", "method", "class", "import"];
let future_imports = select l.binding as binding, l.file as file from definitions as l join import_origins as r on l.binding = r.id and l.file = r.file where l.refinement = "from-import" and starts_with(r.target, "__future__.");
let eligible_previous00 = antijoin(left=eligible_previous0, right=loop_variable_bindings, left-on=["binding"], right-on=["binding"]);
let eligible_previous1 = antijoin(left=eligible_previous00, right=with_variable_bindings, left-on=["binding"], right-on=["binding"]);
let eligible_previous = antijoin(left=eligible_previous1, right=future_imports, left-on=["binding", "file"], right-on=["binding", "file"]);
let successor_pairs = select previous, binding as current, file from "binding-shadow" where relationship = "replacement";
let previous_successors = select s.previous as previous, s.current as current, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as previous_order, l.file as file, l.declaration_kind as previous_kind, l.refinement as previous_refinement, l.span as previous_span from successor_pairs as s join eligible_previous as l on s.previous = l.binding and s.file = l.file;
let reaching_redefinitions = select l.previous as previous, l.current as current, l.name as name, l.scope as scope, l.phase as phase, l.previous_order as previous_order, r.ordinal as current_order, l.file as file, l.previous_kind as previous_kind, r.declaration_kind as current_kind, l.previous_refinement as previous_refinement, r.refinement as current_refinement, l.previous_span as previous_span, r.span as current_span from previous_successors as l join bindings as r on l.current = r.binding and l.file = r.file where l.scope = r.scope and l.phase = r.phase and l.previous_order < r.ordinal;
let immediate_sites = select binding as previous,next as current,file from site_followed;
let indirect_edges = antijoin(left=reaching_redefinitions,right=immediate_sites,left-on=[previous,current,file],right-on=[previous,current,file]);
let intervening_binds = select l.previous as previous,l.current as current,l.file as file from indirect_edges as l join bindings as r on l.scope=r.scope and l.name=r.name and l.phase=r.phase and l.file=r.file where l.previous_order < r.ordinal and r.ordinal < l.current_order;
let potential_redefinitions0 = antijoin(left=reaching_redefinitions,right=intervening_binds,left-on=[previous,current,file],right-on=[previous,current,file]);
let type_parameter_bindings = select id as binding, file from "defines" where kind = "type-parameter";
let potential_redefinitions01 = antijoin(left=potential_redefinitions0, right=type_parameter_bindings, left-on=["current", "file"], right-on=["binding", "file"]);
let potential_redefinitions1 = antijoin(left=potential_redefinitions01, right=future_imports, left-on=["current", "file"], right-on=["binding", "file"]);
let redirect_scope_nodes = select id, file from nodes where kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let redirect_declarations = select occurrence as id, name, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_declaration_owners = axis(from=redirect_declarations, relation="semantic-child", direction=nearest-ancestor, domain=redirect_scope_nodes);
let redirect_home_rows = select r.related as home, l.name as name, l.file as file from redirect_declarations as l join redirect_declaration_owners as r on l.id = r.id;
let redirect_home_counts = group-count(from=redirect_home_rows, keys=["home", "name", "file"], count="count");
let redirect_homes = select home, name, file from redirect_home_counts;
let redirect_names = select name,file from redirect_declarations;
let redirect_bind_events = select r.occurrence as id,r.name as name,r.file as file from redirect_names as l join "binding-event" as r on l.name=r.name and l.file=r.file where r.kind="bind";
let redirect_bind_owners = axis(from=redirect_bind_events, relation="semantic-child", direction=nearest-ancestor, domain=redirect_scope_nodes);
let redirect_bind_homes = select l.id as binding, l.name as name, r.related as home, l.file as file from redirect_bind_events as l join redirect_bind_owners as r on l.id = r.id;
let redirected_bindings = select l.binding as binding, l.home as home, l.file as file from redirect_bind_homes as l join redirect_homes as h on l.home = h.home and l.name = h.name and l.file = h.file;
let previous_homes = select l.previous as previous, l.current as current, r.home as previous_home from potential_redefinitions1 as l join redirected_bindings as r on l.previous = r.binding and l.file = r.file;
let current_homes = select l.previous as previous, l.current as current, r.home as current_home from potential_redefinitions1 as l join redirected_bindings as r on l.current = r.binding and l.file = r.file;
let both_homes = select l.previous as previous, l.current as current, l.previous_home as previous_home, r.current_home as current_home from previous_homes as l join current_homes as r on l.previous = r.previous and l.current = r.current;
let same_homes = select previous, current from both_homes where previous_home = current_home;
let previous_redirected_pairs = select previous, current from previous_homes;
let current_redirected_pairs = select previous, current from current_homes;
let redirected_pairs = union(left=previous_redirected_pairs, right=current_redirected_pairs);
let cross_home_pairs = antijoin(left=redirected_pairs, right=same_homes, left-on=["previous", "current"], right-on=["previous", "current"]);
let potential_redefinitions = antijoin(left=potential_redefinitions1, right=cross_home_pairs, left-on=["previous", "current"], right-on=["previous", "current"]);
let immediate_redefinitions = select * from potential_redefinitions;
let cross_scope_shadow_edges = select binding as current, previous, file from "binding-shadow" where relationship = "lexical";
let cross_imports = select l.binding as binding,l.name as name,l.scope as scope,l.phase as phase,l.ordinal as ordinal,l.file as file,l.declaration_kind as declaration_kind,l.refinement as refinement,l.span as span from eligible_previous as l join cross_scope_shadow_edges as r on l.binding = r.previous and l.file = r.file where l.declaration_kind = "import";
let later_ends = antijoin(left=site_bind_ids, right=site_last_binds, left-on=[binding,file], right-on=[binding,file]);
let final_previous = antijoin(left=cross_imports, right=later_ends, left-on=[binding], right-on=[binding]);
let cross_scope_previous_imports = select l.binding as previous, r.current as current, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as previous_order, l.file as file, l.declaration_kind as previous_kind, l.refinement as previous_refinement, l.span as previous_span from final_previous as l join cross_scope_shadow_edges as r on l.binding = r.previous and l.file = r.file where l.declaration_kind = "import";
let cross_scope_pairs = select l.previous as previous, l.current as current, l.name as name, l.scope as scope, l.phase as phase, l.previous_order as previous_order, r.ordinal as current_order, l.file as file, l.previous_kind as previous_kind, r.declaration_kind as current_kind, l.previous_refinement as previous_refinement, r.refinement as current_refinement, l.previous_span as previous_span, r.span as current_span from cross_scope_previous_imports as l join bindings as r on l.current = r.binding and l.name = r.name and l.file = r.file where l.previous_order < r.ordinal;
let cross_scope_pairs0 = select * from cross_scope_pairs;
let class_shadow_bindings = select l.binding as binding, l.file as file from bindings as l join class_nodes as r on l.scope = r.id and l.file = r.file;
let redundant_from_aliases = select alias as binding,file from alias_parts as a where rename!="" and matches(target,"[.]") and ends_with(target, concat(".", rename));
let redundant_module_aliases = select alias as binding,file from alias_parts where rename!="" and rename=target;
let explicit_exports = union(left=redundant_from_aliases, right=redundant_module_aliases);
let non_class_cross_pairs0 = antijoin(left=cross_scope_pairs0, right=class_shadow_bindings, left-on=["current", "file"], right-on=["binding", "file"]);
let non_class_cross_pairs = antijoin(left=non_class_cross_pairs0, right=type_parameter_bindings, left-on=["current", "file"], right-on=["binding", "file"]);
let ordinary_cross_pairs = antijoin(left=non_class_cross_pairs, right=explicit_exports, left-on=["previous", "file"], right-on=["binding", "file"]);
let dummy_previous = select previous, current from immediate_redefinitions where previous_kind != "import" and matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let decorator_lists = select parent as binding, child as list, file from "semantic-child" where field = "decorator-list";
let decorators = select l.binding as binding, r.child as expression, l.file as file from decorator_lists as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let imported_overload_names = select id, file from "qualified-name" where path = "typing.overload" or path = "typing_extensions.overload";
let module_nodes = select id, file from "semantic-syntax" where kind = "module";
let module_identities = select file, path from "module-identity";
let packaged_modules = select l.id as id, l.file as file from module_nodes as l join module_identities as r on l.file = r.file;
let standalone_modules = antijoin(left=module_nodes, right=packaged_modules, left-on=["id", "file"], right-on=["id", "file"]);
let standalone_typing_modules = select id, file from standalone_modules where glob_any(file, "**/{typing,typing_extensions}.{py,pyi}");
let package_typing_modules = select l.id as id, l.file as file from module_nodes as l join module_identities as r on l.file = r.file where r.path = "typing.__init__" or r.path = "typing_extensions.__init__";
let typing_modules_of_files = union(left=standalone_typing_modules, right=package_typing_modules);
let typing_imports = select file from "static-import" where target = "typing" or starts_with(target, "typing.") or target = "typing_extensions" or starts_with(target, "typing_extensions.");
let typing_import_files = project(from=typing_imports, columns=["file"]);
let typing_files0 = select l.file as file from typing_modules_of_files as l join typing_import_files as r on l.file = r.file;
let typing_files = project(from=typing_files0, columns=["file"]);
let overload_definitions = select id, file from "defines" where name = "overload" and refinement in ["function", "async-function", "method", "async-method", "class"];
let local_overloads = select l.id as id, l.file as file from overload_definitions as l join typing_files as r on l.file = r.file;
let decorator_definitions = select l.expression as id, r.definition as definition, l.file as file from decorators as l join "resolves" as r on l.expression = r.occurrence and l.file = r.file;
let local_overload_names = select l.id as id, l.file as file from decorator_definitions as l join local_overloads as r on l.definition = r.id and l.file = r.file;
let overload_names = union(left=imported_overload_names, right=local_overload_names);
let overloaded = select l.binding as binding, l.file as file from decorators as l join overload_names as r on l.expression = r.id and l.file = r.file;
let ordinary_same_pairs0 = antijoin(left=immediate_redefinitions, right=dummy_previous, left-on=["previous", "current"], right-on=["previous", "current"]);
let ordinary_same_pairs = antijoin(left=ordinary_same_pairs0, right=overloaded, left-on=["previous", "file"], right-on=["binding", "file"]);
let all_potential_redefinitions0 = union(left=ordinary_same_pairs, right=ordinary_cross_pairs);
let previous_submodule_pairs = select l.previous as previous, l.current as current from all_potential_redefinitions0 as l join submodule_definitions as r on l.previous = r.binding and l.file = r.file;
let current_submodule_pairs = select l.previous as previous, l.current as current from all_potential_redefinitions0 as l join submodule_definitions as r on l.current = r.binding and l.file = r.file;
let submodule_pairs = union(left=previous_submodule_pairs, right=current_submodule_pairs);
let import_pair_targets = select l.previous as previous, l.current as current, r.target as target, l.file as file from all_potential_redefinitions0 as l join import_origins as r on l.previous = r.id and l.file = r.file;
let same_import_pairs = select l.previous as previous, l.current as current from import_pair_targets as l join import_origins as r on l.current = r.id and l.file = r.file where l.target = r.target;
let different_import_pairs = antijoin(left=submodule_pairs, right=same_import_pairs, left-on=["previous", "current"], right-on=["previous", "current"]);
let all_potential_redefinitions = antijoin(left=all_potential_redefinitions0, right=different_import_pairs, left-on=["previous", "current"], right-on=["previous", "current"]);
let assignment_kinds = select binding from definitions where declaration_kind = "variable";
let old_assignments = select l.previous as previous, l.current as current from all_potential_redefinitions as l join assignment_kinds as r on l.previous = r.binding;
let non_exception_kinds = select binding from definitions where declaration_kind = "variable" and refinement != "exception";
let plain_assignment_kinds = antijoin(left=non_exception_kinds, right=with_variable_bindings, left-on=["binding"], right-on=["binding"]);
let new_assignments = select l.previous as previous, l.current as current from all_potential_redefinitions as l join plain_assignment_kinds as r on l.current = r.binding;
let assignment_pairs = select previous, current from old_assignments as l join new_assignments as r on l.previous = r.previous and l.current = r.current;
let non_assignment_pairs = antijoin(left=all_potential_redefinitions,right=assignment_pairs,left-on=["previous","current"],right-on=["previous","current"]);
let non_loop_pairs = antijoin(left=non_assignment_pairs, right=loop_variable_bindings, left-on=["current"], right-on=["binding"]);
let branch_kinds = select id from nodes where kind in ["if", "try", "try-star", "with", "async-with", "match-case", "if-exp"];
let tree_parents = select parent as id from "semantic-child";
let pair_previous = select previous as id from non_loop_pairs;
let pair_current = select current as id from non_loop_pairs;
let event_starts = union(left=pair_previous, right=pair_current);
let event_walk = axis(from=event_starts, relation="semantic-child", direction=ancestor, domain=tree_parents);
let event_branch_ancestors = select id as binding, related as owner from event_walk;
let branch_owners = select l.binding as binding, l.owner as owner from event_branch_ancestors as l join branch_kinds as r on l.owner = r.id;
let branch_arm_candidates = select l.binding as binding, l.owner as owner, r.child as arm_node, r.field as field from branch_owners as l join "semantic-child" as r on l.owner = r.parent;
let arm_starts = select binding as id, owner, field, arm_node from branch_arm_candidates;
let arm_walk = axis(from=arm_starts, relation="semantic-child", direction=ancestor, domain=tree_parents);
let walked_members = select id as binding, owner, field, arm_node from arm_walk where related = arm_node;
let definition_statements = select id from nodes where kind in ["function-def", "async-function-def", "class-def"];
let arm_statements = select l.id as id, l.owner as owner, l.field as field, l.arm_node as arm_node from arm_starts as l join definition_statements as r on l.arm_node = r.id;
let statement_members = select id as binding, owner, field, arm_node from arm_statements where id = arm_node;
let branch_members = union(left=walked_members, right=statement_members);
let try_body = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "body";
let try_orelse = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "orelse";
let try_main = union(left=try_body,right=try_orelse);
let ordinary_branch_fields0 = select l.binding as binding, l.owner as owner, l.field as arm, l.owner as arm_id from branch_members as l join nodes as r on l.owner = r.id where (r.kind != "try" and r.kind != "try-star" and r.kind != "if" and r.kind != "with" and r.kind != "async-with") or (r.kind = "with" or r.kind = "async-with") and l.field = "body" or r.kind = "if" and l.field != "orelse" or (r.kind = "try" or r.kind = "try-star") and l.field = "finalbody";
let conditional_clause_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "if" and l.field = "orelse";
let ordinary_branch_fields = union(left=ordinary_branch_fields0, right=conditional_clause_fields);
let clause_branch_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "try" and l.field = "handlers" or r.kind = "try-star" and l.field = "handlers";
let try_main_owners = select binding, owner, owner as arm_id from try_main;
let try_main_arms = extend(from=try_main_owners, values={arm: "try-main"});
let branch_paths_ordinary = union(left=ordinary_branch_fields,right=clause_branch_fields);
let branch_paths = union(left=branch_paths_ordinary,right=try_main_arms);
let left_paths = select p.previous as previous, p.current as current, b.owner as owner, b.arm as arm, b.arm_id as arm_id from non_loop_pairs as p join branch_paths as b on p.previous = b.binding;
let right_paths = select p.previous as previous, p.current as current, b.owner as owner, b.arm as arm, b.arm_id as arm_id from non_loop_pairs as p join branch_paths as b on p.current = b.binding;
let left_only_paths = antijoin(left=left_paths,right=right_paths,left-on=["previous","current","owner","arm","arm_id"],right-on=["previous","current","owner","arm","arm_id"]);
let right_only_paths = antijoin(left=right_paths,right=left_paths,left-on=["previous","current","owner","arm","arm_id"],right-on=["previous","current","owner","arm","arm_id"]);
let different_left = select previous, current from left_only_paths;
let different_right = select previous, current from right_only_paths;
let different_paths = union(left=different_left,right=different_right);
let same_branch_pairs = antijoin(left=non_loop_pairs,right=different_paths,left-on=["previous","current"],right-on=["previous","current"]);
let binding_marks = select scope, phase, name, file, ordinal, binding as occurrence from bindings;
let delete_marks = select scope, phase, name, file, ordinal, occurrence from events where kind = "delete" or kind = "cleanup";
let timeline = union(left=binding_marks, right=delete_marks);
let visible_successors = select l.previous as previous,l.file as file from immediate_sites as l join bindings as r on l.current=r.binding and l.file=r.file;
let unproven_next = antijoin(left=same_branch_pairs,right=visible_successors,left-on=[previous,file],right-on=[previous,file]);
let timeline_next = as-of(left=unproven_next, right=timeline, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="previous_order", right-order="ordinal", bound=after, output={previous:[left,previous], previous_order:[left,previous_order], next:[right,occurrence], next_order:[right,ordinal], file:[left,file]});
let delete_nodes = select occurrence as id, ordinal, file from events where kind = "delete" or kind = "cleanup";
let delete_followed = select s.previous as previous, s.previous_order as previous_order, s.file as file from timeline_next as s join delete_nodes as d on s.next = d.id and s.next_order = d.ordinal and s.file = d.file;
let intervening_deletes = select l.previous as previous, l.current as current from same_branch_pairs as l join delete_followed as r on l.previous = r.previous and l.previous_order = r.previous_order and l.file = r.file;
let surviving_pairs = antijoin(left=same_branch_pairs,right=intervening_deletes,left-on=["previous","current"],right-on=["previous","current"]);
let candidate_pairs = select previous, current from surviving_pairs;
let local_global_declarations = select occurrence as declaration, name, scope, phase, ordinal, file, span from events where kind = "global";
let declaration_homes = select l.id as current, r.related as home from redirect_declarations as l join redirect_declaration_owners as r on l.id = r.id;
let previous_bind_homes = select binding as previous, home from redirect_bind_homes;
let variable_bindings = select binding, name, scope, ordinal, file from bindings where declaration_kind = "variable";
let unreferenced_variable_bindings = antijoin(left=variable_bindings, right=used_bindings, left-on=["binding"], right-on=["binding"]);
let global_event_rows = select l.scope as scope, h.home as phase, l.name as name, l.file as file, l.ordinal as ordinal from unreferenced_variable_bindings as l join previous_bind_homes as h on l.binding = h.previous;
let global_probe_rows = select l.scope as scope, h.home as phase, l.name as name, l.file as file, l.ordinal as ordinal from local_global_declarations as l join declaration_homes as h on l.declaration = h.current;
let global_hits = latest_before(events=global_event_rows, probes=global_probe_rows);
let unreferenced_global_bindings = select l.declaration as current, l.file as file, l.span as span from local_global_declarations as l join global_hits as r on l.scope = r.scope and l.name = r.name and l.file = r.file and l.ordinal = r.point;
let ordinary_report_ids = select current as id from candidate_pairs;
let ordinary_report_candidates = select l.id as id, r.file as file, r.span as span from ordinary_report_ids as l join definitions as r on l.id = r.binding;
let global_report_candidates = select current as id, file, span from unreferenced_global_bindings;
let report_candidates = union(left=ordinary_report_candidates, right=global_report_candidates);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from report_candidates as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, code="F811");
let violations = antijoin(left=report_candidates, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","F811") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
