import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
import deferred_events from "python/ruff/deferred-read-events";
let nodes = select id, kind, file, span from "semantic-syntax";
let definitions0 = select l.id as binding, l.kind as declaration_kind, l.refinement as refinement, l.name as name, l.owner as scope, l.file as file, l.span as span from "defines" as l join nodes as r on l.id = r.id;
let import_origins = select occurrence as id, target, file from "static-import";
let asname_edges = select parent as id, child as asname, file from "semantic-child" where field = "asname";
let unaliased_definitions = antijoin(left=definitions0, right=asname_edges, left-on=["binding", "file"], right-on=["id", "file"]);
let submodule_definitions = select l.binding as binding, l.file as file from unaliased_definitions as l join import_origins as r on l.binding = r.id and l.file = r.file where l.refinement = "import" and matches(r.target, "[.]");
let non_submodule_definitions = antijoin(left=definitions0, right=submodule_definitions, left-on=["binding", "file"], right-on=["binding", "file"]);
let full_import_definitions0 = select l.binding as binding, l.declaration_kind as declaration_kind, l.refinement as refinement, l.name as name, l.scope as scope, l.file as file, r.span as span from definitions0 as l join nodes as r on l.binding = r.id and l.file = r.file;
let full_import_definitions = select l.binding as binding, l.declaration_kind as declaration_kind, l.refinement as refinement, l.name as name, l.scope as scope, l.file as file, l.span as span from full_import_definitions0 as l join submodule_definitions as r on l.binding = r.binding and l.file = r.file;
let definitions = union(left=non_submodule_definitions, right=full_import_definitions);
let events = select occurrence, name, scope, phase, kind, ordinal, file, span from "binding-event";
let all_bindings = select l.occurrence as binding, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.file as file, r.declaration_kind as declaration_kind, r.refinement as refinement, r.span as span from events as l join definitions as r on l.occurrence = r.binding and l.name = r.name and l.file = r.file where l.kind = "bind";
let functions_for_types = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let arguments_for_types = select id, file from nodes where kind = "arg";
let parameter_type_roots = select r.child as id, l.file as file from arguments_for_types as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let return_type_roots = select r.child as id, l.file as file from functions_for_types as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let class_nodes = select id, file from nodes where kind = "class-def";
let call_arguments = select id, file from nodes where kind = "call-arguments";
let class_header_children = select r.child as id, l.file as file from class_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.file as file from class_header_children as l join call_arguments as r on l.id = r.id and l.file = r.file;
let function_type_roots = union(left=parameter_type_roots, right=return_type_roots);
let transient_type_roots = union(left=function_type_roots, right=class_type_roots);
let binding_inputs = select binding as id, file from all_bindings;
let transient_binding_axes = axis(from=binding_inputs, relation="semantic-child", direction=ancestor, domain=transient_type_roots);
let transient_bindings = select id, file from transient_binding_axes;
let bindings = antijoin(left=all_bindings, right=transient_bindings, left-on=["binding", "file"], right-on=["id", "file"]);
let all_reads = select reference as id, name, scope, phase, file from "binding-read";
let deferred_resolutions = deferred_events(missing=all_reads);
let ordinary_uses = antijoin(left="binding-use", right=deferred_resolutions, left-on=["reference", "file"], right-on=["reference", "file"]);
let ordinary_use_points = select l.reference as reference, l.binding as binding, r.ordinal as point, l.file as file from ordinary_uses as l join events as r on l.reference = r.occurrence and l.file = r.file where r.kind = "read";
let deferred_use_points = select reference, occurrence as binding, point, file from deferred_resolutions where kind = "bind";
let actual_use_points = union(left=ordinary_use_points, right=deferred_use_points);
let actual_uses = select binding, file from actual_use_points;
let source_use_points = select l.binding as binding, l.point as point, r.name as name, r.scope as scope, r.phase as phase, r.ordinal as ordinal, l.file as file from actual_use_points as l join bindings as r on l.binding = r.binding and l.file = r.file;
let copied_uses = select r.binding as binding, l.binding as source, l.ordinal as source_point, r.ordinal as target_point, l.name as name, l.scope as scope, l.phase as phase, l.file as file from source_use_points as l join bindings as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where l.point < r.ordinal;
let broken_copies = select l.binding as binding, l.source as source, l.file as file from copied_uses as l join events as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where (r.kind = "delete" or r.kind = "cleanup") and l.source_point < r.ordinal and r.ordinal < l.target_point;
let live_copies = antijoin(left=copied_uses, right=broken_copies, left-on=["binding", "source", "file"], right-on=["binding", "source", "file"]);
let inherited_uses = select binding, file from live_copies;
let used_binding_rows = union(left=actual_uses, right=inherited_uses);
let used_bindings = select binding from used_binding_rows;
let unused = antijoin(left=bindings,right=used_bindings,left-on=["binding"],right-on=["binding"]);
let branch_kinds = select id from nodes where kind = "if" or kind = "try" or kind = "try-star" or kind = "with" or kind = "async-with" or kind = "match-case" or kind = "if-exp";
let child_to_parent = select child as origin, parent as destination from "semantic-child";
let ancestry = closure(edges=child_to_parent,source="origin",destination="destination");
let event_branch_ancestors = select l.occurrence as binding, r.destination as owner from events as l join ancestry as r on l.occurrence = r.origin;
let branch_owners = select l.binding as binding, l.owner as owner from event_branch_ancestors as l join branch_kinds as r on l.owner = r.id;
let branch_arm_candidates = select l.binding as binding, l.owner as owner, r.child as arm_node, r.field as field from branch_owners as l join "semantic-child" as r on l.owner = r.parent;
let branch_members = select l.binding as binding, l.owner as owner, l.field as field, l.arm_node as arm_node from branch_arm_candidates as l join ancestry as r on l.arm_node = r.destination and l.binding = r.origin;
let try_body = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "body";
let try_orelse = select l.binding as binding, l.owner as owner from branch_members as l join nodes as r on l.owner = r.id where (r.kind = "try" or r.kind = "try-star") and l.field = "orelse";
let try_main = union(left=try_body,right=try_orelse);
let ordinary_branch_fields0 = select l.binding as binding, l.owner as owner, l.field as arm, l.owner as arm_id from branch_members as l join nodes as r on l.owner = r.id where (r.kind != "try" and r.kind != "try-star" and r.kind != "if") or r.kind = "if" and l.field != "orelse" or (r.kind = "try" or r.kind = "try-star") and l.field = "finalbody";
let conditional_clause_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "if" and l.field = "orelse";
let ordinary_branch_fields = union(left=ordinary_branch_fields0, right=conditional_clause_fields);
let clause_branch_fields = select l.binding as binding, l.owner as owner, l.field as arm, l.arm_node as arm_id from branch_members as l join nodes as r on l.owner = r.id where r.kind = "try" and l.field = "handlers" or r.kind = "try-star" and l.field = "handlers";
let try_main_owners = select binding, owner, owner as arm_id from try_main;
let try_main_arms = extend(from=try_main_owners, values={arm: "try-main"});
let branch_paths_ordinary = union(left=ordinary_branch_fields,right=clause_branch_fields);
let branch_paths = union(left=branch_paths_ordinary,right=try_main_arms);
let loop_kinds = select id, file from nodes where kind = "for" or kind = "async-for";
let loop_target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select l.child as target, r.file as file from loop_target_fields as l join loop_kinds as r on l.parent = r.id;
let syntax_edges = select parent as origin, child as destination from "semantic-child";
let syntax_descendants = closure(edges=syntax_edges, source="origin", destination="destination");
let loop_target_paths = select l.target as target, r.destination as member, l.file as file from loop_target_roots as l join syntax_descendants as r on l.target = r.origin;
let loop_target_descendant_members = select member, file from loop_target_paths;
let direct_loop_targets = select target as member, file from loop_target_roots;
let all_loop_targets = union(left=direct_loop_targets, right=loop_target_descendant_members);
let loop_variable_bindings = select l.binding as binding from bindings as l join all_loop_targets as r on l.binding = r.member and l.file = r.file;
let eligible_previous0 = select * from unused where declaration_kind = "variable" or declaration_kind = "function" or declaration_kind = "method" or declaration_kind = "class" or declaration_kind = "import";
let future_imports = select l.binding as binding, l.file as file from definitions as l join import_origins as r on l.binding = r.id and l.file = r.file where l.refinement = "from-import" and starts_with(r.target, "__future__.");
let eligible_previous1 = antijoin(left=eligible_previous0, right=loop_variable_bindings, left-on=["binding"], right-on=["binding"]);
let eligible_previous = antijoin(left=eligible_previous1, right=future_imports, left-on=["binding", "file"], right-on=["binding", "file"]);
let potential_redefinitions0 = select l.binding as previous, r.binding as current, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as previous_order, r.ordinal as current_order, l.file as file, l.declaration_kind as previous_kind, r.declaration_kind as current_kind, l.refinement as previous_refinement, r.refinement as current_refinement, l.span as previous_span, r.span as current_span from eligible_previous as l join bindings as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where l.ordinal < r.ordinal;
let potential_redefinitions = antijoin(left=potential_redefinitions0, right=future_imports, left-on=["current", "file"], right-on=["binding", "file"]);
let intervening_bindings = select p.previous as previous, p.current as current from potential_redefinitions as p join bindings as b on p.scope = b.scope and p.phase = b.phase and p.name = b.name and p.file = b.file where p.previous_order < b.ordinal and b.ordinal < p.current_order;
let immediate_redefinitions = antijoin(left=potential_redefinitions, right=intervening_bindings, left-on=["previous", "current"], right-on=["previous", "current"]);
let cross_scope_shadow_edges = select binding as current, previous, file from "binding-shadow" where relationship = "lexical";
let cross_scope_previous_imports = select l.binding as previous, r.current as current, l.name as name, l.scope as scope, l.phase as phase, l.ordinal as previous_order, l.file as file, l.declaration_kind as previous_kind, l.refinement as previous_refinement, l.span as previous_span from eligible_previous as l join cross_scope_shadow_edges as r on l.binding = r.previous and l.file = r.file where l.declaration_kind = "import";
let cross_scope_pairs = select l.previous as previous, l.current as current, l.name as name, l.scope as scope, l.phase as phase, l.previous_order as previous_order, r.ordinal as current_order, l.file as file, l.previous_kind as previous_kind, r.declaration_kind as current_kind, l.previous_refinement as previous_refinement, r.refinement as current_refinement, l.previous_span as previous_span, r.span as current_span from cross_scope_previous_imports as l join bindings as r on l.current = r.binding and l.name = r.name and l.file = r.file where l.previous_order < r.ordinal;
let cross_scope_pairs0 = select * from cross_scope_pairs;
let class_shadow_bindings = select l.binding as binding, l.file as file from bindings as l join class_nodes as r on l.scope = r.id and l.file = r.file;
let asname_labels = select l.id as id, r.name as name, l.file as file from asname_edges as l join "identifier" as r on l.asname = r.id and l.file = r.file;
let import_segments = capture(from=import_origins, path="target", pattern="{*module}.{*member}", captures=["module", "member"]);
let redundant_from_aliases = select l.id as binding, l.file as file from asname_labels as l join import_segments as r on l.id = r.id and l.file = r.file where l.name = r.member;
let redundant_module_aliases = select l.id as binding, l.file as file from asname_labels as l join import_origins as r on l.id = r.id and l.file = r.file where l.name = r.target;
let explicit_exports = union(left=redundant_from_aliases, right=redundant_module_aliases);
let non_class_cross_pairs = antijoin(left=cross_scope_pairs0, right=class_shadow_bindings, left-on=["current", "file"], right-on=["binding", "file"]);
let ordinary_cross_pairs = antijoin(left=non_class_cross_pairs, right=explicit_exports, left-on=["previous", "file"], right-on=["binding", "file"]);
let dummy_previous = select previous, current from immediate_redefinitions where previous_kind != "import" and matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let decorator_lists = select parent as binding, child as list, file from "semantic-child" where field = "decorator-list";
let decorators = select l.binding as binding, r.child as expression, l.file as file from decorator_lists as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let overload_names = select id, file from "qualified-name" where path = "typing.overload" or path = "typing_extensions.overload";
let overloaded = select l.binding as binding, l.file as file from decorators as l join overload_names as r on l.expression = r.id and l.file = r.file;
let ordinary_same_pairs0 = antijoin(left=immediate_redefinitions, right=dummy_previous, left-on=["previous", "current"], right-on=["previous", "current"]);
let ordinary_same_pairs = antijoin(left=ordinary_same_pairs0, right=overloaded, left-on=["previous", "file"], right-on=["binding", "file"]);
let all_potential_redefinitions0 = union(left=ordinary_same_pairs, right=ordinary_cross_pairs);
let previous_submodule_pairs = select l.previous as previous, l.current as current from all_potential_redefinitions0 as l join submodule_definitions as r on l.previous = r.binding and l.file = r.file;
let current_submodule_pairs = select l.previous as previous, l.current as current from all_potential_redefinitions0 as l join submodule_definitions as r on l.current = r.binding and l.file = r.file;
let submodule_pairs = union(left=previous_submodule_pairs, right=current_submodule_pairs);
let import_pair_targets = select l.previous as previous, l.current as current, r.target as target, l.file as file from all_potential_redefinitions0 as l join import_origins as r on l.previous = r.id and l.file = r.file;
let same_import_pairs = select l.previous as previous, l.current as current from import_pair_targets as l join import_origins as r on l.current = r.id and l.file = r.file where l.target = r.target;
let different_import_pairs = antijoin(left=submodule_pairs, right=same_import_pairs, left-on=["previous", "current"], right-on=["previous", "current"]);
let all_potential_redefinitions = antijoin(left=all_potential_redefinitions0, right=different_import_pairs, left-on=["previous", "current"], right-on=["previous", "current"]);
let left_paths = select p.previous as previous, p.current as current, b.owner as owner, b.arm as arm, b.arm_id as arm_id from all_potential_redefinitions as p join branch_paths as b on p.previous = b.binding;
let right_paths = select p.previous as previous, p.current as current, b.owner as owner, b.arm as arm, b.arm_id as arm_id from all_potential_redefinitions as p join branch_paths as b on p.current = b.binding;
let left_only_paths = antijoin(left=left_paths,right=right_paths,left-on=["previous","current","owner","arm","arm_id"],right-on=["previous","current","owner","arm","arm_id"]);
let right_only_paths = antijoin(left=right_paths,right=left_paths,left-on=["previous","current","owner","arm","arm_id"],right-on=["previous","current","owner","arm","arm_id"]);
let different_left = select previous, current from left_only_paths;
let different_right = select previous, current from right_only_paths;
let different_paths = union(left=different_left,right=different_right);
let same_branch_pairs = antijoin(left=all_potential_redefinitions,right=different_paths,left-on=["previous","current"],right-on=["previous","current"]);
let intervening_deletes = select p.previous as previous, p.current as current from same_branch_pairs as p join events as e on p.scope = e.scope and p.phase = e.phase and p.name = e.name and p.file = e.file where (e.kind = "delete" or e.kind = "cleanup") and e.ordinal > p.previous_order and e.ordinal < p.current_order;
let surviving_pairs = antijoin(left=same_branch_pairs,right=intervening_deletes,left-on=["previous","current"],right-on=["previous","current"]);
let assignment_kinds = select binding from definitions where declaration_kind = "variable";
let old_assignments = select l.previous as previous, l.current as current from surviving_pairs as l join assignment_kinds as r on l.previous = r.binding;
let new_assignments = select l.previous as previous, l.current as current from surviving_pairs as l join assignment_kinds as r on l.current = r.binding;
let assignment_pairs = select previous, current from old_assignments as l join new_assignments as r on l.previous = r.previous and l.current = r.current;
let non_assignment_pairs = antijoin(left=surviving_pairs,right=assignment_pairs,left-on=["previous","current"],right-on=["previous","current"]);
let non_loop_pairs = antijoin(left=non_assignment_pairs, right=loop_variable_bindings, left-on=["current"], right-on=["binding"]);
let candidate_pairs = select previous, current from non_loop_pairs;
let local_global_declarations = select occurrence as declaration, name, scope, phase, ordinal, file, span from events where kind = "global";
let prior_global_bindings = select l.declaration as current, b.binding as previous, l.name as name, l.scope as scope, l.phase as phase, b.ordinal as previous_order, l.ordinal as current_order, l.file as file, l.span as span, b.binding as binding from local_global_declarations as l join bindings as b on l.name = b.name and l.scope = b.scope and l.phase = b.phase and l.file = b.file where b.ordinal < l.ordinal and b.declaration_kind = "variable";
let unreferenced_global_bindings = antijoin(left=prior_global_bindings, right=used_bindings, left-on=["binding"], right-on=["binding"]);
let ordinary_report_ids = select current as id from candidate_pairs;
let ordinary_report_candidates = select l.id as id, r.file as file, r.span as span from ordinary_report_ids as l join definitions as r on l.id = r.binding;
let global_report_candidates = select current as id, file, span from unreferenced_global_bindings;
let report_candidates = union(left=ordinary_report_candidates, right=global_report_candidates);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from report_candidates as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F811(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F811)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:F811)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F811)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "F811"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
