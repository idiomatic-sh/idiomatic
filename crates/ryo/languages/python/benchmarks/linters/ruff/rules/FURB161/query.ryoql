import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, l.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let qualified_bin_functions = select id, file from "qualified-name" where path = "builtins.bin";
let bin_calls = select l.call as call, l.file as file from call_functions as l join qualified_bin_functions as r on l.function = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attr_value_edges = select parent, child, file from "semantic-child" where field = "value";
let attribute_receivers = select l.id as attribute, l.file as file, r.child as receiver from attributes as l join attr_value_edges as r on l.id = r.parent and l.file = r.file;
let inner_bin_calls = select l.attribute as attribute, l.file as file, r.call as call from attribute_receivers as l join bin_calls as r on l.receiver = r.call and l.file = r.file;
let attr_name_edges = select parent, child, file from "semantic-child" where field = "attr";
let attribute_names = select l.parent as attribute, l.file as file, r.name as name from attr_name_edges as l join "identifier" as r on l.child = r.id and l.file = r.file;
let count_attributes = select l.attribute as attribute, l.file as file from attribute_names as l where l.name = "count";
let outer_calls = select l.call as call, l.function as function, l.span as span, l.file as file from call_functions as l join count_attributes as r on l.function = r.attribute and l.file = r.file;
let calls_with_inner_bin = select l.call as outer_call, l.span as span, l.file as file, r.call as bin_call from outer_calls as l join inner_bin_calls as r on l.function = r.attribute and l.file = r.file;
let argument_wrappers = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id and l.file = r.file where r.kind = "call-arguments";
let positional_edges = select parent, child, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, r.child as argument, l.file as file from argument_wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let argument_counts = group-count(from=positional_args, keys=["call", "file"], count="argument_count", distinct="argument");
let one_argument_calls = select call, file from argument_counts where argument_count = 1;
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let call_keyword_edges = select l.call as call, l.file as file, r.child as keyword from argument_wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let calls_with_keywords = select call, file from call_keyword_edges;
let no_keyword_calls = antijoin(left=one_argument_calls, right=calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let eligible_call_arguments = select l.call as call, l.argument as argument, l.file as file from positional_args as l join no_keyword_calls as r on l.call = r.call and l.file = r.file;
let count_string_literals = select occurrence as id, file from "string-literal" where value = "1";
let outer_count_args = select l.outer_call as call, l.file as file, l.span as span, r.argument as argument from calls_with_inner_bin as l join eligible_call_arguments as r on l.outer_call = r.call and l.file = r.file;
let count_calls = select l.call as call, l.file as file, l.span as span from outer_count_args as l join count_string_literals as r on l.argument = r.id and l.file = r.file;
let bin_argument_candidates = select l.bin_call as call, l.file as file, r.argument as argument from calls_with_inner_bin as l join eligible_call_arguments as r on l.bin_call = r.call and l.file = r.file;
let starred_arguments = select l.call as call, l.file as file, l.argument as argument from bin_argument_candidates as l join "semantic-syntax" as r on l.argument = r.id and l.file = r.file where r.kind = "starred";
let all_bin_argument_calls = select call, file from bin_argument_candidates;
let bin_argument_calls = antijoin(left=all_bin_argument_calls, right=starred_arguments, left-on=["call", "file"], right-on=["call", "file"]);
let outer_calls_with_bin_argument = select l.outer_call as call, l.file as file from calls_with_inner_bin as l join bin_argument_calls as r on l.bin_call = r.call and l.file = r.file;
let candidates = select l.call as id, l.file as file, l.span as span from count_calls as l join outer_calls_with_bin_argument as r on l.call = r.call and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB161(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB161)(?:,|$)");
emit violations subject file key(id);
