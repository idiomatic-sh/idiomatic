import observation_matches from "python/ruff/suppress-matches";
let assignments = select id, file from "semantic-syntax" where kind = "ann-assign";
let annotation_edges = select l.id as assignment, r.child as annotation, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let annotated_subscripts = select l.assignment as assignment, l.annotation as annotation, l.file as file from annotation_edges as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let values = select parent as subscript, child as value, file from "semantic-child" where field = "value";
let slices = select parent as subscript, child as slice, file from "semantic-child" where field = "slice";
let annotation_values = select l.assignment as assignment, l.annotation as annotation, r.value as value, l.file as file from annotated_subscripts as l join values as r on l.annotation = r.subscript and l.file = r.file;
let final_names = select id, file from "qualified-name" where path = "typing.Final" or path = "typing_extensions.Final";
let final_annotations = select l.assignment as assignment, l.annotation as annotation, l.file as file from annotation_values as l join final_names as r on l.value = r.id and l.file = r.file;
let final_slices = select l.assignment as assignment, r.slice as slice, l.file as file from final_annotations as l join slices as r on l.annotation = r.subscript and l.file = r.file;
let literal_subscripts = select l.assignment as assignment, l.slice as subscript, l.file as file from final_slices as l join subscripts as r on l.slice = r.id and l.file = r.file;
let literal_values = select l.assignment as assignment, l.subscript as subscript, r.value as value, l.file as file from literal_subscripts as l join values as r on l.subscript = r.subscript and l.file = r.file;
let literal_names = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let literal_annotations = select l.assignment as assignment, l.subscript as subscript, l.file as file from literal_values as l join literal_names as r on l.value = r.id and l.file = r.file;
let literal_slices = select l.assignment as assignment, r.slice as literal, l.file as file from literal_annotations as l join slices as r on l.subscript = r.subscript and l.file = r.file;
let scalar_literals = select id, file from "literal-properties" where kind = "integer" or kind = "float" or kind = "complex" or kind = "boolean" or kind = "null" or kind = "ellipsis" or kind = "string" or kind = "bytes";
let reportable = select l.assignment as id, l.file as file from literal_slices as l join scalar_literals as r on l.literal = r.id and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:PYI064)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI064"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
