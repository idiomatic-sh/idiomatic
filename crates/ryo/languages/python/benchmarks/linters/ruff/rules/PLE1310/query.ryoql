import suppress from "python/ruff/suppress";
import repeated_characters from "python/ruff/repeated-characters";
import repeated_octets from "python/ruff/repeated-octets";
import binding_type from "python/ruff/binding-type";
let calls = select id, file from "semantic-syntax" where kind = "call";
let func_edges = select l.id as call, r.child as attribute, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attr_nodes = select l.call as call, l.attribute as attribute, l.file as file from func_edges as l join attributes as r on l.attribute = r.id and l.file = r.file;
let attr_edges = select l.call as call, r.child as label, l.file as file from attr_nodes as l join "semantic-child" as r on l.attribute = r.parent and l.file = r.file where r.field = "attr";
let strip_names = select l.call as call, l.file as file from attr_edges as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "strip" or r.name = "lstrip" or r.name = "rstrip";
let receivers0 = select l.call as call, r.child as receiver, l.file as file from attr_nodes as l join "semantic-child" as r on l.attribute = r.parent and l.file = r.file where r.field = "value";
let receivers = select l.call as call, r.receiver as receiver, l.file as file from strip_names as l join receivers0 as r on l.call = r.call and l.file = r.file;
let reference_nodes = select id, file from "semantic-syntax" where kind = "name";
let receiver_references = select r.id as reference, r.file as file from receivers as l join reference_nodes as r on l.receiver = r.id and l.file = r.file;
let string_references = binding_type(references=receiver_references, builtin="builtins.str", typing="typing.Text", atom="string");
let byte_references = binding_type(references=receiver_references, builtin="builtins.bytes", typing="__no_typing_bytes_alias__", atom="bytes");
let string_constants = select id, file from "literal-properties" where kind = "string";
let literal_strings = select l.occurrence as reference, l.file as file from "string-literal" as l join string_constants as r on l.occurrence = r.id and l.file = r.file;
let literal_bytes = select occurrence as reference, file from "bytes-literal";
let string_values = union(left=literal_strings, right=string_references);
let byte_values = union(left=literal_bytes, right=byte_references);
let string_calls = select l.call as call, l.file as file from receivers as l join string_values as r on l.receiver = r.reference and l.file = r.file;
let byte_calls = select l.call as call, l.file as file from receivers as l join byte_values as r on l.receiver = r.reference and l.file = r.file;
let strips = union(left=string_calls, right=byte_calls);
let containers = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_children = select l.call as call, r.child as child, l.file as file from strips as l join "semantic-child" as r on l.call = r.parent and l.file = r.file;
let wrappers = select l.call as call, l.child as wrapper, l.file as file from call_children as l join containers as r on l.child = r.id and l.file = r.file;
let arguments = select l.call as call, r.child as argument, l.file as file from wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let counts = group-count(from=arguments, keys=["call", "file"], count="count", distinct="argument");
let one_argument = select l.call as call, l.argument as argument, l.file as file from arguments as l join counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let keywords = select l.call as call, l.file as file from wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "keywords";
let positional_only = antijoin(left=one_argument, right=keywords, left-on=["call","file"], right-on=["call","file"]);
let string_arguments = select l.argument as id, r.value as value, l.file as file from positional_only as l join "string-literal" as r on l.argument = r.occurrence and l.file = r.file;
let byte_arguments = select l.argument as id, r."hex-value" as value, l.file as file from positional_only as l join "bytes-literal" as r on l.argument = r.occurrence and l.file = r.file;
let constant_string_arguments = select l.id as id, l.value as value, l.file as file from string_arguments as l join string_constants as r on l.id = r.id and l.file = r.file;
let repeated_strings = repeated_characters(strings=constant_string_arguments);
let repeated_bytes = repeated_octets(strings=byte_arguments);
let typed_string_arguments = select l.call as call, l.argument as argument, l.file as file from positional_only as l join string_calls as r on l.call = r.call and l.file = r.file;
let typed_byte_arguments = select l.call as call, l.argument as argument, l.file as file from positional_only as l join byte_calls as r on l.call = r.call and l.file = r.file;
let string_reports = select l.argument as id, l.file as file from typed_string_arguments as l join repeated_strings as r on l.argument = r.id and l.file = r.file;
let byte_reports = select l.argument as id, l.file as file from typed_byte_arguments as l join repeated_bytes as r on l.argument = r.id and l.file = r.file;
let reportable = union(left=string_reports, right=byte_reports);
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PLE1310($|[, #])", range-pattern="(?:^|,)PLE1310(?:,|$)");
emit violations subject file key(id);
