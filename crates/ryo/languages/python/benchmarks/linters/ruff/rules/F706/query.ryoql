import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let statements = select * from "semantic-syntax" where kind = "return";
let scopes = select id, kind from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let bodies = select parent, child from "semantic-child" where field = "body";
let regions = select r.child as id, l.kind as kind from scopes as l join bodies as r on l.id = r.parent;
let boundaries = select id from regions;
let functions = select id from regions where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let ancestors = axis(from=statements, relation="semantic-child", direction=nearest-ancestor, domain=boundaries);
let nested = select l.id as id from ancestors as l join functions as r on l.related = r.id;
let direct = select l.id as id from statements as l join functions as r on l.id = r.id;
let nested_only = antijoin(left=nested, right=regions, left-on=["id"], right-on=["id"]);
let valid = union(left=nested_only, right=direct);
let invalid = antijoin(left=statements, right=valid, left-on=["id"], right-on=["id"]);
let reportable = select id, file, span from invalid;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F706(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F706)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:F706)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F706)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "F706"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
