import observation_matches from "python/ruff/suppress-matches";
let containers = select id, file, span from "semantic-syntax" where kind = "tuple" or kind = "list";
let starred = select id, file from "semantic-syntax" where kind = "starred";
let elements = select parent, child, ordinal, file from "semantic-child" where field = "elts";
let star_elements0 = select l.parent as parent, l.child as star, l.ordinal as ordinal, l.file as file from elements as l join starred as r on l.child = r.id and l.file = r.file;
let star_counts = group-count(from=star_elements0, keys=["parent", "file"], count="count", distinct="star");
let star_elements = select l.parent as parent, l.star as star, l.ordinal as ordinal, l.file as file from star_elements0 as l join star_counts as r on l.parent = r.parent and l.file = r.file where r.count = 1;
let preceding = select l.parent as parent, l.star as star, l.file as file, r.child as member from star_elements as l join elements as r on l.parent = r.parent and l.file = r.file where r.ordinal < l.ordinal;
let following = select l.parent as parent, l.star as star, l.file as file, r.child as member from star_elements as l join elements as r on l.parent = r.parent and l.file = r.file where r.ordinal > l.ordinal;
let before_counts = group-count(from=preceding, keys=["parent", "star", "file"], count="count", distinct="member");
let after_counts = group-count(from=following, keys=["parent", "star", "file"], count="count", distinct="member");
let before_overflow = select parent, file from before_counts where count >= 256;
let after_overflow = select parent, file from after_counts where count >= 16777216;
let overflows = union(left=before_overflow, right=after_overflow);
let stores = select id from "semantic-syntax" where kind = "assign" or kind = "for" or kind = "async-for" or kind = "comprehension" or kind = "withitem";
let target_fields = select parent, child from "semantic-child" where field = "targets" or field = "target" or field = "optional-vars";
let roots = select r.child as id from stores as l join target_fields as r on l.id = r.parent;
let container_edges = select r.parent as parent, r.child as child from containers as l join elements as r on l.id = r.parent;
let values = select parent, child from "semantic-child" where field = "value";
let star_edges = select r.parent as parent, r.child as child from starred as l join values as r on l.id = r.parent;
let edges = union(left=container_edges, right=star_edges);
let descendants = closure(edges=edges, source="parent", destination="child");
let nested = select r.child as id from roots as l join descendants as r on l.id = r.parent;
let stored = union(left=roots, right=nested);
let stored_overflow = select l.id as id, r.file as file from stored as l join overflows as r on l.id = r.parent;
let reportable = select l.id as id, l.file as file, l.span as span from containers as l join stored_overflow as r on l.id = r.id and l.file = r.file;
let located = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=located, codes="^(?:F621)$");
let violations_rows = select id, file, span from located;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F621"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
