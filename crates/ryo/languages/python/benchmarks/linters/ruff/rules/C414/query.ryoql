import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let qualified_functions = select id, file, path, provenance from "qualified-name" where path = "builtins.list" or path = "builtins.tuple" or path = "builtins.set" or path = "builtins.reversed" or path = "builtins.sorted";
let builtin_reads = select reference, name, file from "binding-read" where state = "builtin" and context = "value";
let builtin_function_refs = select l.id as function, l.file as file, l.path as path from qualified_functions as l join builtin_reads as r on l.id = r.reference and l.file = r.file where l.provenance = "builtin";
let builtin_list_rows = select function, file from builtin_function_refs where path = "builtins.list";
let builtin_list = extend(from=builtin_list_rows, values={name: "list"});
let builtin_tuple_rows = select function, file from builtin_function_refs where path = "builtins.tuple";
let builtin_tuple = extend(from=builtin_tuple_rows, values={name: "tuple"});
let builtin_set_rows = select function, file from builtin_function_refs where path = "builtins.set";
let builtin_set = extend(from=builtin_set_rows, values={name: "set"});
let builtin_reversed_rows = select function, file from builtin_function_refs where path = "builtins.reversed";
let builtin_reversed = extend(from=builtin_reversed_rows, values={name: "reversed"});
let builtin_sorted_rows = select function, file from builtin_function_refs where path = "builtins.sorted";
let builtin_sorted = extend(from=builtin_sorted_rows, values={name: "sorted"});
let builtin_functions_a = union(left=builtin_list, right=builtin_tuple);
let builtin_functions_b = union(left=builtin_set, right=builtin_reversed);
let builtin_functions_c = union(left=builtin_functions_a, right=builtin_functions_b);
let builtin_functions = union(left=builtin_functions_c, right=builtin_sorted);
let imported_bindings = select occurrence as binding, target, file from "static-import" where target = "builtins.list" or target = "builtins.tuple" or target = "builtins.set" or target = "builtins.reversed" or target = "builtins.sorted";
let import_list_rows = select binding, file from imported_bindings where target = "builtins.list";
let import_list = extend(from=import_list_rows, values={name: "list"});
let import_tuple_rows = select binding, file from imported_bindings where target = "builtins.tuple";
let import_tuple = extend(from=import_tuple_rows, values={name: "tuple"});
let import_set_rows = select binding, file from imported_bindings where target = "builtins.set";
let import_set = extend(from=import_set_rows, values={name: "set"});
let import_reversed_rows = select binding, file from imported_bindings where target = "builtins.reversed";
let import_reversed = extend(from=import_reversed_rows, values={name: "reversed"});
let import_sorted_rows = select binding, file from imported_bindings where target = "builtins.sorted";
let import_sorted = extend(from=import_sorted_rows, values={name: "sorted"});
let import_names_a = union(left=import_list, right=import_tuple);
let import_names_b = union(left=import_set, right=import_reversed);
let import_names_c = union(left=import_names_a, right=import_names_b);
let import_names = union(left=import_names_c, right=import_sorted);
let imported_function_refs = select l.reference as function, l.file as file, r.name as name from "binding-use" as l join import_names as r on l.binding = r.binding and l.file = r.file;
let imported_function_names = select l.function as function, l.file as file, l.name as name from imported_function_refs as l join qualified_functions as r on l.function = r.id and l.file = r.file where r.provenance = "import";
let imported_builtins_modules = select occurrence as binding, file from "static-import" where target = "builtins";
let imported_builtins_module_uses = select l.reference as base, l.file as file from "binding-use" as l join imported_builtins_modules as r on l.binding = r.binding and l.file = r.file;
let function_attribute_values = select l.id as function, l.file as file, r.child as base, l.path as path from qualified_functions as l join "semantic-child" as r on l.id = r.parent where l.provenance = "import" and r.field = "value";
let imported_module_function_paths = select l.function as function, l.file as file, l.path as path from function_attribute_values as l join imported_builtins_module_uses as r on l.base = r.base and l.file = r.file;
let imported_module_list_rows = select function, file from imported_module_function_paths where path = "builtins.list";
let imported_module_list = extend(from=imported_module_list_rows, values={name: "list"});
let imported_module_tuple_rows = select function, file from imported_module_function_paths where path = "builtins.tuple";
let imported_module_tuple = extend(from=imported_module_tuple_rows, values={name: "tuple"});
let imported_module_set_rows = select function, file from imported_module_function_paths where path = "builtins.set";
let imported_module_set = extend(from=imported_module_set_rows, values={name: "set"});
let imported_module_reversed_rows = select function, file from imported_module_function_paths where path = "builtins.reversed";
let imported_module_reversed = extend(from=imported_module_reversed_rows, values={name: "reversed"});
let imported_module_sorted_rows = select function, file from imported_module_function_paths where path = "builtins.sorted";
let imported_module_sorted = extend(from=imported_module_sorted_rows, values={name: "sorted"});
let imported_module_names_a = union(left=imported_module_list, right=imported_module_tuple);
let imported_module_names_b = union(left=imported_module_set, right=imported_module_reversed);
let imported_module_names_c = union(left=imported_module_names_a, right=imported_module_names_b);
let imported_module_names = union(left=imported_module_names_c, right=imported_module_sorted);
let imported_names = union(left=imported_function_names, right=imported_module_names);
let function_names = union(left=builtin_functions, right=imported_names);
let recognized_call_functions = select l.call as call, r.name as name, l.file as file from call_functions as l join function_names as r on l.function = r.function and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from argument_owners as l join positional_fields as r on l.wrapper = r.parent;
let positional_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from positional_arguments as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let earlier_arguments = select l.call as call, l.argument as later_argument, r.argument as earlier_argument, l.file as file from positional_locations as l join positional_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let later_first_arguments = select call, later_argument as argument, file from earlier_arguments;
let first_arguments = antijoin(left=positional_arguments, right=later_first_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let outer_first_args = select l.call as outer_call, l.file as file, l.argument as argument, r.name as outer_name from first_arguments as l join recognized_call_functions as r on l.call = r.call and l.file = r.file;
let inner_calls = select l.outer_call as outer_call, l.file as file, l.argument as inner_call, l.outer_name as outer_name from outer_first_args as l join calls as r on l.argument = r.id and l.file = r.file;
let nested_function_names = select l.inner_call as inner_call, l.outer_call as outer_call, l.file as file, l.outer_name as outer_name, r.name as inner_name from inner_calls as l join recognized_call_functions as r on l.inner_call = r.call and l.file = r.file;
let permitted_pairs_a = select outer_call as call, file from nested_function_names where (outer_name = "set" or outer_name = "sorted") and (inner_name = "list" or inner_name = "tuple" or inner_name = "reversed");
let permitted_pairs_b = select outer_call as call, file from nested_function_names where outer_name = "set" and inner_name = "set";
let permitted_pairs_c = select outer_call as call, file from nested_function_names where (outer_name = "list" or outer_name = "tuple") and (inner_name = "list" or inner_name = "tuple");
let sorted_sorted_pairs = select outer_call as call, inner_call as inner_call, file from nested_function_names where outer_name = "sorted" and inner_name = "sorted";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keywords = select l.call as call, r.child as keyword, l.file as file from argument_owners as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_rows = select l.call as call, l.keyword as keyword, l.file as file from call_keywords as l join keyword_nodes as r on l.keyword = r.id;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_arg_edges = select l.parent as keyword, r.child as token from keyword_arg_fields as l join "semantic-child" as r on l.child = r.parent;
let identifier_edges = select l.child as id, r.name as name from "semantic-child" as l join "identifier" as r on l.parent = r.id;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name from keyword_arg_edges as l join identifiers as r on l.token = r.id;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_values = select l.call as call, l.keyword as keyword, l.file as file, r.child as value from keyword_rows as l join keyword_value_fields as r on l.keyword = r.parent;
let keyword_named_values = select l.call as call, l.keyword as keyword, l.file as file, l.value as value, r.name as name from keyword_values as l join keyword_names as r on l.keyword = r.keyword;
let keyword_shapes = select l.call as call, l.keyword as keyword, l.file as file, l.name as name, r.shape as shape from keyword_named_values as l join "expression-shape" as r on l.value = r.id and l.file = r.file;
let sorted_inner_keywords = select l.call as outer_call, l.inner_call as inner_call, l.file as file, r.keyword as keyword from sorted_sorted_pairs as l join keyword_rows as r on l.inner_call = r.call and l.file = r.file;
let sorted_outer_keywords = select l.call as outer_call, l.inner_call as inner_call, l.file as file, r.keyword as keyword from sorted_sorted_pairs as l join keyword_rows as r on l.call = r.call and l.file = r.file;
let sorted_inner_keyword_shapes = select l.outer_call as outer_call, l.inner_call as inner_call, l.file as file, l.keyword as keyword, r.name as name, r.shape as shape from sorted_inner_keywords as l join keyword_shapes as r on l.keyword = r.keyword and l.file = r.file;
let sorted_outer_keyword_shapes = select l.outer_call as outer_call, l.inner_call as inner_call, l.file as file, l.keyword as keyword, r.name as name, r.shape as shape from sorted_outer_keywords as l join keyword_shapes as r on l.keyword = r.keyword and l.file = r.file;
let matching_sorted_keywords = select l.outer_call as outer_call, l.inner_call as inner_call, l.file as file, l.keyword as keyword from sorted_inner_keyword_shapes as l join sorted_outer_keyword_shapes as r on l.outer_call = r.outer_call and l.inner_call = r.inner_call and l.file = r.file and l.name = r.name and l.shape = r.shape;
let inner_keyword_counts = group-count(from=sorted_inner_keywords, keys=["outer_call", "inner_call", "file"], count="inner_count", distinct="keyword");
let outer_keyword_counts = group-count(from=sorted_outer_keywords, keys=["outer_call", "inner_call", "file"], count="outer_count", distinct="keyword");
let matching_keyword_counts = group-count(from=matching_sorted_keywords, keys=["outer_call", "inner_call", "file"], count="matching_count", distinct="keyword");
let equal_keyword_counts = select l.outer_call as outer_call, l.inner_call as inner_call, l.file as file, l.inner_count as count from inner_keyword_counts as l join outer_keyword_counts as r on l.outer_call = r.outer_call and l.inner_call = r.inner_call and l.file = r.file where l.inner_count = r.outer_count;
let equal_keyword_pairs = select l.outer_call as outer_call, l.inner_call as inner_call, l.file as file from equal_keyword_counts as l join matching_keyword_counts as r on l.outer_call = r.outer_call and l.inner_call = r.inner_call and l.file = r.file where l.count = r.matching_count;
let calls_with_keywords = select call, file from keyword_rows;
let no_keyword_calls = antijoin(left=recognized_call_functions, right=calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let sorted_no_keyword_inner = select r.call as outer_call, r.inner_call as inner_call, r.file as file from no_keyword_calls as l join sorted_sorted_pairs as r on l.call = r.inner_call and l.file = r.file;
let sorted_no_keyword_outer = select r.call as outer_call, r.inner_call as inner_call, r.file as file from no_keyword_calls as l join sorted_sorted_pairs as r on l.call = r.call and l.file = r.file;
let sorted_no_keyword_pairs = select l.outer_call as call, l.file as file from sorted_no_keyword_outer as l join sorted_no_keyword_inner as r on l.outer_call = r.outer_call and l.inner_call = r.inner_call and l.file = r.file;
let allowed_sorted_pairs_a = select l.call as call, l.file as file from sorted_sorted_pairs as l join sorted_no_keyword_pairs as r on l.call = r.call and l.file = r.file;
let allowed_sorted_pairs_b = select outer_call as call, file from equal_keyword_pairs;
let allowed_sorted_pairs = union(left=allowed_sorted_pairs_a, right=allowed_sorted_pairs_b);
let allowed_a = union(left=permitted_pairs_a, right=permitted_pairs_b);
let allowed_b = union(left=allowed_a, right=permitted_pairs_c);
let allowed_pairs = union(left=allowed_b, right=allowed_sorted_pairs);
let candidates = select l.call as id, l.file as file, r.span as span from allowed_pairs as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])C414(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:C414)(?:,|$)");
emit violations subject file key(id);
