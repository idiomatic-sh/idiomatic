import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/suppression-edges";
import namespace_events from "python/ruff/checker-namespace-events";
import nonlocal_bindings from "python/ruff/nonlocal-bindings";
import deferred_events from "python/ruff/deferred-read-events";
let nodes = select id, kind, file, span from "semantic-syntax";
let statements = select id from nodes where glob_any(kind, "{function-def,async-function-def,class-def,return,delete,assign,type-alias,aug-assign,ann-assign,for,async-for,while,if,with,async-with,match,raise,try,assert,import,import-from,global,nonlocal,expr,pass,break,continue}");
let lexical_scopes = select id from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let functions = select id from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let named_definitions = select l.id as binding, r.id as id, l.name as name, l.file as file, l.span as span from "defines" as l join "identifier" as r on l.file = r.file and l.span = r.span and l.name = r.name;
let namespace = namespace_events();
let resolved_nonlocals = nonlocal_bindings(events=namespace);
let raw_binding_events = select occurrence, phase, ordinal from "binding-event" where kind = "bind";
let bindings = select l.occurrence as binding, l.name as name, l.scope as scope, r.phase as phase, l.ordinal as ordinal from namespace as l join raw_binding_events as r on l.occurrence = r.occurrence where l.kind = "bind";
let named_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.ordinal as ordinal, r.id as id, r.name as name, r.file as file, r.span as span from bindings as l join named_definitions as r on l.binding = r.binding;
let endings = select occurrence as binding, name, scope, phase, ordinal from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let replaced = select l.binding as binding from named_bindings as l join endings as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name where l.ordinal < r.ordinal;
let final_bindings = antijoin(left=named_bindings,right=replaced,left-on=["binding"],right-on=["binding"]);
let redirections = select occurrence as id, name from "binding-event" where kind = "global";
let redirect_scopes = axis(from=redirections,relation="semantic-child",direction=nearest-ancestor,domain=lexical_scopes);
let global_redirected = select related as scope, name from redirect_scopes;
let valid_nonlocal_redirected = select scope, name from resolved_nonlocals;
let redirected = union(left=global_redirected, right=valid_nonlocal_redirected);
let unredirected = antijoin(left=final_bindings,right=redirected,left-on=["scope","name"],right-on=["scope","name"]);
let local_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from unredirected as l join functions as r on l.scope = r.id;
let declaration_nodes = select binding as id from local_bindings;
let enclosing_statements = axis(from=declaration_nodes,relation="semantic-child",direction=nearest-ancestor,domain=statements);
let ancestor_source_statements = select l.id as binding, r.id as statement, r.kind as kind from enclosing_statements as l join nodes as r on l.related = r.id;
let declaration_statement_roots = select l.id as binding, r.id as statement from declaration_nodes as l join statements as r on l.id = r.id;
let direct_source_statements = select l.binding as binding, l.statement as statement, r.kind as kind from declaration_statement_roots as l join nodes as r on l.statement = r.id;
let nonroot_source_statements = antijoin(left=ancestor_source_statements, right=direct_source_statements, left-on=["binding"], right-on=["binding"]);
let source_statements = union(left=direct_source_statements, right=nonroot_source_statements);
let plain_assignments = select binding from source_statements where kind = "assign" or kind = "aug-assign" or kind = "ann-assign" or kind = "with" or kind = "async-with";
let named_expressions = select id from nodes where kind = "named-expr";
let targets = select parent, child from "semantic-child" where field = "target";
let named_targets = select r.child as binding from named_expressions as l join targets as r on l.id = r.parent;
let patterns = select id as binding from nodes where kind = "match-as" or kind = "match-star" or kind = "match-mapping";
let assignment_or_named = union(left=plain_assignments,right=named_targets);
let eligible_assignments = union(left=assignment_or_named,right=patterns);
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_bindings = select l.binding as binding from local_bindings as l join parameter_nodes as r on l.binding = r.id and l.file = r.file;
let eligible_nonparameter_assignments = antijoin(left=eligible_assignments, right=parameter_bindings, left-on=["binding"], right-on=["binding"]);
let eligible_locals = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from local_bindings as l join eligible_nonparameter_assignments as r on l.binding = r.binding;
let handlers = select id from nodes where kind = "except-handler";
let exception_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from named_bindings as l join handlers as r on l.binding = r.id;
let shadow_replacements = select previous as earlier, binding as later from "binding-shadow" where relationship = "replacement";
let timed_replacements = select l.earlier as earlier, l.later as later, r.phase as phase, r.ordinal as ordinal from shadow_replacements as l join bindings as r on l.later = r.binding;
let local_replacements = select l.earlier as earlier, l.later as later, l.ordinal as ordinal from timed_replacements as l join bindings as r on l.earlier = r.binding and l.phase = r.phase where r.ordinal < l.ordinal;
let replacement_edges = select earlier, later from local_replacements;
let inherited = closure(edges=replacement_edges,source="earlier",destination="later");
let read_events = select occurrence as reference, ordinal from "binding-event" where kind = "read" or kind = "delete";
let read_nodes = select occurrence as id, file from "binding-event" where kind = "read" or kind = "delete";
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_reads_axis = axis(from=embedded_roots, relation="semantic-child", direction=descendant, domain=read_nodes);
let embedded_descendant_reads = select l.related as reference, l.file as file from embedded_reads_axis as l;
let embedded_root_reads = select l.id as reference, l.file as file from embedded_roots as l join read_nodes as r on l.id = r.id and l.file = r.file;
let embedded_reads = union(left=embedded_descendant_reads, right=embedded_root_reads);
let all_read_contexts = select reference as id, name, scope, phase, file from "binding-read";
let deferred_resolutions = deferred_events(missing=all_read_contexts);
let ordinary_binding_uses0 = antijoin(left="binding-use", right=deferred_resolutions, left-on=["reference", "file"], right-on=["reference", "file"]);
let nonlocal_reference_ids = select occurrence as reference, file from "binding-event" where kind = "nonlocal";
let ordinary_binding_uses = antijoin(left=ordinary_binding_uses0, right=nonlocal_reference_ids, left-on=["reference", "file"], right-on=["reference", "file"]);
let ordinary_use_rows = select binding, reference, file from ordinary_binding_uses;
let replayed_use_rows = select occurrence as binding, reference, file from deferred_resolutions where kind = "bind";
let effective_binding_uses = union(left=ordinary_use_rows, right=replayed_use_rows);
let embedded_reference_uses = select l.binding as binding, l.reference as reference from effective_binding_uses as l join embedded_reads as r on l.reference = r.reference and l.file = r.file;
let all_binding_uses = select binding, reference from effective_binding_uses;
let nonembedded_binding_uses = antijoin(left=all_binding_uses, right=embedded_reference_uses, left-on=["binding", "reference"], right-on=["binding", "reference"]);
let direct_uses = select binding from nonembedded_binding_uses;
let ordinary_dated_uses = select l.binding as binding, r.ordinal as ordinal from ordinary_binding_uses as l join read_events as r on l.reference = r.reference;
let deferred_dated_uses = select occurrence as binding, point as ordinal from deferred_resolutions where kind = "bind";
let dated_uses = union(left=ordinary_dated_uses, right=deferred_dated_uses);
let copied_uses = select r.later as binding from dated_uses as l join local_replacements as r on l.binding = r.earlier where l.ordinal < r.ordinal;
let inherited_uses = select r.later as binding from copied_uses as l join inherited as r on l.binding = r.earlier;
let copied_and_inherited = union(left=copied_uses,right=inherited_uses);
let used_before_nonlocal = union(left=direct_uses,right=copied_and_inherited);
let nonlocal_uses = select binding from resolved_nonlocals;
let used = union(left=used_before_nonlocal,right=nonlocal_uses);
let unused_locals = antijoin(left=eligible_locals,right=used,left-on=["binding"],right-on=["binding"]);
let unused_exceptions = antijoin(left=exception_bindings,right=used,left-on=["binding"],right-on=["binding"]);
let calls = select id from nodes where kind = "call";
let callable_fields = select parent, child from "semantic-child" where field = "func";
let callees = select r.child as id from calls as l join callable_fields as r on l.id = r.parent;
let locals_names = select id from "identifier" where name = "locals";
let locals_calls = select l.id as id from callees as l join locals_names as r on l.id = r.id;
let locals_scopes = select r.scope as scope from locals_calls as l join "binding-read" as r on l.id = r.reference;
let real_functions = select id from nodes where kind = "function-def" or kind = "async-function-def";
let inspecting_scopes = select l.scope as scope from locals_scopes as l join real_functions as r on l.scope = r.id;
let uninspected = antijoin(left=unused_locals,right=inspecting_scopes,left-on=["scope"],right-on=["scope"]);
let regular_names = select * from uninspected where name != "__tracebackhide__" and name != "__traceback_info__" and name != "__traceback_supplement__" and name != "__debuggerskip__";
let all_candidates = union(left=regular_names,right=unused_exceptions);
let dummy_candidates = select binding from all_candidates where matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let named_candidates = antijoin(left=all_candidates,right=dummy_candidates,left-on=["binding"],right-on=["binding"]);
let containers = select id from nodes where kind = "tuple" or kind = "list" or kind = "set";
let assign_nodes = select id from nodes where kind = "assign";
let assign_targets = select parent, child from "semantic-child" where field = "targets";
let assigned_targets = select l.id as statement, r.child as target from assign_nodes as l join assign_targets as r on l.id = r.parent;
let container_targets = select l.statement as statement, l.target as target from assigned_targets as l join containers as r on l.target = r.id;
let scalar_targets = antijoin(left=assigned_targets,right=container_targets,left-on=["statement","target"],right-on=["statement","target"]);
let mixed_statements = select statement from scalar_targets;
let value_fields = select parent, child from "semantic-child" where field = "value";
let container_values = select l.parent as statement from value_fields as l join containers as r on l.child = r.id;
let dynamic_assigns = antijoin(left=container_targets,right=container_values,left-on=["statement"],right-on=["statement"]);
let mixed_assigns = select l.statement as statement, l.target as target from container_targets as l join mixed_statements as r on l.statement = r.statement;
let unpacking = union(left=dynamic_assigns,right=mixed_assigns);
let unpack_roots = select target as id from unpacking;
let candidate_ids = select binding as id from named_candidates;
let unpacked = axis(from=unpack_roots,relation="semantic-child",direction=descendant,domain=candidate_ids);
let unpacked_bindings = select related as binding from unpacked;
let tuple_nodes = select id from nodes where kind = "tuple";
let optional_vars = select child from "semantic-child" where field = "optional_vars";
let with_tuples = select l.child as id from optional_vars as l join tuple_nodes as r on l.child = r.id;
let with_unpacked = axis(from=with_tuples,relation="semantic-child",direction=descendant,domain=candidate_ids);
let with_bindings = select related as binding from with_unpacked;
let excluded_unpacking = union(left=unpacked_bindings,right=with_bindings);
let report_candidates = antijoin(left=named_candidates,right=excluded_unpacking,left-on=["binding"],right-on=["binding"]);
let reportable = select id, file, span from report_candidates;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let suppression_mappings = noqa_line_map();
let suppression_locations = noqa_locations(candidates=candidate_locations, mappings=suppression_mappings);
let suppression_parents = select id, file, line from candidate_locations where id != id;
let suppression_matches = suppression_edges(candidates=candidate_locations, locations=suppression_locations, additional_locations=suppression_parents, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:F841)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F841)(?:,|$)");
let suppression_candidates = select id, file, span from suppression_locations;
let violations = antijoin(left=suppression_candidates, right=suppression_matches, left-on=[id, span], right-on=[id, span]);
let matched_directives = select directive, file from suppression_matches where scope = 0 or scope = 1;
let noqa_matches = extend(from=matched_directives, values={code: "F841"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
