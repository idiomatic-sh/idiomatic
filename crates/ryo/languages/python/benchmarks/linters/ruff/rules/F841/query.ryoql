import deferred_context from "python/ruff/deferred-type-reads";
import indexed_matches from "python/ruff/suppress-matches";
import header_bindings from "python/ruff/type-root-binds";
import early_reads from "python/ruff/direct-binding-reads";
import counted_reads from "python/ruff/counted-binding-reads";
import latest_before from "python/ruff/latest-before";
import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
import namespace_events from "python/ruff/checker-namespace-events";
import nonlocal_bindings from "python/ruff/nonlocal-bindings";
import deferred_binds from "python/ruff/deferred-binding-targets";
import skipped_reads from "python/ruff/type-definition-skipped";
import line_located from "python/ruff/candidate-locations";
import unpacking_targets from "python/ruff/unpacking-targets";
import class_cell_nonlocals from "python/ruff/class-cell-nonlocals";
let nodes = select id, kind, file, span from "semantic-syntax";
let lexical_scopes = select id from nodes where kind in ["module", "function-def", "async-function-def", "class-def", "lambda"];
let functions = select id from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let namespace = namespace_events();
let nonlocal_statements = select file from "binding-event" where kind = "nonlocal";
let nonlocal_files = select file from nonlocal_statements;
let gated_namespace = select r.occurrence as occurrence, r.name as name, r.scope as scope, r.ordinal as ordinal, r.kind as kind, r.file as file from nonlocal_files as l join namespace as r on l.file = r.file;
let resolved_nonlocals = nonlocal_bindings(events=gated_namespace);
let redirected_names = select name, file from "binding-event" where kind = "global" or kind = "nonlocal";
let declared_redirects = group-count(from=redirected_names, keys=[name,file], count="declarations");
let scoped_binds = select occurrence as binding,name,scope,phase,ordinal,file from "binding-event" where kind = "bind";
let ordinary_binds = antijoin(left=scoped_binds,right=declared_redirects,left-on=[name,file],right-on=[name,file]);
let type_binds = header_bindings();
let value_binds = antijoin(left=ordinary_binds,right=type_binds,left-on=[binding,file],right-on=[id,file]);
let possibly_redirected_binds = select r.binding as binding,r.phase as phase,r.file as file from declared_redirects as l join scoped_binds as r on l.name = r.name and l.file = r.file;
let adjusted_binds = select l.binding as binding,r.name as name,r.scope as scope,l.phase as phase,r.ordinal as ordinal,l.file as file from possibly_redirected_binds as l join namespace as r on l.binding = r.occurrence and l.file = r.file where r.kind = "bind";
let bindings = union(left=value_binds,right=adjusted_binds);
let all_read_contexts = select reference as id, name, scope, phase, file from "binding-read";
let read_ids_for_types = select id, file from all_read_contexts;
let ignored_in_calls = skipped_reads(expressions=read_ids_for_types);
let ignored_reference_ids = select id as reference, file from ignored_in_calls;
let delay_inputs = select reference as id,file from "binding-read";
let delayed_reads = deferred_context(expressions=delay_inputs);
let delayed_reference_ids = select id as reference,file from delayed_reads where visit="deferred";
let postponed_or_skipped = union(left=delayed_reference_ids, right=ignored_reference_ids);
let early_reads0 = early_reads(deferred=postponed_or_skipped);
let early_used = select binding,file from early_reads0;
let unread_bindings = antijoin(left=bindings, right=early_used, left-on=[binding,file], right-on=[binding,file]);
let named_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.ordinal as ordinal, r.name as name, r.file as file, r.span as span from unread_bindings as l join "defines" as r on l.binding = r.id and l.file = r.file;
let site_steps = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let site_binds = select occurrence as binding, name, scope, phase, ordinal, file from site_steps where kind = "bind";
let site_last = group-max(from=site_steps, keys=["scope","name","phase","file"], order="ordinal");
let site_last_binds = select occurrence as binding, file from site_last where kind = "bind";
let site_counts = group-count(from=site_binds, keys=["scope","name","phase","file"], count="stores");
let site_repeated_groups = select scope, name, phase, file from site_counts where stores > 1;
let repeated_steps = select l.occurrence as occurrence, l.name as name, l.scope as scope, l.phase as phase, l.kind as kind, l.ordinal as ordinal, l.file as file from site_steps as l join site_repeated_groups as r on l.scope = r.scope and l.name = r.name and l.phase = r.phase and l.file = r.file;
let repeated_binds = select occurrence as binding, name, scope, phase, ordinal, file from repeated_steps where kind = "bind";
let site_following = as-of(left=repeated_steps, right=repeated_steps, left-on=[scope,name,phase,file], right-on=[scope,name,phase,file], left-order="ordinal", right-order="ordinal", bound=after, output={binding:[left,occurrence], kind:[left,kind], next:[right,occurrence], next_kind:[right,kind], file:[left,file]});
let site_followed = select binding, next, file from site_following where kind = "bind" and next_kind = "bind";
let site_ends = antijoin(left=repeated_binds, right=site_followed, left-on=[binding,file], right-on=[binding,file]);
let site_series = as-of(left=repeated_binds, right=site_ends, left-on=[scope,name,phase,file], right-on=[scope,name,phase,file], left-order="ordinal", right-order="ordinal", bound=at-or-after, output={binding:[left,binding], endpoint:[right,binding], scope:[left,scope], name:[left,name], phase:[left,phase], ordinal:[left,ordinal], file:[left,file]});
let final_bindings = select r.binding as binding,r.scope as scope,r.phase as phase,r.ordinal as ordinal,r.name as name,r.file as file,r.span as span from site_last_binds as l join named_bindings as r on l.binding=r.binding and l.file=r.file;
let global_redirected = select lexical as scope, name from "binding-event" where kind = "global";
let valid_nonlocal_redirected = select scope, name from resolved_nonlocals;
let cell_nonlocals = class_cell_nonlocals();
let cell_scopes = axis(from=cell_nonlocals,relation="semantic-child",direction=nearest-ancestor,domain=lexical_scopes);
let cell_redirected = select related as scope, name from cell_scopes;
let nonlocal_redirected = union(left=valid_nonlocal_redirected, right=cell_redirected);
let redirected_rows = union(left=global_redirected, right=nonlocal_redirected);
let redirected_counts = group-count(from=redirected_rows, keys=["scope","name"], count="count");
let redirected = select scope, name from redirected_counts;
let uncancelled_unredirected = antijoin(left=final_bindings,right=redirected,left-on=["scope","name"],right-on=["scope","name"]);
let raw_phases = select occurrence, phase from "binding-event";
let scope_deletes = select l.occurrence as id, l.name as name, l.scope as scope, r.phase as phase, l.ordinal as ordinal, l.file as file from namespace as l join raw_phases as r on l.occurrence = r.occurrence where l.kind = "delete";
let first_deletes = group-min(from=scope_deletes,keys=[scope,phase,name,file],order="ordinal");
let redirected_final_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.name as name, l.file as file, l.span as span from final_bindings as l join redirected as r on l.scope = r.scope and l.name = r.name;
let deleted_before_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.ordinal as ordinal, l.name as name, l.file as file, l.span as span from redirected_final_bindings as l join first_deletes as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let plain_local_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.span as span from uncancelled_unredirected as l join functions as r on l.scope = r.id;
let cancelled_local_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.span as span from deleted_before_bindings as l join functions as r on l.phase = r.id;
let local_bindings = union(left=plain_local_bindings, right=cancelled_local_bindings);
let assignment_statements = select id, file from nodes where kind in ["assign", "aug-assign", "ann-assign", "with", "async-with"];
let site_statements = select id, file from "semantic-syntax" where kind in ["function-def", "async-function-def", "class-def", "return", "delete", "type-alias", "assign", "aug-assign", "ann-assign", "for", "async-for", "while", "if", "with", "async-with", "match", "raise", "try", "try-star", "assert", "import", "import-from", "global", "nonlocal", "expr", "pass", "break", "continue"];
let site_bind_nodes = select binding as id, file from local_bindings;
let site_self_statements = select l.id as id, l.id as related, l.file as file from site_bind_nodes as l join site_statements as r on l.id = r.id and l.file = r.file;
let site_inner_nodes = antijoin(left=site_bind_nodes, right=site_self_statements, left-on=[id,file], right-on=[id,file]);
let site_enclosing = axis(from=site_inner_nodes, relation="semantic-child", direction=nearest-ancestor, domain=site_statements);
let site_enclosing_rows = select id, related, file from site_enclosing;
let site_statement_roots = union(left=site_self_statements, right=site_enclosing_rows);
let plain_assignments = select l.id as binding from site_statement_roots as l join assignment_statements as r on l.related = r.id and l.file = r.file;
let named_expressions = select id from nodes where kind = "named-expr";
let targets = select parent, child from "semantic-child" where field = "target";
let named_targets = select r.child as binding from named_expressions as l join targets as r on l.id = r.parent;
let patterns = select id as binding from nodes where kind = "match-as" or kind = "match-star" or kind = "match-mapping";
let assignment_or_named = union(left=plain_assignments,right=named_targets);
let eligible_assignments = union(left=assignment_or_named,right=patterns);
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_bindings = select l.binding as binding from local_bindings as l join parameter_nodes as r on l.binding = r.id and l.file = r.file;
let eligible_nonparameter_assignments = antijoin(left=eligible_assignments, right=parameter_bindings, left-on=["binding"], right-on=["binding"]);
let eligible_locals = select l.binding as binding, l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.span as span from local_bindings as l join eligible_nonparameter_assignments as r on l.binding = r.binding;
let handlers = select id from nodes where kind = "except-handler";
let exception_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.span as span from named_bindings as l join handlers as r on l.binding = r.id;
let read_events = select occurrence as reference, ordinal from "binding-event" where kind = "read" or kind = "delete";
let deferred_resolutions = deferred_binds(reads=all_read_contexts, skipped=ignored_in_calls);
let scope_candidates = select l.binding as binding, l.file as file from bindings as l join functions as r on l.scope = r.id;
let phase_candidates = select l.binding as binding, l.file as file from bindings as l join functions as r on l.phase = r.id;
let local_probes = select binding, file from eligible_locals;
let exception_probes = select binding,file from exception_bindings;
let candidates_for_credit = union(left=local_probes,right=exception_probes);
let function_candidates = union(left=scope_candidates, right=phase_candidates);
let handler_candidates = select occurrence as binding, file from "binding-event" where kind = "cleanup";
let eligible_read_names = union(left=function_candidates,right=handler_candidates);
let repeated_sites = select l.binding as binding,l.endpoint as endpoint,l.file as file from site_series as l;
let remaining_endpoints = select r.endpoint as endpoint,l.file as file from candidates_for_credit as l join repeated_sites as r on l.binding=r.binding and l.file=r.file;
let repeated_bindings = select r.binding as binding,l.file as file from remaining_endpoints as l join repeated_sites as r on l.endpoint=r.endpoint and l.file=r.file;
let redirected_read_names = select l.binding as binding,l.file as file from bindings as l join declared_redirects as r on l.name=r.name and l.file=r.file;
let possible_credit = union(left=repeated_bindings,right=redirected_read_names);
let required_uses = union(left=candidates_for_credit,right=possible_credit);
let candidate_bindings = select l.binding as binding,l.file as file from required_uses as l join eligible_read_names as r on l.binding=r.binding and l.file=r.file;
let ordinary_binding_uses0 = counted_reads(deferred=postponed_or_skipped, bindings=candidate_bindings);
let nonlocal_reference_ids = select occurrence as reference, file from "binding-event" where kind = "nonlocal";
let ordinary_binding_uses = antijoin(left=ordinary_binding_uses0, right=nonlocal_reference_ids, left-on=["reference", "file"], right-on=["reference", "file"]);
let ordinary_use_rows = select binding, reference, file from ordinary_binding_uses;
let replayed_use_rows = select occurrence as binding, reference, file from deferred_resolutions where kind = "bind";
let effective_binding_uses = union(left=ordinary_use_rows, right=replayed_use_rows);
let all_binding_uses = select binding, reference from effective_binding_uses;
let direct_uses = select binding from all_binding_uses;
let ordinary_dated_uses = select l.binding as binding, r.ordinal as ordinal from ordinary_binding_uses as l join read_events as r on l.reference = r.reference;
let deferred_dated_uses = select occurrence as binding, point as ordinal from deferred_resolutions where kind = "bind";
let dated_uses = union(left=ordinary_dated_uses, right=deferred_dated_uses);
let first_use = group-min(from=dated_uses, keys=[binding], order="ordinal");
let ordinary_credit_bindings = antijoin(left=bindings,right=declared_redirects,left-on=[name,file],right-on=[name,file]);
let routed_bindings = select b.binding as binding,b.scope as scope,b.phase as phase,b.name as name,b.file as file,b.ordinal as ordinal from bindings as b join declared_redirects as r on b.name = r.name and b.file = r.file;
let repeated_store_ids = select binding, file from repeated_binds;
let repeated_sources = select l.binding as binding, l.ordinal as ordinal from first_use as l join repeated_store_ids as r on l.binding = r.binding;
let sources = select b.scope as scope, b.phase as phase, b.name as name, b.file as file, b.ordinal as point, l.ordinal as used_at from repeated_sources as l join routed_bindings as b on l.binding = b.binding;
let changes = select occurrence,scope,phase,name,file,kind,ordinal from "binding-event" where kind in ["bind","cleanup","delete"];
let following = as-of(left=sources, right=changes, left-on=[scope,phase,name,file], right-on=[scope,phase,name,file], left-order="point", right-order="ordinal", bound=after, output={binding:[right,occurrence], kind:[right,kind], point:[right,ordinal], used_at:[left,used_at]});
let copied_uses = select binding from following where kind = "bind" and used_at < point;
let copied_marker_rows = select b.scope as scope, b.phase as phase, b.name as name, b.file as file, b.ordinal as ordinal from copied_uses as c join bindings as b on c.binding = b.binding;
let barrier_rows = select scope, phase, name, file, ordinal from changes where kind = "delete" or kind = "cleanup";
let chain_events = union(left=copied_marker_rows, right=barrier_rows);
let probe_bindings = select b.binding as binding,b.scope as scope,b.phase as phase,b.name as name,b.file as file,b.ordinal as ordinal from candidates_for_credit as l join routed_bindings as b on l.binding = b.binding and l.file = b.file;
let uncopied_bindings = antijoin(left=probe_bindings, right=copied_uses, left-on=["binding"], right-on=["binding"]);
let repeated_candidates = select l.binding as binding,l.scope as scope,l.phase as phase,l.name as name,l.file as file,l.ordinal as ordinal from uncopied_bindings as l join repeated_store_ids as r on l.binding = r.binding and l.file = r.file;
let chain_probes = select scope, phase, name, file, ordinal from repeated_candidates;
let chain_hits = latest_before(events=chain_events, probes=chain_probes);
let marker_hits = select l.scope as scope, l.phase as phase, l.name as name, l.file as file, l.point as point from chain_hits as l join copied_marker_rows as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name and l.file = r.file and l.event_ordinal = r.ordinal;
let inherited_uses = select b.binding as binding from marker_hits as h join bindings as b on h.scope = b.scope and h.phase = b.phase and h.name = b.name and h.file = b.file and h.point = b.ordinal;
let routed_credit = union(left=copied_uses,right=inherited_uses);
let site_repeated_series = select l.binding as binding,l.endpoint as endpoint,l.ordinal as ordinal,l.file as file from site_series as l;
let site_runs = select binding,endpoint,ordinal,file from site_repeated_series;
let current_series = select r.binding as binding,r.endpoint as endpoint,r.ordinal as ordinal,r.file as file from remaining_endpoints as l join site_runs as r on l.endpoint=r.endpoint and l.file=r.file;
let ordinary_sites = select r.binding as binding,r.endpoint as endpoint,r.ordinal as ordinal,r.file as file from ordinary_credit_bindings as l join current_series as r on l.binding=r.binding and l.file=r.file;
let ordinary_nexts = select l.binding as binding,r.next as next,l.file as file from ordinary_sites as l join site_followed as r on l.binding = r.binding and l.file = r.file;
let prior_reads = select l.ordinal as used_at,r.next as next,r.file as file from first_use as l join ordinary_nexts as r on l.binding = r.binding;
let next_stores = select occurrence as binding,ordinal,file from "binding-event" where kind = "bind";
let directly_copied = select r.binding as binding from prior_reads as l join next_stores as r on l.next = r.binding and l.file = r.file where l.used_at < r.ordinal;
let credited_sites = select r.endpoint as endpoint,r.ordinal as ordinal,r.file as file from directly_copied as l join ordinary_sites as r on l.binding = r.binding;
let first_credit = group-min(from=credited_sites, keys=[endpoint,file],order="ordinal");
let regular_probe_sites = select r.binding as binding,r.endpoint as endpoint,r.ordinal as ordinal,r.file as file from candidates_for_credit as l join ordinary_sites as r on l.binding = r.binding and l.file = r.file;
let inherited_credit = select l.binding as binding from regular_probe_sites as l join first_credit as r on l.endpoint = r.endpoint and l.file = r.file where l.ordinal > r.ordinal;
let ordinary_credit = union(left=directly_copied,right=inherited_credit);
let copied_and_inherited = union(left=ordinary_credit,right=routed_credit);
let used_before_nonlocal = union(left=direct_uses,right=copied_and_inherited);
let nonlocal_uses = select binding from resolved_nonlocals;
let used = union(left=used_before_nonlocal,right=nonlocal_uses);
let unused_locals = antijoin(left=eligible_locals,right=used,left-on=["binding"],right-on=["binding"]);
let unused_exceptions = antijoin(left=exception_bindings,right=used,left-on=["binding"],right-on=["binding"]);
let locals_scopes = select l.scope as scope from "binding-read" as l join "semantic-child" as r on l.reference=r.child and l.file=r.file where l.name="locals" and r.field="func";
let real_functions = select id from nodes where kind = "function-def" or kind = "async-function-def";
let inspecting_scopes = select l.scope as scope from locals_scopes as l join real_functions as r on l.scope = r.id;
let uninspected = antijoin(left=unused_locals,right=inspecting_scopes,left-on=["scope"],right-on=["scope"]);
let regular_names = select * from uninspected where name != "__tracebackhide__" and name != "__traceback_info__" and name != "__traceback_supplement__" and name != "__debuggerskip__";
let all_candidates = union(left=regular_names,right=unused_exceptions);
let dummy_candidates = select binding from all_candidates where matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let named_candidates = antijoin(left=all_candidates,right=dummy_candidates,left-on=["binding"],right-on=["binding"]);
let unpack_roots = unpacking_targets();
let candidate_ids = select binding as id, file from named_candidates;
let unpacked = axis(from=unpack_roots,relation="semantic-child",direction=descendant,domain=candidate_ids);
let excluded_unpacking = select related as binding from unpacked;
let report_candidates = antijoin(left=named_candidates,right=excluded_unpacking,left-on=["binding"],right-on=["binding"]);
let reportable = select r.id as id, l.file as file, l.span as span from report_candidates as l join "identifier" as r on l.name = r.name and l.span = r.span and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let suppression_matches = indexed_matches(candidates=candidate_locations,code="F841");
let violations = antijoin(left=reportable, right=suppression_matches, left-on=[id, span], right-on=[id, span]);
let noqa_matches = select directive,file,concat("","F841") as code from suppression_matches where scope<2;
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
