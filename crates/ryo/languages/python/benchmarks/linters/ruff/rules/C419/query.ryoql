import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
import keyword_argument_names from "python/ruff/call-keywords";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let positional_places = group-ordinal(from=positional_ordered, keys=["call"], order="ordinal", output="place");
let positional = select call, id, place as ordinal from positional_places;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let keyword_names = keyword_argument_names(keywords=keywords, identifiers=semantic_identifiers);
let qualified = select id from qualified_names where (path = "builtins.any" or path = "builtins.all") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let matching_calls = select l.parent as id from functions as l join qualified as r on l.child = r.id;
let no_keywords = antijoin(left=matching_calls, right=keywords, left-on=["id"], right-on=["call"]);
let first_args = select call, id from positional where ordinal = 0;
let arguments = select l.call as call, l.id as id from first_args as l join no_keywords as r on l.call = r.id;
let comprehensions = select id from "semantic-syntax" where kind = "list-comp" or kind = "set-comp";
let candidates = select l.call as call, r.id as id from arguments as l join comprehensions as r on l.id = r.id;
let elements = select parent, child from "semantic-child" where field = "elt";
let candidate_elements = select l.id as comprehension, r.child as id from candidates as l join elements as r on l.id = r.parent;
let awaits = select id from "semantic-syntax" where kind = "await";
let element_awaits = axis(from=candidate_elements, relation="semantic-child", direction=descendant, domain=awaits);
let descendants = select comprehension, related as id from element_awaits;
let all_elements = union(left=candidate_elements, right=descendants);
let awaits_in_element = select l.comprehension as id from all_elements as l join awaits as r on l.id = r.id;
let generators = select parent, child from "semantic-child" where field = "generators";
let async_fields = select parent from "semantic-child" where field = "is-async";
let async_comprehensions = select l.parent as id from generators as l join async_fields as r on l.child = r.parent;
let excluded = union(left=awaits_in_element, right=async_comprehensions);
let synchronous = antijoin(left=candidates, right=excluded, left-on=["id"], right-on=["id"]);
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join synchronous as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="C419");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "C419"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
