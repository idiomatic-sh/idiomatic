import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let classes = select id from "semantic-syntax" where kind = "class-def";
let arguments = select id, file, span from "semantic-syntax" where kind = "call-arguments";
let class_children = select r.child as child from classes as l join "semantic-child" as r on l.id = r.parent;
let class_arguments = select r.id as id, r.file as file, r.span as span from class_children as l join arguments as r on l.child = r.id;
let supplied = select parent from "semantic-child" where field = "bases" or field = "keywords";
let reportable = antijoin(left=class_arguments, right=supplied, left-on=["id"], right-on=["parent"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP039(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP039)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP039)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP039)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP039"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
