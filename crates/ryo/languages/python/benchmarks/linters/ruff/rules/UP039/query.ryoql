import observation_matches from "python/ruff/suppress-matches";
let classes = select id from "semantic-syntax" where kind = "class-def";
let arguments = select id, file, span from "semantic-syntax" where kind = "call-arguments";
let class_children = select r.child as child from classes as l join "semantic-child" as r on l.id = r.parent;
let class_arguments = select r.id as id, r.file as file, r.span as span from class_children as l join arguments as r on l.child = r.id;
let supplied = select parent from "semantic-child" where field = "bases" or field = "keywords";
let reportable = antijoin(left=class_arguments, right=supplied, left-on=["id"], right-on=["parent"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:UP039)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP039"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
