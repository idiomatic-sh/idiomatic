import suppress from "python/ruff/suppress";
let binary_nodes = select id, file, span from "semantic-syntax" where kind = "bin-op";
let operator_fields = select parent, child from "semantic-child" where field = "op";
let right_shift_tokens = select id, file from "semantic-syntax" where text = ">>";
let right_shifts = select l.parent as id, r.file as file from operator_fields as l join right_shift_tokens as r on l.child = r.id;
let candidates = select l.id as id, l.file as file, l.span as span from binary_nodes as l join right_shifts as r on l.id = r.id and l.file = r.file;
let left_fields = select parent, child from "semantic-child" where field = "left";
let left_names = select l.id as binary, l.file as file, r.child as left from candidates as l join left_fields as r on l.id = r.parent;
let builtin_print = select id, file from "qualified-name" where path = "builtins.print" and (provenance = "builtin" or provenance = "import");
let invalid_prints = select l.left as id, l.file as file from left_names as l join builtin_print as r on l.left = r.id and l.file = r.file;
let print_syntax_nodes = select l.id as id, l.file as file, r.span as span from invalid_prints as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from print_syntax_nodes as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F633(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F633)(?:,|$)");
emit violations subject file key(id);
