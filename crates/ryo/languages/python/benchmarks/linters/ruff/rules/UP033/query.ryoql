import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let lru_cache_functions = select id, file from "qualified-name" where path = "functools.lru_cache";
let lru_cache_calls = select l.call as call, l.file as file from call_functions as l join lru_cache_functions as r on l.function = r.id and l.file = r.file;
let function_defs = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let decorator_fields = select parent, child from "semantic-child" where field = "decorator-list";
let function_decorator_fields = select l.parent as function, l.child as decorator from decorator_fields as l join function_defs as r on l.parent = r.id;
let decorator_roots = select l.decorator as id, r.file as file from function_decorator_fields as l join "semantic-syntax" as r on l.decorator = r.id;
let decorator_call_edges = select l.decorator as root, r.child as call from function_decorator_fields as l join "semantic-child" as r on l.decorator = r.parent;
let decorator_calls = select l.call as call, r.file as file from decorator_call_edges as l join calls as r on l.call = r.id;
let decorated_lru_calls = select l.call as call, l.file as file from lru_cache_calls as l join decorator_calls as r on l.call = r.call and l.file = r.file;
let call_arguments = select parent as call, child as wrapper from "semantic-child";
let arguments_nodes = select id, file, span from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_arguments as l join arguments_nodes as r on l.wrapper = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_args = select l.call as call, r.child as argument, l.file as file from call_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let no_positional = antijoin(left=decorated_lru_calls,right=positional_args,left-on=["call","file"],right-on=["call","file"]);
let keyword_fields = select parent, child, ordinal from "semantic-child" where field = "keywords";
let keyword_nodes = select id, file from "semantic-syntax" where kind = "keyword";
let call_keyword_edges = select l.call as call, r.child as keyword, r.ordinal as ordinal, l.file as file from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let call_keywords = select l.call as call, l.keyword as keyword, l.ordinal as ordinal, l.file as file from call_keyword_edges as l join keyword_nodes as r on l.keyword = r.id and l.file = r.file;
let other_keyword_rows = select l.call as call, l.keyword as keyword, l.file as file from call_keywords as l join call_keywords as r on l.call = r.call and l.file = r.file where l.keyword != r.keyword;
let only_keyword = antijoin(left=call_keywords,right=other_keyword_rows,left-on=["call","keyword","file"],right-on=["call","keyword","file"]);
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_arg_ids = select l.parent as keyword, l.child as id, r.call as call, r.file as file from keyword_arg_fields as l join only_keyword as r on l.parent = r.keyword;
let identifiers = select id, name, file from "identifier";
let named_keywords = select l.call as call, l.keyword as keyword, l.id as id, l.file as file, r.name as name from keyword_arg_ids as l join identifiers as r on l.id = r.id and l.file = r.file;
let maxsize_keywords = select call, keyword, file from named_keywords where name = "maxsize";
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_values = select l.parent as keyword, l.child as value, r.call as call, r.file as file from keyword_value_fields as l join maxsize_keywords as r on l.parent = r.keyword;
let null_values = select id, file from "literal-properties" where kind = "null";
let null_maxsize = select l.call as call, l.file as file from keyword_values as l join null_values as r on l.value = r.id and l.file = r.file;
let valid_calls = select l.call as call, l.file as file, r.wrapper as arguments from null_maxsize as l join call_wrappers as r on l.call = r.call and l.file = r.file;
let lru_decorators = select l.call as call, l.file as file, l.arguments as arguments from valid_calls as l join no_positional as r on l.call = r.call and l.file = r.file;
let argument_rows = select l.arguments as id, l.file as file, r.span as span from lru_decorators as l join arguments_nodes as r on l.arguments = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from argument_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP033(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP033)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP033(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP033)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP033"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
