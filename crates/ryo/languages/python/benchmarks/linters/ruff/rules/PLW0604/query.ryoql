import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let statements = select id, file, span from "semantic-syntax" where kind = "global";
let scopes = select id, kind from "semantic-syntax" where kind in ["module", "function-def", "async-function-def", "class-def", "lambda"];
let owners = axis(from=statements, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let modules = select id from scopes where kind = "module";
let module_statements = select l.id as id from owners as l join modules as r on l.related = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from statements as l join module_statements as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="PLW0604");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PLW0604") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
