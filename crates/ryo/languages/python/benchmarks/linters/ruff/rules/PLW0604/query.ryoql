import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let statements = select id, file, span from "semantic-syntax" where kind = "global";
let scopes = select id, kind from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let owners = axis(from=statements, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let modules = select id from scopes where kind = "module";
let module_statements = select l.id as id from owners as l join modules as r on l.related = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from statements as l join module_statements as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0604(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0604)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0604(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0604)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0604"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
