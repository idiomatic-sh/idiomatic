import observation_matches from "python/ruff/suppress-matches";
let py3_references = select id, file, span from "qualified-name" where path = "six.PY3";
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from py3_references as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, code="YTT202");
let violations = antijoin(left=py3_references, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","YTT202") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
