import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let parameters = select id, file from "defines" where kind = "parameter";
let annotations = select parent as parameter, child as annotation, file from "semantic-child" where field = "annotation";
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let parameter_rows = select l.annotation as id, l.file as file from annotations as l join parameters as r on l.parameter = r.id and l.file = r.file;
let parameter_annotations = select l.id as id, l.file as file from parameter_rows as l join stub_files as r on l.file = r.file;
let no_return_names = select id, file from "qualified-name" where path = "typing.NoReturn" or path = "typing_extensions.NoReturn";
let direct_candidates = select l.id as id, l.file as file from parameter_annotations as l join no_return_names as r on l.id = r.id and l.file = r.file;
let string_values = select occurrence as id, value, file from "string-literal";
let parameter_string_values = select l.id as id, r.value as value, l.file as file from parameter_annotations as l join string_values as r on l.id = r.id and l.file = r.file;
let string_no_return = select id, file from parameter_string_values where value = "NoReturn";
let from_import_aliases = select binding, file from "static-import" where target = "typing.NoReturn" or target = "typing_extensions.NoReturn";
let string_alias_rows = select l.id as id, l.file as file from parameter_string_values as l join from_import_aliases as r on l.value = r.binding and l.file = r.file;
let module_import_aliases = select binding, target, file from "static-import" where target = "typing" or target = "typing_extensions";
let qualified_strings = select id, value, file from parameter_string_values;
let qualified_string_parts = capture(from=qualified_strings, path="value", pattern="{*alias}.NoReturn", captures=["alias"]);
let qualified_string_aliases = select l.id as id, l.file as file from qualified_string_parts as l join module_import_aliases as r on l.alias = r.binding and l.file = r.file;
let recognized_strings = union(left=string_no_return, right=string_alias_rows);
let all_string_aliases = union(left=recognized_strings, right=qualified_string_aliases);
let candidates = union(left=direct_candidates, right=all_string_aliases);
let locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI050(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI050(?:,|$)");
let ruf100_matches = observation_matches(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI050(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI050(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI050"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
