import suppress from "python/ruff/suppress";
import qualified_origins from "python/ruff/qualified-origins";
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let lambdas = select id, file from nodes where kind = "lambda";
let boundaries = union(left=functions, right=lambdas);
let all_edges = select parent, child, file from "semantic-child";
let boundary_edges = select l.parent as parent, l.child as child, l.file as file from all_edges as l join boundaries as r on l.parent = r.id and l.file = r.file;
let physical_walk_edges = antijoin(left=all_edges, right=boundary_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let embedded_edges = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=physical_walk_edges, right=embedded_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let body_edges = select l.id as function, r.child as child, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_roots = select function, child as id, file from body_edges;
let yields = select id, file from nodes where kind = "yield" or kind = "yield-from";
let raises = select id, file from nodes where kind = "raise";
let member_domain = union(left=yields, right=raises);
let rooted_members = axis(from=body_roots, relation=walk_edges, direction=descendant, domain=member_domain);
let reachable_nodes = select function, related as member, file from rooted_members;
let initial_nodes = select function, child as member, file from body_edges;
let members = union(left=initial_nodes, right=reachable_nodes);
let generator_functions = select l.function as function, l.file as file from members as l join yields as r on l.member = r.id and l.file = r.file;
let function_raises = select l.function as function, l.member as raise, l.file as file from members as l join raises as r on l.member = r.id and l.file = r.file;
let generator_raises = select l.function as function, l.raise as raise, l.file as file from function_raises as l join generator_functions as r on l.function = r.function and l.file = r.file;
let raise_exceptions = select l.function as function, l.raise as raise, r.child as exception, l.file as file from generator_raises as l join "semantic-child" as r on l.raise = r.parent and l.file = r.file where r.field = "exc";
let calls = select id, file from nodes where kind = "call";
let bare_exceptions = antijoin(left=raise_exceptions, right=calls, left-on=["exception", "file"], right-on=["id", "file"]);
let bare_values = select function, raise, exception as value, file from bare_exceptions;
let called_values = select l.function as function, l.raise as raise, r.child as value, l.file as file from raise_exceptions as l join "semantic-child" as r on l.exception = r.parent and l.file = r.file where r.field = "func";
let exception_values = union(left=bare_values, right=called_values);
let function_scopes = select child as function, parent as initial_scope, file from "scope";
let bind_events = select occurrence as function, ordinal as point, file from "binding-event" where kind = "bind";
let function_points = select l.function as context, l.initial_scope as initial_scope, r.point as point, r.point as header_point, l.file as file from function_scopes as l join bind_events as r on l.function = r.function and l.file = r.file;
let context_rows = extend(from=function_points, values={stage: 0});
let contexts = select context, initial_scope, point, header_point, stage, file from context_rows;
let origin_expressions = select value as id, file from exception_values;
let origins = qualified_origins(symbol_contexts=contexts, expressions=origin_expressions);
let stop_iteration_origins = select context, expression, file from origins where path = "builtins.StopIteration";
let reportable_rows = select l.raise as id, l.file as file from exception_values as l join stop_iteration_origins as r on l.function = r.context and l.value = r.expression and l.file = r.file;
let reportable_groups = group-count(from=reportable_rows, keys=["id", "file"], count="count", distinct="id");
let reportable = select id, file from reportable_groups;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PLR1708($|[, #])", range-pattern="(?:^|,)PLR1708(?:,|$)");
emit violations subject file key(id);
