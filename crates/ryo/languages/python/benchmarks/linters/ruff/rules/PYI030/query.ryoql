import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let union_nodes = select id, file, span from "semantic-syntax" where kind = "bin-op";
let operator_fields = select parent, child from "semantic-child" where field = "op";
let operators = select l.id as operation, r.child as operator, l.file as file from union_nodes as l join operator_fields as r on l.id = r.parent;
let pipe_tokens = select id, file from "semantic-syntax" where text = "|";
let pipe_operators = select l.operation as operation, l.file as file from operators as l join pipe_tokens as r on l.operator = r.id and l.file = r.file;
let unions = select l.id as id, l.file as file, l.span as span from union_nodes as l join pipe_operators as r on l.id = r.operation and l.file = r.file;
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let literal_names = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let subscript_values = select l.parent as subscript, l.child as value, l.file as file from "semantic-child" as l join subscript_nodes as r on l.parent = r.id and l.file = r.file where l.field = "value";
let literal_subscripts = select l.subscript as subscript, l.file as file from subscript_values as l join literal_names as r on l.value = r.id and l.file = r.file;
let descendants = axis(from=unions, relation="semantic-child", direction=descendant, domain=subscript_nodes);
let union_literals = select l.id as union, r.subscript as literal, l.file as file from descendants as l join literal_subscripts as r on l.related = r.subscript and l.file = r.file;
let counts = group-count(from=union_literals, keys=["union", "file"], count="count", distinct="literal");
let multiple = select union as id, file from counts where count > 1;
let reportable = select l.id as id, l.file as file, r.span as span from multiple as l join unions as r on l.id = r.id and l.file = r.file;
let locations = select r.id as id, r.file as file, r."start-line" as line from "source-location" as r;
let candidates = select l.id as id, l.file as file, l.span as span, r.line as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI030(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI030)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI030(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI030)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI030"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
