import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import nonlocal_bindings from "python/ruff/nonlocal-bindings";
import namespace_events from "python/ruff/checker-namespace-events";
let events = namespace_events();
let syntax = select id, kind, file from "semantic-syntax";
let functions = select id, file from syntax where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let globals0 = select occurrence as id, name, scope, ordinal, file from events where kind = "global";
let modules = select id, file from syntax where kind = "module";
let globals = antijoin(left=globals0, right=modules, left-on=["scope", "file"], right-on=["id", "file"]);
let resolved_nonlocals = nonlocal_bindings(events=events);
let valid_nonlocals = select l.occurrence as occurrence, l.name as name, l.scope as scope, l.ordinal as ordinal, l.file as file from events as l join resolved_nonlocals as r on l.occurrence = r.declaration and l.file = r.file where l.kind = "nonlocal";
let ordinary_endings = select occurrence, name, scope, ordinal, file from events where kind = "bind" or kind = "delete" or kind = "cleanup" or kind = "global";
let endings = union(left=ordinary_endings, right=valid_nonlocals);
let replaced = select l.id as id, l.file as file from globals as l join endings as r on l.name = r.name and l.scope = r.scope and l.file = r.file where l.ordinal < r.ordinal;
let candidates = antijoin(left=globals, right=replaced, left-on=["id", "file"], right-on=["id", "file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from candidates as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0602(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0602)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0602(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0602)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0602"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
