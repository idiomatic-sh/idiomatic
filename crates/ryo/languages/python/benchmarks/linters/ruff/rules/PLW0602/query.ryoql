import namespace_events from "python/ruff/checker-namespace-events";
import conflicting_nonlocals from "python/ruff/conflicting-nonlocal-declarations";
import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let declarations = select occurrence as id, lexical as scope, name, ordinal, file from "binding-event" where kind = "global";
let modules = select id, file from "semantic-syntax" where kind = "module";
let globals = antijoin(left=declarations, right=modules, left-on=[scope,file], right-on=[id,file]);
let stores = select lexical as scope, name, ordinal, file from "binding-event" where kind in ["bind","global","delete","cleanup"];
let nonlocals = select occurrence as declaration, lexical as scope, name, ordinal, file from "binding-event" where kind = "nonlocal";
let conflicts = select r.declaration as declaration, r.scope as scope, r.name as name, r.ordinal as ordinal, r.file as file from globals as l join nonlocals as r on l.scope = r.scope and l.name = r.name and l.file = r.file where l.ordinal < r.ordinal;
let conflict_names = select name, file from conflicts;
let all_events = namespace_events();
let conflict_events = select r.occurrence as occurrence, r.name as name, r.scope as scope, r.ordinal as ordinal, r.kind as kind, r.file as file from conflict_names as l join all_events as r on l.name = r.name and l.file = r.file;
let valid_conflicts = conflicting_nonlocals(events=conflict_events);
let counted = select l.scope as scope, l.name as name, l.ordinal as ordinal, l.file as file from conflicts as l join valid_conflicts as r on l.declaration = r.declaration and l.file = r.file;
let changes = union(left=stores, right=counted);
let last_change = group-max(from=changes,keys=[name,scope,file],order="ordinal");
let replaced = select l.id as id,l.file as file from globals as l join last_change as r on l.name=r.name and l.scope=r.scope and l.file=r.file where l.ordinal<r.ordinal;
let candidates = antijoin(left=globals, right=replaced, left-on=["id", "file"], right-on=["id", "file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from candidates as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="PLW0602");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PLW0602") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
