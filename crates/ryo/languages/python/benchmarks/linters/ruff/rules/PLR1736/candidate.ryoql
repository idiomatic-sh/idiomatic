import annotation_origins from "python/ruff/annotation-origins";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
import accesses from "python/ruff/sequence-index-accesses";
let loop_nodes = select id, file from nodes where kind = "for" or kind = "async-for";
let comp_nodes = select id, file from nodes where kind = "comprehension";
let owner_nodes = union(left=loop_nodes, right=comp_nodes);
let iteration_fields = select parent, child, file from "semantic-child" where field = "iter";
let owner_iterations = select l.id as context, l.file as file, r.child as iterator from owner_nodes as l join iteration_fields as r on l.id = r.parent and l.file = r.file;
let target_fields = select parent, child, file from "semantic-child" where field = "target";
let owner_targets = select l.context as context, l.file as file, l.iterator as iterator, r.child as target from owner_iterations as l join target_fields as r on l.context = r.parent and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let tuple_targets = select l.context as context, l.file as file, l.iterator as iterator, r.id as target from owner_targets as l join tuples as r on l.target = r.id and l.file = r.file;
let target_elements = select l.context as context, l.file as file, l.iterator as iterator, r.child as element, r.ordinal as ordinal from tuple_targets as l join "semantic-child" as r on l.target = r.parent and l.file = r.file where r.field = "elts";
let target_counts = group-count(from=target_elements, keys=["context","file"], count="count", distinct="element");
let binary_elements = select l.context as context, l.file as file, l.iterator as iterator, l.element as element, l.ordinal as ordinal from target_elements as l join target_counts as r on l.context = r.context and l.file = r.file where r.count = 2;
let first_elements = select l.context as context, l.file as file, l.iterator as iterator, l.element as index_node, r.element as value_node from binary_elements as l join binary_elements as r on l.context = r.context and l.file = r.file where l.ordinal < r.ordinal;
let name_nodes = select id, file from nodes where kind = "name";
let names = select l.id as id, l.file as file, r.name as name from name_nodes as l join "identifier" as r on l.id = r.id and l.file = r.file;
let index_names = select l.context as context, l.file as file, l.iterator as iterator, l.value_node as value_node, r.name as index from first_elements as l join names as r on l.index_node = r.id and l.file = r.file where r.name != "_";
let pair_names = select l.context as context, l.file as file, l.iterator as iterator, l.index as index, r.name as value from index_names as l join names as r on l.value_node = r.id and l.file = r.file where r.name != "_";
let generator_fields = select parent, child, ordinal, file from "semantic-child" where field = "generators";
let comp_members = select l.id as generator, l.file as file, r.parent as expression, r.ordinal as ordinal from comp_nodes as l join generator_fields as r on l.id = r.child and l.file = r.file;
let qualified_enumerators = select call, file from qualified_calls where path = "builtins.enumerate";
let builtin_enumerators = select l.call as call, l.file as file from callee_nodes as l join "binding-read" as r on l.callee = r.reference and l.file = r.file where r.name = "enumerate" and r.state = "builtin";
let embedded_roots = select root as id, file from "embedded-expression";
let callee_ids = select callee as id, file from callee_nodes;
let embedded_callee_ancestors = axis(from=callee_ids, relation="semantic-child", direction=nearest-ancestor, domain=embedded_roots);
let embedded_callees = select l.call as call, l.callee as callee, l.file as file from callee_nodes as l join embedded_callee_ancestors as r on l.callee = r.id and l.file = r.file;
let embedded_callee_ids = select callee as id, file from embedded_callees;
let embedded_origins = annotation_origins(expressions=embedded_callee_ids);
let embedded_enumerators = select l.call as call, l.file as file from embedded_callees as l join embedded_origins as r on l.callee = r.id and l.file = r.file where r.path = "builtins.enumerate";
let ordinary_enumerators = union(left=qualified_enumerators, right=builtin_enumerators);
let newly_resolved_enumerators = antijoin(left=embedded_enumerators, right=ordinary_enumerators, left-on=["call", "file"], right-on=["call", "file"]);
let enumerate_calls = union(left=ordinary_enumerators, right=newly_resolved_enumerators);
let enumeration_pairs = select l.context as context, l.file as file, l.iterator as iterator, l.index as index, l.value as value from pair_names as l join enumerate_calls as r on l.iterator = r.call and l.file = r.file;
let first_arguments = select call, value, file from positional_arguments where position = 0;
let second_arguments = select call, value, file from positional_arguments where position = 1;
let unstarred_second = antijoin(left=second_arguments, right=starred_nodes, left-on=["value","file"], right-on=["id","file"]);
let start_keywords = select call, value, file from named_keyword_values where name = "start";
let positional_starts = antijoin(left=unstarred_second, right=start_keywords, left-on=["call","file"], right-on=["call","file"]);
let starts = union(left=start_keywords, right=positional_starts);
let bad_starts = antijoin(left=starts, right=plain_zero, left-on=["value","file"], right-on=["id","file"]);
let zero_enumerations = antijoin(left=enumeration_pairs, right=bad_starts, left-on=["iterator","file"], right-on=["call","file"]);
let first_values = select l.context as context, l.file as file, l.index as index, l.value as value, r.value as sequence_node from zero_enumerations as l join first_arguments as r on l.iterator = r.call and l.file = r.file;
let valid_contexts = select l.context as context, r.name as sequence, l.index as index, l.value as value, l.file as file from first_values as l join names as r on l.sequence_node = r.id and l.file = r.file;
let bad_generators = antijoin(left=comp_members, right=valid_contexts, left-on=["generator","file"], right-on=["context","file"]);
let late_generators = select l.generator as context, l.file as file from comp_members as l join bad_generators as r on l.expression = r.expression and l.file = r.file where r.ordinal < l.ordinal;
let contexts = antijoin(left=valid_contexts, right=late_generators, left-on=["context","file"], right-on=["context","file"]);
let loop_contexts = select l.context as context, l.file as file from contexts as l join loop_nodes as r on l.context = r.id and l.file = r.file;
let loop_starts = select l.context as context, l.context as entry, r.child as destination, r.ordinal as position, l.file as file from loop_contexts as l join "semantic-child" as r on l.context = r.parent and l.file = r.file where (r.field = "body" or r.field = "orelse");
let comp_contexts = select l.context as context, l.file as file, r.expression as expression from contexts as l join comp_members as r on l.context = r.generator and l.file = r.file;
let element_roots0 = select l.context as context, l.context as entry, r.child as destination, l.file as file from comp_contexts as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "elt" or r.field = "value";
let element_roots1 = extend(from=element_roots0, values={position: 0});
let element_starts = select context, entry, destination, position, file from element_roots1;
let selected_starts = union(left=loop_starts, right=element_starts);
let found = accesses(contexts=contexts, starts=selected_starts);
let candidates = select l.id as id, l.file as file, r.span as span from found as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let visible_locations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLR1736(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLR1736)(?:,|$)");
let violations = select l.id as id, l.file as file, r.span as span, l.context as context from found as l join visible_locations as r on l.id = r.id and l.file = r.file;
emit violations subject file key(id,context);
