let moved_5 = select id, file from typed where ((target in ["typing_extensions.AbstractSet", "typing_extensions.AnyStr", "typing_extensions.AsyncIterable", "typing_extensions.AsyncIterator", "typing_extensions.Awaitable", "typing_extensions.BinaryIO", "typing_extensions.Callable", "typing_extensions.ClassVar", "typing_extensions.Collection", "typing_extensions.Container", "typing_extensions.Coroutine", "typing_extensions.DefaultDict", "typing_extensions.Dict", "typing_extensions.FrozenSet", "typing_extensions.Generic", "typing_extensions.Hashable", "typing_extensions.IO", "typing_extensions.ItemsView", "typing_extensions.Iterable", "typing_extensions.Iterator", "typing_extensions.KeysView", "typing_extensions.List", "typing_extensions.Mapping", "typing_extensions.MappingView", "typing_extensions.Match", "typing_extensions.MutableMapping", "typing_extensions.MutableSequence", "typing_extensions.MutableSet", "typing_extensions.Optional", "typing_extensions.Pattern", "typing_extensions.Reversible", "typing_extensions.Sequence", "typing_extensions.Set", "typing_extensions.Sized", "typing_extensions.TYPE_CHECKING", "typing_extensions.Text", "typing_extensions.TextIO", "typing_extensions.Tuple", "typing_extensions.Type", "typing_extensions.Union", "typing_extensions.ValuesView", "typing_extensions.cast", "typing_extensions.no_type_check", "typing_extensions.no_type_check_decorator"]) and major >= 3) or ((target in ["typing_extensions.ChainMap", "typing_extensions.Counter", "typing_extensions.Deque", "typing_extensions.ForwardRef", "typing_extensions.NoReturn"]) and (major > 3 or major = 3 and minor >= 7)) or ((target = "typing_extensions.Final" or target = "typing_extensions.OrderedDict") and (major > 3 or major = 3 and minor >= 8)) or ((target = "typing_extensions.Annotated") and (major > 3 or major = 3 and minor >= 9)) or ((target in ["typing_extensions.Concatenate", "typing_extensions.Literal", "typing_extensions.NewType", "typing_extensions.ParamSpecArgs", "typing_extensions.ParamSpecKwargs", "typing_extensions.TypeAlias", "typing_extensions.TypeGuard", "typing_extensions.get_args", "typing_extensions.get_origin"]) and (major > 3 or major = 3 and minor >= 10)) or ((target in ["typing_extensions.Any", "typing_extensions.LiteralString", "typing_extensions.Never", "typing_extensions.NotRequired", "typing_extensions.Required", "typing_extensions.Self", "typing_extensions.assert_never", "typing_extensions.assert_type", "typing_extensions.clear_overloads", "typing_extensions.final", "typing_extensions.get_overloads", "typing_extensions.overload", "typing_extensions.reveal_type"]) and (major > 3 or major = 3 and minor >= 11)) or ((target in ["typing_extensions.Protocol", "typing_extensions.SupportsAbs", "typing_extensions.SupportsBytes", "typing_extensions.SupportsComplex", "typing_extensions.SupportsFloat", "typing_extensions.SupportsIndex", "typing_extensions.SupportsInt", "typing_extensions.SupportsRound", "typing_extensions.TypeAliasType", "typing_extensions.Unpack", "typing_extensions.NamedTuple", "typing_extensions.dataclass_transform", "typing_extensions.override"]) and (major > 3 or major = 3 and minor >= 12)) or ((target in ["typing_extensions.get_protocol_members", "typing_extensions.is_protocol", "typing_extensions.NoDefault", "typing_extensions.ReadOnly", "typing_extensions.TypeIs", "typing_extensions.get_type_hints", "typing_extensions.ContextManager", "typing_extensions.Generator", "typing_extensions.AsyncContextManager", "typing_extensions.AsyncGenerator", "typing_extensions.Protocol", "typing_extensions.runtime_checkable", "typing_extensions.ParamSpec", "typing_extensions.TypeVar", "typing_extensions.TypeVarTuple"]) and (major > 3 or major = 3 and minor >= 13));
