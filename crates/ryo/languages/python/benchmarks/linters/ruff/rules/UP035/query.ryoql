let reportable = select l.id as id, l.file as file, r.span as span, l.token as token, l.diagnostic_group as diagnostic_group from merged_24 as l join statements as r on l.id = r.id and l.file = r.file;
let locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let allowed = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP035(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP035)(?:,|$)");
let violations = select l.id as id, l.file as file, l.span as span, l.token as token, l.diagnostic_group as diagnostic_group from reportable as l join allowed as r on l.id = r.id and l.file = r.file and l.span = r.span;
emit violations subject file key(id, token, diagnostic_group);
