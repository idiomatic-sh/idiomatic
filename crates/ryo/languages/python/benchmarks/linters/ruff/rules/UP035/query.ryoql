import suppress from "python/ruff/suppress";
let statements = select id, file, span from "semantic-syntax" where kind = "import-from";
let names = select parent as statement, child as occurrence, file from "semantic-child" where field = "names";
let imports = select occurrence, target, file from "static-import";
let aliases = select l.statement as id, l.occurrence as occurrence, r.target as target, r.file as file from names as l join imports as r on l.occurrence = r.occurrence and l.file = r.file;
let targets = select file, major, minor from "language-target";
let typed = select l.id as id, l.occurrence as occurrence, l.target as target, l.file as file, r.major as major, r.minor as minor from aliases as l join targets as r on l.file = r.file;
let moved_0 = select id, file from typed where ((target = "collections.AsyncGenerator" or target = "collections.AsyncIterable" or target = "collections.AsyncIterator" or target = "collections.Awaitable" or target = "collections.ByteString" or target = "collections.Callable" or target = "collections.Collection" or target = "collections.Container" or target = "collections.Coroutine" or target = "collections.Generator" or target = "collections.Hashable" or target = "collections.ItemsView" or target = "collections.Iterable" or target = "collections.Iterator" or target = "collections.KeysView" or target = "collections.Mapping" or target = "collections.MappingView" or target = "collections.MutableMapping" or target = "collections.MutableSequence" or target = "collections.MutableSet" or target = "collections.Reversible" or target = "collections.Sequence" or target = "collections.Set" or target = "collections.Sized" or target = "collections.ValuesView") and major >= 3);
