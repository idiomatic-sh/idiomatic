.Deque" or target = "typing_extensions.ForwardRef" or target = "typing_extensions.NoReturn") and (major > 3 or major = 3 and minor >= 7)) or ((target = "typing_extensions.Final" or target = "typing_extensions.OrderedDict") and (major > 3 or major = 3 and minor >= 8)) or ((target = "typing_extensions.Annotated") and (major > 3 or major = 3 and minor >= 9)) or ((target = "typing_extensions.Concatenate" or target = "typing_extensions.Literal" or target = "typing_extensions.NewType" or target = "typing_extensions.ParamSpecArgs" or target = "typing_extensions.ParamSpecKwargs" or target = "typing_extensions.TypeAlias" or target = "typing_extensions.TypeGuard" or target = "typing_extensions.get_args" or target = "typing_extensions.get_origin") and (major > 3 or major = 3 and minor >= 10)) or ((target = "typing_extensions.Any" or target = "typing_extensions.LiteralString" or target = "typing_extensions.Never" or target = "typing_extensions.NotRequired" or target = "typing_extensions.Required" or target = "typing_extensions.Self" or target = "typing_extensions.assert_never" or target = "typing_extensions.assert_type" or target = "typing_extensions.clear_overloads" or target = "typing_extensions.final" or target = "typing_extensions.get_overloads" or target = "typing_extensions.overload" or target = "typing_extensions.reveal_type") and (major > 3 or major = 3 and minor >= 11)) or ((target = "typing_extensions.Protocol" or target = "typing_extensions.SupportsAbs" or target = "typing_extensions.SupportsBytes" or target = "typing_extensions.SupportsComplex" or target = "typing_extensions.SupportsFloat" or target = "typing_extensions.SupportsIndex" or target = "typing_extensions.SupportsInt" or target = "typing_extensions.SupportsRound" or target = "typing_extensions.TypeAliasType" or target = "typing_extensions.Unpack" or target = "typing_extensions.NamedTuple" or target = "typing_extensions.dataclass_transform" or target = "typing_extensions.override") and (major > 3 or major =