import observation_matches from "python/ruff/suppress-matches";
let statements = select id, file, span from "semantic-syntax" where kind = "import-from";
let names = select parent as statement, child as occurrence, file from "semantic-child" where field = "names";
let imports = select occurrence, target, file from "static-import";
let aliases = select l.statement as id, l.occurrence as occurrence, r.target as target, r.file as file from names as l join imports as r on l.occurrence = r.occurrence and l.file = r.file;
let targets = select file, major, minor from "language-target";
let typed = select l.id as id, l.occurrence as occurrence, l.target as target, l.file as file, r.major as major, r.minor as minor from aliases as l join targets as r on l.file = r.file;
let moved_0 = select id, file from typed where ((target in ["collections.AsyncGenerator", "collections.AsyncIterable", "collections.AsyncIterator", "collections.Awaitable", "collections.ByteString", "collections.Callable", "collections.Collection", "collections.Container", "collections.Coroutine", "collections.Generator", "collections.Hashable", "collections.ItemsView", "collections.Iterable", "collections.Iterator", "collections.KeysView", "collections.Mapping", "collections.MappingView", "collections.MutableMapping", "collections.MutableSequence", "collections.MutableSet", "collections.Reversible", "collections.Sequence", "collections.Set", "collections.Sized", "collections.ValuesView"]) and major >= 3);
let group_0 = extend(from=moved_0, values={diagnostic_group: 0});
let rows_0 = select id, file, id as token, diagnostic_group from group_0;
