import suppress from "python/ruff/suppress";
import deferred_resolutions from "python/ruff/deferred-read-resolutions";
import eager_before_future from "python/ruff/eager-before-future";
let read_rows = select reference, name, scope, phase, context, state, "since-major" as since_major, "since-minor" as since_minor, file, span from "binding-read";
let ordinary_missing0 = select reference as id, name, scope, phase, file, span from read_rows where state = "unbound" and context != "deletion";
let replay_reads = select reference as id, name, scope, phase, file from read_rows where context != "deletion";
let eager_missing = eager_before_future(reads=replay_reads);
let replay_missing = select l.reference as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from read_rows as l join eager_missing as r on l.reference = r.id and l.file = r.file;
let ordinary_missing = union(left=ordinary_missing0, right=replay_missing);
let global_declarations = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "global";
let global_function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let global_declaration_owners = axis(from=global_declarations, relation="semantic-child", direction=nearest-ancestor, domain=global_function_scopes);
let global_owner_names = select l.name as name, r.related as scope, l.file as file from global_declarations as l join global_declaration_owners as r on l.id = r.id;
let global_scope_edges = select parent as origin, child as destination from "semantic-child";
let global_scope_paths = closure(edges=global_scope_edges, source="origin", destination="destination");
let visible_global_scope_pairs = select l.scope as global_scope, r.destination as read_scope, l.name as name, l.file as file from global_owner_names as l join global_scope_paths as r on l.scope = r.origin;
let direct_global_scopes = select scope as global_scope, scope as read_scope, name, file from global_owner_names;
let all_global_scope_pairs = union(left=visible_global_scope_pairs, right=direct_global_scopes);
let explicit_global_reads = select l.reference as id from read_rows as l join all_global_scope_pairs as r on l.name = r.name and l.scope = r.read_scope and l.file = r.file where l.state = "unbound";
let ordinary_missing_without_global = antijoin(left=ordinary_missing, right=explicit_global_reads, left-on=["id"], right-on=["id"]);
let read_events = select occurrence as id, ordinal, scope, phase, name, file from "binding-event" where kind = "read";
let local_declarations = select name, scope, phase, ordinal, file from "binding-event" where kind = "bind" or kind = "annotation";
let removal_events = select name, scope, phase, ordinal, file from "binding-event" where kind = "delete" or kind = "cleanup";
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let missing_read_events = select l.id as id, r.ordinal as ordinal, r.scope as scope, r.phase as phase, r.name as name, r.file as file from ordinary_missing as l join read_events as r on l.id = r.id and l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let prior_removals = select l.id as id from missing_read_events as l join removal_events as d on l.name = d.name and l.phase = d.phase and l.file = d.file where d.ordinal < l.ordinal;
let deletion_reads = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from ordinary_missing as l join prior_removals as r on l.id = r.id;
let delete_events = select occurrence as id, name, scope, phase, ordinal, file, span from "binding-event" where kind = "delete";
let global_deletions = select l.id as id from delete_events as l join global_declarations as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where r.ordinal < l.ordinal;
let non_global_deletions = antijoin(left=delete_events, right=global_deletions, left-on=["id"], right-on=["id"]);
let nonlocal_declarations = select name, scope, file from "binding-event" where kind = "nonlocal";
let nonlocal_binding_scopes = select l.name as name, l.scope as scope, l.file as file from nonlocal_declarations as l join "binding-event" as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.kind = "bind" or r.kind = "annotation";
let valid_nonlocal_deletions = select l.id as id from non_global_deletions as l join nonlocal_binding_scopes as r on l.name = r.name and l.file = r.file;
let local_delete_candidates = antijoin(left=non_global_deletions, right=valid_nonlocal_deletions, left-on=["id"], right-on=["id"]);
let parameter_declarations = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let raw_namespace_effects = select occurrence as id, name, scope, phase, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let nonparameter_namespace_effects = antijoin(left=raw_namespace_effects, right=parameter_declarations, left-on=["id", "file"], right-on=["id", "file"]);
let conditional_domains = select id, file from "semantic-syntax" where kind = "if" or kind = "while" or kind = "match";
let conditional_deletion_axes = axis(from=delete_events, relation="semantic-child", direction=ancestor, domain=conditional_domains);
let conditional_deletions = select id, file from conditional_deletion_axes;
let orelse_roots = select child as id, file from "semantic-child" where field = "orelse";
let orelse_deletion_axes = axis(from=delete_events, relation="semantic-child", direction=ancestor, domain=orelse_roots);
let orelse_deletions = select id, file from orelse_deletion_axes;
let handler_boundaries = select id, file from "semantic-syntax" where kind = "except-handler" or kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let nearest_handler_boundaries = axis(from=delete_events, relation="semantic-child", direction=nearest-ancestor, domain=handler_boundaries);
let handler_deletions = select l.id as id, l.file as file from nearest_handler_boundaries as l join handlers as r on l.related = r.id and l.file = r.file;
let conditional_delete_effects0 = union(left=conditional_deletions, right=orelse_deletions);
let conditional_delete_effects = union(left=conditional_delete_effects0, right=handler_deletions);
let namespace_effects = antijoin(left=nonparameter_namespace_effects, right=conditional_delete_effects, left-on=["id", "file"], right-on=["id", "file"]);
let prior_effects = select l.id as deletion, l.name as name, l.scope as scope, l.phase as phase, l.file as file, r.ordinal as prior, r.kind as prior_kind from local_delete_candidates as l join namespace_effects as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file where r.ordinal < l.ordinal;
let superseded_prior_effects = select l.deletion as deletion, l.prior as prior from prior_effects as l join prior_effects as r on l.deletion = r.deletion where l.prior < r.prior;
let latest_prior_effects = antijoin(left=prior_effects, right=superseded_prior_effects, left-on=["deletion", "prior"], right-on=["deletion", "prior"]);
let latest_prior_bindings = select deletion as id from latest_prior_effects where prior_kind = "bind";
let missing_prior_bindings = antijoin(left=local_delete_candidates, right=latest_prior_bindings, left-on=["id"], right-on=["id"]);
let builtin_modules = select id, file from "semantic-syntax" where kind = "module";
let no_prior_effect_deletions = antijoin(left=missing_prior_bindings, right=prior_effects, left-on=["id", "file"], right-on=["deletion", "file"]);
let builtin_deletions0 = select l.id as id, l.name as name, l.file as file from no_prior_effect_deletions as l join builtin_modules as r on l.scope = r.id and l.file = r.file;
let builtin_catalog = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let first_builtin_deletions = select l.id as id, l.file as file from builtin_deletions0 as l join builtin_catalog as r on l.name = r.name and l.file = r.file;
let actually_missing_deletions = antijoin(left=missing_prior_bindings, right=first_builtin_deletions, left-on=["id", "file"], right-on=["id", "file"]);
let inferred_unresolved_deletions = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file, l.span as span from actually_missing_deletions as l;
let all_unresolved_deletions = select * from inferred_unresolved_deletions;
let unavailable_builtins = select reference as id, name, scope, phase, file, span from read_rows where state = "builtin" and context != "deletion" and (since_major > 3 or since_major = 3 and since_minor > 10);
let pre_environment_candidates = union(left=ordinary_missing_without_global, right=unavailable_builtins);
let module_environment = select catalog.name as name, catalog.scope as scope, catalog.file as file from "implicit-symbol" as catalog where catalog.kind = "module-global" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let ordinary_candidates = antijoin(left=pre_environment_candidates, right=prior_removals, left-on=["id"], right-on=["id"]);
let module_environment_reads = select l.id as id from ordinary_candidates as l join module_environment as r on l.name = r.name and l.file = r.file;
let without_module_environment = antijoin(left=ordinary_candidates, right=module_environment_reads, left-on=["id"], right-on=["id"]);
let platform_environment = select name, file from "implicit-symbol" where kind = "platform-builtin";
let platform_environment_reads = select l.id as id from without_module_environment as l join platform_environment as r on l.name = r.name and l.file = r.file;
let without_platform_environment = antijoin(left=without_module_environment, right=platform_environment_reads, left-on=["id"], right-on=["id"]);
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_candidate_reads = select l.id as id, r.name as name, r.scope as scope, r.file as file from without_platform_environment as l join read_rows as r on l.id = r.reference and l.file = r.file;
let class_magic_reads = select l.id as id from class_candidate_reads as l join class_scopes as c on l.scope = c.id and l.file = c.file where (l.name = "__module__" or l.name = "__qualname__");
let class_cell_candidate_reads = select l.id as id, r.scope as scope, r.file as file from without_platform_environment as l join read_rows as r on l.id = r.reference and l.file = r.file where r.name = "__class__";
let function_class_cell_reads = select l.id as id, l.file as file from class_cell_candidate_reads as l join function_scopes as f on l.scope = f.id and l.file = f.file;
let class_ancestors = axis(from=function_class_cell_reads, relation="semantic-child", direction=nearest-ancestor, domain=class_scopes);
let class_cell_reads = select l.id as id from class_ancestors as l join class_scopes as c on l.related = c.id and l.file = c.file;
let class_implicit_reads = union(left=class_magic_reads, right=class_cell_reads);
let without_class_implicit = antijoin(left=without_platform_environment, right=class_implicit_reads, left-on=["id"], right-on=["id"]);
let known_deletions = union(left=deletion_reads, right=all_unresolved_deletions);
let pre_suppression_candidates = union(left=without_class_implicit, right=known_deletions);
let semantic_paths = closure(edges="semantic-child", source="parent", destination="child");
let tries = select id, file from "semantic-syntax" where kind = "try";
let try_body_roots = select l.parent as attempt, l.child as child from "semantic-child" as l join tries as r on l.parent = r.id where l.field = "body";
let try_body_nodes = select l.attempt as attempt, r.child as id from try_body_roots as l join semantic_paths as r on l.child = r.parent;
let try_body_root_nodes = select attempt, child as id from try_body_roots;
let all_try_body_nodes = union(left=try_body_nodes, right=try_body_root_nodes);
let handler_edges = select parent, child as handler from "semantic-child" where field = "handlers";
let try_handlers = select l.parent as attempt, l.handler as handler, r.file as file from handler_edges as l join tries as r on l.parent = r.id;
let handler_type_roots = select parent as handler, child as id from "semantic-child" where field = "type";
let handler_type_descendants = select l.handler as handler, r.child as id from handler_type_roots as l join semantic_paths as r on l.id = r.parent;
let handler_type_nodes = union(left=handler_type_roots, right=handler_type_descendants);
let name_error_type_nodes = select l.handler as handler from handler_type_nodes as l join "qualified-name" as r on l.id = r.id where r.path = "builtins.NameError";
let name_error_attempts = select l.attempt as id, l.file as file from try_handlers as l join name_error_type_nodes as r on l.handler = r.handler;
let name_error_body_reads = select r.attempt as attempt, l.id as id from pre_suppression_candidates as l join all_try_body_nodes as r on l.id = r.id;
let name_error_candidates = select l.attempt as attempt, l.id as id from name_error_body_reads as l join name_error_attempts as r on l.attempt = r.id;
let phase_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda" or kind = "generator-exp";
let try_phase_ancestors = axis(from=tries, relation="semantic-child", direction=nearest-ancestor, domain=phase_scopes);
let try_phase_rows = select id as attempt, related as phase, file from try_phase_ancestors;
let module_roots = select id as phase, file from "semantic-syntax" where kind = "module";
let tries_without_callable_phase = antijoin(left=tries, right=try_phase_rows, left-on=["id"], right-on=["attempt"]);
let module_phase_tries = select l.id as attempt, r.phase as phase, l.file as file from tries_without_callable_phase as l join module_roots as r on l.file = r.file;
let all_try_phases = union(left=try_phase_rows, right=module_phase_tries);
let name_error_reads_with_phase = select l.attempt as attempt, l.id as id, r.phase as phase, r.file as file from name_error_candidates as l join read_rows as r on l.id = r.reference;
let same_phase_name_errors = select l.id as id from name_error_reads_with_phase as l join all_try_phases as r on l.attempt = r.attempt and l.phase = r.phase and l.file = r.file;
let without_name_error_handlers = antijoin(left=pre_suppression_candidates, right=same_phase_name_errors, left-on=["id"], right-on=["id"]);
let candidates = select * from without_name_error_handlers;
let package_init_files = select path as file from "filesystem.file" where path = "__init__.py" or ends_with(path, "/__init__.py");
let package_path_reads = select l.reference as id, l.file as file from "binding-read" as l join package_init_files as r on l.file = r.file where l.name = "__path__" and l.state = "unbound" and l.context = "value";
let report_candidates = antijoin(left=candidates, right=package_path_reads, left-on=["id", "file"], right-on=["id", "file"]);
let unresolved_reads = select id, name, scope, phase, file from ordinary_missing;
let deferred_known = deferred_resolutions(missing=unresolved_reads);
let final_candidates = antijoin(left=report_candidates, right=deferred_known, left-on=["id", "file"], right-on=["id", "file"]);
let reportable = select id, file, span from final_candidates;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F821(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F821)(?:,|$)");
emit violations subject file key(id);
