import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let classes = select id from "semantic-syntax" where kind = "class-def";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let class_arguments = select l.parent as owner, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let class_argument_nodes = select r.id as id from classes as l join class_arguments as r on l.id = r.owner;
let arguments = select parent, child from "semantic-child" where field = "bases";
let bases = select r.child as id from class_argument_nodes as l join arguments as r on l.id = r.parent;
let objects = select id from qualified_names where path = "builtins.object" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let invalid = select l.id as id from bases as l join objects as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP004(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP004)(?:,|$)");
emit violations subject file key(id);
