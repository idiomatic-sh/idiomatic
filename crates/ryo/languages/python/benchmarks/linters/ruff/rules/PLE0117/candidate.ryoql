import suppress from "python/ruff/suppress";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let nonlocals = select occurrence as id, name, file, scope from events where kind = "nonlocal";
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_nonlocals = select l.id as id, l.file as file from nonlocals as l join modules as r on l.scope = r.id and l.file = r.file;
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let outer_function_nonlocals = select l.id as id, l.file as file, l.scope as scope, l.name as name from nonlocals as l join functions as f on l.scope = f.id and l.file = f.file;
let function_declarations = select name, scope, file from events where kind = "bind" or kind = "annotation";
let bound_outer_nonlocals = select l.id as id, l.file as file, l.scope as scope from outer_function_nonlocals as l join function_declarations as r on l.name = r.name and l.scope = r.scope and l.file = r.file;
let unbound_function_nonlocals = antijoin(left=outer_function_nonlocals, right=bound_outer_nonlocals, left-on=["id","file","scope"], right-on=["id","file","scope"]);
let class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let class_scope_ancestors = axis(from=nonlocals, relation="semantic-child", direction=ancestor, domain=class_nodes);
let class_method_nonlocals = select l.id as id, l.file as file from class_scope_ancestors as l where l.name = "__class__";
let unbound_functions = select id, file from unbound_function_nonlocals;
let unbound_all = union(left=module_nonlocals, right=unbound_functions);
let unbound = antijoin(left=unbound_all, right=class_method_nonlocals, left-on=["id","file"], right-on=["id","file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from unbound as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLE0117(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLE0117)(?:,|$)");
emit violations subject file key(id);
