import observation_matches from "python/ruff/suppress-matches";
import typing_match from "python/ruff/typing-match-at-visit";
import suppress from "python/ruff/suppress";
import type_context from "python/ruff/type-definition-context";
let nodes = select id, kind, file from "semantic-syntax";
let binary_nodes = select id, file from nodes where kind = "bin-op";
let lefts = select l.id as binary, r.child as operand, l.file as file from binary_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "left";
let rights = select l.id as binary, r.child as operand, l.file as file from binary_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "right";
let left_ends = select l.binary as binary, r."end-byte" as position, l.file as file from lefts as l join "source-location" as r on l.operand = r.id and l.file = r.file;
let right_starts = select l.binary as binary, r."start-byte" as position, l.file as file from rights as l join "source-location" as r on l.operand = r.id and l.file = r.file;
let gaps = select l.binary as binary, l.position as start, r.position as end, l.file as file from left_ends as l join right_starts as r on l.binary = r.binary and l.file = r.file;
let pipes = select l.id as id, r."start-byte" as start, r."end-byte" as end, l.file as file from "semantic-syntax" as l join "source-location" as r on l.id = r.id and l.file = r.file where l.text = "|";
let pipe_nodes = select l.binary as id, l.file as file from gaps as l join pipes as r on l.file = r.file where r.start >= l.start and r.end <= l.end;
let operands = union(left=lefts, right=rights);
let pipe_members = select l.binary as owner, l.operand as member, l.file as file from operands as l join pipe_nodes as r on l.binary = r.id and l.file = r.file;
let subscript_nodes = select id, file from nodes where kind = "subscript";
let values = select l.id as id, r.child as value, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let union_inputs = select value as id,file from values;
let union_names = typing_match(expressions=union_inputs, member="Union");
let union_nodes = select l.id as id, l.file as file from values as l join union_names as r on l.value = r.id and l.file = r.file;
let union_slices = select l.id as owner, r.child as slice, l.file as file from union_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuple_nodes = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.owner as owner, l.slice as slice, l.file as file from union_slices as l join tuple_nodes as r on l.slice = r.id and l.file = r.file;
let tuple_members = select l.owner as owner, r.child as member, l.file as file from tuple_slices as l join "semantic-child" as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let member_counts = group-count(from=tuple_members, keys=["owner","file"], count="count", distinct="member");
let multiple_members = select l.owner as owner, l.member as member, l.file as file from tuple_members as l join member_counts as r on l.owner = r.owner and l.file = r.file where r.count > 1;
let members = union(left=pipe_members, right=multiple_members);
let owners = select owner as id, file from members;
let visited = type_context(expressions=owners);
let visited_members = select l.owner as owner, l.member as member, l.file as file from members as l join visited as r on l.owner = r.id and l.file = r.file;
let typing_inputs = select member as id,file from visited_members;
let never_members = typing_match(expressions=typing_inputs, member="Never");
let noreturn_members = typing_match(expressions=typing_inputs, member="NoReturn");
let never_names = union(left=never_members, right=noreturn_members);
let candidates = select l.member as id, l.file as file from visited_members as l join never_names as r on l.member = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, r.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF020(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF020)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])RUF020(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:RUF020)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF020"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
