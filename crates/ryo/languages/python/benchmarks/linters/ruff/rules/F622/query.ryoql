import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let containers = select id, file, span from "semantic-syntax" where kind = "tuple" or kind = "list";
let starred = select id from "semantic-syntax" where kind = "starred";
let elements = select parent, child from "semantic-child" where field = "elts";
let star_elements = select l.parent as parent, l.child as child from elements as l join starred as r on l.child = r.id;
let counts = group-count(from=star_elements, keys=["parent"], count="count", distinct="child");
let duplicate = select parent from counts where count > 1;
let stores = select id from "semantic-syntax" where kind = "assign" or kind = "for" or kind = "async-for" or kind = "comprehension" or kind = "withitem";
let target_fields = select parent, child from "semantic-child" where field = "targets" or field = "target" or field = "optional-vars";
let roots = select r.child as id from stores as l join target_fields as r on l.id = r.parent;
let container_edges = select r.parent as parent, r.child as child from containers as l join elements as r on l.id = r.parent;
let values = select parent, child from "semantic-child" where field = "value";
let star_edges = select r.parent as parent, r.child as child from starred as l join values as r on l.id = r.parent;
let edges = union(left=container_edges, right=star_edges);
let descendants = closure(edges=edges, source="parent", destination="child");
let nested = select r.child as id from roots as l join descendants as r on l.id = r.parent;
let stored = union(left=roots, right=nested);
let invalid = select l.id as id from stored as l join duplicate as r on l.id = r.parent;
let reportable = select l.id as id, l.file as file, l.span as span from containers as l join invalid as r on l.id = r.id;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F622)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F622"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
