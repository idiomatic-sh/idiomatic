import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let scopes = select id from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let later = select l.child as child from bodies as l join bodies as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first = antijoin(left=bodies, right=later, left-on=["child"], right-on=["child"]);
let first_in_scope = select r.child as child from scopes as l join first as r on l.id = r.parent;
let statements = select id from "semantic-syntax" where kind = "expr";
let candidates = select r.id as id from first_in_scope as l join statements as r on l.child = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let first_values = select r.child as child from candidates as l join values as r on l.id = r.parent;
let constants = select id, file, span from "semantic-syntax" where kind = "constant";
let string_parts = select id, text from "semantic-syntax" where kind = "string-part";
let empty_tokens = select id from "semantic-syntax" where kind = "string" and matches(text, "(?is)^[ru]?(?:\x22\x22\x22\s*\x22\x22\x22|'\x27'\s*'\x27'|\x22\s*\x22|'\s*')$");
let empty_parts = select l.parent as id from "semantic-child" as l join empty_tokens as r on l.child = r.id;
let parts = select l.parent as parent, l.child as child from "semantic-child" as l join string_parts as r on l.child = r.id;
let empty = select l.parent as occurrence from parts as l join empty_parts as r on l.child = r.id;
let empty_strings = select l.id as id, l.file as file, l.span as span from constants as l join empty as r on l.id = r.occurrence;
let empty_docstrings = select r.id as id, r.file as file, r.span as span from first_values as l join empty_strings as r on l.child = r.id;
let part_counts = group-count(from=parts, keys=["parent"], count="count", distinct="child");
let single_parts = select parent from part_counts where count = 1;
let reportable = select l.id as id, l.file as file, l.span as span from empty_docstrings as l join single_parts as r on l.id = r.parent;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:D419)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "D419"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
