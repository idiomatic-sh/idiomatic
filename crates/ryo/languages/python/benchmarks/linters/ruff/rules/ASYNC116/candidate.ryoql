import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.id as call, r.child as function, l.file as file from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let origins = select id, path, file from "qualified-name" where provenance = "import" and (path = "trio.sleep" or path = "anyio.sleep");
let sleep_calls = select l.call as call, r.path as path, l.file as file from call_functions as l join origins as r on l.function = r.id and l.file = r.file;
let wrappers = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrapper_edges = select l.call as call, l.path as path, r.child as wrapper, l.file as file from sleep_calls as l join "semantic-child" as r on l.call = r.parent and l.file = r.file;
let call_wrappers = select l.call as call, l.path as path, l.wrapper as wrapper, l.file as file from wrapper_edges as l join wrappers as r on l.wrapper = r.id and l.file = r.file;
let positions = select parent, child, file from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as id, l.file as file from call_wrappers as l join positions as r on l.wrapper = r.parent and l.file = r.file;
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let keywords = select l.call as call, l.path as path, r.child as keyword, l.file as file from call_wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_ids = select call, keyword as id, file from keywords;
let all_arguments = union(left=positional, right=keyword_ids);
let arities = group-count(from=all_arguments, keys=["call", "file"], count="count", distinct="id");
let single = select call, file from arities where count = 1;
let keyword_names = select l.call as call, l.path as path, l.keyword as keyword, r.child as label, l.file as file from keywords as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "arg";
let proper_names = select l.call as call, l.keyword as keyword, l.file as file from keyword_names as l join "identifier" as r on l.label = r.id and l.file = r.file where (l.path = "trio.sleep" and r.name = "seconds") or (l.path = "anyio.sleep" and r.name = "delay");
let named_values = select l.call as call, r.child as id, l.file as file from proper_names as l join "semantic-child" as r on l.keyword = r.parent and l.file = r.file where r.field = "value";
let values = union(left=positional, right=named_values);
let single_values = select l.call as call, l.id as id, l.file as file from values as l join single as r on l.call = r.call and l.file = r.file;
let at_least_day = select id, file from "numeric-literal" where numeric_gte(value, 86400);
let at_most_day = select id, file from "numeric-literal" where numeric_gte(86400, value);
let above_day = antijoin(left=at_least_day, right=at_most_day, left-on=["id", "file"], right-on=["id", "file"]);
let long_calls = select l.call as id, l.file as file from single_values as l join above_day as r on l.id = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from long_calls as l join calls as r on l.id = r.id and l.file = r.file;
let candidates = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="ASYNC116($|[, #])", range-pattern="(?:^|,)ASYNC116(?:,|$)");
emit violations subject file key(id);
