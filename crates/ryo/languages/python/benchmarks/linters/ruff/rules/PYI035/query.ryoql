import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let assignments = select id, file, span from "semantic-syntax" where kind = "ann-assign" and matches(file, "\.pyi$");
let values = select parent from "semantic-child" where field = "value";
let unassigned = antijoin(left=assignments, right=values, left-on=["id"], right-on=["parent"]);
let targets = select parent, child from "semantic-child" where field = "target";
let names = select id from "semantic-syntax" where kind = "name";
let name_fields = select parent, child from "semantic-child" where field = "id";
let tokens = select id, text from semantic_identifiers;
let named = select l.parent as id, r.text as name from name_fields as l join tokens as r on l.child = r.id;
let named_targets = select l.parent as id, r.name as name from targets as l join named as r on l.child = r.id;
let candidates = select l.id as id, l.file as file, l.span as span, r.name as name from unassigned as l join named_targets as r on l.id = r.id;
let scopes = select id, kind from "semantic-syntax" where kind = "module" or kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let owners = axis(from=candidates, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let scoped = select l.id as id, l.file as file, l.span as span, l.name as name, r.kind as kind from owners as l join scopes as r on l.related = r.id;
let reportable = select id, file, span from scoped where kind = "module" and name = "__all__" or kind = "class-def" and name = "__slots__" or kind = "class-def" and name = "__match_args__";
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI035(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI035)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI035(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI035)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI035"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
