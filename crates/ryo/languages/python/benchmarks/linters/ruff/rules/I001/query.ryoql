import observation_matches from "python/ruff/suppress-unmapped-matches";
let import_sites = select id,field,span,"run-first" as run_head,"run-span" as run_span,file from "import-head";
let import_nodes = select id,file,span from import_sites;
let after_import = select parent,id as source,"next" as destination, "next-kind" as destination_kind, kind as source_kind,gap as interval,"gap-text" as gap_text,file from "import-head" as site where field="body" and site."has-next"=1;
let before_import = select parent,"previous" as source,id as destination,kind as destination_kind,"previous-kind" as source_kind,"previous-gap" as interval,"previous-gap-text" as gap_text,file from "import-head" as site where field="body" and site."has-previous"=1 and site."previous-kind"!="import" and site."previous-kind"!="import-from";
let ordered = union(left=after_import,right=before_import);
let locations = select id, file, "start-byte" as start_byte, "end-byte" as end_byte from "source-location";
let comments = select id, file, text from "comment";
let isort_comments = select id, file, text from comments where matches(text, "isort");
let skip_file_comments = select file from isort_comments where matches(text, "^ (?:ruff: )?isort: ?skip_file[ \t]*$");
let off_comments = select id, file from isort_comments where matches(text, "^ (?:ruff: )?isort: off[ \t]*$");
let on_comments = select id, file from isort_comments where matches(text, "^ (?:ruff: )?isort: on[ \t]*$");
let import_positions = select id,file,"statement-at" as at,"statement-end" as end_byte,"statement-start-line" as start_line,"statement-end-line" as end_line from "import-head" where count>0;
let inline_skipped = select statement as id,file from "import-line-comment" as t where t."first-line"=1 and matches(text,"isort: ?skip");
let off_positions = select l.file as file, r.start_byte as at from off_comments as l join locations as r on l.id = r.id and l.file = r.file;
let on_positions = select l.file as file, r.start_byte as at from on_comments as l join locations as r on l.id = r.id and l.file = r.file;
let after_off = select r.id as id,r.file as file,r.at as import_at,l.at as off_at from off_positions as l join import_positions as r on l.file=r.file where l.at<r.at;
let closed_off = select l.id as id, l.file as file, l.off_at as off_at from after_off as l join on_positions as r on l.file = r.file where l.off_at < r.at and r.at < l.import_at;
let active_off = antijoin(left=after_off, right=closed_off, left-on=["id","file","off_at"], right-on=["id","file","off_at"]);
let region_skipped = select id, file from active_off;
let file_skipped = select r.id as id,r.file as file from skip_file_comments as l join import_nodes as r on l.file=r.file;
let skipped0 = union(left=inline_skipped, right=region_skipped);
let skipped = union(left=skipped0, right=file_skipped);
let eligible_imports = antijoin(left=import_nodes, right=skipped, left-on=["id","file"], right-on=["id","file"]);
let pair_bounds = span-bounds(from=ordered, span="interval", start-output="first_end", end-output="last_start");
let split_comments = select id, file from isort_comments where matches(text, "^ (?:ruff: )?isort: split[ \t]*$");
let split_positions = select l.file as file, r.start_byte as start_byte from split_comments as l join locations as r on l.id = r.id and l.file = r.file;
let split_cuts = select r.source as source,r.destination as destination,r.file as file from split_positions as l join pair_bounds as r on l.file=r.file where r.first_end<=l.start_byte and l.start_byte<r.last_start;
let direct_pairs = select id as source,"next" as destination,"gap-text" as gap_text,file from "import-head" as t where field="body" and t."next-kind" in ["import","import-from"];
let skipped_source_edges = select r.source as source,r.destination as destination,r.file as file from skipped as l join direct_pairs as r on l.id=r.source and l.file=r.file;
let skipped_destination_edges = select r.source as source,r.destination as destination,r.file as file from skipped as l join direct_pairs as r on l.id=r.destination and l.file=r.file;
let skipped_edges = union(left=skipped_source_edges,right=skipped_destination_edges);
let excluded_edges = union(left=split_cuts,right=skipped_edges);
let import_edges = antijoin(left=direct_pairs,right=excluded_edges,left-on=[source,destination,file],right-on=[source,destination,file]);
let affected_files = group-count(from=isort_comments,keys=[file],count="markers");
let special_imports = select r.id as id,r.file as file,r.span as span from affected_files as l join eligible_imports as r on l.file=r.file;
let affected_edges = select r.source as source,r.destination as destination,r.file as file from affected_files as l join import_edges as r on l.file=r.file;
let incoming = select destination as id, file from affected_edges;
let outgoing = select source as id, file from affected_edges;
let starts = antijoin(left=special_imports, right=incoming, left-on=["id","file"], right-on=["id","file"]);
let ends = antijoin(left=special_imports, right=outgoing, left-on=["id","file"], right-on=["id","file"]);
let paths = closure(edges=affected_edges,source="source",destination="destination",keys=[file]);
let from_starts = select l.id as first, l.span as first_span, r.destination as last, l.file as file from starts as l join paths as r on l.id = r.source and l.file = r.file;
let maximal = select l.first as first, l.first_span as first_span, r.span as last_span, l.file as file from from_starts as l join ends as r on l.last = r.id and l.file = r.file;
let block_spans = span-between(from=maximal, start="first_span", end="last_span", output="span");
let multi_blocks = select first as id, file, span from block_spans;
let touched = union(left=incoming, right=outgoing);
let singleton_nodes = antijoin(left=special_imports, right=touched, left-on=["id","file"], right-on=["id","file"]);
let single_blocks = select id, file, span from singleton_nodes;
let special_singles = select id,span,file from single_blocks;
let adjusted_blocks = union(left=multi_blocks,right=special_singles);
let special_bounds = span-bounds(from=adjusted_blocks,span="span",start-output="begin",end-output="finish");
let special_membership = select l.id as block,l.span as span,l.file as file,r.id as statement from special_bounds as l join import_positions as r on l.file=r.file where l.begin<=r.at and r.at<l.finish;
let usual_membership = select run_head as block,run_span as span,file,id as statement from import_sites where field="body";
let singleton_membership = select id as block,span,file,id as statement from import_sites where field!="body";
let syntax_membership = union(left=usual_membership,right=singleton_membership);
let ordinary_membership = antijoin(left=syntax_membership,right=affected_files,left-on=[file],right-on=[file]);
let statement_blocks = union(left=ordinary_membership,right=special_membership);
let alias_locations = select id, file, "start-byte" as at, "start-line" as start_line, "end-line" as end_line from "source-location";
let unparenthesized_texts = select id as statement,file,span as statement_span,"statement-text" as spelling_text from "import-head" as a where count>0 and kind="import-from" and a."written-name"!="*" and not matches(a."statement-text","(?s)^from[[:blank:]]*.*import[[:blank:]]*[(]");
let fitting_texts = fits-rendered(from=unparenthesized_texts, texts=["spelling_text"], literals=["", ""], span="statement_span", max-line=88, tab-width=4);
let overflowing_texts = antijoin(left=unparenthesized_texts, right=fitting_texts, left-on=["file","statement"], right-on=["file","statement"]);
let import_comment_prefixes = select statement,file,prefix from "import-line-comment";
let import_comment_gaps = source-matches(from=import_comment_prefixes, span="prefix", pattern="(?s)(?:^|[\r\n])[^\r\n]*\S(?P<gap>[ \t]*)\z", output="gap_match", capture="gap", capture-output="gap_span", capture-text-output="gap_text");
let badly_spaced_comments = select statement, file from import_comment_gaps where gap_text != "  ";
let imports_with_comments = select l.file as file,r.statement as statement,r.statement_span as statement_span,r.spelling_text as spelling_text,l.text as comment_text from "import-line-comment" as l join unparenthesized_texts as r on l.statement=r.statement and l.file=r.file where l.following=1;
let fitting_comments = fits-rendered(from=imports_with_comments, texts=["spelling_text", "comment_text"], literals=["", "  #", ""], span="statement_span", max-line=88, tab-width=4);
let overflowing_comments = antijoin(left=imports_with_comments, right=fitting_comments, left-on=["file","statement"], right-on=["file","statement"]);
let context = select id as statement,kind as form,root,"written-root" as written_root,level,catalog,"source-module-prefix" as module_prefix,"source-package-prefix" as package_prefix,"module-namespace" as module_namespace,"package-root" as package_root,"head-at" as at,"written-module" as module,"written-name" as name,"written-rename" as rename,dots,"run-first" as run_head,"run-span" as run_span,span as statement_span,file from "import-head" as t where count>0 and field="body" and t."run-span"!=span;
let future_choice = select statement,form,at,module,name,rename,dots,run_head,run_span,statement_span,file,0 as section from context where form="import-from" and root="__future__" and written_root=root;
let stdlib_choice = select statement,form,at,module,name,rename,dots,run_head,run_span,statement_span,file,1 as section from context where level=0 and root!="" and written_root=root and (form!="import-from" or root!="__future__") and catalog="standard";
let first_party_choice = select statement,form,at,module,name,rename,dots,run_head,run_span,statement_span,file,3 as section from context where level=0 and root!="" and written_root=root and (form!="import-from" or root!="__future__") and catalog!="standard" and (module_prefix!="" or package_prefix!="" or module_namespace=1 or package_root=root);
let relative_choice = select statement,form,at,module,name,rename,dots,run_head,run_span,statement_span,file,4 as section from context where level>0;
let external_choice = select statement,form,at,module,name,rename,dots,run_head,run_span,statement_span,file,2 as section from context where level=0 and (root="" or written_root!=root or ((form!="import-from" or root!="__future__") and catalog!="standard" and module_prefix="" and package_prefix="" and module_namespace=0 and package_root!=root));
let section_choices0 = union(left=future_choice, right=stdlib_choice);
let section_choices1 = union(left=section_choices0, right=first_party_choice);
let section_choices2 = union(left=section_choices1, right=relative_choice);
let section_choices = union(left=section_choices2, right=external_choice);
let physical_heads = select run_head as block,run_span as span,statement,file,at,form,module,name,rename,dots,section from section_choices;
let normal_heads = antijoin(left=physical_heads,right=affected_files,left-on=[file],right-on=[file]);
let marked_heads = select l.block as block,l.span as span,r.statement as statement,r.file as file,r.at as at,r.form as form,r.module as module,r.name as name,r.rename as rename,r.dots as dots,r.section as section from special_membership as l join section_choices as r on l.statement=r.statement and l.file=r.file where l.span!=r.statement_span;
let classified = union(left=normal_heads,right=marked_heads);
let pair_source_sections = select l.destination as destination,l.gap_text as gap_text,l.file as file,r.block as block,r.span as block_span,r.section as source_section,r.form as source_form,r.dots as source_dots,r.module as source_module from import_edges as l join classified as r on l.source=r.statement and l.file=r.file;
let pair_sections = select l.gap_text as gap_text, l.file as file, l.block as block, l.block_span as block_span, l.source_section as source_section,l.source_form as source_form,l.source_dots as source_dots,l.source_module as source_module,r.section as destination_section,r.form as destination_form,r.dots as destination_dots,r.module as destination_module from pair_source_sections as l join classified as r on l.destination=r.statement and l.file=r.file;
let primary_disorder = select block,block_span as span,file from pair_sections where (source_section>destination_section or (source_section=destination_section and (source_form>destination_form or (source_form=destination_form and (source_dots<destination_dots or (source_dots=destination_dots and matches(source_module,"^[a-z_.]+$") and matches(destination_module,"^[a-z_.]+$") and source_module>destination_module)))))) or ((source_section=destination_section and not matches(gap_text,"(?:^[ \t]*(?:#[^\r\n]*)?\r?\n[ \t]*$)|(?:^[ \t]*(?:#[^\r\n]*)?\r?\n[ \t]*\r?\n(?:[ \t]*#[^\r\n]*\r?\n)+[ \t]*$)")) or (source_section!=destination_section and not matches(gap_text,"^[ \t]*(?:#[^\r\n]*)?\r?\n[ \t]*\r?\n(?:[ \t]*#[^\r\n]*\r?\n)*[ \t]*$")));
let unchecked_members = antijoin(left=statement_blocks,right=primary_disorder,left-on=[block,file],right-on=[block,file]);
let from_keys = select id as statement,file,1 as family,"written-module" as value from "import-head" as t where count>0 and field="body" and t."run-span"!=span and kind="import-from" and t."written-name"!="*" and renames=0;
let literal_keys = select id as statement,file,0 as family,"statement-text" as value from "import-head" as t where count>0 and field="body" and t."run-span"!=span and (kind!="import-from" or t."written-name"="*" or renames>0);
let duplicate_keys = union(left=from_keys,right=literal_keys);
let block_keys = select l.block as block,l.span as span,l.statement as statement,l.file as file,r.family as family,r.value as value from unchecked_members as l join duplicate_keys as r on l.statement=r.statement and l.file=r.file;
let duplicate_counts = group-count(from=block_keys,keys=[block,span,file,family,value],count="count",distinct=statement);
let repeated_reports = select block,span,file from duplicate_counts where count>1;
let unresolved_pairs = select block,file from pair_sections where source_section=destination_section and source_form=destination_form and source_dots=destination_dots and (source_module=destination_module or not (matches(source_module,"^[a-z_.]+$") and matches(destination_module,"^[a-z_.]+$")));
let headless = antijoin(left=import_nodes,right=import_positions,left-on=[id,file],right-on=[id,file]);
let headless_blocks = select r.block as block,r.file as file from headless as l join statement_blocks as r on l.id=r.statement and l.file=r.file;
let tied_rows = union(left=unresolved_pairs,right=headless_blocks);
let undiagnosed_ties = antijoin(left=tied_rows,right=primary_disorder,left-on=[block,file],right-on=[block,file]);
let ties = group-count(from=undiagnosed_ties,keys=[block,file],count="pairs");
let tied_heads = select r.block as block,r.span as span,r.statement as statement,r.file as file,r.at as at,r.section as section,r.form as form,r.dots as dots,r.module as module,r.name as name,r.rename as rename from ties as l join classified as r on l.block=r.block and l.file=r.file;
let head_names = select statement,file,0 as member,at,form,name,rename from tied_heads;
let member_names = select statement,file,1 as member,at,form,"written-name" as name,"written-rename" as rename from "import-alias-parts" where form="import-from" and count>1;
let name_rows = union(left=member_names,right=head_names);
let star_rank = select statement,file,member,at,name,rename,0 as rank from name_rows where form="import-from" and name="*";
let constant_rank = select statement,file,member,at,name,rename,1 as rank from name_rows where form="import" or (form="import-from" and matches(name, "^(?:[^\p{Lowercase}\p{Lt}]*\p{Uppercase}[^\p{Lowercase}\p{Lt}]+|[^\p{Lowercase}\p{Lt}]+\p{Uppercase}[^\p{Lowercase}\p{Lt}]*)$"));
let class_rank = select statement,file,member,at,name,rename,2 as rank from name_rows where form="import-from" and matches(name,"^\p{Uppercase}") and not matches(name, "^(?:[^\p{Lowercase}\p{Lt}]*\p{Uppercase}[^\p{Lowercase}\p{Lt}]+|[^\p{Lowercase}\p{Lt}]+\p{Uppercase}[^\p{Lowercase}\p{Lt}]*)$");
let variable_rank = select statement,file,member,at,name,rename,3 as rank from name_rows where form="import-from" and name!="*" and not matches(name,"^\p{Uppercase}") and not matches(name, "^(?:[^\p{Lowercase}\p{Lt}]*\p{Uppercase}[^\p{Lowercase}\p{Lt}]+|[^\p{Lowercase}\p{Lt}]+\p{Uppercase}[^\p{Lowercase}\p{Lt}]*)$");
let rank_candidates0 = union(left=star_rank, right=constant_rank);
let rank_candidates1 = union(left=rank_candidates0, right=class_rank);
let rank_candidates = union(left=rank_candidates1,right=variable_rank);
let mult_from = select statement,file,at,name,rename,rank from rank_candidates where member=1;
let head_ranks = select statement,file,rank from rank_candidates where member=0;
let head_list = select l.block as block,l.span as span,l.statement as statement,l.file as file,l.at as at,l.section as section,l.form as form,l.dots as dots,l.module as module,r.rank as rank,l.name as name,l.rename as rename from tied_heads as l join head_ranks as r on l.statement=r.statement and l.file=r.file;
let head_order = order(from=head_list,keys=[block,file],by=[[section,"number"],[form,"text"],[dots,"text","desc"],[module,"natural-folded"],[rank,"number"],[name,"natural-folded"],[rename,"natural-folded"]],position="at",rank="sort_rank",step="sort_step");
let member_order = order(from=mult_from,keys=[statement,file],by=[[rank,"number"],[name,"natural-folded"],[rename,"natural-folded"]],position="at",rank="sort_rank",step="sort_step");
let head_disorder = select block,span,file from head_order where sort_step=0;
let member_disorder = select statement,file from member_order where sort_step=0;
let problems = union(left=primary_disorder,right=head_disorder);
let odd_initial_space = select id as block,span,file from "import-head" as t where matches(t."statement-text","^(?:import|from)[ \t]{2,}");
let spacing_rows = antijoin(left=odd_initial_space,right=skipped,left-on=[block,file],right-on=[id,file]);
let split_lines = select l.id as id, l.file as file, r.at as at, r.start_line as comment_line from split_comments as l join alias_locations as r on l.id = r.id and l.file = r.file;
let split_pair_lines = select l.source as source, l.destination as destination, l.file as file, r.comment_line as comment_line from pair_bounds as l join split_lines as r on l.file = r.file where l.first_end <= r.at and r.at < l.last_start;
let split_previous = select l.source as source, l.file as file, l.comment_line as comment_line, r.end_line as import_end from split_pair_lines as l join alias_locations as r on l.source = r.id and l.file = r.file;
let split_bad_lines = select source, file from split_previous where integer_successor(import_end, comment_line);
let split_spacing = select l.source as block, r.span as span, l.file as file from split_bad_lines as l join eligible_imports as r on l.source = r.id and l.file = r.file;
let module_trailers = select id as source,"next" as destination,"next-kind" as destination_kind,"gap-text" as gap_text,file from "import-head" as t where field="body" and t."parent-kind"="module" and t."has-next"=1 and t."next-kind"!="import" and t."next-kind"!="import-from";
let trailer_candidates = select source,destination,file from module_trailers where ((not (destination_kind in ["function-def","async-function-def","class-def"]) or ends_with(file,".pyi")) and matches(gap_text,"^(?:(?:\r?\n)(?:$|[ \t]*#)|(?:\r?\n){3,}(?:$|[ \t]*#))")) or ((destination_kind in ["function-def","async-function-def","class-def"]) and not ends_with(file,".pyi") and matches(gap_text,"^(?:(?:\r?\n)(?:$|[ \t]*#)|(?:\r?\n){2}(?:$|#[^\r\n]*\r?\n$)|(?:\r?\n){4,}$|(?:\r?\n){3,}[ \t]*#)") and not matches(gap_text,"^(?:\r?\n){3}(?:[ \t]*#[^\r\n]*\r?\n)+$"));
let unsplit_trailers = antijoin(left=trailer_candidates,right=split_cuts,left-on=[source,destination,file],right-on=[source,destination,file]);
let bad_trailers = antijoin(left=unsplit_trailers,right=skipped,left-on=[source,file],right-on=[id,file]);
let continuation_sources = select id as destination,"previous" as source,file,span,"previous-gap" as before from "import-head" as t where field="body" and t."has-previous"=1 and t."previous-kind"!="import" and t."previous-kind"!="import-from" and (matches(t."previous-gap-text",";") or matches(t."statement-text",";"));
let prefix_intervals = span-between(from=continuation_sources,start="before",end="span",output="interval");
let continued_imports = source-matches(from=prefix_intervals, span="interval", pattern=";[ \t]*\x5c[ \t]*\r?\n[ \t]*(?:import|from)", output="continuation");
let kept_continuations = antijoin(left=continued_imports,right=split_cuts,left-on=[source,destination,file],right-on=[source,destination,file]);
let continuation_rows = select destination as block,span,file from kept_continuations;
let continuation_spacing = antijoin(left=continuation_rows,right=skipped,left-on=[block,file],right-on=[id,file]);
let member_issue_0 = select statement,file from "import-alias-parts" as a where ((index=0 and count>1 and (form="import" or renames>0)) or (matches(a."alias-text","(?m)\r?\n[ \t]*as[ \t]")) or (form="import-from" and matches(a."statement-text","(?s)^from[[:blank:]]*.*import[[:blank:]]*[(]") and ((a."previous-start-line"=a."start-line" or a."start-line"=a."statement-start-line" or a."end-line"=a."statement-end-line") or (index=0 and not matches(a."statement-text","(?m)(?:^|[\r\n])[^#\r\n]*,[ \t]*(?:#[^\r\n]*)?(?:\r?\n[ \t]*(?:#[^\r\n]*\r?\n[ \t]*)*)?[)]"))))) or (index=0 and (matches(a."statement-text","(?m)^[^#\r\n]*\x5c[ \t]*\r?\n") or (form="import-from" and dots!="" and matches(module,"[^.]") and (matches(a."statement-text","^from[.]") or matches(a."statement-text","^from[ \t]+[.]+[ \t]+")))));
let member_issue_6 = select source as statement,file from bad_trailers;
let member_issues_2 = union(left=member_issue_0,right=badly_spaced_comments);
let member_issues_5 = union(left=member_issues_2,right=member_issue_6);
let member_issues = union(left=member_issues_5,right=member_disorder);
let width_issues = select statement,file from overflowing_texts;
let width_comment_issues = select statement,file from overflowing_comments;
let all_width_issues = union(left=width_issues,right=width_comment_issues);
let member_and_width = union(left=member_issues,right=all_width_issues);
let mapped_members = select l.block as block,l.span as span,l.file as file from unchecked_members as l join member_and_width as r on l.statement=r.statement and l.file=r.file;
let visible_candidates_0 = union(left=problems,right=spacing_rows);
let visible_candidates_1 = union(left=visible_candidates_0,right=split_spacing);
let visible_candidates_2 = union(left=visible_candidates_1,right=continuation_spacing);
let visible_candidates_3 = union(left=visible_candidates_2,right=mapped_members);
let problems9 = union(left=visible_candidates_3,right=repeated_reports);
let ruf100_candidate_locations = select l.block as id, l.file as file, l.span as span, r."start-line" as line from problems9 as l join "source-location" as r on l.block = r.id and l.file = r.file;
let ruf100_matches = observation_matches(candidates=ruf100_candidate_locations, code="I001");
let ruf100_used = select directive,file,concat("","I001") as code from ruf100_matches where scope<2;
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=problems9, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(span);
