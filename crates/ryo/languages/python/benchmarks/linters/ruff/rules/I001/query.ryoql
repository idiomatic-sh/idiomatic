import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
let syntax = select id, kind, file, span from "semantic-syntax";
let import_nodes = select id, file, span from syntax where kind = "import" or kind = "import-from";
let body = select parent, child, ordinal, file from "semantic-child" where field = "body";
let ordered = select l.parent as parent, l.child as source, r.child as destination, l.ordinal as first_ordinal, r.ordinal as last_ordinal, l.file as file from body as l join body as r on l.parent = r.parent and l.file = r.file where l.ordinal < r.ordinal;
let intervening = select l.source as source, l.destination as destination, l.file as file from ordered as l join body as r on l.parent = r.parent and l.file = r.file where l.first_ordinal < r.ordinal and r.ordinal < l.last_ordinal;
let locations = select id, file, "start-byte" as start_byte, "end-byte" as end_byte from "source-location";
let line_locations = select id, file, "start-byte" as start_byte, "end-byte" as end_byte, "start-line" as start_line, "end-line" as end_line from "source-location";
let comments = select id, file, text from "comment";
let skip_file_comments = select file from comments where matches(text, "^ (?:ruff: )?isort: ?skip_file[ \t]*$");
let skip_line_comments = select id, file from comments where matches(text, "isort: ?skip");
let off_comments = select id, file from comments where matches(text, "^ (?:ruff: )?isort: off[ \t]*$");
let on_comments = select id, file from comments where matches(text, "^ (?:ruff: )?isort: on[ \t]*$");
let import_positions = select l.id as id, l.file as file, r.start_byte as at, r.end_byte as end_byte, r.start_line as start_line, r.end_line as end_line from import_nodes as l join line_locations as r on l.id = r.id and l.file = r.file;
let skip_positions = select l.file as file, r.start_byte as at, r.start_line as start_line from skip_line_comments as l join line_locations as r on l.id = r.id and l.file = r.file;
let inline_skipped = select l.id as id, l.file as file from import_positions as l join skip_positions as r on l.file = r.file where l.start_line = r.start_line and l.at < r.at;
let off_positions = select l.file as file, r.start_byte as at from off_comments as l join locations as r on l.id = r.id and l.file = r.file;
let on_positions = select l.file as file, r.start_byte as at from on_comments as l join locations as r on l.id = r.id and l.file = r.file;
let after_off = select l.id as id, l.file as file, l.at as import_at, r.at as off_at from import_positions as l join off_positions as r on l.file = r.file where r.at < l.at;
let closed_off = select l.id as id, l.file as file, l.off_at as off_at from after_off as l join on_positions as r on l.file = r.file where l.off_at < r.at and r.at < l.import_at;
let active_off = antijoin(left=after_off, right=closed_off, left-on=["id","file","off_at"], right-on=["id","file","off_at"]);
let region_skipped = select id, file from active_off;
let file_skipped = select l.id as id, l.file as file from import_nodes as l join skip_file_comments as r on l.file = r.file;
let skipped0 = union(left=inline_skipped, right=region_skipped);
let skipped = union(left=skipped0, right=file_skipped);
let eligible_imports = antijoin(left=import_nodes, right=skipped, left-on=["id","file"], right-on=["id","file"]);
let first_ends = select l.source as source, l.destination as destination, r.end_byte as first_end, l.file as file from ordered as l join locations as r on l.source = r.id and l.file = r.file;
let pair_bounds = select l.source as source, l.destination as destination, l.first_end as first_end, r.start_byte as last_start, l.file as file from first_ends as l join locations as r on l.destination = r.id and l.file = r.file;
let split_comments = select id, file from "comment" where matches(text, "^ (?:ruff: )?isort: split[ \t]*$");
let split_positions = select l.file as file, r.start_byte as start_byte from split_comments as l join locations as r on l.id = r.id and l.file = r.file;
let split_cuts = select l.source as source, l.destination as destination, l.file as file from pair_bounds as l join split_positions as r on l.file = r.file where l.first_end <= r.start_byte and r.start_byte < l.last_start;
let cuts = union(left=intervening, right=split_cuts);
let adjacent = antijoin(left=ordered, right=cuts, left-on=["source","destination","file"], right-on=["source","destination","file"]);
let first_imports = select l.source as source, l.destination as destination, l.file as file from adjacent as l join eligible_imports as r on l.source = r.id and l.file = r.file;
let import_edges = select l.source as source, l.destination as destination, l.file as file from first_imports as l join eligible_imports as r on l.destination = r.id and l.file = r.file;
let incoming = select destination as id, file from import_edges;
let outgoing = select source as id, file from import_edges;
let starts = antijoin(left=eligible_imports, right=incoming, left-on=["id","file"], right-on=["id","file"]);
let ends = antijoin(left=eligible_imports, right=outgoing, left-on=["id","file"], right-on=["id","file"]);
let paths = closure(edges=import_edges, source="source", destination="destination", keys=["file"]);
let from_starts = select l.id as first, l.span as first_span, r.destination as last, l.file as file from starts as l join paths as r on l.id = r.source and l.file = r.file;
let maximal = select l.first as first, l.first_span as first_span, r.span as last_span, l.file as file from from_starts as l join ends as r on l.last = r.id and l.file = r.file;
let block_spans = span-between(from=maximal, start="first_span", end="last_span", output="span");
let multi_blocks = select first as id, file, span from block_spans;
let touched = union(left=incoming, right=outgoing);
let singleton_nodes = antijoin(left=eligible_imports, right=touched, left-on=["id","file"], right-on=["id","file"]);
let single_blocks = select id, file, span from singleton_nodes;
let blocks = union(left=multi_blocks, right=single_blocks);
let block_bounds = span-bounds(from=blocks, span="span", start-output="begin", end-output="finish");
let alias_locations = select id, file, "start-byte" as at, "start-line" as start_line, "end-line" as end_line from "source-location";
let imports = select occurrence as alias, target, file, span from "static-import";
let imports_at = select l.alias as alias, l.target as target, l.file as file, r.at as at, r.start_line as start_line, r.end_line as end_line from imports as l join alias_locations as r on l.alias = r.id and l.file = r.file;
let import_aliases = select parent as statement, child as alias, file from "semantic-child" where field = "names";
let ordered_aliases = select l.statement as statement, l.alias as alias, l.file as file, r.at as at from import_aliases as l join alias_locations as r on l.alias = r.id and l.file = r.file;
let later_aliases = select r.alias as alias, r.file as file from ordered_aliases as l join ordered_aliases as r on l.statement = r.statement and l.file = r.file where l.at < r.at;
let first_aliases = antijoin(left=import_aliases, right=later_aliases, left-on=["alias","file"], right-on=["alias","file"]);
let alias_counts = group-count(from=import_aliases, keys=["statement","file"], count="count", distinct="alias");
let multiple_aliases = select statement, file from alias_counts where count > 1;
let from_import_nodes = select id, file, span from syntax where kind = "import-from";
let as_import_nodes = source-matches(from=from_import_nodes, span="span", pattern="[ \\t]as[ \\t]", output="as_word");
let from_split_alias_statements = select l.id as statement, l.file as file from as_import_nodes as l join multiple_aliases as r on l.id = r.statement and l.file = r.file;
let plain_import_nodes = select id, file from syntax where kind = "import";
let plain_split_alias_statements = select l.id as statement, l.file as file from plain_import_nodes as l join multiple_aliases as r on l.id = r.statement and l.file = r.file;
let split_alias_statements0 = union(left=from_split_alias_statements, right=plain_split_alias_statements);
let parenthesized_from = source-matches(from=from_import_nodes, span="span", pattern="(?s)^from[[:blank:]]*.*import[[:blank:]]*[(]", output="opening");
let trailing_commas = source-matches(from=parenthesized_from, span="span", pattern="(?m)(?:^|[\r\n])[^#\r\n]*,[ \t]*(?:#[^\r\n]*)?(?:\r?\n[ \t]*(?:#[^\r\n]*\r?\n[ \t]*)*)?[)]", output="comma");
let parenthesized_without_trailing_comma = antijoin(left=parenthesized_from, right=trailing_commas, left-on=["id","file"], right-on=["id","file"]);
let parenthesized_lines = select l.id as statement, l.file as file, r.start_line as start_line, r.end_line as end_line from parenthesized_from as l join line_locations as r on l.id = r.id and l.file = r.file;
let inline_parenthesized = select statement, file from parenthesized_lines where start_line = end_line;
let parenthesized_aliases = select l.statement as statement, l.file as file, l.start_line as opening_line, l.end_line as closing_line, r.alias as alias from parenthesized_lines as l join import_aliases as r on l.statement = r.statement and l.file = r.file;
let parenthesized_alias_lines = select l.statement as statement, l.file as file, l.opening_line as opening_line, l.closing_line as closing_line, r.start_line as alias_start_line, r.end_line as alias_end_line, r.start_byte as alias_start_byte from parenthesized_aliases as l join line_locations as r on l.alias = r.id and l.file = r.file;
let alias_on_parenthesis_line = select statement, file from parenthesized_alias_lines where alias_start_line = opening_line or alias_end_line = closing_line;
let aliases_on_same_line = select l.statement as statement, l.file as file from parenthesized_alias_lines as l join parenthesized_alias_lines as r on l.statement = r.statement and l.file = r.file where l.alias_start_line = r.alias_start_line and l.alias_start_byte < r.alias_start_byte;
let bad_parenthesized_layout = union(left=alias_on_parenthesis_line, right=aliases_on_same_line);
let alias_spans = select l.alias as id, l.statement as statement, l.file as file, r.span as alias_span from import_aliases as l join syntax as r on l.alias = r.id and l.file = r.file;
let broken_as_aliases = source-matches(from=alias_spans, span="alias_span", pattern="(?m)\r?\n[ \t]*as[ \t]", output="broken_as");
let broken_as_statements = select statement, file from broken_as_aliases;
let split_alias_statements = union(left=split_alias_statements0, right=broken_as_statements);
let spelled_aliases = source-matches(from=alias_spans, span="alias_span", pattern="(?s)^(?P<alias>.*)$", output="alias_match", capture="alias", capture-output="alias_capture", capture-text-output="alias_text");
let source_alias_names = source-matches(from=alias_spans, span="alias_span", pattern="^(?P<name>[^ \t\r\n]+)", output="name_match", capture="name", capture-output="name_span", capture-text-output="name_text");
let spelled_names = select id as alias, file, name_text as name from source_alias_names;
let renamed_aliases = source-matches(from=alias_spans, span="alias_span", pattern="[ \t]+as[ \t]+(?P<rename>[^ \t\r\n]+)$", output="rename_match", capture="rename", capture-output="rename_span", capture-text-output="rename_text");
let renamed_keys = select id as alias, file, rename_text as rename from renamed_aliases;
let unrenamed_aliases = antijoin(left=import_aliases, right=renamed_keys, left-on=["alias","file"], right-on=["alias","file"]);
let unrenamed_keys = extend(from=unrenamed_aliases, values={rename: ""});
let unrenamed_keys_rows = select alias, file, rename from unrenamed_keys;
let alias_keys = union(left=renamed_keys, right=unrenamed_keys_rows);
let star_spelled_aliases = select id as alias, file from spelled_aliases where alias_text = "*";
let star_statements = select l.statement as statement, l.file as file from import_aliases as l join star_spelled_aliases as r on l.alias = r.alias and l.file = r.file;
let without_trailing_comma = select id as statement, file from parenthesized_without_trailing_comma;
let unwrap_statements0 = union(left=without_trailing_comma, right=inline_parenthesized);
let unwrap_statements = union(left=unwrap_statements0, right=bad_parenthesized_layout);
let import_forms = select l.alias as alias, l.file as file, r.kind as form from import_aliases as l join syntax as r on l.statement = r.id and l.file = r.file where r.kind = "import" or r.kind = "import-from";
let imports_with_forms = select l.alias as alias, l.target as target, l.file as file, l.at as at, l.start_line as start_line, l.end_line as end_line, r.form as form from imports_at as l join import_forms as r on l.alias = r.alias and l.file = r.file;
let from_module_spellings = source-matches(from=from_import_nodes, span="span", pattern="^from[[:blank:]]+(?P<module>[^[:space:]]+)[[:blank:]]+import", output="module_match", capture="module", capture-output="module_span", capture-text-output="module_text");
let spelled_from_modules = select id, file, module_span, module_text from from_module_spellings;
let from_with_module_child = select parent as statement, child as module_id, file from "semantic-child" where field = "module";
let module_child_spans = select l.statement as statement, l.file as file, r.span as module_source_span from from_with_module_child as l join syntax as r on l.module_id = r.id and l.file = r.file;
let module_child_texts = source-matches(from=module_child_spans, span="module_source_span", pattern="(?s)^(?P<module>.*)$", output="module_match", capture="module", capture-output="module_span", capture-text-output="module_text");
let structural_from_modules = select statement as id, file, module_span, module_text from module_child_texts;
let unspelled_structural_modules = antijoin(left=structural_from_modules, right=spelled_from_modules, left-on=["id","file"], right-on=["id","file"]);
let from_modules0 = union(left=spelled_from_modules, right=unspelled_structural_modules);
let relative_only_spellings = source-matches(from=from_import_nodes, span="span", pattern="^from[[:blank:]]*(?P<module>[.]+)[[:blank:]]*import", output="module_match", capture="module", capture-output="module_span", capture-text-output="module_text");
let relative_only_modules = select id, file, module_span, module_text from relative_only_spellings;
let unmatched_relative_modules = antijoin(left=relative_only_modules, right=from_modules0, left-on=["id","file"], right-on=["id","file"]);
let from_modules = union(left=from_modules0, right=unmatched_relative_modules);
let from_module_keys = select l.alias as alias, l.file as file, r.module_text as module from import_aliases as l join from_modules as r on l.statement = r.id and l.file = r.file;
let relative_module_heads = source-matches(from=from_modules, span="module_span", pattern="^(?P<dots>[.]+)", output="dots_match", capture="dots", capture-output="dots_span", capture-text-output="dots_text");
let relative_module_keys = select l.alias as alias, l.file as file, r.dots_text as dots from import_aliases as l join relative_module_heads as r on l.statement = r.id and l.file = r.file;
let plain_module_keys = select l.alias as alias, l.file as file, r.name as module from imports_with_forms as l join spelled_names as r on l.alias = r.alias and l.file = r.file where l.form = "import";
let module_keys = union(left=from_module_keys, right=plain_module_keys);
let members = select l.id as block, l.span as span, l.file as file, r.alias as alias, r.target as target, r.at as at, r.start_line as start_line, r.end_line as end_line, r.form as form from block_bounds as l join imports_with_forms as r on l.file = r.file where l.begin <= r.at and r.at < l.finish;
let spelled_imports = source-matches(from=import_nodes, span="span", pattern="(?s)^(?P<spelling>.*)$", output="whole", capture="spelling", capture-output="spelling_span", capture-text-output="spelling_text");
let member_statements = select l.block as block, l.file as file, r.statement as statement from members as l join import_aliases as r on l.alias = r.alias and l.file = r.file;
let split_alias_blocks = select l.block as block, l.file as file from member_statements as l join split_alias_statements as r on l.statement = r.statement and l.file = r.file;
let split_alias_problems = select l.id as block, l.span as span, l.file as file from blocks as l join split_alias_blocks as r on l.id = r.block and l.file = r.file;
let unwrap_blocks = select l.block as block, l.file as file from member_statements as l join unwrap_statements as r on l.statement = r.statement and l.file = r.file;
let unwrap_problems = select l.id as block, l.span as span, l.file as file from blocks as l join unwrap_blocks as r on l.id = r.block and l.file = r.file;
let spelled_members = select l.block as block, l.file as file, l.statement as statement, r.spelling_text as spelling from member_statements as l join spelled_imports as r on l.statement = r.id and l.file = r.file;
let from_statements = select id as statement, file from from_import_nodes;
let from_member_statements = select l.block as block, l.file as file, l.statement as statement from member_statements as l join from_statements as r on l.statement = r.statement and l.file = r.file;
let from_statement_modules = select l.block as block, l.file as file, l.statement as statement, r.module_text as module from from_member_statements as l join from_modules as r on l.statement = r.id and l.file = r.file;
let combinable_from_statements = antijoin(left=from_statement_modules, right=as_import_nodes, left-on=["statement","file"], right-on=["id","file"]);
let from_module_counts = group-count(from=combinable_from_statements, keys=["block","file","module"], count="count", distinct="statement");
let repeated_from_modules = select block, file from from_module_counts where count > 1;
let combine_from_problems = select l.id as block, l.span as span, l.file as file from blocks as l join repeated_from_modules as r on l.id = r.block and l.file = r.file;
let member_texts = select l.block as block, l.file as file, l.statement as statement, r.span as statement_span, r.spelling_text as spelling_text from from_member_statements as l join spelled_imports as r on l.statement = r.id and l.file = r.file;
let nonstar_member_texts = antijoin(left=member_texts, right=star_statements, left-on=["statement","file"], right-on=["statement","file"]);
let unparenthesized_texts = antijoin(left=nonstar_member_texts, right=parenthesized_from, left-on=["statement","file"], right-on=["id","file"]);
let fitting_texts = fits-rendered(from=unparenthesized_texts, texts=["spelling_text"], literals=["", ""], span="statement_span", max-line=88, tab-width=4);
let overflowing_texts = antijoin(left=unparenthesized_texts, right=fitting_texts, left-on=["block","file","statement"], right-on=["block","file","statement"]);
let width_problems = select l.id as block, l.span as span, l.file as file from blocks as l join overflowing_texts as r on l.id = r.block and l.file = r.file;
let inline_comments = select l.file as file, l.text as comment_text, l.span as comment_span, r.start_line as line, r.start_byte as at from "comment" as l join line_locations as r on l.id = r.id and l.file = r.file;
let import_comment_positions = select l.id as statement, l.file as file, l.span as statement_span, r.at as statement_at, r.start_line as start_line, r.end_line as end_line from eligible_imports as l join import_positions as r on l.id = r.id and l.file = r.file;
let import_comment_pairs = select l.statement as statement, l.file as file, l.statement_span as statement_span, r.comment_span as comment_span from import_comment_positions as l join inline_comments as r on l.file = r.file where l.start_line <= r.line and r.line <= l.end_line and l.statement_at < r.at;
let import_comment_starts = source-matches(from=import_comment_pairs, span="statement_span", pattern="^", output="statement_start");
let import_comment_ends = source-matches(from=import_comment_starts, span="comment_span", pattern="^", output="comment_start");
let import_comment_prefixes = span-between(from=import_comment_ends, start="statement_start", end="comment_start", output="prefix");
let import_comment_gaps = source-matches(from=import_comment_prefixes, span="prefix", pattern="(?s)(?:^|[\r\n])[^\r\n]*\S(?P<gap>[ \t]*)\z", output="gap_match", capture="gap", capture-output="gap_span", capture-text-output="gap_text");
let badly_spaced_comments = select statement, file from import_comment_gaps where gap_text != "  ";
let comment_spacing_blocks = select l.block as block, l.file as file from member_statements as l join badly_spaced_comments as r on l.statement = r.statement and l.file = r.file;
let comment_spacing_problems = select l.id as block, l.span as span, l.file as file from blocks as l join comment_spacing_blocks as r on l.id = r.block and l.file = r.file;
let star_member_texts = select l.block as block, l.file as file, l.statement as statement, l.statement_span as statement_span from member_texts as l join star_statements as r on l.statement = r.statement and l.file = r.file;
let star_import_ends = select l.block as block, l.file as file, l.statement as statement, l.statement_span as statement_span, r.end_line as line, r.end_byte as end_byte from star_member_texts as l join line_locations as r on l.statement = r.id and l.file = r.file;
let star_inline_comments = select l.block as block, l.file as file, l.statement as statement, l.statement_span as statement_span, r.comment_span as comment_span from star_import_ends as l join inline_comments as r on l.file = r.file and l.line = r.line where l.end_byte <= r.at;
let star_statement_ends = source-matches(from=star_inline_comments, span="statement_span", pattern="$", output="statement_end");
let star_comment_starts = source-matches(from=star_statement_ends, span="comment_span", pattern="^", output="comment_start");
let star_comment_gaps = span-between(from=star_comment_starts, start="statement_end", end="comment_start", output="gap");
let star_short_comment_gaps = source-matches(from=star_comment_gaps, span="gap", pattern="^ $", output="short_gap");
let star_comment_spacing = select l.id as block, l.span as span, l.file as file from blocks as l join star_short_comment_gaps as r on l.id = r.block and l.file = r.file;
let import_ends = select l.block as block, l.file as file, l.statement as statement, l.statement_span as statement_span, l.spelling_text as spelling_text, r.end_line as line, r.end_byte as end_byte from unparenthesized_texts as l join line_locations as r on l.statement = r.id and l.file = r.file;
let imports_with_comments = select l.block as block, l.file as file, l.statement as statement, l.statement_span as statement_span, l.spelling_text as spelling_text, r.comment_text as comment_text from import_ends as l join inline_comments as r on l.file = r.file and l.line = r.line where l.end_byte <= r.at;
let fitting_comments = fits-rendered(from=imports_with_comments, texts=["spelling_text", "comment_text"], literals=["", "  ", ""], span="statement_span", max-line=88, tab-width=4);
let overflowing_comments = antijoin(left=imports_with_comments, right=fitting_comments, left-on=["block","file","statement"], right-on=["block","file","statement"]);
let comment_width_problems = select l.id as block, l.span as span, l.file as file from blocks as l join overflowing_comments as r on l.id = r.block and l.file = r.file;
let spelling_counts = group-count(from=spelled_members, keys=["block","file","spelling"], count="count", distinct="statement");
let repeated_spellings = select block, file, spelling from spelling_counts where count > 1;
let repeated_blocks = group-count(from=repeated_spellings, keys=["block","file"], count="count", distinct="spelling");
let duplicate_imports = select l.id as block, l.span as span, l.file as file from blocks as l join repeated_blocks as r on l.id = r.block and l.file = r.file;
let future_targets = select alias, file from imports where matches(target, "^__future__(?:\.|$)");
let future_aliases = select l.alias as alias, l.file as file from future_targets as l join import_forms as r on l.alias = r.alias and l.file = r.file where r.form = "import-from";
let stdlib_aliases = select occurrence as alias, file from "standard-library-import";
let nonfuture_stdlib = antijoin(left=stdlib_aliases, right=future_aliases, left-on=["alias","file"], right-on=["alias","file"]);
let relative_aliases = select alias, file from imports where matches(target, "^[.]");
let first_party_aliases = select l.alias as alias, l.file as file from imports as l join "project-namespace-membership" as r on l.file = r.file where r.membership = "present" and (l.target = r.root or starts_with(l.target, concat(r.root, ".")));
let known0 = union(left=future_aliases, right=nonfuture_stdlib);
let first_party_nonstdlib = antijoin(left=first_party_aliases, right=known0, left-on=["alias","file"], right-on=["alias","file"]);
let known1 = union(left=known0, right=relative_aliases);
let known = union(left=known1, right=first_party_nonstdlib);
let external_aliases = antijoin(left=imports, right=known, left-on=["alias","file"], right-on=["alias","file"]);
let future_section = extend(from=future_aliases, values={section: 0});
let stdlib_section = extend(from=nonfuture_stdlib, values={section: 1});
let external_keys = select alias, file from external_aliases;
let external_section = extend(from=external_keys, values={section: 2});
let first_party_section = extend(from=first_party_nonstdlib, values={section: 3});
let relative_section = extend(from=relative_aliases, values={section: 4});
let sections0 = union(left=future_section, right=stdlib_section);
let sections1 = union(left=sections0, right=external_section);
let sections2 = union(left=sections1, right=first_party_section);
let sections = union(left=sections2, right=relative_section);
let classified_sections = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, r.section as section, l.target as target, l.form as form, l.start_line as start_line, l.end_line as end_line from members as l join sections as r on l.alias = r.alias and l.file = r.file;
let classified_module = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.section as section, l.target as target, l.form as form, l.start_line as start_line, l.end_line as end_line, r.module as module from classified_sections as l join module_keys as r on l.alias = r.alias and l.file = r.file;
let classified = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.section as section, l.target as target, l.form as form, l.start_line as start_line, l.end_line as end_line, l.module as module, r.name as name from classified_module as l join spelled_names as r on l.alias = r.alias and l.file = r.file;
let uppercase_cased_aliases = select alias, file from classified where form = "import-from" and matches(name, "^[^\p{Lowercase}\p{Lt}]*\p{Uppercase}[^\p{Lowercase}\p{Lt}]*$");
let singleton_uppercase = select alias, file from classified where form = "import-from" and matches(name, "^\p{Uppercase}$");
let constant_aliases = antijoin(left=uppercase_cased_aliases, right=singleton_uppercase, left-on=["alias","file"], right-on=["alias","file"]);
let uppercase_aliases = select alias, file from classified where form = "import-from" and matches(name, "^\p{Uppercase}");
let class_aliases = antijoin(left=uppercase_aliases, right=constant_aliases, left-on=["alias","file"], right-on=["alias","file"]);
let from_aliases = select alias, file from classified where form = "import-from";
let star_aliases = select l.alias as alias, l.file as file from classified as l join star_spelled_aliases as r on l.alias = r.alias and l.file = r.file where l.form = "import-from";
let ranked_aliases0 = union(left=constant_aliases, right=class_aliases);
let ranked_aliases = union(left=ranked_aliases0, right=star_aliases);
let variable_aliases = antijoin(left=from_aliases, right=ranked_aliases, left-on=["alias","file"], right-on=["alias","file"]);
let plain_aliases = select alias, file from classified where form = "import";
let rank_one_aliases = union(left=constant_aliases, right=plain_aliases);
let rank_zero = extend(from=star_aliases, values={rank: 0});
let rank_one = extend(from=rank_one_aliases, values={rank: 1});
let rank_two = extend(from=class_aliases, values={rank: 2});
let rank_three = extend(from=variable_aliases, values={rank: 3});
let ranks0 = union(left=rank_zero, right=rank_one);
let ranks1 = union(left=ranks0, right=rank_two);
let ranks = union(left=ranks1, right=rank_three);
let ranked0 = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.section as section, l.target as target, l.name as name, l.form as form, l.start_line as start_line, l.end_line as end_line, l.module as module, r.rank as rank from classified as l join ranks as r on l.alias = r.alias and l.file = r.file;
let ranked1 = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.section as section, l.target as target, l.name as name, l.form as form, l.start_line as start_line, l.end_line as end_line, l.module as module, l.rank as rank, r.statement as statement from ranked0 as l join import_aliases as r on l.alias = r.alias and l.file = r.file;
let ranked = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.section as section, l.target as target, l.name as name, l.form as form, l.start_line as start_line, l.end_line as end_line, l.module as module, l.rank as rank, l.statement as statement, r.rename as rename from ranked1 as l join alias_keys as r on l.alias = r.alias and l.file = r.file;
let inversions = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.section > r.section;
let style_inversions = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.section = r.section and l.form = "import-from" and r.form = "import";
let relative_ranked = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.module as module, r.dots as dots from ranked as l join relative_module_keys as r on l.alias = r.alias and l.file = r.file where l.section = 4;
let relative_module_inversions = select l.block as block, l.span as span, l.file as file from relative_ranked as l join relative_ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and ((l.dots != r.dots and starts_with(r.dots, l.dots)) or (l.dots = r.dots and (natural_lt(lower(r.module), lower(l.module)) or (lower(r.module) = lower(l.module) and natural_lt(r.module, l.module)))));
let module_inversions = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.section = r.section and l.section != 4 and l.form = r.form and (natural_lt(lower(r.module), lower(l.module)) or (lower(r.module) = lower(l.module) and natural_lt(r.module, l.module)));
let rename_inversions = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.section = r.section and l.form = r.form and l.module = r.module and l.name = r.name and (natural_lt(lower(r.rename), lower(l.rename)) or (lower(r.rename) = lower(l.rename) and natural_lt(r.rename, l.rename)));
let within_statement_inversions = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.statement = r.statement and l.section = r.section and l.form = "import-from" and r.form = "import-from" and l.module = r.module and (l.rank > r.rank or (l.rank = r.rank and (natural_lt(lower(r.name), lower(l.name)) or (lower(r.name) = lower(l.name) and natural_lt(r.name, l.name)))));
let statement_heads = select l.block as block, l.span as span, l.file as file, l.alias as alias, l.at as at, l.statement as statement, l.section as section, l.form as form, l.module as module, l.name as name, l.rank as rank from ranked as l join first_aliases as r on l.alias = r.alias and l.file = r.file;
let between_statement_inversions = select l.block as block, l.span as span, l.file as file from statement_heads as l join statement_heads as r on l.block = r.block and l.file = r.file where l.at < r.at and l.statement != r.statement and l.section = r.section and l.form = "import-from" and r.form = "import-from" and l.module = r.module and (l.rank > r.rank or (l.rank = r.rank and (natural_lt(lower(r.name), lower(l.name)) or (lower(r.name) = lower(l.name) and natural_lt(r.name, l.name)))));
let member_inversions = union(left=within_statement_inversions, right=between_statement_inversions);
let all_module_inversions = union(left=module_inversions, right=relative_module_inversions);
let sorted_inversions = union(left=style_inversions, right=all_module_inversions);
let sorted_inversions1 = union(left=sorted_inversions, right=rename_inversions);
let out_of_order = union(left=sorted_inversions1, right=member_inversions);
let missing_section_gap = select l.block as block, l.span as span, l.file as file from ranked as l join ranked as r on l.block = r.block and l.file = r.file where l.at < r.at and l.section < r.section and integer_successor(l.end_line, r.start_line);
let problems0 = union(left=inversions, right=out_of_order);
let problems = union(left=problems0, right=missing_section_gap);
let spacing_matches = source-matches(from=eligible_imports, span="span", pattern="^(?:import|from)[ \t]{2,}", output="raw_gap");
let spacing_rows = select id as block, span, file from spacing_matches;
let split_lines = select l.id as id, l.file as file, r.at as at, r.start_line as comment_line from split_comments as l join alias_locations as r on l.id = r.id and l.file = r.file;
let split_pair_lines = select l.source as source, l.destination as destination, l.file as file, r.comment_line as comment_line from pair_bounds as l join split_lines as r on l.file = r.file where l.first_end <= r.at and r.at < l.last_start;
let split_previous = select l.source as source, l.file as file, l.comment_line as comment_line, r.end_line as import_end from split_pair_lines as l join alias_locations as r on l.source = r.id and l.file = r.file;
let split_bad_lines = select source, file from split_previous where integer_successor(import_end, comment_line);
let split_spacing = select l.source as block, r.span as span, l.file as file from split_bad_lines as l join eligible_imports as r on l.source = r.id and l.file = r.file;
let imported_edges = select l.parent as parent, l.source as source, l.destination as destination, l.file as file, r.span as source_span from adjacent as l join eligible_imports as r on l.source = r.id and l.file = r.file;
let module_nodes = select id, file from syntax where kind = "module";
let module_import_edges = select l.source as source, l.destination as destination, l.source_span as source_span, l.file as file from imported_edges as l join module_nodes as r on l.parent = r.id and l.file = r.file;
let nonimport_next = antijoin(left=module_import_edges, right=import_nodes, left-on=["destination","file"], right-on=["id","file"]);
let following_nodes = select l.source as source, l.source_span as source_span, r.span as destination_span, r.kind as destination_kind, l.file as file from nonimport_next as l join syntax as r on l.destination = r.id and l.file = r.file;
let following_defs = select source, source_span, destination_span, file from following_nodes where destination_kind = "function-def" or destination_kind = "async-function-def" or destination_kind = "class-def";
let source_ends = source-matches(from=following_nodes, span="source_span", pattern="$", output="source_end");
let destination_starts = source-matches(from=source_ends, span="destination_span", pattern="^", output="destination_start");
let trailer_intervals = span-between(from=destination_starts, start="source_end", end="destination_start", output="interval");
let no_blank_trailers = source-matches(from=trailer_intervals, span="interval", pattern="^\r?\n$", output="gap");
let extra_blank_trailers = source-matches(from=trailer_intervals, span="interval", pattern="^(?:\r?\n){3,}$", output="gap");
let definition_ends = source-matches(from=following_defs, span="source_span", pattern="$", output="source_end");
let definition_starts = source-matches(from=definition_ends, span="destination_span", pattern="^", output="destination_start");
let definition_intervals = span-between(from=definition_starts, start="source_end", end="destination_start", output="interval");
let too_many_definition_blanks = source-matches(from=definition_intervals, span="interval", pattern="^(?:\r?\n){4,}$", output="gap");
let too_many_stub_definition_blanks = source-matches(from=definition_intervals, span="interval", pattern="^(?:\r?\n){3,}$", output="gap");
let one_blank_definitions = source-matches(from=definition_intervals, span="interval", pattern="^(?:\r?\n){2}$", output="gap");
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let stub_extra_definitions = select l.source as source, l.file as file from too_many_stub_definition_blanks as l join stub_files as r on l.file = r.file;
let short_python_definitions = antijoin(left=one_blank_definitions, right=stub_files, left-on=["file"], right-on=["file"]);
let attached_comments = source-matches(from=definition_intervals, span="interval", pattern="^(?:\r?\n){2}#[^\r\n]*(?:\r?\n)$", output="gap");
let attached_python_comments = antijoin(left=attached_comments, right=stub_files, left-on=["file"], right-on=["file"]);
let no_blank_sources = select source, file from no_blank_trailers;
let extra_blank_nondefinitions = select source, file from extra_blank_trailers where destination_kind != "function-def" and destination_kind != "async-function-def" and destination_kind != "class-def";
let extra_blank_python_definition_rows = antijoin(left=too_many_definition_blanks, right=stub_files, left-on=["file"], right-on=["file"]);
let extra_blank_python_definitions = select source, file from extra_blank_python_definition_rows;
let extra_blank_definitions = union(left=extra_blank_python_definitions, right=stub_extra_definitions);
let extra_blank_sources = union(left=extra_blank_nondefinitions, right=extra_blank_definitions);
let nonstandard_trailers = union(left=no_blank_sources, right=extra_blank_sources);
let short_definition_sources = select source, file from short_python_definitions;
let attached_comment_sources = select source, file from attached_python_comments;
let one_newline_before_comment = source-matches(from=trailer_intervals, span="interval", pattern="^\r?\n[ \t]*#", output="gap");
let many_newlines_before_comment = source-matches(from=trailer_intervals, span="interval", pattern="^(?:\r?\n){3,}[ \t]*#", output="gap");
let definition_comment_gaps = source-matches(from=definition_intervals, span="interval", pattern="^(?:\r?\n){3}(?:[ \t]*#[^\r\n]*\r?\n)+$", output="gap");
let valid_python_definition_comments = antijoin(left=definition_comment_gaps, right=stub_files, left-on=["file"], right-on=["file"]);
let excess_comment_gaps = antijoin(left=many_newlines_before_comment, right=valid_python_definition_comments, left-on=["source","file"], right-on=["source","file"]);
let comment_gap_sources = union(left=one_newline_before_comment, right=excess_comment_gaps);
let comment_gap_rows = select source, file from comment_gap_sources;
let bad_trailers0 = union(left=nonstandard_trailers, right=short_definition_sources);
let bad_trailers1 = union(left=bad_trailers0, right=attached_comment_sources);
let bad_trailers = union(left=bad_trailers1, right=comment_gap_rows);
let trailer_blocks = select r.block as block, r.file as file from bad_trailers as l join member_statements as r on l.source = r.statement and l.file = r.file;
let trailer_spacing = select l.id as block, l.span as span, l.file as file from blocks as l join trailer_blocks as r on l.id = r.block and l.file = r.file;
let preceding_nonimports = antijoin(left=syntax, right=import_nodes, left-on=["id","file"], right-on=["id","file"]);
let prefix_sources = select l.source as source, l.destination as destination, l.file as file, r.span as source_span from adjacent as l join preceding_nonimports as r on l.source = r.id and l.file = r.file;
let prefix_imports = select l.source as source, l.destination as destination, l.source_span as source_span, l.file as file, r.span as destination_span from prefix_sources as l join eligible_imports as r on l.destination = r.id and l.file = r.file;
let prefix_ends = source-matches(from=prefix_imports, span="source_span", pattern="$", output="source_end");
let prefix_intervals = span-between(from=prefix_ends, start="source_end", end="destination_span", output="interval");
let continued_imports = source-matches(from=prefix_intervals, span="interval", pattern=";[ \t]*\x5c[ \t]*\r?\n[ \t]*(?:import|from)", output="continuation");
let continuation_spacing = select destination as block, destination_span as span, file from continued_imports;
let continued_import_nodes = source-matches(from=eligible_imports, span="span", pattern="(?m)^[^#\r\n]*\x5c[ \t]*\r?\n", output="continuation");
let continued_import_blocks = select l.block as block, l.file as file from member_statements as l join continued_import_nodes as r on l.statement = r.id and l.file = r.file;
let continued_import_problems = select l.id as block, l.span as span, l.file as file from blocks as l join continued_import_blocks as r on l.id = r.block and l.file = r.file;
let problems1 = union(left=problems, right=spacing_rows);
let problems2 = union(left=problems1, right=split_spacing);
let problems3a = union(left=problems2, right=trailer_spacing);
let problems3 = union(left=problems3a, right=continued_import_problems);
let problems4 = union(left=problems3, right=continuation_spacing);
let problems5 = union(left=problems4, right=duplicate_imports);
let problems5a = union(left=problems5, right=combine_from_problems);
let problems6 = union(left=problems5a, right=width_problems);
let problems6a0 = union(left=problems6, right=star_comment_spacing);
let problems6a = union(left=problems6a0, right=comment_spacing_problems);
let problems7 = union(left=problems6a, right=comment_width_problems);
let problems8 = union(left=problems7, right=split_alias_problems);
let problems9 = union(left=problems8, right=unwrap_problems);
let ruf100_candidates = select file, span from problems9;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:I001)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:I001)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "I001"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=problems9, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(span);
