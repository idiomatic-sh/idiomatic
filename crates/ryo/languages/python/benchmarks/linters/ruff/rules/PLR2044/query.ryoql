import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let comments = select id, file, span, text from "comment";
let empty_comments = select id, file, span from comments where matches(text, "^[ \t\x0c]*$");
let comment_locations = select l.id as id, l.file as file, l.span as span, l.text as text, r."start-line" as line, r."start-column" as column, r."start-byte" as start from comments as l join "source-location" as r on l.id = r.id and l.file = r.file;
let physical_content = select id, text, file from "syntax-tree" where matches(text, "[^ \t\r\n\x0c][^\r\n]*$");
let content_ends = select l.id as id, l.file as file, r."end-line" as end_line, r."end-column" as end_column, r."end-byte" as end from physical_content as l join "source-location" as r on l.id = r.id and l.file = r.file;
let inline_comment_ids = select l.id as id, l.file as file from comment_locations as l join content_ends as r on l.file = r.file where l.line = r.end_line and r.end <= l.start and r.end_column > 1;
let own_line_ids = antijoin(left=comment_locations, right=inline_comment_ids, left-on=["id","file"], right-on=["id","file"]);
let own_line_comments = select l.id as id, l.file as file, l.span as span, l.text as text, l.line as line, l.column as column from comment_locations as l join own_line_ids as r on l.id = r.id and l.file = r.file;
let newlines = select id, file from "syntax-tree" where kind = "newline" or kind = "nl";
let physical_line_steps = select l.file as file, r."start-line" as line, r."end-line" as next_line from newlines as l join "source-location" as r on l.id = r.id and l.file = r.file where r."end-line" > r."start-line";
let next_comment_lines = select l.id as source, l.file as file, l.column as column, r.next_line as next_line from own_line_comments as l join physical_line_steps as r on l.file = r.file and l.line = r.line;
let adjacent_comments = select l.source as source, r.id as destination, l.file as file from next_comment_lines as l join own_line_comments as r on l.file = r.file and l.next_line = r.line and l.column = r.column;
let reverse_adjacent_comments = select destination as source, source as destination, file from adjacent_comments;
let comment_block_edges = union(left=adjacent_comments, right=reverse_adjacent_comments);
let comment_block_paths = closure(edges=comment_block_edges, source="source", destination="destination", keys=["file"]);
let nonempty_own_comments = antijoin(left=own_line_comments, right=empty_comments, left-on=["id", "file"], right-on=["id", "file"]);
let comments_in_nonempty_blocks = select l.source as id, l.file as file from comment_block_paths as l join nonempty_own_comments as r on l.destination = r.id and l.file = r.file;
let reportable = antijoin(left=empty_comments, right=comments_in_nonempty_blocks, left-on=["id", "file"], right-on=["id", "file"]);
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLR2044)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR2044"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
