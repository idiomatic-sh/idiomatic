import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let assignments = select l.id as id, l.file as file from "semantic-syntax" as l join stub_files as r on l.file = r.file where l.kind = "assign";
let targets = select l.parent as assignment, l.child as target, l.file as file from "semantic-child" as l join assignments as r on l.parent = r.id and l.file = r.file where l.field = "targets";
let target_names = select l.target as id, l.file as file from targets as l join "identifier" as r on l.target = r.id and l.file = r.file;
let values = select l.parent as assignment, l.child as value, l.file as file from "semantic-child" as l join assignments as r on l.parent = r.id and l.file = r.file where l.field = "value";
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let generic_aliases = select l.assignment as assignment, l.file as file from values as l join subscripts as r on l.value = r.id and l.file = r.file;
let any_values = select id, file from "qualified-name" where path = "typing.Any" or path = "typing_extensions.Any";
let any_aliases = select l.assignment as assignment, l.file as file from values as l join any_values as r on l.value = r.id and l.file = r.file;
let null_values = select id, file from "literal-properties" where kind = "null";
let null_aliases = select l.assignment as assignment, l.file as file from values as l join null_values as r on l.value = r.id and l.file = r.file;
let binary_nodes = select id, file from "semantic-syntax" where kind = "bin-op";
let operator_fields = select parent, child from "semantic-child" where field = "op";
let operators = select l.id as operation, r.child as operator, l.file as file from binary_nodes as l join operator_fields as r on l.id = r.parent;
let pipe_tokens = select id, file from "semantic-syntax" where text = "|";
let pipe_ops = select l.operation as operation, l.file as file from operators as l join pipe_tokens as r on l.operator = r.id and l.file = r.file;
let pipe_values = select l.assignment as assignment, l.file as file from values as l join pipe_ops as r on l.value = r.operation and l.file = r.file;
let binary_aliases = select assignment, file from pipe_values;
let alias_variants = union(left=generic_aliases, right=any_aliases);
let alias_variants2 = union(left=alias_variants, right=null_aliases);
let all_aliases = union(left=alias_variants2, right=binary_aliases);
let named_assignments = select l.id as id, t.assignment as assignment, l.file as file from target_names as l join targets as t on l.id = t.target and l.file = t.file;
let reportable = select l.id as id, l.file as file from named_assignments as l join all_aliases as a on l.assignment = a.assignment and l.file = a.file;
let locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from "source-location" as r;
let candidates = select l.id as id, l.file as file, r.span as span, r.line as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI026(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI026)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI026(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI026)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI026"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
