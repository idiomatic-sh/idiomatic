import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let conditionals = select id, file from "semantic-syntax" where kind = "if" or kind = "elif-else-clause";
let test_edges = select parent, child, file from "semantic-child" where field = "test";
let raw_tests = select r.child as test, l.file as file from conditionals as l join test_edges as r on l.id = r.parent and l.file = r.file;
let boolops = select id, file from "semantic-syntax" where kind = "bool-op";
let bool_tests = select l.test as test, l.file as file from raw_tests as l join boolops as r on l.test = r.id and l.file = r.file;
let bool_values = select r.child as test, l.file as file from bool_tests as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "values";
let simple_tests = antijoin(left=raw_tests, right=boolops, left-on=["test", "file"], right-on=["id", "file"]);
let tests = union(left=simple_tests, right=bool_values);
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare";
let tested_comparisons = select r.id as id, r.file as file, r.span as span from tests as l join comparisons as r on l.test = r.id and l.file = r.file;
let comparator_edges = select parent, child, file from "semantic-child" where field = "comparators";
let comparator_rows = select l.id as comparison, r.child as comparator, l.file as file from tested_comparisons as l join comparator_edges as r on l.id = r.parent and l.file = r.file;
let chained = select l.comparison as comparison, l.file as file from comparator_rows as l join comparator_rows as r on l.comparison = r.comparison and l.file = r.file where l.comparator != r.comparator;
let single_comparisons = antijoin(left=tested_comparisons, right=chained, left-on=["id", "file"], right-on=["comparison", "file"]);
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let version_info = select id, file from "qualified-name" where path = "sys.version_info";
let left_rows = select l.id as comparison, r.child as left, l.file as file from single_comparisons as l join left_edges as r on l.id = r.parent and l.file = r.file;
let version_rows = select l.comparison as comparison, l.file as file from left_rows as l join version_info as r on l.left = r.id and l.file = r.file;
let op_edges = select parent, child, file from "semantic-child" where field = "ops";
let preferred_ops = select id, file from "semantic-syntax" where text = "<" or text = ">=";
let op_rows = select l.comparison as comparison, r.child as op, l.file as file from version_rows as l join op_edges as r on l.comparison = r.parent and l.file = r.file;
let preferred_comparisons = select l.comparison as comparison, l.file as file from op_rows as l join preferred_ops as r on l.op = r.id and l.file = r.file;
let other_comparisons = antijoin(left=version_rows, right=preferred_comparisons, left-on=["comparison", "file"], right-on=["comparison", "file"]);
let reportable = select l.comparison as id, r.file as file, r.span as span from other_comparisons as l join comparisons as r on l.comparison = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI006)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI006"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
