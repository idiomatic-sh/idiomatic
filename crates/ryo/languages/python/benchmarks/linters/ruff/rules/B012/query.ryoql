import suppress from "python/ruff/suppress";
let jumps = select id, kind, file, span from "semantic-syntax" where kind = "break" or kind = "continue" or kind = "return";
let final_roots = select child as id from "semantic-child" where field = "finalbody";
let ordinary = select id from "semantic-syntax" where kind = "if" or kind = "try" or kind = "try-star" or kind = "with" or kind = "async-with" or kind = "match-case";
let body_fields = select parent, child from "semantic-child" where field = "body";
let ordinary_edges = select r.parent as parent, r.child as child from ordinary as l join body_fields as r on l.id = r.parent;
let case_edges = select parent, child from "semantic-child" where field = "cases";
let edges = union(left=ordinary_edges, right=case_edges);
let paths = closure(edges=edges, source="parent", destination="child");
let descendants = select r.child as id from final_roots as l join paths as r on l.id = r.parent;
let reachable = union(left=final_roots, right=descendants);
let direct_jumps = select l.id as id, l.file as file, l.span as span from jumps as l join reachable as r on l.id = r.id;
let loops = select id from "semantic-syntax" where kind = "for" or kind = "async-for" or kind = "while";
let loop_edges = select r.parent as parent, r.child as child from loops as l join body_fields as r on l.id = r.parent;
let return_edges = union(left=edges, right=loop_edges);
let return_paths = closure(edges=return_edges, source="parent", destination="child");
let return_descendants = select r.child as id from final_roots as l join return_paths as r on l.id = r.parent;
let returns = select id, file, span from jumps where kind = "return";
let nested_returns = select l.id as id, l.file as file, l.span as span from returns as l join return_descendants as r on l.id = r.id;
let reportable = union(left=direct_jumps, right=nested_returns);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B012(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B012)(?:,|$)");
emit violations subject file key(id);
