import observation_matches from "python/ruff/suppress-matches";
let statement_loops = select id, file from "semantic-syntax" where kind = "for" or kind = "async-for";
let comprehensions = select id, file from "semantic-syntax" where kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let comprehension_loops = select r.child as id, l.file as file from comprehensions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let loops = union(left=statement_loops, right=comprehension_loops);
let iter_edges = select parent, child, file from "semantic-child" where field = "iter";
let loop_iterables = select r.child as id, l.file as file from loops as l join iter_edges as r on l.id = r.parent and l.file = r.file;
let sets = select l.id as id, l.file as file, r.span as span from loop_iterables as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file where r.kind = "set";
let elements = select l.id as set_id, l.file as file, r.child as id from sets as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let constants = select id, file from "semantic-syntax" where kind = "constant";
let nonliteral_elements = antijoin(left=elements, right=constants, left-on=["id","file"], right-on=["id","file"]);
let keyed_elements = select l.set_id as set_id, l.id as id, l.file as file, r.key as key from elements as l join "constant-key" as r on l.id = r.id and l.file = r.file;
let key_counts = group-count(from=keyed_elements, keys=["set_id","file","key"], count="count", distinct="id");
let duplicate_sets = select set_id, file from key_counts where count > 1;
let literal_sets = antijoin(left=sets, right=nonliteral_elements, left-on=["id","file"], right-on=["set_id","file"]);
let candidates = antijoin(left=literal_sets, right=duplicate_sets, left-on=["id","file"], right-on=["set_id","file"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLC0208)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLC0208"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
