let comments = select id, file from "comment";
let located = select l.id as id, l.file as file, r.span as comment_span, r."start-byte" as begin, r."start-line" as line from comments as l join "source-location" as r on l.id = r.id and l.file = r.file;
let inline_heads = source-matches(from=located, span="comment_span", pattern="#[^\S\r\n]*(?i:noqa)(?P<suffix>.*)$", output="marker", capture="suffix", capture-output="suffix_span", capture-text-output="suffix");
let file_heads0 = source-matches(from=located, span="comment_span", pattern="#[^\S\r\n]*(?:ruff|flake8)[^\S\r\n]*:[^\S\r\n]*(?i:noqa)(?P<suffix>.*)$", output="marker", capture="suffix", capture-output="suffix_span", capture-text-output="suffix");
let significant = select id, file from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let token_places = select l.id as id, l.file as file, r."start-line" as line, r."end-byte" as finish from significant as l join "source-location" as r on l.id = r.id and l.file = r.file;
let trailing_file = select l.id as id from file_heads0 as l join token_places as r on l.file = r.file and l.line = r.line where r.finish <= l.begin;
let file_heads = antijoin(left=file_heads0, right=trailing_file, left-on=["id"], right-on=["id"]);
let blanket_files = select file from file_heads where matches(suffix, "^(?:$|#|\s+(?:$|[^:\s]))");
let inline_lists = source-matches(from=inline_heads, span="suffix_span", pattern="^\s*:\s*(?P<codes>[\s,]*[A-Z]+[0-9]+(?:[\s,]*[A-Z]+[0-9]+)*)(?:[\s,]*(?:$|#.*)|[\s,]+(?:[^A-Z,\s].*|[A-Z]+(?:$|[^A-Z0-9].*)))$", output="list", capture="codes", capture-output="codes_span");
let inline_codes = source-matches(from=inline_lists, span="codes_span", pattern="(?P<code>[A-Z]+[0-9]+)", output="token", capture="code", capture-output="code_span", capture-text-output="code");
let file_lists = source-matches(from=file_heads, span="suffix_span", pattern="^\s*:\s*(?P<codes>[\s,]*[A-Z]+[0-9]+(?:[\s,]*[A-Z]+[0-9]+)*)(?:[\s,]*(?:$|#.*)|[\s,]+(?:[^A-Z,\s].*|[A-Z]+(?:$|[^A-Z0-9].*)))$", output="list", capture="codes", capture-output="codes_span");
let file_codes = source-matches(from=file_lists, span="codes_span", pattern="(?P<code>[A-Z]+[0-9]+)", output="token", capture="code", capture-output="code_span", capture-text-output="code");
let exempt_codes = select file from file_codes where code = "RUF101";
let exempt_files = union(left=blanket_files, right=exempt_codes);
let inline_tokens = select id, file, code, code_span as span from inline_codes;
let file_tokens = select id, file, code, code_span as span from file_codes;
let tokens = union(left=inline_tokens, right=file_tokens);
let redirected = select id, file, span from tokens where matches(code, "^(?:C9|I2|I25|I252|IC0|IC00|IC001|IC002|IC003|IC004|M0|M001|PDV0|PDV002|PDV003|PDV004|PDV007|PDV008|PDV009|PDV01|PDV010|PDV011|PDV012|PDV013|PDV015|PDV9|PDV90|PDV901|PGH001|PGH002|PIE802|PLR1701|PLW0117|PLW0130|R5|R50|R501|R502|R503|R504|R505|R506|R507|R508|RUF004|RUF011|RUF025|RUF035|SIM111|T001|T002|T003|T004|T1|T2|TCH001|TCH002|TCH003|TCH004|TCH005|TCH006|TCH010|TRIO1|TRIO10|TRIO100|TRIO105|TRIO109|TRIO11|TRIO110|TRIO115|TRY200|TRY302|TYP001|U0|U00|U001|U003|U004|U005|U006|U007|U008|U009|U01|U010|U011|U012|U013|U014|U015|U016|U017|U019)$");
let violations = antijoin(left=redirected, right=exempt_files, left-on=["file"], right-on=["file"]);
let ruf100_blanket_owners = select id, file from file_heads where matches(suffix, "^(?:$|#|\s+(?:$|[^:\s]))");
let ruf100_code_owners = select id, file from file_codes where code = "RUF101";
let ruf100_file_owners = union(left=ruf100_blanket_owners, right=ruf100_code_owners);
let ruf100_directives = select l.id as directive, l.file as file from ruf100_file_owners as l join redirected as r on l.file = r.file;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF101"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id, span);
