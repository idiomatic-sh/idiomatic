import noqa_codes from "python/ruff/noqa-codes";
import noqa_blankets from "python/ruff/noqa-blankets";
let blanket_rows = noqa_blankets();
let codes = noqa_codes();
let file_codes = select id, file, code from codes where scope = 1;
let blanket_files = select file from blanket_rows where scope = 1;
let exempt_codes = select file from file_codes where code = "RUF101";
let exempt_files = union(left=blanket_files, right=exempt_codes);
let tokens = select id, file, code, code_span as span from codes;
let redirected = select id, file, span from tokens where matches(code, "^(?:C9|I2|I25|I252|IC0|IC00|IC001|IC002|IC003|IC004|M0|M001|PDV0|PDV002|PDV003|PDV004|PDV007|PDV008|PDV009|PDV01|PDV010|PDV011|PDV012|PDV013|PDV015|PDV9|PDV90|PDV901|PGH001|PGH002|PIE802|PLR1701|PLW0117|PLW0130|R5|R50|R501|R502|R503|R504|R505|R506|R507|R508|RUF004|RUF011|RUF025|RUF035|SIM111|T001|T002|T003|T004|T1|T2|TCH001|TCH002|TCH003|TCH004|TCH005|TCH006|TCH010|TRIO1|TRIO10|TRIO100|TRIO105|TRIO109|TRIO11|TRIO110|TRIO115|TRY200|TRY302|TYP001|U0|U00|U001|U003|U004|U005|U006|U007|U008|U009|U01|U010|U011|U012|U013|U014|U015|U016|U017|U019)$");
let violations = antijoin(left=redirected, right=exempt_files, left-on=["file"], right-on=["file"]);
let ruf100_blanket_owners = select id, file from blanket_rows where scope = 1;
let ruf100_code_owners = select id, file from file_codes where code = "RUF101";
let ruf100_file_owners = union(left=ruf100_blanket_owners, right=ruf100_code_owners);
let ruf100_directives = select l.id as directive, l.file as file from ruf100_file_owners as l join redirected as r on l.file = r.file;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF101"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id, span);
