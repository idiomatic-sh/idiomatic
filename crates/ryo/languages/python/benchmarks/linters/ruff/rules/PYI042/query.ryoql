import suppress from "python/ruff/suppress";
let definitions = select id as binding, kind, name, file, span from "defines";
let annotations = select id, file from "semantic-syntax" where kind = "ann-assign";
let type_alias_names = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let annotation_edges = select parent as assignment, child as annotation, file from "semantic-child" where field = "annotation";
let marked_assignments = select l.assignment as assignment, l.file as file from annotation_edges as l join type_alias_names as r on l.annotation = r.id and l.file = r.file;
let marked_ann_assignments = select l.id as statement, l.file as file from annotations as l join marked_assignments as r on l.id = r.assignment and l.file = r.file;
let assignment_targets = select parent as statement, child as target, file from "semantic-child" where field = "target";
let annotated_aliases = select l.target as binding, l.file as file from assignment_targets as l join marked_ann_assignments as r on l.statement = r.statement and l.file = r.file;
let pep695_statements = select id, file from "semantic-syntax" where kind = "type-alias";
let pep695_names = select parent as statement, child as binding, file from "semantic-child" where field = "name";
let pep695_aliases = select l.binding as binding, l.file as file from pep695_names as l join pep695_statements as r on l.statement = r.id and l.file = r.file;
let aliases = union(left=annotated_aliases, right=pep695_aliases);
let named_aliases = select l.binding as id, l.file as file, r.name as name, r.span as span from aliases as l join definitions as r on l.binding = r.binding and l.file = r.file;
let snake_candidates = select id, file, span from named_aliases where matches(name, "^_?[a-z0-9]");
let locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from snake_candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="PYI042($|[, #])", range-pattern="(?:^|,)(?:PYI042)(?:,|$)");
emit violations subject file key(id);
