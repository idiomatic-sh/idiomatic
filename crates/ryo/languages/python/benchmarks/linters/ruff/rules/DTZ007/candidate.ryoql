import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let strptime_functions = select id from qualified_names where path = "datetime.datetime.strptime" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let strptime_calls = select l.call as call, l.function as function from call_functions as l join strptime_functions as r on l.function = r.id;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_to_argument_wrappers = select l.parent as call, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let call_arguments = select l.call as call, l.wrapper as wrapper, r.file as file from call_to_argument_wrappers as l join calls as r on l.call = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as argument, l.file as file from call_arguments as l join positional_fields as r on l.wrapper = r.parent;
let positional_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start from positional as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let preceding_argument_pairs = select l.call as call, l.argument as later_argument, r.argument as earlier_argument, l.file as file from positional_locations as l join positional_locations as r on l.call = r.call and l.file = r.file where r.start < l.start;
let preceding_argument_counts = group-count(from=preceding_argument_pairs, keys=["call", "later_argument", "file"], count="count", distinct="earlier_argument");
let second_argument_rows = select l.call as call, l.later_argument as format, l.file as file from preceding_argument_counts as l where l.count = 1;
let second_arguments = select call, format, file from second_argument_rows;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from call_arguments as l join keyword_fields as r on l.wrapper = r.parent;
let call_keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent as keyword, child from "semantic-child" where field = "arg";
let arg_tokens = select l.keyword as keyword, r.child as token from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let semantic_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifier_children = select r.child as id, l.name as name from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let identifiers = select l.id as id, l.name as name from identifier_children as l join semantic_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name from arg_tokens as l join identifiers as r on l.token = r.id;
let format_keywords = select keyword from keyword_names where name = "format";
let format_keyword_calls = select l.call as call, l.keyword as keyword, l.file as file from call_keywords as l join format_keywords as r on l.keyword = r.keyword;
let keyword_value_fields = select parent as keyword, child as value from "semantic-child" where field = "value";
let format_keyword_values = select l.call as call, r.value as format, l.file as file from format_keyword_calls as l join keyword_value_fields as r on l.keyword = r.keyword;
let positional_without_keyword = antijoin(left=second_arguments, right=format_keyword_values, left-on=["call"], right-on=["call"]);
let format_arguments = union(left=positional_without_keyword, right=format_keyword_values);
let direct_format_literals = select l.call as call, r.value as value, l.file as file from second_arguments as l join "string-literal" as r on l.format = r.occurrence;
let direct_timezone_formats = select call, file from direct_format_literals where matches(value, ".*%z.*");
let joined_strings = select id, file from "semantic-syntax" where kind = "joined-str";
let joined_format_arguments = select l.call as call, r.id as joined, l.file as file from format_arguments as l join joined_strings as r on l.format = r.id and l.file = r.file;
let joined_literals = select l.call as call, r.value as value, l.file as file from joined_format_arguments as l join "interpolated-string-literal" as r on l.joined = r.owner and l.file = r.file;
let joined_literal_formats = select call, file from joined_literals where matches(value, "(?s).*%z.*");
let joined_timezone_formats = select call, file from joined_literal_formats;
let timezone_formats = union(left=direct_timezone_formats, right=joined_timezone_formats);
let calls_without_format = antijoin(left=strptime_calls, right=format_arguments, left-on=["call"], right-on=["call"]);
let no_format_ids = select call from calls_without_format;
let strptime_format_arguments = select l.call as call, r.format as format, r.file as file from strptime_calls as l join format_arguments as r on l.call = r.call;
let calls_without_timezone_format = antijoin(left=strptime_format_arguments, right=timezone_formats, left-on=["call"], right-on=["call"]);
let format_candidates = select call from calls_without_timezone_format;
let base_candidates = union(left=no_format_ids, right=format_candidates);
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child from "semantic-child" where field = "value";
let attribute_bases = select l.parent as attribute, l.child as base from attribute_values as l join attributes as r on l.parent = r.id;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_tokens = select l.parent as parent, r.child as child from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let semantic_name_tokens = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_name_tokens as r on l.id = r.id;
let attribute_names = select l.parent as attribute, r.text as name from attr_tokens as l join semantic_identifiers as r on l.child = r.id;
let replace_attributes = select attribute from attribute_names where name = "replace";
let astimezone_attributes = select attribute from attribute_names where name = "astimezone";
let replace_attr_bases = select l.attribute as attribute, r.base as base from replace_attributes as l join attribute_bases as r on l.attribute = r.attribute;
let astimezone_attr_bases = select l.attribute as attribute, r.base as base from astimezone_attributes as l join attribute_bases as r on l.attribute = r.attribute;
let replace_calls = select l.parent as call, l.child as attribute from function_fields as l join replace_attributes as r on l.child = r.attribute;
let initial_replace_calls = select l.base as origin, r.call as destination from replace_attr_bases as l join replace_calls as r on l.attribute = r.attribute;
let call_replace_bases = select l.id as origin, r.attribute as attribute from calls as l join replace_attr_bases as r on l.id = r.base;
let replace_transitions = select l.origin as origin, r.call as destination from call_replace_bases as l join replace_calls as r on l.attribute = r.attribute;
let replace_paths = closure(edges=replace_transitions, source="origin", destination="destination");
let chained_replaces = select l.origin as origin, r.destination as destination from initial_replace_calls as l join replace_paths as r on l.destination = r.origin;
let direct_timezone_uses = select l.call as id from base_candidates as l join astimezone_attr_bases as r on l.call = r.base;
let first_replace_timezone = select l.origin as id, r.base as terminal from initial_replace_calls as l join astimezone_attr_bases as r on l.destination = r.base;
let chained_replace_timezone = select l.origin as id, r.base as terminal from chained_replaces as l join astimezone_attr_bases as r on l.destination = r.base;
let first_replace_safe = select l.id as id from first_replace_timezone as l;
let chained_replace_safe = select l.id as id from chained_replace_timezone as l;
let timezone_safe_a = union(left=direct_timezone_uses, right=first_replace_safe);
let timezone_safe = union(left=timezone_safe_a, right=chained_replace_safe);
let unconverted_timezone = antijoin(left=base_candidates, right=timezone_safe, left-on=["call"], right-on=["id"]);
let replace_candidates = select l.call as call, r.attribute as attribute from base_candidates as l join replace_attr_bases as r on l.call = r.base;
let direct_replace_calls = select l.call as origin, r.call as replacement from replace_candidates as l join replace_calls as r on l.attribute = r.attribute;
let call_argument_wrappers = select l.replacement as replacement, r.wrapper as wrapper from direct_replace_calls as l join call_arguments as r on l.replacement = r.call;
let replace_keyword_edges = select l.replacement as call, r.child as keyword from call_argument_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let replace_keywords = select l.call as call, l.keyword as keyword from replace_keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let tzinfo_keyword_names = select keyword from keyword_names where name = "tzinfo";
let replacement_tzinfo_keywords = select l.call as call, l.keyword as keyword from replace_keywords as l join tzinfo_keyword_names as r on l.keyword = r.keyword;
let replacement_tzinfo_values = select l.call as call, r.value as value from replacement_tzinfo_keywords as l join keyword_value_fields as r on l.keyword = r.keyword;
let null_literals = select id from "literal-properties" where kind = "null";
let nonnull_tzinfo_values = antijoin(left=replacement_tzinfo_values, right=null_literals, left-on=["value"], right-on=["id"]);
let safe_replace_calls = select l.call as call from nonnull_tzinfo_values as l;
let safe_replace_candidates = select l.origin as call from direct_replace_calls as l join safe_replace_calls as r on l.replacement = r.call;
let safe_antipattern = select call from safe_replace_candidates;
let no_safe_replace = antijoin(left=unconverted_timezone, right=safe_antipattern, left-on=["call"], right-on=["call"]);
let reportable = select l.call as id, r.file as file, r.span as span from no_safe_replace as l join calls as r on l.call = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*DTZ007(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:DTZ007)(?:,|$)");
emit violations subject file key(id);
