import observation_matches from "python/ruff/suppress-matches";
let strings0 = select id, file, span from "syntax-tree" where kind = "string";
let strings = select l.id as id, l.file as file, l.span as span, r."start-line" as base_line from strings0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let raw_strings = source-matches(from=strings, span="span", pattern="(?i)^[a-z]*r[a-z]*", output="prefix");
let ordinary = antijoin(left=strings, right=raw_strings, left-on=["id", "file"], right-on=["id", "file"]);
let triple_double = source-matches(from=ordinary, span="span", base-line="base_line", pattern="(?s)^[a-zA-Z]*\x22\x22\x22(?P<body>.*)\x22\x22\x22$", output="whole", line-output="whole_line", capture="body", capture-output="body_span", capture-line-output="body_line");
let triple_single = source-matches(from=ordinary, span="span", base-line="base_line", pattern="(?s)^[a-zA-Z]*'''(?P<body>.*)'''$", output="whole", line-output="whole_line", capture="body", capture-output="body_span", capture-line-output="body_line");
let double_all = source-matches(from=ordinary, span="span", base-line="base_line", pattern="(?s)^[a-zA-Z]*\x22(?P<body>.*)\x22$", output="whole", line-output="whole_line", capture="body", capture-output="body_span", capture-line-output="body_line");
let single_all = source-matches(from=ordinary, span="span", base-line="base_line", pattern="(?s)^[a-zA-Z]*'(?P<body>.*)'$", output="whole", line-output="whole_line", capture="body", capture-output="body_span", capture-line-output="body_line");
let double_only = antijoin(left=double_all, right=triple_double, left-on=["id", "file"], right-on=["id", "file"]);
let single_only = antijoin(left=single_all, right=triple_single, left-on=["id", "file"], right-on=["id", "file"]);
let d3 = select id, file, body_span as span, body_line as base_line from triple_double;
let s3 = select id, file, body_span as span, body_line as base_line from triple_single;
let d1 = select id, file, body_span as span, body_line as base_line from double_only;
let s1 = select id, file, body_span as span, body_line as base_line from single_only;
let quoted3 = union(left=d3, right=s3);
let quoted1 = union(left=d1, right=s1);
let quoted = union(left=quoted3, right=quoted1);
let parts = select id, file from "syntax-tree" where kind = "f-string-part" or kind = "t-string-part";
let middles0 = select id, file, span from "syntax-tree" where kind = "fstring-middle" or kind = "tstring-middle";
let middles = select l.id as id, l.file as file, l.span as span, r."start-line" as base_line from middles0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let starts = select id, file, span from "syntax-tree" where kind = "fstring-start" or kind = "tstring-start";
let raw_starts = source-matches(from=starts, span="span", pattern="(?i)^[a-z]*r[a-z]*", output="prefix");
let nonraw_starts = antijoin(left=starts, right=raw_starts, left-on=["id", "file"], right-on=["id", "file"]);
let middle_owners = axis(from=middles, relation="syntax-child", direction=nearest-ancestor, domain=parts);
let start_owners = axis(from=nonraw_starts, relation="syntax-child", direction=nearest-ancestor, domain=parts);
let owned_middles = select l.id as id, l.span as span, l.base_line as base_line, l.file as file, r.related as owner from middles as l join middle_owners as r on l.id = r.id and l.file = r.file;
let owned_starts = select id, related as owner, file from start_owners;
let middle_segments = select l.id as id, l.file as file, l.span as span, l.base_line as base_line from owned_middles as l join owned_starts as r on l.owner = r.owner and l.file = r.file;
let segments = union(left=quoted, right=middle_segments);
let normal_runs0 = source-matches(from=segments, span="span", base-line="base_line", pattern="(?P<run>\\+)[^\\\r\n]", output="sequence", line-output="line", capture="run", capture-output="run_span", capture-text-output="run_text");
let normal_runs = select id, file, sequence, line, run_text from normal_runs0;
let middle_ends = span-bounds(from=middle_segments, span="span", start-output="begin", end-output="finish");
let braces0 = select id, file, span from "syntax-tree" where kind = "lbrace" or kind = "rbrace";
let braces = select l.id as id, l.file as file, l.span as span, r."start-byte" as begin from braces0 as l join "source-location" as r on l.id = r.id and l.file = r.file;
let adjacent = select l.id as id, l.file as file, l.span as middle_span, l.base_line as base_line, r.span as brace_span from middle_ends as l join braces as r on l.file = r.file and l.finish = r.begin;
let extended = span-between(from=adjacent, start="middle_span", end="brace_span", output="extended_span");
let boundary_runs0 = source-matches(from=extended, span="extended_span", base-line="base_line", pattern="(?P<run>\\+)[{}]$", output="sequence", line-output="line", capture="run", capture-output="run_span", capture-text-output="run_text");
let boundary_runs = select id, file, sequence, line, run_text from boundary_runs0;
let runs = union(left=normal_runs, right=boundary_runs);
let odd_runs = select id, file, sequence, line from runs where matches(run_text, "^(?:\\\\)*\\$");
let pairs0 = source-matches(from=odd_runs, span="sequence", base-line="line", pattern="(?P<escape>\\[^\\\r\n])$", output="whole", line-output="line_out", capture="escape", capture-output="escape_span", capture-text-output="escape_text");
let pairs = select id, file, escape_span as span, escape_text, line_out as line from pairs0;
let valid = select id, file, span from pairs where matches(escape_text, "^\\[\\'\x22abfnrtv0-7xNuU]$");
let invalid = antijoin(left=pairs, right=valid, left-on=["id", "file", "span"], right-on=["id", "file", "span"]);
let candidates = select id, file, span, line from invalid;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:W605)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "W605"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id, span);
