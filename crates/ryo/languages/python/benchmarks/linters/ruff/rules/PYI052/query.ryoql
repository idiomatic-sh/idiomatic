import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import enum_bases from "python/ruff/enum-bases";
import suppress from "python/ruff/suppress";

let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let assignment_targets = select parent as assignment, child as target, file from "semantic-child" where field = "targets";
let multi_target_pairs = select l.assignment as assignment, l.file as file from assignment_targets as l join assignment_targets as r on l.assignment = r.assignment and l.file = r.file where l.target != r.target;
let single_targets = antijoin(left=assignment_targets, right=multi_target_pairs, left-on=["assignment", "file"], right-on=["assignment", "file"]);
let simple_targets = select l.assignment as assignment, l.target as target, l.file as file from single_targets as l join "semantic-syntax" as r on l.target = r.id and l.file = r.file where r.kind = "name";
let variable_definitions = select id as target, name, owner as scope, file from "defines" where kind = "variable";
let module_scopes = select id as scope, file from "semantic-syntax" where kind = "module";
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let class_function_ancestors = axis(from=class_scopes, relation="semantic-child", direction=ancestor, domain=function_scopes);
let class_scopes_in_functions = select id, file from class_function_ancestors;
let variables = select l.assignment as assignment, l.target as target, r.name as name, r.scope as scope, l.file as file from simple_targets as l join variable_definitions as r on l.target = r.target and l.file = r.file;
let module_variables = select l.assignment as assignment, l.target as target, l.name as name, l.file as file from variables as l join module_scopes as r on l.scope = r.scope and l.file = r.file where l.name != "__all__";
let class_variables0 = select l.assignment as assignment, l.target as target, l.name as name, l.scope as scope, l.file as file from variables as l join class_scopes as r on l.scope = r.id and l.file = r.file where l.name != "__slots__" and l.name != "__match_args__";
let class_variables = antijoin(left=class_variables0, right=class_scopes_in_functions, left-on=["scope", "file"], right-on=["id", "file"]);
let target_bindings = select occurrence, ordinal, file from "binding-event" where kind = "bind";
let assignment_contexts = select l.target as context, l.scope as initial_scope, r.ordinal as point, l.file as file from class_variables as l join target_bindings as r on l.target = r.occurrence and l.file = r.file;
let all_enum_scopes = enum_bases(ordered_contexts=assignment_contexts);
let non_enum_class_variables = antijoin(left=class_variables, right=all_enum_scopes, left-on=["target", "scope", "file"], right-on=["context", "enum_class", "file"]);
let class_assignments = select assignment, target, name, file from non_enum_class_variables;
let eligible_scopes = union(left=module_variables, right=class_assignments);
let stub_assignments = select l.assignment as assignment, l.target as target, l.name as name, l.file as file from eligible_scopes as l join stub_files as r on l.file = r.file;
let assignment_values = select parent as assignment, child as value, file from "semantic-child" where field = "value";
let primitive_values = select id, file from "semantic-syntax" where kind = "constant" or kind = "list" or kind = "tuple" or kind = "set" or kind = "dict" or kind = "unary-op" or kind = "bin-op";
let eligible_values = select l.assignment as assignment, l.value as value, l.file as file from assignment_values as l join primitive_values as r on l.value = r.id and l.file = r.file;
let assignments_with_values = select l.target as target, l.name as name, r.value as value, l.file as file from stub_assignments as l join eligible_values as r on l.assignment = r.assignment and l.file = r.file;
let literal_kinds = select id, kind, file from "literal-properties" where kind = "integer" or kind = "float" or kind = "complex" or kind = "boolean" or kind = "string" or kind = "bytes";
let primitive_candidates = select l.value as id, l.file as file from assignments_with_values as l join literal_kinds as r on l.value = r.id and l.file = r.file;
let container_nodes = select id, file from "semantic-syntax" where kind = "list" or kind = "tuple" or kind = "set";
let container_elements = select l.parent as container, l.child as member, l.file as file from "semantic-child" as l join container_nodes as r on l.parent = r.id and l.file = r.file where l.field = "elts";
let all_element_counts = group-count(from=container_elements, keys=["container", "file"], count="count", distinct="member");
let literal_members = select l.container as container, l.member as member, l.file as file from container_elements as l join "literal-properties" as r on l.member = r.id and l.file = r.file;
let literal_element_counts = group-count(from=literal_members, keys=["container", "file"], count="count", distinct="member");
let valid_nonempty_container_counts = select l.container as container, l.file as file from all_element_counts as l join literal_element_counts as r on l.container = r.container and l.file = r.file where l.count = r.count and l.count <= 10;
let valid_nonempty_containers = select container as id, file from valid_nonempty_container_counts;
let empty_containers = antijoin(left=container_nodes, right=container_elements, left-on=["id", "file"], right-on=["container", "file"]);
let simple_containers = union(left=valid_nonempty_containers, right=empty_containers);
let dict_nodes = select id, file from "semantic-syntax" where kind = "dict";
let dict_keys = select l.parent as container, l.child as member, l.file as file from "semantic-child" as l join dict_nodes as r on l.parent = r.id and l.file = r.file where l.field = "keys";
let dict_values = select l.parent as container, l.child as member, l.file as file from "semantic-child" as l join dict_nodes as r on l.parent = r.id and l.file = r.file where l.field = "values";
let dict_key_counts = group-count(from=dict_keys, keys=["container", "file"], count="count", distinct="member");
let dict_value_counts = group-count(from=dict_values, keys=["container", "file"], count="count", distinct="member");
let dict_all_children = union(left=dict_keys, right=dict_values);
let dict_literal_children = select l.container as container, l.member as member, l.file as file from dict_all_children as l join "literal-properties" as r on l.member = r.id and l.file = r.file;
let matched_dict_counts = select l.container as container, l.file as file, l.count as keys, r.count as values from dict_key_counts as l join dict_value_counts as r on l.container = r.container and l.file = r.file where l.count = r.count and l.count <= 10;
let invalid_dict_children = antijoin(left=dict_all_children, right=dict_literal_children, left-on=["member", "file"], right-on=["member", "file"]);
let invalid_dict_parents = select container as id, file from invalid_dict_children;
let valid_dicts0 = antijoin(left=matched_dict_counts, right=invalid_dict_parents, left-on=["container", "file"], right-on=["id", "file"]);
let valid_dicts = select container as id, file from valid_dicts0;
let empty_dicts = antijoin(left=dict_nodes, right=dict_all_children, left-on=["id", "file"], right-on=["container", "file"]);
let simple_dicts = union(left=valid_dicts, right=empty_dicts);
let simple_container_candidates = union(left=simple_containers, right=simple_dicts);
let simple_container_assignments = select l.target as target, l.name as name, l.value as value, l.file as file from assignments_with_values as l join simple_container_candidates as r on l.value = r.id and l.file = r.file;
let container_candidate_rows = select value as id, file from simple_container_assignments;
let unary_nodes = select id, file from "semantic-syntax" where kind = "unary-op";
let unary_operands = select l.parent as unary, l.child as operand, l.file as file from "semantic-child" as l join unary_nodes as r on l.parent = r.id and l.file = r.file where l.field = "operand";
let unary_operators = select parent as unary, child as operator, file from "semantic-child" where field = "op";
let minus_tokens = select id, file from "syntax-tree" where text = "-";
let unary_minus = select l.unary as unary, l.file as file from unary_operators as l join minus_tokens as r on l.operator = r.id and l.file = r.file;
let numeric_literals = select id, kind, file from "literal-properties" where kind = "integer" or kind = "float" or kind = "complex";
let numeric_unary_operands = select l.unary as unary, l.file as file from unary_operands as l join numeric_literals as r on l.operand = r.id and l.file = r.file;
let unary_numeric_candidates = select l.unary as id, l.file as file from numeric_unary_operands as l join unary_minus as r on l.unary = r.unary and l.file = r.file;
let binary_nodes = select id, file from "semantic-syntax" where kind = "bin-op";
let binary_left = select l.parent as binary, l.child as left, l.file as file from "semantic-child" as l join binary_nodes as r on l.parent = r.id and l.file = r.file where l.field = "left";
let binary_right = select l.parent as binary, l.child as right, l.file as file from "semantic-child" as l join binary_nodes as r on l.parent = r.id and l.file = r.file where l.field = "right";
let binary_operators = select parent as binary, child as operator, file from "semantic-child" where field = "op";
let add_tokens = select id, file from "syntax-tree" where text = "+" or text = "-";
let numeric_locations = select l.id as literal, l.file as file, r."start-byte" as start, r."end-byte" as end from numeric_literals as l join "source-location" as r on l.id = r.id and l.file = r.file where l.kind = "integer" or l.kind = "float";
let short_number_tokens = select id, file from "syntax-tree" where matches(text, "^.{1,10}$");
let numeric_tokens = select l.id as token, l.file as file, r."start-byte" as start, r."end-byte" as end from short_number_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let short_numeric_literals = select l.literal as id, l.file as file from numeric_locations as l join numeric_tokens as r on l.start = r.start and l.end = r.end and l.file = r.file;
let numeric_binary_left = select l.binary as binary, l.file as file from binary_left as l join short_numeric_literals as r on l.left = r.id and l.file = r.file;
let unary_binary_left0 = select l.binary as binary, r.unary as unary, r.operand as operand, l.file as file from binary_left as l join unary_operands as r on l.left = r.unary and l.file = r.file;
let unary_binary_left1 = select l.binary as binary, l.operand as operand, l.file as file from unary_binary_left0 as l join unary_minus as r on l.unary = r.unary and l.file = r.file;
let unary_binary_left = select l.binary as binary, l.file as file from unary_binary_left1 as l join short_numeric_literals as r on l.operand = r.id and l.file = r.file;
let valid_binary_left = union(left=numeric_binary_left, right=unary_binary_left);
let complex_binary_right = select l.binary as binary, l.file as file from binary_right as l join "literal-properties" as r on l.right = r.id and l.file = r.file where r.kind = "complex";
let binary_with_valid_operands = select l.binary as binary, l.file as file from valid_binary_left as l join complex_binary_right as r on l.binary = r.binary and l.file = r.file;
let binary_operator_rows = select l.binary as binary, o.operator as operator, l.file as file from binary_with_valid_operands as l join binary_operators as o on l.binary = o.binary and l.file = o.file;
let complex_binary_candidates = select l.binary as id, l.file as file from binary_operator_rows as l join add_tokens as r on l.operator = r.id and l.file = r.file;
let negative_math_names = select id, file from "qualified-name" where path = "math.inf" or path = "math.e" or path = "math.pi" or path = "math.tau";
let unary_math_operands = select l.unary as unary, l.operand as operand, l.file as file from unary_operands as l join negative_math_names as r on l.operand = r.id and l.file = r.file;
let unary_math_candidates = select l.unary as id, l.file as file from unary_math_operands as l join unary_minus as r on l.unary = r.unary and l.file = r.file;
let with_unary_candidates = union(left=unary_numeric_candidates, right=unary_math_candidates);
let complex_expression_candidates = union(left=with_unary_candidates, right=complex_binary_candidates);
let complex_assignment_candidates = select l.value as id, l.file as file from assignments_with_values as l join complex_expression_candidates as r on l.value = r.id and l.file = r.file;
let with_container_candidates = union(left=complex_assignment_candidates, right=container_candidate_rows);
let all_primitive_candidates = union(left=primitive_candidates, right=with_container_candidates);
let locations = select id, file, span, "start-line" from "source-location";
let located = select l.id as id, l.file as file, r.span as span, r."start-line" as line from all_primitive_candidates as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="PYI052($|[, #])", range-pattern="(?:^|,)PYI052(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PYI052)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI052)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI052"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
