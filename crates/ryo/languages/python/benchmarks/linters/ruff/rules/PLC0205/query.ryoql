import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let classes = select id from "semantic-syntax" where kind = "class-def";
let bodies = select parent, child from "semantic-child" where field = "body";
let direct = select r.child as child from classes as l join bodies as r on l.id = r.parent;
let assignments = select id, file, span from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let statements = select r.id as id, r.file as file, r.span as span from direct as l join assignments as r on l.child = r.id;
let targets = select parent, child from "semantic-child" where field = "targets" or field = "target";
let name_fields = select parent, child from "semantic-child" where field = "id";
let slots = select id from semantic_identifiers where text = "__slots__";
let slot_names = select l.parent as id from name_fields as l join slots as r on l.child = r.id;
let slot_targets = select l.parent as parent from targets as l join slot_names as r on l.child = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let constants = select id from "semantic-syntax" where kind = "constant" or kind = "joined-str";
let strings = select l.occurrence as id from "string-literal" as l join constants as r on l.occurrence = r.id;
let string_values = select l.parent as parent from values as l join strings as r on l.child = r.id;
let bad_values = select l.parent as parent from slot_targets as l join string_values as r on l.parent = r.parent;
let reportable = select l.id as id, l.file as file, l.span as span from statements as l join bad_values as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLC0205(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLC0205)(?:,|$)");
emit violations subject file key(id);
