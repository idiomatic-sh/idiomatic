let import_nodes = select id, file, span from "semantic-syntax" where kind = "import-from";
let module_fields = select parent, child, file from "semantic-child" where field = "module";
let module_child_ranges = select l.parent as import, l.file as file, r."start-byte" as begin, r."end-byte" as finish from module_fields as l join "source-location" as r on l.child = r.id and l.file = r.file;
let future_module_tokens = select id, file from "syntax-tree" where text = "__future__";
let future_module_ranges = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from future_module_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let future_module_pairs = select l.import as id, l.file as file from module_child_ranges as l join future_module_ranges as r on l.file = r.file and l.begin = r.begin and l.finish = r.finish;
let relative_imports = select parent as id from "semantic-child" where field = "level";
let absolute_future_imports = antijoin(left=future_module_pairs,right=relative_imports,left-on=["id"],right-on=["id"]);
let future_statements = select l.id as id, l.file as file, r.span as span from absolute_future_imports as l join import_nodes as r on l.id = r.id and l.file = r.file;
let modules = select id, file from "semantic-syntax" where kind = "module";
let module_bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let module_body_nodes = select l.parent as module, l.child as id, l.ordinal as ordinal, r.file as file from module_bodies as l join modules as r on l.parent = r.id;
let module_statements = select l.module as module, l.id as id, l.ordinal as ordinal, l.file as file, r.kind as kind, r.span as span from module_body_nodes as l join "semantic-syntax" as r on l.id = r.id;
let earlier_module_body_rows = select l.parent as module, l.child as child, l.ordinal as ordinal from module_bodies as l join module_bodies as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first_module_bodies = antijoin(left=module_bodies,right=earlier_module_body_rows,left-on=["parent","child"],right-on=["module","child"]);
let first_module_exprs = select l.parent as module, l.child as id, r.child as value from first_module_bodies as l join "semantic-child" as r on l.child = r.parent where r.field = "value";
let exprs = select id from "semantic-syntax" where kind = "expr";
let first_exprs = select l.module as module, l.id as id, l.value as value from first_module_exprs as l join exprs as r on l.id = r.id;
let constants = select id, file from "semantic-syntax" where kind = "constant";
let first_constant_values = select l.module as module, l.id as statement, c.id as constant, c.file as file from first_exprs as l join constants as c on l.value = c.id;
let first_constant_ranges = select l.module as module, l.statement as statement, l.file as file, r."start-byte" as begin, r."end-byte" as finish from first_constant_values as l join "source-location" as r on l.constant = r.id;
let ordinary_string_tokens = select id, file from "syntax-tree" where kind = "string" and matches(text, "(?i)^[ru]*(?:\x22\x22\x22|'\x27\x27\x27|\x22|'\x27)");
let ordinary_string_ranges = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from ordinary_string_tokens as l join "source-location" as r on l.id = r.id;
let docstring_occurrences = select l.statement as id from first_constant_ranges as l join ordinary_string_ranges as r on l.file = r.file where r.begin >= l.begin and r.finish <= l.finish;
let docstring_rows = select id from docstring_occurrences;
let future_direct_statements = select l.module as module, l.id as id, l.ordinal as ordinal, l.file as file from module_statements as l join future_statements as r on l.id = r.id and l.file = r.file;
let nested_future_statements = antijoin(left=future_statements,right=module_statements,left-on=["id","file"],right-on=["id","file"]);
let nonfuture_module_statements = antijoin(left=module_statements,right=future_statements,left-on=["id","file"],right-on=["id","file"]);
let earlier_nonfuture = select module, id, ordinal from nonfuture_module_statements;
let non_docstring_boundaries = antijoin(left=earlier_nonfuture,right=docstring_rows,left-on=["id"],right-on=["id"]);
let prior_boundaries = select l.id as future, l.file as file from future_direct_statements as l join non_docstring_boundaries as r on l.module = r.module where r.ordinal < l.ordinal;
let late_direct_statements = select future as id, file from prior_boundaries;
let nested_future_imports = select id, file from nested_future_statements;
let late_statements = union(left=late_direct_statements,right=nested_future_imports);
let late_syntax_nodes = select l.id as id, l.file as file, r.span as span from late_statements as l join "semantic-syntax" as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from late_syntax_nodes as l join "source-location" as r on l.id = r.id;
let comments = select id, file, text from "syntax-tree" where kind = "comment";
let line_noqa_comments = select id, file from comments where matches(text, "(?i)^\s*#\s*(?:ruff\s*:\s*)?noqa(?:\s*:\s*F404(?:\s|,|#|$)|\s*(?:#.*)?$)");
let line_noqa_lines = select l.file as file, r."start-line" as line from line_noqa_comments as l join "source-location" as r on l.id = r.id;
let file_noqa_comments = select id, file from comments where matches(text, "(?i)^\s*#\s*ruff\s*:\s*noqa(?:\s*:\s*F404(?:\s|,|#|$)|\s*(?:#.*)?$)");
let unsuppressed_lines = antijoin(left=candidate_locations,right=line_noqa_lines,left-on=["file","line"],right-on=["file","line"]);
let unsuppressed_files = antijoin(left=unsuppressed_lines,right=file_noqa_comments,left-on=["file"],right-on=["file"]);
let violations = select id, file, span from unsuppressed_files;
emit violations subject file key(id);
