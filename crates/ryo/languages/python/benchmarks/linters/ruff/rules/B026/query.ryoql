import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let arguments = select parent, child, ordinal from "semantic-child" where field = "args";
let keywords = select parent, ordinal from "semantic-child" where field = "keywords";
let starred = select * from "semantic-syntax" where kind = "starred";
let late = select l.child as child from arguments as l join keywords as r on l.parent = r.parent where l.ordinal > r.ordinal;
let reportable = select r.id as id, r.file as file, r.span as span from late as l join starred as r on l.child = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:B026|RUF004)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B026|RUF004)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:B026|RUF004)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B026|RUF004)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B026"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
