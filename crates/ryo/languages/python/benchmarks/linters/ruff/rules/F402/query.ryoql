import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
import branch_arms from "python/ruff/branch-arms";
let nodes = select id, kind, file, span from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for";
let target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select l.id as loop, r.child as id, l.file as file from loops as l join target_fields as r on l.id = r.parent;
let tree_children = select child as id from "semantic-child";
let loop_target_walk = axis(from=loop_target_roots, relation="semantic-child", direction=descendant, domain=tree_children);
let loop_target_descendants = select loop, related as id, file from loop_target_walk;
let loop_target_ids = union(left=loop_target_roots, right=loop_target_descendants);
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let target_bindings = select l.loop as loop, r.occurrence as id, r.name as name, r.file as file from loop_target_ids as l join events as r on l.id = r.occurrence and l.file = r.file where r.kind = "bind";
let imports = select occurrence as id, file from "static-import";
let shadow_edges = select binding, previous, file, relationship from "binding-shadow";
let replaced_imports = select l.binding as id, l.previous as import, l.file as file from shadow_edges as l join imports as r on l.previous = r.id and l.file = r.file;
let shadow_pairs = select l.id as id, l.name as name, r.import as import, l.file as file from target_bindings as l join replaced_imports as r on l.id = r.id and l.file = r.file;
let loop_ends = select id, file from shadow_pairs;
let import_ends = select import as id, file from shadow_pairs;
let pair_ends = union(left=loop_ends, right=import_ends);
let arms = branch_arms(bindings=pair_ends);
let loop_arms = select p.id as id, p.import as import, b.owner as owner, b.arm as arm, b.arm_id as arm_id from shadow_pairs as p join arms as b on p.id = b.binding;
let import_arms = select p.id as id, p.import as import, b.owner as owner, b.arm as arm, b.arm_id as arm_id from shadow_pairs as p join arms as b on p.import = b.binding;
let loop_only_arms = antijoin(left=loop_arms, right=import_arms, left-on=["id", "import", "owner", "arm", "arm_id"], right-on=["id", "import", "owner", "arm", "arm_id"]);
let import_only_arms = antijoin(left=import_arms, right=loop_arms, left-on=["id", "import", "owner", "arm", "arm_id"], right-on=["id", "import", "owner", "arm", "arm_id"]);
let loop_only_pairs = select id, import from loop_only_arms;
let import_only_pairs = select id, import from import_only_arms;
let other_branch_pairs = union(left=loop_only_pairs, right=import_only_pairs);
let same_branch_pairs = antijoin(left=shadow_pairs, right=other_branch_pairs, left-on=["id", "import"], right-on=["id", "import"]);
let loop_import_shadows = select id, name, file from same_branch_pairs;
let reportable = select l.id as id, l.file as file, r.span as span from loop_import_shadows as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, code="F402");
let violations = antijoin(left=reportable, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","F402") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
