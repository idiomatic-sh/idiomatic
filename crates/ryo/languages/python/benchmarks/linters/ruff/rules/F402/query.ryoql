import observation_matches from "python/ruff/suppress-matches";
let nodes = select id, kind, file, span from "semantic-syntax";
let loops = select id, file from nodes where kind = "for" or kind = "async-for";
let target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select l.id as loop, r.child as id, l.file as file from loops as l join target_fields as r on l.id = r.parent;
let descendant_edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=descendant_edges, source="origin", destination="destination");
let loop_target_descendants = select l.loop as loop, r.destination as id, l.file as file from loop_target_roots as l join descendants as r on l.id = r.origin;
let loop_target_ids = union(left=loop_target_roots, right=loop_target_descendants);
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let target_bindings = select l.loop as loop, r.occurrence as id, r.name as name, r.file as file from loop_target_ids as l join events as r on l.id = r.occurrence and l.file = r.file where r.kind = "bind";
let imports = select occurrence as id, file from "static-import";
let shadow_edges = select binding, previous, file, relationship from "binding-shadow";
let replaced_imports = select l.binding as id, l.file as file from shadow_edges as l join imports as r on l.previous = r.id and l.file = r.file;
let loop_import_shadows = select l.id as id, l.name as name, l.file as file from target_bindings as l join replaced_imports as r on l.id = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from loop_import_shadows as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:F402)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "F402"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
