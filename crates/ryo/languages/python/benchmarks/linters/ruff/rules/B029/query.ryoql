import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let handlers = select * from "semantic-syntax" where kind = "except-handler";
let types = select parent, child from "semantic-child" where field = "type";
let tuples = select id from "semantic-syntax" where kind = "tuple";
let elements = select parent from "semantic-child" where field = "elts";
let empty = antijoin(left=tuples, right=elements, left-on=["id"], right-on=["parent"]);
let empty_types = select l.parent as parent from types as l join empty as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from handlers as l join empty_types as r on l.id = r.parent;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B029)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "B029"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
