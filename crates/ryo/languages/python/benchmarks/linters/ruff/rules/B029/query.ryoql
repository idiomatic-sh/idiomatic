import suppress from "python/ruff/suppress";
let handlers = select * from "semantic-syntax" where kind = "except-handler";
let types = select parent, child from "semantic-child" where field = "type";
let tuples = select id from "semantic-syntax" where kind = "tuple";
let elements = select parent from "semantic-child" where field = "elts";
let empty = antijoin(left=tuples, right=elements, left-on=["id"], right-on=["parent"]);
let empty_types = select l.parent as parent from types as l join empty as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from handlers as l join empty_types as r on l.id = r.parent;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B029(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B029)(?:,|$)");
emit violations subject file key(id);
