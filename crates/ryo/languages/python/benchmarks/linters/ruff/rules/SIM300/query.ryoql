import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/suppression-edges";
let nodes = select id, file, span, kind from "semantic-syntax";
let literals = select id, file from nodes where kind = "constant";
let cased_names = select id, file from "identifier" where matches(name, "\p{Lu}|\p{Lt}");
let lowercase_names = select id, file from "identifier" where matches(name, "\p{Ll}");
let identifiers = antijoin(left=cased_names, right=lowercase_names, left-on=[id, file], right-on=[id, file]);
let names = select l.id as id, l.file as file from nodes as l join identifiers as r on l.id = r.id and l.file = r.file where l.kind = "name";
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let attributes = select l.parent as id, l.file as file from attr_fields as l join identifiers as r on l.child = r.id and l.file = r.file;
let named = union(left=names, right=attributes);
let atoms = union(left=literals, right=named);
let math_ops = select id, file from "semantic-syntax" where text = "+" or text = "-" or text = "~";
let op_fields = select parent, child, file from "semantic-child" where field = "op";
let math_unary_ids = select l.parent as id, l.file as file from op_fields as l join math_ops as r on l.child = r.id and l.file = r.file;
let unary = select l.id as id, l.file as file from nodes as l join math_unary_ids as r on l.id = r.id and l.file = r.file where l.kind = "unary-op";
let ordinary_composites = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "dict" or kind = "bin-op";
let composites = union(left=ordinary_composites, right=unary);
let value_fields = select parent, child, file from "semantic-child" where field = "elts" or field = "keys" or field = "values" or field = "key" or field = "value" or field = "left" or field = "right" or field = "operand";
let value_edges = select l.id as origin, r.child as destination from composites as l join value_fields as r on l.id = r.parent and l.file = r.file;
let descendants = closure(edges=value_edges, source="origin", destination="destination");
let admitted = union(left=atoms, right=composites);
let zero_nodes = antijoin(left=nodes, right=admitted, left-on=[id, file], right-on=[id, file]);
let weak_nodes = antijoin(left=nodes, right=literals, left-on=[id, file], right-on=[id, file]);
let weak_leaves = antijoin(left=weak_nodes, right=composites, left-on=[id, file], right-on=[id, file]);
let zero_desc = select l.origin as id from descendants as l join zero_nodes as r on l.destination = r.id;
let weak_desc = select l.origin as id from descendants as l join weak_leaves as r on l.destination = r.id;
let possible = antijoin(left=admitted, right=zero_desc, left-on=[id], right-on=[id]);
let definite_composites = antijoin(left=composites, right=weak_desc, left-on=[id], right-on=[id]);
let definite = union(left=literals, right=definite_composites);
let nondefinite = antijoin(left=possible, right=definite, left-on=[id, file], right-on=[id, file]);
let high = extend(from=definite, values={rank: 2});
let medium = extend(from=nondefinite, values={rank: 1});
let positive = union(left=high, right=medium);
let low_nodes = antijoin(left=nodes, right=positive, left-on=[id, file], right-on=[id, file]);
let low_ids = select id, file from low_nodes;
let low = extend(from=low_ids, values={rank: 0});
let ranks = union(left=positive, right=low);
let operators = select parent, child, file from "semantic-child" where field = "ops";
let counts = group-count(from=operators, keys=[parent, file], count="count");
let single = select parent, file from counts where count = 1;
let wanted = select id, file from "semantic-syntax" where text = "==" or text = "!=" or text = "<" or text = "<=" or text = ">" or text = ">=";
let ordinary_ops = select l.parent as parent, l.file as file from operators as l join wanted as r on l.child = r.id and l.file = r.file;
let comparisons = select l.parent as id, l.file as file from ordinary_ops as l join single as r on l.parent = r.parent and l.file = r.file;
let left_fields = select parent, child, file from "semantic-child" where field = "left";
let right_fields = select parent, child, file from "semantic-child" where field = "comparators";
let left_ranks = select l.parent as id, l.file as file, r.rank as rank from left_fields as l join ranks as r on l.child = r.id and l.file = r.file;
let right_ranks = select l.parent as id, l.file as file, r.rank as rank from right_fields as l join ranks as r on l.child = r.id and l.file = r.file;
let reversed = select l.id as id, l.file as file from left_ranks as l join right_ranks as r on l.id = r.id and l.file = r.file where l.rank > r.rank;
let eligible = select l.id as id, l.file as file from reversed as l join comparisons as r on l.id = r.id and l.file = r.file;
let located = select l.id as id, l.file as file, r.span as span, r."start-line" as line from eligible as l join "source-location" as r on l.id = r.id and l.file = r.file;
let mappings = noqa_line_map();
let locations = noqa_locations(candidates=located, mappings=mappings);
let additional = select id, file, line from located where id != id;
let matches = suppression_edges(candidates=located, locations=locations, additional_locations=additional, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM300)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM300)(?:,|$)");
let violations = antijoin(left=locations, right=matches, left-on=[id, span], right-on=[id, span]);
let matched = select directive, file from matches where scope = 0 or scope = 1;
let noqa_matches = extend(from=matched, values={code: "SIM300"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
