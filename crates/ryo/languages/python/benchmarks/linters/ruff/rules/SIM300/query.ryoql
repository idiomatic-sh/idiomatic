import noqa_line_map from "python/ruff/noqa-line-map";
import noqa_locations from "python/ruff/noqa-locations";
import suppression_edges from "python/ruff/noqa-suppressions-with-additional-lines";
let nodes = select id, file, span, kind from "semantic-syntax";
let compares = select id, file from nodes where kind = "compare";
let op_rows = select l.id as id, r.child as op, l.file as file from compares as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "ops";
let counts = group-count(from=op_rows, keys=[id, file], count="count");
let single = select id, file from counts where count = 1;
let wanted_ops = select l.id as id, l.file as file from op_rows as l join "semantic-syntax" as r on l.op = r.id and l.file = r.file where r.text in ["==", "!=", "<", "<=", ">", ">="];
let comparisons = select l.id as id, l.file as file from wanted_ops as l join single as r on l.id = r.id and l.file = r.file;
let left_ops = select l.id as compare, r.child as id, l.file as file from comparisons as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "left";
let right_ops = select l.id as compare, r.child as id, l.file as file from comparisons as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "comparators";
let left_ids = select id, file from left_ops;
let right_ids = select id, file from right_ops;
let operands = union(left=left_ids, right=right_ids);
let literals = select id, file from nodes where kind = "constant";
let cased_names = select id, file from "identifier" where matches(name, "\p{Lu}|\p{Lt}");
let lowercase_names = select id, file from "identifier" where matches(name, "\p{Ll}");
let identifiers = antijoin(left=cased_names, right=lowercase_names, left-on=[id, file], right-on=[id, file]);
let names = select l.id as id, l.file as file from nodes as l join identifiers as r on l.id = r.id and l.file = r.file where l.kind = "name";
let attr_fields = select parent, child, file from "semantic-child" where field = "attr";
let attributes = select l.parent as id, l.file as file from attr_fields as l join identifiers as r on l.child = r.id and l.file = r.file;
let named = union(left=names, right=attributes);
let atoms = union(left=literals, right=named);
let math_ops = select id, file from "semantic-syntax" where text = "+" or text = "-" or text = "~";
let op_fields = select parent, child, file from "semantic-child" where field = "op";
let math_unary_ids = select l.parent as id, l.file as file from op_fields as l join math_ops as r on l.child = r.id and l.file = r.file;
let unary = select l.id as id, l.file as file from nodes as l join math_unary_ids as r on l.id = r.id and l.file = r.file where l.kind = "unary-op";
let ordinary_composites = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "dict" or kind = "bin-op";
let composites = union(left=ordinary_composites, right=unary);
let value_fields = select parent, child, file from "semantic-child" where field in ["elts", "keys", "values", "key", "value", "left", "right", "operand"];
let value_edges = select l.id as origin, r.child as destination from composites as l join value_fields as r on l.id = r.parent and l.file = r.file;
let descendants = closure(edges=value_edges, source="origin", destination="destination");
let admitted = union(left=atoms, right=composites);
let solid = union(left=literals, right=composites);
let operand_descendants = select l.id as id, r.destination as member, l.file as file from operands as l join descendants as r on l.id = r.origin;
let unadmitted_members = antijoin(left=operand_descendants, right=admitted, left-on=[member, file], right-on=[id, file]);
let weak_members = antijoin(left=operand_descendants, right=solid, left-on=[member, file], right-on=[id, file]);
let zero_desc = select id, file from unadmitted_members;
let weak_desc = select id, file from weak_members;
let operand_literals = select l.id as id, l.file as file from operands as l join literals as r on l.id = r.id and l.file = r.file;
let operand_composites = select l.id as id, l.file as file from operands as l join composites as r on l.id = r.id and l.file = r.file;
let operand_admitted = select l.id as id, l.file as file from operands as l join admitted as r on l.id = r.id and l.file = r.file;
let possible = antijoin(left=operand_admitted, right=zero_desc, left-on=[id, file], right-on=[id, file]);
let definite_composites = antijoin(left=operand_composites, right=weak_desc, left-on=[id, file], right-on=[id, file]);
let definite = union(left=operand_literals, right=definite_composites);
let nondefinite = antijoin(left=possible, right=definite, left-on=[id, file], right-on=[id, file]);
let high = extend(from=definite, values={rank: 2});
let medium = extend(from=nondefinite, values={rank: 1});
let positive = union(left=high, right=medium);
let low_ids = antijoin(left=operands, right=positive, left-on=[id, file], right-on=[id, file]);
let low = extend(from=low_ids, values={rank: 0});
let ranks = union(left=positive, right=low);
let left_ranks = select l.compare as id, l.file as file, r.rank as rank from left_ops as l join ranks as r on l.id = r.id and l.file = r.file;
let right_ranks = select l.compare as id, l.file as file, r.rank as rank from right_ops as l join ranks as r on l.id = r.id and l.file = r.file;
let eligible = select l.id as id, l.file as file from left_ranks as l join right_ranks as r on l.id = r.id and l.file = r.file where l.rank > r.rank;
let located = select l.id as id, l.file as file, r.span as span, r."start-line" as line from eligible as l join "source-location" as r on l.id = r.id and l.file = r.file;
let mappings = noqa_line_map();
let locations = noqa_locations(candidates=located, mappings=mappings);
let additional = select id, file, line from located where id != id;
let matches = suppression_edges(candidates=located, locations=locations, additional_locations=additional, codes="^(?:SIM300)$");
let violations = antijoin(left=locations, right=matches, left-on=[id, span], right-on=[id, span]);
let matched = select directive, file from matches where scope < 2;
let noqa_matches = extend(from=matched, values={code: "SIM300"});
observe noqa_matches as noqa_matches;
emit violations subject file key(id);
