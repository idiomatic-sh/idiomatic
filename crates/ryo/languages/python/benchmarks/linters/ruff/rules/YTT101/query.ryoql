import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let qnames = select id, file from "qualified-name" where path = "sys.version";
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let value_fields = select parent, child from "semantic-child" where field = "value";
let values = select l.parent as subscript, l.child as value, r.file as file from value_fields as l join subscripts as r on l.parent = r.id;
let target_subscripts = select l.subscript as subscript, l.file as file from values as l join qnames as r on l.value = r.id and l.file = r.file;
let slice_fields = select parent, child from "semantic-child" where field = "slice";
let slices = select l.parent as subscript, l.child as slice, r.file as file from slice_fields as l join target_subscripts as r on l.parent = r.subscript;
let slice_nodes = select id, file from "semantic-syntax" where kind = "slice";
let checked_slices = select l.slice as slice, l.file as file from slices as l join slice_nodes as r on l.slice = r.id and l.file = r.file;
let upper_fields = select parent, child from "semantic-child" where field = "upper";
let upper_bounds = select l.parent as slice, l.child as upper, r.file as file from upper_fields as l join checked_slices as r on l.parent = r.slice;
let lower_fields = select parent as slice from "semantic-child" where field = "lower";
let step_fields = select parent as slice from "semantic-child" where field = "step";
let no_lower = antijoin(left=checked_slices, right=lower_fields, left-on=["slice"], right-on=["slice"]);
let simple_slices = antijoin(left=no_lower, right=step_fields, left-on=["slice"], right-on=["slice"]);
let present_upper = select l.slice as slice, l.upper as upper, l.file as file from upper_bounds as l join simple_slices as r on l.slice = r.slice and l.file = r.file;
let bound_literals = select id, file from "semantic-syntax" where kind = "number" and matches(text, "^(?:3|0[xX]_?3|0[oO]_?3|0[bB]_?1_?1)$");
let upper_roots = select upper as id, file from present_upper;
let upper_literal_axes = axis(from=upper_roots, relation="semantic-child", direction=child, domain=bound_literals);
let selected_slices = select l.slice as id, l.file as file from present_upper as l join upper_literal_axes as r on l.upper = r.id and l.file = r.file;
let selected_subscripts = select r.subscript as id, l.file as file from selected_slices as l join slices as r on l.id = r.slice and l.file = r.file;
let selected_values = select r.value as id, l.file as file from selected_subscripts as l join values as r on l.id = r.subscript and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from selected_values as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*YTT101(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:YTT101)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:YTT101)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:YTT101)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "YTT101"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
