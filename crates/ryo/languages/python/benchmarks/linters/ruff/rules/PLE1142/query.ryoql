import observation_matches from "python/ruff/suppress-matches";
import evaluation_regions from "python/ruff/python-evaluation-regions";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let all_regions = evaluation_regions();
let regions = select id, kind, file from all_regions where kind != "list-comp" and kind != "set-comp" and kind != "dict-comp";
let await_inputs = select id, file from nodes where kind = "await" or kind = "async-for" or kind = "async-with";
let clauses = select id, file from nodes where kind = "comprehension";
let async_flags = select parent as id, file from "semantic-child" where field = "is-async";
let async_clauses = select l.id as id, l.file as file from clauses as l join async_flags as r on l.id = r.id and l.file = r.file;
let generators = select id, file from nodes where kind = "generator-exp";
let generator_clauses = select r.child as id, l.file as file from generators as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "generators";
let eager_async_clauses = antijoin(left=async_clauses, right=generator_clauses, left-on=["id", "file"], right-on=["id", "file"]);
let inputs0 = union(left=await_inputs, right=eager_async_clauses);
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_nested = axis(from=inputs0, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let embedded_descendants = select id, file from embedded_nested;
let embedded_own = select l.id as id, l.file as file from inputs0 as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let embedded = union(left=embedded_descendants, right=embedded_own);
let inputs = antijoin(left=inputs0, right=embedded, left-on=["id", "file"], right-on=["id", "file"]);
let nearest = axis(from=inputs, relation="semantic-child", direction=nearest-ancestor, domain=regions);
let nested = select l.id as id, r.kind as kind, l.file as file from nearest as l join regions as r on l.related = r.id and l.file = r.file;
let direct = select l.id as id, r.kind as kind, l.file as file from inputs as l join regions as r on l.id = r.id and l.file = r.file;
let nested_only = antijoin(left=nested, right=direct, left-on=["id", "file"], right-on=["id", "file"]);
let contexts = union(left=nested_only, right=direct);
let permitted = select id, file from contexts where kind = "async-function-def" or kind = "generator-exp";
let reportable = antijoin(left=inputs, right=permitted, left-on=["id", "file"], right-on=["id", "file"]);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE1142(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1142)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])PLE1142(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLE1142)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE1142"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
