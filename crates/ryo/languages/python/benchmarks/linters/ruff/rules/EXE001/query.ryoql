import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let not_executable = select path as file from "filesystem.executable" where executable = "false";
let comments = select id, file, span from "syntax-tree" where kind = "comment" and matches(text, "^#!");
let reportable = select l.id as id, l.file as file, l.span as span from comments as l join not_executable as r on l.file = r.file;
let candidates = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])EXE001(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:EXE001)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:EXE001)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:EXE001)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "EXE001"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
