import suppress from "python/ruff/suppress";
let not_executable = select path as file from "filesystem.executable" where executable = "false";
let comments = select id, file, span from "syntax-tree" where kind = "comment" and matches(text, "^#!");
let reportable = select l.id as id, l.file as file, l.span as span from comments as l join not_executable as r on l.file = r.file;
let candidates = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])EXE001(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:EXE001)(?:,|$)");
emit violations subject file key(id);
