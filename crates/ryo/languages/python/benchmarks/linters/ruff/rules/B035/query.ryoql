import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let comprehensions = select id, file from "semantic-syntax" where kind = "dict-comp";
let keys = select parent, child, file from "semantic-child" where field = "key";
let comprehension_keys = select l.id as comprehension, r.child as key, l.file as file from comprehensions as l join keys as r on l.id = r.parent and l.file = r.file;
let literal_keys = select l.key as id, l.file as file, r.span as span from comprehension_keys as l join "literal-properties" as r on l.key = r.id and l.file = r.file;
let constant_keys = select id, file from "constant-key";
let shaped_keys = select l.key as id, l.file as file from comprehension_keys as l join constant_keys as r on l.key = r.id and l.file = r.file;
let shaped_literals = select l.id as id, l.file as file, r.span as span from shaped_keys as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let key_names = select l.key as id, l.file as file, r.span as span from comprehension_keys as l join "semantic-syntax" as r on l.key = r.id and l.file = r.file where r.kind = "name";
let identifiers = select id, name, file from "identifier";
let named_keys = select l.id as id, l.file as file, l.span as span, r.name as name from key_names as l join identifiers as r on l.id = r.id and l.file = r.file;
let comprehension_bindings = select l.id as comprehension, r.occurrence as binding, r.name as name, l.file as file from comprehensions as l join "binding-event" as r on l.id = r.scope and l.file = r.file where r.kind = "bind";
let bound_comprehension_names = select name, file from comprehension_bindings;
let static_named_keys_all = antijoin(left=named_keys, right=bound_comprehension_names, left-on=["name","file"], right-on=["name","file"]);
let static_named_keys = select id, file, span from static_named_keys_all;
let key_attributes = select l.key as id, l.file as file, r.span as span from comprehension_keys as l join "semantic-syntax" as r on l.key = r.id and l.file = r.file where r.kind = "attribute";
let attribute_values = select parent, child, file from "semantic-child" where field = "value";
let attribute_bases = select l.id as attribute, r.child as base, l.file as file, l.span as span from key_attributes as l join attribute_values as r on l.id = r.parent and l.file = r.file;
let named_attribute_bases = select l.attribute as attribute, l.file as file, l.span as span, r.name as name from attribute_bases as l join identifiers as r on l.base = r.id and l.file = r.file;
let static_attributes_all = antijoin(left=named_attribute_bases, right=bound_comprehension_names, left-on=["name","file"], right-on=["name","file"]);
let static_attributes = select attribute as id, file, span from static_attributes_all;
let static_names_and_attributes = union(left=static_named_keys, right=static_attributes);
let literal_and_tuple_keys = union(left=literal_keys, right=shaped_literals);
let all_literals_and_names = union(left=literal_and_tuple_keys, right=static_names_and_attributes);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from all_literals_and_names as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B035(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B035)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*B035(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B035)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "B035"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
