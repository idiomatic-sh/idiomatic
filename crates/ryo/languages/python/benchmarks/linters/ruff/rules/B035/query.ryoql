import observation_matches from "python/ruff/suppress-matches";
let comprehensions = select id, file from "semantic-syntax" where kind = "dict-comp";
let keys = select parent, child, file from "semantic-child" where field = "key";
let comprehension_keys = select l.id as comprehension, r.child as key, l.file as file from comprehensions as l join keys as r on l.id = r.parent and l.file = r.file;
let syntax_nodes = select id, kind, file, span from "semantic-syntax";
let key_ids = select key as id, file from comprehension_keys;
let all_nodes = select id from syntax_nodes;
let key_descendants = axis(from=key_ids, relation="semantic-child", direction=descendant, domain=all_nodes);
let key_inner_nodes = select id as key, related as node, file from key_descendants;
let key_self_nodes = select id as key, id as node, file from key_ids;
let key_nodes = union(left=key_inner_nodes, right=key_self_nodes);
let typed_key_nodes = select l.key as key, l.node as node, r.kind as kind, l.file as file from key_nodes as l join syntax_nodes as r on l.node = r.id and l.file = r.file;
let dynamic_nodes = select key, file from typed_key_nodes where kind in ["call", "compare", "if-exp", "slice", "joined-str", "template-str", "lambda", "list", "set", "dict", "list-comp", "set-comp", "dict-comp", "generator-exp", "named-expr", "await", "yield", "yield-from", "starred"];
let key_names = select l.key as key, l.node as node, l.file as file from typed_key_nodes as l where l.kind = "name";
let identifiers = select id, name, file from "identifier";
let named_key_nodes = select l.key as key, r.name as name, l.file as file from key_names as l join identifiers as r on l.node = r.id and l.file = r.file;
let keyed_names = select l.comprehension as comprehension, r.key as key, r.name as name, l.file as file from comprehension_keys as l join named_key_nodes as r on l.key = r.key and l.file = r.file;
let bind_occurrences = select occurrence as id, name, file from "binding-event" where kind = "bind";
let comprehension_binds = axis(from=comprehensions, relation="semantic-child", direction=descendant, domain=bind_occurrences);
let comprehension_bound = select l.id as comprehension, r.name as name, l.file as file from comprehension_binds as l join bind_occurrences as r on l.related = r.id and l.file = r.file;
let bound_keys = select l.key as key, l.file as file from keyed_names as l join comprehension_bound as r on l.comprehension = r.comprehension and l.name = r.name and l.file = r.file;
let unbound_keys = antijoin(left=key_ids, right=bound_keys, left-on=["id", "file"], right-on=["key", "file"]);
let static_keys = antijoin(left=unbound_keys, right=dynamic_nodes, left-on=["id", "file"], right-on=["key", "file"]);
let all_literals_and_names = select l.id as id, l.file as file, r.span as span from static_keys as l join syntax_nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from all_literals_and_names as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B035|RUF011)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "B035"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
