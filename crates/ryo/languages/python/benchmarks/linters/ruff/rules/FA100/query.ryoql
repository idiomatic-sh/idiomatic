import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
import annotation_context from "python/ruff/annotation-evaluation-context";
import annotation_origins from "python/ruff/annotation-origins";
let nodes = select id, kind, file, span from "semantic-syntax";
let reference_nodes = select id, file from nodes where kind = "name" or kind = "attribute";
let resolved_origins = annotation_origins(expressions=reference_nodes);
let legacy_symbols = select id, file from resolved_origins where matches(path, "^(?:typing[.](?:Dict|FrozenSet|List|Set|Tuple|Type|Deque|DefaultDict)|typing_extensions[.](?:Type|Deque|DefaultDict))$");
let old_generic_files = select file from "language-target" where major = 3 and minor >= 7 and minor < 9;
let generic_candidates = select l.id as id, l.file as file from legacy_symbols as l join old_generic_files as r on l.file = r.file;
let union_symbols = select id, file from resolved_origins where path = "typing.Optional" or path = "typing.Union" or path = "typing_extensions.Optional" or path = "typing_extensions.Union";
let subscript_values = select parent, child, file from "semantic-child" where field = "value";
let union_owners0 = select l.parent as owner, l.child as id, l.file as file from subscript_values as l join union_symbols as r on l.child = r.id and l.file = r.file;
let subscripts = select id, file from nodes where kind = "subscript";
let union_owners = select l.owner as owner, l.id as id, l.file as file from union_owners0 as l join subscripts as r on l.owner = r.id and l.file = r.file;
let slices = select parent, child, file from "semantic-child" where field = "slice";
let union_slices = select l.owner as owner, l.id as id, r.child as slice, l.file as file from union_owners as l join slices as r on l.owner = r.parent and l.file = r.file;
let tuples = select id, file from nodes where kind = "tuple";
let slice_tuples = select l.owner as owner, l.id as id, l.slice as slice, l.file as file from union_slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_elements = select l.owner as owner, l.id as id, r.child as member, l.file as file from slice_tuples as l join "semantic-child" as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let scalar_slices0 = antijoin(left=union_slices, right=tuples, left-on=["slice","file"], right-on=["id","file"]);
let scalar_slices = select owner, id, slice as member, file from scalar_slices0;
let members = union(left=tuple_elements, right=scalar_slices);
let starred = select id, file from nodes where kind = "starred";
let starred_owners = select l.owner as owner, l.file as file from members as l join starred as r on l.member = r.id and l.file = r.file;
let string_literals = select id, file from "literal-properties" where kind = "string";
let quoted_owners = select l.owner as owner, l.file as file from members as l join string_literals as r on l.member = r.id and l.file = r.file;
let union_contexts = annotation_context(expressions=union_symbols);
let eager_union_symbols = select id, file from union_contexts where evaluation = "eager";
let eager_quoted_owners = select l.owner as owner, l.file as file from union_owners as l join eager_union_symbols as r on l.id = r.id and l.file = r.file;
let quoted_runtime0 = select l.owner as owner, l.file as file from eager_quoted_owners as l join quoted_owners as r on l.owner = r.owner and l.file = r.file;
let ifs = select id, file from nodes where kind = "if";
let tests = select l.id as id, r.child as test, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let tc_origins = select id, file from resolved_origins where path = "typing.TYPE_CHECKING" or path = "typing_extensions.TYPE_CHECKING";
let tc_plain = select id, file from "identifier" where name = "TYPE_CHECKING";
let tc_flags = union(left=tc_origins, right=tc_plain);
let tc_ifs = select l.id as id, l.file as file from tests as l join tc_flags as r on l.test = r.id and l.file = r.file;
let tc_bodies = select r.child as id, l.file as file from tc_ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let quoted_owner_nodes = select owner as id, file from quoted_runtime0;
let tc_quoted_axes = axis(from=quoted_owner_nodes, relation="semantic-child", direction=ancestor, domain=tc_bodies);
let tc_quoted_nodes = select id, file from tc_quoted_axes;
let quoted_runtime = antijoin(left=quoted_runtime0, right=tc_quoted_nodes, left-on=["owner","file"], right-on=["id","file"]);
let invalid_owners = union(left=starred_owners, right=quoted_runtime);
let usable_unions = antijoin(left=union_owners, right=invalid_owners, left-on=["owner","file"], right-on=["owner","file"]);
let old_union_files = select file from "language-target" where major = 3 and minor >= 7 and minor < 10;
let union_candidates = select l.id as id, l.file as file from usable_unions as l join old_union_files as r on l.file = r.file;
let possible = union(left=generic_candidates, right=union_candidates);
let contexts = annotation_context(expressions=possible);
let ordinary_eligible = select id, file from contexts where evaluation = "eager" or evaluation = "unevaluated";
let embeddings = select root, host, file from "embedded-expression";
let embedded_roots = select root as id, file from embeddings;
let embedded_axes = axis(from=possible, relation="semantic-child", direction=nearest-ancestor, domain=embedded_roots);
let nested_roots = select id, related as root, file from embedded_axes;
let own_roots = select l.id as id, l.id as root, l.file as file from possible as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let member_roots = union(left=nested_roots, right=own_roots);
let embedded_hosts = select l.id as id, e.host as host, l.file as file from member_roots as l join embeddings as e on l.root = e.root and l.file = e.file;
let host_nodes = select host as id, file from embedded_hosts;
let host_contexts = annotation_context(expressions=host_nodes);
let eligible_hosts = select id, file from host_contexts where evaluation = "eager" or evaluation = "unevaluated";
let embedded_eligible = select l.id as id, l.file as file from embedded_hosts as l join eligible_hosts as r on l.host = r.id and l.file = r.file;
let eligible = union(left=ordinary_eligible, right=embedded_eligible);
let future_files = select file from "compiler-feature" where feature = "python.future-annotations" and enabled = "true";
let no_future = antijoin(left=eligible, right=future_files, left-on=["file"], right-on=["file"]);
let selected = select id, file from no_future where matches(file, "[.]py$");
let candidates = select l.id as id, l.file as file, r.span as span from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let located = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=located, inline-pattern="(?:^|[^A-Z0-9])FA100(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FA100)(?:,|$)");
let ruf100_matches = observation_matches(candidates=located, inline-pattern="(?:^|[^A-Z0-9])FA100(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FA100)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "FA100"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
