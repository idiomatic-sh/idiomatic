import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
let calls = call_syntax();
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function from function_fields as l join calls as r on l.parent = r.id;
let warns_names = select id from "qualified-name" where path = "pytest.warns";
let warns_calls = select l.call as call from call_functions as l join warns_names as r on l.function = r.id;
let with_nodes = select id, file, span from "semantic-syntax" where kind = "with";
let item_fields = select parent, child from "semantic-child" where field = "items";
let with_items = select l.id as owner, r.child as item from with_nodes as l join item_fields as r on l.id = r.parent;
let context_fields = select parent, child from "semantic-child" where field = "context-expr";
let item_contexts = select l.item as item, r.child as context from with_items as l join context_fields as r on l.item = r.parent;
let warns_items = select l.item as item from item_contexts as l join warns_calls as r on l.context = r.call;
let warns_with = select l.owner as id from with_items as l join warns_items as r on l.item = r.item;
let body_fields = select parent, child from "semantic-child" where field = "body";
let with_body = select l.id as owner, r.child as statement from warns_with as l join body_fields as r on l.id = r.parent;
let body_counts = group-count(from=with_body, keys=["owner"], count="count", distinct="statement");
let multiple_body = select owner as id from body_counts where count > 1;
let one_body = select l.owner as owner, l.statement as statement from with_body as l join body_counts as r on l.owner = r.owner where r.count = 1;
let statement_kinds = select id, kind from "semantic-syntax";
let direct_statements = select l.owner as owner, l.statement as statement, r.kind as kind from one_body as l join statement_kinds as r on l.statement = r.id;
let simple_compounds = select owner as id from direct_statements where kind = "if" or kind = "while" or kind = "match" or kind = "try";
let loops = select owner as id, statement as loop from direct_statements where kind = "for";
let loop_body = select l.loop as loop, r.child as statement from loops as l join body_fields as r on l.loop = r.parent;
let loop_counts = group-count(from=loop_body, keys=["loop"], count="count", distinct="statement");
let loop_pass = select l.loop as loop from loop_body as l join statement_kinds as r on l.statement = r.id where r.kind = "pass";
let expressions = select id from statement_kinds where kind = "expr";
let expression_values = select l.id as expression, r.child as value from expressions as l join "semantic-child" as r on l.id = r.parent where r.field = "value";
let expression_value_locations = select l.expression as expression, r.file as file, r."start-byte" as begin, r."end-byte" as finish from expression_values as l join "source-location" as r on l.value = r.id;
let ellipsis_tokens = select id, file from "syntax-tree" where text = "...";
let ellipsis_locations = select l.file as file, r."start-byte" as begin, r."end-byte" as finish from ellipsis_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let ellipsis_expressions = select l.expression as expression from expression_value_locations as l join ellipsis_locations as r on l.file = r.file and l.begin = r.begin and l.finish = r.finish;
let loop_ellipsis = select l.loop as loop from loop_body as l join ellipsis_expressions as r on l.statement = r.expression;
let allowed_loop_bodies = union(left=loop_pass, right=loop_ellipsis);
let allowed_single_loops = select l.loop as loop from loop_counts as l join allowed_loop_bodies as r on l.loop = r.loop where l.count = 1;
let bad_single_loops = antijoin(left=loop_counts, right=allowed_single_loops, left-on=["loop"], right-on=["loop"]);
let loops_bad = select l.id as id from loops as l join bad_single_loops as r on l.loop = r.loop;
let nested_with = select owner as id, statement as inner_with from direct_statements where kind = "with";
let nested_with_body = select l.inner_with as inner_with, r.child as statement from nested_with as l join body_fields as r on l.inner_with = r.parent;
let nested_with_counts = group-count(from=nested_with_body, keys=["inner_with"], count="count", distinct="statement");
let nested_with_many = select inner_with as id from nested_with_counts where count > 1;
let nested_with_one = select l.inner_with as inner_with, l.statement as statement from nested_with_body as l join nested_with_counts as r on l.inner_with = r.inner_with where r.count = 1;
let nested_compounds = select id from statement_kinds where kind = "if" or kind = "while" or kind = "match" or kind = "try" or kind = "with" or kind = "for" or kind = "class-def" or kind = "function-def" or kind = "async-function-def";
let nested_with_compound = select l.inner_with as id from nested_with_one as l join nested_compounds as r on l.statement = r.id;
let nested_with_bad = union(left=nested_with_many, right=nested_with_compound);
let nested_bad_outer = select l.id as id from nested_with as l join nested_with_bad as r on l.inner_with = r.id;
let bad_single = union(left=simple_compounds, right=loops_bad);
let bad_single_all = union(left=bad_single, right=nested_bad_outer);
let raw_violations = union(left=multiple_body, right=bad_single_all);
let violation_rows = select l.id as id, r.file as file, r.span as span from raw_violations as l join with_nodes as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from violation_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PT031)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PT031"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
