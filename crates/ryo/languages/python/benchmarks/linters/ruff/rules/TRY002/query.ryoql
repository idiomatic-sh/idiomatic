import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let broad_exceptions = select id from qualified_names where (path = "builtins.Exception" or path = "builtins.BaseException") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let raises = select id from "semantic-syntax" where kind = "raise";
let exc_fields = select parent, child from "semantic-child" where field = "exc";
let exceptions = select r.child as id from raises as l join exc_fields as r on l.id = r.parent;
let funcs = select parent, child from "semantic-child" where field = "func";
let invoked = select l.parent as id from funcs as l join broad_exceptions as r on l.child = r.id;
let broad_values = union(left=broad_exceptions, right=invoked);
let invalid = select l.id as id from exceptions as l join broad_values as r on l.id = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join invalid as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*TRY002(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY002)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:TRY002)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:TRY002)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "TRY002"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
