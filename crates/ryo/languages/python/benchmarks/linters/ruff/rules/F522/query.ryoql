import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_fields as l join calls as r on l.parent = r.id;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let value_fields = select parent, child from "semantic-child" where field = "value";
let attr_values = select l.id as attribute, l.file as file, r.child as receiver from attributes as l join value_fields as r on l.id = r.parent;
let string_values = select occurrence as receiver, file from "string-literal";
let literal_receivers = select l.attribute as attribute, l.file as file, r.receiver as receiver from attr_values as l join string_values as r on l.receiver = r.receiver and l.file = r.file;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_children = select l.attribute as attribute, l.file as file, r.child as name_id from literal_receivers as l join attr_fields as r on l.attribute = r.parent;
let format_attributes = select l.attribute as attribute, l.file as file from attr_children as l join "identifier" as r on l.name_id = r.id and l.file = r.file where r.name = "format";
let format_calls = select l.call as call, l.function as function, l.file as file, l.span as span from call_functions as l join format_attributes as r on l.function = r.attribute and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from argument_owners as l join positional_fields as r on l.wrapper = r.parent;
let format_calls_with_literal = select l.call as call, l.file as file, l.span as span, r.receiver as format_id from format_calls as l join literal_receivers as r on l.function = r.attribute and l.file = r.file;
let parse_rows = select id, file, outcome, "error-category" as error_category, "automatic-count" as automatic_count, "indexed-count" as indexed_count, "keyword-count" as keyword_count, "nested-field-count" as nested_field_count from "brace-format-parse" where representation = "decoded-string";
let parsed_calls = select l.call as call, l.file as file, l.span as span, l.format_id as format_id, r.outcome as outcome, r.error_category as error_category, r.automatic_count as automatic_count, r.indexed_count as indexed_count, r.keyword_count as keyword_count, r.nested_field_count as nested_field_count from format_calls_with_literal as l join parse_rows as r on l.format_id = r.id and l.file = r.file;
let format_keyword_fields = select l.call as call, l.file as file, f."selector-name" as name from parsed_calls as l join "brace-format-field" as f on l.format_id = f.id and l.file = f.file where l.outcome = "parsed" and f."selector-kind" = "keyword";
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from argument_owners as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let call_keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let named_keyword_ids = select parent as keyword from arg_fields;
let keyword_spreads = antijoin(left=call_keywords, right=named_keyword_ids, left-on=["keyword"], right-on=["keyword"]);
let spread_calls = select call, file from keyword_spreads;
let keyword_arg_nodes = select l.call as call, l.keyword as keyword, l.file as file, r.child as wrapper from call_keywords as l join arg_fields as r on l.keyword = r.parent;
let keyword_arg_tokens = select l.call as call, l.keyword as keyword, l.file as file, r.child as token from keyword_arg_nodes as l join "semantic-child" as r on l.wrapper = r.parent;
let identifier_edges = select l.child as id, r.name as name from "semantic-child" as l join "identifier" as r on l.parent = r.id;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let call_keyword_names = select l.call as call, l.file as file, l.keyword as keyword, r.name as name from keyword_arg_tokens as l join identifiers as r on l.token = r.id;
let extra_keyword_names = antijoin(left=call_keyword_names, right=format_keyword_fields, left-on=["call", "name", "file"], right-on=["call", "name", "file"]);
let no_spread_extras = antijoin(left=extra_keyword_names, right=spread_calls, left-on=["call", "file"], right-on=["call", "file"]);
let extra_keyword_counts = group-count(from=no_spread_extras, keys=["call", "file"], count="extra_count", distinct="keyword");
let candidates = select l.call as call, l.file as file, r.span as span from extra_keyword_counts as l join parsed_calls as r on l.call = r.call and l.file = r.file where r.outcome = "parsed";
let candidate_locations = select l.call as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])F522(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:F522)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:F522)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F522)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "F522"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
