import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let qualified = select id from qualified_names where (path = "builtins.exit" or path = "builtins.quit") and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let matching_calls = select l.child as function from functions as l join qualified as r on l.child = r.id;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join matching_calls as r on l.id = r.function;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLR1722)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1722"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
