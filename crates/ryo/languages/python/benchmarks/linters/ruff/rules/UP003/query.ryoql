import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let identifier_fields = select parent, child from "semantic-child" where field = "id";
let function_name_nodes = select l.parent as reference, l.child as identifier, r.file as file from identifier_fields as l join name_nodes as r on l.parent = r.id;
let function_names = select l.reference as reference, r.name as name, l.file as file from function_name_nodes as l join "identifier" as r on l.reference = r.id and l.file = r.file;
let type_references = select l.reference as reference, l.file as file from function_names as l where l.name = "type";
let call_arguments = select parent as call, child as wrapper from "semantic-child";
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_arguments as l join argument_nodes as r on l.wrapper = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional = select l.call as call, r.child as argument, r.ordinal as ordinal, l.file as file from call_wrappers as l join positional_fields as r on l.wrapper = r.parent;
let later_positional_arguments = select l.call as call, l.argument as argument, l.file as file from positional as l join positional as r on l.call = r.call and l.file = r.file where l.ordinal > r.ordinal;
let first_positional = antijoin(left=positional, right=later_positional_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let later_positionals = select l.call as call, l.argument as argument, l.file as file from positional as l join positional as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let exactly_one_positional = antijoin(left=first_positional,right=later_positionals,left-on=["call","argument","file"],right-on=["call","argument","file"]);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keyword_children = select l.call as call, l.file as file, r.child as keyword from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let any_keywords = select l.call as call, l.file as file from keyword_children as l join keyword_nodes as r on l.keyword = r.id;
let no_keywords = antijoin(left=exactly_one_positional,right=any_keywords,left-on=["call","file"],right-on=["call","file"]);
let direct_type_function_calls = select l.call as call, l.file as file, l.function as reference from call_functions as l join type_references as r on l.function = r.reference and l.file = r.file;
let direct_type_calls = select l.call as call, l.reference as reference, r.argument as argument, l.file as file from direct_type_function_calls as l join no_keywords as r on l.call = r.call and l.file = r.file;
let qualified_type_functions = select id, file from "qualified-name" where path = "builtins.type";
let qualified_type_function_calls = select l.call as call, l.file as file, l.function as reference from call_functions as l join qualified_type_functions as r on l.function = r.id and l.file = r.file;
let qualified_type_calls = select l.call as call, l.reference as reference, r.argument as argument, l.file as file from qualified_type_function_calls as l join no_keywords as r on l.call = r.call and l.file = r.file;
let primitive_arguments = select id, file from "literal-properties" where kind = "boolean" or kind = "string" or kind = "bytes" or kind = "integer" or kind = "float" or kind = "complex";
let direct_typed_calls = select l.call as call, l.reference as reference, l.file as file from direct_type_calls as l join primitive_arguments as r on l.argument = r.id and l.file = r.file;
let qualified_typed_calls = select l.call as call, l.reference as reference, l.file as file from qualified_type_calls as l join primitive_arguments as r on l.argument = r.id and l.file = r.file;
let candidates = select l.call as call, l.reference as reference, l.file as file, r.span as span from direct_typed_calls as l join calls as r on l.call = r.id and l.file = r.file;
let read_events = select occurrence as id, name, scope, phase, ordinal, file from "binding-event" where kind = "read";
let anchored = select l.reference as id, l.call as call, l.reference as reference, l.file as file, l.span as span, r.scope as scope, r.phase as phase, r.ordinal as ordinal from candidates as l join read_events as r on l.reference = r.id and l.file = r.file where r.name = "type";
let scopes = select child as id, file from "scope";
let scope_ancestors = axis(from=anchored, relation="semantic-child", direction=ancestor, domain=scopes);
let visible_scopes = select l.call as call, l.reference as reference, l.file as file, l.span as span, r.related as lookup_scope, l.phase as phase, l.ordinal as ordinal from anchored as l join scope_ancestors as r on l.reference = r.id and l.file = r.file;
let class_scopes = select id, file from "semantic-syntax" where kind = "class-def";
let class_ancestors = select l.call as call, l.reference as reference, l.file as file, l.span as span, l.lookup_scope as lookup_scope, l.phase as phase, l.ordinal as ordinal from visible_scopes as l join class_scopes as r on l.lookup_scope = r.id and l.file = r.file;
let nearest_scope = axis(from=anchored, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let current_class = select l.reference as reference, r.related as lookup_scope, l.file as file from anchored as l join nearest_scope as r on l.reference = r.id and l.file = r.file;
let visible_current_class = select l.call as call, l.reference as reference, l.file as file, l.span as span, l.lookup_scope as lookup_scope, l.phase as phase, l.ordinal as ordinal from class_ancestors as l join current_class as r on l.reference = r.reference and l.file = r.file and l.lookup_scope = r.lookup_scope;
let nonclass_scopes = antijoin(left=visible_scopes,right=class_scopes,left-on=["lookup_scope","file"],right-on=["id","file"]);
let lookup_scopes = union(left=nonclass_scopes,right=visible_current_class);
let prior_events = select name, scope, ordinal, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let shadowed = select l.call as call, l.reference as reference from lookup_scopes as l join prior_events as r on l.lookup_scope = r.scope and l.file = r.file where r.name = "type" and r.ordinal < l.ordinal;
let unshadowed = antijoin(left=candidates,right=shadowed,left-on=["call","reference"],right-on=["call","reference"]);
let qualified_with_spans = select l.call as call, l.reference as reference, l.file as file, r.span as span from qualified_typed_calls as l join calls as r on l.call = r.id and l.file = r.file;
let qualified_reportable = antijoin(left=qualified_with_spans,right=unshadowed,left-on=["call","reference"],right-on=["call","reference"]);
let direct_reportable = select call, reference, file, span from unshadowed;
let reportable = union(left=direct_reportable,right=qualified_reportable);
let candidate_locations = select l.call as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.call = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*UP003(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP003)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP003)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP003)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP003"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
