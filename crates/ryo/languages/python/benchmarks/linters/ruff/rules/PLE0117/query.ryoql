import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let nonlocals = select occurrence as id, name, file, scope from events where kind = "nonlocal";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let nonlocal_function_ancestors = axis(from=nonlocals, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let outer_function_nonlocals = select l.id as id, l.file as file, r.related as scope, l.name as name from nonlocals as l join nonlocal_function_ancestors as r on l.id = r.id and l.file = r.file;
let function_declarations = select name, scope, file from events where kind = "bind" or kind = "annotation";
let scope_edges = select child as origin, parent as destination from "scope";
let scope_ancestors = closure(edges=scope_edges, source="origin", destination="destination");
let nonlocal_ancestor_paths = select l.id as id, l.file as file, l.scope as nonlocal_scope, r.destination as scope, l.name as name from outer_function_nonlocals as l join scope_ancestors as r on l.scope = r.origin;
let nonlocal_scope_self = select id, file, scope as nonlocal_scope, scope, name from outer_function_nonlocals;
let nonlocal_outer_scopes = union(left=nonlocal_ancestor_paths, right=nonlocal_scope_self);
let outer_function_declarations = select l.name as name, l.scope as scope, l.file as file from function_declarations as l join functions as r on l.scope = r.id and l.file = r.file;
let lexical_scopes = select id, file from "semantic-syntax" where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let nonlocal_lexical_owners = axis(from=nonlocals, relation="semantic-child", direction=nearest-ancestor, domain=lexical_scopes);
let nonlocal_owner_rows = select l.id as id, r.related as owner, l.file as file from nonlocals as l join nonlocal_lexical_owners as r on l.id = r.id and l.file = r.file;
let nonlocal_outer_scopes_with_owner = select l.id as id, l.file as file, l.nonlocal_scope as nonlocal_scope, l.scope as scope, l.name as name, r.owner as owner from nonlocal_outer_scopes as l join nonlocal_owner_rows as r on l.id = r.id and l.file = r.file;
let strictly_outer_nonlocal_scopes = select id, file, nonlocal_scope, scope, name from nonlocal_outer_scopes_with_owner where scope != owner;
let bound_outer_nonlocals = select l.id as id, l.file as file, l.nonlocal_scope as scope from strictly_outer_nonlocal_scopes as l join outer_function_declarations as r on l.name = r.name and l.scope = r.scope and l.file = r.file;
let unbound_function_nonlocals0 = antijoin(left=outer_function_nonlocals, right=bound_outer_nonlocals, left-on=["id","file","scope"], right-on=["id","file","scope"]);
let own_parameters = select l.id as id, l.file as file, l.scope as scope from outer_function_nonlocals as l join "parameter" as r on l.name = r.name and l.scope = r.owner and l.file = r.file;
let unbound_function_nonlocals = antijoin(left=unbound_function_nonlocals0, right=own_parameters, left-on=["id", "file", "scope"], right-on=["id", "file", "scope"]);
let global_declarations = select occurrence as id, name, file from events where kind = "global";
let global_function_owners = axis(from=global_declarations, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let global_function_declarations = select l.name as name, r.related as scope, l.file as file from global_declarations as l join global_function_owners as r on l.id = r.id and l.file = r.file;
let nonlocals_with_ancestor_global = select l.id as id, l.file as file from strictly_outer_nonlocal_scopes as l join global_function_declarations as r on l.name = r.name and l.scope = r.scope and l.file = r.file;
let unbound_nonlocals_without_ancestor_global = antijoin(left=unbound_function_nonlocals, right=nonlocals_with_ancestor_global, left-on=["id","file"], right-on=["id","file"]);
let class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let class_scope_ancestors = axis(from=nonlocals, relation="semantic-child", direction=ancestor, domain=class_nodes);
let class_method_nonlocals = select l.id as id, l.file as file from class_scope_ancestors as l where l.name = "__class__";
let unbound_functions = select id, file from unbound_nonlocals_without_ancestor_global;
let unbound = antijoin(left=unbound_functions, right=class_method_nonlocals, left-on=["id","file"], right-on=["id","file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from unbound as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLE0117)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLE0117"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
