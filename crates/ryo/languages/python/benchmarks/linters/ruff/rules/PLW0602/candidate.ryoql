import suppress from "python/ruff/suppress";
let events = select occurrence as id, name, scope, phase, kind, ordinal, file from "binding-event";
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let global_events = select id, name, ordinal, file from events where kind = "global";
let global_owners = axis(from=global_events, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let function_globals = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, r.related as owner from global_events as l join global_owners as r on l.id = r.id and l.file = r.file;
let bind_events = select id, name, file from events where kind = "bind";
let bind_owners = axis(from=bind_events, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let function_binds = select l.id as id, l.name as name, l.file as file, r.related as owner from bind_events as l join bind_owners as r on l.id = r.id and l.file = r.file;
let assigned_globals = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, l.owner as owner from function_globals as l join function_binds as r on l.name = r.name and l.owner = r.owner and l.file = r.file;
let unassigned_globals = antijoin(left=function_globals, right=assigned_globals, left-on=["id", "name", "ordinal", "file", "owner"], right-on=["id", "name", "ordinal", "file", "owner"]);
let delete_events = select id, name, ordinal, file from events where kind = "delete";
let delete_owners = axis(from=delete_events, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let function_deletes = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, r.related as owner from delete_events as l join delete_owners as r on l.id = r.id and l.file = r.file;
let later_deletes = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, l.owner as owner from unassigned_globals as l join function_deletes as r on l.name = r.name and l.owner = r.owner and l.file = r.file where r.ordinal > l.ordinal;
let deleted_globals = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, l.owner as owner from later_deletes as l;
let candidates = antijoin(left=unassigned_globals, right=deleted_globals, left-on=["id", "name", "ordinal", "file", "owner"], right-on=["id", "name", "ordinal", "file", "owner"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from candidates as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0602(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0602)(?:,|$)");
emit violations subject file key(id);
