import suppress from "python/ruff/suppress";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let globals = select occurrence as id, name, scope, phase, file from events where kind = "global";
let assigned = select name, scope, phase, file from events where kind = "bind";
let assigned_globals = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file from globals as l join assigned as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let unassigned = antijoin(left=globals, right=assigned_globals, left-on=["id","name","scope","phase","file"], right-on=["id","name","scope","phase","file"]);
let deleted = select occurrence as id, name, scope, phase, file from events where kind = "delete";
let deleted_globals = select l.id as id, l.name as name, l.scope as scope, l.phase as phase, l.file as file from unassigned as l join deleted as r on l.name = r.name and l.scope = r.scope and l.phase = r.phase and l.file = r.file;
let candidates = antijoin(left=unassigned, right=deleted_globals, left-on=["id","name","scope","phase","file"], right-on=["id","name","scope","phase","file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from candidates as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLW0602(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0602)(?:,|$)");
emit violations subject file key(id);
