import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let expression_statements = select id, file, span from "semantic-syntax" where kind = "expr";
let expression_values = select parent, child from "semantic-child" where field = "value";
let statement_calls = select l.id as statement, l.file as file, l.span as span, r.child as call from expression_statements as l join expression_values as r on l.id = r.parent;
let calls = select id, file from "semantic-syntax" where kind = "call";
let call_roots = select l.statement as statement, l.file as file, l.span as span, l.call as call from statement_calls as l join calls as r on l.call = r.id and l.file = r.file;
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let builtin_exception_functions = select q.id as id, q.file as file from "qualified-name" as q where (q.provenance = "import" or q.provenance = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10)) and (q.path = "builtins.BaseException" or q.path = "builtins.GeneratorExit" or q.path = "builtins.KeyboardInterrupt" or q.path = "builtins.SystemExit" or q.path = "builtins.Exception" or q.path = "builtins.ArithmeticError" or q.path = "builtins.FloatingPointError" or q.path = "builtins.OverflowError" or q.path = "builtins.ZeroDivisionError" or q.path = "builtins.AssertionError" or q.path = "builtins.AttributeError" or q.path = "builtins.BufferError" or q.path = "builtins.EOFError" or q.path = "builtins.ImportError" or q.path = "builtins.ModuleNotFoundError" or q.path = "builtins.LookupError" or q.path = "builtins.IndexError" or q.path = "builtins.KeyError" or q.path = "builtins.MemoryError" or q.path = "builtins.NameError" or q.path = "builtins.UnboundLocalError" or q.path = "builtins.OSError" or q.path = "builtins.BlockingIOError" or q.path = "builtins.ChildProcessError" or q.path = "builtins.ConnectionError" or q.path = "builtins.BrokenPipeError" or q.path = "builtins.ConnectionAbortedError" or q.path = "builtins.ConnectionRefusedError" or q.path = "builtins.ConnectionResetError" or q.path = "builtins.FileExistsError" or q.path = "builtins.FileNotFoundError" or q.path = "builtins.InterruptedError" or q.path = "builtins.IsADirectoryError" or q.path = "builtins.NotADirectoryError" or q.path = "builtins.PermissionError" or q.path = "builtins.ProcessLookupError" or q.path = "builtins.TimeoutError" or q.path = "builtins.ReferenceError" or q.path = "builtins.RuntimeError" or q.path = "builtins.NotImplementedError" or q.path = "builtins.RecursionError" or q.path = "builtins.StopAsyncIteration" or q.path = "builtins.StopIteration" or q.path = "builtins.SyntaxError" or q.path = "builtins.IndentationError" or q.path = "builtins.TabError" or q.path = "builtins.SystemError" or q.path = "builtins.TypeError" or q.path = "builtins.ValueError" or q.path = "builtins.UnicodeError" or q.path = "builtins.UnicodeDecodeError" or q.path = "builtins.UnicodeEncodeError" or q.path = "builtins.UnicodeTranslateError" or q.path = "builtins.Warning" or q.path = "builtins.BytesWarning" or q.path = "builtins.DeprecationWarning" or q.path = "builtins.FutureWarning" or q.path = "builtins.ImportWarning" or q.path = "builtins.PendingDeprecationWarning" or q.path = "builtins.ResourceWarning" or q.path = "builtins.RuntimeWarning" or q.path = "builtins.SyntaxWarning" or q.path = "builtins.UnicodeWarning" or q.path = "builtins.UserWarning" or q.path = "builtins.EncodingWarning");
let exception_calls = select l.call as call, l.file as file from call_functions as l join builtin_exception_functions as r on l.function = r.id and l.file = r.file;
let candidates = select l.statement as id, l.file as file, l.span as span from call_roots as l join exception_calls as r on l.call = r.call and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW0133(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW0133)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:PLW0133)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLW0133)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLW0133"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
