import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let expression_statements = select id, file, span from "semantic-syntax" where kind = "expr";
let expression_values = select parent, child from "semantic-child" where field = "value";
let statement_calls = select l.id as statement, l.file as file, l.span as span, r.child as call from expression_statements as l join expression_values as r on l.id = r.parent;
let call_syntax_rows = call_syntax();
let calls = select id, file from call_syntax_rows;
let call_roots = select l.statement as statement, l.file as file, l.span as span, l.call as call from statement_calls as l join calls as r on l.call = r.id and l.file = r.file;
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let builtin_exception_functions = select q.id as id, q.file as file from "qualified-name" as q where (q.provenance = "import" or q.provenance = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10)) and (q.path in ["builtins.BaseException", "builtins.GeneratorExit", "builtins.KeyboardInterrupt", "builtins.SystemExit", "builtins.Exception", "builtins.ArithmeticError", "builtins.FloatingPointError", "builtins.OverflowError", "builtins.ZeroDivisionError", "builtins.AssertionError", "builtins.AttributeError", "builtins.BufferError", "builtins.EOFError", "builtins.ImportError", "builtins.ModuleNotFoundError", "builtins.LookupError", "builtins.IndexError", "builtins.KeyError", "builtins.MemoryError", "builtins.NameError", "builtins.UnboundLocalError", "builtins.OSError", "builtins.BlockingIOError", "builtins.ChildProcessError", "builtins.ConnectionError", "builtins.BrokenPipeError", "builtins.ConnectionAbortedError", "builtins.ConnectionRefusedError", "builtins.ConnectionResetError", "builtins.FileExistsError", "builtins.FileNotFoundError", "builtins.InterruptedError", "builtins.IsADirectoryError", "builtins.NotADirectoryError", "builtins.PermissionError", "builtins.ProcessLookupError", "builtins.TimeoutError", "builtins.ReferenceError", "builtins.RuntimeError", "builtins.NotImplementedError", "builtins.RecursionError", "builtins.StopAsyncIteration", "builtins.StopIteration", "builtins.SyntaxError", "builtins.IndentationError", "builtins.TabError", "builtins.SystemError", "builtins.TypeError", "builtins.ValueError", "builtins.UnicodeError", "builtins.UnicodeDecodeError", "builtins.UnicodeEncodeError", "builtins.UnicodeTranslateError", "builtins.Warning", "builtins.BytesWarning", "builtins.DeprecationWarning", "builtins.FutureWarning", "builtins.ImportWarning", "builtins.PendingDeprecationWarning", "builtins.ResourceWarning", "builtins.RuntimeWarning", "builtins.SyntaxWarning", "builtins.UnicodeWarning", "builtins.UserWarning", "builtins.EncodingWarning"]);
let exception_calls = select l.call as call, l.file as file from call_functions as l join builtin_exception_functions as r on l.function = r.id and l.file = r.file;
let candidates = select l.statement as id, l.file as file, l.span as span from call_roots as l join exception_calls as r on l.call = r.call and l.file = r.file;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, code="PLW0133");
let violations = antijoin(left=candidates, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_used = select directive,file,concat("","PLW0133") as code from violations_matches where scope<2;
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
