import suppress from "python/ruff/suppress";
import text_units from "python/ruff/text-units";
let imports = select occurrence as id, target, file from "static-import";
let alias_fields = select parent as alias, child as name, file from "semantic-child" where field = "name";
let named_aliases = select l.alias as id, r.name as name, l.file as file from alias_fields as l join "identifier" as r on l.name = r.id and l.file = r.file;
let named_wildcard_aliases = select id, file from named_aliases where name = "*";
let stars = select id, file from "syntax-tree" where text = "*";
let star_locations = select l.id as token, r."start-byte" as start, r."end-byte" as end, l.file as file from stars as l join "source-location" as r on l.id = r.id and l.file = r.file;
let alias_locations = select l.id as id, r."start-byte" as start, r."end-byte" as end, l.file as file from imports as l join "source-location" as r on l.id = r.id and l.file = r.file;
let physical_wildcard_aliases = select l.id as id, l.file as file from alias_locations as l join star_locations as r on l.start = r.start and l.end = r.end and l.file = r.file;
let wildcard_aliases = union(left=named_wildcard_aliases, right=physical_wildcard_aliases);
let nonwild_imports = antijoin(left=imports, right=wildcard_aliases, left-on=["id", "file"], right-on=["id", "file"]);
let identities = select file, path from "module-identity";
let absolute_matches = select l.id as id, l.file as file from nonwild_imports as l join identities as r on l.target = r.path and l.file = r.file;
let relative_parts = capture(from=nonwild_imports, path="target", pattern="{*dots}{*tail}", captures=["dots", "tail"]);
let dot_prefixes = select id, dots, tail, file from relative_parts where matches(dots, "^[.]+$");
let incomplete_prefixes = select id, dots, tail, file from dot_prefixes where starts_with(tail, ".");
let relative_imports = antijoin(left=dot_prefixes, right=incomplete_prefixes, left-on=["id", "dots", "tail", "file"], right-on=["id", "dots", "tail", "file"]);
let dot_strings = select id, dots as value, file from relative_imports;
let dot_units = text_units(strings=dot_strings);
let levels = group-count(from=dot_units, keys=["id", "file"], count="level", distinct="before");
let module_nodes = select id, file from "semantic-syntax" where kind = "module";
let module_paths = select l.id as module, r.path as path, l.file as file from module_nodes as l join identities as r on l.file = r.file;
let module_splits = capture(from=module_paths, path="path", pattern="{*prefix}.{*tail}", captures=["prefix", "tail"]);
let tail_splits = capture(from=module_splits, path="tail", pattern="{*before}.{*after}", captures=["before", "after"]);
let earlier_components = select module, tail, before, file from tail_splits;
let last_components = select module, tail, tail as before, file from module_splits;
let components = union(left=earlier_components, right=last_components);
let depths = group-count(from=components, keys=["module", "tail", "file"], count="depth", distinct="before");
let relative_depths = select l.id as id, l.tail as tail, r.level as level, l.file as file from relative_imports as l join levels as r on l.id = r.id and l.file = r.file;
let relative_matches = select l.id as id, l.file as file from relative_depths as l join depths as r on l.tail = r.tail and l.level = r.depth and l.file = r.file;
let matches0 = union(left=absolute_matches, right=relative_matches);
let from_nodes = select id, file from "semantic-syntax" where kind = "import-from";
let from_children = select l.id as statement, r.child as alias, r.ordinal as ordinal, l.file as file from from_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "names";
let from_matches = select l.id as id, r.statement as statement, r.ordinal as ordinal, l.file as file from matches0 as l join from_children as r on l.id = r.alias and l.file = r.file;
let later_from_matches = select l.id as id, l.file as file from from_matches as l join from_matches as r on l.statement = r.statement and l.file = r.file where r.ordinal < l.ordinal;
let reportable = antijoin(left=matches0, right=later_from_matches, left-on=["id", "file"], right-on=["id", "file"]);
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PLW0406($|[, #])", range-pattern="(?:^|,)PLW0406(?:,|$)");
emit violations subject file key(id);
