import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let zip_names = select id, file from "qualified-name" where path = "builtins.zip";
let zip_calls = select l.call as call, l.file as file, l.span as span from call_functions as l join zip_names as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_edges = select parent, child, ordinal, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, l.file as file, r.child as argument, r.ordinal as ordinal from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let positional_counts = group-count(from=positional_args, keys=["call","file"], count="positional_count", distinct="argument");
let two_arg_zip = select l.call as call, l.file as file, l.span as span from zip_calls as l join positional_counts as r on l.call = r.call and l.file = r.file where r.positional_count = 2;
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let call_keyword_rows = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let keyword_counts = group-count(from=call_keyword_rows, keys=["call","file"], count="keyword_count", distinct="keyword");
let no_keywords = antijoin(left=two_arg_zip,right=call_keyword_rows,left-on=["call","file"],right-on=["call","file"]);
let keyword_name_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_rows = select l.call as call, l.file as file, r.child as name_id from call_keyword_rows as l join keyword_name_edges as r on l.keyword = r.parent and l.file = r.file;
let named_keywords = select l.call as call, l.file as file, r.name as name from named_keyword_rows as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let strict_names = select call, file from named_keywords where name = "strict";
let only_strict_keywords = select l.call as call, l.file as file from strict_names as l join keyword_counts as r on l.call = r.call and l.file = r.file where r.keyword_count = 1;
let no_keyword_ids = select call, file from no_keywords;
let zip_no_other_keywords = union(left=no_keyword_ids,right=only_strict_keywords);
let eligible_zip_calls = select l.call as call, l.file as file, l.span as span from two_arg_zip as l join zip_no_other_keywords as r on l.call = r.call and l.file = r.file;
let first_arg_pairs = select l.call as call, l.file as file, l.argument as later, r.argument as earlier, l.ordinal as later_ord, r.ordinal as earlier_ord from positional_args as l join positional_args as r on l.call = r.call and l.file = r.file where r.ordinal < l.ordinal;
let second_arg_counts = group-count(from=first_arg_pairs, keys=["call","file","later"], count="prior_count", distinct="earlier");
let second_args = select l.call as call, l.file as file, l.later as argument from first_arg_pairs as l join second_arg_counts as r on l.call = r.call and l.file = r.file and l.later = r.later where r.prior_count = 1;
let later_arg_rows = select call, file, later as argument from first_arg_pairs;
let first_args = antijoin(left=positional_args,right=later_arg_rows,left-on=["call","file","argument"],right-on=["call","file","argument"]);
let zip_key_arg_rows = select l.call as zip_call, l.file as file, l.span as span, r.argument as key_call from eligible_zip_calls as l join first_args as r on l.call = r.call and l.file = r.file;
let zip_key_value_args = select l.zip_call as zip_call, l.file as file, l.span as span, l.key_call as key_call, r.argument as value_call from zip_key_arg_rows as l join second_args as r on l.zip_call = r.call and l.file = r.file;
let key_calls = select id, file from "semantic-syntax" where kind = "call";
let value_calls = select id, file from "semantic-syntax" where kind = "call";
let key_call_rows = select l.zip_call as zip_call, l.file as file, l.span as span, l.key_call as key_call from zip_key_value_args as l join key_calls as r on l.key_call = r.id and l.file = r.file;
let value_call_rows = select l.zip_call as zip_call, l.file as file, l.span as span, l.value_call as value_call from zip_key_value_args as l join value_calls as r on l.value_call = r.id and l.file = r.file;
let key_function_edges = select parent, child, file from "semantic-child" where field = "func";
let key_functions = select r.zip_call as zip_call, l.parent as inner_call, l.file as file, r.span as span, l.child as function from key_function_edges as l join key_call_rows as r on l.parent = r.key_call and l.file = r.file;
let value_functions = select r.zip_call as zip_call, l.parent as inner_call, l.file as file, r.span as span, l.child as function from key_function_edges as l join value_call_rows as r on l.parent = r.value_call and l.file = r.file;
let attribute_nodes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child, file from "semantic-child" where field = "value";
let attr_receivers = select l.id as attribute, l.file as file, r.child as receiver from attribute_nodes as l join attribute_values as r on l.id = r.parent and l.file = r.file;
let key_call_attributes = select l.zip_call as zip_call, l.inner_call as inner_call, l.file as file, l.span as span, l.function as attribute, r.receiver as receiver from key_functions as l join attr_receivers as r on l.function = r.attribute and l.file = r.file;
let value_call_attributes = select l.zip_call as zip_call, l.inner_call as inner_call, l.file as file, l.span as span, l.function as attribute, r.receiver as receiver from value_functions as l join attr_receivers as r on l.function = r.attribute and l.file = r.file;
let attr_name_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_name_rows = select l.parent as attribute, l.file as file, r.name as name from attr_name_edges as l join "identifier" as r on l.child = r.id and l.file = r.file;
let key_methods = select l.zip_call as zip_call, l.inner_call as inner_call, l.file as file, l.span as span, l.receiver as receiver, r.name as name from key_call_attributes as l join attr_name_rows as r on l.attribute = r.attribute and l.file = r.file;
let value_methods = select l.zip_call as zip_call, l.inner_call as inner_call, l.file as file, l.span as span, l.receiver as receiver, r.name as name from value_call_attributes as l join attr_name_rows as r on l.attribute = r.attribute and l.file = r.file;
let keys_methods = select zip_call, inner_call, file, span, receiver from key_methods where name = "keys";
let values_methods = select zip_call, inner_call, file, span, receiver from value_methods where name = "values";
let receiver_names = select id, file from "semantic-syntax" where kind = "name";
let key_name_receivers = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver from keys_methods as l join receiver_names as r on l.receiver = r.id and l.file = r.file;
let value_name_receivers = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver from values_methods as l join receiver_names as r on l.receiver = r.id and l.file = r.file;
let name_identifier_edges = select parent, child, file from "semantic-child" where field = "id";
let key_receiver_identifiers = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver, r.child as identifier from key_name_receivers as l join name_identifier_edges as r on l.receiver = r.parent and l.file = r.file;
let value_receiver_identifiers = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver, r.child as identifier from value_name_receivers as l join name_identifier_edges as r on l.receiver = r.parent and l.file = r.file;
let key_receiver_text = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver, r.name as name from key_name_receivers as l join "identifier" as r on l.receiver = r.id and l.file = r.file;
let value_receiver_text = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver, r.name as name from value_name_receivers as l join "identifier" as r on l.receiver = r.id and l.file = r.file;
let same_receiver_names = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver from key_receiver_text as l join value_receiver_text as r on l.zip_call = r.zip_call and l.file = r.file and l.name = r.name;
let name_receivers = select l.zip_call as zip_call, l.file as file, l.span as span, l.receiver as receiver from same_receiver_names as l;
let key_inner_counts = group-count(from=positional_args, keys=["call","file"], count="arg_count", distinct="argument");
let key_inner_args = select l.zip_call as zip_call, l.file as file from name_receivers as l join key_calls as r on l.receiver = r.id and l.file = r.file;
let receiver_bindings = select l.zip_call as zip_call, l.file as file, l.span as span, r.binding as binding from name_receivers as l join "binding-use" as r on l.receiver = r.reference and l.file = r.file;
let bind_events = select occurrence, file from "binding-event" where kind = "bind";
let assignments = select id, file from "semantic-syntax" where kind = "assign";
let target_edges = select parent, child, file from "semantic-child" where field = "targets";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let assignment_targets = select l.id as assignment, l.file as file, r.child as target from assignments as l join target_edges as r on l.id = r.parent and l.file = r.file;
let bound_targets = select l.assignment as assignment, l.file as file, l.target as target from assignment_targets as l join bind_events as r on l.target = r.occurrence and l.file = r.file;
let assigned_values = select l.target as target, l.file as file, r.child as value from bound_targets as l join value_edges as r on l.assignment = r.parent and l.file = r.file;
let dict_nodes = select id, file from "semantic-syntax" where kind = "dict";
let dict_literal_targets = select l.target as binding, l.file as file from assigned_values as l join dict_nodes as r on l.value = r.id and l.file = r.file;
let dictionaries = select binding, file from dict_literal_targets;
let dict_backed_receivers = select l.zip_call as id, l.file as file, l.span as span from receiver_bindings as l join dictionaries as r on l.binding = r.binding and l.file = r.file;
let inner_calls = union(left=keys_methods,right=values_methods);
let inner_positional_args = select l.call as call, l.file as file, r.child as argument from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let inner_keyword_args = select l.call as call, l.file as file from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let inner_calls_with_positional = select l.zip_call as id, l.file as file from inner_calls as l join inner_positional_args as r on l.inner_call = r.call and l.file = r.file;
let inner_calls_without_positional = antijoin(left=inner_calls,right=inner_calls_with_positional,left-on=["zip_call","file"],right-on=["id","file"]);
let inner_calls_with_keywords = select l.zip_call as id, l.file as file from inner_calls_without_positional as l join inner_keyword_args as r on l.inner_call = r.call and l.file = r.file;
let inner_calls_without_args = antijoin(left=inner_calls_without_positional,right=inner_calls_with_keywords,left-on=["zip_call","file"],right-on=["id","file"]);
let dict_backed_calls = select l.id as id, l.file as file, l.span as span from dict_backed_receivers as l join inner_calls_without_args as r on l.id = r.zip_call and l.file = r.file;
let inner_no_args = select id, file, span from dict_backed_calls;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from inner_no_args as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])SIM911(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:SIM911)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:SIM911)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:SIM911)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM911"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
