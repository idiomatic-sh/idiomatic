import observation_matches from "python/ruff/suppress-matches";
let undocumented_warns = select id, file, span from "qualified-name" where path = "logging.WARN";
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from undocumented_warns as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:LOG009)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "LOG009"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
