import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import keyword_argument_names from "python/ruff/call-keywords";
let qualified_names = select q.id as id, q.path as path, q.provenance as provenance, q."since-major" as since_major, q."since-minor" as since_minor from "qualified-name" as q;
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let calls = call_syntax();
let functions = select parent, child from "semantic-child" where field = "func";
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let call_arguments = select l.parent as call, r.id as id from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_ordered = select l.call as call, r.child as id, r.ordinal as ordinal from call_arguments as l join positional_fields as r on l.id = r.parent;
let earlier_positionals = select l.id as id, r.id as earlier from positional_ordered as l join positional_ordered as r on l.call = r.call where l.ordinal > r.ordinal;
let positional_ranks = group-count(from=earlier_positionals, keys=["id"], count="ordinal", distinct="earlier");
let ranked_positional = select l.call as call, l.id as id, r.ordinal as ordinal from positional_ordered as l join positional_ranks as r on l.id = r.id;
let initial_positional = antijoin(left=positional_ordered, right=positional_ranks, left-on=["id"], right-on=["id"]);
let initial_ids = select call, id from initial_positional;
let zero_positional = extend(from=initial_ids, values={ordinal: 0});
let positional = union(left=ranked_positional, right=zero_positional);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keywords = select l.call as call, r.child as id from call_arguments as l join keyword_fields as r on l.id = r.parent;
let keyword_names = keyword_argument_names(keywords=keywords, identifiers=semantic_identifiers);
let builtin = select id from qualified_names where path = "builtins.isinstance" and (provenance != "builtin" or since_major < 3 or since_major = 3 and since_minor <= 10);
let builtin_calls = select l.parent as id from functions as l join builtin as r on l.child = r.id;
let counts = group-count(from=positional, keys=["call"], count="count", distinct="id");
let pairs = select call from counts where count = 2;
let binary = select l.id as id from builtin_calls as l join pairs as r on l.id = r.call;
let eligible = antijoin(left=binary, right=keywords, left-on=["id"], right-on=["call"]);
let first_arguments = select call, id from positional where ordinal = 0;
let targets = select l.id as call, r.id as id from eligible as l join first_arguments as r on l.id = r.call;
let shapes = select id, shape, file from "expression-shape";
let typed_targets = select l.call as id, r.shape as shape, r.file as file from targets as l join shapes as r on l.id = r.id;
let booleans = select id, file, span from "semantic-syntax" where kind = "bool-op";
let operators = select parent, child from "semantic-child" where field = "op";
let or_tokens = select id from "semantic-syntax" where text = "or";
let disjunctions = select l.parent as id from operators as l join or_tokens as r on l.child = r.id;
let owners = select l.id as id, l.file as file, l.span as span from booleans as l join disjunctions as r on l.id = r.id;
let value_fields = select parent, child, ordinal from "semantic-child" where field = "values";
let values = select l.id as owner, r.child as id, r.ordinal as ordinal from owners as l join value_fields as r on l.id = r.parent;
let following = select l.owner as owner, l.id as first, r.id as second, l.ordinal as first_order, r.ordinal as second_order from values as l join values as r on l.owner = r.owner where l.ordinal < r.ordinal;
let skipped = select l.first as first, l.second as second from following as l join values as r on l.owner = r.owner where r.ordinal > l.first_order and r.ordinal < l.second_order;
let adjacent = antijoin(left=following, right=skipped, left-on=["first", "second"], right-on=["first", "second"]);
let first_shapes = select l.owner as owner, l.first as first, l.second as second, r.shape as shape, r.file as file from adjacent as l join typed_targets as r on l.first = r.id;
let equal_pairs = select l.owner as owner, l.first as first, l.second as second from first_shapes as l join typed_targets as r on l.second = r.id and l.file = r.file and l.shape = r.shape;
let continued_runs = select l.first as id from equal_pairs as l join equal_pairs as r on l.first = r.second;
let starts = antijoin(left=equal_pairs, right=continued_runs, left-on=["first"], right-on=["id"]);
let reportable = select l.first as id, r.id as location, r.file as file, r.span as span from starts as l join owners as r on l.owner = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.location = r.id;
let suppression_candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.location = r.id;
let suppression_found = observation_matches(candidates=suppression_candidates, codes="^(?:PLR1701|SIM101)$");
let candidate_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=candidate_rows, right=suppression_found, left-on=[id], right-on=[id]);
let ruf100_directives = select directive, file from suppression_found where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM101"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
