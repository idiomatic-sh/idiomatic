import suppress from "python/ruff/suppress";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let annotations = select occurrence as id, name, scope, phase, file from events where kind = "annotation";
let value_bindings = select name, scope, file from events where kind = "bind" or kind = "delete";
let annotations_with_value = select l.id as id, l.file as file from annotations as l join value_bindings as r on l.name = r.name and l.scope = r.scope and l.file = r.file;
let annotation_only = antijoin(left=annotations, right=annotations_with_value, left-on=["id", "file"], right-on=["id", "file"]);
let function_scopes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "lambda";
let local_annotations = select l.id as id, l.name as name, l.scope as scope, l.file as file from annotation_only as l join function_scopes as r on l.scope = r.id and l.file = r.file;
let reads = select occurrence as id, name, scope, file from events where kind = "read";
let scope_edges = select child as origin, parent as destination from "scope";
let scope_ancestors = closure(edges=scope_edges, source="origin", destination="destination");
let direct_read_paths = select id as read_id, name, scope as read_scope, scope as path_scope, file from reads;
let outer_read_paths = select l.id as read_id, l.name as name, l.scope as read_scope, r.destination as path_scope, l.file as file from reads as l join scope_ancestors as r on l.scope = r.origin;
let all_read_paths = union(left=direct_read_paths, right=outer_read_paths);
let annotation_read_owners = select l.id as ann_id, l.name as name, l.scope as owner_scope, r.read_id as read_id, r.read_scope as read_scope, l.file as file from local_annotations as l join all_read_paths as r on l.name = r.name and l.scope = r.path_scope and l.file = r.file;
let annotation_read_paths = select l.ann_id as ann_id, l.name as name, l.owner_scope as owner_scope, l.read_id as read_id, l.read_scope as read_scope, r.path_scope as path_scope, l.file as file from annotation_read_owners as l join all_read_paths as r on l.read_id = r.read_id and l.read_scope = r.read_scope and l.file = r.file;
let declarations = select name, scope, file from events where kind = "bind" or kind = "annotation";
let scope_nodes = select id, kind, file from "semantic-syntax";
let shadowed_declarations = select l.ann_id as ann_id, l.read_id as read_id, l.file as file, l.path_scope as path_scope, l.owner_scope as owner_scope, l.read_scope as read_scope from annotation_read_paths as l join declarations as r on l.name = r.name and l.path_scope = r.scope and l.file = r.file;
let shadowed_read_paths = select l.ann_id as ann_id, l.read_id as read_id, l.file as file, l.path_scope as path_scope, l.owner_scope as owner_scope, l.read_scope as read_scope, r.kind as kind from shadowed_declarations as l join scope_nodes as r on l.path_scope = r.id and l.file = r.file where l.path_scope != l.owner_scope;
let intermediate_class_paths = select ann_id, read_id, file from shadowed_read_paths where kind = "class-def" and path_scope != read_scope;
let allowed_shadow_paths = antijoin(left=shadowed_read_paths, right=intermediate_class_paths, left-on=["ann_id","read_id","file"], right-on=["ann_id","read_id","file"]);
let unshadowed_read_paths = antijoin(left=annotation_read_paths, right=allowed_shadow_paths, left-on=["ann_id","read_id","file"], right-on=["ann_id","read_id","file"]);
let read_annotations = select ann_id as id, file from unshadowed_read_paths;
let unused_annotations = antijoin(left=local_annotations, right=read_annotations, left-on=["id","file"], right-on=["id","file"]);
let dummy_annotations = select id, file from unused_annotations where matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let non_dummy = antijoin(left=unused_annotations, right=dummy_annotations, left-on=["id","file"], right-on=["id","file"]);
let nodes = select id, file, span from "semantic-syntax";
let reportable = select l.id as id, l.file as file, r.span as span from non_dummy as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F842(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:F842)(?:,|$)");
emit violations subject file key(id);
