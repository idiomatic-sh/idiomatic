import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let calls = select id, file from nodes where kind = "call";
let function_edges = select l.id as call, r.child as function, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let zip_origins = select id, file from "qualified-name" where (provenance = "builtin" or provenance = "import") and path = "builtins.zip";
let zip_calls = select l.call as call, l.function as function, l.file as file from function_edges as l join zip_origins as r on l.function = r.id and l.file = r.file;
let wrappers = select id, file from nodes where kind = "call-arguments";
let possible_wrappers = select l.call as call, r.child as wrapper, l.file as file from zip_calls as l join "semantic-child" as r on l.call = r.parent and l.file = r.file;
let call_wrappers = select l.call as call, l.wrapper as wrapper, l.file as file from possible_wrappers as l join wrappers as r on l.wrapper = r.id and l.file = r.file;
let positional = select l.call as call, r.child as expression, r.ordinal as ordinal, l.file as file from call_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args";
let arities = group-count(from=positional, keys=["call", "file"], count="count", distinct="expression");
let two = select call, file from arities where count = 2;
let two_args = select l.call as call, l.expression as expression, l.ordinal as ordinal, l.file as file from positional as l join two as r on l.call = r.call and l.file = r.file;
let pairs = ordered-match(left=two_args, right=two_args, left-on=["call", "file"], right-on=["call", "file"], left-order="ordinal", right-order="ordinal", output={call:[left,call], first:[left,expression], second:[right,expression], file:[left,file]});
let names = select l.id as expression, r.name as base, l.file as file from nodes as l join "identifier" as r on l.id = r.id and l.file = r.file where l.kind = "name";
let slices = select id, file from nodes where kind = "slice";
let integers = select id, value, file from "numeric-literal" where kind = "integer";
let steps = select l.id as slice, r.child as step, l.file as file from slices as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "step";
let unit_steps = select l.slice as slice, l.file as file from steps as l join integers as r on l.step = r.id and l.file = r.file where numeric_gte(r.value, 1) and numeric_gte(1, r.value);
let invalid_steps = antijoin(left=steps, right=unit_steps, left-on=["slice", "file"], right-on=["slice", "file"]);
let eligible_slices = antijoin(left=slices, right=invalid_steps, left-on=["id", "file"], right-on=["slice", "file"]);
let lowers = select l.id as slice, r.child as lower, l.file as file from eligible_slices as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "lower";
let direct_starts = select l.slice as slice, r.value as start, l.file as file from lowers as l join integers as r on l.lower = r.id and l.file = r.file;
let without_lower = antijoin(left=eligible_slices, right=lowers, left-on=["id", "file"], right-on=["slice", "file"]);
let absent_starts = select id as slice, file from without_lower;
let zero_values = extend(from=absent_starts, values={start: "0"});
let zero_starts = select slice, start, file from zero_values;
let starts = union(left=direct_starts, right=zero_starts);
let subscripts = select id, file from nodes where kind = "subscript";
let receiver_edges = select l.id as expression, r.child as receiver, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let named_receivers = select l.expression as expression, r.base as base, l.file as file from receiver_edges as l join names as r on l.receiver = r.expression and l.file = r.file;
let slice_edges = select l.expression as expression, l.base as base, r.child as slice, l.file as file from named_receivers as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "slice";
let slice_info = select l.expression as expression, l.base as base, r.start as start, l.file as file from slice_edges as l join starts as r on l.slice = r.slice and l.file = r.file;
let name_values = extend(from=names, values={start: "0"});
let name_info = select expression, base, start, file from name_values;
let first_info = union(left=slice_info, right=name_info);
let firsts = select l.call as call, l.second as second, r.base as base, r.start as first_start, l.file as file from pairs as l join first_info as r on l.first = r.expression and l.file = r.file;
let matching = select l.call as call, l.first_start as first_start, r.start as second_start, l.file as file from firsts as l join slice_info as r on l.second = r.expression and l.file = r.file where l.base = r.base;
let successive = select call, file from matching where integer_successor(first_start, second_start);
let reportable = select l.call as id, r.function as function, l.file as file from successive as l join zip_calls as r on l.call = r.call and l.file = r.file;
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.function = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="RUF007($|[, #])", range-pattern="(?:^|,)RUF007(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidates, inline-pattern="RUF007($|[, #])", range-pattern="(?:^|,)RUF007(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "RUF007"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
