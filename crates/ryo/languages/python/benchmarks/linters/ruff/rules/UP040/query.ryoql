import ruf100_candidate_matches from "python/ruff/noqa-candidate-matches";
import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let plain_assignments = select id, file from nodes where kind = "assign";
let annotated_assignments = select id, file from nodes where kind = "ann-assign";
let values = select parent, child, file from "semantic-child" where field = "value";
let names = select id, file from nodes where kind = "name";
let target_fields = select parent, child, file from "semantic-child" where field = "target" or field = "targets";
let plain_targets = select l.id as assignment, r.child as target, l.file as file from plain_assignments as l join target_fields as r on l.id = r.parent and l.file = r.file;
let target_counts = group-count(from=plain_targets, keys=["assignment","file"], count="count", distinct="target");
let single_plain_targets_join_1 = select l.assignment as l_assignment, l.target as l_target, l.file as l_file, c.assignment as c_assignment, c.file as c_file, c.count as c_count from plain_targets as l join target_counts as c on l.assignment = c.assignment and l.file = c.file;
let single_plain_targets = select l.l_assignment as assignment, l.l_target as target, l.l_file as file from single_plain_targets_join_1 as l join names as r on l.l_target = r.id and l.l_file = r.file where l.c_count = 1;
let annotated_targets_join_1 = select l.id as l_id, e.child as e_child, l.file as l_file, e.parent as e_parent, e.file as e_file from annotated_assignments as l join target_fields as e on l.id = e.parent and l.file = e.file;
let annotated_targets = select l.l_id as assignment, l.e_child as target, l.l_file as file from annotated_targets_join_1 as l join names as r on l.e_child = r.id and l.e_file = r.file;
let type_alias_annotations = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let annotation_fields = select parent, child, file from "semantic-child" where field = "annotation";
let annotated_aliases0_join_1 = select l.assignment as l_assignment, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from annotated_targets as l join annotation_fields as e on l.assignment = e.parent and l.file = e.file;
let annotated_aliases0 = select l.l_assignment as id, l.l_file as file from annotated_aliases0_join_1 as l join type_alias_annotations as r on l.e_child = r.id and l.e_file = r.file;
let annotated_aliases = select l.id as id, l.file as file from annotated_aliases0 as l join values as r on l.id = r.parent and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let callee_origins_join_1 = select l.id as l_id, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from calls as l join functions as e on l.id = e.parent and l.file = e.file;
let callee_origins = select l.l_id as call, r.path as path, l.l_file as file from callee_origins_join_1 as l join "qualified-name" as r on l.e_child = r.id and l.e_file = r.file;
let alias_type_calls = select call, file from callee_origins where path = "typing.TypeAliasType" or path = "typing_extensions.TypeAliasType";
let factory_assignments_join_1 = select l.assignment as l_assignment, l.target as l_target, e.child as e_child, l.file as l_file, e.parent as e_parent, e.file as e_file from single_plain_targets as l join values as e on l.assignment = e.parent and l.file = e.file;
let factory_assignments = select l.l_assignment as id, l.l_target as target, l.e_child as call, l.l_file as file from factory_assignments_join_1 as l join alias_type_calls as r on l.e_child = r.call and l.e_file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_values = select l.id as keyword, l.related as call, e.child as expression, l.file as file from keyword_owners as l join values as e on l.id = e.parent and l.file = e.file;
let keyword_labels = select parent, child, file from "semantic-child" where field = "arg";
let keyword_names_join_1 = select l.keyword as l_keyword, l.call as l_call, l.expression as l_expression, l.file as l_file, e.parent as e_parent, e.file as e_file, e.child as e_child from keyword_values as l join keyword_labels as e on l.keyword = e.parent and l.file = e.file;
let keyword_names = select l.l_keyword as keyword, l.l_call as call, l.l_expression as expression, r.name as name, l.l_file as file from keyword_names_join_1 as l join "identifier" as r on l.e_child = r.id and l.e_file = r.file;
let all_arguments = select call, expression, position, file from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["expression","file"], right-on=["expression","file"]);
let argument_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="expression");
let two_argument_factories = select l.id as id, l.target as target, l.call as call, l.file as file from factory_assignments as l join argument_counts as r on l.call = r.call and l.file = r.file where r.count = 2;
let first_arguments = select call, expression, file from positional_arguments where position = 0;
let strings = select id, file from "literal-properties" where kind = "string";
let string_arguments = select l.call as call, l.expression as expression, l.file as file from first_arguments as l join strings as r on l.expression = r.id and l.file = r.file;
let factory_names = select l.call as call, r.value as name, l.file as file from string_arguments as l join "string-literal" as r on l.expression = r.occurrence and l.file = r.file;
let same_named_factories_join_1 = select l.id as l_id, l.call as l_call, l.file as l_file, l.target as l_target, t.id as t_id, t.file as t_file, t.name as t_name from two_argument_factories as l join "identifier" as t on l.target = t.id and l.file = t.file;
let same_named_factories = select l.l_id as id, l.l_call as call, l.l_file as file from same_named_factories_join_1 as l join factory_names as r on l.l_call = r.call and l.l_file = r.file where l.t_name = r.name;
let keyword_counts = group-count(from=keyword_values, keys=["call","file"], count="count", distinct="keyword");
let no_keyword_factories = antijoin(left=same_named_factories, right=keyword_values, left-on=["call","file"], right-on=["call","file"]);
let tuples = select id, file from nodes where kind = "tuple";
let named_type_params = select l.call as call, l.expression as tuple, l.file as file from keyword_names as l join tuples as r on l.expression = r.id and l.file = r.file where l.name = "type_params";
let type_param_elements = select l.call as call, e.child as element, l.file as file from named_type_params as l join "semantic-child" as e on l.tuple = e.parent and l.file = e.file where e.field = "elts";
let named_type_param_elements = select l.call as call, l.element as element, l.file as file from type_param_elements as l join names as r on l.element = r.id and l.file = r.file;
let invalid_type_param_elements = antijoin(left=type_param_elements, right=named_type_param_elements, left-on=["element","file"], right-on=["element","file"]);
let valid_type_params = antijoin(left=named_type_params, right=invalid_type_param_elements, left-on=["call","file"], right-on=["call","file"]);
let one_keyword_factories_join_1 = select l.id as l_id, l.call as l_call, l.file as l_file, c.call as c_call, c.file as c_file, c.count as c_count from same_named_factories as l join keyword_counts as c on l.call = c.call and l.file = c.file;
let one_keyword_factories = select l.l_id as id, l.l_call as call, l.l_file as file from one_keyword_factories_join_1 as l join valid_type_params as r on l.l_call = r.call and l.l_file = r.file where l.c_count = 1;
let factory_aliases0 = union(left=no_keyword_factories, right=one_keyword_factories);
let factory_aliases = select id, file from factory_aliases0;
let all_aliases = union(left=annotated_aliases, right=factory_aliases);
let typevar_calls = select call, file from callee_origins where path = "typing.TypeVar" or path = "typing_extensions.TypeVar" or path = "typing.TypeVarTuple" or path = "typing_extensions.TypeVarTuple" or path = "typing.ParamSpec" or path = "typing_extensions.ParamSpec";
let default_keyword_calls = select call, file from keyword_names where name = "default";
let typevar_name_arguments = select l.call as call, l.file as file from positional_arguments as l join strings as r on l.expression = r.id and l.file = r.file where l.position = 0;
let default_typevar_calls_join_1 = select l.call as l_call, l.file as l_file, r.call as r_call, r.file as r_file from typevar_calls as l join default_keyword_calls as r on l.call = r.call and l.file = r.file;
let default_typevar_calls = select l.l_call as call, l.l_file as file from default_typevar_calls_join_1 as l join typevar_name_arguments as n on l.l_call = n.call and l.l_file = n.file;
let default_assignments_join_1 = select l.target as l_target, l.file as l_file, l.assignment as l_assignment, e.parent as e_parent, e.file as e_file, e.child as e_child from single_plain_targets as l join values as e on l.assignment = e.parent and l.file = e.file;
let default_assignments = select l.l_target as binding, l.l_file as file from default_assignments_join_1 as l join default_typevar_calls as r on l.e_child = r.call and l.e_file = r.file;
let default_uses = select l.reference as id, l.file as file from "binding-use" as l join default_assignments as r on l.binding = r.binding and l.file = r.file;
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_axes = axis(from=default_uses, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let embedded_uses = select id, file from embedded_axes;
let ordinary_default_uses = antijoin(left=default_uses, right=embedded_uses, left-on=["id","file"], right-on=["id","file"]);
let default_reference_axes = axis(from=ordinary_default_uses, relation="semantic-child", direction=nearest-ancestor, domain=annotated_aliases);
let annotated_aliases_with_defaults = select related as id, file from default_reference_axes;
let default_type_params = select l.call as call, l.file as file from named_type_param_elements as l join ordinary_default_uses as r on l.element = r.id and l.file = r.file;
let factory_aliases_with_defaults = select l.id as id, l.file as file from one_keyword_factories as l join default_type_params as r on l.call = r.call and l.file = r.file;
let aliases_with_defaults = union(left=annotated_aliases_with_defaults, right=factory_aliases_with_defaults);
let no_default_aliases = antijoin(left=all_aliases, right=aliases_with_defaults, left-on=["id","file"], right-on=["id","file"]);
let target_files = select file from "language-target" where major = 3 and minor >= 12;
let selected = select l.id as id, l.file as file from no_default_aliases as l join target_files as r on l.file = r.file;
let candidates_join_1 = select l.id as l_id, l.file as l_file, r.span as r_span, r.id as r_id, r.file as r_file from selected as l join nodes as r on l.id = r.id and l.file = r.file;
let candidates = select l.l_id as id, l.l_file as file, l.r_span as span, s."start-line" as line from candidates_join_1 as l join "source-location" as s on l.l_id = s.id and l.l_file = s.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP040(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:UP040)(?:,|$)");
let ruf100_candidates = select file, span from violations;
let ruf100_matches = ruf100_candidate_matches(candidates=ruf100_candidates, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*(?:UP040)(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:UP040)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "UP040"});
observe ruf100_used as noqa_matches;
let ruf100_visible = antijoin(left=violations, right=ruf100_matches, left-on=[file,span], right-on=[file,span]);
emit ruf100_visible subject file key(id);
