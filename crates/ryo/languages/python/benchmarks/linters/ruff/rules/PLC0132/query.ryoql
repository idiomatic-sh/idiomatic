import observation_matches from "python/ruff/suppress-matches";
let assignments = select id, file from "semantic-syntax" where kind = "assign";
let value_edges = select parent, child from "semantic-child" where field = "value";
let assignment_values = select l.id as assignment, l.file as file, r.child as call from assignments as l join value_edges as r on l.id = r.parent;
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let direct_calls = select l.assignment as assignment, l.file as file, l.call as call, r.span as call_span from assignment_values as l join calls as r on l.call = r.id and l.file = r.file;
let callee_edges = select parent, child from "semantic-child" where field = "func";
let call_callees = select l.assignment as assignment, l.call as call, l.call_span as call_span, l.file as file, r.child as callee from direct_calls as l join callee_edges as r on l.call = r.parent;
let qualified_calls = select l.assignment as assignment, l.call as call, l.call_span as call_span, l.callee as callee, l.file as file, r.path as path, r.span as callee_span from call_callees as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let variable_calls = select * from qualified_calls where path = "typing.TypeVar" or path = "typing_extensions.TypeVar" or path = "typing.ParamSpec" or path = "typing_extensions.ParamSpec" or path = "_typeshed.TypeVar" or path = "_typeshed.ParamSpec";
let all_typing_calls = select * from qualified_calls where path = "typing.TypeVar" or path = "typing_extensions.TypeVar" or path = "typing.ParamSpec" or path = "typing_extensions.ParamSpec" or path = "typing.TypeVarTuple" or path = "typing_extensions.TypeVarTuple" or path = "typing.NewType" or path = "typing_extensions.NewType" or path = "_typeshed.TypeVar" or path = "_typeshed.ParamSpec" or path = "_typeshed.TypeVarTuple" or path = "_typeshed.NewType";
let keyword_nodes = select id, file from "semantic-syntax" where kind = "keyword";
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let keyword_name_edges = select parent, child from "semantic-child" where field = "arg";
let keyword_identifiers = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join keyword_name_edges as r on l.id = r.parent;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from keyword_identifiers as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.keyword as keyword, l.call as call, l.file as file, l.name as name, r.child as value from keyword_names as l join value_edges as r on l.keyword = r.parent;
let all_keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent;
let keyword_name_values = select call, file, value from named_keyword_values where name = "name";
let first_arguments = select call, file, expression as value from "call-argument" where position = 0;
let first_non_keyword_arguments = antijoin(left=first_arguments, right=all_keyword_values, left-on=["value","file"], right-on=["value","file"]);
let starred_nodes = select id, file from "semantic-syntax" where kind = "starred";
let first_positional_arguments = antijoin(left=first_non_keyword_arguments, right=starred_nodes, left-on=["value","file"], right-on=["id","file"]);
let positional_name_values = antijoin(left=first_positional_arguments, right=keyword_name_values, left-on=["call","file"], right-on=["call","file"]);
let selected_name_values = union(left=keyword_name_values, right=positional_name_values);
let constant_nodes = select id, file from "semantic-syntax" where kind = "constant";
let plain_strings = select l.occurrence as id, l.file as file, l.value as value from "string-literal" as l join constant_nodes as r on l.occurrence = r.id and l.file = r.file;
let declared_names = select l.call as call, l.file as file, r.value as name from selected_name_values as l join plain_strings as r on l.value = r.id and l.file = r.file;
let literal_true = select id, file from "literal-properties" where kind = "boolean" and boolean = "true";
let true_keywords = select l.call as call, l.file as file, l.name as name from named_keyword_values as l join literal_true as r on l.value = r.id and l.file = r.file;
let covariant_calls = select call, file from true_keywords where name = "covariant";
let contravariant_calls = select call, file from true_keywords where name = "contravariant";
let bivariant_calls = select l.call as call, l.file as file from covariant_calls as l join contravariant_calls as r on l.call = r.call and l.file = r.file;
let target_edges = select parent as assignment, child as target, file from "semantic-child" where field = "targets";
let assignment_targets = select l.id as assignment, l.file as file, r.target as target from assignments as l join target_edges as r on l.id = r.assignment and l.file = r.file;
let target_counts = group-count(from=assignment_targets, keys=["assignment","file"], count="count", distinct="target");
let single_targets = select l.assignment as assignment, l.file as file, l.target as target from assignment_targets as l join target_counts as r on l.assignment = r.assignment and l.file = r.file where r.count = 1;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let name_targets = select l.assignment as assignment, l.file as file, l.target as target from single_targets as l join name_nodes as r on l.target = r.id and l.file = r.file;
let named_targets = select l.assignment as assignment, l.file as file, r.name as name from name_targets as l join "identifier" as r on l.target = r.id and l.file = r.file;
let assigned_typing_calls = select l.call as call, l.file as file, l.call_span as call_span, r.name as variable from all_typing_calls as l join named_targets as r on l.assignment = r.assignment and l.file = r.file;
let candidates = select l.call as id, l.file as file, l.call_span as span from assigned_typing_calls as l join declared_names as r on l.call = r.call and l.file = r.file where l.variable != r.name;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLC0132)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLC0132"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
