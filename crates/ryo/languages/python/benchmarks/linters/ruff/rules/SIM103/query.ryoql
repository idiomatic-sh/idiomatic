import observation_matches from "python/ruff/suppress-matches";
import conditional_guards from "python/ruff/conditional-guards";
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if";
let locations = select id, span, "start-byte", "end-byte", "start-line", file from "source-location";
let roots = select id, file from ifs;
let clauses = select id, file from nodes where kind = "elif-else-clause";
let clause_edges = select l.id as root, r.child as clause, r.ordinal as ordinal, l.file as file from roots as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "orelse";
let tests0 = select parent, child, file from "semantic-child" where field = "test";
let tested_clauses = select l.root as root, l.clause as branch, l.file as file from clause_edges as l join tests0 as r on l.clause = r.parent and l.file = r.file;
let else_clauses = antijoin(left=clause_edges, right=tests0, left-on=["clause", "file"], right-on=["parent", "file"]);
let first_branches = select id as root, id as branch, file from roots;
let branches = union(left=first_branches, right=tested_clauses);
let branch_positions = select l.root as root, l.branch as branch, r."start-byte" as position, l.file as file from branches as l join locations as r on l.branch = r.id and l.file = r.file;
let not_terminal = select l.root as root, l.branch as branch, l.file as file from branch_positions as l join branch_positions as r on l.root = r.root and l.file = r.file where l.position < r.position;
let terminal = antijoin(left=branches, right=not_terminal, left-on=["root", "branch", "file"], right-on=["root", "branch", "file"]);
let else_bodies = select l.root as root, r.child as other_return, l.file as file from else_clauses as l join "semantic-child" as r on l.clause = r.parent and l.file = r.file where r.field = "body";
let else_counts = group-count(from=else_bodies, keys=["root", "file"], count="count", distinct="other_return");
let single_else0 = select l.root as root, l.other_return as other_return, l.file as file from else_bodies as l join else_counts as r on l.root = r.root and l.file = r.file where r.count = 1;
let single_else = select l.root as root, r.branch as branch, l.other_return as other_return, l.file as file from single_else0 as l join terminal as r on l.root = r.root and l.file = r.file;
let with_else = select root as id, file from clause_edges;
let implicit_roots = antijoin(left=roots, right=with_else, left-on=["id", "file"], right-on=["id", "file"]);
let suite_members = select parent, child, ordinal, field, file from "semantic-child" where field = "body" or field = "orelse" or field = "finalbody";
let root_suites = select l.id as root, r.parent as suite, r.field as field, r.ordinal as ordinal, l.file as file from implicit_roots as l join suite_members as r on l.id = r.child and l.file = r.file;
let following = select l.root as root, r.child as next, r.ordinal as ordinal, l.file as file from root_suites as l join suite_members as r on l.suite = r.parent and l.field = r.field and l.file = r.file where r.ordinal > l.ordinal;
let not_next = select l.root as root, l.next as next, l.file as file from following as l join following as r on l.root = r.root and l.file = r.file where r.ordinal < l.ordinal;
let next_statements = antijoin(left=following, right=not_next, left-on=["root", "next", "file"], right-on=["root", "next", "file"]);
let implicit_else = select root, root as branch, next as other_return, file from next_statements;
let else_cases = union(left=single_else, right=implicit_else);
let body_owners = union(left=ifs, right=clauses);
let bodies = select l.id as branch, r.child as member, l.file as file from body_owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=bodies, keys=["branch", "file"], count="count", distinct="member");
let single_bodies = select l.branch as branch, l.member as return, l.file as file from bodies as l join body_counts as r on l.branch = r.branch and l.file = r.file where r.count = 1;
let returns = select id, file from nodes where kind = "return";
let return_edges = select l.id as return, r.child as value, l.file as file from returns as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let bool_returns = select l.return as return, r.boolean as boolean, l.file as file from return_edges as l join "literal-properties" as r on l.value = r.id and l.file = r.file where r.kind = "boolean";
let body_bools = select l.branch as branch, r.boolean as boolean, l.file as file from single_bodies as l join bool_returns as r on l.return = r.return and l.file = r.file;
let case_bools = select l.root as root, l.branch as branch, l.other_return as other_return, r.boolean as boolean, l.file as file from else_cases as l join body_bools as r on l.branch = r.branch and l.file = r.file;
let opposite = select l.root as root, l.branch as branch, l.other_return as other_return, l.file as file from case_bools as l join bool_returns as r on l.other_return = r.return and l.file = r.file where l.boolean != r.boolean;
let tests = select l.id as context, r.child as test, l.file as file from roots as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let guarded = conditional_guards(conditions=tests);
let reportable = antijoin(left=opposite, right=guarded, left-on=["root", "file"], right-on=["context", "file"]);
let bounds0 = select l.root as id, l.other_return as other_return, r.span as start_span, r."start-line" as line, l.file as file from reportable as l join locations as r on l.branch = r.id and l.file = r.file;
let bounds = select l.id as id, l.start_span as start_span, r.span as end_span, l.line as line, l.file as file from bounds0 as l join locations as r on l.other_return = r.id and l.file = r.file;
let composed = span-between(from=bounds, start="start_span", end="end_span", output="span");
let candidates = select id, file, span, line from composed;
let violations_matches = observation_matches(candidates=candidates, codes="^(?:SIM103)$");
let violations_rows = select id, file, span from candidates;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "SIM103"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
