import observation_matches from "python/ruff/suppress-matches";
let bodies = select parent, child, ordinal from "semantic-child" where field = "body";
let multiple = select l.parent as id from bodies as l join bodies as r on l.parent = r.parent where l.ordinal != r.ordinal;
let single = antijoin(left=bodies, right=multiple, left-on=["parent"], right-on=["id"]);
let scopes = select id from "semantic-syntax" where (kind = "function-def" or kind = "async-function-def" or kind = "class-def") and glob_any(file, "**/*.pyi");
let scoped = select r.child as id from scopes as l join single as r on l.id = r.parent;
let passes = select id, file, span from "semantic-syntax" where kind = "pass";
let reportable = select r.id as id, r.file as file, r.span as span from scoped as l join passes as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PYI009)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "PYI009"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
