import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let loops = select id, kind, file from nodes where kind = "for" or kind = "async-for" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let target_fields = select parent, child from "semantic-child" where field = "target";
let body_fields = select parent, child from "semantic-child" where field = "body";
let statement_loop_targets = select l.id as loop, r.child as id, l.file as file from loops as l join target_fields as r on l.id = r.parent where l.kind = "for" or l.kind = "async-for";
let generator_fields = select parent, child from "semantic-child" where field = "generators";
let comprehension_clauses = select l.id as loop, r.child as clause, l.file as file from loops as l join generator_fields as r on l.id = r.parent;
let comprehension_targets = select l.loop as loop, r.child as id, l.file as file from comprehension_clauses as l join target_fields as r on l.clause = r.parent;
let loop_target_roots = union(left=statement_loop_targets, right=comprehension_targets);
let comprehension_body_fields = select parent, child from "semantic-child" where field = "elt" or field = "key" or field = "value";
let statement_loop_bodies = select l.id as loop, r.child as id, l.file as file from loops as l join body_fields as r on l.id = r.parent where l.kind = "for" or l.kind = "async-for";
let comprehension_bodies = select l.id as loop, r.child as id, l.file as file from loops as l join comprehension_body_fields as r on l.id = r.parent;
let loop_body_roots = union(left=statement_loop_bodies, right=comprehension_bodies);
let descendant_nodes = select child as id from "semantic-child";
let target_walk = axis(from=loop_target_roots, relation="semantic-child", direction=descendant, domain=descendant_nodes);
let target_descendants = select loop, related as id, file from target_walk;
let body_walk = axis(from=loop_body_roots, relation="semantic-child", direction=descendant, domain=descendant_nodes);
let body_descendants = select loop, related as id, file from body_walk;
let target_ids = select loop, id, file from loop_target_roots;
let target_children = select loop, id, file from target_descendants;
let all_target_ids = union(left=target_ids, right=target_children);
let body_ids = select loop, id, file from loop_body_roots;
let body_children = select loop, id, file from body_descendants;
let all_body_ids = union(left=body_ids, right=body_children);
let loop_bindings_target = select l.loop as loop, r.occurrence as binding, r.name as name, r.scope as scope, r.file as file from all_target_ids as l join "binding-event" as r on l.id = r.occurrence and l.file = r.file where r.kind = "bind";
let loop_bindings_body_all = select l.loop as loop, r.occurrence as binding, r.name as name, r.scope as scope, r.file as file from all_body_ids as l join "binding-event" as r on l.id = r.occurrence and l.file = r.file where r.kind = "bind";
let scope_nodes = select id, kind, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda" or kind = "list-comp" or kind = "set-comp" or kind = "dict-comp" or kind = "generator-exp";
let loop_scope_ancestors = axis(from=loops, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let loop_scopes = select l.id as loop, r.related as scope, l.file as file from loops as l join loop_scope_ancestors as r on l.id = r.id and l.file = r.file;
let loop_bindings_body = select l.loop as loop, l.binding as binding, l.name as name, l.scope as scope, l.file as file from loop_bindings_body_all as l join loop_scopes as r on l.loop = r.loop and l.scope = r.scope and l.file = r.file;
let bindings = union(left=loop_bindings_target, right=loop_bindings_body);
let functions = select id, kind, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let functions_in_loop = axis(from=functions, relation="semantic-child", direction=ancestor, domain=loops);
let nested_functions_all = select l.id as function, r.related as loop, l.file as file from functions as l join functions_in_loop as r on l.id = r.id and l.file = r.file;
let iter_fields = select parent, child from "semantic-child" where field = "iter";
let loop_iter_roots = select l.id as loop, r.child as id, l.file as file from loops as l join iter_fields as r on l.id = r.parent;
let iter_walk = axis(from=loop_iter_roots, relation="semantic-child", direction=descendant, domain=descendant_nodes);
let iter_descendants = select loop, related as id, file from iter_walk;
let iter_nodes = union(left=loop_iter_roots, right=iter_descendants);
let functions_in_iter = select l.loop as loop, r.id as function, l.file as file from iter_nodes as l join functions as r on l.id = r.id and l.file = r.file;
let nested_functions = antijoin(left=nested_functions_all, right=functions_in_iter, left-on=["loop", "function", "file"], right-on=["loop", "function", "file"]);
let immediate_lambda_funcs = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.child where r.field = "func";
let return_nodes = select id, file from nodes where kind = "return";
let return_fields = select parent, child from "semantic-child" where field = "value";
let returned_lambdas = select r.child as id, l.file as file from return_nodes as l join return_fields as r on l.id = r.parent;
let call_nodes = select id, file from nodes where kind = "call";
let call_func_fields = select parent, child from "semantic-child" where field = "func";
let call_function_names = select l.id as call, r.child as function_name, l.file as file from call_nodes as l join call_func_fields as r on l.id = r.parent;
let name_nodes = select id, file from nodes where kind = "name";
let identifier_fields = select parent, child from "semantic-child" where field = "id";
let function_name_nodes = select l.parent as reference, r.file as file from identifier_fields as l join name_nodes as r on l.parent = r.id;
let function_names = select l.reference as reference, r.name as name, l.file as file from function_name_nodes as l join "identifier" as r on l.reference = r.id and l.file = r.file;
let safe_builtin_names = select reference, file from function_names where name = "map" or name = "filter" or name = "reduce";
let safe_name_calls = select l.call as call, l.file as file from call_function_names as l join safe_builtin_names as r on l.function_name = r.reference and l.file = r.file;
let functools_reduce_names = select id, file from "qualified-name" where path = "functools.reduce";
let functools_reduce_calls = select l.call as call, l.file as file from call_function_names as l join functools_reduce_names as r on l.function_name = r.id and l.file = r.file;
let safe_builtin_calls = union(left=safe_name_calls, right=functools_reduce_calls);
let call_argument_fields = select parent as call, child as wrapper, file from "semantic-child";
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_argument_fields as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let positional_fields = select parent, child, file from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from call_wrappers as l join positional_fields as r on l.wrapper = r.parent and l.file = r.file;
let safe_positional_arguments = select l.argument as id, l.file as file from positional_arguments as l join safe_builtin_calls as r on l.call = r.call and l.file = r.file;
let safe_argument_functions = select l.id as id, l.file as file from safe_positional_arguments as l join functions as r on l.id = r.id and l.file = r.file where r.kind = "lambda";
let safe_direct_functions = union(left=immediate_lambda_funcs, right=returned_lambdas);
let safe_functions = union(left=safe_direct_functions, right=safe_argument_functions);
let unsafe_functions = antijoin(left=functions, right=safe_functions, left-on=["id","file"], right-on=["id","file"]);
let function_loops = select l.function as function, l.loop as loop, l.file as file from nested_functions as l join unsafe_functions as r on l.function = r.id and l.file = r.file;
let function_uses = select reference, binding, phase, file from "binding-use";
let uses_in_function = select l.loop as loop, l.function as function, r.reference as id, r.binding as binding, l.file as file from function_loops as l join function_uses as r on l.function = r.phase and l.file = r.file;
let captured_loop_bindings = select l.id as id, l.file as file from uses_in_function as l join bindings as r on l.loop = r.loop and l.binding = r.binding and l.file = r.file;
let reportable = select l.id as id, l.file as file, r.span as span from captured_loop_bindings as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B023)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "B023"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
