import observation_matches from "python/ruff/suppress-matches";
import line_located from "python/ruff/candidate-locations";
let nodes = select id, kind, text, file, span from "semantic-syntax";
let loops = select id, kind, file from nodes where kind in ["for", "async-for", "while", "list-comp", "set-comp", "dict-comp", "generator-exp"];
let target_fields = select parent, child from "semantic-child" where field = "target";
let body_fields = select parent, child from "semantic-child" where field = "body";
let statement_loop_targets = select l.id as loop, r.child as id, l.file as file from loops as l join target_fields as r on l.id = r.parent where l.kind = "for" or l.kind = "async-for";
let generator_fields = select parent, child from "semantic-child" where field = "generators";
let comprehension_clauses = select l.id as loop, r.child as clause, l.file as file from loops as l join generator_fields as r on l.id = r.parent;
let comprehension_targets = select l.loop as loop, r.child as id, l.file as file from comprehension_clauses as l join target_fields as r on l.clause = r.parent;
let loop_target_roots = union(left=statement_loop_targets, right=comprehension_targets);
let comprehension_body_fields = select parent, child from "semantic-child" where field = "elt" or field = "key" or field = "value";
let statement_loop_bodies = select l.id as loop, r.child as id, l.file as file from loops as l join body_fields as r on l.id = r.parent where l.kind = "for" or l.kind = "async-for" or l.kind = "while";
let comprehension_bodies = select l.id as loop, r.child as id, l.file as file from loops as l join comprehension_body_fields as r on l.id = r.parent;
let loop_body_roots = union(left=statement_loop_bodies, right=comprehension_bodies);
let scope_nodes = select id, kind, file from nodes where kind in ["module", "function-def", "async-function-def", "class-def", "lambda", "list-comp", "set-comp", "dict-comp", "generator-exp"];
let functions = select id, kind, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let functions_in_loop = axis(from=functions, relation="semantic-child", direction=ancestor, domain=loops);
let nested_functions_all = select l.id as function, r.related as loop, l.file as file from functions as l join functions_in_loop as r on l.id = r.id and l.file = r.file;
let iter_fields = select parent, child from "semantic-child" where field = "iter";
let loop_iter_roots = select l.id as loop, r.child as id, l.file as file from loops as l join iter_fields as r on l.id = r.parent;
let iter_root_ids = select id from loop_iter_roots;
let function_iter_roots = axis(from=functions, relation="semantic-child", direction=ancestor, domain=iter_root_ids);
let functions_below_iter = select l.loop as loop, r.id as function, l.file as file from loop_iter_roots as l join function_iter_roots as r on l.id = r.related and l.file = r.file;
let functions_at_iter = select l.loop as loop, r.id as function, l.file as file from loop_iter_roots as l join functions as r on l.id = r.id and l.file = r.file;
let functions_in_iter = union(left=functions_below_iter, right=functions_at_iter);
let nested_functions = antijoin(left=nested_functions_all, right=functions_in_iter, left-on=["loop", "function", "file"], right-on=["loop", "function", "file"]);
let immediate_lambda_funcs = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.child where r.field = "func";
let return_nodes = select id, file from nodes where kind = "return";
let return_fields = select parent, child from "semantic-child" where field = "value";
let returned_lambdas = select r.child as id, l.file as file from return_nodes as l join return_fields as r on l.id = r.parent;
let call_nodes = select id, file from nodes where kind = "call";
let call_func_fields = select parent, child from "semantic-child" where field = "func";
let call_function_names = select l.id as call, r.child as function_name, l.file as file from call_nodes as l join call_func_fields as r on l.id = r.parent;
let name_nodes = select id, file from nodes where kind = "name";
let identifier_fields = select parent, child from "semantic-child" where field = "id";
let function_name_nodes = select l.parent as reference, r.file as file from identifier_fields as l join name_nodes as r on l.parent = r.id;
let function_names = select l.reference as reference, r.name as name, l.file as file from function_name_nodes as l join "identifier" as r on l.reference = r.id and l.file = r.file;
let safe_builtin_names = select reference, file from function_names where name = "map" or name = "filter" or name = "reduce";
let safe_name_calls = select l.call as call, l.file as file from call_function_names as l join safe_builtin_names as r on l.function_name = r.reference and l.file = r.file;
let functools_reduce_names = select id, file from "qualified-name" where path = "functools.reduce";
let functools_reduce_calls = select l.call as call, l.file as file from call_function_names as l join functools_reduce_names as r on l.function_name = r.id and l.file = r.file;
let safe_builtin_calls = union(left=safe_name_calls, right=functools_reduce_calls);
let argument_nodes = select id, file from nodes where kind = "call-arguments";
let call_argument_fields = select parent as call, child as wrapper, file from "semantic-child";
let call_wrappers = select l.call as call, r.id as wrapper, r.file as file from call_argument_fields as l join argument_nodes as r on l.wrapper = r.id and l.file = r.file;
let positional_fields = select parent, child, file from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as argument, l.file as file from call_wrappers as l join positional_fields as r on l.wrapper = r.parent and l.file = r.file;
let safe_positional_arguments = select l.argument as id, l.file as file from positional_arguments as l join safe_builtin_calls as r on l.call = r.call and l.file = r.file;
let safe_argument_functions = select l.id as id, l.file as file from safe_positional_arguments as l join functions as r on l.id = r.id and l.file = r.file where r.kind = "lambda";
let keyword_fields = select parent, child, file from "semantic-child" where field = "keywords";
let call_keywords = select l.call as call, r.child as keyword, l.file as file from call_wrappers as l join keyword_fields as r on l.wrapper = r.parent and l.file = r.file;
let keyword_arg_fields = select parent, child from "semantic-child" where field = "arg";
let keyword_args = select l.keyword as keyword, r.child as arg, l.file as file from call_keywords as l join keyword_arg_fields as r on l.keyword = r.parent;
let keyword_names = select l.keyword as keyword, r.name as name, l.file as file from keyword_args as l join "identifier" as r on l.arg = r.id and l.file = r.file;
let key_keywords = select keyword, file from keyword_names where name = "key";
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let key_values = select r.child as id, l.file as file from key_keywords as l join keyword_value_fields as r on l.keyword = r.parent;
let key_lambdas = select l.id as id, l.file as file from key_values as l join functions as r on l.id = r.id and l.file = r.file where r.kind = "lambda";
let safe_direct_functions0 = union(left=immediate_lambda_funcs, right=returned_lambdas);
let safe_direct_functions = union(left=safe_direct_functions0, right=key_lambdas);
let safe_functions = union(left=safe_direct_functions, right=safe_argument_functions);
let unsafe_functions = antijoin(left=functions, right=safe_functions, left-on=["id","file"], right-on=["id","file"]);
let function_loops = select l.function as function, l.loop as loop, l.file as file from nested_functions as l join unsafe_functions as r on l.function = r.id and l.file = r.file;
let function_uses = select reference, binding, phase, file from "binding-use";
let uses_in_function = select l.loop as loop, l.function as function, r.reference as id, r.binding as binding, l.file as file from function_loops as l join function_uses as r on l.function = r.phase and l.file = r.file;
let used_pairs = project(from=uses_in_function, columns=["loop", "binding", "file"]);
let used_bind_events = select l.loop as loop, l.binding as binding, r.scope as scope, l.file as file from used_pairs as l join "binding-event" as r on l.binding = r.occurrence and l.file = r.file where r.kind = "bind";
let used_binding_pairs = project(from=used_bind_events, columns=["binding", "file"]);
let used_binding_ids = select binding as id, file from used_binding_pairs;
let target_root_ids = select id from loop_target_roots;
let used_target_up = axis(from=used_binding_ids, relation="semantic-child", direction=ancestor, domain=target_root_ids);
let target_up_roots = select l.id as binding, r.loop as loop, l.file as file from used_target_up as l join loop_target_roots as r on l.related = r.id and l.file = r.file;
let target_self_roots = select l.binding as binding, r.loop as loop, l.file as file from used_bind_events as l join loop_target_roots as r on l.binding = r.id and l.file = r.file;
let target_bindings = union(left=target_up_roots, right=target_self_roots);
let loop_bindings_target = select l.loop as loop, l.binding as binding, l.file as file from used_bind_events as l join target_bindings as r on l.binding = r.binding and l.loop = r.loop and l.file = r.file;
let body_root_ids = select id from loop_body_roots;
let used_body_up = axis(from=used_binding_ids, relation="semantic-child", direction=ancestor, domain=body_root_ids);
let body_up_roots = select l.id as binding, r.loop as loop, l.file as file from used_body_up as l join loop_body_roots as r on l.related = r.id and l.file = r.file;
let body_self_roots = select l.binding as binding, r.loop as loop, l.file as file from used_bind_events as l join loop_body_roots as r on l.binding = r.id and l.file = r.file;
let body_bindings = union(left=body_up_roots, right=body_self_roots);
let body_events = select l.loop as loop, l.binding as binding, l.scope as scope, l.file as file from used_bind_events as l join body_bindings as r on l.binding = r.binding and l.loop = r.loop and l.file = r.file;
let used_loop_pairs = project(from=used_pairs, columns=["loop", "file"]);
let used_loops = select loop as id, file from used_loop_pairs;
let loop_scope_ancestors = axis(from=used_loops, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let loop_scopes = select id as loop, related as scope, file from loop_scope_ancestors;
let scoped_body_bindings = select l.loop as loop, l.binding as binding, l.file as file from body_events as l join loop_scopes as r on l.loop = r.loop and l.scope = r.scope and l.file = r.file;
let assigning_statements = select id, file from nodes where kind in ["assign", "aug-assign", "ann-assign", "for", "async-for"];
let assignment_target_roots = select r.child as id, l.file as file from assigning_statements as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets" or r.field = "target";
let assignment_root_ids = select id from assignment_target_roots;
let bindings_under_targets = axis(from=used_binding_ids, relation="semantic-child", direction=ancestor, domain=assignment_root_ids);
let nested_target_bindings = select id as binding, file from bindings_under_targets;
let root_target_bindings = select l.id as binding, l.file as file from used_binding_ids as l join assignment_target_roots as r on l.id = r.id and l.file = r.file;
let assigned_bindings = union(left=nested_target_bindings, right=root_target_bindings);
let loop_bindings_body = select l.loop as loop, l.binding as binding, l.file as file from scoped_body_bindings as l join assigned_bindings as r on l.binding = r.binding and l.file = r.file;
let bindings = union(left=loop_bindings_target, right=loop_bindings_body);
let captured_uses = select l.id as id, l.function as function, l.binding as binding, l.file as file from uses_in_function as l join bindings as r on l.loop = r.loop and l.binding = r.binding and l.file = r.file;
let captured_names = select l.id as id, l.function as function, r.name as name, l.file as file from captured_uses as l join "binding-event" as r on l.binding = r.occurrence and l.file = r.file where r.kind = "bind";
let function_binds = select phase as function, name, file from "binding-event" where kind = "bind";
let rebound_uses = select l.id as id, l.file as file from captured_names as l join function_binds as r on l.function = r.function and l.name = r.name and l.file = r.file;
let captured_ids = select id, file from captured_uses;
let captured_loop_bindings = antijoin(left=captured_ids, right=rebound_uses, left-on=["id", "file"], right-on=["id", "file"]);
let reportable = select l.id as id, l.file as file, r.span as span from captured_loop_bindings as l join nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=reportable);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:B023)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "B023"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
