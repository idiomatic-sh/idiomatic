import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let declarations = union(left=classes, right=functions);
let nested_axes = axis(from=declarations, relation="semantic-child", direction=ancestor, domain=declarations);
let nested = select id, file from nested_axes;
let outer_declarations = antijoin(left=declarations, right=nested, left-on=["id","file"], right-on=["id","file"]);
let parameter_lists = select parent as id, file from "semantic-child" where field = "type-params";
let ordinary_declarations = antijoin(left=outer_declarations, right=parameter_lists, left-on=["id","file"], right-on=["id","file"]);
let target_files = select file from "language-target" where major = 3 and minor >= 12;
let eligible_declarations = select l.id as id, l.file as file from ordinary_declarations as l join target_files as r on l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let callees = select l.id as call, r.child as callee, l.file as file from calls as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "func";
let factories = select id, file from "qualified-name" where path = "typing.TypeVar" or path = "typing_extensions.TypeVar" or path = "typing.ParamSpec" or path = "typing_extensions.ParamSpec" or path = "typing.TypeVarTuple" or path = "typing_extensions.TypeVarTuple";
let factory_calls = select l.call as call, l.file as file from callees as l join factories as r on l.callee = r.id and l.file = r.file;
let string_nodes = select id, file from "literal-properties" where kind = "string";
let first_args = select call, expression, file from "call-argument" where position = 0;
let first_strings = select l.call as call, l.file as file from first_args as l join string_nodes as r on l.expression = r.id and l.file = r.file;
let valid_factories = select l.call as call, l.file as file from factory_calls as l join first_strings as r on l.call = r.call and l.file = r.file;
let assignments = select id, file from nodes where kind = "assign";
let assigned_values = select l.id as assignment, r.child as value, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let factory_assignments = select l.assignment as assignment, l.value as call, l.file as file from assigned_values as l join valid_factories as r on l.value = r.call and l.file = r.file;
let assigned_targets = select l.assignment as assignment, l.call as call, r.child as binding, l.file as file from factory_assignments as l join "semantic-child" as r on l.assignment = r.parent and l.file = r.file where r.field = "targets";
let typevar_bindings = select l.binding as binding, l.call as call, l.file as file from assigned_targets as l join "identifier" as r on l.binding = r.id and l.file = r.file;
let binding_reads = select reference, binding, file from "binding-use" where certainty = "unique";
let typevar_reads = select l.reference as id, r.call as call, l.file as file from binding_reads as l join typevar_bindings as r on l.binding = r.binding and l.file = r.file;
let keyword_names = select l.parent as keyword, r.name as name, l.file as file from "semantic-child" as l join "identifier" as r on l.child = r.id and l.file = r.file where l.field = "arg";
let default_keywords = select keyword, file from keyword_names where name = "default";
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let default_calls = select l.related as call, l.file as file from keyword_owners as l join default_keywords as r on l.id = r.keyword and l.file = r.file;
let default_reads = select l.id as id, l.file as file from typevar_reads as l join default_calls as r on l.call = r.call and l.file = r.file;
let raw_anystr_reads = select id, file from "qualified-name" where path = "typing.AnyStr" or path = "typing_extensions.AnyStr";
let module_scopes = select child as id, file from "scope" where parent = child;
let builtin_events = select occurrence as id, scope, name, kind, file from "binding-event" where name = "str" or name = "bytes";
let module_builtin_events = select l.id as id, l.name as name, l.kind as kind, l.file as file from builtin_events as l join module_scopes as r on l.scope = r.id and l.file = r.file;
let builtin_points = select l.id as event, l.name as name, l.kind as kind, l.file as file, r."start-byte" as point from module_builtin_events as l join "source-location" as r on l.id = r.id and l.file = r.file;
let anystr_points = select l.id as id, l.file as file, r."start-byte" as point from raw_anystr_reads as l join "source-location" as r on l.id = r.id and l.file = r.file;
let earlier_builtin_events = select l.id as id, l.file as file, r.event as event, r.name as name, r.kind as kind, r.point as event_point from anystr_points as l join builtin_points as r on l.file = r.file where r.point < l.point;
let superseded_builtin_events = select l.id as id, l.file as file, l.event as event from earlier_builtin_events as l join earlier_builtin_events as r on l.id = r.id and l.file = r.file and l.name = r.name where l.event_point < r.event_point;
let last_builtin_events = antijoin(left=earlier_builtin_events, right=superseded_builtin_events, left-on=["id","file","event"], right-on=["id","file","event"]);
let shadowed_anystr = select id, file from last_builtin_events where kind = "bind";
let anystr_reads = antijoin(left=raw_anystr_reads, right=shadowed_anystr, left-on=["id","file"], right-on=["id","file"]);
let ordinary_reads = select id, file from typevar_reads;
let recognized_reads = union(left=ordinary_reads, right=anystr_reads);
let eligible_classes = select l.id as id, l.file as file from eligible_declarations as l join classes as r on l.id = r.id and l.file = r.file;
let base_expressions = select declaration as class, occurrence as id, file from "inherits";
let bases = select l.class as class, l.id as id, l.file as file from base_expressions as l join eligible_classes as r on l.class = r.id and l.file = r.file;
let subscript_bases = select l.class as class, l.id as id, l.file as file from bases as l join nodes as r on l.id = r.id and l.file = r.file where r.kind = "subscript";
let base_values = select l.class as class, l.id as base, r.child as value, l.file as file from subscript_bases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let generic_origins = select id, file from "qualified-name" where path = "typing.Generic" or path = "typing_extensions.Generic";
let generic_bases = select l.class as class, l.base as id, l.file as file from base_values as l join generic_origins as r on l.value = r.id and l.file = r.file;
let base_locations = select l.class as class, l.id as id, l.file as file, r."start-byte" as start_byte from generic_bases as l join "source-location" as r on l.id = r.id and l.file = r.file;
let later_generics = select l.id as id, l.file as file from base_locations as l join base_locations as r on l.class = r.class and l.file = r.file where r.start_byte < l.start_byte;
let first_generics = antijoin(left=generic_bases, right=later_generics, left-on=["id","file"], right-on=["id","file"]);
let slices = select l.id as id, r.child as expression, l.file as file from first_generics as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let slice_roots = select expression as id, file from slices;
let descendants = axis(from=slice_roots, relation="semantic-child", direction=descendant, domain=nodes);
let nested_members = select l.id as id, r.related as member, l.file as file from slices as l join descendants as r on l.expression = r.id and l.file = r.file;
let root_members = select id, expression as member, file from slices;
let members = union(left=root_members, right=nested_members);
let used_reads = select l.id as id, l.member as member, l.file as file from members as l join recognized_reads as r on l.member = r.id and l.file = r.file;
let member_names = select l.id as id, l.member as member, r.name as name, l.file as file from members as l join "identifier" as r on l.member = r.id and l.file = r.file;
let unresolved_names = antijoin(left=member_names, right=recognized_reads, left-on=["member","file"], right-on=["id","file"]);
let unknown_bases = select id, file from unresolved_names;
let name_counts = group-count(from=member_names, keys=["id","name","file"], count="count", distinct="member");
let duplicates = select id, file from name_counts where count > 1;
let default_bases = select l.id as id, l.file as file from used_reads as l join default_reads as r on l.member = r.id and l.file = r.file;
let invalid0 = union(left=duplicates, right=default_bases);
let known_invalid = antijoin(left=invalid0, right=unknown_bases, left-on=["id","file"], right-on=["id","file"]);
let all_base_locations = select l.class as class, l.id as id, l.file as file, r."start-byte" as start_byte from bases as l join "source-location" as r on l.id = r.id and l.file = r.file;
let not_last = select l.id as id, l.file as file from base_locations as l join all_base_locations as r on l.class = r.class and l.file = r.file where r.start_byte > l.start_byte;
let invalid_last = antijoin(left=known_invalid, right=not_last, left-on=["id","file"], right-on=["id","file"]);
let reportable = antijoin(left=first_generics, right=invalid_last, left-on=["id","file"], right-on=["id","file"]);
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="(?:^|[^A-Z0-9])UP046(?:$|[^A-Z0-9])", range-pattern="(?:^|,)UP046(?:,|$)");
emit violations subject file key(id);
