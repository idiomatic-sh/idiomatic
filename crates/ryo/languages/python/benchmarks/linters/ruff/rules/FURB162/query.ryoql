import observation_matches from "python/ruff/suppress-matches";
import call_syntax from "python/ruff/calls";
import line_located from "python/ruff/candidate-locations";
let calls = call_syntax();
let function_edges = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file, r.span as span from function_edges as l join calls as r on l.parent = r.id and l.file = r.file;
let target_versions = select file, major, minor from "language-target";
let python311_targets = select file from target_versions where major > 3 or major = 3 and minor >= 11;
let fromisoformat_functions = select id, file from "qualified-name" where path = "datetime.datetime.fromisoformat";
let fromisoformat_calls = select l.call as call, l.file as file from call_functions as l join fromisoformat_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id, file from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, l.file as file, r.id as wrapper from "semantic-child" as l join argument_nodes as r on l.child = r.id and l.file = r.file;
let positional_edges = select parent, child, file from "semantic-child" where field = "args";
let positional_args = select l.call as call, r.child as argument, l.file as file from wrappers as l join positional_edges as r on l.wrapper = r.parent and l.file = r.file;
let argument_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from positional_args as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let argument_pairs = select l.call as call, l.argument as later, r.argument as earlier, l.file as file from argument_locations as l join argument_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let later_arguments = select call, later as argument, file from argument_pairs;
let first_arguments = antijoin(left=positional_args, right=later_arguments, left-on=["call", "argument", "file"], right-on=["call", "argument", "file"]);
let argument_counts = group-count(from=positional_args, keys=["call", "file"], count="argument_count", distinct="argument");
let one_argument_calls = select call, file from argument_counts where argument_count = 1;
let keyword_edges = select parent, child, file from "semantic-child" where field = "keywords";
let call_keyword_edges = select l.call as call, l.file as file, r.child as keyword from wrappers as l join keyword_edges as r on l.wrapper = r.parent and l.file = r.file;
let calls_with_keywords = select call, file from call_keyword_edges;
let no_keyword_calls = antijoin(left=one_argument_calls, right=calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let valid_fromisoformat_calls = select l.call as call, l.file as file from fromisoformat_calls as l join no_keyword_calls as r on l.call = r.call and l.file = r.file;
let outer_arguments = select l.call as call, l.file as file, r.argument as argument from valid_fromisoformat_calls as l join first_arguments as r on l.call = r.call and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_values = select parent, child, file from "semantic-child" where field = "value";
let attribute_receivers = select l.id as attribute, l.file as file, r.child as receiver from attributes as l join attribute_values as r on l.id = r.parent and l.file = r.file;
let replace_calls = select l.call as call, l.function as function, l.file as file, l.span as span from call_functions as l;
let replace_function_attributes = select l.call as call, l.file as file, l.span as span, r.receiver as receiver, l.function as function from replace_calls as l join attribute_receivers as r on l.function = r.attribute and l.file = r.file;
let attr_names = select parent, child, file from "semantic-child" where field = "attr";
let named_attributes = select l.parent as attribute, l.file as file, r.name as name from attr_names as l join "identifier" as r on l.child = r.id and l.file = r.file;
let replace_named_calls = select l.call as call, l.file as file, l.span as span, l.receiver as receiver from replace_function_attributes as l join named_attributes as r on l.function = r.attribute and l.file = r.file where r.name = "replace";
let receiver_matches_outer_arg = select l.call as replace_call, l.file as file, r.call as outer_call from replace_named_calls as l join outer_arguments as r on l.call = r.argument and l.file = r.file;
let replace_argument_counts = group-count(from=positional_args, keys=["call", "file"], count="argument_count", distinct="argument");
let two_argument_replace_calls = select l.call as call, l.file as file, l.span as span from replace_named_calls as l join replace_argument_counts as r on l.call = r.call and l.file = r.file where r.argument_count = 2;
let replace_calls_with_keywords = select call, file from call_keyword_edges;
let keyword_free_replace_calls = antijoin(left=two_argument_replace_calls, right=replace_calls_with_keywords, left-on=["call", "file"], right-on=["call", "file"]);
let first_replace_arguments = select l.argument as argument, l.call as call, l.file as file from positional_args as l join keyword_free_replace_calls as r on l.call = r.call and l.file = r.file;
let replace_arg_locations = select l.call as call, l.argument as argument, l.file as file, r."start-byte" as start_byte from first_replace_arguments as l join "source-location" as r on l.argument = r.id and l.file = r.file;
let replace_pairs = select l.call as call, l.argument as later, r.argument as earlier, l.file as file from replace_arg_locations as l join replace_arg_locations as r on l.call = r.call and l.file = r.file where r.start_byte < l.start_byte;
let replace_first_args = select call, earlier as argument, file from replace_pairs;
let replace_second_args = select call, later as argument, file from replace_pairs;
let strings = select occurrence as id, file, value from "string-literal";
let z_arguments = select l.call as call, l.file as file from replace_first_args as l join strings as r on l.argument = r.id and l.file = r.file where r.value = "Z";
let zero_offsets = select id, file from strings where value = "+00:00" or value = "+0000" or value = "+00" or value = "-00:00" or value = "-0000" or value = "-00";
let offset_arguments = select l.call as call, l.file as file from replace_second_args as l join zero_offsets as r on l.argument = r.id and l.file = r.file;
let valid_replace_calls = select l.call as call, l.file as file, l.span as span from keyword_free_replace_calls as l join z_arguments as r on l.call = r.call and l.file = r.file;
let valid_replace_with_offset = select l.call as call, l.file as file, l.span as span from valid_replace_calls as l join offset_arguments as r on l.call = r.call and l.file = r.file;
let matched_replace_calls = select l.replace_call as id, l.file as file from receiver_matches_outer_arg as l join valid_replace_with_offset as r on l.replace_call = r.call and l.file = r.file;
let binary_nodes = select id, file, span from "semantic-syntax" where kind = "bin-op";
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let right_edges = select parent, child, file from "semantic-child" where field = "right";
let binary_lefts = select l.id as binary, l.file as file, r.child as left from binary_nodes as l join left_edges as r on l.id = r.parent and l.file = r.file;
let binary_rights = select l.id as binary, l.file as file, r.child as right from binary_nodes as l join right_edges as r on l.id = r.parent and l.file = r.file;
let plus_ops = select parent, child, file from "semantic-child" where field = "op";
let plus_tokens = select id, file from "semantic-syntax" where text = "+";
let plus_binary_nodes = select l.parent as binary, l.file as file from plus_ops as l join plus_tokens as r on l.child = r.id and l.file = r.file;
let plus_binary_parts = select l.binary as binary, l.file as file, r.left as left from plus_binary_nodes as l join binary_lefts as r on l.binary = r.binary and l.file = r.file;
let plus_binary_values = select l.binary as binary, l.file as file, l.left as left, r.right as right from plus_binary_parts as l join binary_rights as r on l.binary = r.binary and l.file = r.file;
let zero_offset_rights = select l.binary as binary, l.file as file from plus_binary_values as l join zero_offsets as r on l.right = r.id and l.file = r.file;
let strip_names = select attribute, file from named_attributes where name = "strip" or name = "rstrip";
let strip_calls = select l.call as call, l.file as file, l.receiver as receiver from replace_function_attributes as l join strip_names as r on l.function = r.attribute and l.file = r.file;
let strip_counts = group-count(from=positional_args, keys=["call", "file"], count="count", distinct="argument");
let strip_one_args = select l.call as call, l.file as file, l.argument as argument from positional_args as l join strip_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let strip_keyword_rows = select call, file from call_keyword_edges;
let strip_arg_no_keywords = antijoin(left=strip_one_args, right=strip_keyword_rows, left-on=["call", "file"], right-on=["call", "file"]);
let strip_calls_with_arg = select l.call as call, l.file as file, l.receiver as receiver, r.argument as argument from strip_calls as l join strip_arg_no_keywords as r on l.call = r.call and l.file = r.file;
let strip_z_calls = select l.call as call, l.file as file, l.receiver as receiver from strip_calls_with_arg as l join strings as r on l.argument = r.id and l.file = r.file where r.value = "Z";
let strip_lefts = select l.binary as binary, l.file as file from plus_binary_values as l join strip_z_calls as r on l.left = r.call and l.file = r.file;
let slice_nodes = select id, file from "semantic-syntax" where kind = "slice";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let slice_edges = select parent, child, file from "semantic-child" where field = "slice";
let slice_subscripts = select l.parent as subscript, l.file as file, l.child as slice from slice_edges as l join subscript_nodes as r on l.parent = r.id and l.file = r.file;
let lower_edges = select parent, child, file from "semantic-child" where field = "lower";
let upper_edges = select parent, child, file from "semantic-child" where field = "upper";
let step_edges = select parent, child, file from "semantic-child" where field = "step";
let slice_lowers = select l.slice as slice, l.file as file from slice_subscripts as l join lower_edges as r on l.slice = r.parent and l.file = r.file;
let slice_steps = select l.slice as slice, l.file as file from slice_subscripts as l join step_edges as r on l.slice = r.parent and l.file = r.file;
let unbounded_slice_rows = antijoin(left=slice_subscripts, right=slice_lowers, left-on=["slice", "file"], right-on=["slice", "file"]);
let unstepped_slice_rows = antijoin(left=unbounded_slice_rows, right=slice_steps, left-on=["slice", "file"], right-on=["slice", "file"]);
let minus_tokens = select id, file from "semantic-syntax" where text = "-";
let unary_nodes = select id, file from "semantic-syntax" where kind = "unary-op";
let slice_unary_upper = select l.parent as slice, l.file as file, l.child as unary from upper_edges as l join unary_nodes as r on l.child = r.id and l.file = r.file;
let unary_operators = select parent, child, file from "semantic-child" where field = "op";
let unary_minus = select l.parent as unary, l.file as file from unary_operators as l join minus_tokens as r on l.child = r.id and l.file = r.file;
let upper_is_minus = select l.slice as slice, l.file as file, r.unary as unary from slice_unary_upper as l join unary_minus as r on l.unary = r.unary and l.file = r.file;
let unary_operands = select parent, child, file from "semantic-child" where field = "operand";
let unary_one_edges = select l.unary as unary, l.file as file, r.child as operand from upper_is_minus as l join unary_operands as r on l.unary = r.parent and l.file = r.file;
let integer_literals = select id, file, span from "literal-properties" where kind = "integer";
let integer_tokens = select id, file, span, text from "semantic-syntax" where kind = "number";
let integer_spellings = select l.id as id, l.file as file, r.text as text from integer_literals as l join integer_tokens as r on l.span = r.span and l.file = r.file;
let negative_one_upper = select l.unary as unary, l.file as file from unary_one_edges as l join integer_spellings as r on l.operand = r.id and l.file = r.file where matches(r.text, "^(?:1|0[xX]_?1|0[oO]_?1|0[bB]_?1)$");
let valid_slice_upper = select l.slice as slice, l.file as file from upper_is_minus as l join negative_one_upper as r on l.unary = r.unary and l.file = r.file;
let valid_slices = select l.slice as slice, l.file as file from unstepped_slice_rows as l join valid_slice_upper as r on l.slice = r.slice and l.file = r.file;
let subscript_lefts = select l.binary as binary, l.file as file, r.subscript as subscript from plus_binary_values as l join slice_subscripts as r on l.left = r.subscript and l.file = r.file;
let valid_subscripts = select l.subscript as subscript, l.file as file from slice_subscripts as l join valid_slices as r on l.slice = r.slice and l.file = r.file;
let slice_binary_matches = select l.binary as binary, l.file as file from subscript_lefts as l join valid_subscripts as r on l.subscript = r.subscript and l.file = r.file;
let strip_binary_matches = select binary, file from strip_lefts;
let concat_forms = union(left=strip_binary_matches, right=slice_binary_matches);
let concat_candidates = select l.binary as id, l.file as file from concat_forms as l join zero_offset_rights as r on l.binary = r.binary and l.file = r.file;
let all_matches = union(left=matched_replace_calls, right=concat_candidates);
let target_matches = select l.id as id, l.file as file from all_matches as l join python311_targets as r on l.file = r.file;
let candidate_nodes = select id, file, span from "semantic-syntax";
let candidates = select l.id as id, l.file as file, r.span as span from target_matches as l join candidate_nodes as r on l.id = r.id and l.file = r.file;
let candidate_locations = line_located(candidates=candidates);
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:FURB162)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches where scope < 2;
let ruf100_used = extend(from=ruf100_directives, values={code: "FURB162"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
