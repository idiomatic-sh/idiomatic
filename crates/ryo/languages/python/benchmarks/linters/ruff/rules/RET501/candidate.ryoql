import suppress from "python/ruff/suppress";
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let classes = select id, file from nodes where kind = "class-def";
let body_edges = select l.id as function, r.child as child, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let body_counts = group-count(from=body_edges, keys=["function", "file"], count="count", distinct="child");
let single_statement_functions = select function, file from body_counts where count = 1;
let returns = select id, file from nodes where kind = "return";
let single_return_functions = select l.function as function, l.file as file from body_edges as l join returns as r on l.child = r.id and l.file = r.file;
let trivial_functions = select l.function as function, l.file as file from single_return_functions as l join single_statement_functions as r on l.function = r.function and l.file = r.file;
let nontrivial_functions = antijoin(left=functions, right=trivial_functions, left-on=["id", "file"], right-on=["function", "file"]);
let class_edges = select l.parent as parent, l.child as child, l.field as field, l.file as file from "semantic-child" as l join classes as r on l.parent = r.id and l.file = r.file;
let class_ignored_edges = select parent, child, file from class_edges where field != "decorator-list";
let function_edges = select l.parent as parent, l.child as child, l.field as field, l.file as file from "semantic-child" as l join functions as r on l.parent = r.id and l.file = r.file;
let function_ignored_edges = select parent, child, file from function_edges where field != "decorator-list" and field != "returns" and field != "args";
let ignored_definition_edges = union(left=class_ignored_edges, right=function_ignored_edges);
let all_edges = select parent, child, file from "semantic-child";
let definition_walk_edges = antijoin(left=all_edges, right=ignored_definition_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let embedded_edges = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=definition_walk_edges, right=embedded_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let walk_paths = closure(edges=walk_edges, source="parent", destination="child", keys=["file"]);
let reachable_nodes = select l.function as function, r.child as member, l.file as file from body_edges as l join walk_paths as r on l.child = r.parent and l.file = r.file;
let initial_nodes = select function, child as member, file from body_edges;
let members = union(left=initial_nodes, right=reachable_nodes);
let return_members = select l.function as function, l.member as return, l.file as file from members as l join returns as r on l.member = r.id and l.file = r.file;
let return_values = select l.function as function, l.return as return, r.child as value, l.file as file from return_members as l join "semantic-child" as r on l.return = r.parent and l.file = r.file where r.field = "value";
let nulls = select id, file from "literal-properties" where kind = "null";
let nonnull_returns = antijoin(left=return_values, right=nulls, left-on=["value", "file"], right-on=["id", "file"]);
let yields = select id, file from nodes where kind = "yield" or kind = "yield-from";
let generator_functions = select l.function as function, l.file as file from members as l join yields as r on l.member = r.id and l.file = r.file;
let nongenerator_functions = antijoin(left=nontrivial_functions, right=generator_functions, left-on=["id", "file"], right-on=["function", "file"]);
let none_only_functions = antijoin(left=nongenerator_functions, right=nonnull_returns, left-on=["id", "file"], right-on=["function", "file"]);
let annotations = select parent as function, child as annotation, file from "semantic-child" where field = "returns";
let nonnull_annotations = antijoin(left=annotations, right=nulls, left-on=["annotation", "file"], right-on=["id", "file"]);
let annotated_functions = antijoin(left=none_only_functions, right=nonnull_annotations, left-on=["id", "file"], right-on=["function", "file"]);
let decorators = select declaration as function, occurrence as decorator, file from "decorates";
let decorator_expressions = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let direct_origins = select l.function as function, r.path as path, l.file as file from decorator_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let called_expressions = select l.function as function, r.child as expression, l.file as file from decorator_expressions as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "func";
let called_origins = select l.function as function, r.path as path, l.file as file from called_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let origins = union(left=direct_origins, right=called_origins);
let properties = select function, file from origins where path = "builtins.property" or path = "enum.property" or path = "functools.cached_property" or path = "abc.abstractproperty" or path = "types.DynamicClassAttribute";
let checked_functions = antijoin(left=annotated_functions, right=properties, left-on=["id", "file"], right-on=["function", "file"]);
let checked_returns = select l.return as id, l.value as value, l.file as file from return_values as l join checked_functions as r on l.function = r.id and l.file = r.file;
let reportable = select l.id as id, l.file as file from checked_returns as l join nulls as r on l.value = r.id and l.file = r.file;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="RET501($|[, #])", range-pattern="(?:^|,)RET501(?:,|$)");
emit violations subject file key(id);
