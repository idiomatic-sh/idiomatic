import observation_matches from "python/ruff/suppress-matches";
import suppress from "python/ruff/suppress";
let events = select occurrence, name, scope, phase, kind, file from "binding-event";
let parameters = select id, name, owner, file from "parameter";
let shadow_edges = select binding, previous, file from "binding-shadow";
let loop_nodes = select id, file from "semantic-syntax" where kind = "for" or kind = "async-for";
let target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select r.child as id from loop_nodes as l join target_fields as r on l.id = r.parent;
let optional_fields = select child as id from "semantic-child" where field = "optional-vars";
let edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=edges, source="origin", destination="destination");
let loop_target_descendants = select r.destination as id from loop_target_roots as l join descendants as r on l.id = r.origin;
let loop_target_ids = union(left=loop_target_roots, right=loop_target_descendants);
let with_target_descendants = select r.destination as id from optional_fields as l join descendants as r on l.id = r.origin;
let with_target_ids = union(left=optional_fields, right=with_target_descendants);
let child_to_parent = select child as origin, parent as destination from "semantic-child";
let ancestors = closure(edges=child_to_parent, source="origin", destination="destination");
let with_target_ancestors = select r.destination as id from optional_fields as l join ancestors as r on l.id = r.origin;
let with_target_and_ancestors = union(left=with_target_ids, right=with_target_ancestors);
let target_ids = union(left=loop_target_ids, right=with_target_and_ancestors);
let exception_handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let target_events = select l.occurrence as binding, l.name as name, l.scope as scope, l.file as file from events as l join target_ids as r on l.occurrence = r.id where l.kind = "bind";
let handler_events = select l.occurrence as binding, l.name as name, l.scope as scope, l.file as file from events as l join exception_handlers as r on l.occurrence = r.id and l.file = r.file where l.kind = "bind";
let local_targets = union(left=target_events, right=handler_events);
let parameter_shadows = select l.binding as binding, l.file as file, r.owner as owner, r.name as name from shadow_edges as l join parameters as r on l.previous = r.id and l.file = r.file;
let target_parameter_shadows = select l.binding as binding, l.file as file, l.owner as owner, l.name as name from parameter_shadows as l join local_targets as r on l.binding = r.binding and l.file = r.file and l.name = r.name;
let scope_nodes = select id, kind, file from "semantic-syntax";
let ordinary_scope_shadows = select l.binding as binding, l.file as file, l.name as name from target_parameter_shadows as l join scope_nodes as r on l.owner = r.id and l.file = r.file where r.kind != "list-comp" and r.kind != "set-comp" and r.kind != "dict-comp" and r.kind != "generator-exp";
let dummy = select l.binding as binding, l.file as file from ordinary_scope_shadows as l where matches(l.name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let reportable = antijoin(left=ordinary_scope_shadows, right=dummy, left-on=["binding","file"], right-on=["binding","file"]);
let report_nodes = select id, file, span from "defines";
let report_rows = select l.binding as id, l.file as file, r.span as span from reportable as l join report_nodes as r on l.binding = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from report_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLR1704(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLR1704)(?:,|$)");
let ruf100_matches = observation_matches(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PLR1704(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PLR1704)(?:,|$)");
let ruf100_directives = select directive, file from ruf100_matches where scope = 0 or scope = 1;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1704"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
