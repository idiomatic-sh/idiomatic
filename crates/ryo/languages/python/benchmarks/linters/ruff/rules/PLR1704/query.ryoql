import observation_matches from "python/ruff/suppress-matches";
let events = select occurrence, name, scope, phase, kind, ordinal, file from "binding-event";
let parameters = select id, name, owner, file from "parameter";
let bind_events = select occurrence, name, scope, ordinal from events where kind = "bind";
let all_shadows = select binding, previous, file from "binding-shadow";
let candidate_shadows = select l.binding as binding, l.previous as previous, l.file as file from all_shadows as l join parameters as r on l.previous = r.id and l.file = r.file;
let binding_ordinals = select l.binding as binding, l.previous as previous, l.file as file, r.scope as scope, r.name as name, r.ordinal as binding_ordinal from candidate_shadows as l join bind_events as r on l.binding = r.occurrence;
let shadow_ordinals = select l.binding as binding, l.previous as previous, l.file as file, l.scope as scope, l.name as name, l.binding_ordinal as binding_ordinal, r.ordinal as previous_ordinal from binding_ordinals as l join bind_events as r on l.previous = r.occurrence;
let intervening = select l.binding as binding, l.previous as previous from shadow_ordinals as l join bind_events as r on l.scope = r.scope and l.name = r.name where r.ordinal > l.previous_ordinal and r.ordinal < l.binding_ordinal;
let shadow_edges = antijoin(left=shadow_ordinals, right=intervening, left-on=["binding","previous"], right-on=["binding","previous"]);
let loop_nodes = select id, file from "semantic-syntax" where kind = "for" or kind = "async-for";
let target_fields = select parent, child from "semantic-child" where field = "target";
let loop_target_roots = select r.child as id from loop_nodes as l join target_fields as r on l.id = r.parent;
let optional_fields = select child as id from "semantic-child" where field = "optional-vars";
let exception_handlers = select id, file from "semantic-syntax" where kind = "except-handler";
let handler_events = select l.occurrence as binding, l.name as name, l.scope as scope, l.file as file from events as l join exception_handlers as r on l.occurrence = r.id and l.file = r.file where l.kind = "bind";
let parameter_shadows = select l.binding as binding, l.file as file, r.owner as owner, r.name as name from shadow_edges as l join parameters as r on l.previous = r.id and l.file = r.file;
let shadow_binding_pairs = project(from=parameter_shadows, columns=["binding", "file"]);
let shadow_bindings = select binding as id, file from shadow_binding_pairs;
let in_loop_target = axis(from=shadow_bindings, relation="semantic-child", direction=ancestor, domain=loop_target_roots);
let loop_target_hits = select id from in_loop_target;
let loop_root_hits = select l.id as id from shadow_bindings as l join loop_target_roots as r on l.id = r.id;
let in_with_target = axis(from=shadow_bindings, relation="semantic-child", direction=ancestor, domain=optional_fields);
let with_target_hits = select id from in_with_target;
let with_root_hits = select l.id as id from shadow_bindings as l join optional_fields as r on l.id = r.id;
let above_with_target = axis(from=shadow_bindings, relation="semantic-child", direction=descendant, domain=optional_fields);
let above_with_hits = select id from above_with_target;
let loop_hits = union(left=loop_target_hits, right=loop_root_hits);
let with_hits = union(left=with_target_hits, right=with_root_hits);
let with_and_above_hits = union(left=with_hits, right=above_with_hits);
let target_ids = union(left=loop_hits, right=with_and_above_hits);
let target_events = select l.occurrence as binding, l.name as name, l.scope as scope, l.file as file from events as l join target_ids as r on l.occurrence = r.id where l.kind = "bind";
let local_targets = union(left=target_events, right=handler_events);
let target_parameter_shadows = select l.binding as binding, l.file as file, l.owner as owner, l.name as name from parameter_shadows as l join local_targets as r on l.binding = r.binding and l.file = r.file and l.name = r.name;
let scope_nodes = select id, kind, file from "semantic-syntax";
let ordinary_scope_shadows = select l.binding as binding, l.file as file, l.name as name from target_parameter_shadows as l join scope_nodes as r on l.owner = r.id and l.file = r.file where r.kind != "list-comp" and r.kind != "set-comp" and r.kind != "dict-comp" and r.kind != "generator-exp";
let dummy = select l.binding as binding, l.file as file from ordinary_scope_shadows as l where matches(l.name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let reportable = antijoin(left=ordinary_scope_shadows, right=dummy, left-on=["binding","file"], right-on=["binding","file"]);
let report_nodes = select id, file, span from "defines";
let report_rows = select l.binding as id, l.file as file, r.span as span from reportable as l join report_nodes as r on l.binding = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from report_rows as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations_matches = observation_matches(candidates=candidate_locations, codes="^(?:PLR1704)$");
let violations_rows = select id, file, span from candidate_locations;
let violations = antijoin(left=violations_rows, right=violations_matches, left-on=[id, span], right-on=[id, span]);
let ruf100_directives = select directive, file from violations_matches;
let ruf100_used = extend(from=ruf100_directives, values={code: "PLR1704"});
observe ruf100_used as noqa_matches;
emit violations subject file key(id);
