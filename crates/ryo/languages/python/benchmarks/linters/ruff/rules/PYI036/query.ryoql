import suppress from "python/ruff/suppress";

let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let classes = select id, file from "semantic-syntax" where kind = "class-def";
let parents = select id, file from "semantic-syntax" where kind = "if" or kind = "for" or kind = "async-for" or kind = "while" or kind = "with" or kind = "async-with" or kind = "try" or kind = "try-star" or kind = "match";
let scopes0 = union(left=functions, right=classes);
let scopes = union(left=scopes0, right=parents);
let function_ancestors = axis(from=functions, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let function_class_ancestors = select l.id as function, r.related as class, l.file as file from functions as l join function_ancestors as r on l.id = r.id and l.file = r.file;
let class_methods = select l.function as function, l.class as class, l.file as file from function_class_ancestors as l join classes as r on l.class = r.id and l.file = r.file;
let function_names = select parent as function, child as name_id, file from "semantic-child" where field = "name";
let methods_with_names = select l.function as function, l.class as class, r.name_id as name_id, l.file as file from class_methods as l join function_names as r on l.function = r.function and l.file = r.file;
let method_labels = select l.function as function, l.class as class, l.name_id as name_id, r.name as method, l.file as file from methods_with_names as l join "identifier" as r on l.name_id = r.id and l.file = r.file;
let sync_functions = select id, file from "semantic-syntax" where kind = "function-def";
let async_functions = select id, file from "semantic-syntax" where kind = "async-function-def";
let sync_exit = select l.function as function, l.class as class, l.name_id as name_id, l.file as file from method_labels as l join sync_functions as r on l.function = r.id and l.file = r.file where l.method = "__exit__";
let async_exit = select l.function as function, l.class as class, l.name_id as name_id, l.file as file from method_labels as l join async_functions as r on l.function = r.id and l.file = r.file where l.method = "__aexit__";
let exit_methods = union(left=sync_exit, right=async_exit);
let args_edges = select parent as function, child as arguments, file from "semantic-child" where field = "args";
let method_decorators = select parent as function, child as list, file from "semantic-child" where field = "decorator-list";
let method_decorator_items = select l.function as function, r.child as decorator, l.file as file from method_decorators as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let overload_names = select id, file from "qualified-name" where path = "typing.overload" or path = "typing_extensions.overload";
let overload_methods = select l.function as function, l.file as file from method_decorator_items as l join overload_names as r on l.decorator = r.id and l.file = r.file;
let method_arguments = select l.function as function, l.class as class, l.name_id as name_id, r.arguments as arguments, l.file as file from exit_methods as l join args_edges as r on l.function = r.function and l.file = r.file;
let non_overloaded_method_arguments = antijoin(left=method_arguments, right=overload_methods, left-on=["function", "file"], right-on=["function", "file"]);
let source_locations = select id, span, "start-line", file from "source-location";
let positional_edges = select parent as arguments, child as parameter, ordinal, file from "semantic-child" where field = "posonlyargs" or field = "args";
let positional_counts = group-count(from=positional_edges, keys=["arguments", "file"], count="count", distinct="parameter");
let method_positional_edges = select l.arguments as arguments, p.parameter as wrapper, p.ordinal as ordinal, l.function as function, l.class as class, l.name_id as name_id, l.file as file from method_arguments as l join positional_edges as p on l.arguments = p.arguments and l.file = p.file;
let positional_pairs = select l.arguments as arguments, l.wrapper as earlier, r.wrapper as later, l.ordinal as earlier_ordinal, r.ordinal as later_ordinal, l.file as file from method_positional_edges as l join method_positional_edges as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let positional_predecessor_counts = group-count(from=positional_pairs, keys=["arguments", "later", "file"], count="count", distinct="earlier");
let ranked_method_parameters = select l.function as function, l.class as class, l.name_id as name_id, l.arguments as arguments, r.later as wrapper, r.count as index, l.file as file from method_positional_edges as l join positional_predecessor_counts as r on l.arguments = r.arguments and l.wrapper = r.later and l.file = r.file;
let extra_method_positional_edges = select function, class, name_id, wrapper as parameter, file from ranked_method_parameters where index >= 4;
let default_edges = select parent as parameter, child as value, file from "semantic-child" where field = "defaults" or field = "kw-defaults";
let required_extra_positional = antijoin(left=extra_method_positional_edges, right=default_edges, left-on=["parameter", "file"], right-on=["parameter", "file"]);
let non_overloaded_required_extra = antijoin(left=required_extra_positional, right=overload_methods, left-on=["function", "file"], right-on=["function", "file"]);
let required_extra_positional_candidates = select l.parameter as id, l.file as file, r.span as span, r."start-line" as line from non_overloaded_required_extra as l join source_locations as r on l.parameter = r.id and l.file = r.file;
let first_report_parameter_wrappers = select * from ranked_method_parameters where index = 1;
let second_report_parameter_wrappers = select * from ranked_method_parameters where index = 2;
let third_report_parameter_wrappers = select * from ranked_method_parameters where index = 3;
let wrapper_names = select parent as wrapper, child as name, file from "semantic-child" where field = "args" or field = "posonlyargs" or field = "kwonlyargs";
let first_report_names = select l.function as function, l.class as class, l.name_id as name_id, r.name as parameter, l.index as index, l.file as file from first_report_parameter_wrappers as l join wrapper_names as r on l.wrapper = r.wrapper and l.file = r.file;
let second_report_names = select l.function as function, l.class as class, l.name_id as name_id, r.name as parameter, l.index as index, l.file as file from second_report_parameter_wrappers as l join wrapper_names as r on l.wrapper = r.wrapper and l.file = r.file;
let third_report_names = select l.function as function, l.class as class, l.name_id as name_id, r.name as parameter, l.index as index, l.file as file from third_report_parameter_wrappers as l join wrapper_names as r on l.wrapper = r.wrapper and l.file = r.file;
let annotation_edges = select parent as parameter, child as annotation, file from "semantic-child" where field = "annotation";
let first_report_annotations = select l.function as function, l.class as class, l.name_id as name_id, r.annotation as annotation, l.file as file from first_report_names as l join annotation_edges as r on l.parameter = r.parameter and l.file = r.file;
let second_report_annotations = select l.function as function, l.class as class, l.name_id as name_id, r.annotation as annotation, l.file as file from second_report_names as l join annotation_edges as r on l.parameter = r.parameter and l.file = r.file;
let third_report_annotations = select l.function as function, l.class as class, l.name_id as name_id, r.annotation as annotation, l.file as file from third_report_names as l join annotation_edges as r on l.parameter = r.parameter and l.file = r.file;
let allowed_object_types = select id, file from "qualified-name" where path = "builtins.object" or path = "object" or path = "_typeshed.Unused";
let nullable_value_names = select id, path, file from "qualified-name" where path = "typing.Optional" or path = "typing_extensions.Optional" or path = "typing.Union" or path = "typing_extensions.Union";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_value_edges = select l.parent as subscript, l.child as value, l.file as file from "semantic-child" as l join subscript_nodes as r on l.parent = r.id and l.file = r.file where l.field = "value";
let subscript_slice_edges = select l.parent as subscript, l.child as slice, l.file as file from "semantic-child" as l join subscript_nodes as r on l.parent = r.id and l.file = r.file where l.field = "slice";
let optional_subscripts = select l.subscript as annotation, l.file as file from subscript_value_edges as l join nullable_value_names as r on l.value = r.id and l.file = r.file where r.path = "typing.Optional" or r.path = "typing_extensions.Optional";
let optional_inner_types = select l.annotation as annotation, r.slice as inner, l.file as file from optional_subscripts as l join subscript_slice_edges as r on l.annotation = r.subscript and l.file = r.file;
let union_subscripts = select l.subscript as annotation, l.file as file from subscript_value_edges as l join nullable_value_names as r on l.value = r.id and l.file = r.file where r.path = "typing.Union" or r.path = "typing_extensions.Union";
let union_slices = select l.annotation as annotation, r.slice as slice, l.file as file from union_subscripts as l join subscript_slice_edges as r on l.annotation = r.subscript and l.file = r.file;
let union_slice_tuples = select l.annotation as annotation, r.id as tuple, l.file as file from union_slices as l join "semantic-syntax" as r on l.slice = r.id and l.file = r.file where r.kind = "tuple";
let tuple_elements = select parent as tuple, child as member, file from "semantic-child" where field = "elts";
let tuple_element_counts = group-count(from=tuple_elements, keys=["tuple", "file"], count="count", distinct="member");
let two_element_union_slices = select l.annotation as annotation, l.tuple as tuple, l.file as file from union_slice_tuples as l join tuple_element_counts as r on l.tuple = r.tuple and l.file = r.file where r.count = 2;
let null_values = select id, file from "literal-properties" where kind = "null";
let two_union_members = select l.annotation as annotation, r.member as member, r.tuple as tuple, l.file as file from two_element_union_slices as l join tuple_elements as r on l.tuple = r.tuple and l.file = r.file;
let union_null_members = select l.annotation as annotation, l.member as null_member, l.file as file from two_union_members as l join null_values as n on l.member = n.id and l.file = n.file;
let union_nonnull_members = antijoin(left=two_union_members, right=null_values, left-on=["member", "file"], right-on=["id", "file"]);
let union_inner_types = select l.annotation as annotation, l.member as inner, l.file as file from union_nonnull_members as l join union_null_members as r on l.annotation = r.annotation and l.file = r.file;
let nullable_annotation_inner_types0 = union(left=optional_inner_types, right=union_inner_types);
let operator_edges = select parent as binop, child as operator, file from "semantic-child" where field = "op";
let pipe_tokens = select id, file from "semantic-syntax" where text = "|";
let pipe_binops = select l.binop as binop, l.file as file from operator_edges as l join pipe_tokens as r on l.operator = r.id and l.file = r.file;
let pipe_left = select l.binop as annotation, r.child as inner, l.file as file from pipe_binops as l join "semantic-child" as r on l.binop = r.parent and l.file = r.file where r.field = "left";
let pipe_right = select l.binop as annotation, r.child as inner, l.file as file from pipe_binops as l join "semantic-child" as r on l.binop = r.parent and l.file = r.file where r.field = "right";
let pipe_left_nonnull = antijoin(left=pipe_left, right=null_values, left-on=["inner", "file"], right-on=["id", "file"]);
let pipe_left_null = select l.annotation as annotation, l.file as file from pipe_left as l join null_values as r on l.inner = r.id and l.file = r.file;
let pipe_right_nonnull = antijoin(left=pipe_right, right=null_values, left-on=["inner", "file"], right-on=["id", "file"]);
let pipe_right_selected = select l.annotation as annotation, r.inner as inner, l.file as file from pipe_left_null as l join pipe_right_nonnull as r on l.annotation = r.annotation and l.file = r.file;
let pipe_inner_types = union(left=pipe_left_nonnull, right=pipe_right_selected);
let nullable_annotation_inner_types = union(left=nullable_annotation_inner_types0, right=pipe_inner_types);
let base_exception_names = select id, file from "qualified-name" where path = "builtins.BaseException" or path = "BaseException";
let traceback_names = select id, file from "qualified-name" where path = "types.TracebackType";
let type_constructor_names = select id, file from "qualified-name" where path = "builtins.type" or path = "type" or path = "typing.Type" or path = "typing_extensions.Type";
let type_constructor_edges = select l.id as type_expr, r.value as constructor, l.file as file from subscript_nodes as l join subscript_value_edges as r on l.id = r.subscript and l.file = r.file;
let type_argument_edges = select l.id as type_expr, r.slice as argument, l.file as file from subscript_nodes as l join subscript_slice_edges as r on l.id = r.subscript and l.file = r.file;
let exception_type_nodes0 = select l.type_expr as type_expr, l.file as file from type_constructor_edges as l join type_constructor_names as r on l.constructor = r.id and l.file = r.file;
let exception_type_arguments = select l.type_expr as type_expr, r.argument as argument, l.file as file from exception_type_nodes0 as l join type_argument_edges as r on l.type_expr = r.type_expr and l.file = r.file;
let exception_type_nodes = select l.type_expr as type_expr, l.file as file from exception_type_arguments as l join base_exception_names as n on l.argument = n.id and l.file = n.file;
let valid_first_direct = select l.annotation as annotation, l.file as file from first_report_annotations as l join allowed_object_types as r on l.annotation = r.id and l.file = r.file;
let first_nonnull_inner = select l.annotation as annotation, r.inner as inner, l.file as file from first_report_annotations as l join nullable_annotation_inner_types as r on l.annotation = r.annotation and l.file = r.file;
let first_nonnull = select l.annotation as annotation, l.file as file from first_nonnull_inner as l join exception_type_nodes as n on l.inner = n.type_expr and l.file = n.file;
let valid_first_types = union(left=valid_first_direct, right=first_nonnull);
let valid_second_direct = select l.annotation as annotation, l.file as file from second_report_annotations as l join allowed_object_types as r on l.annotation = r.id and l.file = r.file;
let second_nonnull_inner = select l.annotation as annotation, r.inner as inner, l.file as file from second_report_annotations as l join nullable_annotation_inner_types as r on l.annotation = r.annotation and l.file = r.file;
let second_nonnull = select l.annotation as annotation, l.file as file from second_nonnull_inner as l join base_exception_names as n on l.inner = n.id and l.file = n.file;
let valid_second_types = union(left=valid_second_direct, right=second_nonnull);
let valid_third_direct = select l.annotation as annotation, l.file as file from third_report_annotations as l join allowed_object_types as r on l.annotation = r.id and l.file = r.file;
let third_nonnull_inner = select l.annotation as annotation, r.inner as inner, l.file as file from third_report_annotations as l join nullable_annotation_inner_types as r on l.annotation = r.annotation and l.file = r.file;
let third_nonnull = select l.annotation as annotation, l.file as file from third_nonnull_inner as l join traceback_names as n on l.inner = n.id and l.file = n.file;
let valid_third_types = union(left=valid_third_direct, right=third_nonnull);
let invalid_first_types = antijoin(left=first_report_annotations, right=valid_first_types, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let invalid_second_types = antijoin(left=second_report_annotations, right=valid_second_types, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let invalid_third_types = antijoin(left=third_report_annotations, right=valid_third_types, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let invalid_annotation_edges0 = union(left=invalid_first_types, right=invalid_second_types);
let invalid_annotation_edges = union(left=invalid_annotation_edges0, right=invalid_third_types);
let non_overloaded_invalid_annotation_edges = antijoin(left=invalid_annotation_edges, right=overload_methods, left-on=["function", "file"], right-on=["function", "file"]);
let invalid_annotation_candidates = select l.annotation as id, l.file as file, r.span as span, r."start-line" as line from non_overloaded_invalid_annotation_edges as l join source_locations as r on l.annotation = r.id and l.file = r.file;
let vararg_edges = select parent as arguments, child as parameter, file from "semantic-child" where field = "vararg";
let nonempty_short_arguments = select l.function as function, l.class as class, l.name_id as name_id, l.arguments as arguments, l.file as file from non_overloaded_method_arguments as l join positional_counts as r on l.arguments = r.arguments and l.file = r.file where r.count < 4;
let zero_positional_arguments = antijoin(left=non_overloaded_method_arguments, right=positional_counts, left-on=["arguments", "file"], right-on=["arguments", "file"]);
let short_arguments = union(left=nonempty_short_arguments, right=zero_positional_arguments);
let missing_argument_methods = antijoin(left=short_arguments, right=vararg_edges, left-on=["arguments", "file"], right-on=["arguments", "file"]);
let short_vararg_edges = select l.arguments as arguments, r.parameter as parameter, l.file as file from short_arguments as l join vararg_edges as r on l.arguments = r.arguments and l.file = r.file;
let vararg_annotations = select l.arguments as arguments, r.child as annotation, l.file as file from short_vararg_edges as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let allowed_star_types = select id, file from "qualified-name" where path = "builtins.object" or path = "object" or path = "_typeshed.Unused";
let bad_star_annotations = antijoin(left=vararg_annotations, right=allowed_star_types, left-on=["annotation", "file"], right-on=["id", "file"]);
let bad_star_candidates = select l.annotation as id, l.file as file, r.span as span, r."start-line" as line from bad_star_annotations as l join source_locations as r on l.annotation = r.id and l.file = r.file;
let missing_argument_candidates = select l.arguments as id, l.file as file, r.span as span, r."start-line" as line from missing_argument_methods as l join source_locations as r on l.arguments = r.id and l.file = r.file;

let arguments_nodes = select id, file from "semantic-syntax" where kind = "arguments";
let keyword_only_edges = select l.parent as arguments, l.child as parameter, l.file as file from "semantic-child" as l join arguments_nodes as r on l.parent = r.id and l.file = r.file where l.field = "kwonlyargs";
let method_keyword_only_edges = select l.function as function, l.class as class, l.name_id as name_id, r.parameter as parameter, l.file as file from non_overloaded_method_arguments as l join keyword_only_edges as r on l.arguments = r.arguments and l.file = r.file;
let required_keyword_only = antijoin(left=method_keyword_only_edges, right=default_edges, left-on=["parameter", "file"], right-on=["parameter", "file"]);
let unique_required_keyword_only = group-count(from=required_keyword_only, keys=["parameter", "file"], count="count", distinct="parameter");
let required_keyword_candidates = select l.parameter as id, l.file as file, r.span as span, r."start-line" as line from unique_required_keyword_only as l join source_locations as r on l.parameter = r.id and l.file = r.file;
let overloaded_labels = select l.function as function, l.class as class, l.method as method, l.file as file from method_labels as l join overload_methods as r on l.function = r.function and l.file = r.file;
let overload_counts = group-count(from=overloaded_labels, keys=["class", "method", "file"], count="count", distinct="function");
let two_overload_labels = select l.function as function, l.class as class, l.method as method, l.file as file from overloaded_labels as l join overload_counts as r on l.class = r.class and l.method = r.method and l.file = r.file where r.count = 2;
let overload_arguments = select l.function as function, l.class as class, l.method as method, r.arguments as arguments, l.file as file from two_overload_labels as l join args_edges as r on l.function = r.function and l.file = r.file;
let correct_colour_overloads = select l.function as function, l.class as class, l.method as method, l.arguments as arguments, l.file as file from overload_arguments as l join exit_methods as r on l.function = r.function and l.file = r.file;
let four_parameter_overloads = select l.function as function, l.class as class, l.method as method, l.arguments as arguments, l.file as file from correct_colour_overloads as l join positional_counts as r on l.arguments = r.arguments and l.file = r.file where r.count = 4;
let disqualifying_edges = select parent as arguments, file from "semantic-child" where field = "vararg" or field = "kwarg" or field = "kwonlyargs";
let shaped_overloads = antijoin(left=four_parameter_overloads, right=disqualifying_edges, left-on=["arguments", "file"], right-on=["arguments", "file"]);
let rejected_overloads = antijoin(left=overload_arguments, right=shaped_overloads, left-on=["function", "file"], right-on=["function", "file"]);
let eligible_overloads = antijoin(left=shaped_overloads, right=rejected_overloads, left-on=["class", "method", "file"], right-on=["class", "method", "file"]);
let report_annotations0 = union(left=first_report_annotations, right=second_report_annotations);
let report_annotations = union(left=report_annotations0, right=third_report_annotations);
let universal_overload_types = union(left=allowed_object_types, right=null_values);
let bad_none_pattern = antijoin(left=report_annotations, right=universal_overload_types, left-on=["annotation", "file"], right-on=["id", "file"]);
let first_direct_exception = select l.annotation as annotation, l.file as file from first_report_annotations as l join exception_type_nodes as r on l.annotation = r.type_expr and l.file = r.file;
let first_exception_or_object = union(left=first_direct_exception, right=valid_first_direct);
let second_direct_exception = select l.annotation as annotation, l.file as file from second_report_annotations as l join base_exception_names as r on l.annotation = r.id and l.file = r.file;
let second_exception_or_object = union(left=second_direct_exception, right=valid_second_direct);
let third_direct_exception = select l.annotation as annotation, l.file as file from third_report_annotations as l join traceback_names as r on l.annotation = r.id and l.file = r.file;
let third_exception_or_object = union(left=third_direct_exception, right=valid_third_direct);
let bad_exception_first = antijoin(left=first_report_annotations, right=first_exception_or_object, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let bad_exception_second = antijoin(left=second_report_annotations, right=second_exception_or_object, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let bad_exception_third = antijoin(left=third_report_annotations, right=third_exception_or_object, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let bad_exception_pattern0 = union(left=bad_exception_first, right=bad_exception_second);
let bad_exception_pattern = union(left=bad_exception_pattern0, right=bad_exception_third);
let invalid_overload_functions = select l.function as function, l.file as file from bad_none_pattern as l join bad_exception_pattern as r on l.function = r.function and l.file = r.file;
let invalid_eligible_overloads = select l.arguments as arguments, l.file as file from eligible_overloads as l join invalid_overload_functions as r on l.function = r.function and l.file = r.file;
let overload_candidates = select l.arguments as id, l.file as file, r.span as span, r."start-line" as line from invalid_eligible_overloads as l join source_locations as r on l.arguments = r.id and l.file = r.file;
let candidates0 = union(left=missing_argument_candidates, right=bad_star_candidates);
let candidates1 = union(left=candidates0, right=required_keyword_candidates);
let candidates2 = union(left=candidates1, right=required_extra_positional_candidates);
let candidates3 = union(left=candidates2, right=invalid_annotation_candidates);
let all_candidates = union(left=candidates3, right=overload_candidates);
let unique_candidates = group-count(from=all_candidates, keys=["id", "file", "span", "line"], count="count", distinct="id");
let candidate_locations = select id, file, span, line from unique_candidates;
let violations = suppress(candidates=candidate_locations, inline-pattern="PYI036($|[, #])", range-pattern="(?:^|,)PYI036(?:,|$)");
emit violations subject file key(id);
