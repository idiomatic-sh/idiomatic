import suppress from "python/ruff/suppress";
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent as call, child as function, file from "semantic-child" where field = "func";
let call_functions = select l.call as call, l.function as function, l.file as file from function_fields as l join calls as r on l.call = r.id and l.file = r.file;
let scope_boundaries = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let nearest_scopes = axis(from=calls, relation="semantic-child", direction=nearest-ancestor, domain=scope_boundaries);
let async_scopes = select id, file from "semantic-syntax" where kind = "async-function-def";
let call_nearest_scopes = select l.id as call, l.file as file, r.related as scope from calls as l join nearest_scopes as r on l.id = r.id and l.file = r.file;
let async_calls = select l.call as call, l.file as file from call_nearest_scopes as l join async_scopes as r on l.scope = r.id and l.file = r.file;
let call_qnames = select l.call as call, l.function as function, q.path as path, l.file as file, q.span as span from call_functions as l join "qualified-name" as q on l.function = q.id and l.file = q.file;
let builtin_open = select id as function, file, span from "qualified-name" where (path = "builtins.open" and provenance = "builtin") or path = "io.open" or path = "io.open_code";
let open_function_calls = select l.call as call, l.function as function, l.file as file, l.span as span from call_qnames as l join builtin_open as r on l.function = r.function and l.file = r.file;
let attribute_nodes = select id, file from "semantic-syntax" where kind = "attribute";
let identifiers = select id, name, file from "identifier";
let attribute_names = select parent as attribute, child as name, file from "semantic-child" where field = "attr";
let named_attributes = select l.attribute as attribute, n.name as name, l.file as file from attribute_names as l join identifiers as n on l.name = n.id and l.file = n.file;
let open_attributes = select l.attribute as function, l.file as file from named_attributes as l join attribute_nodes as r on l.attribute = r.id and l.file = r.file where l.name = "open";
let attribute_value_fields = select parent as function, child as value, file from "semantic-child" where field = "value";
let open_receivers = select l.function as function, r.value as receiver, l.file as file from open_attributes as l join attribute_value_fields as r on l.function = r.function and l.file = r.file;
let pathlib_calls = select call, function, file from call_qnames where path = "pathlib.Path";
let inline_pathlib_receivers = select l.function as function, l.file as file from open_receivers as l join pathlib_calls as p on l.receiver = p.call and l.file = p.file;
let receiver_names = select l.function as function, l.receiver as reference, l.file as file from open_receivers as l join "semantic-syntax" as n on l.receiver = n.id and l.file = n.file where n.kind = "name";
let receiver_uses = select l.function as function, u.binding as binding, l.file as file from receiver_names as l join "binding-use" as u on l.reference = u.reference and l.file = u.file;
let assignment_nodes = select id, file from "semantic-syntax" where kind = "assign" or kind = "ann-assign";
let assignment_targets = select parent as assignment, child as target, file from "semantic-child" where field = "targets" or field = "target";
let assignment_values = select parent as assignment, child as value, file from "semantic-child" where field = "value";
let defined_assignment_targets = select l.id as binding, t.assignment as assignment, l.file as file from "defines" as l join assignment_targets as t on l.id = t.target and l.file = t.file;
let assigned_targets = select l.binding as binding, l.assignment as assignment, l.file as file from defined_assignment_targets as l join assignment_nodes as a on l.assignment = a.id and l.file = a.file;
let receiver_assignments = select u.function as function, u.file as file, t.assignment as assignment from receiver_uses as u join assigned_targets as t on u.binding = t.binding and u.file = t.file;
let path_call_assignments = select u.function as function, u.file as file, a.value as value from receiver_assignments as u join assignment_values as a on u.assignment = a.assignment and u.file = a.file;
let assigned_path_calls = select l.function as function, l.file as file, c.id as call from path_call_assignments as l join calls as c on l.value = c.id and l.file = c.file;
let qualified_path_calls = select l.function as function, l.file as file, q.function as constructor from assigned_path_calls as l join call_qnames as q on l.call = q.call and l.file = q.file;
let variable_path_receivers = select l.function as function, l.file as file from qualified_path_calls as l join pathlib_calls as p on l.constructor = p.function and l.file = p.file;
let pathlib_open_attributes = union(left=inline_pathlib_receivers, right=variable_path_receivers);
let pathlib_open_calls = select l.function as function, c.call as call, l.file as file from pathlib_open_attributes as l join call_functions as c on l.function = c.function and l.file = c.file;
let async_open_calls = select l.function as function, l.call as call, l.file as file from open_function_calls as l join async_calls as r on l.call = r.call and l.file = r.file;
let async_pathlib_calls = select l.function as function, l.call as call, l.file as file from pathlib_open_calls as l join async_calls as r on l.call = r.call and l.file = r.file;
let all_open_calls = union(left=async_open_calls, right=async_pathlib_calls);
let locations = select l.function as id, l.file as file, r.span as span, r."start-line" as line from all_open_calls as l join "source-location" as r on l.function = r.id and l.file = r.file;
let violations = suppress(candidates=locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*ASYNC230(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)ASYNC230(?:,|$)");
emit violations subject file key(id);
