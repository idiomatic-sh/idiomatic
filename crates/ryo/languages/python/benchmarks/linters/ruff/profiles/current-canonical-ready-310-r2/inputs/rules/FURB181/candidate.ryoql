import suppress from "python/ruff/suppress";
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let attributes = select id, file from nodes where kind = "attribute";
let attr_edges = select parent, child, file from "semantic-child" where field = "attr";
let attr_ids = select l.id as id, l.file as file, r.child as identifier from attributes as l join attr_edges as r on l.id = r.parent and l.file = r.file;
let attr_names = select l.id as id, l.file as file, r.name as name from attr_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let method_callees = select l.call as call, l.file as file, l.callee as callee, r.name as name from callee_nodes as l join attr_names as r on l.callee = r.id and l.file = r.file;
let method_calls = select l.call as call, l.file as file, l.name as name, r.child as receiver from method_callees as l join value_edges as r on l.callee = r.parent and l.file = r.file;
let hex_calls = select call, file, receiver from method_calls where name = "hex";
let empty_hex_calls = select l.call as call, l.file as file, l.receiver as digest from hex_calls as l join empty_calls as r on l.call = r.id and l.file = r.file;
let digest_calls = select call, file, receiver from method_calls where name = "digest";
let digested_hex_calls = select l.call as call, l.file as file, r.receiver as constructor from empty_hex_calls as l join digest_calls as r on l.digest = r.call and l.file = r.file;
let hash_calls = select call, file from qualified_calls where path = "hashlib.md5" or path = "hashlib.sha1" or path = "hashlib.sha224" or path = "hashlib.sha256" or path = "hashlib.sha384" or path = "hashlib.sha512" or path = "hashlib.blake2b" or path = "hashlib.blake2s" or path = "hashlib.sha3_224" or path = "hashlib.sha3_256" or path = "hashlib.sha3_384" or path = "hashlib.sha3_512" or path = "hashlib.shake_128" or path = "hashlib.shake_256";
let digests = select l.call as call, l.file as file from digested_hex_calls as l join hash_calls as r on l.constructor = r.call and l.file = r.file;
let candidates = select l.call as id, l.file as file, r.span as span from digests as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])FURB181(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:FURB181)(?:,|$)");
emit violations subject file key(id);
