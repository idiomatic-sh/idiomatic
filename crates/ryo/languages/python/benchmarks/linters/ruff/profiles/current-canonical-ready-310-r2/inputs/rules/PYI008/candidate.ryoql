import suppress from "python/ruff/suppress";
let comparisons = select id, file from "semantic-syntax" where kind = "compare" and glob_any(file, "**/*.pyi");
let left_edges = select parent, child from "semantic-child" where field = "left";
let platform = select id, file from "qualified-name" where path = "sys.platform";
let left_rows = select l.parent as comparison, l.child as left, r.file as file from left_edges as l join comparisons as r on l.parent = r.id;
let platform_rows = select l.comparison as comparison, l.file as file from left_rows as l join platform as r on l.left = r.id and l.file = r.file;
let rhs_edges = select parent, child from "semantic-child" where field = "comparators";
let rhs_rows = select l.parent as comparison, l.child as rhs, r.file as file from rhs_edges as l join platform_rows as r on l.parent = r.comparison;
let equality_ops = select id from "semantic-syntax" where text = "==" or text = "!=";
let ops = select parent, child from "semantic-child" where field = "ops";
let equality_comparisons = select l.parent as comparison from ops as l join equality_ops as r on l.child = r.id;
let strings = select occurrence as id, file, value from "string-literal";
let platform_strings = select l.comparison as comparison, l.rhs as rhs, l.file as file, r.value as value from rhs_rows as l join strings as r on l.rhs = r.id and l.file = r.file;
let valid_operator_rows = select l.comparison as comparison, l.rhs as rhs, l.file as file, l.value as value from platform_strings as l join equality_comparisons as r on l.comparison = r.comparison;
let invalid_names = select comparison, rhs, file from valid_operator_rows where value != "linux" and value != "win32" and value != "cygwin" and value != "darwin";
let reportable = select l.rhs as id, r.file as file, r.span as span from invalid_names as l join "semantic-syntax" as r on l.rhs = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI008(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI008)(?:,|$)");
emit violations subject file key(id);
