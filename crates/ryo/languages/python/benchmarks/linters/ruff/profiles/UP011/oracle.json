{
  "functools-direct": {
    "source": "import functools\n@functools.lru_cache()\ndef f():\n    return 1\n",
    "expected": [
      {
        "rule": "UP011",
        "file": "case.py",
        "start": 37,
        "end": 39
      }
    ]
  },
  "alias-module": {
    "source": "import functools as ft\n@ft.lru_cache()\ndef f():\n    return 1\n",
    "expected": [
      {
        "rule": "UP011",
        "file": "case.py",
        "start": 36,
        "end": 38
      }
    ]
  },
  "from-import": {
    "source": "from functools import lru_cache\n@lru_cache()\ndef f():\n    return 1\n",
    "expected": [
      {
        "rule": "UP011",
        "file": "case.py",
        "start": 42,
        "end": 44
      }
    ]
  },
  "from-alias": {
    "source": "from functools import lru_cache as cache\n@cache()\ndef f():\n    return 1\n",
    "expected": [
      {
        "rule": "UP011",
        "file": "case.py",
        "start": 47,
        "end": 49
      }
    ]
  },
  "configured-size": {
    "source": "import functools\n@functools.lru_cache(32)\ndef f():\n    return 1\n",
    "expected": []
  },
  "keyword": {
    "source": "import functools\n@functools.lru_cache(maxsize=None)\ndef f():\n    return 1\n",
    "expected": []
  },
  "not-decorator": {
    "source": "import functools\nfunctools.lru_cache()\n",
    "expected": []
  },
  "other-decorator": {
    "source": "from other import lru_cache\n@lru_cache()\ndef f():\n    return 1\n",
    "expected": []
  },
  "noqa": {
    "source": "import functools\n@functools.lru_cache()  # noqa: UP011\ndef f():\n    return 1\n",
    "expected": []
  },
  "file-noqa": {
    "source": "# ruff: noqa: UP011\nimport functools\n@functools.lru_cache()\ndef f():\n    return 1\n",
    "expected": []
  },
  "other-noqa": {
    "source": "import functools\n@functools.lru_cache()  # noqa: F401\ndef f():\n    return 1\n",
    "expected": [
      {
        "rule": "UP011",
        "file": "case.py",
