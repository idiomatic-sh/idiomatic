import suppress from "python/ruff/suppress";
import lookup_attribute from "python/ruff/lookup-attribute";
import union_members from "python/ruff/union-members";
let members = union_members();
let functions = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let parameters = select id, file from "semantic-syntax" where kind = "arg";
let parameter_scopes = axis(from=parameters, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let annotation_edges = select l.id as parameter, r.child as annotation, l.file as file from parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let function_annotations = select l.annotation as annotation, l.file as file, r.related as function from annotation_edges as l join parameter_scopes as r on l.parameter = r.id and l.file = r.file;
let decorators = select declaration as function, occurrence as decorator, file from "decorates";
let decorator_roots = select l.function as function, r.child as expression, l.file as file from decorators as l join "semantic-child" as r on l.decorator = r.parent and l.file = r.file;
let dispatch_names = select id, file from "qualified-name" where path = "functools.singledispatch" or path = "functools.singledispatchmethod";
let dispatch_interfaces = select l.function as function, l.file as file from decorator_roots as l join dispatch_names as r on l.expression = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_labels = select l.id as attribute, r.child as label, l.file as file from attributes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let register_attributes = select l.attribute as attribute, l.file as file from attribute_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "register";
let dispatch_register_decorators = select l.function as function, l.expression as attribute, l.file as file from decorator_roots as l join register_attributes as r on l.expression = r.attribute and l.file = r.file;
let register_receivers = select l.function as function, r.child as receiver, l.file as file from dispatch_register_decorators as l join "semantic-child" as r on l.attribute = r.parent and l.file = r.file where r.field = "value";
let register_context_scopes = select l.function as context, r.parent as initial_scope, l.file as file from register_receivers as l join "scope" as r on l.function = r.child and l.file = r.file;
let bind_events = select occurrence, ordinal, file from "binding-event" where kind = "bind";
let register_contexts = select l.context as context, l.initial_scope as initial_scope, r.ordinal as point, l.file as file from register_context_scopes as l join bind_events as r on l.context = r.occurrence and l.file = r.file;
let receiver_expressions = select receiver as id, file from register_receivers;
let receiver_definitions = lookup_attribute(ordered_contexts=register_contexts, expressions=receiver_expressions);
let resolved_registers = select l.function as function, r.definition as interface, l.file as file from register_receivers as l join receiver_definitions as r on l.function = r.context and l.receiver = r.expression and l.file = r.file;
let dispatch_implementations = select l.function as function, l.file as file from resolved_registers as l join dispatch_interfaces as r on l.interface = r.function and l.file = r.file;
let annotation_locations = select l.function as function, l.annotation as annotation, r."start-byte" as position, l.file as file from function_annotations as l join "source-location" as r on l.annotation = r.id and l.file = r.file;
let nonfirst_annotations = select r.function as function, r.annotation as annotation, r.file as file from annotation_locations as l join annotation_locations as r on l.function = r.function and l.file = r.file where l.position < r.position;
let first_annotations = antijoin(left=annotation_locations, right=nonfirst_annotations, left-on=["function", "annotation", "file"], right-on=["function", "annotation", "file"]);
let skipped_annotations = select l.annotation as annotation, l.file as file from first_annotations as l join dispatch_implementations as r on l.function = r.function and l.file = r.file;
let checked_annotations = antijoin(left=function_annotations, right=skipped_annotations, left-on=["annotation", "file"], right-on=["annotation", "file"]);
let annotation_members = select l.annotation as annotation, r.member as member, l.file as file from checked_annotations as l join members as r on l.annotation = r.root and l.file = r.file;
let numeric_names = select id, path, file from "qualified-name" where path = "builtins.int" or path = "builtins.float" or path = "builtins.complex";
let numeric_members = select l.annotation as annotation, r.path as path, l.file as file from annotation_members as l join numeric_names as r on l.member = r.id and l.file = r.file;
let numeric_counts = group-count(from=numeric_members, keys=["annotation", "file"], count="count", distinct="path");
let reportable = select annotation as id, file from numeric_counts where count >= 2;
let locations = select id, span, "start-line", file from "source-location";
let candidates = select l.id as id, l.file as file, r.span as span, r."start-line" as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PYI041($|[, #])", range-pattern="(?:^|,)PYI041(?:,|$)");
emit violations subject file key(id);
