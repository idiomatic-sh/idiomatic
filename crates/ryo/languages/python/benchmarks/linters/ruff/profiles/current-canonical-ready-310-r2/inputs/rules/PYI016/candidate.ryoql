import suppress from "python/ruff/suppress";
let binary_nodes = select id, file from "semantic-syntax" where kind = "bin-op";
let operator_fields = select parent, child from "semantic-child" where field = "op";
let operators = select l.id as operation, r.child as operator, l.file as file from binary_nodes as l join operator_fields as r on l.id = r.parent;
let pipe_tokens = select id, file from "semantic-syntax" where text = "|";
let pipe_operators = select l.operation as operation, l.file as file from operators as l join pipe_tokens as r on l.operator = r.id and l.file = r.file;
let binary_unions = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join pipe_operators as r on l.id = r.operation and l.file = r.file;
let subscript_nodes = select id, file, span from "semantic-syntax" where kind = "subscript";
let subscript_values = select l.parent as subscript, l.child as value, l.file as file from "semantic-child" as l join subscript_nodes as r on l.parent = r.id and l.file = r.file where l.field = "value";
let union_names = select id, file from "qualified-name" where path = "typing.Union" or path = "typing_extensions.Union";
let union_subscripts = select l.subscript as id, l.file as file from subscript_values as l join union_names as r on l.value = r.id and l.file = r.file;
let typed_union_nodes = select l.id as id, l.file as file, r.span as span from union_subscripts as l join subscript_nodes as r on l.id = r.id and l.file = r.file;
let union_nodes = union(left=binary_unions, right=typed_union_nodes);
let operands = select l.parent as parent, l.child as child, l.file as file from "semantic-child" as l join binary_unions as r on l.parent = r.id and l.file = r.file where l.field = "left" or l.field = "right";
let binary_edges = select parent as origin, child as destination, file from operands;
let slice_edges = select parent as subscript, child as slice_node, file from "semantic-child" where field = "slice";
let union_slices = select l.id as union, r.slice_node as slice_node, l.file as file from union_subscripts as l join slice_edges as r on l.id = r.subscript and l.file = r.file;
let slice_tuples = select l.union as union, r.id as tuple_node, l.file as file from union_slices as l join "semantic-syntax" as r on l.slice_node = r.id and l.file = r.file where r.kind = "tuple";
let tuple_elements = select parent as tuple_node, child as member, file from "semantic-child" where field = "elts";
let union_tuple_members = select l.union as origin, r.member as destination, l.file as file from slice_tuples as l join tuple_elements as r on l.tuple_node = r.tuple_node and l.file = r.file;
let union_edges = union(left=binary_edges, right=union_tuple_members);
let union_paths = closure(edges=union_edges, source="origin", destination="destination");
let direct_members = select l.origin as union, l.destination as member, r.file as file from union_paths as l join union_nodes as r on l.origin = r.id;
let union_container_ids = select id as member, file from union_nodes;
let leaf_members = antijoin(left=direct_members, right=union_container_ids, left-on=["member", "file"], right-on=["member", "file"]);
let shapes = select id, shape, file from "expression-shape";
let shaped_members = select l.union as union, l.member as member, r.shape as shape, l.file as file from leaf_members as l join shapes as r on l.member = r.id and l.file = r.file;
let same_shape_pairs = select l.union as union, r.member as later, l.member as earlier, l.file as file from shaped_members as l join shaped_members as r on l.union = r.union and l.shape = r.shape and l.file = r.file;
let member_locations = select id, file, "start-byte" as start from "source-location";
let earlier_locations = select l.union as union, l.later as later, r.start as earlier_start, l.file as file from same_shape_pairs as l join member_locations as r on l.earlier = r.id and l.file = r.file;
let pair_locations = select l.union as union, l.later as later, l.earlier_start as earlier_start, r.start as later_start, l.file as file from earlier_locations as l join member_locations as r on l.later = r.id and l.file = r.file;
let ordered_pairs = select union, later, file from pair_locations where earlier_start < later_start;
let duplicate_members = select union, later as id, file from ordered_pairs;
let optional_names = select id, file from "qualified-name" where path = "typing.Optional" or path = "typing_extensions.Optional";
let optional_subscripts = select l.value as id, l.file as file from subscript_values as l join optional_names as r on l.value = r.id and l.file = r.file;
let optional_descendants = axis(from=union_nodes, relation="semantic-child", direction=descendant, domain=optional_subscripts);
let union_optionals = select l.id as union, r.related as optional_id, l.file as file from optional_descendants as r join union_nodes as l on r.id = l.id and r.file = l.file;
let null_nodes = select id, file from "literal-properties" where kind = "null";
let null_descendants = axis(from=union_nodes, relation="semantic-child", direction=descendant, domain=null_nodes);
let union_nulls = select l.id as union, r.related as null_id, l.file as file from null_descendants as r join union_nodes as l on r.id = l.id and r.file = l.file;
let optional_null_pairs = select l.union as union, l.optional_id as optional_id, r.null_id as null_id, l.file as file from union_optionals as l join union_nulls as r on l.union = r.union and l.file = r.file;
let optional_locations = select l.union as union, l.optional_id as optional_id, l.null_id as null_id, l.file as file, r."start-byte" as optional_start from optional_null_pairs as l join "source-location" as r on l.optional_id = r.id and l.file = r.file;
let optional_pair_locations = select l.union as union, l.optional_id as optional_id, l.null_id as null_id, l.file as file, l.optional_start as optional_start, r."start-byte" as null_start from optional_locations as l join "source-location" as r on l.null_id = r.id and l.file = r.file;
let optional_duplicate_nulls = select union, null_id as id, file from optional_pair_locations where optional_start < null_start;
let optional_duplicate_types = select union, optional_id as id, file from optional_pair_locations where optional_start > null_start;
let optional_pairs = select l.union as union, l.optional_id as earlier, r.optional_id as later, l.file as file from union_optionals as l join union_optionals as r on l.union = r.union and l.file = r.file;
let optional_pair_locations2 = select l.union as union, l.earlier as earlier, l.later as later, r."start-byte" as earlier_start, l.file as file from optional_pairs as l join "source-location" as r on l.earlier = r.id and l.file = r.file;
let optional_duplicate_types2 = select l.union as union, l.later as later, l.earlier_start as earlier_start, r."start-byte" as later_start, l.file as file from optional_pair_locations2 as l join "source-location" as r on l.later = r.id and l.file = r.file;
let repeated_optionals = select union, later as id, file from optional_duplicate_types2 where earlier_start < later_start;
let optional_dups_a = union(left=optional_duplicate_nulls, right=optional_duplicate_types);
let optional_dups = union(left=optional_dups_a, right=repeated_optionals);
let all_duplicate_members = union(left=duplicate_members, right=optional_dups);
let duplicate_member_set = group-count(from=all_duplicate_members, keys=["union", "id", "file"], count="count");
let reportable = select l.id as id, l.file as file, r.span as span from duplicate_member_set as l join "source-location" as r on l.id = r.id and l.file = r.file;
let locations = select r.id as id, r.file as file, r."start-line" as line from "source-location" as r;
let candidates = select l.id as id, l.file as file, l.span as span, r.line as line from reportable as l join locations as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="PYI016(?:$|[, #])", range-pattern="(?:^|,)PYI016(?:,|$)");
emit violations subject file key(id);
