import suppress from "python/ruff/suppress";
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare" and glob_any(file, "**/*.pyi");
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let version = select id, file from "qualified-name" where path = "sys.version_info";
let subscript = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_bases = select parent as subscript, child as base from "semantic-child" where field = "value";
let version_subscript = select l.subscript as subscript, r.file as file from subscript_bases as l join version as r on l.base = r.id;
let index_edges = select parent, child, file from "semantic-child" where field = "slice";
let indices = select l.parent as subscript, l.child as index, r.file as file from index_edges as l join version_subscript as r on l.parent = r.subscript;
let index_literals = select id, file, kind, zero from "literal-properties";
let index_integer_rows = select l.index as id, l.file as file, r.zero as zero from indices as l join index_literals as r on l.index = r.id and l.file = r.file where r.kind = "integer";
let zero_indices = select id, file from index_integer_rows where zero = "true";
let slice_indices = select l.index as id, l.file as file from indices as l join "semantic-syntax" as r on l.index = r.id and l.file = r.file where r.kind = "slice";
let upper_fields = select parent, child, file from "semantic-child" where field = "upper";
let upper_exprs = select l.id as slice, r.child as upper, l.file as file from slice_indices as l join upper_fields as r on l.id = r.parent and l.file = r.file;
let upper_locations = select l.slice as slice, l.file as file, r."start-byte" as start, r."end-byte" as end from upper_exprs as l join "source-location" as r on l.upper = r.id and l.file = r.file;
let upper_value_tokens = select id, file from "semantic-syntax" where matches(text, "(?i)^(?:1|0x(?:_?0)*_?1|0b(?:_?0)*_?1|0o(?:_?0)*_?1)$") or matches(text, "(?i)^(?:2|0x(?:_?0)*_?2|0b(?:_?0)*_?1_?0|0o(?:_?0)*_?2)$");
let upper_token_locations = select l.id as token, l.file as file, r."start-byte" as start, r."end-byte" as end from upper_value_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let valid_slice_uppers = select l.slice as id, l.file as file from upper_locations as l join upper_token_locations as r on l.start = r.start and l.end = r.end and l.file = r.file;
let lower_fields = select parent as slice, child, file from "semantic-child" where field = "lower";
let step_fields = select parent as slice, child, file from "semantic-child" where field = "step";
let slices_with_lower = select l.id as id, l.file as file from slice_indices as l join lower_fields as r on l.id = r.slice and l.file = r.file;
let slices_with_step = select l.id as id, l.file as file from slice_indices as l join step_fields as r on l.id = r.slice and l.file = r.file;
let invalid_slice_shape = union(left=slices_with_lower, right=slices_with_step);
let invalid_slice_uppers = antijoin(left=slice_indices, right=valid_slice_uppers, left-on=["id", "file"], right-on=["id", "file"]);
let invalid_slices = union(left=invalid_slice_shape, right=invalid_slice_uppers);
let index_slices = antijoin(left=slice_indices, right=invalid_slices, left-on=["id", "file"], right-on=["id", "file"]);
let valid_indices = union(left=zero_indices, right=index_slices);
let invalid_indices = antijoin(left=indices, right=valid_indices, left-on=["index", "file"], right-on=["id", "file"]);
let comparator_edges = select parent, child from "semantic-child" where field = "comparators";
let comparators = select l.parent as comparison, l.child as comparator, r.file as file from comparator_edges as l join comparisons as r on l.parent = r.id;
let valid_comparators = select l.comparator as id, l.file as file from comparators as l join "literal-properties" as r on l.comparator = r.id and l.file = r.file where r.kind = "integer";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_comparator_rows = select l.comparator as id, l.file as file from comparators as l join tuples as r on l.comparator = r.id and l.file = r.file;
let tuple_elements = select parent, child from "semantic-child" where field = "elts";
let tuple_element_rows = select l.parent as tuple, l.child as element, r.file as file from tuple_elements as l join tuples as r on l.parent = r.id;
let integer_elements = select id, file from "literal-properties" where kind = "integer";
let invalid_tuple_elements = antijoin(left=tuple_element_rows, right=integer_elements, left-on=["element", "file"], right-on=["id", "file"]);
let bad_tuple_ids = select tuple as id, file from invalid_tuple_elements;
let valid_tuple_comparators = antijoin(left=tuple_comparator_rows, right=bad_tuple_ids, left-on=["id", "file"], right-on=["id", "file"]);
let valid_rhs = union(left=valid_comparators, right=valid_tuple_comparators);
let invalid_rhs = antijoin(left=comparators, right=valid_rhs, left-on=["comparator", "file"], right-on=["id", "file"]);
let bad_rhs_comparisons = select comparison as id, file from invalid_rhs;
let bad_index_comparison_edges = select l.parent as comparison, r.file as file from left_edges as l join invalid_indices as r on l.child = r.subscript;
let bad_index_comparisons = select l.comparison as id, l.file as file from bad_index_comparison_edges as l join comparisons as r on l.comparison = r.id and l.file = r.file;
let candidates = union(left=bad_rhs_comparisons, right=bad_index_comparisons);
let reportable = select l.id as id, r.file as file, r.span as span from candidates as l join comparisons as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI003(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI003)(?:,|$)");
emit violations subject file key(id);
