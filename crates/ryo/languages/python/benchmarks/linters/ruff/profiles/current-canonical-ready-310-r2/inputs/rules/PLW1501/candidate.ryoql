import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let builtin_open_functions = select id, file from "qualified-name" where path = "builtins.open";
let builtin_open_calls = select l.call as call, l.file as file from call_functions as l join builtin_open_functions as r on l.function = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_calls = select l.call as call, l.function as attribute, l.file as file from call_functions as l join attributes as r on l.function = r.id and l.file = r.file;
let attr_fields = select parent, child from "semantic-child" where field = "attr";
let attr_children = select l.parent as attribute, r.child as token from attr_fields as l join "semantic-child" as r on l.child = r.parent;
let name_tokens = select id from "semantic-syntax" where kind = "name-token";
let identifier_edges = select l.child as id, r.name as name from "semantic-child" as l join "identifier" as r on l.parent = r.id;
let identifiers = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let attribute_names = select l.attribute as attribute, r.name as name from attr_children as l join identifiers as r on l.token = r.id;
let open_attributes = select attribute from attribute_names where name = "open";
let open_attribute_rows = select l.call as call, l.attribute as attribute, l.file as file from attribute_calls as l join open_attributes as r on l.attribute = r.attribute;
let value_fields = select parent, child from "semantic-child" where field = "value";
let attribute_bases = select l.parent as attribute, l.child as base, r.file as file from value_fields as l join calls as r on l.child = r.id;
let path_call_fields = select parent, child from "semantic-child" where field = "func";
let path_call_functions = select l.parent as call, l.child as function, r.file as file from path_call_fields as l join calls as r on l.parent = r.id;
let path_functions = select id, file from "qualified-name" where path = "pathlib.Path";
let path_calls = select l.call as call, l.file as file from path_call_functions as l join path_functions as r on l.function = r.id and l.file = r.file;
let path_open_bases = select l.attribute as attribute, l.file as file from attribute_bases as l join path_calls as r on l.base = r.call and l.file = r.file;
let path_open_attribute_rows = select l.attribute as attribute, l.file as file from path_open_bases as l join open_attributes as r on l.attribute = r.attribute;
let path_open_calls = select r.call as call, l.file as file from path_open_attribute_rows as l join attribute_calls as r on l.attribute = r.attribute and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, r.ordinal as ordinal, l.file as file from wrappers as l join positional_fields as r on l.wrapper = r.parent;
let later_argument_rows = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from positional_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let first_arguments = antijoin(left=positional_arguments,right=later_argument_rows,left-on=["call","value","ordinal","file"],right-on=["call","value","ordinal","file"]);
let after_first_rows = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from first_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let later_after_first_rows = select l.call as call, r.value as value, r.ordinal as ordinal, l.file as file from after_first_rows as l join after_first_rows as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let second_arguments = antijoin(left=after_first_rows,right=later_after_first_rows,left-on=["call","value","ordinal","file"],right-on=["call","value","ordinal","file"]);
let builtin_positional_modes = select l.call as call, r.value as value, l.file as file from builtin_open_calls as l join second_arguments as r on l.call = r.call and l.file = r.file;
let path_positional_modes = select l.call as call, r.value as value, l.file as file from path_open_calls as l join first_arguments as r on l.call = r.call and l.file = r.file;
let positional_modes = union(left=builtin_positional_modes,right=path_positional_modes);
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let keywords = select l.call as call, l.keyword as keyword, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let arg_fields = select parent, child from "semantic-child" where field = "arg";
let arg_edges = select l.parent as keyword, r.child as identifier from arg_fields as l join "semantic-child" as r on l.child = r.parent;
let identifiers_by_id = select l.id as id, l.name as name from identifier_edges as l join name_tokens as r on l.id = r.id;
let keyword_names = select l.keyword as keyword, r.name as name from arg_edges as l join identifiers_by_id as r on l.identifier = r.id;
let mode_names = select keyword from keyword_names where name = "mode";
let mode_keyword_edges = select l.call as call, l.keyword as keyword, l.file as file from keywords as l join mode_names as r on l.keyword = r.keyword;
let keyword_value_fields = select parent, child from "semantic-child" where field = "value";
let keyword_modes = select l.call as call, r.child as value, l.file as file from mode_keyword_edges as l join keyword_value_fields as r on l.keyword = r.parent;
let all_mode_values = union(left=positional_modes,right=keyword_modes);
let mode_strings = select l.call as call, l.value as value, l.file as file, r.span as span, r.value as mode from all_mode_values as l join "string-literal" as r on l.value = r.occurrence and l.file = r.file;
let bad_modes = select * from mode_strings where matches(mode, ".*[^rwaxUbt+].*") or matches(mode, ".*r.*r.*") or matches(mode, ".*w.*w.*") or matches(mode, ".*a.*a.*") or matches(mode, ".*x.*x.*") or matches(mode, ".*U.*U.*") or matches(mode, ".*b.*b.*") or matches(mode, ".*t.*t.*") or matches(mode, ".*[+].*[+].*") or matches(mode, ".*r.*w.*") or matches(mode, ".*w.*r.*") or matches(mode, ".*r.*a.*") or matches(mode, ".*a.*r.*") or matches(mode, ".*r.*x.*") or matches(mode, ".*x.*r.*") or matches(mode, ".*w.*a.*") or matches(mode, ".*a.*w.*") or matches(mode, ".*w.*x.*") or matches(mode, ".*x.*w.*") or matches(mode, ".*a.*x.*") or matches(mode, ".*x.*a.*") or matches(mode, ".*U.*[wax].*") or matches(mode, ".*[wax].*U.*") or matches(mode, ".*b.*t.*") or matches(mode, ".*t.*b.*") or matches(mode, "^[bt+]*$");
let candidate_locations = select value as id, file as file, span as span, r."start-line" as line from bad_modes as l join "source-location" as r on l.value = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW1501(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW1501)(?:,|$)");
emit violations subject file key(id);
