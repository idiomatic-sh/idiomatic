import suppress from "python/ruff/suppress";
let stub_files = select path as file from "filesystem.file" where ends_with(path, ".pyi");
let assignments = select l.id as id, l.file as file from "semantic-syntax" as l join stub_files as r on l.file = r.file where l.kind = "ann-assign";
let values = select l.parent as assignment, l.child as value, l.file as file from "semantic-child" as l join assignments as r on l.parent = r.id and l.file = r.file where l.field = "value";
let calls = select id, file from "semantic-syntax" where kind = "call";
let call_values = select l.assignment as assignment, l.value as value, l.file as file from values as l join calls as r on l.value = r.id and l.file = r.file;
let functions = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, l.file as file from functions as l join calls as r on l.parent = r.id and l.file = r.file;
let typevar_names = select id, file from "qualified-name" where path = "typing.TypeVar" or path = "typing.ParamSpec" or path = "typing.TypeVarTuple";
let typevar_calls = select l.call as call, l.file as file from call_functions as l join typevar_names as r on l.function = r.id and l.file = r.file;
let typevar_filtered = antijoin(left=call_values, right=typevar_calls, left-on=["value", "file"], right-on=["call", "file"]);
let annotations = select parent as assignment, child as annotation, file from "semantic-child" where field = "annotation";
let type_alias_names = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias";
let type_alias_assignments = select l.assignment as assignment, l.file as file from annotations as l join type_alias_names as r on l.annotation = r.id and l.file = r.file;
let non_type_alias_calls = antijoin(left=typevar_filtered, right=type_alias_assignments, left-on=["assignment", "file"], right-on=["assignment", "file"]);
let locations = select r.id as id, r.file as file, r.span as span, r."start-line" as line from "source-location" as r;
let candidates = select l.value as id, l.file as file, r.span as span, r.line as line from non_type_alias_calls as l join locations as r on l.value = r.id and l.file = r.file;
let violations = suppress(candidates=candidates, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI015(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI015)(?:,|$)");
emit violations subject file key(id);
