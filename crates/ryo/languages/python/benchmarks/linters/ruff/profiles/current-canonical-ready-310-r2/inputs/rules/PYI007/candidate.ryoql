import suppress from "python/ruff/suppress";
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare" and glob_any(file, "**/*.pyi");
let left_edges = select parent, child from "semantic-child" where field = "left";
let platform = select id, file from "qualified-name" where path = "sys.platform";
let left_rows = select l.parent as comparison, l.child as left, r.file as file from left_edges as l join comparisons as r on l.parent = r.id;
let platform_rows = select l.comparison as comparison, l.left as left, l.file as file from left_rows as l join platform as r on l.left = r.id and l.file = r.file;
let op_edges = select parent, child from "semantic-child" where field = "ops";
let allowed_ops = select id from "semantic-syntax" where text = "==" or text = "!=";
let invalid_ops = antijoin(left=op_edges, right=allowed_ops, left-on=["child"], right-on=["id"]);
let bad_operator_rows = select l.comparison as comparison, l.file as file from platform_rows as l join invalid_ops as r on l.comparison = r.parent;
let comparator_edges = select parent, child from "semantic-child" where field = "comparators";
let rhs_rows = select l.parent as comparison, l.child as rhs, r.file as file from comparator_edges as l join comparisons as r on l.parent = r.id;
let strings = select id, file from "literal-properties" where kind = "string";
let bad_rhs = antijoin(left=rhs_rows, right=strings, left-on=["rhs", "file"], right-on=["id", "file"]);
let bad_rhs_rows = select l.comparison as comparison, l.file as file from bad_rhs as l join platform_rows as r on l.comparison = r.comparison;
let invalid = union(left=bad_operator_rows, right=bad_rhs_rows);
let reportable = select l.comparison as id, r.file as file, r.span as span from invalid as l join comparisons as r on l.comparison = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI007(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI007)(?:,|$)");
emit violations subject file key(id);
