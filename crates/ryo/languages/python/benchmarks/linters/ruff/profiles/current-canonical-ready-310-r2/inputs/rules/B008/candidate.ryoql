import suppress from "python/ruff/suppress";
let default_roots = select parent as function, child as value, file from "semantic-child" where field = "defaults";
let default_wrappers = select id, file from "semantic-syntax" where kind = "parameter-with-default";
let wrapper_defaults = select l.id as wrapper, l.file as file, r.child as value from default_wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "defaults" or r.field = "kw-defaults";
let wrapper_parameters = select l.id as wrapper, l.file as file, r.child as parameter from default_wrappers as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "args" or r.field = "posonlyargs" or r.field = "kwonlyargs";
let parameter_annotations = select l.wrapper as wrapper, l.file as file, r.child as annotation from wrapper_parameters as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let direct_annotation_names = select id as node, file, path from "qualified-name";
let direct_immutable_nodes = select node, file from direct_annotation_names where path = "collections.abc.Sized" or path = "typing.LiteralString" or path = "typing.Sized" or path = "builtins.bool" or path = "builtins.bytes" or path = "builtins.complex" or path = "builtins.float" or path = "builtins.int" or path = "builtins.object" or path = "builtins.range" or path = "builtins.str";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_value_edges = select parent, child from "semantic-child" where field = "value";
let subscript_bases = select l.id as subscript, l.file as file, r.child as base from subscript_nodes as l join subscript_value_edges as r on l.id = r.parent;
let subscript_base_names = select l.subscript as subscript, l.file as file, r.path as path from subscript_bases as l join "qualified-name" as r on l.base = r.id and l.file = r.file;
let generic_subscripts = select subscript as node, file from subscript_base_names where path = "builtins.frozenset" or path = "builtins.tuple" or path = "builtins.frozendict" or path = "collections.abc.ByteString" or path = "collections.abc.Collection" or path = "collections.abc.Container" or path = "collections.abc.Iterable" or path = "collections.abc.Mapping" or path = "collections.abc.Reversible" or path = "collections.abc.Sequence" or path = "collections.abc.Set" or path = "typing.AbstractSet" or path = "typing.ByteString" or path = "typing.Callable" or path = "typing.Collection" or path = "typing.Container" or path = "typing.FrozenSet" or path = "typing.Iterable" or path = "typing.Literal" or path = "typing.Mapping" or path = "typing.Never" or path = "typing.NoReturn" or path = "typing.Reversible" or path = "typing.Sequence" or path = "typing.Tuple";
let generic_direct_nodes = select id as node, file from "qualified-name" where path = "builtins.frozenset" or path = "builtins.tuple" or path = "builtins.frozendict" or path = "collections.abc.ByteString" or path = "collections.abc.Collection" or path = "collections.abc.Container" or path = "collections.abc.Iterable" or path = "collections.abc.Mapping" or path = "collections.abc.Reversible" or path = "collections.abc.Sequence" or path = "collections.abc.Set" or path = "typing.AbstractSet" or path = "typing.ByteString" or path = "typing.Callable" or path = "typing.Collection" or path = "typing.Container" or path = "typing.FrozenSet" or path = "typing.Iterable" or path = "typing.Literal" or path = "typing.Mapping" or path = "typing.Never" or path = "typing.NoReturn" or path = "typing.Reversible" or path = "typing.Sequence" or path = "typing.Tuple";
let optional_subscripts = select subscript as node, file from subscript_base_names where path = "typing.Optional";
let union_subscripts = select subscript as node, file from subscript_base_names where path = "typing.Union";
let annotated_subscripts = select subscript as node, file from subscript_base_names where path = "typing.Annotated";
let none_nodes = select id as node, file from "literal-properties" where kind = "null";
let binops = select id, file from "semantic-syntax" where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binop_lefts = select l.id as binop, l.file as file, r.child as child from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, l.file as file, r.child as child from binops as l join right_fields as r on l.id = r.parent;
let binop_left_locations = select l.binop as binop, l.file as file, r."end-byte" as boundary from binop_lefts as l join "source-location" as r on l.child = r.id and l.file = r.file;
let binop_right_locations = select l.binop as binop, l.file as file, r."start-byte" as boundary from binop_rights as l join "source-location" as r on l.child = r.id and l.file = r.file;
let ordered_binop_operands = select l.binop as binop, l.file as file, l.boundary as left_end, r.boundary as right_start from binop_left_locations as l join binop_right_locations as r on l.binop = r.binop and l.file = r.file;
let pipe_tokens = select l.id as token, r.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "|";
let bit_or_nodes = select l.binop as node, l.file as file from ordered_binop_operands as l join pipe_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let optional_slice_edges = select l.subscript as origin, r.child as destination from subscript_bases as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let optional_edges = select l.origin as origin, l.destination as destination from optional_slice_edges as l join optional_subscripts as r on l.origin = r.node;
let union_slice_nodes = select l.subscript as union_node, r.child as slice from subscript_bases as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let union_argument_lists = select l.union_node as union_node, r.id as argument_list_node from union_slice_nodes as l join "semantic-syntax" as r on l.slice = r.id where r.kind = "tuple";
let argument_element_edges = select parent, child, ordinal from "semantic-child" where field = "elts";
let union_element_edges = select l.union_node as origin, r.child as destination from union_argument_lists as l join argument_element_edges as r on l.argument_list_node = r.parent;
let union_edges = select l.origin as origin, l.destination as destination from union_element_edges as l join union_subscripts as r on l.origin = r.node;
let annotated_slice_nodes = select l.subscript as annotated_node, r.child as slice from subscript_bases as l join "semantic-child" as r on l.subscript = r.parent and l.file = r.file where r.field = "slice";
let annotated_argument_list_nodes = select l.annotated_node as annotated_node, r.id as argument_list_node from annotated_slice_nodes as l join "semantic-syntax" as r on l.slice = r.id where r.kind = "tuple";
let later_argument_element_pairs = select l.parent as tuple_id, l.child as element_id, l.ordinal as ordinal from argument_element_edges as l join argument_element_edges as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first_argument_elements = antijoin(left=argument_element_edges, right=later_argument_element_pairs, left-on=["parent", "child", "ordinal"], right-on=["tuple_id", "element_id", "ordinal"]);
let annotated_element_edges = select l.annotated_node as origin, r.child as destination from annotated_argument_list_nodes as l join first_argument_elements as r on l.argument_list_node = r.parent;
let annotated_edges = select l.origin as origin, l.destination as destination from annotated_element_edges as l join annotated_subscripts as r on l.origin = r.node;
let bit_or_left_edges = select l.node as origin, r.child as destination from bit_or_nodes as l join left_fields as r on l.node = r.parent;
let bit_or_right_edges = select l.node as origin, r.child as destination from bit_or_nodes as l join right_fields as r on l.node = r.parent;
let bit_or_edges = union(left=bit_or_left_edges, right=bit_or_right_edges);
let annotation_flow_edges_a = union(left=optional_edges, right=union_edges);
let annotation_flow_edges_b = union(left=annotation_flow_edges_a, right=annotated_edges);
let annotation_flow_edges = union(left=annotation_flow_edges_b, right=bit_or_edges);
let annotation_paths = closure(edges=annotation_flow_edges, source="origin", destination="destination");
let annotation_root_nodes = select wrapper, annotation as node, file from parameter_annotations;
let annotation_descendant_nodes = select l.wrapper as wrapper, r.destination as node, l.file as file from parameter_annotations as l join annotation_paths as r on l.annotation = r.origin;
let all_annotation_nodes = union(left=annotation_root_nodes, right=annotation_descendant_nodes);
let structural_annotation_nodes_a = union(left=optional_subscripts, right=union_subscripts);
let structural_annotation_nodes_b = union(left=structural_annotation_nodes_a, right=annotated_subscripts);
let structural_annotation_nodes = union(left=structural_annotation_nodes_b, right=bit_or_nodes);
let immutable_nodes_a = union(left=direct_immutable_nodes, right=generic_direct_nodes);
let immutable_nodes_b = union(left=immutable_nodes_a, right=generic_subscripts);
let immutable_nodes_c = union(left=immutable_nodes_b, right=none_nodes);
let immutable_nodes = union(left=immutable_nodes_c, right=structural_annotation_nodes);
let unrecognized_annotation_nodes = antijoin(left=all_annotation_nodes, right=immutable_nodes, left-on=["node", "file"], right-on=["node", "file"]);
let mutable_annotation_wrappers = select wrapper, file from unrecognized_annotation_nodes;
let immutable_annotations = antijoin(left=parameter_annotations, right=mutable_annotation_wrappers, left-on=["wrapper", "file"], right-on=["wrapper", "file"]);
let immutable_annotation_defaults = select l.value as id, l.file as file from wrapper_defaults as l join immutable_annotations as r on l.wrapper = r.wrapper and l.file = r.file;
let unannotated_default_roots = antijoin(left=default_roots, right=immutable_annotation_defaults, left-on=["value","file"], right-on=["id","file"]);
let edges = select parent as origin, child as destination from "semantic-child";
let descendants = closure(edges=edges, source="origin", destination="destination");
let values_below_default = select l.function as function, l.value as value, l.file as file from unannotated_default_roots as l;
let nested_values = select l.function as function, r.destination as value, l.file as file from unannotated_default_roots as l join descendants as r on l.value = r.origin;
let all_values_a = union(left=values_below_default, right=nested_values);
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let calls_in_defaults = select r.id as id, r.file as file, r.span as span from all_values_a as l join calls as r on l.value = r.id and l.file = r.file;
let all_default_values = union(left=values_below_default, right=nested_values);
let lambda_nodes = select id, file from "semantic-syntax" where kind = "lambda";
let lambdas_in_defaults = select l.value as id, l.file as file from all_default_values as l join lambda_nodes as r on l.value = r.id and l.file = r.file;
let lambda_descendants = select l.id as lambda, r.destination as id, l.file as file from lambdas_in_defaults as l join descendants as r on l.id = r.origin;
let calls_in_lambdas = select l.id as id, l.file as file from lambda_descendants as l join calls as r on l.id = r.id and l.file = r.file;
let calls_outside_lambdas = antijoin(left=calls_in_defaults, right=calls_in_lambdas, left-on=["id","file"], right-on=["id","file"]);
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from calls_outside_lambdas as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*B008(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:B008)(?:,|$)");
emit violations subject file key(id);
