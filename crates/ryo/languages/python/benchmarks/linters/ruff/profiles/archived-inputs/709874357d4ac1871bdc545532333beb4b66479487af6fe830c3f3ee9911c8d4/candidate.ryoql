import suppress from "python/ruff/suppress";
let bases = select parent as arguments, child as base, ordinal, file from "semantic-child" where field = "bases";
let base_values = select parent as base, child as value, file from "semantic-child" where field = "value";
let generic_names = select id, file from "qualified-name" where path = "typing.Generic" or path = "typing_extensions.Generic";
let direct_generics = select l.arguments as arguments, l.base as generic, l.ordinal as ordinal, l.file as file from bases as l join generic_names as r on l.base = r.id and l.file = r.file;
let subscript_bases = select l.arguments as arguments, l.base as base, l.ordinal as ordinal, r.value as value, l.file as file from bases as l join base_values as r on l.base = r.base and l.file = r.file;
let subscript_generics = select l.arguments as arguments, l.base as generic, l.ordinal as ordinal, l.file as file from subscript_bases as l join generic_names as r on l.value = r.id and l.file = r.file;
let generics = union(left=direct_generics, right=subscript_generics);
let later_bases = select parent as arguments, child as base, ordinal, file from "semantic-child" where field = "bases";
let nonfinal_generics = select l.arguments as arguments, l.generic as generic, l.file as file from generics as l join later_bases as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let offending_arguments = group-count(from=nonfinal_generics, keys=["arguments", "file"], count="count", distinct="generic");
let with_line = select l.arguments as id, l.file as file, r.span as span, r."start-line" as line from offending_arguments as l join "source-location" as r on l.arguments = r.id and l.file = r.file;
let violations = suppress(candidates=with_line, inline-pattern="PYI059($|[, #])", range-pattern="(?:^|,)(?:PYI059)(?:,|$)");
emit violations subject file key(id);
