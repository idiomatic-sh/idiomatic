output relation<binding: node, value: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let assignments = select id, file from nodes where kind = "assign";
let named_expressions = select id, file from nodes where kind = "named-expr";
let with_items = select id, file from nodes where kind = "withitem";
let assign_targets = select l.id as owner, r.child as target, l.file as file from assignments as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "targets";
let named_targets = select l.id as owner, r.child as target, l.file as file from named_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let with_targets = select l.id as owner, r.child as target, l.file as file from with_items as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "optional-vars";
let ordinary_targets = union(left=assign_targets, right=named_targets);
let ordinary_values = select parent as owner, child as value, file from "semantic-child" where field = "value";
let ordinary_pairs = select l.target as target, r.value as value, l.file as file from ordinary_targets as l join ordinary_values as r on l.owner = r.owner and l.file = r.file;
let with_values = select parent as owner, child as value, file from "semantic-child" where field = "context-expr";
let with_pairs = select l.target as target, r.value as value, l.file as file from with_targets as l join with_values as r on l.owner = r.owner and l.file = r.file;
let root_pairs = union(left=ordinary_pairs, right=with_pairs);
let names = select id, file from nodes where kind = "name";
let direct_bindings = select l.target as binding, l.value as value, l.file as file from root_pairs as l join names as r on l.target = r.id and l.file = r.file;
let target_collections = select id, file from nodes where kind = "tuple" or kind = "list";
let value_collections = select id, file from nodes where kind = "tuple" or kind = "list" or kind = "set";
let collection_targets = select l.target as target, l.value as value, l.file as file from root_pairs as l join target_collections as r on l.target = r.id and l.file = r.file;
let collection_pairs = select l.target as target, l.value as value, l.file as file from collection_targets as l join value_collections as r on l.value = r.id and l.file = r.file;
let elements = select l.id as parent, r.child as child, r.ordinal as ordinal, l.file as file from value_collections as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let element_predecessors = select l.parent as parent, l.child as earlier, r.child as child, l.file as file from elements as l join elements as r on l.parent = r.parent and l.file = r.file where l.ordinal < r.ordinal;
let element_positions = group-count(from=element_predecessors, keys=["parent", "child", "file"], count="position", distinct="earlier");
let first_elements0 = antijoin(left=elements, right=element_positions, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let first_elements1 = select parent, child, file from first_elements0;
let first_elements2 = extend(from=first_elements1, values={position: 0});
let first_elements = select parent, child, file, position from first_elements2;
let later_elements = select parent, child, file, position from element_positions;
let ranked_elements = union(left=first_elements, right=later_elements);
let collection_edges = select parent as origin, child as destination, file from elements;
let self_edges = select id as origin, id as destination, file from nodes;
let edges = union(left=collection_edges, right=self_edges);
let paths = closure(edges=edges, source="origin", destination="destination", keys=["file"]);
let intervals = select l.origin as root, r.destination as end, l.destination as middle, l.file as file from paths as l join paths as r on l.destination = r.origin and l.file = r.file;
let depths = group-count(from=intervals, keys=["root", "end", "file"], count="depth", distinct="middle");
let target_paths = select l.target as target_root, l.value as value_root, r.end as binding, r.depth as depth, l.file as file from collection_pairs as l join depths as r on l.target = r.root and l.file = r.file;
let target_bindings = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.depth as depth, l.file as file from target_paths as l join names as r on l.binding = r.id and l.file = r.file;
let candidates = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, r.end as value, l.file as file from target_bindings as l join depths as r on l.value_root = r.root and l.depth = r.depth and l.file = r.file;
let target_steps0 = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, r.middle as step, l.file as file from candidates as l join intervals as r on l.target_root = r.root and l.binding = r.end and l.file = r.file where r.middle != l.target_root;
let target_steps1 = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, l.step as step, r.position as position, l.file as file from target_steps0 as l join ranked_elements as r on l.step = r.child and l.file = r.file;
let target_steps = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, l.step as step, l.position as position, r.depth as depth, l.file as file from target_steps1 as l join depths as r on l.target_root = r.root and l.step = r.end and l.file = r.file;
let value_steps0 = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, r.middle as step, l.file as file from candidates as l join intervals as r on l.value_root = r.root and l.value = r.end and l.file = r.file where r.middle != l.value_root;
let value_steps1 = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, l.step as step, r.position as position, l.file as file from value_steps0 as l join ranked_elements as r on l.step = r.child and l.file = r.file;
let value_steps = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, l.step as step, l.position as position, r.depth as depth, l.file as file from value_steps1 as l join depths as r on l.value_root = r.root and l.step = r.end and l.file = r.file;
let matched_steps = select l.target_root as target_root, l.value_root as value_root, l.binding as binding, l.value as value, l.step as step, l.file as file from target_steps as l join value_steps as r on l.target_root = r.target_root and l.value_root = r.value_root and l.binding = r.binding and l.value = r.value and l.depth = r.depth and l.position = r.position and l.file = r.file;
let required_counts = group-count(from=target_steps, keys=["target_root", "value_root", "binding", "value", "file"], count="count", distinct="step");
let matched_counts = group-count(from=matched_steps, keys=["target_root", "value_root", "binding", "value", "file"], count="count", distinct="step");
let nested_bindings = select l.binding as binding, l.value as value, l.file as file from required_counts as l join matched_counts as r on l.target_root = r.target_root and l.value_root = r.value_root and l.binding = r.binding and l.value = r.value and l.file = r.file where l.count = r.count;
let bindings = union(left=direct_bindings, right=nested_bindings);
return bindings;
