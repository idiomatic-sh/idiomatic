let nodes = select id, kind, file, span from "semantic-syntax";
let statements = select id from nodes where glob_any(kind, "{function-def,class-def,return,delete,assign,type-alias,aug-assign,ann-assign,for,while,if,with,match,raise,try,assert,import,import-from,global,nonlocal,expr,pass,break,continue}");
let lexical_scopes = select id from nodes where kind = "module" or kind = "function-def" or kind = "class-def" or kind = "lambda";
let functions = select id from nodes where kind = "function-def" or kind = "lambda";
let named_definitions = select l.id as binding, r.id as id, l.name as name, l.file as file, l.span as span from "defines" as l join "identifier" as r on l.file = r.file and l.span = r.span and l.name = r.name;
let bindings = select occurrence as binding, name, scope, phase, ordinal from "binding-event" where kind = "bind";
let named_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.ordinal as ordinal, r.id as id, r.name as name, r.file as file, r.span as span from bindings as l join named_definitions as r on l.binding = r.binding;
let endings = select occurrence as binding, name, scope, phase, ordinal from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let replaced = select l.binding as binding from named_bindings as l join endings as r on l.scope = r.scope and l.phase = r.phase and l.name = r.name where l.ordinal < r.ordinal;
let final_bindings = antijoin(left=named_bindings,right=replaced,left-on=["binding"],right-on=["binding"]);
let redirections = select occurrence as id, name from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_scopes = axis(from=redirections,relation="semantic-child",direction=nearest-ancestor,domain=lexical_scopes);
let redirected = select related as scope, name from redirect_scopes;
let unredirected = antijoin(left=final_bindings,right=redirected,left-on=["scope","name"],right-on=["scope","name"]);
let local_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from unredirected as l join functions as r on l.scope = r.id;
let declaration_nodes = select binding as id from local_bindings;
let enclosing_statements = axis(from=declaration_nodes,relation="semantic-child",direction=nearest-ancestor,domain=statements);
let source_statements = select l.id as binding, r.id as statement, r.kind as kind from enclosing_statements as l join nodes as r on l.related = r.id;
let plain_assignments = select binding from source_statements where kind = "assign" or kind = "aug-assign" or kind = "ann-assign" or kind = "with";
let named_expressions = select id from nodes where kind = "named-expr";
let targets = select parent, child from "semantic-child" where field = "target";
let named_targets = select r.child as binding from named_expressions as l join targets as r on l.id = r.parent;
let patterns = select id as binding from nodes where kind = "match-as" or kind = "match-star" or kind = "match-mapping";
let assignment_or_named = union(left=plain_assignments,right=named_targets);
let eligible_assignments = union(left=assignment_or_named,right=patterns);
let eligible_locals = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from local_bindings as l join eligible_assignments as r on l.binding = r.binding;
let handlers = select id from nodes where kind = "except-handler";
let exception_bindings = select l.binding as binding, l.scope as scope, l.phase as phase, l.id as id, l.name as name, l.file as file, l.span as span from named_bindings as l join handlers as r on l.binding = r.id;
let shadow_replacements = select previous as earlier, binding as later from "binding-shadow" where relationship = "replacement";
let timed_replacements = select l.earlier as earlier, l.later as later, r.phase as phase, r.ordinal as ordinal from shadow_replacements as l join bindings as r on l.later = r.binding;
let local_replacements = select l.earlier as earlier, l.later as later, l.ordinal as ordinal from timed_replacements as l join bindings as r on l.earlier = r.binding and l.phase = r.phase where r.ordinal < l.ordinal;
let replacement_edges = select earlier, later from local_replacements;
let inherited = closure(edges=replacement_edges,source="earlier",destination="later");
let direct_uses = select binding from "binding-use";
let read_events = select occurrence as reference, ordinal from "binding-event" where kind = "read" or kind = "delete";
let dated_uses = select l.binding as binding, r.ordinal as ordinal from "binding-use" as l join read_events as r on l.reference = r.reference;
let copied_uses = select r.later as binding from dated_uses as l join local_replacements as r on l.binding = r.earlier where l.ordinal < r.ordinal;
let inherited_uses = select r.later as binding from copied_uses as l join inherited as r on l.binding = r.earlier;
let copied_and_inherited = union(left=copied_uses,right=inherited_uses);
let used = union(left=direct_uses,right=copied_and_inherited);
let unused_locals = antijoin(left=eligible_locals,right=used,left-on=["binding"],right-on=["binding"]);
let unused_exceptions = antijoin(left=exception_bindings,right=used,left-on=["binding"],right-on=["binding"]);
let calls = select id from nodes where kind = "call";
let callable_fields = select parent, child from "semantic-child" where field = "func";
let callees = select r.child as id from calls as l join callable_fields as r on l.id = r.parent;
let locals_names = select id from "identifier" where name = "locals";
let locals_calls = select l.id as id from callees as l join locals_names as r on l.id = r.id;
let locals_scopes = select r.scope as scope from locals_calls as l join "binding-read" as r on l.id = r.reference;
let real_functions = select id from nodes where kind = "function-def";
let inspecting_scopes = select l.scope as scope from locals_scopes as l join real_functions as r on l.scope = r.id;
let uninspected = antijoin(left=unused_locals,right=inspecting_scopes,left-on=["scope"],right-on=["scope"]);
let regular_names = select * from uninspected where name != "__tracebackhide__" and name != "__traceback_info__" and name != "__traceback_supplement__" and name != "__debuggerskip__";
let all_candidates = union(left=regular_names,right=unused_exceptions);
let dummy_candidates = select binding from all_candidates where matches(name, "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$");
let named_candidates = antijoin(left=all_candidates,right=dummy_candidates,left-on=["binding"],right-on=["binding"]);
let containers = select id from nodes where kind = "tuple" or kind = "list" or kind = "set";
let assign_nodes = select id from nodes where kind = "assign";
let assign_targets = select parent, child from "semantic-child" where field = "targets";
let assigned_targets = select l.id as statement, r.child as target from assign_nodes as l join assign_targets as r on l.id = r.parent;
let container_targets = select l.statement as statement, l.target as target from assigned_targets as l join containers as r on l.target = r.id;
let scalar_targets = antijoin(left=assigned_targets,right=container_targets,left-on=["statement","target"],right-on=["statement","target"]);
let mixed_statements = select statement from scalar_targets;
let value_fields = select parent, child from "semantic-child" where field = "value";
let container_values = select l.parent as statement from value_fields as l join containers as r on l.child = r.id;
let dynamic_assigns = antijoin(left=container_targets,right=container_values,left-on=["statement"],right-on=["statement"]);
let mixed_assigns = select l.statement as statement, l.target as target from container_targets as l join mixed_statements as r on l.statement = r.statement;
let unpacking = union(left=dynamic_assigns,right=mixed_assigns);
let unpack_roots = select target as id from unpacking;
let candidate_ids = select binding as id from named_candidates;
let unpacked = axis(from=unpack_roots,relation="semantic-child",direction=descendant,domain=candidate_ids);
let unpacked_bindings = select related as binding from unpacked;
let tuple_nodes = select id from nodes where kind = "tuple";
let optional_vars = select child from "semantic-child" where field = "optional_vars";
let with_tuples = select l.child as id from optional_vars as l join tuple_nodes as r on l.child = r.id;
let with_unpacked = axis(from=with_tuples,relation="semantic-child",direction=descendant,domain=candidate_ids);
let with_bindings = select related as binding from with_unpacked;
let excluded_unpacking = union(left=unpacked_bindings,right=with_bindings);
let report_candidates = antijoin(left=named_candidates,right=excluded_unpacking,left-on=["binding"],right-on=["binding"]);
let reportable = select id, file, span from report_candidates;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let quoted = select id from "syntax-tree" where kind = "f-string-part" or kind = "string" and matches(text, "(?i)^[rub]*(?:\x22\x22\x22|'\x27')");
let continued = select id from "syntax-tree" where kind = "whitespace" and matches(text, "\\(?:\r\n|\r|\n)");
let mapped_tokens = union(left=quoted, right=continued);
let mapping_ranges = select l.id as id, r.file as file, r."start-line" as line, r."end-line" as endline from mapped_tokens as l join "source-location" as r on l.id = r.id where r."start-line" < r."end-line";
let mapping_edges = select l.id as origin, r.id as destination from mapping_ranges as l join mapping_ranges as r on l.file = r.file where l.line <= r.endline and r.line <= l.endline and l.endline < r.endline;
let mapping_paths = closure(edges=mapping_edges, source="origin", destination="destination");
let reachable_ranges = select l.origin as id, r.endline as endline from mapping_paths as l join mapping_ranges as r on l.destination = r.id;
let initial_ranges = select id, endline from mapping_ranges;
let all_ranges = union(left=initial_ranges, right=reachable_ranges);
let earlier_endings = select l.id as id, l.endline as endline from all_ranges as l join all_ranges as r on l.id = r.id where l.endline < r.endline;
let last_ranges = antijoin(left=all_ranges, right=earlier_endings, left-on=["id", "endline"], right-on=["id", "endline"]);
let mappings = select l.id as id, l.file as file, l.line as line, r.endline as endline from mapping_ranges as l join last_ranges as r on l.id = r.id;
let mapped_candidates = select l.id as id, l.file as file, l.span as span, r.endline as line from candidate_locations as l join mappings as r on l.file = r.file where l.line >= r.line and l.line <= r.endline;
let smaller_candidates = select l.id as id, l.line as line from mapped_candidates as l join mapped_candidates as r on l.id = r.id where l.line < r.line;
let remapped_locations = antijoin(left=mapped_candidates, right=smaller_candidates, left-on=["id", "line"], right-on=["id", "line"]);
let unchanged_locations = antijoin(left=candidate_locations, right=remapped_locations, left-on=["id"], right-on=["id"]);
let located = union(left=unchanged_locations, right=remapped_locations);
let comments = select * from "comment" where matches(text, "(?i:noqa)");
let internal_markers = capture(from=comments, path="text", pattern="{*before}#{*tail}", captures=["before", "tail"]);
let leading_markers = capture(from=comments, path="text", pattern="#{*tail}", captures=["tail"]);
let later_inline_markers = select * from internal_markers where matches(before, "(?:^|#)\s*(?i:noqa)");
let first_inline_markers = antijoin(left=internal_markers, right=later_inline_markers, left-on=["id", "tail"], right-on=["id", "tail"]);
let initial_inline = select id, file, span, text as directive from comments where matches(text, "^\s*(?i:noqa)");
let internal_inline = select id, file, span, tail as directive from first_inline_markers where matches(tail, "^\s*(?i:noqa)");
let leading_inline = select id, file, span, tail as directive from leading_markers where matches(tail, "^\s*(?i:noqa)");
let inline_with_internal = union(left=initial_inline, right=internal_inline);
let all_inline = union(left=inline_with_internal, right=leading_inline);
let inline_directives = extend(from=all_inline, values={scope: 0});
let later_file_markers = select * from internal_markers where matches(before, "(?:^|#)\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let first_file_markers = antijoin(left=internal_markers, right=later_file_markers, left-on=["id", "tail"], right-on=["id", "tail"]);
let initial_file = select id, file, span, text as directive from comments where matches(text, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let internal_file = select id, file, span, tail as directive from first_file_markers where matches(tail, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let leading_file = select id, file, span, tail as directive from leading_markers where matches(tail, "^\s*(?:ruff|flake8)\s*:\s*(?i:noqa)");
let file_with_internal = union(left=initial_file, right=internal_file);
let all_file = union(left=file_with_internal, right=leading_file);
let file_parts = capture(from=all_file, path="directive", pattern="{*tool}:{*directive_text}", captures=["tool", "directive_text"]);
let normalized_file = select id, file, span, directive_text as directive from file_parts where matches(tool, "^\s*(?:ruff|flake8)\s*$");
let file_directives = extend(from=normalized_file, values={scope: 1});
let directives = union(left=inline_directives, right=file_directives);
let blanket = select id, file, span, scope from directives where matches(directive, "^\s*(?i:noqa)(?:$|#|\s+(?:$|[^:\s]))");
let code_parts = capture(from=directives, path="directive", pattern="{*prefix}:{*codes}", captures=["prefix", "codes"]);
let code_directives = select * from code_parts where matches(prefix, "^\s*(?i:noqa)\s*$");
let valid_codes = select * from code_directives where matches(codes, "^[\s,]*[A-Z]+[0-9]+(?:[A-Z]+[0-9]+|[\s,]+[A-Z]+[0-9]+)*(?:$|#.*|[\s,]+(?:$|[^\s,A-Z].*|[A-Z]+(?:$|[^A-Z0-9].*)))$");
let matching_codes = select id, file, span, scope from valid_codes where matches(codes, "^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*F841(?:$|[\s,#]|[A-Z])");
let suppressions = union(left=blanket, right=matching_codes);
let line_noqa = select id, file from suppressions where scope = 0;
let line_suppressions = select l.file as file, r."start-line" as line from line_noqa as l join "source-location" as r on l.id = r.id;
let file_noqa = select id, file from suppressions where scope = 1;
let file_suppressions = select l.file as file, r."start-line" as line from file_noqa as l join "source-location" as r on l.id = r.id;
let code_tokens = select id from "syntax-tree" where text != "" and kind != "comment" and kind != "whitespace" and kind != "newline" and kind != "nl" and kind != "indent" and kind != "dedent";
let code_token_ranges = select r.file as file, r."start-line" as line, r."end-line" as endline from code_tokens as l join "source-location" as r on l.id = r.id;
let code_lines = select l.file as file, l.line as line from file_suppressions as l join code_token_ranges as r on l.file = r.file where l.line >= r.line and l.line <= r.endline;
let standalone = antijoin(left=file_suppressions, right=code_lines, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_lines = antijoin(left=located, right=line_suppressions, left-on=["file", "line"], right-on=["file", "line"]);
let unsuppressed_files = antijoin(left=unsuppressed_lines, right=standalone, left-on=["file"], right-on=["file"]);
let supp_range_comments = select id, file, span, text as directive from "comment" where matches(text, "^\s*ruff\s*:");
let supp_range_tools = capture(from=supp_range_comments, path="directive", pattern="{*tool}:{*contents}", captures=["tool", "contents"]);
let supp_range_tool = select * from supp_range_tools where matches(tool, "^\s*ruff\s*$");
let supp_range_with_reason = capture(from=supp_range_tool, path="contents", pattern="{*action}[{*codes}]{*reason}", captures=["action", "codes", "reason"]);
let supp_range_without_reason = capture(from=supp_range_tool, path="contents", pattern="{*action}[{*codes}]", captures=["action", "codes"]);
let supp_range_reason_parts = select id, file, span, action, codes from supp_range_with_reason;
let supp_range_plain_parts = select id, file, span, action, codes from supp_range_without_reason;
let supp_range_parts = union(left=supp_range_reason_parts, right=supp_range_plain_parts);
let supp_range_valid = select * from supp_range_parts where matches(action, "^\s*(?:disable|enable|ignore|file-ignore)\s*$") and matches(codes, "^\s*\p{Alphabetic}[\p{Alphabetic}\p{Number}_:-]*(?:\s*,\s*\p{Alphabetic}[\p{Alphabetic}\p{Number}_:-]*)*\s*,?\s*$");
let supp_range_compact = replace(from=supp_range_valid, text="codes", pattern="\s+", replacement="", output="compact");
let supp_range_normalized = replace(from=supp_range_compact, text="compact", pattern=",$", replacement="", output="normalized");
let supp_range_actions = replace(from=supp_range_normalized, text="action", pattern="\s+", replacement="", output="mode");
let supp_range_selected = select * from supp_range_actions where matches(normalized, "(?:^|,)(?:F841)(?:,|$)");
let supp_range_positions = select l.id as id, l.file as file, l.mode as mode, l.normalized as normalized, r."start-byte" as begin, r."end-byte" as finish, r."start-line" as line, r."start-column" as column from supp_range_selected as l join "source-location" as r on l.id = r.id;
let supp_all_source_tokens = select id, kind, text, file from "syntax-tree" where text != "" or kind = "dedent";
let supp_source_tokens = select l.id as id, l.kind as kind, l.text as text, l.file as file, r."start-byte" as begin, r."end-byte" as finish, r."start-line" as line, r."end-line" as endline from supp_all_source_tokens as l join "source-location" as r on l.id = r.id;
let supp_significant = select * from supp_source_tokens where kind != "comment" and kind != "whitespace" and kind != "nl";
let supp_code_ranges = select * from supp_source_tokens where kind != "comment" and kind != "whitespace" and kind != "nl" and kind != "newline" and kind != "indent" and kind != "dedent";
let supp_trailing_directives = select l.id as id from supp_range_positions as l join supp_code_ranges as r on l.file = r.file where l.line >= r.line and l.line <= r.endline;
let supp_ownline_directives = antijoin(left=supp_range_positions, right=supp_trailing_directives, left-on=["id"], right-on=["id"]);
let supp_prefix_tokens = select * from supp_source_tokens where kind = "whitespace";
let supp_prefixed_directives = select l.id as id, r.text as prefix from supp_ownline_directives as l join supp_prefix_tokens as r on l.file = r.file and l.begin = r.finish where l.column > 0;
let supp_raw_prefixes = replace(from=supp_prefixed_directives, text="prefix", pattern="(?s)^.*[\r\n]", replacement="", output="indentation");
let supp_nonempty_prefixes = select id, indentation from supp_raw_prefixes where matches(indentation, "^[ \t\x0c]*$");
let supp_zero_prefixes = select id from supp_ownline_directives where column = 0;
let supp_empty_prefixes = extend(from=supp_zero_prefixes, values={indentation: ""});
let supp_prefixes = union(left=supp_nonempty_prefixes, right=supp_empty_prefixes);
let supp_indented_directives = select l.id as id, l.file as file, l.mode as mode, l.normalized as normalized, l.begin as begin, l.finish as finish, l.column as column, r.indentation as indentation from supp_ownline_directives as l join supp_prefixes as r on l.id = r.id;
let supp_next_candidates = select l.id as directive, r.id as token, r.kind as kind, r.begin as begin from supp_range_positions as l join supp_significant as r on l.file = r.file where r.begin >= l.finish;
let supp_later_next = select l.directive as directive, l.token as token from supp_next_candidates as l join supp_next_candidates as r on l.directive = r.directive where l.begin > r.begin;
let supp_next_tokens = antijoin(left=supp_next_candidates, right=supp_later_next, left-on=["directive", "token"], right-on=["directive", "token"]);
let supp_next_boundaries = select directive from supp_next_tokens where kind = "indent" or kind = "dedent";
let supp_regions = select id, parent, file, indentation, "start-byte" as begin, "end-byte" as finish from "indent-region";
let supp_nested_regions = select * from supp_regions where id != parent;
let supp_nested_widths = select l.id as id, r."end-column" as width from supp_nested_regions as l join "source-location" as r on l.id = r.id;
let supp_root_regions = select id from supp_regions where id = parent;
let supp_root_widths = extend(from=supp_root_regions, values={width: 0});
let supp_region_widths = union(left=supp_nested_widths, right=supp_root_widths);
let supp_containing_regions = select l.id as directive, r.id as region, r.begin as begin from supp_indented_directives as l join supp_regions as r on l.file = r.file where l.begin >= r.begin and l.begin < r.finish;
let supp_outer_regions = select l.directive as directive, l.region as region from supp_containing_regions as l join supp_containing_regions as r on l.directive = r.directive where l.begin < r.begin;
let supp_current_regions = antijoin(left=supp_containing_regions, right=supp_outer_regions, left-on=["directive", "region"], right-on=["directive", "region"]);
let supp_current_indentation = select l.directive as directive, r.indentation as indentation from supp_current_regions as l join supp_regions as r on l.region = r.id;
let supp_aligned_directives = select l.id as directive from supp_indented_directives as l join supp_current_indentation as r on l.id = r.directive and l.indentation = r.indentation;
let supp_valid_blocks = union(left=supp_aligned_directives, right=supp_next_boundaries);
let supp_valid_block_directives = select l.id as id, l.file as file, l.mode as mode, l.normalized as normalized, l.begin as begin, l.finish as finish, l.column as column, l.indentation as indentation from supp_indented_directives as l join supp_valid_blocks as r on l.id = r.directive where l.mode = "disable" or l.mode = "enable";
let supp_region_events = select l.id as id, l.file as file, l.begin as begin, l.finish as finish, r.width as width from supp_regions as l join supp_region_widths as r on l.id = r.id;
let supp_eligible_regions = select l.id as directive, r.id as region, r.begin as begin, r.finish as finish from supp_valid_block_directives as l join supp_region_events as r on l.file = r.file where l.column >= r.width and r.finish >= l.finish;
let supp_later_regions = select l.directive as directive, l.region as region from supp_eligible_regions as l join supp_eligible_regions as r on l.directive = r.directive where l.finish > r.finish or l.finish = r.finish and l.begin < r.begin;
let supp_governing_regions = antijoin(left=supp_eligible_regions, right=supp_later_regions, left-on=["directive", "region"], right-on=["directive", "region"]);
let supp_scoped_directives = select l.id as id, l.file as file, l.mode as mode, l.normalized as normalized, l.indentation as indentation, l.begin as begin, l.finish as finish, r.region as region from supp_valid_block_directives as l join supp_governing_regions as r on l.id = r.directive;
let supp_disables = select * from supp_scoped_directives where mode = "disable";
let supp_enables = select * from supp_scoped_directives where mode = "enable";
let supp_paired_blocks = ordered-match(left=supp_disables, right=supp_enables, left-on=[file,region,indentation,normalized], right-on=[file,region,indentation,normalized], left-order="begin", right-order="begin", output={id:[left,id],file:[left,file],begin:[left,begin],finish:[right,finish]});
let supp_unmatched_disables = antijoin(left=supp_disables, right=supp_paired_blocks, left-on=["id"], right-on=["id"]);
let supp_implicit_blocks = select l.id as id, l.file as file, l.begin as begin, r.finish as finish from supp_unmatched_disables as l join supp_regions as r on l.region = r.id;
let supp_block_ranges = union(left=supp_paired_blocks, right=supp_implicit_blocks);
let supp_file_ignores = select file from supp_indented_directives where mode = "file-ignore" and indentation = "";
let supp_original_locations = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from candidate_locations as l join "source-location" as r on l.id = r.id;
let supp_block_hidden = select l.id as id from supp_original_locations as l join supp_block_ranges as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let supp_file_hidden = select l.id as id from supp_original_locations as l join supp_file_ignores as r on l.file = r.file;
let supp_ignore_directives = select id, file, begin, finish from supp_range_positions where mode = "ignore";
let supp_ownline_ignores = select id, file, begin, finish from supp_ownline_directives where mode = "ignore";
let supp_ordinary_trailing_ignores = antijoin(left=supp_ignore_directives, right=supp_ownline_ignores, left-on=["id"], right-on=["id"]);
let supp_nested_ignore_comments = capture(from="comment", path="text", pattern="{*before}#{*tail}", captures=["before", "tail"]);
let supp_nested_ignore_heads = select id, file, tail as directive from supp_nested_ignore_comments where matches(tail, "^\s*ruff\s*:\s*ignore\s*\[");
let supp_nested_ignore_tools = capture(from=supp_nested_ignore_heads, path="directive", pattern="{*tool}:{*contents}", captures=["tool", "contents"]);
let supp_nested_ignore_reason = capture(from=supp_nested_ignore_tools, path="contents", pattern="{*action}[{*codes}]{*reason}", captures=["action", "codes", "reason"]);
let supp_nested_ignore_plain = capture(from=supp_nested_ignore_tools, path="contents", pattern="{*action}[{*codes}]", captures=["action", "codes"]);
let supp_nested_reason_codes = select id, file, tool, action, codes from supp_nested_ignore_reason;
let supp_nested_plain_codes = select id, file, tool, action, codes from supp_nested_ignore_plain;
let supp_nested_ignore_parts = union(left=supp_nested_reason_codes, right=supp_nested_plain_codes);
let supp_nested_ignore_valid = select * from supp_nested_ignore_parts where matches(tool, "^\s*ruff\s*$") and matches(action, "^\s*ignore\s*$") and matches(codes, "^\s*\p{Alphabetic}[\p{Alphabetic}\p{Number}_:-]*(?:\s*,\s*\p{Alphabetic}[\p{Alphabetic}\p{Number}_:-]*)*\s*,?\s*$");
let supp_nested_ignore_compact = replace(from=supp_nested_ignore_valid, text="codes", pattern="\s+", replacement="", output="compact");
let supp_nested_ignore_selected = select id, file from supp_nested_ignore_compact where matches(compact, "(?:^|,)(?:F841)(?:,|$)");
let supp_nested_trailing_ignores = select l.id as id, l.file as file, r."start-byte" as begin, r."end-byte" as finish from supp_nested_ignore_selected as l join "source-location" as r on l.id = r.id;
let supp_trailing_ignores = union(left=supp_ordinary_trailing_ignores, right=supp_nested_trailing_ignores);
let supp_prior_significant = select l.id as directive, r.id as token, r.kind as kind, r.finish as finish from supp_ownline_ignores as l join supp_significant as r on l.file = r.file where r.finish <= l.begin;
let supp_earlier_significant = select l.directive as directive, l.token as token from supp_prior_significant as l join supp_prior_significant as r on l.directive = r.directive where l.finish < r.finish;
let supp_nearest_significant = antijoin(left=supp_prior_significant, right=supp_earlier_significant, left-on=["directive", "token"], right-on=["directive", "token"]);
let supp_inner_comments = select directive from supp_nearest_significant where kind != "newline";
let supp_inner_ignores = select l.id as id, l.file as file, l.begin as begin, l.finish as finish from supp_ownline_ignores as l join supp_inner_comments as r on l.id = r.directive;
let supp_outer_ignores = antijoin(left=supp_ownline_ignores, right=supp_inner_comments, left-on=["id"], right-on=["directive"]);
let supp_logical_newlines = select * from supp_source_tokens where kind = "newline";
let supp_physical_newlines = select * from supp_source_tokens where kind = "newline" or kind = "nl";
let supp_logical_endings = select l.id as id, l.file as file, l.begin as begin, r.begin as finish from supp_outer_ignores as l join supp_logical_newlines as r on l.file = r.file where r.begin >= l.finish;
let supp_later_logical_endings = select l.id as id, l.finish as finish from supp_logical_endings as l join supp_logical_endings as r on l.id = r.id where l.finish > r.finish;
let supp_logical_ignores = antijoin(left=supp_logical_endings, right=supp_later_logical_endings, left-on=["id", "finish"], right-on=["id", "finish"]);
let supp_unterminated_outer = antijoin(left=supp_outer_ignores, right=supp_logical_ignores, left-on=["id"], right-on=["id"]);
let supp_source_roots = select file, finish from supp_regions where id = parent;
let supp_outer_eof = select l.id as id, l.file as file, l.begin as begin, r.finish as finish from supp_unterminated_outer as l join supp_source_roots as r on l.file = r.file;
let supp_outer_ranges = union(left=supp_logical_ignores, right=supp_outer_eof);
let supp_following_code = select l.id as directive, l.file as file, l.begin as begin, r.id as token, r.begin as token_begin, r.finish as token_finish from supp_inner_ignores as l join supp_code_ranges as r on l.file = r.file where r.begin >= l.finish;
let supp_later_code = select l.directive as directive, l.token as token from supp_following_code as l join supp_following_code as r on l.directive = r.directive where l.token_begin > r.token_begin;
let supp_next_code = antijoin(left=supp_following_code, right=supp_later_code, left-on=["directive", "token"], right-on=["directive", "token"]);
let supp_physical_endings = select l.directive as id, l.file as file, l.begin as begin, r.begin as finish from supp_next_code as l join supp_physical_newlines as r on l.file = r.file where r.begin >= l.token_finish;
let supp_later_physical_endings = select l.id as id, l.finish as finish from supp_physical_endings as l join supp_physical_endings as r on l.id = r.id where l.finish > r.finish;
let supp_physical_ignores = antijoin(left=supp_physical_endings, right=supp_later_physical_endings, left-on=["id", "finish"], right-on=["id", "finish"]);
let supp_unterminated_inner = antijoin(left=supp_inner_ignores, right=supp_physical_ignores, left-on=["id"], right-on=["id"]);
let supp_inner_eof = select l.id as id, l.file as file, l.begin as begin, r.finish as finish from supp_unterminated_inner as l join supp_source_roots as r on l.file = r.file;
let supp_inner_ranges = union(left=supp_physical_ignores, right=supp_inner_eof);
let supp_preceding_newlines = select l.id as id, l.file as file, r.finish as begin, l.finish as finish from supp_trailing_ignores as l join supp_physical_newlines as r on l.file = r.file where r.finish <= l.begin;
let supp_earlier_newlines = select l.id as id, l.begin as begin from supp_preceding_newlines as l join supp_preceding_newlines as r on l.id = r.id where l.begin < r.begin;
let supp_trailing_ranges = antijoin(left=supp_preceding_newlines, right=supp_earlier_newlines, left-on=["id", "begin"], right-on=["id", "begin"]);
let supp_first_line_ignores = antijoin(left=supp_trailing_ignores, right=supp_trailing_ranges, left-on=["id"], right-on=["id"]);
let supp_first_line_ends = select id, file, finish from supp_first_line_ignores;
let supp_first_line_ranges = extend(from=supp_first_line_ends, values={begin: 0});
let supp_all_trailing_ranges = union(left=supp_trailing_ranges, right=supp_first_line_ranges);
let supp_ownline_ranges = union(left=supp_outer_ranges, right=supp_inner_ranges);
let supp_ignore_ranges = union(left=supp_ownline_ranges, right=supp_all_trailing_ranges);
let supp_ignore_hidden = select l.id as id from supp_original_locations as l join supp_ignore_ranges as r on l.file = r.file where l.begin >= r.begin and l.begin < r.finish;
let supp_block_or_file_hidden = union(left=supp_block_hidden, right=supp_file_hidden);
let supp_range_hidden = union(left=supp_block_or_file_hidden, right=supp_ignore_hidden);
let supp_after_ranges = antijoin(left=unsuppressed_files, right=supp_range_hidden, left-on=["id"], right-on=["id"]);
let violations = select id, file, span from supp_after_ranges;
emit violations subject file key(id);
