import suppress from "python/ruff/suppress";
let comparisons = select id, file, span from "semantic-syntax" where kind = "compare" and glob_any(file, "**/*.pyi");
let left_edges = select parent, child from "semantic-child" where field = "left";
let version = select id, file from "qualified-name" where path = "sys.version_info";
let subscript_bases = select parent as subscript, child as base from "semantic-child" where field = "value";
let version_subscripts = select l.subscript as subscript, r.file as file from subscript_bases as l join version as r on l.base = r.id;
let version_ids = select id, file from version;
let subscripts_as_ids = select subscript as id, file from version_subscripts;
let version_lefts = union(left=version_ids, right=subscripts_as_ids);
let version_left_edges = select l.parent as comparison, l.child as left, r.file as file from left_edges as l join version_lefts as r on l.child = r.id;
let version_comparisons = select l.comparison as comparison, l.file as file from version_left_edges as l join comparisons as c on l.comparison = c.id and l.file = c.file;
let comparator_edges = select parent, child from "semantic-child" where field = "comparators";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_comparator_edges = select l.parent as comparison, l.child as tuple, r.file as file from comparator_edges as l join tuples as r on l.child = r.id;
let tuple_comparators = select l.comparison as comparison, l.tuple as tuple, l.file as file from tuple_comparator_edges as l join version_comparisons as c on l.comparison = c.comparison and l.file = c.file;
let elements = select parent, child from "semantic-child" where field = "elts";
let tuple_elements = select l.parent as tuple, l.child as element, r.file as file from elements as l join tuple_comparators as r on l.parent = r.tuple;
let integer_elements = select id, file from "literal-properties" where kind = "integer";
let invalid_elements = antijoin(left=tuple_elements, right=integer_elements, left-on=["element", "file"], right-on=["id", "file"]);
let invalid_tuple_ids = select tuple as id, file from invalid_elements;
let all_integer_tuple_comparators = antijoin(left=tuple_comparators, right=invalid_tuple_ids, left-on=["tuple", "file"], right-on=["id", "file"]);
let counts = group-count(from=tuple_elements, keys=["tuple", "file"], count="count", distinct="element");
let long_tuples = select l.tuple as tuple, l.file as file from counts as l where count > 2;
let long_comparisons = select l.comparison as id, l.file as file from all_integer_tuple_comparators as l join long_tuples as t on l.tuple = t.tuple and l.file = t.file;
let reportable = select l.id as id, r.file as file, r.span as span from long_comparisons as l join comparisons as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\\s,]*(?:[A-Z]+[0-9]+[\\s,]*)*PYI004(?:$|[\\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PYI004)(?:,|$)");
emit violations subject file key(id);
