import suppress from "python/ruff/suppress";
let imports = select occurrence as id, target, file, span from "static-import" where target = "typing.ByteString" or target = "collections.abc.ByteString";
let attributes = select id, path, file, span from "qualified-name" where path = "typing.ByteString" or path = "collections.abc.ByteString";
let attribute_rows = select id, file, span from attributes;
let import_rows = select id, file, span from imports;
let locations = union(left=import_rows, right=attribute_rows);
let with_line = select l.id as id, l.file as file, l.span as span, r."start-line" as line from locations as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=with_line, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PYI057(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)PYI057(?:,|$)");
emit violations subject file key(id);
