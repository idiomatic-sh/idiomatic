import suppress from "python/ruff/suppress";
let calls = select id, file, span from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let copy_functions = select id, file from "qualified-name" where path = "copy.copy";
let environ_nodes = select id, file from "qualified-name" where path = "os.environ";
let copy_calls = select l.call as call, l.file as file from call_functions as l join copy_functions as r on l.function = r.id and l.file = r.file;
let argument_nodes = select id from "semantic-syntax" where kind = "call-arguments";
let wrappers = select l.parent as call, r.id as wrapper, l.file as file from "semantic-child" as l join argument_nodes as r on l.child = r.id;
let positional_fields = select parent, child from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, l.file as file from wrappers as l join positional_fields as r on l.wrapper = r.parent;
let keyword_fields = select parent, child from "semantic-child" where field = "keywords";
let keyword_edges = select l.call as call, r.child as keyword, l.file as file from wrappers as l join keyword_fields as r on l.wrapper = r.parent;
let keyword_nodes = select id from "semantic-syntax" where kind = "keyword";
let calls_with_keywords = select l.call as call, l.file as file from keyword_edges as l join keyword_nodes as r on l.keyword = r.id;
let no_keyword_calls = antijoin(left=copy_calls,right=calls_with_keywords,left-on=["call","file"],right-on=["call","file"]);
let argument_counts = group-count(from=positional_arguments,keys=["call","file"],count="count",distinct="value");
let one_argument_calls = select call, file from argument_counts where count = 1;
let eligible_calls = select l.call as call, l.file as file from no_keyword_calls as l join one_argument_calls as r on l.call = r.call and l.file = r.file;
let environ_arguments = select l.call as call, l.file as file from positional_arguments as l join environ_nodes as r on l.value = r.id and l.file = r.file;
let candidates_rows = select l.call as call, l.file as file from eligible_calls as l join environ_arguments as r on l.call = r.call and l.file = r.file;
let candidates = select l.call as id, r.file as file, r.span as span from candidates_rows as l join calls as r on l.call = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from candidates as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW1507(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW1507)(?:,|$)");
emit violations subject file key(id);
