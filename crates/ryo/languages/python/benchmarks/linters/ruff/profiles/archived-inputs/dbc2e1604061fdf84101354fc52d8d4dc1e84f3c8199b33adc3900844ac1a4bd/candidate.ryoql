import suppress from "python/ruff/suppress";
let comparisons = select id, file from "semantic-syntax" where kind = "compare";
let left_fields = select parent, child from "semantic-child" where field = "left";
let comparator_fields = select parent, child from "semantic-child" where field = "comparators";
let comparison_lefts = select l.parent as comparison, l.child as operand, r.file as file from left_fields as l join comparisons as r on l.parent = r.id;
let comparison_comparators = select l.parent as comparison, l.child as operand, r.file as file from comparator_fields as l join comparisons as r on l.parent = r.id;
let comparison_operands = union(left=comparison_lefts, right=comparison_comparators);
let match_value_nodes = select id, file from "semantic-syntax" where kind = "match-value";
let match_value_fields = select parent, child from "semantic-child" where field = "value";
let match_pattern_operands = select l.id as comparison, r.child as operand, l.file as file from match_value_nodes as l join match_value_fields as r on l.id = r.parent;
let operands = union(left=comparison_operands, right=match_pattern_operands);
let nan_qualified_names = select id, file from "qualified-name" where path = "math.nan" or path = "numpy.nan" or path = "numpy.NAN" or path = "numpy.NaN";
let qualified_nan_operands = select l.operand as id, l.file as file from operands as l join nan_qualified_names as r on l.operand = r.id and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let float_functions = select id, file from "qualified-name" where path = "builtins.float" and (provenance = "builtin" or provenance = "import");
let float_calls = select l.call as call, l.file as file from call_functions as l join float_functions as r on l.function = r.id and l.file = r.file;
let arguments = select id from "semantic-syntax" where kind = "call-arguments";
let argument_owners = select l.parent as call, l.child as arguments, l.file as file from "semantic-child" as l join arguments as r on l.child = r.id;
let positional_fields = select parent, child, ordinal from "semantic-child" where field = "args";
let positional_arguments = select l.call as call, r.child as value, l.file as file, r.ordinal as ordinal from argument_owners as l join positional_fields as r on l.arguments = r.parent;
let later_argument_pairs = select l.call as call, l.value as value, l.file as file from positional_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where l.ordinal < r.ordinal;
let first_arguments = antijoin(left=positional_arguments, right=later_argument_pairs, left-on=["call", "value", "file"], right-on=["call", "value", "file"]);
let first_counts = group-count(from=first_arguments, keys=["call"], count="count", distinct="value");
let single_argument_calls = select call from first_counts where count = 1;
let keyword_fields = select parent from "semantic-child" where field = "keywords";
let keyword_calls = select l.call as call from argument_owners as l join keyword_fields as r on l.arguments = r.parent;
let calls_without_keywords = antijoin(left=float_calls, right=keyword_calls, left-on=["call"], right-on=["call"]);
let one_argument_float_calls = select l.call as call, l.file as file from calls_without_keywords as l join single_argument_calls as r on l.call = r.call;
let nan_strings = select occurrence as id, file from "string-literal" where matches(value, "(?i)^\s*[+-]?nan\s*$");
let one_argument_values = select l.call as call, l.file as file, r.value as value from one_argument_float_calls as l join first_arguments as r on l.call = r.call and l.file = r.file;
let nan_string_arguments = select l.call as call, l.file as file from one_argument_values as l join nan_strings as r on l.value = r.id and l.file = r.file;
let float_nan_operands = select l.call as id, l.file as file from nan_string_arguments as l;
let all_nan_operands = union(left=qualified_nan_operands, right=float_nan_operands);
let nan_node_locations = select l.id as id, l.file as file, r.span as span from all_nan_operands as l join "semantic-syntax" as r on l.id = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from nan_node_locations as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW0177(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW0177)(?:,|$)");
emit violations subject file key(id);
