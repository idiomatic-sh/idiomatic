import suppress from "python/ruff/suppress";
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let value_fields = select parent, child from "semantic-child" where field = "value";
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let attribute_bases = select l.parent as attribute, r.id as base, r.file as file from value_fields as l join name_nodes as r on l.child = r.id;
let super_names = select id, file, span from "qualified-name" where path = "builtins.super";
let super_base_attributes = select l.attribute as attribute, l.base as base, l.file as file, r.span as span from attribute_bases as l join super_names as r on l.base = r.id and l.file = r.file;
let calls = select id, file from "semantic-syntax" where kind = "call";
let function_fields = select parent, child from "semantic-child" where field = "func";
let call_functions = select l.parent as call, l.child as function, r.file as file from function_fields as l join calls as r on l.parent = r.id;
let called_attributes = select l.call as call, l.function as attribute, l.file as file from call_functions as l join attributes as r on l.function = r.id and l.file = r.file;
let super_attribute_calls = select l.attribute as attribute, l.base as base, l.file as file, l.span as span from super_base_attributes as l join called_attributes as r on l.attribute = r.attribute and l.file = r.file;
let function_nodes = select id, file from "semantic-syntax" where kind = "function-def" or kind = "async-function-def";
let super_call_bases = select base as id, file from super_attribute_calls;
let nearest_function = axis(from=super_call_bases, relation="semantic-child", direction=nearest-ancestor, domain=function_nodes);
let function_contexts = select l.base as base, l.file as file, r.related as function from super_attribute_calls as l join nearest_function as r on l.base = r.id and l.file = r.file;
let scope_edges = select child, parent from "scope";
let class_nodes = select id, file from "semantic-syntax" where kind = "class-def";
let method_functions = select l.child as function, r.file as file from scope_edges as l join class_nodes as r on l.parent = r.id;
let new_name_fields = select parent, child from "semantic-child" where field = "name";
let function_name_edges = select l.id as function, r.child as name, l.file as file from function_nodes as l join new_name_fields as r on l.id = r.parent;
let named_functions = select l.function as function, r.name as name, l.file as file from function_name_edges as l join "identifier" as r on l.name = r.id;
let new_functions = select function, file from named_functions where name = "__new__";
let ordinary_method_functions = antijoin(left=method_functions,right=new_functions,left-on=["function","file"],right-on=["function","file"]);
let eligible_method_contexts = select l.base as base, l.file as file from function_contexts as l join ordinary_method_functions as r on l.function = r.function and l.file = r.file;
let reportable = select l.base as id, l.file as file, r.span as span from eligible_method_contexts as l join super_names as r on l.base = r.id and l.file = r.file;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id and l.file = r.file;
let violations = suppress(candidates=candidate_locations, inline-pattern="(?:^|[^A-Z0-9])PLW0245(?:$|[^A-Z0-9])", range-pattern="(?:^|,)(?:PLW0245)(?:,|$)");
emit violations subject file key(id);
