import lookup_symbol_events from "python/ruff/lookup-symbol-events";
input symbol_contexts: relation<context: node, initial_scope: node, point: number, header_point: number, stage: number, file: file>;
input expressions: relation<id: node, file: file>;
output relation<context: node, expression: node, path: symbol, file: file>;
let names = select id, file from "semantic-syntax" where kind = "name";
let name_expressions = select l.id as expression, l.id as root, l.file as file from expressions as l join names as r on l.id = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_expressions = select l.id as expression, l.file as file from expressions as l join attributes as r on l.id = r.id and l.file = r.file;
let attribute_values = select l.expression as expression, r.child as root, l.file as file from attribute_expressions as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "value";
let simple_attributes = select l.expression as expression, l.root as root, l.file as file from attribute_values as l join names as r on l.root = r.id and l.file = r.file;
let expression_roots = union(left=name_expressions, right=simple_attributes);
let roots = select root as id, file from expression_roots;
let root_events = lookup_symbol_events(ordered_contexts=symbol_contexts, expressions=roots);
let bound_root_events = select context, expression, occurrence, file from root_events where kind = "bind";
let import_events = select l.context as context, l.expression as expression, l.occurrence as definition, r.target as target, l.file as file from bound_root_events as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file;
let import_definitions = select id, refinement, file from "defines" where kind = "import";
let asnames = select parent as definition, file from "semantic-child" where field = "asname";
let raw_module_imports = select l.context as context, l.expression as expression, l.definition as definition, l.target as target, l.file as file from import_events as l join import_definitions as r on l.definition = r.id and l.file = r.file where r.refinement = "import";
let unaliased_modules = antijoin(left=raw_module_imports, right=asnames, left-on=["definition", "file"], right-on=["definition", "file"]);
let deep_modules = select context, expression, definition, target, file from unaliased_modules where starts_with(target, "abc.") or starts_with(target, "enum.") or starts_with(target, "builtins.") or starts_with(target, "typing.") or starts_with(target, "typing_extensions.");
let direct_imports = antijoin(left=import_events, right=deep_modules, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "definition", "file"]);
let known_direct_imports = select context, expression, target as path, file from direct_imports where target = "builtins.type" or target = "abc.ABCMeta" or target = "enum.EnumMeta" or target = "enum.EnumType" or target = "builtins.str" or target = "builtins.tuple" or target = "builtins.dict" or target = "builtins.StopIteration" or target = "typing.Protocol" or target = "typing_extensions.Protocol";
let bare_import_origins = select r.context as context, l.expression as expression, r.path as path, l.file as file from name_expressions as l join known_direct_imports as r on l.root = r.expression and l.file = r.file;
let named_builtin_roots = select l.expression as expression, r.name as name, l.file as file from name_expressions as l join "identifier" as r on l.expression = r.id and l.file = r.file where r.name = "type" or r.name = "str" or r.name = "tuple" or r.name = "dict" or r.name = "StopIteration";
let contextual_builtin_roots = select l.context as context, r.expression as expression, r.name as name, l.file as file from symbol_contexts as l join named_builtin_roots as r on l.file = r.file where l.stage = 0 or l.context = r.expression;
let unbound_builtin_roots = antijoin(left=contextual_builtin_roots, right=root_events, left-on=["context", "expression", "file"], right-on=["context", "expression", "file"]);
let raw_type_builtins = select context, expression, file from unbound_builtin_roots where name = "type";
let raw_str_builtins = select context, expression, file from unbound_builtin_roots where name = "str";
let raw_tuple_builtins = select context, expression, file from unbound_builtin_roots where name = "tuple";
let raw_dict_builtins = select context, expression, file from unbound_builtin_roots where name = "dict";
let type_builtins = extend(from=raw_type_builtins, values={path: "builtins.type"});
let str_builtins = extend(from=raw_str_builtins, values={path: "builtins.str"});
let tuple_builtins = extend(from=raw_tuple_builtins, values={path: "builtins.tuple"});
let dict_builtins = extend(from=raw_dict_builtins, values={path: "builtins.dict"});
let builtin_origins0 = union(left=type_builtins, right=str_builtins);
let builtin_origins1 = union(left=tuple_builtins, right=dict_builtins);
let standard_builtin_origins = union(left=builtin_origins0, right=builtin_origins1);
let raw_stop_iteration_builtins = select context, expression, file from unbound_builtin_roots where name = "StopIteration";
let stop_iteration_builtins = extend(from=raw_stop_iteration_builtins, values={path: "builtins.StopIteration"});
let builtin_origins = union(left=standard_builtin_origins, right=stop_iteration_builtins);
let enum_modules0 = select context, expression, file from import_events where target = "enum";
let enum_modules1 = select context, expression, file from deep_modules where starts_with(target, "enum.");
let enum_modules = union(left=enum_modules0, right=enum_modules1);
let abc_modules0 = select context, expression, file from import_events where target = "abc";
let abc_modules1 = select context, expression, file from deep_modules where starts_with(target, "abc.");
let abc_modules = union(left=abc_modules0, right=abc_modules1);
let builtin_modules0 = select context, expression, file from import_events where target = "builtins";
let builtin_modules1 = select context, expression, file from deep_modules where starts_with(target, "builtins.");
let builtin_modules = union(left=builtin_modules0, right=builtin_modules1);
let labels0 = select l.expression as expression, l.root as root, r.child as label, l.file as file from simple_attributes as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "attr";
let labels = select l.expression as expression, l.root as root, r.name as name, l.file as file from labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let enum_attributes = select r.context as context, l.expression as expression, l.name as name, l.file as file from labels as l join enum_modules as r on l.root = r.expression and l.file = r.file;
let enum_meta0 = select context, expression, file from enum_attributes where name = "EnumMeta";
let enum_type0 = select context, expression, file from enum_attributes where name = "EnumType";
let enum_meta = extend(from=enum_meta0, values={path: "enum.EnumMeta"});
let enum_type = extend(from=enum_type0, values={path: "enum.EnumType"});
let abc_attributes = select r.context as context, l.expression as expression, l.file as file from labels as l join abc_modules as r on l.root = r.expression and l.file = r.file where l.name = "ABCMeta";
let abc_meta = extend(from=abc_attributes, values={path: "abc.ABCMeta"});
let builtin_attributes = select r.context as context, l.expression as expression, l.name as name, l.file as file from labels as l join builtin_modules as r on l.root = r.expression and l.file = r.file;
let qualified_type0 = select context, expression, file from builtin_attributes where name = "type";
let qualified_str0 = select context, expression, file from builtin_attributes where name = "str";
let qualified_tuple0 = select context, expression, file from builtin_attributes where name = "tuple";
let qualified_dict0 = select context, expression, file from builtin_attributes where name = "dict";
let qualified_type = extend(from=qualified_type0, values={path: "builtins.type"});
let qualified_str = extend(from=qualified_str0, values={path: "builtins.str"});
let qualified_tuple = extend(from=qualified_tuple0, values={path: "builtins.tuple"});
let qualified_dict = extend(from=qualified_dict0, values={path: "builtins.dict"});
let qualified_builtin0 = union(left=qualified_type, right=qualified_str);
let qualified_builtin1 = union(left=qualified_tuple, right=qualified_dict);
let standard_qualified_builtins = union(left=qualified_builtin0, right=qualified_builtin1);
let qualified_stop_iteration0 = select context, expression, file from builtin_attributes where name = "StopIteration";
let qualified_stop_iteration = extend(from=qualified_stop_iteration0, values={path: "builtins.StopIteration"});
let qualified_builtins = union(left=standard_qualified_builtins, right=qualified_stop_iteration);
let qualified_enum = union(left=enum_meta, right=enum_type);
let qualified_origins0 = union(left=qualified_enum, right=abc_meta);
let ordinary_qualified_origins = union(left=qualified_origins0, right=qualified_builtins);
let typing_modules0 = select context, expression, file from import_events where target = "typing";
let typing_modules1 = select context, expression, file from deep_modules where starts_with(target, "typing.");
let typing_modules = union(left=typing_modules0, right=typing_modules1);
let extension_modules0 = select context, expression, file from import_events where target = "typing_extensions";
let extension_modules1 = select context, expression, file from deep_modules where starts_with(target, "typing_extensions.");
let extension_modules = union(left=extension_modules0, right=extension_modules1);
let typing_protocol0 = select r.context as context, l.expression as expression, l.file as file from labels as l join typing_modules as r on l.root = r.expression and l.file = r.file where l.name = "Protocol";
let extension_protocol0 = select r.context as context, l.expression as expression, l.file as file from labels as l join extension_modules as r on l.root = r.expression and l.file = r.file where l.name = "Protocol";
let typing_protocol = extend(from=typing_protocol0, values={path: "typing.Protocol"});
let extension_protocol = extend(from=extension_protocol0, values={path: "typing_extensions.Protocol"});
let qualified_protocols = union(left=typing_protocol, right=extension_protocol);
let qualified_origins = union(left=ordinary_qualified_origins, right=qualified_protocols);
let origins0 = union(left=bare_import_origins, right=builtin_origins);
let origins = union(left=origins0, right=qualified_origins);
return origins;
