import lookup_attribute from "python/ruff/lookup-attribute";
import class_bases from "python/ruff/class-bases";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, file: file>;
output relation<context: node, enum_class: node, file: file>;
let bases = select declaration as class, occurrence as base, file from "inherits";
let subscript_nodes = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_bases = select l.class as class, l.base as base, l.file as file from bases as l join subscript_nodes as r on l.base = r.id and l.file = r.file;
let ordinary_bases = antijoin(left=bases, right=subscript_nodes, left-on=["base", "file"], right-on=["id", "file"]);
let unwrapped_bases = select l.class as class, r.child as base, l.file as file from subscript_bases as l join "semantic-child" as r on l.base = r.parent and l.file = r.file where r.field = "value";
let mapped_bases = union(left=ordinary_bases, right=unwrapped_bases);
let names = select id, file from "semantic-syntax" where kind = "name";
let bare_names = select l.class as class, l.base as expression, l.file as file from mapped_bases as l join names as r on l.base = r.id and l.file = r.file;
let attributes = select id, file from "semantic-syntax" where kind = "attribute";
let attribute_bases = select l.class as class, l.base as expression, l.file as file from mapped_bases as l join attributes as r on l.base = r.id and l.file = r.file;
let attribute_values = select l.class as class, l.expression as expression, r.child as root, l.file as file from attribute_bases as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "value";
let simple_attribute_roots = select l.class as class, l.expression as expression, l.root as root, l.file as file from attribute_values as l join names as r on l.root = r.id and l.file = r.file;
let bare_expression_roots = select expression as id, file from bare_names;
let attribute_expression_roots = select root as id, file from simple_attribute_roots;
let expression_roots = union(left=bare_expression_roots, right=attribute_expression_roots);
let root_definitions = lookup_attribute(ordered_contexts=ordered_contexts, expressions=expression_roots);
let import_definitions = select l.context as context, l.expression as expression, l.definition as definition, r.target as target, l.file as file from root_definitions as l join "static-import" as r on l.definition = r.occurrence and l.file = r.file;
let definitions = select id, refinement, file from "defines" where kind = "import";
let asnames = select parent as definition, file from "semantic-child" where field = "asname";
let raw_module_imports = select l.context as context, l.expression as expression, l.definition as definition, l.target as target, l.file as file from import_definitions as l join definitions as r on l.definition = r.id and l.file = r.file where r.refinement = "import";
let unaliased_module_imports = antijoin(left=raw_module_imports, right=asnames, left-on=["definition", "file"], right-on=["definition", "file"]);
let unaliased_deep_imports = select context, expression, definition, target, file from unaliased_module_imports where starts_with(target, "enum.");
let direct_member_imports = antijoin(left=import_definitions, right=unaliased_deep_imports, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "definition", "file"]);
let known_member_imports = select context, expression, definition, file from direct_member_imports where target = "enum.Enum" or target = "enum.Flag" or target = "enum.IntEnum" or target = "enum.IntFlag" or target = "enum.StrEnum" or target = "enum.ReprEnum" or target = "enum.CheckEnum";
let direct_context_enum_classes = select r.context as context, l.class as enum_class, l.file as file from bare_names as l join known_member_imports as r on l.expression = r.expression and l.file = r.file;
let plain_module_imports = select context, expression, definition, file from import_definitions where target = "enum";
let deep_module_imports = select context, expression, definition, file from unaliased_deep_imports;
let module_imports = union(left=plain_module_imports, right=deep_module_imports);
let imported_attribute_roots = select r.context as context, l.class as class, l.expression as expression, l.file as file from simple_attribute_roots as l join module_imports as r on l.root = r.expression and l.file = r.file;
let attribute_labels = select l.context as context, l.class as class, r.child as label, l.file as file from imported_attribute_roots as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "attr";
let attribute_enum_classes = select l.context as context, l.class as enum_class, l.file as file from attribute_labels as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "Enum" or r.name = "Flag" or r.name = "IntEnum" or r.name = "IntFlag" or r.name = "StrEnum" or r.name = "ReprEnum" or r.name = "CheckEnum";
let direct_enum_classes = union(left=direct_context_enum_classes, right=attribute_enum_classes);
let contextual_class_bases = class_bases(ordered_contexts=ordered_contexts);
let contextual_class_paths = closure(edges=contextual_class_bases, source="child_class", destination="parent_class", keys=["context", "file"]);
let indirect_enum_classes = select l.context as context, l.child_class as enum_class, l.file as file from contextual_class_paths as l join direct_enum_classes as r on l.context = r.context and l.parent_class = r.enum_class and l.file = r.file;
let enum_classes = union(left=direct_enum_classes, right=indirect_enum_classes);
return enum_classes;
