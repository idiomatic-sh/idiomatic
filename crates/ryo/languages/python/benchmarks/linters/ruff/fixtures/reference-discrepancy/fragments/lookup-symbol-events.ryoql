import future_context from "python/ruff/future-annotation-context";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, header_point: number, stage: number, file: file>;
input expressions: relation<id: node, file: file>;
output relation<context: node, expression: node, occurrence: node, scope: node, kind: symbol, file: file>;
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let attributes = select id, file from nodes where kind = "attribute";
let name_nodes = select id, file from nodes where kind = "name";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let scope_nodes_for_events = select child as id, file from "scope";
let redirect_events = select occurrence as id, name, ordinal, kind, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_owners = axis(from=redirect_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let redirect_namespaces = select id as occurrence, name, ordinal, kind, file, related as scope from redirect_owners;
let all_raw_namespace_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let scope_body_roots = select l.id as scope, l.file as file, r.child as id from scope_nodes_for_events as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let type_function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_header_children = select l.id as owner, l.file as file, r.child as id from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.owner as owner, l.file as file from class_header_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_annotation_roots = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_type_owners = axis(from=parameter_annotation_roots,relation="semantic-child",direction=nearest-ancestor,domain=type_function_nodes);
let parameter_type_roots = select id, related as owner, file from parameter_type_owners;
let return_type_roots = select r.child as id, l.id as owner, l.file as file from type_function_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_type_roots = union(left=parameter_type_roots,right=return_type_roots);
let type_scope_roots = union(left=class_type_roots,right=function_type_roots);
let body_evaluation_roots = select id, scope as owner, file from scope_body_roots;
let evaluation_roots = union(left=body_evaluation_roots,right=type_scope_roots);
let nearest_evaluations = axis(from=all_raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=evaluation_roots);
let stub_type_roots = select id, file from type_scope_roots where matches(file, "\.pyi$");
let function_root_inputs = select id, file from function_type_roots;
let future_function_type_roots = future_context(expressions=function_root_inputs);
let deferred_type_roots = union(left=stub_type_roots, right=future_function_type_roots);
let active_initial_type_roots = antijoin(left=type_scope_roots, right=deferred_type_roots, left-on=["id", "file"], right-on=["id", "file"]);
let all_type_namespace_events = select l.id as id, l.file as file from nearest_evaluations as l join type_scope_roots as r on l.related = r.id and l.file = r.file;
let raw_namespace_events = antijoin(left=all_raw_namespace_events,right=all_type_namespace_events,left-on=["id","file"],right-on=["id","file"]);
let lexical_event_owners = axis(from=raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let event_body_ancestors = axis(from=raw_namespace_events,relation="semantic-child",direction=ancestor,domain=scope_body_roots);
let ancestor_body_owners = select l.id as id, l.file as file, r.scope as scope from event_body_ancestors as l join scope_body_roots as r on l.related = r.id and l.file = r.file;
let self_body_owners = select l.id as id, l.file as file, r.scope as scope from raw_namespace_events as l join scope_body_roots as r on l.id = r.id and l.file = r.file;
let event_body_owners = union(left=ancestor_body_owners,right=self_body_owners);
let lexical_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from lexical_event_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let named_expressions = select id, file from nodes where kind = "named-expr";
let walrus_targets = select r.child as id, l.file as file from named_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let walrus_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from raw_namespace_events as l join walrus_targets as r on l.id = r.id and l.file = r.file;
let non_comprehension_scopes = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let walrus_lexical_owners = axis(from=walrus_events,relation="semantic-child",direction=nearest-ancestor,domain=non_comprehension_scopes);
let walrus_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from walrus_lexical_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let owned_namespace_events = union(left=lexical_body_events,right=walrus_body_events);
let redirected_namespace_events = select l.id as occurrence, l.name as name, l.related as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from owned_namespace_events as l join redirect_namespaces as r on l.related = r.scope and l.name = r.name and l.file = r.file;
let normal_namespace_rows = antijoin(left=raw_namespace_events,right=redirected_namespace_events,left-on=["id","file"],right-on=["occurrence","file"]);
let normal_namespace_events = select id as occurrence, name, scope, ordinal, kind, file from normal_namespace_rows;
let corrected_namespace_events = union(left=normal_namespace_events,right=redirected_namespace_events);
let namespace_events = union(left=corrected_namespace_events,right=redirect_namespaces);
let named_or_attributed = union(left=name_nodes, right=attributes);
let attribute_value_edges = select r.child as origin, l.id as destination, l.file as file from attributes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let contiguous_attribute_edges = select l.origin as origin, l.destination as destination from attribute_value_edges as l join named_or_attributed as r on l.origin = r.id and l.file = r.file;
let expression_self_edges = select id as origin, id as destination from named_or_attributed;
let expression_edges = union(left=contiguous_attribute_edges, right=expression_self_edges);
let expression_paths = closure(edges=expression_edges, source="origin", destination="destination");
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges,source="origin",destination="destination",keys=["file"]);
let outer_lookup_scopes = select l.stage as stage, l.header_point as header_point, l.context as context, l.initial_scope as initial_scope, l.point as point, l.file as file, r.destination as lookup_scope from ordered_contexts as l join scope_paths as r on l.initial_scope = r.origin and l.file = r.file;
let ancestor_class_scopes = select l.context as context, l.lookup_scope as lookup_scope, l.file as file from outer_lookup_scopes as l join classes as r on l.lookup_scope = r.id and l.file = r.file where l.lookup_scope != l.initial_scope;
let visible_outer_scopes = antijoin(left=outer_lookup_scopes,right=ancestor_class_scopes,left-on=["context","lookup_scope","file"],right-on=["context","lookup_scope","file"]);
let self_lookup_scopes = select stage, header_point, context, initial_scope, point, file, initial_scope as lookup_scope from ordered_contexts;
let lookup_scopes = union(left=visible_outer_scopes,right=self_lookup_scopes);
let base_root_paths = select r.origin as expression, l.file as file from expressions as l join expression_paths as r on l.id = r.destination;
let base_name_roots = select l.expression as expression, l.file as file from base_root_paths as l join name_nodes as r on l.expression = r.id and l.file = r.file;
let root_names = select l.expression as expression, l.file as file, r.name as name from base_name_roots as l join "identifier" as r on l.expression = r.id and l.file = r.file;
let context_names = select l.stage as stage, l.header_point as header_point, l.initial_scope as initial_scope, l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from lookup_scopes as l join root_names as r on l.file = r.file where l.stage = 0 or l.stage = 2 or l.stage = 3 or l.context = r.expression;
let ordinary_preceding_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.occurrence as definition, r.ordinal as ordinal, r.kind as kind from context_names as l join namespace_events as r on l.lookup_scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (l.stage = 0 or l.stage = 3 or l.lookup_scope != l.initial_scope);
let scoped_header_aliases = select id, file from nodes where kind = "type-alias";
let scoped_header_generics = union(left=type_function_nodes, right=classes);
let scoped_header_parameters = select id, file from nodes where kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let scoped_header_parameter_axes = axis(from=scoped_header_parameters, relation="semantic-child", direction=nearest-ancestor, domain=scoped_header_generics);
let scoped_header_payloads = select l.id as parameter, r.child as id, l.file as file from scoped_header_parameters as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "bound" or r.field = "default-value";
let scoped_header_parameter_roots = select l.id as id, r.related as owner, l.file as file from scoped_header_payloads as l join scoped_header_parameter_axes as r on l.parameter = r.id and l.file = r.file;
let scoped_header_alias_roots = select r.child as id, l.id as owner, l.file as file from scoped_header_aliases as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let scoped_header_roots0 = union(left=type_scope_roots, right=scoped_header_parameter_roots);
let scoped_header_roots = union(left=scoped_header_roots0, right=scoped_header_alias_roots);
let scoped_context_nodes = select context as id, file from ordered_contexts where stage = 3;
let scoped_header_context_axes = axis(from=scoped_context_nodes, relation="semantic-child", direction=nearest-ancestor, domain=scoped_header_roots);
let scoped_header_owners = select l.id as context, r.owner as owner, l.file as file from scoped_header_context_axes as l join scoped_header_roots as r on l.related = r.id and l.file = r.file;
let excluded_header_ordinary_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from ordinary_preceding_bindings0 as l join scoped_header_owners as r on l.context = r.context and l.lookup_scope = r.owner and l.file = r.file;
let ordinary_preceding_bindings = antijoin(left=ordinary_preceding_bindings0, right=excluded_header_ordinary_bindings, left-on=["context","expression","definition","file"], right-on=["context","expression","definition","file"]);

let type_lookup_scopes = union(left=outer_lookup_scopes, right=self_lookup_scopes);
let type_context_names = select l.stage as stage, l.header_point as header_point, l.initial_scope as initial_scope, l.context as context, l.point as point, l.file as file, l.lookup_scope as lookup_scope, r.expression as expression, r.name as name from type_lookup_scopes as l join root_names as r on l.file = r.file where l.stage = 0 or l.stage = 2 or l.stage = 3 or l.context = r.expression;
let all_type_events = select l.id as id, l.name as name, r.owner as owner, r.id as root, l.ordinal as ordinal, l.file as file from nearest_evaluations as l join type_scope_roots as r on l.related = r.id and l.file = r.file;
let active_type_events = select l.id as id, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from all_type_events as l join active_initial_type_roots as r on l.root = r.id and l.file = r.file;
let current_type_contexts = select * from type_context_names where stage = 0;
let parameter_analysis_type_contexts = select * from type_context_names where stage = 2;
let class_enclosing_functions = axis(from=classes, relation="semantic-child", direction=ancestor, domain=type_function_nodes);
let initial_class_headers = antijoin(left=classes, right=class_enclosing_functions, left-on=["id","file"], right-on=["id","file"]);
let visited_class_header_events = select l.id as id, l.name as name, l.owner as owner, l.ordinal as ordinal, l.file as file from all_type_events as l join initial_class_headers as r on l.owner = r.id and l.file = r.file;
let parameter_analysis_type_events = union(left=active_type_events, right=visited_class_header_events);
let deferred_type_contexts = select * from type_context_names where stage = 1;
let current_type_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from current_type_contexts as l join active_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let deferred_type_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from deferred_type_contexts as l join all_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point and (r.owner != l.initial_scope or r.ordinal <= l.header_point);
let parameter_analysis_type_bindings0 = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from parameter_analysis_type_contexts as l join parameter_analysis_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let type_bindings_a = union(left=current_type_bindings0, right=deferred_type_bindings0);
let type_bindings0 = union(left=type_bindings_a, right=parameter_analysis_type_bindings0);
let type_bindings = extend(from=type_bindings0, values={kind: "bind"});
let body_analysis_type_contexts = select * from type_context_names where stage = 3;
let body_analysis_type_bindings_a = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from body_analysis_type_contexts as l join active_type_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let body_analysis_function_scopes = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let body_analysis_own_functions = select l.context as context, l.file as file from ordered_contexts as l join body_analysis_function_scopes as r on l.initial_scope = r.id and l.file = r.file where l.stage = 3;
let body_analysis_outer_functions = select l.context as context, l.file as file from outer_lookup_scopes as l join body_analysis_function_scopes as r on l.lookup_scope = r.id and l.file = r.file where l.stage = 3;
let body_analysis_deferred_contexts = union(left=body_analysis_own_functions, right=body_analysis_outer_functions);
let body_analysis_completed_headers = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, r.id as definition, r.ordinal as ordinal from body_analysis_type_contexts as l join visited_class_header_events as r on l.lookup_scope = r.owner and l.name = r.name and l.file = r.file where r.ordinal <= l.point;
let body_analysis_type_bindings_b = select l.context as context, l.name as name, l.file as file, l.lookup_scope as lookup_scope, l.expression as expression, l.definition as definition, l.ordinal as ordinal from body_analysis_completed_headers as l join body_analysis_deferred_contexts as r on l.context = r.context and l.file = r.file;
let body_analysis_type_bindings0 = union(left=body_analysis_type_bindings_a, right=body_analysis_type_bindings_b);
let body_analysis_type_bindings = extend(from=body_analysis_type_bindings0, values={kind: "bind"});
let ordinary_and_type_bindings = union(left=ordinary_preceding_bindings, right=type_bindings);
let unbounded_preceding_bindings = union(left=ordinary_and_type_bindings, right=body_analysis_type_bindings);
let body_contexts = select * from ordered_contexts where stage = 3;
let body_context_nodes = select context as id, file from body_contexts;
let active_function_axes = axis(from=body_context_nodes, relation="semantic-child", direction=nearest-ancestor, domain=type_function_nodes);
let initial_body_limits = select context, initial_scope as scope, header_point as limit, file from body_contexts;
let class_body_contexts = select l.context as context, l.initial_scope as initial_scope, l.header_point as limit, l.file as file from body_contexts as l join classes as r on l.initial_scope = r.id and l.file = r.file;
let class_body_scope_nodes = select initial_scope as id, file from class_body_contexts;
let class_body_function_axes = axis(from=class_body_scope_nodes, relation="semantic-child", direction=nearest-ancestor, domain=type_function_nodes);
let active_enclosing_functions = select l.context as context, r.related as scope, l.limit as limit, l.file as file from class_body_contexts as l join class_body_function_axes as r on l.initial_scope = r.id and l.file = r.file;
let body_scope_limits = union(left=initial_body_limits, right=active_enclosing_functions);
let out_of_time_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from unbounded_preceding_bindings as l join body_scope_limits as r on l.context = r.context and l.lookup_scope = r.scope and l.file = r.file where l.ordinal > r.limit;
let all_preceding_bindings = antijoin(left=unbounded_preceding_bindings, right=out_of_time_bindings, left-on=["context","expression","definition","file"], right-on=["context","expression","definition","file"]);
let cleanup_events = select occurrence, name, scope, ordinal, file from namespace_events where kind = "cleanup";
let handler_binds = select occurrence, name, scope, ordinal, file from namespace_events where kind = "bind";
let handler_intervals = select l.occurrence as handler, l.name as name, l.scope as scope, l.file as file, l.ordinal as finish, r.ordinal as begin from cleanup_events as l join handler_binds as r on l.occurrence = r.occurrence and l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let restorable_handlers = select l.handler as handler, l.name as name, l.scope as scope, l.file as file, l.begin as begin, l.finish as finish from handler_intervals as l join namespace_events as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.begin;
let finished_context_handlers = select l.context as context, l.file as file, r.name as name, r.scope as scope, r.begin as begin, r.finish as finish from ordered_contexts as l join restorable_handlers as r on l.file = r.file where r.finish <= l.point;
let restored_handler_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.ordinal as ordinal, l.file as file from all_preceding_bindings as l join finished_context_handlers as r on l.context = r.context and l.file = r.file and l.lookup_scope = r.scope and l.name = r.name where l.ordinal >= r.begin and l.ordinal <= r.finish;
let preceding_bindings = antijoin(left=all_preceding_bindings,right=restored_handler_bindings,left-on=["context","expression","definition","ordinal","file"],right-on=["context","expression","definition","ordinal","file"]);
let older_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from preceding_bindings as l join preceding_bindings as r on l.context = r.context and l.expression = r.expression and l.lookup_scope = r.lookup_scope and l.file = r.file where l.ordinal < r.ordinal;
let unadjusted_last_bindings = antijoin(left=preceding_bindings,right=older_bindings,left-on=["context","expression","definition","file"],right-on=["context","expression","definition","file"]);
let late_deletion_events = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, l.file as file from unadjusted_last_bindings as l join ordered_contexts as r on l.context = r.context and l.file = r.file where r.stage = 1 and l.kind = "delete";
let deletion_reference_locations = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, r."start-byte" as reference_start, l.file as file from late_deletion_events as l join "source-location" as r on l.expression = r.id and l.file = r.file;
let forward_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.lookup_scope as lookup_scope, l.ordinal as ordinal, l.kind as kind, l.file as file from deletion_reference_locations as l join "source-location" as r on l.definition = r.id and l.file = r.file where l.reference_start < r."start-byte";
let shadowed_event_options = select l.context as context, l.expression as expression, l.definition as deletion, l.name as name, l.lookup_scope as lookup_scope, r.definition as definition, r.ordinal as ordinal, r.kind as kind, l.file as file from forward_deletions as l join preceding_bindings as r on l.context = r.context and l.expression = r.expression and l.lookup_scope = r.lookup_scope and l.file = r.file where r.ordinal < l.ordinal;
let older_shadowed_options = select l.context as context, l.expression as expression, l.deletion as deletion, l.definition as definition, l.file as file from shadowed_event_options as l join shadowed_event_options as r on l.context = r.context and l.expression = r.expression and l.deletion = r.deletion and l.file = r.file where l.ordinal < r.ordinal;
let shadowed_events = antijoin(left=shadowed_event_options, right=older_shadowed_options, left-on=["context", "expression", "deletion", "definition", "file"], right-on=["context", "expression", "deletion", "definition", "file"]);
let restored_bindings = select context, name, file, lookup_scope, expression, definition, ordinal, kind from shadowed_events where kind = "bind";
let restored_deletions = select context, expression, deletion as definition, file from shadowed_events where kind = "bind";
let unshadowed_deletions = antijoin(left=forward_deletions, right=shadowed_event_options, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "deletion", "file"]);
let module_scope_nodes = select id, file from nodes where kind = "module";
let module_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.name as name, l.file as file from unshadowed_deletions as l join module_scope_nodes as r on l.lookup_scope = r.id and l.file = r.file;
let implicit_builtins = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let restored_builtin_deletions = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from module_deletions as l join implicit_builtins as r on l.name = r.name and l.file = r.file;
let ignored_deletions = union(left=restored_deletions, right=restored_builtin_deletions);
let unchanged_last_bindings = antijoin(left=unadjusted_last_bindings, right=ignored_deletions, left-on=["context", "expression", "definition", "file"], right-on=["context", "expression", "definition", "file"]);
let last_bindings = union(left=unchanged_last_bindings, right=restored_bindings);
let competing_scopes = select l.context as context, l.expression as expression, l.definition as definition, l.lookup_scope as farther, r.lookup_scope as closer, l.file as file from last_bindings as l join last_bindings as r on l.context = r.context and l.expression = r.expression and l.file = r.file where l.lookup_scope != r.lookup_scope;
let farther_bindings = select l.context as context, l.expression as expression, l.definition as definition, l.file as file from competing_scopes as l join scope_paths as r on l.closer = r.origin and l.farther = r.destination and l.file = r.file;
let nearest_bindings = antijoin(left=last_bindings,right=farther_bindings,left-on=["context","expression","definition","file"],right-on=["context","expression","definition","file"]);
let results = select context, expression, definition as occurrence, lookup_scope as scope, kind, file from nearest_bindings;
return results;
