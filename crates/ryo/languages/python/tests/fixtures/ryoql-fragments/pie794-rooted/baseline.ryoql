import suppress from "python/ruff/suppress";
let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let classes = select id from "semantic-syntax" where kind = "class-def";
let bodies = select parent, child from "semantic-child" where field = "body";
let class_statements = select l.id as owner, r.child as id from classes as l join bodies as r on l.id = r.parent;
let assignments = select id from "semantic-syntax" where kind = "assign";
let annotated = select id from "semantic-syntax" where kind = "ann-assign";
let target_fields = select parent, child from "semantic-child" where field = "targets";
let target_counts = group-count(from=target_fields, keys=["parent"], count="count", distinct="child");
let single = select parent from target_counts where count = 1;
let assign_targets = select l.id as id, r.child as target from assignments as l join target_fields as r on l.id = r.parent;
let single_targets = select l.id as id, l.target as target from assign_targets as l join single as r on l.id = r.parent;
let annotated_fields = select parent, child from "semantic-child" where field = "target";
let annotated_targets = select l.id as id, r.child as target from annotated as l join annotated_fields as r on l.id = r.parent;
let targets = union(left=single_targets, right=annotated_targets);
let id_fields = select parent, child from "semantic-child" where field = "id";
let identifiers = select id, text from semantic_identifiers;
let names = select l.parent as id, r.text as name from id_fields as l join identifiers as r on l.child = r.id;
let named_targets = select l.id as id, r.name as name from targets as l join names as r on l.target = r.id;
let candidates = select l.owner as owner, l.id as id, r.name as name from class_statements as l join named_targets as r on l.id = r.id;
let values = select parent, child from "semantic-child" where field = "value";
let candidate_values = select l.id as statement, l.name as name, r.child as id from candidates as l join values as r on l.id = r.parent;
let expression_paths = closure(edges="semantic-child", source="parent", destination="child");
let nested_values = select l.statement as statement, l.name as name, r.child as id from candidate_values as l join expression_paths as r on l.id = r.parent;
let all_values = union(left=candidate_values, right=nested_values);
let self_references = select l.statement as id from all_values as l join names as r on l.id = r.id and l.name = r.name;
let ordinary = antijoin(left=candidates, right=self_references, left-on=["id"], right-on=["id"]);
let ordered = select l.owner as owner, l.id as id, l.name as name, r."start-byte" as begin from ordinary as l join "source-location" as r on l.id = r.id;
let duplicates = select l.id as id from ordered as l join ordered as r on l.owner = r.owner and l.name = r.name where l.begin > r.begin;
let reportable = select l.id as id, l.file as file, l.span as span from "semantic-syntax" as l join duplicates as r on l.id = r.id;
let candidate_locations = select l.id as id, l.file as file, l.span as span, r."start-line" as line from reportable as l join "source-location" as r on l.id = r.id;
let violations = suppress(candidates=candidate_locations, inline-pattern="^[\s,]*(?:[A-Z]+[0-9]+[\s,]*)*PIE794(?:$|[\s,#]|[A-Z])", range-pattern="(?:^|,)(?:PIE794)(?:,|$)");
emit violations subject file key(id);
