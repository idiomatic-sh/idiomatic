let semantic_token_nodes = select id from "semantic-syntax" where kind = "name-token";
let semantic_identifier_children = select r.child as id, l.name as text from "identifier" as l join "semantic-child" as r on l.id = r.parent;
let semantic_identifiers = select l.id as id, l.text as text from semantic_identifier_children as l join semantic_token_nodes as r on l.id = r.id;
let id_fields = select parent, child from "semantic-child" where field = "id";
let names = select l.parent as id, r.text as name from id_fields as l join semantic_identifiers as r on l.child = r.id;
let calls = select id, file from "semantic-syntax" where kind = "call";
let functions = select parent, child from "semantic-child" where field = "func";
let outer_functions = select l.parent as id from functions as l join names as r on l.child = r.id where r.name = "outer";
let root_calls = select l.id as id, l.file as file from calls as l join outer_functions as r on l.id = r.id;
let roots_a = extend(from=root_calls, values={tag: "a"});
let roots_b = extend(from=root_calls, values={tag: "b"});
let roots = union(left=roots_a, right=roots_b);
let global_paths = closure(edges="semantic-child", source="parent", destination="child");
let global_nodes = select l.id as root, l.file as file, l.tag as tag, r.child as node from roots as l join global_paths as r on l.id = r.parent;
let old_names = select l.root as root, l.file as file, l.tag as tag, l.node as node from global_nodes as l join names as r on l.node = r.id;
let rooted = axis(from=roots, relation="semantic-child", direction=descendant, domain=names);
let new_names = select id as root, file, tag, related as node from rooted;
let old_counts = group-count(from=old_names, keys=["root", "file", "tag", "node"], count="count");
let new_counts = group-count(from=new_names, keys=["root", "file", "tag", "node"], count="count");
let old_only = antijoin(left=old_counts, right=new_counts, left-on=["root", "file", "tag", "node", "count"], right-on=["root", "file", "tag", "node", "count"]);
let new_only = antijoin(left=new_counts, right=old_counts, left-on=["root", "file", "tag", "node", "count"], right-on=["root", "file", "tag", "node", "count"]);
let mismatches = union(left=old_only, right=new_only);
let modules = select id, file, span from "semantic-syntax" where kind = "module";
let totals = group-count(from=new_names, keys=["file"], count="count");
let wrong_totals = select file from totals where count != 12;
let missing_totals = antijoin(left=modules, right=totals, left-on=["file"], right-on=["file"]);
let mismatched_files = select l.id as id, l.file as file, l.span as span from modules as l join mismatches as r on l.file = r.file;
let wrong_files = select l.id as id, l.file as file, l.span as span from modules as l join wrong_totals as r on l.file = r.file;
let bad_counts = union(left=wrong_files, right=missing_totals);
let violations = union(left=mismatched_files, right=bad_counts);
emit violations subject file key(id);
