let nodes = select id, kind, file, span from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let lambdas = select id, file from nodes where kind = "lambda";
let boundaries = union(left=functions, right=lambdas);
let all_edges = select parent, child, file from "semantic-child";
let boundary_edges = select l.parent as parent, l.child as child, l.file as file from all_edges as l join boundaries as r on l.parent = r.id and l.file = r.file;
let physical_walk_edges = antijoin(left=all_edges, right=boundary_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let embedded_edges = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=physical_walk_edges, right=embedded_edges, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let body_roots = select r.child as id, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let roots_a = extend(from=body_roots, values={tag: "a"});
let roots_b = extend(from=body_roots, values={tag: "b"});
let roots = union(left=roots_a, right=roots_b);
let global_paths = closure(edges=walk_edges, source="parent", destination="child", keys=["file"]);
let global_nodes = select l.id as root, l.file as file, l.tag as tag, r.child as node from roots as l join global_paths as r on l.id = r.parent and l.file = r.file;
let domain_nodes = select child as id from walk_edges;
let rooted = axis(from=roots, relation=walk_edges, direction=descendant, domain=domain_nodes);
let new_nodes = select id as root, file, tag, related as node from rooted;
let old_counts = group-count(from=global_nodes, keys=["root", "file", "tag", "node"], count="count");
let new_counts = group-count(from=new_nodes, keys=["root", "file", "tag", "node"], count="count");
let old_only = antijoin(left=old_counts, right=new_counts, left-on=["root", "file", "tag", "node", "count"], right-on=["root", "file", "tag", "node", "count"]);
let new_only = antijoin(left=new_counts, right=old_counts, left-on=["root", "file", "tag", "node", "count"], right-on=["root", "file", "tag", "node", "count"]);
let mismatches = union(left=old_only, right=new_only);
let modules = select id, file, span from nodes where kind = "module";
let totals = group-count(from=new_nodes, keys=["file"], count="count");
let missing = antijoin(left=modules, right=totals, left-on=["file"], right-on=["file"]);
let wrong = select l.id as id, l.file as file, l.span as span from modules as l join mismatches as r on l.file = r.file;
let violations = union(left=wrong, right=missing);
emit violations subject file key(id);
