n place"}\n        ```\n        ')), Return(value=Call(func=Attribute(value=Attribute(value=Name(id='self'), attr='router'), attr='patch'), args=[Name(id='path')], keywords=[keyword(arg='response_model', value=Name(id='response_model')), keyword(arg='status_code', value=Name(id='status_code')), keyword(arg='tags', value=Name(id='tags')), keyword(arg='dependencies', value=Name(id='dependencies')), keyword(arg='summary', value=Name(id='summary')), keyword(arg='description', value=Name(id='description')), keyword(arg='response_description', value=Name(id='response_description')), keyword(arg='responses', value=Name(id='responses')), keyword(arg='deprecated', value=Name(id='deprecated')), keyword(arg='operation_id', value=Name(id='operation_id')), keyword(arg='response_model_include', value=Name(id='response_model_include')), keyword(arg='response_model_exclude', value=Name(id='response_model_exclude')), keyword(arg='response_model_by_alias', value=Name(id='response_model_by_alias')), keyword(arg='response_model_exclude_unset', value=Name(id='response_model_exclude_unset')), keyword(arg='response_model_exclude_defaults', value=Name(id='response_model_exclude_defaults')), keyword(arg='response_model_exclude_none', value=Name(id='response_model_exclude_none')), keyword(arg='include_in_schema', value=Name(id='include_in_schema')), keyword(arg='response_class', value=Name(id='response_class')), keyword(arg='name', value=Name(id='name')), keyword(arg='callbacks', value=Name(id='callbacks')), keyword(arg='openapi_extra', value=Name(id='openapi_extra')), keyword(arg='generate_unique_id_function', value=Name(id='generate_unique_id_function'))]))], returns=Subscript(value=Name(id='Callable'), slice=Tuple(elts=[List(elts=[Name(id='DecoratedCallable')]), Name(id='DecoratedCallable')]))), FunctionDef(name='trace', args=arguments(args=[arg(arg='self'), arg(arg='path', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(elts=[Name(id='str'), Call(func=Name(id='Doc'), args=[Constant(value='\n                The URL path to be used for this *path operation*.\n\n                For example, in `http://example.com/items`, the path is `/items`.\n                ')])])))], kwonlyargs=[arg(arg='response_model', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(elts=[Name(id='Any'), Call(func=Name(id='Doc'), args=[Constant(value="\n                The type to use for the response.\n\n                It could be any valid Pydantic *field* type. So, it doesn't have to\n                be a Pydantic model, it could be other things, like a `list`, `dict`,\n                etc.\n\n                It will be used for:\n\n                * Documentation: the generated OpenAPI (and the UI at `/docs`) will\n                    show it as the response (JSON Schema).\n                * Serialization: you could return an arbitrary object and the\n                    `response_model` would be used to serialize that object into the\n                    corresponding JSON.\n                * Filtering: the JSON sent to the client will only contain the data\n                    (fields) defined in the `response_model`. If you returned an object\n                    that contains an attribute `password` but the `response_model` does\n                    not include that field, the JSON sent to the client would not have\n                    that `password`.\n                * Validation: whatever you return will be serialized with the\n                    `response_model`, converting any data as necessary to generate the\n                    corresponding JSON. But if the data in the object returned is not\n                    valid, that would mean a violation of the contract with the client,\n                    so it's an error from the API developer. So, FastAPI will raise an\n                    error and return a 500 error code (Internal Server Error).\n\n                Read more about it in the\n                [FastAPI docs for Response Model](https://fastapi.tiangolo.com/tutorial/response-model/).\n                ")])]))), arg(arg='status_code', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(elts=[Subscript(value=Name(id='Optional'), slice=Name(id='int')), Call(func=Name(id='Doc'), args=[Constant(value='\n                The default status code to be used for the response.\n\n                You could override the status code by returning a response directly.\n\n                Read more about it in the\n                [FastAPI docs for Response Status Code](https://fastapi.tiangolo.com/tutorial/response-status-code/).\n                ')])]))), arg(arg='tags', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(elts=[Subscript(value=Name(id='Optional'), slice=Subscript(value=Name(id='List'), slice=Subscript(value=Name(id='Union'), slice=Tuple(elts=[Name(id='str'), Name(id='Enum')])))), Call(func=Name(id='Doc'), args=[Constant(value='\n                A list of tags to be applied to the *path operation*.\n\n                It will be added to the generated OpenAPI (e.g. visible at `/docs`).\n\n                Read more about it in the\n                [FastAPI docs for Path Operation Configuration](https://fastapi.tiangolo.com/tutorial/path-operation-configuration/#tags).\n                ')])]))), arg(arg='dependencies', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(elts=[Subscript(value=Name(id='Optional'), slice=Subscript(value=Name(id='Sequence'), slice=Name(id='Depends'))), Call(func=Name(id='Doc'), args=[Constant(value='\n                A list of dependencies (using `Depends()`) to be applied to the\n                *path operation*.\n\n                Read more about it in the\n                [FastAPI docs for Dependencies in path operation decorators](https://fastapi.tiangolo.com/tutorial/dependencies/dependencies-in-path-operation-decorators/).\n                ')])]))), arg(arg='summary', annotation=Subscript(value=Name(id='Annotated'), slice=Tuple(e