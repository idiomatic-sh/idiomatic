check\n    only the presence of given attributes, ignoring their type signatures.\n    Protocol classes can be generic, they are defined as::\n\n        class GenProto[T](Protocol):\n            def meth(self) -> T:\n                ...\n    ')), Assign(targets=[Name(id='__slots__', ctx=Store())], value=Tuple()), Assign(targets=[Name(id='_is_protocol', ctx=Store())], value=Constant(value=True)), Assign(targets=[Name(id='_is_runtime_protocol', ctx=Store())], value=Constant(value=False)), FunctionDef(name='__init_subclass__', args=arguments(args=[arg(arg='cls')], vararg=arg(arg='args'), kwarg=arg(arg='kwargs')), body=[Expr(value=Call(func=Attribute(value=Call(func=Name(id='super')), attr='__init_subclass__'), args=[Starred(value=Name(id='args'))], keywords=[keyword(value=Name(id='kwargs'))])), If(test=UnaryOp(op=Not(), operand=Call(func=Attribute(value=Attribute(value=Name(id='cls'), attr='__dict__'), attr='get'), args=[Constant(value='_is_protocol'), Constant(value=False)])), body=[Assign(targets=[Attribute(value=Name(id='cls'), attr='_is_protocol', ctx=Store())], value=Call(func=Name(id='any'), args=[GeneratorExp(elt=Compare(left=Name(id='b'), ops=[Is()], comparators=[Name(id='Protocol')]), generators=[comprehension(target=Name(id='b', ctx=Store()), iter=Attribute(value=Name(id='cls'), attr='__bases__'), is_async=0)])]))]), If(test=Compare(left=Constant(value='__subclasshook__'), ops=[NotIn()], comparators=[Attribute(value=Name(id='cls'), attr='__dict__')]), body=[Assign(targets=[Attribute(value=Name(id='cls'), attr='__subclasshook__', ctx=Store())], value=Name(id='_proto_hook'))]), If(test=BoolOp(op=And(), values=[Attribute(value=Name(id='cls'), attr='_is_protocol'), Compare(left=Attribute(value=Name(id='cls'), attr='__init__'), ops=[Is()], comparators=[Attribute(value=Name(id='Protocol'), attr='__init__')])]), body=[Assign(targets=[Attribute(value=Name(id='cls'), attr='__init__', ctx=Store())], value=Name(id='_no_init_or_replace_init'))])])]), ClassDef(name='_AnnotatedAlias', bases=[Name(id='_NotIterable'), Name(id='_GenericAlias')], keywords=[keyword(arg='_root', value=Constant(value=True))], body=[Expr(value=Constant(value="Runtime representation of an annotated type.\n\n    At its core 'Annotated[t, dec1, dec2, ...]' is an alias for the type 't'\n    with extra metadata. The alias behaves like a normal typing alias.\n    Instantiating is the same as instantiating the underlying type; binding\n    it to types is also the same.\n\n    The metadata itself is stored in a '__metadata__' attribute as a tuple.\n    ")), FunctionDef(name='__init__', args=arguments(args=[arg(arg='self'), arg(arg='origin'), arg(arg='metadata')]), body=[If(test=Call(func=Name(id='isinstance'), args=[Name(id='origin'), Name(id='_AnnotatedAlias')]), body=[Assign(targets=[Name(id='metadata', ctx=Store())], value=BinOp(left=Attribute(value=Name(id='origin'), attr='__metadata__'), op=Add(), right=Name(id='metadata'))), Assign(targets=[Name(id='origin', ctx=Store())], value=Attribute(value=Name(id='origin'), attr='__origin__'))]), Expr(value=Call(func=Attribute(value=Call(func=Name(id='super')), attr='__init__'), args=[Name(id='origin'), Name(id='origin')], keywords=[keyword(arg='name', value=Constant(value='Annotated'))])), Assign(targets=[Attribute(value=Name(id='self'), attr='__metadata__', ctx=Store())], value=Name(id='metadata'))]), FunctionDef(name='copy_with', args=arguments(args=[arg(arg='self'), arg(arg='params')]), body=[Assert(test=Compare(left=Call(func=Name(id='len'), args=[Name(id='params')]), ops=[Eq()], comparators=[Constant(value=1)])), Assign(targets=[Name(id='new_type', ctx=Store())], value=Subscript(value=Name(id='params'), slice=Constant(value=0))), Return(value=Call(func=Name(id='_AnnotatedAlias'), args=[Name(id='new_type'), Attribute(value=Name(id='self'), attr='__metadata__')]))]), FunctionDef(name='__repr__', args=arguments(args=[arg(arg='self')]), body=[Return(value=Call(func=Attribute(value=Constant(value='typing.Annotated[{}, {