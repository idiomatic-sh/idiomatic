Module(body=[Expr(value=Constant(value='\nThe typing module: Support for gradual typing as defined by PEP 484 and subsequent PEPs.\n\nAmong other things, the module includes the following:\n* Generic, Protocol, and internal machinery to support generic aliases.\n  All subscripted types like X[int], Union[int, str] are generic aliases.\n* Various "special forms" that have unique meanings in type annotations:\n  NoReturn, Never, ClassVar, Self, Concatenate, Unpack, and others.\n* Classes whose instances can be type arguments to generic classes and functions:\n  TypeVar, ParamSpec, TypeVarTuple.\n* Public helper functions: get_type_hints, overload, cast, final, and others.\n* Several protocols to support duck-typing:\n  SupportsFloat, SupportsIndex, SupportsAbs, and others.\n* Special types: NewType, NamedTuple, TypedDict.\n* Deprecated aliases for builtin types and collections.abc ABCs.\n\nAny name not present in __all__ is an implementation detail\nthat may be changed without notice. Use at your own risk!\n')), ImportFrom(module='abc', names=[alias(name='abstractmethod'), alias(name='ABCMeta')], level=0, is_lazy=0), Import(names=[alias(name='collections')], is_lazy=0), ImportFrom(module='collections', names=[alias(name='defaultdict')], level=0, is_lazy=0), Import(names=[alias(name='collections.abc')], is_lazy=0), Import(names=[alias(name='copyreg')], is_lazy=0), Import(names=[alias(name='functools')], is_lazy=0), Import(names=[alias(name='operator')], is_lazy=0), Import(names=[alias(name='sys')], is_lazy=0), Import(names=[alias(name='types')], is_lazy=0), ImportFrom(module='types', names=[alias(name='GenericAlias')], level=0, is_lazy=0), ImportFrom(module='_typing', names=[alias(name='_idfunc'), alias(name='TypeVar'), alias(name='ParamSpec'), alias(name='TypeVarTuple'), alias(name='ParamSpecArgs'), alias(name='ParamSpecKwargs'), alias(name='TypeAliasType'), alias(name='Generic'), alias(name='Union'), alias(name='NoDefault')], level=0, is_lazy=0), Assign(targets=[Name