TypeError'), args=[Constant(value='Any cannot be instantiated')]))]), Return(value=Call(func=Attribute(value=Call(func=Name(id='super')), attr='__new__'), args=[Name(id='cls')]))])]), FunctionDef(name='NoReturn', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value="Special type indicating functions that never return.\n\n    Example::\n\n        from typing import NoReturn\n\n        def stop() -> NoReturn:\n            raise Exception('no way')\n\n    NoReturn can also be used as a bottom type, a type that\n    has no values. Starting in Python 3.11, the Never type should\n    be used for this concept instead. Type checkers should treat the two\n    equivalently.\n    ")), Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' is not subscriptable')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Never', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='The bottom type, a type that has no members.\n\n    This can be used to define a function that should never be\n    called, or a function that never returns::\n\n        from typing import Never\n\n        def never_call_me(arg: Never) -> None:\n            pass\n\n        def int_or_str(arg: int | str) -> None:\n            never_call_me(arg)  # type checker error\n            match arg:\n                case int():\n                    print("It\'s an int")\n                case str():\n                    print("It\'s a str")\n                case _:\n                    never_call_me(arg)  # OK, arg is of type Never\n    ')), Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' is not subscriptable')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Self', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Used to spell the type of "self" in classes.\n\n    Example::\n\n        from typing import Self\n\n        class Foo:\n            def return_self(self) -> Self:\n                ...\n                return self\n\n    This is especially useful for:\n        - classmethods that are used as alternative constructors\n        - annotating an `__enter__` method which returns self\n    ')), Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' is not subscriptable')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='LiteralString', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Represents an arbitrary literal string.\n\n    Example::\n\n        from typing import LiteralString\n\n        def run_query(sql: LiteralString) -> None:\n            ...\n\n        def caller(arbitrary_string: str, literal_string: LiteralString) -> None:\n            run_query("SELECT * FROM students")  # OK\n            run_query(literal_string)  # OK\n            run_query("SELECT * FROM " + literal_string)  # OK\n            run_query(arbitrary_string)  # type checker error\n            run_query(  # type checker error\n                f"SELECT * FROM students WHERE name = {arbitrary_string}"\n            )\n\n    Only string literals and other LiteralStrings are compatible\n    with LiteralString. This provides a tool to help prevent\n    security issues such as SQL injection.\n    ')), Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' is not subscriptable')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='ClassVar', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Special type construct to mark class variables.\n\n    An annotation wrapped in ClassVar indicates that a given\n    attribute is intended to be used as a class variable and\n    should not be set on instances of that class.\n\n    Usage::\n\n        class Starship:\n            stats: ClassVar[dict[str, int]] = {} # class variable\n            damage: int = 10                     # instance variable\n\n    ClassVar accepts only types and cannot be further subscribed.\n\n    Note that ClassVar is not a class itself, and should not\n    be used with isinstance() or issubclass().\n    ')), Assign(targets=[Name(id='item', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='parameters'), JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' accepts only single type.')])], keywords=[keyword(arg='allow_special_forms', value=Constant(value=True))])), Return(value=Call(func=Name(id='_GenericAlias'), args=[Name(id='self'), Tuple(elts=[Name(id='item')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Final', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Special typing construct to indicate final names to type checkers.\n\n    A final name cannot be re-assigned or overridden in a subclass.\n\n    For example::\n\n        MAX_SIZE: Final = 9000\n        MAX_SIZE += 1  # Error reported by type checker\n\n        class Connection:\n            TIMEOUT: Final[int] = 10\n\n        class FastConnector(Connection):\n            TIMEOUT = 1  # Error reported by type checker\n\n    There is no runtime checking of these properties.\n    ')), Assign(targets=[Name(id='item', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='parameters'), JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' accepts only single type.')])], keywords=[keyword(arg='allow_special_forms', value=Constant(value=True))])), Return(value=Call(func=Name(id='_GenericAlias'), args=[Name(id='self'), Tuple(elts=[Name(id='item')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Optional', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Optional[X] is equivalent to Union[X, None].')), Assign(targets=[Name(id='arg', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='parameters'), JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' requires a single type.')])])), Return(value=Subscript(value=Name(id='Union'), slice=Tuple(elts=[Name(id='arg'), Call(func=Name(id='type'), args=[Constant(value=None)])])))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Literal', args=arguments(args=[arg(arg='self')], vararg=arg(arg='parameters')), body=[Expr(value=Constant(value="Special typing form to define literal types (a.k.a. value types).\n\n    This form can be used to indicate to type checkers that the corresponding\n    variable or function parameter has a value equivalent to the provided\n    literal (or one of several literals)::\n\n        def validate_simple(data: Any) -> Literal[True]:  # always returns True\n            ...\n\n        MODE = Literal['r', 'rb', 'w', 'wb']\n        def open_helper(file: str, mode: MODE) -> str:\n            ...\n\n        open_helper('/some/path', 'r')  # Passes type check\n        open_helper('/other/path', 'typo')  # Error in type checker\n\n    Literal[...] cannot be subclassed. At runtime, an arbitrary value\n    is allowed as type argument to Literal[...], but type checkers may\n    impose restrictions.\n    ")), Assign(targets=[Name(id='parameters', ctx=Store())], value=Call(func=Name(id='_flatten_literal_params'), args=[Name(id='parameters')])), Try(body=[Assign(targets=[Name(id='parameters', ctx=Store())], value=Call(func=Name(id='tuple'), args=[GeneratorExp(elt=Name(id='p'), generators=[comprehension(target=Tuple(elts=[Name(id='p', ctx=Store()), Name(id='_', ctx=Store())], ctx=Store()), iter=Call(func=Name(id='_deduplicate'), args=[Call(func=Name(id='list'), args=[Call(func=Name(id='_value_and_type_iter'), args=[Name(id='parameters')])])]), is_async=0)])]))], handlers=[ExceptHandler(type=Name(id='TypeError'), body=[Pass()])]), Return(value=Call(func=Name(id='_LiteralGenericAlias'), args=[Name(id='self'), Name(id='parameters')]))], decorator_list=[Name(id='_TypedCacheSpecialForm'), Call(func=Name(id='_tp_cache'), keywords=[keyword(arg='typed', value=Constant(value=True))])]), FunctionDef(name='TypeAlias', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value="Special form for marking type aliases.\n\n    Use TypeAlias to indicate that an assignment should\n    be recognized as a proper type alias definition by type\n    checkers.\n\n    For example::\n\n        Predicate: TypeAlias = Callable[..., bool]\n\n    It's invalid when used anywhere except as in the example above.\n    ")), Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' is not subscriptable')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='Concatenate', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Special form for annotating higher-order functions.\n\n    ``Concatenate`` can be used in conjunction with ``ParamSpec`` and\n    ``Callable`` to represent a higher-order function which adds, removes or\n    transforms the parameters of a callable.\n\n    For example::\n\n        Callable[Concatenate[int, P], int]\n\n    See PEP 612 for detailed information.\n    ')), If(test=Compare(left=Name(id='parameters'), ops=[Eq()], comparators=[Tuple()]), body=[Raise(exc=Call(func=Name(id='TypeError'), args=[Constant(value='Cannot take a Concatenate of no types.')]))]), If(test=UnaryOp(op=Not(), operand=Call(func=Name(id='isinstance'), args=[Name(id='parameters'), Name(id='tuple')])), body=[Assign(targets=[Name(id='parameters', ctx=Store())], value=Tuple(elts=[Name(id='parameters')]))]), If(test=UnaryOp(op=Not(), operand=BoolOp(op=Or(), values=[Compare(left=Subscript(value=Name(id='parameters'), slice=UnaryOp(op=USub(), operand=Constant(value=1))), ops=[Is()], comparators=[Constant(value=Ellipsis)]), Call(func=Name(id='isinstance'), args=[Subscript(value=Name(id='parameters'), slice=UnaryOp(op=USub(), operand=Constant(value=1))), Name(id='ParamSpec')])])), body=[Raise(exc=Call(func=Name(id='TypeError'), args=[Constant(value='The last parameter to Concatenate should be a ParamSpec variable or ellipsis.')]))]), Assign(targets=[Name(id='msg', ctx=Store())], value=Constant(value='Concatenate[arg, ...]: each arg must be a type.')), Assign(targets=[Name(id='parameters', ctx=Store())], value=Tuple(elts=[Starred(value=GeneratorExp(elt=Call(func=Name(id='_type_check'), args=[Name(id='p'), Name(id='msg')]), generators=[comprehension(target=Name(id='p', ctx=Store()), iter=Subscript(value=Name(id='parameters'), slice=Slice(upper=UnaryOp(op=USub(), operand=Constant(value=1)))), is_async=0)])), Subscript(value=Name(id='parameters'), slice=UnaryOp(op=USub(), operand=Constant(value=1)))])), Return(value=Call(func=Name(id='_ConcatenateGenericAlias'), args=[Name(id='self'), Name(id='parameters')]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='TypeGuard', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Special typing construct for marking user-defined type predicate functions.\n\n    ``TypeGuard`` can be used to annotate the return type of a user-defined\n    type predicate function.  ``TypeGuard`` only accepts a single type argument.\n    At runtime, functions marked this way should return a boolean.\n\n    ``TypeGuard`` aims to benefit *type narrowing* -- a technique used by static\n    type checkers to determine a more precise type of an expression within a\n    program\'s code flow.  Usually type narrowing is done by analyzing\n    conditional code flow and applying the narrowing to a block of code.  The\n    conditional expression here is sometimes referred to as a "type predicate".\n\n    Sometimes it would be convenient to use a user-defined boolean function\n    as a type predicate.  Such a function should use ``TypeGuard[...]`` or\n    ``TypeIs[...]`` as its return type to alert static type checkers to\n    this intention. ``TypeGuard`` should be used over ``TypeIs`` when narrowing\n    from an incompatible type (e.g., ``list[object]`` to ``list[int]``) or when\n    the function does not return ``True`` for all instances of the narrowed type.\n\n    Using  ``-> TypeGuard[NarrowedType]`` tells the static type checker that\n    for a given function:\n\n    1. The return value is a boolean.\n    2. If the return value is ``True``, the type of its argument\n       is ``NarrowedType``.\n\n    For example::\n\n         def is_str_list(val: list[object]) -> TypeGuard[list[str]]:\n             \'\'\'Determines whether all objects in the list are strings\'\'\'\n             return all(isinstance(x, str) for x in val)\n\n         def func1(val: list[object]):\n             if is_str_list(val):\n                 # Type of ``val`` is narrowed to ``list[str]``.\n                 print(" ".join(val))\n             else:\n                 # Type of ``val`` remains as ``list[object]``.\n                 print("Not a list of strings!")\n\n    Strict type narrowing is not enforced -- ``TypeB`` need not be a narrower\n    form of ``TypeA`` (it can even be a wider form) and this may lead to\n    type-unsafe results.  The main reason is to allow for things like\n    narrowing ``list[object]`` to ``list[str]`` even though the latter is not\n    a subtype of the former, since ``list`` is invariant.  The responsibility of\n    writing type-safe type predicates is left to the user.\n\n    ``TypeGuard`` also works with type variables.  For more information, see\n    PEP 647 (User-Defined Type Guards).\n    ')), Assign(targets=[Name(id='item', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='parameters'), JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' accepts only single type.')])])), Return(value=Call(func=Name(id='_GenericAlias'), args=[Name(id='self'), Tuple(elts=[Name(id='item')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='TypeIs', args=arguments(args=[arg(arg='self'), arg(arg='parameters')]), body=[Expr(value=Constant(value='Special typing construct for marking user-defined type predicate functions.\n\n    ``TypeIs`` can be used to annotate the return type of a user-defined\n    type predicate function.  ``TypeIs`` only accepts a single type argument.\n    At runtime, functions marked this way should return a boolean and accept\n    at least one argument.\n\n    ``TypeIs`` aims to benefit *type narrowing* -- a technique used by static\n    type checkers to determine a more precise type of an expression within a\n    program\'s code flow.  Usually type narrowing is done by analyzing\n    conditional code flow and applying the narrowing to a block of code.  The\n    conditional expression here is sometimes referred to as a "type predicate".\n\n    Sometimes it would be convenient to use a user-defined boolean function\n    as a type predicate.  Such a function should use ``TypeIs[...]`` or\n    ``TypeGuard[...]`` as its return type to alert static type checkers to\n    this intention.  ``TypeIs`` usually has more intuitive behavior than\n    ``TypeGuard``, but it cannot be used when the input and output types\n    are incompatible (e.g., ``list[object]`` to ``list[int]``) or when the\n    function does not return ``True`` for all instances of the narrowed type.\n\n    Using  ``-> TypeIs[NarrowedType]`` tells the static type checker that for\n    a given function:\n\n    1. The return value is a boolean.\n    2. If the return value is ``True``, the type of its argument\n       is the intersection of the argument\'s original type and\n       ``NarrowedType``.\n    3. If the return value is ``False``, the type of its argument\n       is narrowed to exclude ``NarrowedType``.\n\n    For example::\n\n        from typing import assert_type, final, TypeIs\n\n        class Parent: pass\n        class Child(Parent): pass\n        @final\n        class Unrelated: pass\n\n        def is_parent(val: object) -> TypeIs[Parent]:\n            return isinstance(val, Parent)\n\n        def run(arg: Child | Unrelated):\n            if is_parent(arg):\n                # Type of ``arg`` is narrowed to the intersection\n                # of ``Parent`` and ``Child``, which is equivalent to\n                # ``Child``.\n                assert_type(arg, Child)\n            else:\n                # Type of ``arg`` is narrowed to exclude ``Parent``,\n                # so only ``Unrelated`` is left.\n                assert_type(arg, Unrelated)\n\n    The type inside ``TypeIs`` must be consistent with the type of the\n    function\'s argument; if it is not, static type checkers will raise\n    an error.  An incorrectly written ``TypeIs`` function can lead to\n    unsound behavior in the type system; it is the user\'s responsibility\n    to write such functions in a type-safe manner.\n\n    ``TypeIs`` also works with type variables.  For more information, see\n    PEP 742 (Narrowing types with ``TypeIs``).\n    ')), Assign(targets=[Name(id='item', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='parameters'), JoinedStr(values=[FormattedValue(value=Name(id='self'), conversion=-1), Constant(value=' accepts only single type.')])])), Return(value=Call(func=Name(id='_GenericAlias'), args=[Name(id='self'), Tuple(elts=[Name(id='item')])]))], decorator_list=[Name(id='_SpecialForm')]), FunctionDef(name='_make_forward_ref', args=arguments(args=[arg(arg='code')], kwonlyargs=[arg(arg='parent_fwdref')], kw_defaults=[Constant(value=None)], kwarg=arg(arg='kwargs')), body=[If(test=Compare(left=Name(id='parent_fwdref'), ops=[IsNot()], comparators=[Constant(value=None)]), body=[If(test=Compare(left=Attribute(value=Name(id='parent_fwdref'), attr='__forward_module__'), ops=[IsNot()], comparators=[Constant(value=None)]), body=[Assign(targets=[Subscript(value=Name(id='kwargs'), slice=Constant(value='module'), ctx=Store())], value=Attribute(value=Name(id='parent_fwdref'), attr='__forward_module__'))]), If(test=Compare(left=Attribute(value=Name(id='parent_fwdref'), attr='__owner__'), ops=[IsNot()], comparators=[Constant(value=None)]), body=[Assign(targets=[Subscript(value=Name(id='kwargs'), slice=Constant(value='owner'), ctx=Store())], value=Attribute(value=Name(id='parent_fwdref'), attr='__owner__'))])]), Assign(targets=[Name(id='forward_ref', ctx=Store())], value=Call(func=Attribute(value=Name(id='_lazy_annotationlib'), attr='ForwardRef'), args=[Name(id='code')], keywords=[keyword(value=Name(id='kwargs'))])), Expr(value=Attribute(value=Name(id='forward_ref'), attr='__forward_code__')), Return(value=Name(id='forward_ref'))]), FunctionDef(name='evaluate_forward_ref', args=arguments(args=[arg(arg='forward_ref')], kwonlyargs=[arg(arg='owner'), arg(arg='globals'), arg(arg='locals'), arg(arg='type_params'), arg(arg='format'), arg(arg='_recursive_guard')], kw_defaults=[Constant(value=None), Constant(value=None), Constant(value=None), Constant(value=None), Constant(value=None), Call(func=Name(id='frozenset'))]), body=[Expr(value=Constant(value='Evaluate a forward reference as a type hint.\n\n    This is similar to calling the ForwardRef.evaluate() method,\n    but unlike that method, evaluate_forward_ref() also\n    recursively evaluates forward references nested within the type hint.\n\n    *forward_ref* must be an instance of ForwardRef. *owner*, if given,\n    should be the object that holds the annotations that the forward reference\n    derived from, such as a module, class object, or function. It is used to\n    infer the namespaces to use for looking up names. *globals* and *locals*\n    can also be explicitly given to provide the global and local namespaces.\n    *type_params* is a tuple of type parameters that are in scope when\n    evaluating the forward reference. This parameter should be provided (though\n    it may be an empty tuple) if *owner* is not given and the forward reference\n    does not already have an owner set. *format* specifies the format of the\n    annotation and is a member of the annotationlib.Format enum, defaulting to\n    VALUE.\n\n    ')), If(test=Compare(left=Name(id='format'), ops=[Eq()], comparators=[Attribute(value=Attribute(value=Name(id='_lazy_annotationlib'), attr='Format'), attr='STRING')]), body=[Return(value=Attribute(value=Name(id='forward_ref'), attr='__forward_arg__'))]), If(test=Compare(left=Attribute(value=Name(id='forward_ref'), attr='__forward_arg__'), ops=[In()], comparators=[Name(id='_recursive_guard')]), body=[Return(value=Name(id='forward_ref'))]), If(test=Compare(left=Name(id='format'), ops=[Is()], comparators=[Constant(value=None)]), body=[Assign(targets=[Name(id='format', ctx=Store())], value=Attribute(value=Attribute(value=Name(id='_lazy_annotationlib'), attr='Format'), attr='VALUE'))]), Assign(targets=[Name(id='value', ctx=Store())], value=Call(func=Attribute(value=Name(id='forward_ref'), attr='evaluate'), keywords=[keyword(arg='globals', value=Name(id='globals')), keyword(arg='locals', value=Name(id='locals')), keyword(arg='type_params', value=Name(id='type_params')), keyword(arg='owner', value=Name(id='owner')), keyword(arg='format', value=Name(id='format'))])), If(test=BoolOp(op=And(), values=[Call(func=Name(id='isinstance'), args=[Name(id='value'), Attribute(value=Name(id='_lazy_annotationlib'), attr='ForwardRef')]), Compare(left=Name(id='format'), ops=[Eq()], comparators=[Attribute(value=Attribute(value=Name(id='_lazy_annotationlib'), attr='Format'), attr='FORWARDREF')])]), body=[Return(value=Name(id='value'))]), If(test=Call(func=Name(id='isinstance'), args=[Name(id='value'), Name(id='str')]), body=[Assign(targets=[Name(id='value', ctx=Store())], value=Call(func=Name(id='_make_forward_ref'), args=[Name(id='value')], keywords=[keyword(arg='module', value=Attribute(value=Name(id='forward_ref'), attr='__forward_module__')), keyword(arg='owner', value=BoolOp(op=Or(), values=[Name(id='owner'), Attribute(value=Name(id='forward_ref'), attr='__owner__')])), keyword(arg='is_argument', value=Attribute(value=Name(id='forward_ref'), attr='__forward_is_argument__')), keyword(arg='is_class', value=Attribute(value=Name(id='forward_ref'), attr='__forward_is_class__'))]))]), If(test=Compare(left=Name(id='owner'), ops=[Is()], comparators=[Constant(value=None)]), body=[Assign(targets=[Name(id='owner', ctx=Store())], value=Attribute(value=Name(id='forward_ref'), attr='__owner__'))]), Return(value=Call(func=Name(id='_eval_type'), args=[Name(id='value'), Name(id='globals'), Name(id='locals'), Name(id='type_params')], keywords=[keyword(arg='recursive_guard', value=BinOp(left=Name(id='_recursive_guard'), op=BitOr(), right=Set(elts=[Attribute(value=Name(id='forward_ref'), attr='__forward_arg__')]))), keyword(arg='format', value=Name(id='format')), keyword(arg='owner', value=Name(id='owner')), keyword(arg='parent_fwdref', value=Name(id='forward_ref'))]))]), FunctionDef(name='_is_unpacked_typevartuple', args=arguments(args=[arg(arg='x', annotation=Name(id='Any'))]), body=[Return(value=BoolOp(op=And(), values=[UnaryOp(op=Not(), operand=Call(func=Name(id='isinstance'), args=[Name(id='x'), Name(id='type')])), Call(func=Name(id='getattr'), args=[Name(id='x'), Constant(value='__typing_is_unpacked_typevartuple__'), Constant(value=False)])]))], returns=Name(id='bool')), FunctionDef(name='_is_typevar_like', args=arguments(args=[arg(arg='x', annotation=Name(id='Any'))]), body=[Return(value=BoolOp(op=Or(), values=[Call(func=Name(id='isinstance'), args=[Name(id='x'), Tuple(elts=[Name(id='TypeVar'), Name(id='ParamSpec')])]), Call(func=Name(id='_is_unpacked_typevartuple'), args=[Name(id='x')])]))], returns=Name(id='bool')), FunctionDef(name='_typevar_subst', args=arguments(args=[arg(arg='self'), arg(arg='arg')]), body=[Assign(targets=[Name(id='msg', ctx=Store())], value=Constant(value='Parameters to generic types must be types.')), Assign(targets=[Name(id='arg', ctx=Store())], value=Call(func=Name(id='_type_check'), args=[Name(id='arg'), Name(id='msg')], keywords=[keyword(arg='is_argument', value=Constant(value=True))])), If(test=BoolOp(op=Or(), values=[BoolOp(op=And(), values=[Call(func=Name(id='isinstance'), args=[Name(id='arg'), Name(id='_GenericAlias')]), Compare(left=Attribute(value=Name(id='arg'), attr='__origin__'), ops=[Is()], comparators=[Name(id='Unpack')])]), BoolOp(op=And(), values=[Call(func=Name(id='isinstance'), args=[Name(id='arg'), Name(id='GenericAlias')]), Call(func=Name(id='getattr'), args=[Name(id='arg'), Constant(value='__unpacked__'), Constant(value=False)])])]), body=[Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[FormattedValue(value=Name(id='arg'), conversion=-1), Constant(value=' is not valid as type argument')])]))]), Return(value=Name(id='arg'))]), FunctionDef(name='_typevartuple_prepare_subst', args=arguments(args=[arg(arg='self'), arg(arg='alias'), arg(arg='args')]), body=[Assign(targets=[Name(id='params', ctx=Store())], value=Attribute(value=Name(id='alias'), attr='__parameters__')), Assign(targets=[Name(id='typevartuple_index', ctx=Store())], value=Call(func=Attribute(value=Name(id='params'), attr='index'), args=[Name(id='self')])), For(target=Name(id='param', ctx=Store()), iter=Subscript(value=Name(id='params'), slice=Slice(lower=BinOp(left=Name(id='typevartuple_index'), op=Add(), right=Constant(value=1)))), body=[If(test=Call(func=Name(id='isinstance'), args=[Name(id='param'), Name(id='TypeVarTuple')]), body=[Raise(exc=Call(func=Name(id='TypeError'), args=[JoinedStr(values=[Constant(value='More than one TypeVarTuple parameter in '), FormattedValue(value=Name(id='alias'), conversion=-1)])]))])]), Assign(targets=[Name(id='alen', ctx=Store())], value=Call(func=Name(id='len'), args=[Name(id='args')])), Assign(targets=[Name(id='plen', ctx=Store())], value=Call(func=Name(id='len'), args=[Name(id='params')])), Assign(targets=[Name(id='left', ctx=Store())], value=Name(id='typevartuple_index')), Assign(targets=[Name(id='right', ctx=Store())], value=BinOp(left=BinOp(left=Name(id='plen'), op=Sub(), right=Name(id='typevartuple_index')), op=Sub(), right=Constant(value=1))), Assign(targets=[Name(id='var_tuple_index', ctx=Store())], value=Constant(value=None)), Assign(targets=[Name(id='fillarg', ctx=Store())], value=Constant(value=None)), For(target=Tuple(elts=[Name(id='k', ctx=Store()), Name(id='arg', ctx=Store())], ctx=Store()), iter=Call(func=Name(id='enumerate'), args=[Name(id='args')]), body=[If(test=UnaryOp(op=Not(), operand=Call(func=Name(id='isinstance'), args=[Name(id='arg'), Name(id='type')])), body=[Assign(targets=[Name(id='subargs', ctx=Store())], value=Call(func=Name(id='getattr'), args=[Name(id='arg'), Constant(value='__typing_unpacked_tuple_args__'), Constant(value=None)])), If(test=BoolOp(op=And(), values=[Name(id='subargs'), Compare(left=Call(func=Name(id='len'), args=[Name(id='subargs')]), ops=[Eq()], comparators=[Constant(value=2)]), Compare(left=Subscript(value=Name(id='subargs'), slice=UnaryOp(op=USub(), operand=Constant(value=1))), ops=[Is()], comparators=[Constant(value=Ellipsis)])]), body=[If(test=Compare(left=Name(id='var_tuple_index'), ops=[IsNot()], comparators=[Constant(value=None)]), body=[Raise(exc=Call(func=Name(id='TypeError'), args=[Constant(value='More than one unpacked arbitrary-length tuple argument')]))]), Assign(targets=[Name(id='var_tuple_index', ctx=Store())], value=Name(id='k')), Assign(targets=[Name(id='fillarg', ctx=Store())], value=Subscript(value=Name(id='subargs'), slice=Constant(value=0)))])])]), If(test=Compare(left=Name(id='var_tuple_index'), ops=[IsNot()], comparators=[Constant(value=None)]), body=[Assign(targets=[Name(id='