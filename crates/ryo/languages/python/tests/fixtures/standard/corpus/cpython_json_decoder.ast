| None              |\n    +---------------+-------------------+\n\n    It also understands ``NaN``, ``Infinity``, and ``-Infinity`` as\n    their corresponding ``float`` values, which is outside the JSON spec.\n\n    ')), FunctionDef(name='__init__', args=arguments(args=[arg(arg='self')], kwonlyargs=[arg(arg='object_hook'), arg(arg='parse_float'), arg(arg='parse_int'), arg(arg='parse_constant'), arg(arg='strict'), arg(arg='object_pairs_hook')], kw_defaults=[Constant(value=None), Constant(value=None), Constant(value=None), Constant(value=None), Constant(value=True), Constant(value=None)]), body=[Expr(value=Constant(value="``object_hook``, if specified, will be called with the result\n        of every JSON object decoded and its return value will be used in\n        place of the given ``dict``.  This can be used to provide custom\n        deserializations (e.g. to support JSON-RPC class hinting).\n\n        ``object_pairs_hook``, if specified will be called with the result of\n        every JSON object decoded with an ordered list of pairs.  The return\n        value of ``object_pairs_hook`` will be used instead of the ``dict``.\n        This feature can be used to implement custom decoders.\n        If ``object_hook`` is also defined, the ``object_pairs_hook`` takes\n        priority.\n\n        ``parse_float``, if specified, will be called with the string\n        of every JSON float to be decoded. By default this is equivalent to\n        float(num_str). This can be used to use another datatype or parser\n        for JSON floats (e.g. decimal.Decimal).\n\n        ``parse_int``, if specified, will be called with the string\n        of every JSON int to be decoded. By default this is equivalent to\n        int(num_str). This can be used to use another datatype or parser\n        for JSON integers (e.g. float).\n\n        ``parse_constant``, if specified, will be called with one of the\n        following strings: -Infinity, Infinity, NaN.\n        This can be used to raise an exception if invalid JSON numbers\n        are encountered.\n\n        If ``strict`` is false (true is the default), then control\n        characters will be allowed inside strings.  Control characters in\n        this context are those with character codes in the 0-31 range,\n        including ``'\\t'`` (tab), ``'\\n'``, ``'\\r'`` and ``'\\0'``.\n        ")), Assign(targets=[Attribute(value=Name(id='self'), attr='object_hook', ctx=Store())], value=Name(id='object_hook')), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_float', ctx=Store())], value=BoolOp(op=Or(), values=[Name(id='parse_float'), Name(id='float')])), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_int', ctx=Store())], value=BoolOp(op=Or(), values=[Name(id='parse_int'), Name(id='int')])), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_constant', ctx=Store())], value=BoolOp(op=Or(), values=[Name(id='parse_constant'), Attribute(value=Name(id='_CONSTANTS'), attr='__getitem__')])), Assign(targets=[Attribute(value=Name(id='self'), attr='strict', ctx=Store())], value=Name(id='strict')), Assign(targets=[Attribute(value=Name(id='self'), attr='object_pairs_hook', ctx=Store())], value=Name(id='object_pairs_hook')), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_object', ctx=Store())], value=Name(id='JSONObject')), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_array', ctx=Store())], value=Name(id='JSONArray')), Assign(targets=[Attribute(value=Name(id='self'), attr='parse_string', ctx=Store())], value=Name(id='scanstring')), Assign(targets=[Attribute(value=Name(id='self'), attr='memo', ctx=Store())], value=Dict()), Assign(targets=[Attribute(value=Name(id='self'), attr='scan_once', ctx=Store())], value=Call(func=Attribute(value=Name(id='scanner'), attr='make_scanner'), args=[Name(id='self')]))]), FunctionDef(name='decode', args=arguments(args=[arg(arg='self'), arg(arg='s'), arg(arg='_w')], defaults=[Attribute(value=Name(id='WHITESPACE'), attr='match')]), body=[Expr(value=Constant(value='Return the Python representation of ``s`` (a ``str`` instance\n        containing a JSON document).\n\n        ')), Assign(targets=[Tuple(elts=[Name(id='obj', ctx=Store()), Name(id='end', ctx=Store())], ctx=Store())], value=Call(func=Attribute(value=Name(id='self'), attr='raw_decode'), args=[Name(id='s')], keywords=[keyword(arg='idx', value=Call(func=Attribute(value=Call(func=Name(id='_w'), args=[Name(id='s'), Constant(value=0)]), attr='end')))])), Assign(targets=[Name(id='end', ctx=Store())], value=Call(func=Attribute(value=Call(func=Name(id='_w'), args=[Name(id='s'), Name(id='end')]), attr='end'))), If(test=Compare(left=Name(id='end'), ops=[NotEq()], comparators=[Call(func=Name(id='len'), args=[Name(id='s')])]), body=[Raise(exc=Call(func=Name(id='JSONDecodeError'), args=[Constant(value='Extra data'), Name(id='s'), Name(id='end')]))]), Return(value=Name(id='obj'))]), FunctionDef(name='raw_decode', args=arguments(args=[arg(arg='self'), arg(arg='s'), arg(arg='idx')], defaults=[Constant(value=0)]), body=[Expr(value=Constant(value='Decode a JSON document from ``s`` (a ``str`` beginning with\n        a JSON document) and return a 2-tuple of the Python\n        representation and the index in ``s`` where the document ended.\n\n        This can be used to decode a JSON document from a string that may\n        have extraneous data at the end.\n\n        ')), Try(body=[Assign(targets=[Tuple(elts=[Name(id='obj', ctx=Store()), Name(id='end', ctx=Store())], ctx=Store())], value=Call(func=Attribute(value=Name(id='self'), attr='scan_once'), args=[Name(id='s'), Name(id='idx')]))], handlers=[ExceptHandler(type=Name(id='StopIteration'), name='err', body=[Raise(exc=Call(func=Name(id='JSONDecodeError'), args=[Constant(value='Expecting value'), Name(id='s'), Attribute(value=Name(id='err'), attr='value')]), cause=Constant(value=None))])]), Return(value=Tuple(elts=[Name(id='obj'), Name(id='end')]))])])])
