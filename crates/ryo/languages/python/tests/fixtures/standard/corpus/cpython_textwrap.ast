)\n        and split() will convert that to [..., "foo.", " ", "Bar", ...]\n        which has one too few spaces; this method simply changes the one\n        space to two.\n        ')), Assign(targets=[Name(id='i', ctx=Store())], value=Constant(value=0)), Assign(targets=[Name(id='patsearch', ctx=Store())], value=Attribute(value=Attribute(value=Name(id='self'), attr='sentence_end_re'), attr='search')), While(test=Compare(left=Name(id='i'), ops=[Lt()], comparators=[BinOp(left=Call(func=Name(id='len'), args=[Name(id='chunks')]), op=Sub(), right=Constant(value=1))]), body=[If(test=BoolOp(op=And(), values=[Compare(left=Subscript(value=Name(id='chunks'), slice=BinOp(left=Name(id='i'), op=Add(), right=Constant(value=1))), ops=[Eq()], comparators=[Constant(value=' ')]), Call(func=Name(id='patsearch'), args=[Subscript(value=Name(id='chunks'), slice=Name(id='i'))])]), body=[Assign(targets=[Subscript(value=Name(id='chunks'), slice=BinOp(left=Name(id='i'), op=Add(), right=Constant(value=1)), ctx=Store())], value=Constant(value='  ')), AugAssign(target=Name(id='i', ctx=Store()), op=Add(), value=Constant(value=2))], orelse=[AugAssign(target=Name(id='i', ctx=Store()), op=Add(), value=Constant(value=1))])])]), FunctionDef(name='_handle_long_word', args=arguments(args=[arg(arg='self'), arg(arg='reversed_chunks'), arg(arg='cur_line'), arg(arg='cur_len'), arg(arg='width')]), body=[Expr(value=Constant(value='_handle_long_word(chunks : [string],\n                             cur_line : [string],\n                             cur_len : int, width : int)\n\n        Handle a chunk of text (most likely a word, not whitespace) that\n        is too long to fit in any line.\n        ')), If(test=Compare(left=Name(id='width'), ops=[Lt()], comparators=[Constant(value=1)]), body=[Assign(targets=[Name(id='space_left', ctx=Store())], value=Constant(value=1))], orelse=[Assign(targets=[Name(id='space_left', ctx=Store())], value=BinOp(left=Name(id='width'), op=Sub(), right=Name(id='cur_len')))]), If(t