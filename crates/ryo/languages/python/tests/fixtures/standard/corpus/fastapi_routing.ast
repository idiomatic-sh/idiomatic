d')])]), body=[Expr(value=Constant(value='\n        Add a *path operation* using an HTTP PUT operation.\n\n        ## Example\n\n        ```python\n        from fastapi import APIRouter, FastAPI\n        from pydantic import BaseModel\n\n        class Item(BaseModel):\n            name: str\n            description: str | None = None\n\n        app = FastAPI()\n        router = APIRouter()\n\n        @router.put("/items/{item_id}")\n        def replace_item(item_id: str, item: Item):\n            return {"message": "Item replaced", "id": item_id}\n\n        app.include_router(router)\n        ```\n        ')), Return(value=Call(func=Attribute(value=Name(id='self'), attr='api_route'), keywords=[keyword(arg='path', value=Name(id='path')), keyword(arg='response_model', value=Name(id='response_model')), keyword(arg='status_code', value=Name(id='status_code')), keyword(arg='tags', value=Name(id='tags')), keyword(arg='dependencies', value=Name(id='dependencies')), keyword(arg='summary', value=Name(id='summary')), keyword(arg='description', value=Name(id='description')), keyword(arg='response_description', value=Name(id='response_description')), keyword(arg='responses', value=Name(id='responses')), keyword(arg='deprecated', value=Name(id='deprecated')), keyword(arg='methods', value=List(elts=[Constant(value='PUT')])), keyword(arg='operation_id', value=Name(id='operation_id')), keyword(arg='response_model_include', value=Name(id='response_model_include')), keyword(arg='response_model_exclude', value=Name(id='response_model_exclude')), keyword(arg='response_model_by_alias', value=Name(id='response_model_by_alias')), keyword(arg='response_model_exclude_unset', value=Name(id='response_model_exclude_unset')), keyword(arg='response_model_exclude_defaults', value=Name(id='response_model_exclude_defaults')), keyword(arg='response_model_exclude_none', value=Name(id='response_model_exclude_none')), keyword(arg='include_in_schema', value=Name(id='include_in_schema')), keyword(arg='re