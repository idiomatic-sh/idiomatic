+/// Whether this statement enables postponed annotations for subsequent definitions.
+fn future_annotations_import(statement: &Stmt) -> bool {
+    let Stmt::ImportFrom(import) = statement else {
+        return false;
+    };
+    !import.is_lazy
+        && import
+            .module
+            .as_ref()
+            .is_some_and(|name| name.as_str() == "__future__")
+        && import
+            .names
+            .iter()
+            .any(|alias| alias.name.as_str() == "annotations")
 }
 
