+/// Syntax constraints follow annotation position, configured version, and future-import form.
+#[test]
+fn annotation_constraints_distinguish_assignments_signatures_and_generics() {
+    let cases: &[(&str, PythonSourceKind, PythonTargetVersion, &[(u32, u32)])] = &[
+        (
+            "from __future__ import annotations\nx:(value:=object)\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py310,
+            &[],
+        ),
+        (
+            "x:(value:=object)\n",
+            PythonSourceKind::Stub,
+            PythonTargetVersion::Py310,
+            &[],
+        ),
+        (
+            "from __future__ import annotations\nx:f\"{(value:=object)}\"\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py310,
+            &[],
+        ),
+        (
+            "x:(value:=object)\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py314,
+            &[(3, 16)],
+        ),
+        (
+            "def f[T](x:(value:=object)): ...\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py312,
+            &[(12, 25)],
+        ),
+        (
+            "class C[T]((value:=object)): ...\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py312,
+            &[(12, 25)],
+        ),
+        (
+            "def f[T:(value:=object)](): ...\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py312,
+            &[(9, 22)],
+        ),
+        (
+            "type Alias=(value:=object)\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py312,
+            &[(12, 25)],
+        ),
+        (
+            "from .__future__ import annotations\ndef f(x:(value:=object)): ...\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py310,
+            &[(45, 58)],
+        ),
+        (
+            "lazy from __future__ import annotations\ndef f(x:(value:=object)): ...\n",
+            PythonSourceKind::Python,
+            PythonTargetVersion::Py310,
+            &[(0, 4), (0, 39)],
+        ),
+    ];
+    for (source, source_kind, target, expected) in cases {
+        let (mut elements, mut symbols) = (Elements::default(), Symbols::default());
+        let mut builder =
+            languages::table_builder(&mut elements, &mut symbols, ByteSlice(source.as_bytes()));
+        SyntaxRuffPythonParserAdapter.read(
+            SourceText(source.as_bytes()),
+            *source_kind,
+            &PythonParserSettings::new(*target),
+            &mut builder,
+        );
+        let mut actual = languages::diagnostics(&elements)
+            .map(|diagnostic| (diagnostic.start.0, diagnostic.end.0))
+            .collect::<Vec<_>>();
+        actual.sort_unstable();
+        let mut expected = expected.to_vec();
+        expected.sort_unstable();
+        assert_eq!(actual, expected, "{source}");
+        assert!(!languages::has_incomplete_syntax(&elements), "{source}");
+    }
+}
