+/// Pinned Ruff controls cover statement/handler snapshots, nested imports, and preserved facts.
+#[test]
+fn postponed_annotation_diagnostics_follow_import_order_and_definition_snapshots() {
+    let cases: &[(&str, PythonSourceKind, &[(u32, u32)])] = &[
+        (
+            "def f(x:(value:=object)):\n global value\n nonlocal value\nfrom __future__ import annotations\n",
+            PythonSourceKind::Python,
+            &[],
+        ),
+        (
+            "from __future__ import annotations\ndef f(x:(value:=object)):\n pass\n",
+            PythonSourceKind::Python,
+            &[(44, 57)],
+        ),
+        (
+            "def early(x:(value:=object)): pass\nfrom __future__ import annotations\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(83, 96)],
+        ),
+        (
+            "def early():\n def inner(x:(value:=object)): pass\nfrom __future__ import annotations\n",
+            PythonSourceKind::Python,
+            &[],
+        ),
+        (
+            "def f(x:(value:=object)): ...\nfrom __future__ import annotations\n",
+            PythonSourceKind::Stub,
+            &[(9, 22)],
+        ),
+        (
+            "class C:\n def f(x:(value:=object)): pass\nfrom __future__ import annotations\n",
+            PythonSourceKind::Python,
+            &[],
+        ),
+        (
+            "def outer():\n from __future__ import annotations\n def inner(x:(value:=object)): pass\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(63, 76)],
+        ),
+        (
+            "class C:\n from __future__ import annotations\n def f(x:(value:=object)): pass\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(55, 68)],
+        ),
+        (
+            "if True:\n from __future__ import annotations\n def inner(x:(value:=object)): pass\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(59, 72)],
+        ),
+        (
+            "for item in []:\n from __future__ import annotations\n def inner(x:(value:=object)): pass\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(66, 79)],
+        ),
+        (
+            "try:\n pass\nexcept Exception:\n from __future__ import annotations\n def inner(x:(value:=object)): pass\nfinally:\n def final(x:(other:=object)): pass\ndef later(x:(last:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(79, 92)],
+        ),
+        (
+            "try:\n from __future__ import annotations\n def inner(x:(value:=object)): pass\nexcept Exception:\n def handler(x:(error:=object)): pass\ndef later(x:(other:=object)): pass\n",
+            PythonSourceKind::Python,
+            &[(55, 68), (111, 124)],
+        ),
+    ];
+    for (source, source_kind, expected) in cases {
+        let (mut elements, mut symbols) = (Elements::default(), Symbols::default());
+        let mut builder =
+            languages::table_builder(&mut elements, &mut symbols, ByteSlice(source.as_bytes()));
+        SyntaxRuffPythonParserAdapter.read(
+            SourceText(source.as_bytes()),
+            *source_kind,
+            &PythonParserSettings::new(PythonTargetVersion::Py310),
+            &mut builder,
+        );
+        let actual = languages::diagnostics(&elements)
+            .map(|diagnostic| {
+                assert_eq!(diagnostic.impact, TreeImpact::Preserved);
+                (diagnostic.start.0, diagnostic.end.0)
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(actual.as_slice(), *expected, "{source}");
+        assert_eq!(
+            languages::syntax_acceptance(&elements),
+            languages::SyntaxAcceptance::Accepted
+        );
+        assert!(!languages::has_incomplete_syntax(&elements));
+    }
+}
