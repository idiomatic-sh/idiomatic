├─43  paragraph[15]
│     ├─0  text "Categories can be freely mixed with linter groups, linter prefixes, rule codes, and rule names. In\naddition to the priority relationships described above for settings like "
│     ├─1  inlineCode "lint.select"
│     ├─2  text ",\n"
│     ├─3  inlineCode "lint.extend-select"
│     ├─4  text ", and "
