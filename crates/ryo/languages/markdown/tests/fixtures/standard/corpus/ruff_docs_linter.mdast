│     │       ├─0 strong[1]
│     │       │   └─0 text "Complexity"
│     │       └─1 text ": These rules detect code that can be written in a simpler or more readable way\nwithout changing its semantics."
│     ├─3 listItem[1]
│     │   │ spread: false
│     │   │ checked: null
│     │   └─0 paragraph[2]
│     │       ├─0 strong[1]
│     │       │   └─0 text "Performance"
