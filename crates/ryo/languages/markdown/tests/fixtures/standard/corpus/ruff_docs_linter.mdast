│     ├─4 listItem[1]
│     │   │ spread: false
│     │   │ checked: null
│     │   └─0 paragraph[2]
│     │       ├─0 strong[1]
│     │       │   └─0 text "Style"
│     │       └─1 text ": These rules flag code that could be written more idiomatically and where the relevant\nidiom has broad community acceptance."
│     ├─5 listItem[1]
│     │   │ spread: false
