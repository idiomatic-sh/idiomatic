│     ├─9  inlineCode ".ruff.toml"
│     ├─10 text " versions, the "
│     ├─11 inlineCode "[tool.ruff]"
│     ├─12 text " header and\n"
│     ├─13 inlineCode "tool.ruff"
│     └─14 text " section prefix is omitted)."
