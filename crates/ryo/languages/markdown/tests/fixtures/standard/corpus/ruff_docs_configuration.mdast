│     │   └─0 paragraph[11]
│     │       ├─0  text "If a configuration file is passed directly via "
│     │       ├─1  inlineCode "--config"
│     │       ├─2  text ", those settings are used for "
│     │       ├─3  emphasis[1]
│     │       │    └─0 text "all"
│     │       ├─4  text "\nanalyzed files, and any relative paths in that configuration file (like "
