│     ├─2 listItem[1]
│     │   │ spread: false
│     │   │ checked: null
│     │   └─0 paragraph[9]
│     │       ├─0 text "If no config file is found in the filesystem hierarchy, Ruff will fall back to using\na default configuration. If a user-specific configuration file exists\nat "
│     │       ├─1 inlineCode "${config_dir}/ruff/pyproject.toml"
│     │       ├─2 text ", that file will be used instead of the default\nconfiguration, with "
│     │       ├─3 inlineCode "${config_dir}"
│     │       ├─4 text " being determined via "
