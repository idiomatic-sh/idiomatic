├─109 heading[1]
│     │ depth: 2
│     └─0 text "Shell autocompletion"
├─110 paragraph[17]
│     ├─0  text "Ruff supports autocompletion for most shells. A shell-specific completion script can be generated\nby "
│     ├─1  inlineCode "ruff generate-shell-completion <SHELL>"
│     ├─2  text ", where "
│     ├─3  inlineCode "<SHELL>"
│     ├─4  text " is one of "
│     ├─5  inlineCode "bash"
│     ├─6  text ", "
│     ├─7  inlineCode "elvish"
│     ├─8  text ", "
│     ├─9  inlineCode "fig"
│     ├─10 text ", "
│     ├─11 inlineCode "fish"
│     ├─12 text ",\n"
│     ├─13 inlineCode "powershell"
│     ├─14 text ", or "
│     ├─15 inlineCode "zsh"
│     └─16 text "."
├─111 paragraph[1]
│     └─0 text "!!! tip"
├─112 code "You can run `echo $SHELL` to help you determine your shell."
│       lang: null
│       meta: null
├─113 paragraph[1]
│     └─0 text "To enable shell autocompletion for Ruff, run one of the following:"
├─114 paragraph[1]
│     └─0 text "=== \"Bash\""
├─115 code "```bash\necho 'eval \"$(ruff generate-shell-completion bash)\"' >> ~/.bashrc\n```"
│       lang: null
│       meta: null
├─116 paragraph[1]
│     └─0 text "=== \"Zsh\""
├─117 code "```bash\necho 'eval \"$(ruff generate-shell-completion zsh)\"' >> ~/.zshrc\n```"
│       lang: null
│       meta: null
├─118 paragraph[1]
