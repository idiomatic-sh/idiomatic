├─116 paragraph[3]
│     ├─0 text "By default, or when targeting Python versions below 3.12, Ruff alternates quote styles for nested\nf-strings, starting with the "
│     ├─1 linkReference[1]
│     │   │ label: "configured quote style"
│     │   │ identifier: "configured quote style"
