│     │   │ title: null
│     │   │ url: "configuration.md"
│     │   └─0 emphasis[1]
│     │       └─0 text "Configuring Ruff"
│     └─6 text "."
├─24  paragraph[3]
│     ├─0 text "Given the focus on Black compatibility (and unlike formatters like "
│     ├─1 link[1]
│     │   │ title: null
│     │   │ url: "https://github.com/google/yapf"
│     │   └─0 text "YAPF"
