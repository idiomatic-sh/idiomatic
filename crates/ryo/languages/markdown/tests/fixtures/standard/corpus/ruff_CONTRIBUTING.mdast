├─137 heading[1]
│     │ depth: 4
│     └─0 text "Benchmark-driven Development"
├─138 paragraph[9]
│     ├─0 text "Ruff uses "
│     ├─1 link[1]
│     │   │ title: null
│     │   │ url: "https://bheisler.github.io/criterion.rs/book/"
│     │   └─0 text "Criterion.rs"
│     ├─2 text " for benchmarks. You can use\n"
│     ├─3 inlineCode "--save-baseline=<name>"
│     ├─4 text " to store an initial baseline benchmark (e.g., on "
│     ├─5 inlineCode "main"
│     ├─6 text ") and then use\n"
│     ├─7 inlineCode "--benchmark=<name>"
│     └─8 text " to compare against that benchmark. Criterion will print a message telling you\nif the benchmark improved/regressed compared to that baseline."
├─139 code "# Run once on your \"baseline\" code\ncargo bench -p ruff_benchmark -- --save-baseline=main\n\n# Then iterate with\ncargo bench -p ruff_benchmark -- --baseline=main"
│       lang: "shell"
│       meta: null
├─140 heading[1]
│     │ depth: 4
│     └─0 text "PR Summary"
├─141 paragraph[5]
│     ├─0 text "You can use "
