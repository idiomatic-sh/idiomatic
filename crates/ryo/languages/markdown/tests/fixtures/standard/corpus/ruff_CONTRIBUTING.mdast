│     │   └─0 paragraph[4]
│     │       ├─0 strong[1]
│     │       │   └─0 text "Explicit settings"
│     │       ├─1 text ": the import is marked as such via the "
│     │       ├─2 inlineCode "known-first-party"
│     │       └─3 text " setting. (This\nshould generally be seen as an escape hatch.)"
│     ├─1 listItem[1]
│     │   │ spread: false
│     │   │ checked: null
