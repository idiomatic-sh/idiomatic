│     │   │ title: null
│     │   │ url: "https://docs.astral.sh/uv/getting-started/installation/"
│     │   └─0 text "uv"
│     └─2 text " to\nrun Python utility commands. uv also manages our development toolchain."
├─23  paragraph[3]
│     ├─0 text "We use "
│     ├─1 link[1]
│     │   │ title: null
│     │   │ url: "https://insta.rs/docs/"
│     │   └─0 text "Insta"
│     └─2 text " to update snapshot tests. It's already part\nof the development toolchain:"
├─24  code "uv run --only-dev cargo insta --version"
│       lang: "shell"
│       meta: null
