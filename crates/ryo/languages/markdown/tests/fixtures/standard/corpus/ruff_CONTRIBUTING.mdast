│     └─0 text "You can optionally install hooks to automatically run the validation checks\nwhen making a commit:"
├─26  code "uv run --only-dev --locked prek install"
│       lang: "shell"
│       meta: null
├─27  paragraph[9]
│     ├─0 text "We recommend "
