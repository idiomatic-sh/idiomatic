import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constant_values from "typescript/oxlint/constant-values";
let nodes = select id, file, span, kind from "semantic-syntax";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let then_names = select id, file, span from names where name = "then";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let then_strings = select occurrence as id from "string-literal" where value = "then";
let template_literals = select id, file, span from "semantic-syntax" where kind = "template-literal";
let then_tokens = select file, span from "semantic-syntax" where kind = "template" and text = "\x60then\x60";
let then_templates = select l.id as id from template_literals as l join then_tokens as r on l.file = r.file and l.span = r.span;
let references = select reference, file from "binding-read";
let values = constant_values(references=references);
let string_values = select l.reference as reference, l.value as value from values as l join then_strings as r on l.value = r.id;
let string_value_rows = select l.reference as reference, l.value as id, r.file as file, r.span as span from string_values as l join "semantic-syntax" as r on l.value = r.id;
let value_candidates = select id, file, span from string_value_rows;
let wrapped_values = parenthesized(candidates=value_candidates);
let followed = antijoin(left=string_value_rows, right=wrapped_values, left-on=["id"], right-on=["id"]);
let constant_thens = select reference as node, id as reported from followed;
let literal_strings = select id as node, id as reported from then_strings;
let literal_templates = select id as node, id as reported from then_templates;
let literal_thens = union(left=literal_strings, right=literal_templates);
let thens = union(left=literal_thens, right=constant_thens);
let keyed_kinds = select id from "semantic-syntax" where kind = "property" or kind = "method-definition" or kind = "property-definition" or kind = "ts-abstract-method-definition" or kind = "ts-abstract-property-definition";
let keys = select l.parent as member, l.child as key from "semantic-child" as l join keyed_kinds as r on l.parent = r.id where l.field = "key";
let object_properties = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "properties" and r.kind = "object-expression";
let object_keys = select l.member as member, l.key as key from keys as l join "semantic-syntax" as r on l.member = r.id where r.kind != "property";
let property_keys = select l.member as member, l.key as key from keys as l join object_properties as r on l.member = r.id;
let member_keys = union(left=object_keys, right=property_keys);
let static_keys = antijoin(left=member_keys, right=computed, left-on=["member"], right-on=["id"]);
let static_key_hits = select l.key as id, r.file as file, r.span as span from static_keys as l join then_names as r on l.key = r.id;
let valued_keys = select l.key as id, r.reported as reported from member_keys as l join thens as r on l.key = r.node;
let assignments = select id from "semantic-syntax" where kind = "assignment-expression";
let assigned = select l.child as member from "semantic-child" as l join assignments as r on l.parent = r.id where l.field = "left";
let assigned_members = select l.member as member, r.file as file, r.span as span from assigned as l join "semantic-syntax" as r on l.member = r.id where r.kind = "member-expression";
let assigned_properties = select l.member as member, l.file as file, l.span as span, r.child as property from assigned_members as l join "semantic-child" as r on l.member = r.parent where r.field = "property";
let static_assigned = antijoin(left=assigned_properties, right=computed, left-on=["member"], right-on=["id"]);
let static_assigned_hits = select l.member as id, l.file as file, l.span as span from static_assigned as l join then_names as r on l.property = r.id;
let computed_assigned = select l.member as member, l.property as property from assigned_properties as l join computed as r on l.member = r.id;
let valued_assigned = select l.member as id, r.reported as reported from computed_assigned as l join thens as r on l.property = r.node;
let exports = select id from "semantic-syntax" where kind = "export-named-declaration";
let exported_declarations = select l.child as declaration from "semantic-child" as l join exports as r on l.parent = r.id where l.field = "declaration";
let named_declarations = select l.declaration as declaration from exported_declarations as l join "semantic-syntax" as r on l.declaration = r.id where r.kind = "function-declaration" or r.kind = "class-declaration" or r.kind = "ts-declare-function";
let declaration_ids = select l.child as id from "semantic-child" as l join named_declarations as r on l.parent = r.declaration where l.field = "id";
let declaration_hits = select r.id as id, r.file as file, r.span as span from declaration_ids as l join then_names as r on l.id = r.id;
let exported_declarators = select l.child as declarator from "semantic-child" as l join exported_declarations as r on l.parent = r.declaration where l.field = "declarations";
let exported_bindings = select l.declarator as id, r.file as file, r.span as span from exported_declarators as l join "defines" as r on l.declarator = r.id where r.name = "then";
let binding_bounds = span-bounds(from=exported_bindings, span="span", start-output="begin", end-output="finish");
let token_rows = select file, span from "semantic-syntax" where kind = "identifier-token" and text = "then";
let token_bounds = span-bounds(from=token_rows, span="span", start-output="tbegin", end-output="tfinish");
let binding_hits = select l.id as id, l.file as file, r.span as span from binding_bounds as l join token_bounds as r on l.file = r.file and l.begin = r.tbegin;
let specifiers = select l.child as specifier from "semantic-child" as l join exports as r on l.parent = r.id where l.field = "specifiers";
let exported_names = select l.child as id from "semantic-child" as l join specifiers as r on l.parent = r.specifier where l.field = "exported";
let specifier_name_hits = select r.id as id, r.file as file, r.span as span from exported_names as l join then_names as r on l.id = r.id;
let specifier_string_hits = select l.id as id from exported_names as l join then_strings as r on l.id = r.id;
let specifier_string_rows = select r.id as id, r.file as file, r.span as span from specifier_string_hits as l join "semantic-syntax" as r on l.id = r.id;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let call_callees = select l.parent as call, l.child as callee from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "callee";
let callee_members = select l.call as call, l.callee as callee from call_callees as l join "semantic-syntax" as r on l.callee = r.id where r.kind = "member-expression";
let plain_members = antijoin(left=callee_members, right=optional, left-on=["callee"], right-on=["id"]);
let callee_objects = select l.call as call, l.callee as callee, r.child as object from plain_members as l join "semantic-child" as r on l.callee = r.parent where r.field = "object";
let object_names = select l.call as call, l.callee as callee, r.name as object from callee_objects as l join names as r on l.object = r.id;
let callee_properties = select l.call as call, l.callee as callee, l.object as object, r.child as property from object_names as l join "semantic-child" as r on l.callee = r.parent where r.field = "property";
let static_callees = antijoin(left=callee_properties, right=computed, left-on=["callee"], right-on=["id"]);
let static_methods = select l.call as call, l.object as object, r.name as method from static_callees as l join names as r on l.property = r.id;
let computed_callees = select l.call as call, l.object as object, l.property as property from callee_properties as l join computed as r on l.callee = r.id;
let computed_methods = select l.call as call, l.object as object, r.value as method from computed_callees as l join "string-literal" as r on l.property = r.occurrence;
let methods = union(left=static_methods, right=computed_methods);
let define_calls = select call from methods where (object = "Object" or object = "Reflect") and method = "defineProperty";
let entry_calls = select call from methods where object = "Object" and method = "fromEntries";
let arguments = select parent as call, child as argument, ordinal from "semantic-child" where field = "arguments";
let earlier = select l.call as call, l.argument as argument from arguments as l join arguments as r on l.call = r.call where r.ordinal < l.ordinal;
let earlier_counts = group-count(from=earlier, keys=["call", "argument"], count="earlier");
let first_arguments = antijoin(left=arguments, right=earlier, left-on=["call", "argument"], right-on=["call", "argument"]);
let second_arguments = select l.call as call, l.argument as argument from arguments as l join earlier_counts as r on l.call = r.call and l.argument = r.argument where r.earlier = 1;
let third_arguments = select call from earlier_counts where earlier = 2;
let argument_kinds = select l.call as call, l.argument as argument, r.kind as kind from first_arguments as l join nodes as r on l.argument = r.id;
let spread_first = select call from argument_kinds where kind = "spread-element";
let long_defines = select l.call as call from define_calls as l join third_arguments as r on l.call = r.call;
let checked_defines = antijoin(left=long_defines, right=spread_first, left-on=["call"], right-on=["call"]);
let define_names = select l.argument as argument from second_arguments as l join checked_defines as r on l.call = r.call;
let valued_defines = select l.argument as id, r.reported as reported from define_names as l join thens as r on l.argument = r.node;
let argument_counts = group-count(from=arguments, keys=["call"], count="arguments");
let single_entries = select l.call as call from entry_calls as l join argument_counts as r on l.call = r.call where r.arguments = 1;
let entry_lists = select l.argument as list from first_arguments as l join single_entries as r on l.call = r.call;
let entry_arrays = select l.list as list from entry_lists as l join nodes as r on l.list = r.id where r.kind = "array-expression";
let elements = select parent as array, child as element, ordinal from "semantic-child" where field = "elements";
let entries = select l.element as entry from elements as l join entry_arrays as r on l.array = r.list;
let entry_rows = select l.entry as entry from entries as l join nodes as r on l.entry = r.id where r.kind = "array-expression";
let entry_elements = select l.array as array, l.element as element, l.ordinal as ordinal from elements as l join entry_rows as r on l.array = r.entry;
let trailing_elements = select l.array as array, l.element as element from entry_elements as l join entry_elements as r on l.array = r.array where r.ordinal < l.ordinal;
let entry_keys = antijoin(left=entry_elements, right=trailing_elements, left-on=["array", "element"], right-on=["array", "element"]);
let valued_entries = select l.element as id, r.reported as reported from entry_keys as l join thens as r on l.element = r.node;
let valued_a = union(left=valued_keys, right=valued_assigned);
let valued_b = union(left=valued_a, right=valued_defines);
let valued = union(left=valued_b, right=valued_entries);
let valued_hits = select l.id as id, r.file as file, r.span as span from valued as l join "semantic-syntax" as r on l.reported = r.id;
let hits_a = union(left=static_key_hits, right=static_assigned_hits);
let hits_b = union(left=hits_a, right=declaration_hits);
let hits_c = union(left=hits_b, right=binding_hits);
let hits_d = union(left=hits_c, right=specifier_name_hits);
let hits_e = union(left=hits_d, right=specifier_string_rows);
let found = union(left=hits_e, right=valued_hits);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-thenable(?:,|$)");
emit violations subject file key(id);
