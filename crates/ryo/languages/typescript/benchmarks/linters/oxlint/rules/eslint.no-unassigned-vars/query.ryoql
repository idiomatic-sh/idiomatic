import directives from "typescript/oxlint/eslint-directives";
let declared = select id, file, span from "defines" where kind = "variable" and refinement = "variable-declarator";
let plain = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "id" and r.kind = "identifier";
let plain_declared = select l.id as id, l.file as file, l.span as span from declared as l join plain as r on l.id = r.id;
let initialized = select parent as id from "semantic-child" where field = "init";
let bare = antijoin(left=plain_declared, right=initialized, left-on=["id"], right-on=["id"]);
let declarations = select child as id, parent as declaration from "semantic-child" where field = "declarations";
let declare_marks = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and r.text = "declare";
let ambient = select l.id as id from declarations as l join declare_marks as r on l.declaration = r.id;
let loop_heads = select l.child as declaration from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "for-statement" or r.kind = "for-in-statement" or r.kind = "for-of-statement";
let looped = select l.id as id from declarations as l join loop_heads as r on l.declaration = r.declaration;
let skipped = union(left=ambient, right=looped);
let local = antijoin(left=bare, right=skipped, left-on=["id"], right-on=["id"]);
let modules = select id from "semantic-syntax" where kind = "ts-module-declaration";
let local_rows = select id from local;
let in_modules = axis(from=local_rows, relation="semantic-child", direction=ancestor, domain=modules);
let outside = antijoin(left=local, right=in_modules, left-on=["id"], right-on=["id"]);
let uses = select binding, context from "binding-use";
let writes = select binding as id from uses where context = "write" or context = "read-write";
let value_reads = select binding as id from uses where context = "value";
let unwritten = antijoin(left=outside, right=writes, left-on=["id"], right-on=["id"]);
let read = select l.id as id, l.file as file, l.span as span from unwritten as l join value_reads as r on l.id = r.id;
let read_bounds = span-bounds(from=read, span="span", start-output="begin", end-output="finish");
let tokens = select id, file, span from "semantic-syntax" where kind = "identifier-token";
let token_bounds = span-bounds(from=tokens, span="span", start-output="tbegin", end-output="tfinish");
let found = select l.id as id, l.file as file, r.span as span from read_bounds as l join token_bounds as r on l.file = r.file and l.begin = r.tbegin;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unassigned-vars(?:,|$)");
emit violations subject file key(id);
