import directives from "typescript/oxlint/eslint-directives";
let chains = select id, file, span from "semantic-syntax" where kind = "chain-expression";
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let edges_all = select l.parent as outer, l.child as inner, l.field as field, l.ordinal as ordinal, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id;
let wrapper_edges = select inner, outer from edges_all where field = "expression" and (kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-type-assertion" or kind = "ts-non-null-expression" or kind = "ts-instantiation-expression");
let await_edges = select inner, outer from edges_all where field = "argument" and kind = "await-expression";
let logical_edges = select l.inner as inner, l.outer as outer from edges_all as l join operators as r on l.outer = r.id where l.kind = "logical-expression" and ((r.operator = "&&" and (l.field = "left" or l.field = "right")) or ((r.operator = "||" or r.operator = "??") and l.field = "right"));
let branch_edges = select inner, outer from edges_all where kind = "conditional-expression" and (field = "consequent" or field = "alternate");
let sequence_parts = select inner, outer, ordinal from edges_all where kind = "sequence-expression" and field = "expressions";
let earlier_parts = select l.inner as inner from sequence_parts as l join sequence_parts as r on l.outer = r.outer where l.ordinal < r.ordinal;
let last_parts = antijoin(left=sequence_parts, right=earlier_parts, left-on=["inner"], right-on=["inner"]);
let sequence_edges = select inner, outer from last_parts;
let edges_a = union(left=wrapper_edges, right=await_edges);
let edges_b = union(left=edges_a, right=logical_edges);
let edges_c = union(left=edges_b, right=branch_edges);
let edges = union(left=edges_c, right=sequence_edges);
let climbed = closure(edges=edges, source="inner", destination="outer");
let chain_positions = select l.id as chain, r.outer as position from chains as l join climbed as r on l.id = r.inner;
let chain_selves = select id as chain, id as position from chains;
let positions = union(left=chain_positions, right=chain_selves);
let slots = select l.chain as chain, r.outer as owner, r.field as field, r.kind as kind from positions as l join edges_all as r on l.position = r.inner;
let plain_owners = antijoin(left=slots, right=optional, left-on=["owner"], right-on=["id"]);
let called = select chain from plain_owners where (kind = "call-expression" and field = "callee") or (kind = "member-expression" and field = "object");
let constructed = select chain from slots where (kind = "new-expression" and field = "callee") or (kind = "tagged-template-expression" and field = "tag") or (kind = "for-of-statement" and field = "right") or (kind = "with-statement" and field = "object") or ((kind = "class-declaration" or kind = "class-expression") and field = "super-class");
let relational = select l.chain as chain from slots as l join operators as r on l.owner = r.id where l.kind = "binary-expression" and l.field = "right" and (r.operator = "in" or r.operator = "instanceof");
let patterns = select id from "semantic-syntax" where kind = "array-pattern" or kind = "object-pattern";
let pattern_lefts = select l.parent as id from "semantic-child" as l join patterns as r on l.child = r.id where l.field = "left" or l.field = "id";
let destructured_slots = select l.chain as chain, l.owner as owner from slots as l join pattern_lefts as r on l.owner = r.id where (l.kind = "assignment-expression" and l.field = "right") or (l.kind = "assignment-pattern" and l.field = "right") or (l.kind = "variable-declarator" and l.field = "init");
let parameters = select child as id from "semantic-child" where field = "params";
let destructured_all = antijoin(left=destructured_slots, right=parameters, left-on=["owner"], right-on=["id"]);
let destructured = select chain from destructured_all;
let array_spreads = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "array-expression" and l.field = "elements";
let spread_slots = select l.chain as chain from slots as l join array_spreads as r on l.owner = r.id where l.kind = "spread-element" and l.field = "argument";
let unsafe_a = union(left=called, right=constructed);
let unsafe_b = union(left=unsafe_a, right=relational);
let unsafe_c = union(left=unsafe_b, right=destructured);
let unsafe = union(left=unsafe_c, right=spread_slots);
let found = select r.id as id, r.file as file, r.span as span from unsafe as l join chains as r on l.chain = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unsafe-optional-chaining(?:,|$)");
emit violations subject file key(id);
