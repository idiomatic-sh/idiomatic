import directives from "typescript/oxlint/eslint-directives";
let finalizers = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "finalizer" and r.kind = "try-statement";
let finalizer_nodes = select r.id as block, r.file as file, r.span as span from finalizers as l join "semantic-syntax" as r on l.id = r.id;
let blocks = span-bounds(from=finalizer_nodes, span="span", start-output="begin", end-output="finish");
let jumps = select id, kind, file, span from "semantic-syntax" where kind = "return-statement" or kind = "throw-statement" or kind = "break-statement" or kind = "continue-statement";
let jump_bounds = span-bounds(from=jumps, span="span", start-output="begin", end-output="finish");
let inside = select l.id as id, l.kind as kind, l.file as file, l.span as span, l.begin as begin, l.finish as finish, r.block as block from jump_bounds as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let functions = select id as shelter, file, span from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression" or kind = "class-declaration" or kind = "class-expression";
let loops = select id as shelter, file, span from "semantic-syntax" where kind = "for-statement" or kind = "for-in-statement" or kind = "for-of-statement" or kind = "while-statement" or kind = "do-while-statement";
let switches = select id as shelter, file, span from "semantic-syntax" where kind = "switch-statement";
let function_bounds = span-bounds(from=functions, span="span", start-output="begin", end-output="finish");
let loop_bounds = span-bounds(from=loops, span="span", start-output="begin", end-output="finish");
let switch_bounds = span-bounds(from=switches, span="span", start-output="begin", end-output="finish");
let inner_functions = select l.shelter as shelter, l.file as file, l.begin as begin, l.finish as finish, r.block as block from function_bounds as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let inner_loops = select l.shelter as shelter, l.file as file, l.begin as begin, l.finish as finish, r.block as block from loop_bounds as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let inner_switches = select l.shelter as shelter, l.file as file, l.begin as begin, l.finish as finish, r.block as block from switch_bounds as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let label_names = select l.parent as id, r.name as label from "semantic-child" as l join names as r on l.child = r.id where l.field = "label";
let in_functions = select l.id as id, l.block as block from inside as l join inner_functions as r on l.block = r.block where l.begin >= r.begin and l.finish <= r.finish;
let unlabeled = antijoin(left=inside, right=label_names, left-on=["id"], right-on=["id"]);
let loop_jumps = select id, block, begin, finish from unlabeled where kind = "break-statement" or kind = "continue-statement";
let switch_jumps = select id, block, begin, finish from unlabeled where kind = "break-statement";
let in_loops = select l.id as id, l.block as block from loop_jumps as l join inner_loops as r on l.block = r.block where l.begin >= r.begin and l.finish <= r.finish;
let in_switches = select l.id as id, l.block as block from switch_jumps as l join inner_switches as r on l.block = r.block where l.begin >= r.begin and l.finish <= r.finish;
let labeled_statements = select id as shelter, file, span from "semantic-syntax" where kind = "labeled-statement";
let labeled_bounds = span-bounds(from=labeled_statements, span="span", start-output="begin", end-output="finish");
let labeled_named = select l.shelter as shelter, l.file as file, l.begin as begin, l.finish as finish, r.label as label from labeled_bounds as l join label_names as r on l.shelter = r.id;
let inner_labeled = select l.shelter as shelter, l.label as label, l.begin as begin, l.finish as finish, r.block as block from labeled_named as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.finish <= r.finish;
let labeled_jumps = select l.id as id, l.block as block, l.begin as begin, l.finish as finish, r.label as label from inside as l join label_names as r on l.id = r.id;
let in_labeled = select l.id as id, l.block as block from labeled_jumps as l join inner_labeled as r on l.block = r.block and l.label = r.label where l.begin >= r.begin and l.finish <= r.finish;
let sheltered_calls = union(left=in_functions, right=in_loops);
let sheltered_switches = union(left=sheltered_calls, right=in_switches);
let sheltered = union(left=sheltered_switches, right=in_labeled);
let unsafe = antijoin(left=inside, right=sheltered, left-on=["id", "block"], right-on=["id", "block"]);
let found = select id, file, span from unsafe;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unsafe-finally(?:,|$)");
emit violations subject file key(id);
