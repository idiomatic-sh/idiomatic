import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constant_values from "typescript/oxlint/constant-values";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let templates = select file, span, text from "semantic-syntax" where kind = "template";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let news = select id from "semantic-syntax" where kind = "new-expression";
let callees = select parent as call, child as callee from "semantic-child" where field = "callee";
let named_callees = select l.call as call, r.name as name from callees as l join names as r on l.callee = r.id;
let fetches = select l.call as call from named_callees as l join calls as r on l.call = r.id where l.name = "fetch";
let requests = select l.call as call from named_callees as l join news as r on l.call = r.id where l.name = "Request";
let requesting = union(left=fetches, right=requests);
let arguments = select l.parent as call, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join requesting as r on l.parent = r.call where l.field = "arguments";
let earlier = select l.call as call, l.argument as argument from arguments as l join arguments as r on l.call = r.call where r.ordinal < l.ordinal;
let earlier_counts = group-count(from=earlier, keys=["call", "argument"], count="earlier");
let seconds = select l.argument as argument from arguments as l join earlier_counts as r on l.call = r.call and l.argument = r.argument where r.earlier = 1;
let option_rows = select r.id as id, r.file as file, r.span as span from seconds as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "object-expression";
let wrapped_options = parenthesized(candidates=option_rows);
let options = antijoin(left=option_rows, right=wrapped_options, left-on=["id"], right-on=["id"]);
let properties = select l.parent as options, l.child as property, l.ordinal as ordinal from "semantic-child" as l join options as r on l.parent = r.id where l.field = "properties";
let spread_options = select l.options as id from properties as l join "semantic-syntax" as r on l.property = r.id where r.kind = "spread-element";
let static_properties = antijoin(left=properties, right=computed, left-on=["property"], right-on=["id"]);
let keys = select l.options as options, l.property as property, l.ordinal as ordinal, r.child as key from static_properties as l join "semantic-child" as r on l.property = r.parent where r.field = "key";
let named_keys = select l.options as options, l.property as property, l.ordinal as ordinal, r.id as key, r.file as file, r.span as span, r.name as name from keys as l join names as r on l.key = r.id;
let bodies = select options, property, ordinal, key, file, span from named_keys where name = "body";
let later_bodies = select l.options as options, l.property as property from bodies as l join bodies as r on l.options = r.options where r.ordinal > l.ordinal;
let last_bodies = antijoin(left=bodies, right=later_bodies, left-on=["options", "property"], right-on=["options", "property"]);
let body_values = select l.property as property, r.child as value from last_bodies as l join "semantic-child" as r on l.property = r.parent where r.field = "value";
let null_tokens = select file, span from "semantic-syntax" where kind = "null";
let literal_nodes = select id, file, span from "semantic-syntax" where kind = "literal";
let nulls = select l.id as id from literal_nodes as l join null_tokens as r on l.file = r.file and l.span = r.span;
let undefineds = select id from names where name = "undefined";
let voids = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.kind = "keyword" and r.text = "void";
let empty_a = union(left=nulls, right=undefineds);
let empty = union(left=empty_a, right=voids);
let empty_bodies = select l.property as property from body_values as l join empty as r on l.value = r.id;
let filled_bodies = antijoin(left=last_bodies, right=empty_bodies, left-on=["property"], right-on=["property"]);
let methods = select options, property, ordinal from named_keys where name = "method";
let method_values = select l.options as options, l.property as property, l.ordinal as ordinal, r.child as value from methods as l join "semantic-child" as r on l.property = r.parent where r.field = "value";
let method_strings = select l.property as property, r.value as text from method_values as l join "string-literal" as r on l.value = r.occurrence;
let method_value_rows = select l.property as property, r.file as file, r.span as span from method_values as l join "semantic-syntax" as r on l.value = r.id where r.kind = "template-literal";
let method_templates = select l.property as property, r.text as text from method_value_rows as l join templates as r on l.file = r.file and l.span = r.span;
let method_references = select l.property as property, r.reference as reference, r.file as file from method_values as l join "binding-read" as r on l.value = r.reference;
let references = select reference, file from method_references;
let values = constant_values(references=references);
let constant_methods = select l.property as property, r.value as value from method_references as l join values as r on l.reference = r.reference;
let constant_strings = select l.property as property, r.value as text from constant_methods as l join "string-literal" as r on l.value = r.occurrence;
let constant_rows = select l.property as property, r.file as file, r.span as span from constant_methods as l join "semantic-syntax" as r on l.value = r.id where r.kind = "template-literal";
let constant_templates = select l.property as property, r.text as text from constant_rows as l join templates as r on l.file = r.file and l.span = r.span;
let uses = select l.property as property, r.binding as binding from method_references as l join "binding-use" as r on l.reference = r.reference where r.certainty = "unique";
let declarators = select id from "semantic-syntax" where kind = "variable-declarator";
let other_bindings = antijoin(left=uses, right=declarators, left-on=["binding"], right-on=["id"]);
let annotations = select parent as binding, child as annotation from "semantic-child" where field = "type-annotation";
let annotated = select l.property as property, r.annotation as annotation from other_bindings as l join annotations as r on l.binding = r.binding;
let unannotated = antijoin(left=other_bindings, right=annotated, left-on=["property"], right-on=["property"]);
let annotation_types = select l.property as property, r.annotation as type from annotated as l join annotations as r on l.annotation = r.binding;
let literal_types = select l.property as property, r.id as type from annotation_types as l join "semantic-syntax" as r on l.type = r.id where r.kind = "ts-literal-type";
let literal_type_values = select l.property as property, r.child as literal from literal_types as l join "semantic-child" as r on l.type = r.parent;
let typed_strings = select l.property as property, r.value as text from literal_type_values as l join "string-literal" as r on l.literal = r.occurrence;
let strings_a = union(left=method_strings, right=constant_strings);
let strings = union(left=strings_a, right=typed_strings);
let quoted = union(left=method_templates, right=constant_templates);
let string_known = select property from strings;
let quoted_known = select property from quoted;
let kept = select property from unannotated;
let known_a = union(left=string_known, right=quoted_known);
let known = union(left=known_a, right=kept);
let string_forbidding = select property from strings where matches(text, "^(?i:get|head)$");
let quoted_forbidding = select property from quoted where matches(text, "^\x60(?i:get|head)\x60$");
let forbidding_a = union(left=string_forbidding, right=quoted_forbidding);
let forbidding = union(left=forbidding_a, right=kept);
let unknown_methods = antijoin(left=methods, right=known, left-on=["property"], right-on=["property"]);
let unknown_options = select options as id from unknown_methods;
let later_methods = select l.options as options, l.property as property from methods as l join methods as r on l.options = r.options where r.ordinal > l.ordinal;
let last_methods = antijoin(left=methods, right=later_methods, left-on=["options", "property"], right-on=["options", "property"]);
let allowing = antijoin(left=last_methods, right=forbidding, left-on=["property"], right-on=["property"]);
let allowing_options = select options as id from allowing;
let checked_a = antijoin(left=filled_bodies, right=spread_options, left-on=["options"], right-on=["id"]);
let checked_b = antijoin(left=checked_a, right=unknown_options, left-on=["options"], right-on=["id"]);
let checked = antijoin(left=checked_b, right=allowing_options, left-on=["options"], right-on=["id"]);
let found = select key as id, file, span from checked;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-invalid-fetch-options(?:,|$)");
emit violations subject file key(id);
