import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let nan_names = select id from names where name = "NaN";
let number_names = select id from names where name = "Number";
let members = select id from "semantic-syntax" where kind = "member-expression";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let static_members = antijoin(left=members, right=computed, left-on=["id"], right-on=["id"]);
let object_children = select l.parent as id from "semantic-child" as l join number_names as r on l.child = r.id where l.field = "object";
let number_objects = select l.id as id from static_members as l join object_children as r on l.id = r.id;
let property_children = select l.parent as id from "semantic-child" as l join nan_names as r on l.child = r.id where l.field = "property";
let number_nan = select l.id as id from number_objects as l join property_children as r on l.id = r.id;
let nan_operands = union(left=nan_names, right=number_nan);
let operators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "==" or r.text = "===" or r.text = "!=" or r.text = "!==" or r.text = "<" or r.text = ">" or r.text = "<=" or r.text = ">=");
let comparisons = select l.id as id from operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "binary-expression";
let compared = select c.child as id from comparisons as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let switches = select id from "semantic-syntax" where kind = "switch-statement" or kind = "switch-case";
let switched = select c.child as id from switches as l join "semantic-child" as c on l.id = c.parent where c.field = "discriminant" or c.field = "test";
let positions = union(left=compared, right=switched);
let hits = select l.id as id from positions as l join nan_operands as r on l.id = r.id;
let found = select r.id as id, r.file as file, r.span as span from hits as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?use-isnan(?:,|$)");
emit violations subject file key(id);
