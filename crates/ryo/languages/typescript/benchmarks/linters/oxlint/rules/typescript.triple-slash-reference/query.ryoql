import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let programs = select id, file, span from "semantic-syntax" where kind = "program";
let body = select l.parent as program, l.child as id, l.ordinal as ordinal from "semantic-child" as l join programs as r on l.parent = r.id where l.field = "body";
let body_rows = select l.program as program, l.id as id, l.ordinal as ordinal, r.kind as kind, r.file as file, r.span as span from body as l join "semantic-syntax" as r on l.id = r.id;
let statement_strings = select l.parent as id, r.id as expression, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "expression" and r.kind = "literal";
let string_tokens = select file, span from "semantic-syntax" where kind = "string";
let string_statements = select l.id as id, l.expression as expression, l.file as file, l.span as span from statement_strings as l join string_tokens as r on l.file = r.file and l.span = r.span;
let string_expressions = select expression as id, file, span from string_statements;
let wrapped_strings = parenthesized(candidates=string_expressions);
let bare_strings = antijoin(left=string_statements, right=wrapped_strings, left-on=["expression"], right-on=["id"]);
let prologue_shaped = select l.program as program, l.id as id, l.ordinal as ordinal from body_rows as l join bare_strings as r on l.id = r.id;
let other_statements = antijoin(left=body_rows, right=prologue_shaped, left-on=["id"], right-on=["id"]);
let interrupted = select l.id as id from prologue_shaped as l join other_statements as r on l.program = r.program where r.ordinal < l.ordinal;
let prologue = antijoin(left=prologue_shaped, right=interrupted, left-on=["id"], right-on=["id"]);
let statements = antijoin(left=body_rows, right=prologue, left-on=["id"], right-on=["id"]);
let statement_bounds = span-bounds(from=statements, span="span", start-output="begin", end-output="finish");
let later_statements = select l.id as id from statement_bounds as l join statement_bounds as r on l.program = r.program where r.begin < l.begin;
let first_statements = antijoin(left=statement_bounds, right=later_statements, left-on=["id"], right-on=["id"]);
let references = select id, file, span, text from "comment" where starts_with(text, "/") and matches(text, "<reference ");
let reference_bounds = span-bounds(from=references, span="span", start-output="begin", end-output="finish");
let late_references = select l.id as id from reference_bounds as l join first_statements as r on l.file = r.file where l.begin >= r.begin;
let header_references = antijoin(left=reference_bounds, right=late_references, left-on=["id"], right-on=["id"]);
let after_open = replace(from=header_references, text="text", pattern="(?s)^.*?<reference ", replacement="", output="after");
let closed = select id, file, span, begin, after from after_open where matches(after, "/>");
let inners = replace(from=closed, text="after", pattern="(?s)/>.*$", replacement="", output="inner");
let spaced = replace(from=inners, text="inner", pattern="^", replacement=" ", output="attributes");
let keyed = select id, file, span, begin, attributes from spaced where matches(attributes, "\s(?:types|path|lib)=");
let rests = replace(from=keyed, text="attributes", pattern="(?s)^.*?\s(?:types|path|lib)=", replacement="", output="rest");
let tokens = replace(from=rests, text="rest", pattern="(?s)\s.*$", replacement="", output="token");
let single = select id, file, span, begin, attributes, rest, token from tokens where matches(token, "^[^=]*$");
let unquoted = replace(from=single, text="token", pattern="^\x22+|\x22+$", replacement="", output="unquoted");
let values = replace(from=unquoted, text="unquoted", pattern="/+$", replacement="", output="value");
let paths = select id, file, span from values where ends_with(attributes, concat("path=", rest));
let types = select id, file, span, begin, value from values where ends_with(attributes, concat("types=", rest));
let later_types = select l.id as id from types as l join types as r on l.file = r.file and l.value = r.value where r.begin > l.begin;
let last_types = antijoin(left=types, right=later_types, left-on=["id"], right-on=["id"]);
let import_sources = select l.id as statement, l.file as file, c.child as source from statements as l join "semantic-child" as c on l.id = c.parent where l.kind = "import-declaration" and c.field = "source";
let equals_references = select l.id as statement, l.file as file, c.child as reference from statements as l join "semantic-child" as c on l.id = c.parent where l.kind = "ts-import-equals-declaration" and c.field = "module-reference";
let equals_sources = select l.statement as statement, l.file as file, c.child as source from equals_references as l join "semantic-child" as c on l.reference = c.parent where c.field = "expression";
let sources = union(left=import_sources, right=equals_sources);
let source_values = select l.statement as statement, l.file as file, r.value as value from sources as l join "string-literal" as r on l.source = r.occurrence;
let imported = select l.id as id, l.file as file, l.span as span, r.statement as statement from last_types as l join source_values as r on l.file = r.file and l.value = r.value;
let path_rows = select id, file, span, id as statement from paths;
let owned = union(left=imported, right=path_rows);
let found = select id, file, span from owned;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?triple-slash-reference(?:,|$)");
let reported = select l.id as id, l.file as file, l.span as span, l.statement as statement from owned as l join violations as r on l.id = r.id;
emit reported subject file key(id, statement);
