import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let pattern_properties = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "properties" and r.kind = "object-pattern";
let colons = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = ":";
let brackets = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let written = select l.id as id from pattern_properties as l join colons as r on l.id = r.id;
let renamed = antijoin(left=written, right=brackets, left-on=["id"], right-on=["id"]);
let keys = select l.parent as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "key";
let direct_values = select l.parent as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "value";
let defaults = select l.parent as id, l.child as pattern from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "value" and r.kind = "assignment-pattern";
let defaulted_left = select l.parent as pattern, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "left";
let defaulted_values = select l.id as id, r.name as name from defaults as l join defaulted_left as r on l.pattern = r.pattern;
let values = union(left=direct_values, right=defaulted_values);
let same_names = select l.id as id from keys as l join values as r on l.id = r.id and l.name = r.name;
let useless_properties = select l.id as id from renamed as l join same_names as r on l.id = r.id;
let property_hits = select r.id as id, r.file as file, r.span as span from useless_properties as l join "semantic-syntax" as r on l.id = r.id;
let specifiers = select id from "semantic-syntax" where kind = "import-specifier" or kind = "export-specifier";
let aliased = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and r.text = "as";
let written_specifiers = select l.id as id from specifiers as l join aliased as r on l.id = r.id;
let locals = select l.parent as id, l.child as local, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "local";
let outer = select l.parent as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "imported" or l.field = "exported";
let same_specifiers = select l.id as id, l.local as local from locals as l join outer as r on l.id = r.id and l.name = r.name;
let useless_specifiers = select r.local as id from written_specifiers as l join same_specifiers as r on l.id = r.id;
let specifier_hits = select r.id as id, r.file as file, r.span as span from useless_specifiers as l join "semantic-syntax" as r on l.id = r.id;
let found = union(left=property_hits, right=specifier_hits);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-useless-rename(?:,|$)");
emit violations subject file key(id);
