import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let chains = select id from "semantic-syntax" where kind = "chain-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let chain_unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join chains as r on l.parent = r.id where l.field = "expression";
let chain_unwrapped = closure(edges=chain_unwrapping, source="outer", destination="inner");
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let members = select id from "semantic-syntax" where kind = "member-expression";
let properties = select l.parent as member, l.child as property from "semantic-child" as l join members as r on l.parent = r.id where l.field = "property";
let static_properties = antijoin(left=properties, right=computed, left-on=["member"], right-on=["id"]);
let computed_properties = select l.member as member, l.property as property from properties as l join computed as r on l.member = r.id;
let static_names = select l.member as member, r.name as name from static_properties as l join names as r on l.property = r.id;
let string_names = select l.member as member, r.value as name from computed_properties as l join "string-literal" as r on l.property = r.occurrence;
let property_rows = select l.member as member, r.file as file, r.span as span from computed_properties as l join "semantic-syntax" as r on l.property = r.id;
let templates = select file, span, text from "semantic-syntax" where kind = "template" and matches(text, "^\x60[^\x60$\x5c]*\x60$");
let template_names_raw = select l.member as member, r.text as text from property_rows as l join templates as r on l.file = r.file and l.span = r.span;
let template_names = replace(from=template_names_raw, text="text", pattern="\x60", replacement="", output="name");
let template_members = select member, name from template_names;
let named_a = union(left=static_names, right=string_names);
let member_names = union(left=named_a, right=template_members);
let objects = select l.parent as member, l.child as object from "semantic-child" as l join members as r on l.parent = r.id where l.field = "object";
let direct_objects = select member, object as inner from objects;
let reached_objects = select l.member as member, r.inner as inner from objects as l join unwrapped as r on l.object = r.outer;
let inner_objects = union(left=direct_objects, right=reached_objects);
let object_names = select l.member as member, r.name as receiver from inner_objects as l join names as r on l.inner = r.id;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let call_arguments = select l.parent as id, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "arguments";
let call_counts = group-count(from=call_arguments, keys=["id"], count="arguments");
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join chain_unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let call_methods = select l.id as id, l.inner as member, r.name as method from inner_callees as l join member_names as r on l.inner = r.member;
let call_receivers = select l.id as id, l.method as method, r.receiver as receiver from call_methods as l join object_names as r on l.member = r.member;
let counted_methods = select l.id as id, l.method as method, r.arguments as arguments from call_methods as l join call_counts as r on l.id = r.id;
let counted_receivers = select l.id as id, l.method as method, l.receiver as receiver, r.arguments as arguments from call_receivers as l join call_counts as r on l.id = r.id;
let method_arrays = select id from call_methods where method = "split" or method = "concat" or method = "copyWithin" or method = "filter" or method = "flat" or method = "flatMap" or method = "map" or method = "slice" or method = "splice" or method = "toReversed" or method = "toSorted" or method = "toSpliced" or method = "with";
let receiver_arrays = select id from call_receivers where (receiver = "Array" and (method = "from" or method = "of")) or (receiver = "Object" and (method = "keys" or method = "values" or method = "entries"));
let typed_froms = select id from counted_receivers where arguments = 1 and method = "from" and (receiver = "Int8Array" or receiver = "Uint8Array" or receiver = "Uint8ClampedArray" or receiver = "Int16Array" or receiver = "Uint16Array" or receiver = "Int32Array" or receiver = "Uint32Array" or receiver = "Float32Array" or receiver = "Float64Array" or receiver = "BigInt64Array" or receiver = "BigUint64Array");
let call_arrays_a = union(left=method_arrays, right=receiver_arrays);
let call_arrays = union(left=call_arrays_a, right=typed_froms);
let reduce_calls_all = select id from counted_methods where method = "reduce" and arguments = 2;
let reduce_calls = antijoin(left=reduce_calls_all, right=call_arrays, left-on=["id"], right-on=["id"]);
let promise_calls_all = select id from counted_receivers where receiver = "Promise" and (method = "all" or method = "allSettled") and arguments = 1;
let promise_calls = antijoin(left=promise_calls_all, right=call_arrays, left-on=["id"], right-on=["id"]);
let object_calls_all = select id from counted_receivers where receiver = "Object" and (method = "fromEntries" or method = "create") and arguments = 1;
let object_calls = antijoin(left=object_calls_all, right=call_arrays, left-on=["id"], right-on=["id"]);
let news = select id from "semantic-syntax" where kind = "new-expression";
let new_arguments = select l.parent as id, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join news as r on l.parent = r.id where l.field = "arguments";
let new_counts = group-count(from=new_arguments, keys=["id"], count="arguments");
let new_callees = select l.parent as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "callee";
let named_news = select l.id as id, r.name as name from news as l join new_callees as r on l.id = r.id;
let counted_news = select l.id as id, l.name as name, r.arguments as arguments from named_news as l join new_counts as r on l.id = r.id;
let new_array_hints = select id from named_news where name = "Array";
let new_object_hints = select id from named_news where name = "Object";
let empty_iterables = select id from named_news where name = "Map" or name = "WeakMap" or name = "Set" or name = "WeakSet";
let filled_iterables = select id from counted_news where arguments > 1;
let new_iterables = antijoin(left=empty_iterables, right=filled_iterables, left-on=["id"], right-on=["id"]);
let literal_arrays = select id from "semantic-syntax" where kind = "array-expression";
let literal_objects = select id from "semantic-syntax" where kind = "object-expression";
let arrays_a = union(left=literal_arrays, right=new_array_hints);
let arrays = union(left=arrays_a, right=call_arrays);
let objects_a = union(left=literal_objects, right=new_object_hints);
let objects_hinted = union(left=objects_a, right=object_calls);
let array_hints = extend(from=arrays, values={hint: 1});
let object_hints = extend(from=objects_hinted, values={hint: 2});
let iterable_hints = extend(from=new_iterables, values={hint: 3});
let promise_hints = extend(from=promise_calls, values={hint: 4});
let hints_a = union(left=array_hints, right=object_hints);
let hints_b = union(left=hints_a, right=iterable_hints);
let hints = union(left=hints_b, right=promise_hints);
let sequences = select id from "semantic-syntax" where kind = "sequence-expression";
let parts = select l.parent as sequence, l.child as part, l.ordinal as ordinal from "semantic-child" as l join sequences as r on l.parent = r.id where l.field = "expressions";
let earlier_parts = select l.sequence as sequence, l.part as part from parts as l join parts as r on l.sequence = r.sequence where l.ordinal < r.ordinal;
let last_parts = antijoin(left=parts, right=earlier_parts, left-on=["sequence", "part"], right-on=["sequence", "part"]);
let sequence_edges = select sequence as outer, part as inner from last_parts;
let conditionals = select id from "semantic-syntax" where kind = "conditional-expression";
let branch_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join conditionals as r on l.parent = r.id where l.field = "consequent" or l.field = "alternate";
let awaits = select id from "semantic-syntax" where kind = "await-expression";
let await_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join awaits as r on l.parent = r.id where l.field = "argument";
let reduce_arguments = select l.id as outer, l.argument as inner, l.ordinal as ordinal from call_arguments as l join reduce_calls as r on l.id = r.id;
let reduce_earlier = select l.outer as outer, l.inner as inner, r.inner as earlier from reduce_arguments as l join reduce_arguments as r on l.outer = r.outer where r.ordinal < l.ordinal;
let reduce_ranks = group-count(from=reduce_earlier, keys=["outer", "inner"], count="earlier");
let reduce_seconds = select outer, inner from reduce_ranks where earlier = 1;
let spread_arguments = select l.parent as outer, l.child as inner from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "argument" and r.kind = "spread-element";
let reduce_spreads = select l.inner as outer, r.inner as inner from reduce_seconds as l join spread_arguments as r on l.inner = r.outer;
let edges_a = union(left=unwrapping, right=sequence_edges);
let edges_b = union(left=edges_a, right=branch_edges);
let edges_c = union(left=edges_b, right=await_edges);
let edges_d = union(left=edges_c, right=reduce_seconds);
let edges = union(left=edges_d, right=reduce_spreads);
let reach = closure(edges=edges, source="outer", destination="inner");
let spreads = select id, file, span from "semantic-syntax" where kind = "spread-element";
let spread_values = select l.parent as spread, l.child as value from "semantic-child" as l join spreads as r on l.parent = r.id where l.field = "argument";
let spread_owners = select l.child as spread, l.parent as owner, l.field as field from "semantic-child" as l join spreads as r on l.child = r.id;
let spread_dots = select l.parent as spread, r.id as id, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "...";
let literal_spreads = select l.spread as spread, l.value as literal, r.kind as kind from spread_values as l join "semantic-syntax" as r on l.value = r.id where r.kind = "array-expression" or r.kind = "object-expression";
let literal_contexts = select l.spread as spread, l.literal as literal, l.kind as kind, r.owner as owner, r.field as field from literal_spreads as l join spread_owners as r on l.spread = r.spread;
let context_rows = select l.spread as spread, l.literal as literal, l.kind as kind, l.field as field, r.kind as owner_kind from literal_contexts as l join "semantic-syntax" as r on l.owner = r.id;
let in_lists = select spread, literal from context_rows where (kind = "object-expression" and owner_kind = "object-expression") or (kind = "array-expression" and owner_kind = "array-expression") or (kind = "array-expression" and field = "arguments" and (owner_kind = "call-expression" or owner_kind = "new-expression"));
let list_hits = select spread from in_lists;
let listed = select literal as id from in_lists;
let containers = select id, kind from "semantic-syntax" where kind = "array-expression" or kind = "object-expression";
let entries = select l.parent as container, l.child as entry, r.kind as kind from "semantic-child" as l join containers as r on l.parent = r.id where l.field = "elements" or l.field = "properties";
let entry_counts = group-count(from=entries, keys=["container"], count="entries");
let lone_entries = select l.container as container, l.entry as entry, l.kind as kind from entries as l join entry_counts as r on l.container = r.container where r.entries = 1;
let lone_spreads = select l.container as container, l.entry as spread, l.kind as kind, r.span as span from lone_entries as l join "semantic-syntax" as r on l.entry = r.id where r.kind = "spread-element";
let commas = select l.parent as container, r.span as comma from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = ",";
let spread_bounds = span-bounds(from=lone_spreads, span="span", start-output="begin", end-output="finish");
let container_commas = select l.container as container, l.begin as begin, r.comma as comma from spread_bounds as l join commas as r on l.container = r.container;
let comma_bounds = span-bounds(from=container_commas, span="comma", start-output="cbegin", end-output="cfinish");
let leading = select container from comma_bounds where cbegin < begin;
let trailing = select container, cbegin from comma_bounds where cbegin > begin;
let trailing_counts = group-count(from=trailing, keys=["container"], count="commas");
let extra_holes = select container from trailing_counts where commas > 1;
let holed = union(left=leading, right=extra_holes);
let single_spreads = antijoin(left=lone_spreads, right=holed, left-on=["container"], right-on=["container"]);
let singles = antijoin(left=single_spreads, right=listed, left-on=["container"], right-on=["id"]);
let single_arrays = select container, spread from singles where kind = "array-expression";
let single_objects = select container, spread from singles where kind = "object-expression";
let array_owners = select l.container as container, l.spread as spread, c.parent as owner, c.field as field, c.ordinal as ordinal from single_arrays as l join "semantic-child" as c on l.container = c.child;
let owner_rows = select l.container as container, l.spread as spread, l.owner as owner, l.field as field, l.ordinal as ordinal, r.kind as owner_kind from array_owners as l join "semantic-syntax" as r on l.owner = r.id;
let for_of_hits = select container, spread from owner_rows where owner_kind = "for-of-statement" and field = "right";
let delegates = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "*";
let yield_owners = select container, spread, owner from owner_rows where owner_kind = "yield-expression" and field = "argument";
let delegated = select l.container as container, l.spread as spread from yield_owners as l join delegates as r on l.owner = r.id;
let delegated_rows = select l.container as id, r.file as file, r.span as span from delegated as l join "semantic-syntax" as r on l.container = r.id;
let wrapped_delegated = parenthesized(candidates=delegated_rows);
let yield_hits = antijoin(left=delegated, right=wrapped_delegated, left-on=["container"], right-on=["id"]);
let argument_owners = select container, spread, owner, ordinal from owner_rows where field = "arguments";
let all_arguments = union(left=call_arguments, right=new_arguments);
let earlier_arguments = select l.container as container from argument_owners as l join all_arguments as r on l.owner = r.id where r.ordinal < l.ordinal;
let first_arguments = antijoin(left=argument_owners, right=earlier_arguments, left-on=["container"], right-on=["container"]);
let iterable_news = select id from counted_news where arguments = 1 and (name = "Map" or name = "WeakMap" or name = "Set" or name = "WeakSet");
let typed_news = select id from named_news where name = "Int8Array" or name = "Uint8Array" or name = "Uint8ClampedArray" or name = "Int16Array" or name = "Uint16Array" or name = "Int32Array" or name = "Uint32Array" or name = "Float32Array" or name = "Float64Array" or name = "BigInt64Array" or name = "BigUint64Array";
let accepting_news = union(left=iterable_news, right=typed_news);
let accepting_promises = select id from counted_receivers where arguments = 1 and receiver = "Promise" and (method = "all" or method = "allSettled" or method = "any" or method = "race");
let accepting_froms = select id from counted_receivers where arguments = 1 and method = "from" and (receiver = "Array" or receiver = "Int8Array" or receiver = "Uint8Array" or receiver = "Uint8ClampedArray" or receiver = "Int16Array" or receiver = "Uint16Array" or receiver = "Int32Array" or receiver = "Uint32Array" or receiver = "Float32Array" or receiver = "Float64Array" or receiver = "BigInt64Array" or receiver = "BigUint64Array");
let accepting_entries = select id from counted_receivers where arguments = 1 and receiver = "Object" and method = "fromEntries";
let accepting_a = union(left=accepting_news, right=accepting_promises);
let accepting_b = union(left=accepting_a, right=accepting_froms);
let accepting = union(left=accepting_b, right=accepting_entries);
let accepted_hits = select l.container as container, l.spread as spread from first_arguments as l join accepting as r on l.owner = r.id;
let iterable_a = union(left=for_of_hits, right=yield_hits);
let iterable_hits = union(left=iterable_a, right=accepted_hits);
let iterable_containers = select container from iterable_hits;
let clone_arrays = antijoin(left=single_arrays, right=iterable_containers, left-on=["container"], right-on=["container"]);
let array_targets = extend(from=clone_arrays, values={wanted: 1});
let object_targets = extend(from=single_objects, values={wanted: 2});
let clone_targets = union(left=array_targets, right=object_targets);
let target_values = select l.container as container, l.spread as spread, l.wanted as wanted, r.value as target from clone_targets as l join spread_values as r on l.spread = r.spread;
let direct_inner = select container, target as inner from target_values;
let reached_inner = select l.container as container, r.inner as inner from target_values as l join unwrapped as r on l.target = r.outer;
let inner_targets = union(left=direct_inner, right=reached_inner);
let literal_targets = select l.container as container from inner_targets as l join containers as r on l.inner = r.id;
let evaluated = antijoin(left=target_values, right=literal_targets, left-on=["container"], right-on=["container"]);
let reached_nodes = select l.target as root, r.inner as node from evaluated as l join reach as r on l.target = r.outer;
let self_nodes = select target as root, target as node from evaluated;
let path_nodes = union(left=reached_nodes, right=self_nodes);
let leaves = antijoin(left=path_nodes, right=edges, left-on=["node"], right-on=["outer"]);
let leaf_hints = select l.root as root, l.node as node, r.hint as hint from leaves as l join hints as r on l.node = r.id;
let promise_leaves = select root, node from leaf_hints where hint = 4;
let gates = select id from "semantic-syntax" where kind = "await-expression" or kind = "conditional-expression";
let promise_leaf_rows = select node as id from promise_leaves;
let nearest_gates = axis(from=promise_leaf_rows, relation="semantic-child", direction=nearest-ancestor, domain=gates);
let gated = select l.root as root, l.node as node, r.related as gate from promise_leaves as l join nearest_gates as r on l.node = r.id;
let gates_on_path = select l.root as root, l.node as node, l.gate as gate from gated as l join path_nodes as r on l.root = r.root and l.gate = r.node;
let awaited_leaves = select l.root as root, l.node as node from gates_on_path as l join awaits as r on l.gate = r.id;
let awaited_hints = extend(from=awaited_leaves, values={hint: 1});
let plain_hints = select root, node, hint from leaf_hints where hint != 4;
let effective = union(left=plain_hints, right=awaited_hints);
let wanted = select l.container as container, l.spread as spread, l.target as root, l.wanted as wanted from evaluated as l join effective as r on l.target = r.root where r.hint = l.wanted;
let matching_leaves = select l.root as root, r.node as node from wanted as l join effective as r on l.root = r.root where r.hint = l.wanted;
let mismatched = antijoin(left=path_nodes, right=matching_leaves, left-on=["root", "node"], right-on=["root", "node"]);
let bad_leaves = antijoin(left=mismatched, right=edges, left-on=["node"], right-on=["outer"]);
let clones = antijoin(left=wanted, right=bad_leaves, left-on=["root"], right-on=["root"]);
let clone_spreads = select spread from clones;
let iterable_spreads = select spread from iterable_hits;
let reported_a = union(left=list_hits, right=iterable_spreads);
let reported = union(left=reported_a, right=clone_spreads);
let found = select r.id as id, r.file as file, r.span as span from reported as l join spread_dots as r on l.spread = r.spread;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-useless-spread(?:,|$)");
emit violations subject file key(id);
