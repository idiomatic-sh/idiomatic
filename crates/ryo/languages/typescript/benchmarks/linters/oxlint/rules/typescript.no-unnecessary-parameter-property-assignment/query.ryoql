import directives from "typescript/oxlint/eslint-directives";
let properties = select id, name, owner from "parameter" where refinement = "ts-parameter-property";
let constructors = select owner as id from properties;
let boundaries = select id from "semantic-syntax" where kind = "function-expression" or kind = "function-declaration" or kind = "assignment-expression";
let assignments = select id, file, span from "semantic-syntax" where kind = "assignment-expression";
let assignment_rows = select id from assignments;
let owners = axis(from=assignment_rows, relation="semantic-child", direction=nearest-ancestor, domain=boundaries);
let visited = select l.id as assignment, r.id as constructor from owners as l join constructors as r on l.related = r.id;
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let lefts = select parent as assignment, child as member from "semantic-child" where field = "left";
let this_objects = select l.parent as member from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "object" and r.kind = "this-expression";
let member_properties = select parent as member, child as property from "semantic-child" where field = "property";
let computed = select l.parent as member from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let static_names = select l.member as member, r.name as name from member_properties as l join names as r on l.property = r.id;
let static_kept = antijoin(left=static_names, right=computed, left-on=["member"], right-on=["member"]);
let literal_names = select l.member as member, r.value as name from member_properties as l join "string-literal" as r on l.property = r.occurrence;
let computed_names = select l.member as member, l.name as name from literal_names as l join computed as r on l.member = r.member;
let property_names = union(left=static_kept, right=computed_names);
let this_names = select l.member as member, l.name as name from property_names as l join this_objects as r on l.member = r.member;
let targets = select l.assignment as assignment, r.name as name from lefts as l join this_names as r on l.member = r.member;
let operators = select l.parent as assignment, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let visited_targets = select l.assignment as assignment, l.constructor as constructor, r.name as name from visited as l join targets as r on l.assignment = r.assignment;
let operated = select l.assignment as assignment, l.constructor as constructor, l.name as name, r.operator as operator from visited_targets as l join operators as r on l.assignment = r.assignment;
let unnecessary = select assignment, constructor, name from operated where operator = "=" or operator = "||=" or operator = "&&=" or operator = "??=";
let others = select assignment, constructor, name from operated where operator != "=" and operator != "||=" and operator != "&&=" and operator != "??=";
let rights = select parent as assignment, child as value from "semantic-child" where field = "right";
let wrapper_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "expression" and (r.kind = "ts-as-expression" or r.kind = "ts-satisfies-expression" or r.kind = "ts-instantiation-expression" or r.kind = "ts-non-null-expression" or r.kind = "ts-type-assertion");
let unwrapped = closure(edges=wrapper_edges, source="outer", destination="inner");
let unwrapped_values = select l.assignment as assignment, r.inner as value from rights as l join unwrapped as r on l.value = r.outer;
let values = union(left=rights, right=unwrapped_values);
let property_uses = select l.reference as reference, r.name as name, r.owner as constructor from "binding-use" as l join properties as r on l.binding = r.id;
let valued = select l.assignment as assignment, l.constructor as constructor, l.name as name, r.value as value from unnecessary as l join values as r on l.assignment = r.assignment;
let candidates = select l.assignment as assignment, l.constructor as constructor, l.name as name from valued as l join property_uses as r on l.value = r.reference and l.constructor = r.constructor and l.name = r.name;
let candidate_rows = select l.assignment as assignment, l.constructor as constructor, l.name as name, r.file as file, r.span as span from candidates as l join assignments as r on l.assignment = r.id;
let candidate_bounds = span-bounds(from=candidate_rows, span="span", start-output="begin", end-output="finish");
let other_rows = select l.assignment as assignment, l.constructor as constructor, l.name as name, r.span as span from others as l join assignments as r on l.assignment = r.id;
let other_bounds = span-bounds(from=other_rows, span="span", start-output="obegin", end-output="ofinish");
let preceded = select l.assignment as assignment from candidate_bounds as l join other_bounds as r on l.constructor = r.constructor and l.name = r.name where r.obegin < l.begin;
let methods = select child as function, parent as method from "semantic-child" where field = "value";
let members = select child as method, parent as body from "semantic-child" where field = "body";
let constructor_bodies = select l.function as constructor, r.body as body from methods as l join members as r on l.method = r.method;
let field_values = select l.parent as definition, l.child as value from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "property-definition" and l.field = "value";
let class_fields = select l.parent as body, r.value as value from "semantic-child" as l join field_values as r on l.child = r.definition where l.field = "body";
let field_targets = select l.body as body, r.name as name from class_fields as l join targets as r on l.value = r.assignment;
let preassigned = select l.constructor as constructor, r.name as name from constructor_bodies as l join field_targets as r on l.body = r.body;
let unpreceded = antijoin(left=candidate_bounds, right=preceded, left-on=["assignment"], right-on=["assignment"]);
let kept = antijoin(left=unpreceded, right=preassigned, left-on=["constructor", "name"], right-on=["constructor", "name"]);
let found = select assignment as id, file, span from kept;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unnecessary-parameter-property-assignment(?:,|$)");
emit violations subject file key(id);
