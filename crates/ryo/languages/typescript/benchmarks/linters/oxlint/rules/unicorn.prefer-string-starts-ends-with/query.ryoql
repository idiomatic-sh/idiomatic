import directives from "typescript/oxlint/eslint-directives";
let regex_tokens = select id from "semantic-syntax" where kind = "regular-expression";
let literals = select l.parent as carrier from "semantic-child" as l join regex_tokens as r on l.child = r.id;
let plain = select l.carrier as carrier from literals as l join "pattern-parse" as r on l.carrier = r.carrier where r.outcome = "parsed" and matches(r.flags, "^[^im]*$");
let patterns = select l.id as pattern, l.carrier as carrier from "pattern-syntax" as l join plain as r on l.carrier = r.carrier where l.kind = "pattern";
let tops = select l.carrier as carrier, r.child as disjunction from patterns as l join "pattern-child" as r on l.pattern = r.parent;
let alternatives = select l.carrier as carrier, r.child as alternative from tops as l join "pattern-child" as r on l.disjunction = r.parent;
let alternative_counts = group-count(from=alternatives, keys=["carrier"], count="alternatives");
let single = select l.carrier as carrier, l.alternative as alternative from alternatives as l join alternative_counts as r on l.carrier = r.carrier where r.alternatives = 1;
let terms = select l.carrier as carrier, r.child as term, r.ordinal as ordinal from single as l join "pattern-child" as r on l.alternative = r.parent;
let term_rows = select l.carrier as carrier, l.term as term, l.ordinal as ordinal, r.kind as kind, r.text as text from terms as l join "pattern-syntax" as r on l.term = r.id;
let others = select carrier, term, ordinal from term_rows where kind != "character";
let carets = select carrier, term from term_rows where kind = "boundary-assertion" and text = "^" and ordinal = 0;
let start_blockers = select carrier from others where ordinal > 0;
let starts = antijoin(left=carets, right=start_blockers, left-on=["carrier"], right-on=["carrier"]);
let later = select l.carrier as carrier, l.term as term from term_rows as l join term_rows as r on l.carrier = r.carrier where r.ordinal > l.ordinal;
let lasts = antijoin(left=term_rows, right=later, left-on=["carrier", "term"], right-on=["carrier", "term"]);
let dollars = select carrier, term from lasts where kind = "boundary-assertion" and text = "$";
let end_others = antijoin(left=others, right=dollars, left-on=["carrier", "term"], right-on=["carrier", "term"]);
let ends = antijoin(left=dollars, right=end_others, left-on=["carrier"], right-on=["carrier"]);
let start_carriers = select carrier from starts;
let end_carriers = select carrier from ends;
let simple = union(left=start_carriers, right=end_carriers);
let calls = select id from "semantic-syntax" where kind = "call-expression";
let callees = select l.child as member from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "callee";
let objects = select l.parent as member, l.child as object from "semantic-child" as l join callees as r on l.parent = r.member where l.field = "object";
let properties = select l.parent as member, l.child as property from "semantic-child" as l join callees as r on l.parent = r.member where l.field = "property";
let test_tokens = select l.parent as property from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and r.text = "test";
let test_members = select l.member as member from properties as l join test_tokens as r on l.property = r.property;
let tested = select l.member as member, l.object as object from objects as l join test_members as r on l.member = r.member;
let matching = select l.member as member from tested as l join simple as r on l.object = r.carrier;
let found = select r.id as id, r.file as file, r.span as span from matching as l join "semantic-syntax" as r on l.member = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?prefer-string-starts-ends-with(?:,|$)");
emit violations subject file key(id, span);
