import directives from "typescript/oxlint/eslint-directives";
let regex_tokens = select id from "semantic-syntax" where kind = "regular-expression";
let literals = select l.parent as carrier from "semantic-child" as l join regex_tokens as r on l.child = r.id;
let escapes = select l.id as id, l.file as file, l.span as span, l.text as text from "pattern-syntax" as l join literals as r on l.carrier = r.carrier where l.kind = "character" and matches(l.text, "^\\.$");
let placed = select l.id as id, l.file as file, l.span as span, l.text as text, r.parent as parent, r.ordinal as ordinal from escapes as l join "pattern-child" as r on l.id = r.child;
let parents = select l.id as id, l.file as file, l.span as span, l.text as text, l.parent as parent, l.ordinal as ordinal, r.kind as parent_kind, r.text as parent_text from placed as l join "pattern-syntax" as r on l.parent = r.id;
let outside = select id, file, span from parents where parent_kind = "alternative" and matches(text, "^\\[^bcdfknprstuvwxBDPSW0-9/\\.$*+?()\[\]{}|^]$");
let in_ranges = select id, file, span from parents where parent_kind = "character-class-range" and matches(text, "^\\[^bcdfnprstuvwxDPSW0-9\\\]\-]$");
let in_classes = select id, file, span, text, parent, ordinal, parent_text from parents where parent_kind = "character-class";
let always = select id, file, span from in_classes where matches(text, "^\\[^bcdfnprstuvwxDPSW0-9\\\]\^\-]$");
let later = select l.id as id from in_classes as l join "pattern-child" as r on l.parent = r.parent where r.ordinal > l.ordinal;
let lasts = antijoin(left=in_classes, right=later, left-on=["id"], right-on=["id"]);
let opening = select id from in_classes where ordinal = 0 and matches(parent_text, "^\[[^^]");
let carets = select id, file, span from in_classes where text = "\^";
let useless_carets = antijoin(left=carets, right=opening, left-on=["id"], right-on=["id"]);
let dashes = select id, file, span from in_classes where text = "\-";
let last_dashes = select l.id as id, l.file as file, l.span as span from dashes as l join lasts as r on l.id = r.id;
let first_dashes = select l.id as id, l.file as file, l.span as span from dashes as l join opening as r on l.id = r.id;
let pattern_escapes = union(left=outside, right=in_ranges);
let pattern_escapes_2 = union(left=pattern_escapes, right=always);
let pattern_escapes_3 = union(left=pattern_escapes_2, right=useless_carets);
let pattern_escapes_4 = union(left=pattern_escapes_3, right=last_dashes);
let pattern_found = union(left=pattern_escapes_4, right=first_dashes);
let strings = select id, file, span from "semantic-syntax" where kind = "string";
let string_runs = source-matches(from=strings, span="span", pattern="(?P<escape>\\[\s\S])", output="run", capture="escape", capture-output="escape", capture-text-output="sequence");
let string_quotes = source-matches(from=strings, span="span", pattern="\A(?P<quote>[\x22\x27])", output="opening", capture="quote", capture-output="quote_span", capture-text-output="quote");
let quoted = select l.id as id, l.file as file, l.escape as escape, l.sequence as sequence, r.quote as quote from string_runs as l join string_quotes as r on l.id = r.id;
let double_useless = select id, file, escape as span from quoted where matches(quote, "\x22") and matches(sequence, "^\\[^bfnrtv0-9ux\\\x22\r\n\x{2028}\x{2029}]$");
let single_useless = select id, file, escape as span from quoted where matches(quote, "'") and matches(sequence, "^\\[^bfnrtv0-9ux\\'\r\n\x{2028}\x{2029}]$");
let string_found = union(left=double_useless, right=single_useless);
let templates = select id, file, span from "semantic-syntax" where kind = "template";
let template_elements = select l.child as id, l.parent as element from "semantic-child" as l join templates as r on l.child = r.id;
let template_literals = select l.id as id, r.parent as literal from template_elements as l join "semantic-child" as r on l.element = r.child;
let tags = select l.child as literal from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "tagged-template-expression";
let tagged = select l.id as id from template_literals as l join tags as r on l.literal = r.literal;
let untagged = antijoin(left=templates, right=tagged, left-on=["id"], right-on=["id"]);
let template_runs = source-matches(from=untagged, span="span", pattern="(?P<escape>\\[\s\S])", output="run", capture="escape", capture-output="escape", capture-text-output="sequence");
let template_useless = select id, file, escape as span from template_runs where matches(sequence, "^\\[^bfnrtv0ux\\`\r\n\x{2028}\x{2029}]$");
let template_braces = source-matches(from=untagged, span="span", pattern="\$(?P<escape>\\\{)", output="run", capture="escape", capture-output="escape", capture-text-output="sequence");
let dollar_braces = select id, file, escape as span from template_braces;
let template_dollars = source-matches(from=untagged, span="span", pattern="(?P<escape>\\\$)[{`]", output="run", capture="escape", capture-output="escape", capture-text-output="sequence");
let opening_dollars = select id, file, escape as span from template_dollars;
let kept_braces = antijoin(left=template_useless, right=dollar_braces, left-on=["id", "span"], right-on=["id", "span"]);
let template_found = antijoin(left=kept_braces, right=opening_dollars, left-on=["id", "span"], right-on=["id", "span"]);
let text_found = union(left=string_found, right=template_found);
let found = union(left=pattern_found, right=text_found);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-useless-escape(?:,|$)");
emit violations subject file key(id, span);
