import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let objects = select id from "semantic-syntax" where kind = "object-expression";
let entries = select l.parent as object, l.child as property from "semantic-child" as l join objects as r on l.parent = r.id where l.field = "properties";
let properties = select l.object as object, l.property as property from entries as l join "semantic-syntax" as r on l.property = r.id where r.kind = "property";
let keys = select l.object as object, l.property as property, c.child as key from properties as l join "semantic-child" as c on l.property = c.parent where c.field = "key";
let computed = select l.parent as property from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let colons = select l.parent as property from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = ":";
let accessors = select l.parent as property, r.text as kind from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and (r.text = "get" or r.text = "set");
let static_keys = antijoin(left=keys, right=computed, left-on=["property"], right-on=["property"]);
let identifier_names = select l.property as property, r.name as name from static_keys as l join names as r on l.key = r.id;
let string_names = select l.property as property, r.value as name from keys as l join "string-literal" as r on l.key = r.occurrence;
let floats = select l.property as property, r.value as value from keys as l join "numeric-literal" as r on l.key = r.id where r.kind = "float";
let float_spelled = replace(from=floats, text="value", pattern="\.0$", replacement="", output="name");
let float_names = select property, name from float_spelled;
let integer_names = select l.property as property, r.value as name from keys as l join "numeric-literal" as r on l.key = r.id where r.kind = "integer";
let key_rows = select l.property as property, r.file as file, r.span as span from keys as l join "semantic-syntax" as r on l.key = r.id;
let templates = select file, span, text from "semantic-syntax" where kind = "template" and matches(text, "^\x60[^\x60$\\]*\x60$");
let template_texts = select l.property as property, r.text as text from key_rows as l join templates as r on l.file = r.file and l.span = r.span;
let template_spelled = replace(from=template_texts, text="text", pattern="\x60", replacement="", output="name");
let template_names = select property, name from template_spelled;
let named_a = union(left=identifier_names, right=string_names);
let named_b = union(left=named_a, right=float_names);
let named_c = union(left=named_b, right=integer_names);
let named = union(left=named_c, right=template_names);
let proto_setters_a = select property from named where name = "__proto__";
let proto_setters_b = select l.property as property from proto_setters_a as l join colons as r on l.property = r.property;
let proto_setters = antijoin(left=proto_setters_b, right=computed, left-on=["property"], right-on=["property"]);
let keyed_names = antijoin(left=named, right=proto_setters, left-on=["property"], right-on=["property"]);
let plain = antijoin(left=keyed_names, right=accessors, left-on=["property"], right-on=["property"]);
let plain_kinds = extend(from=plain, values={kind: "init"});
let getters = select l.property as property, l.name as name from keyed_names as l join accessors as r on l.property = r.property where r.kind = "get";
let setters = select l.property as property, l.name as name from keyed_names as l join accessors as r on l.property = r.property where r.kind = "set";
let getter_kinds = extend(from=getters, values={kind: "get"});
let setter_kinds = extend(from=setters, values={kind: "set"});
let accessed = union(left=getter_kinds, right=setter_kinds);
let kinded = union(left=plain_kinds, right=accessed);
let placed = select l.property as property, l.name as name, l.kind as kind, r.object as object, r.key as key from kinded as l join keys as r on l.property = r.property;
let located = select l.property as property, l.name as name, l.kind as kind, l.object as object, l.key as key, r.file as file, r.span as span from placed as l join "semantic-syntax" as r on l.key = r.id;
let bounded = span-bounds(from=located, span="span", start-output="begin", end-output="finish");
let pairs = select l.object as object, l.name as name, l.key as previous, l.kind as previous_kind, l.begin as previous_begin, r.key as current, r.kind as current_kind, r.begin as current_begin from bounded as l join bounded as r on l.object = r.object and l.name = r.name where l.begin < r.begin;
let between = select l.previous as previous, l.current as current from pairs as l join bounded as m on l.object = m.object and l.name = m.name where m.begin > l.previous_begin and m.begin < l.current_begin;
let adjacent = antijoin(left=pairs, right=between, left-on=["previous", "current"], right-on=["previous", "current"]);
let duplicates = select previous, current from adjacent where previous_kind = "init" or current_kind = "init" or previous_kind = current_kind;
let found = select l.previous as id, l.current as current, r.file as file, r.span as span from duplicates as l join "semantic-syntax" as r on l.previous = r.id;
let firsts = project(from=found, columns=["id", "file", "span"]);
let violations = directives(candidates=firsts, names="(?:^|,)(?:[^,]*/)?no-dupe-keys(?:,|$)");
let reported = select l.id as id, l.current as current, l.file as file, l.span as span from found as l join violations as r on l.id = r.id;
emit reported subject file key(id, current);
