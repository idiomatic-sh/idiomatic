import directives from "typescript/oxlint/eslint-directives";
import constructors from "typescript/oxlint/control-flow";
import super_calls from "typescript/oxlint/super-calls";
let all_constructors = constructors();
let derived = select method, block, file, span from all_constructors where heritage = "valid" or heritage = "invalid";
let derived_files = project(from=derived, columns=["file"]);
let references = select l.id as id, l.kind as kind, l.file as file, l.span as span from "semantic-syntax" as l join derived_files as r on l.file = r.file where l.kind = "this-expression" or l.kind = "super";
let placed = select l.id as id, l.kind as kind, l.file as file, l.span as span, r.block as block from references as l join "flow-member" as r on l.id = r.node;
let bounded = span-bounds(from=placed, span="span", start-output="begin", end-output="finish");
let super_calls_all = super_calls(scope=derived_files);
let super_calls_found = select call, super from super_calls_all;
let selves = select id, kind from references;
let members = select l.parent as member, l.child as object from "semantic-child" as l join selves as r on l.child = r.id where l.field = "object";
let named_properties = select l.member as member, c.child as property from members as l join "semantic-child" as c on l.member = c.parent where c.field = "property";
let identifier_members = select l.member as member from named_properties as l join "semantic-syntax" as r on l.property = r.id where r.kind = "identifier";
let computed = select l.parent as member from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let static_members = antijoin(left=identifier_members, right=computed, left-on=["member"], right-on=["member"]);
let self_members = select member as id from static_members;
let self_values = select id from selves;
let self_like = union(left=self_values, right=self_members);
let arguments = select l.parent as call, l.child as argument from "semantic-child" as l join derived_files as r on l.file = r.file where l.field = "arguments";
let direct = select l.call as call from arguments as l join self_like as r on l.argument = r.id;
let callee_links = select l.parent as call, l.child as callee from "semantic-child" as l join derived_files as r on l.file = r.file where l.field = "callee";
let self_callees = select l.call as call from callee_links as l join self_like as r on l.callee = r.id;
let call_nodes = select l.id as id from "semantic-syntax" as l join derived_files as r on l.file = r.file where l.kind = "call-expression";
let argument_calls = select l.call as outer, l.argument as inner from arguments as l join call_nodes as r on l.argument = r.id;
let nested_calls = closure(edges=argument_calls, source="outer", destination="inner");
let super_nested = select l.call as call, r.inner as inner from super_calls_found as l join nested_calls as r on l.call = r.outer;
let deep_direct = select l.call as call from super_nested as l join direct as r on l.inner = r.call;
let deep_callees = select l.call as call from super_nested as l join self_callees as r on l.inner = r.call;
let deep = union(left=deep_direct, right=deep_callees);
let tainted = union(left=direct, right=deep);
let qualifying_calls = antijoin(left=super_calls_found, right=tainted, left-on=["call"], right-on=["call"]);
let qualifying = select l.super as id, r.file as file, r.block as block, r.begin as begin from qualifying_calls as l join bounded as r on l.super = r.id;
let earlier = select l.id as id from bounded as l join qualifying as r on l.file = r.file and l.block = r.block where r.begin < l.begin;
let qualifying_ids = select id from qualifying;
let preceded = union(left=earlier, right=qualifying_ids);
let violations_local = antijoin(left=bounded, right=preceded, left-on=["id"], right-on=["id"]);
let violating = select block, file from violations_local;
let called = select block, file from qualifying;
let edges = select l.source as source, l.target as target, l."edge-kind" as kind, l.ordinal as place, l.file as file from "flow-edge" as l join derived_files as r on l.file = r.file;
let onward = select source as block, file from edges where kind != "error-explicit" and kind != "error-implicit" and kind != "finalize";
let excepting = select source as block, file from edges where kind = "error-explicit" or kind = "finalize";
let sources = select source as block, file from edges;
let stopping = union(left=violating, right=called);
let going = antijoin(left=onward, right=stopping, left-on=["block", "file"], right-on=["block", "file"]);
let unfinished = antijoin(left=sources, right=onward, left-on=["block", "file"], right-on=["block", "file"]);
let unfinished_free = antijoin(left=unfinished, right=stopping, left-on=["block", "file"], right-on=["block", "file"]);
let called_free = antijoin(left=called, right=violating, left-on=["block", "file"], right-on=["block", "file"]);
let called_excepting = select l.block as block, l.file as file from called_free as l join excepting as r on l.block = r.block and l.file = r.file;
let maybe = union(left=unfinished_free, right=called_excepting);
let walked = select l.source as source, l.target as target, l.place as place, l.file as file from edges as l join going as r on l.source = r.block and l.file = r.file where l.kind = "jump" or l.kind = "normal";
let joins = select l.source as source, l.target as target, l.place as place, l.file as file from edges as l join going as r on l.source = r.block and l.file = r.file where l.kind = "join";
let walked_edges = project(from=walked, columns=["source", "target", "place", "file"]);
let join_edges = project(from=joins, columns=["source", "target", "place", "file"]);
let excepted = select l.source as source, l.target as target, l.kind as kind, l.place as place, l.file as file from edges as l join maybe as r on l.source = r.block and l.file = r.file where l.kind = "error-explicit" or l.kind = "finalize";
let caught_edges = select source, target, place, file from excepted where kind = "error-explicit";
let final_edges = select source, target, place, file from excepted where kind = "finalize";
let modes = extend(from=derived_files, values={mode: "within"});
let modes_caught = extend(from=derived_files, values={mode: "caught"});
let modes_both = extend(from=derived_files, values={mode: "both"});
let modes_held = union(left=modes_caught, right=modes_both);
let modes_any = union(left=modes, right=modes_held);
let walked_moves = select l.source as source, l.target as target, l.place as place, r.mode as before, r.mode as after, l.file as file from walked_edges as l all-pairs join modes_any as r on l.file = r.file;
let join_moves_any = select l.source as source, l.target as target, l.place as place, r.mode as before, l.file as file from join_edges as l all-pairs join modes_held as r on l.file = r.file;
let join_moves = extend(from=join_moves_any, values={after: "caught"});
let caught_moves_any = select l.source as source, l.target as target, l.place as place, r.mode as before, l.file as file from caught_edges as l all-pairs join modes_any as r on l.file = r.file;
let caught_moves = extend(from=caught_moves_any, values={after: "caught"});
let final_moves_any = select l.source as source, l.target as target, l.place as place, r.mode as before, l.file as file from final_edges as l all-pairs join modes_any as r on l.file = r.file;
let final_moves = extend(from=final_moves_any, values={after: "within"});
let flow_moves = union(left=walked_moves, right=join_moves);
let handler_moves = union(left=caught_moves, right=final_moves);
let moves = union(left=flow_moves, right=handler_moves);
let order_within = extend(from=derived_files, values={lower: "unreached", upper: "within"});
let order_caught = extend(from=derived_files, values={lower: "unreached", upper: "caught"});
let order_within_both = extend(from=derived_files, values={lower: "within", upper: "both"});
let order_caught_both = extend(from=derived_files, values={lower: "caught", upper: "both"});
let order_low = union(left=order_within, right=order_caught);
let order_high = union(left=order_within_both, right=order_caught_both);
let lattice = union(left=order_low, right=order_high);
let first_starts = select method, file, span, block as start from derived;
let start_blocks = project(from=first_starts, columns=["start", "file"]);
let roots = extend(from=start_blocks, values={state: "within"});
let trace = worklist(from=roots, root="start", state="state", edges=moves, source="source", destination="target", order="place", before="before", after="after", lattice=lattice, lower="lower", upper="upper", keys=["file"], output="reached");
let reached = select start, target as block, file from trace;
let start_selves = select start, start as block, file from start_blocks;
let segments = union(left=start_selves, right=reached);
let visited = select l.method as method, l.file as file, l.span as span, r.block as block from first_starts as l join segments as r on l.start = r.start and l.file = r.file;
let broken = select l.method as id, l.file as file, l.span as span from visited as l join violating as r on l.block = r.block and l.file = r.file;
let found = project(from=broken, columns=["id", "file", "span"]);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-this-before-super(?:,|$)");
emit violations subject file key(id);
