import directives from "typescript/oxlint/eslint-directives";
let bodies = select id from "semantic-syntax" where kind = "class-body";
let body_children = select l.parent as body, r.id as member, r.kind as kind, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "body" and (r.kind = "method-definition" or r.kind = "property-definition" or r.kind = "accessor-property");
let class_members = select l.body as body, l.member as member, l.kind as kind, l.file as file, l.span as span from body_children as l join bodies as r on l.body = r.id;
let signatures = select l.parent as member from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "value" and r.kind = "ts-empty-body-function-expression";
let members = antijoin(left=class_members, right=signatures, left-on=["member"], right-on=["member"]);
let marks = select l.parent as member, r.kind as kind, r.text as text from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "none";
let statics = select member from marks where kind = "keyword" and text = "static";
let getters = select member from marks where kind = "identifier-token" and text = "get";
let setters = select member from marks where kind = "identifier-token" and text = "set";
let computed = select member from marks where kind = "punctuator" and text = "[";
let keys = select l.parent as member, r.id as key, r.kind as key_kind, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "key";
let key_tokens = select l.parent as key, r.kind as kind, r.text as text from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id;
let named_keys = select member from keys where key_kind = "identifier" or key_kind = "private-identifier";
let identifier_names = select l.member as member, r.name as name from named_keys as l join "defines" as r on l.member = r.id;
let private_keys = select member from keys where key_kind = "private-identifier";
let string_names = select l.member as member, r.value as name from keys as l join "string-literal" as r on l.key = r.occurrence;
let numbers = select l.member as member, r.value as raw from keys as l join "numeric-literal" as r on l.key = r.id;
let number_texts = replace(from=numbers, text="raw", pattern="\.0$", replacement="", output="name");
let number_names = select member, name from number_texts;
let null_names = select l.member as member, r.text as name from keys as l join key_tokens as r on l.key = r.key where l.key_kind = "literal" and r.kind = "null";
let regexp_names = select l.member as member, r.text as name from keys as l join key_tokens as r on l.key = r.key where l.key_kind = "literal" and r.kind = "regular-expression";
let names_a = union(left=identifier_names, right=string_names);
let names_b = union(left=names_a, right=number_names);
let names_c = union(left=names_b, right=null_names);
let names = union(left=names_c, right=regexp_names);
let constructor_named = select l.member as member from names as l join members as r on l.member = r.member where l.name = "constructor" and r.kind = "method-definition";
let constructors_a = antijoin(left=constructor_named, right=statics, left-on=["member"], right-on=["member"]);
let constructors_b = antijoin(left=constructors_a, right=computed, left-on=["member"], right-on=["member"]);
let constructors_c = antijoin(left=constructors_b, right=getters, left-on=["member"], right-on=["member"]);
let constructors = antijoin(left=constructors_c, right=setters, left-on=["member"], right-on=["member"]);
let elements = antijoin(left=names, right=constructors, left-on=["member"], right-on=["member"]);
let placed = select l.body as body, l.member as member, l.file as file, l.span as span, r.name as name from members as l join elements as r on l.member = r.member;
let ordered = span-bounds(from=placed, span="span", start-output="begin", end-output="finish");
let pairs = ordered-match(left=ordered, right=ordered, left-on=[body, file, name], right-on=[body, file, name], left-order="begin", right-order="begin", output={prev:[left,member], next:[right,member], file:[left,file]});
let prev_static = select l.prev as prev, l.next as next from pairs as l join statics as r on l.prev = r.member;
let next_static = select l.prev as prev, l.next as next from pairs as l join statics as r on l.next = r.member;
let static_only_prev = antijoin(left=prev_static, right=statics, left-on=["next"], right-on=["member"]);
let static_only_next = antijoin(left=next_static, right=statics, left-on=["prev"], right-on=["member"]);
let prev_private = select l.prev as prev, l.next as next from pairs as l join private_keys as r on l.prev = r.member;
let next_private = select l.prev as prev, l.next as next from pairs as l join private_keys as r on l.next = r.member;
let private_only_prev = antijoin(left=prev_private, right=private_keys, left-on=["next"], right-on=["member"]);
let private_only_next = antijoin(left=next_private, right=private_keys, left-on=["prev"], right-on=["member"]);
let prev_getter = select l.prev as prev, l.next as next from pairs as l join getters as r on l.prev = r.member;
let getter_setter = select l.prev as prev, l.next as next from prev_getter as l join setters as r on l.next = r.member;
let prev_setter = select l.prev as prev, l.next as next from pairs as l join setters as r on l.prev = r.member;
let setter_getter = select l.prev as prev, l.next as next from prev_setter as l join getters as r on l.next = r.member;
let allowed_a = union(left=static_only_prev, right=static_only_next);
let allowed_b = union(left=allowed_a, right=private_only_prev);
let allowed_c = union(left=allowed_b, right=private_only_next);
let allowed_d = union(left=allowed_c, right=getter_setter);
let allowed = union(left=allowed_d, right=setter_getter);
let duplicates = antijoin(left=pairs, right=allowed, left-on=["prev", "next"], right-on=["prev", "next"]);
let found = select r.key as id, r.file as file, r.span as span from duplicates as l join keys as r on l.prev = r.member;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-dupe-class-members(?:,|$)");
emit violations subject file key(id);
