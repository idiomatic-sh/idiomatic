import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let literal_types = select id from "semantic-syntax" where kind = "ts-literal-type";
let type_literals = select l.parent as type, l.child as literal from "semantic-child" as l join literal_types as r on l.parent = r.id where l.field = "literal";
let annotations = select id from "semantic-syntax" where kind = "ts-type-annotation";
let annotated = select l.parent as annotation, l.child as type from "semantic-child" as l join annotations as r on l.parent = r.id where l.field = "type-annotation";
let as_expressions = select id from "semantic-syntax" where kind = "ts-as-expression";
let as_values = select l.parent as owner, l.child as value from "semantic-child" as l join as_expressions as r on l.parent = r.id where l.field = "expression";
let as_types = select l.parent as owner, l.child as type from "semantic-child" as l join as_expressions as r on l.parent = r.id where l.field = "type-annotation";
let declarators = select id from "semantic-syntax" where kind = "variable-declarator";
let declared = select l.parent as owner, l.child as binding from "semantic-child" as l join declarators as r on l.parent = r.id where l.field = "id";
let binding_annotations = select l.owner as owner, c.child as annotation from declared as l join "semantic-child" as c on l.binding = c.parent where c.field = "type-annotation";
let initializers = select l.parent as owner, l.child as value from "semantic-child" as l join declarators as r on l.parent = r.id where l.field = "init";
let definitions = select id from "semantic-syntax" where kind = "property-definition";
let definition_annotations = select l.parent as owner, l.child as annotation from "semantic-child" as l join definitions as r on l.parent = r.id where l.field = "type-annotation";
let definition_values = select l.parent as owner, l.child as value from "semantic-child" as l join definitions as r on l.parent = r.id where l.field = "value";
let owned_annotations = union(left=binding_annotations, right=definition_annotations);
let annotation_types = select l.owner as owner, r.type as type from owned_annotations as l join annotated as r on l.annotation = r.annotation;
let owned_types = union(left=as_types, right=annotation_types);
let owned_values = union(left=as_values, right=initializers);
let all_values = union(left=owned_values, right=definition_values);
let typed = select l.owner as owner, l.type as type, r.literal as literal from owned_types as l join type_literals as r on l.type = r.type;
let pairs = select l.owner as owner, l.type as type, l.literal as literal, r.value as value from typed as l join all_values as r on l.owner = r.owner;
let numbers = select id, value from "numeric-literal" where kind = "float";
let numbered = select l.owner as owner, l.type as type, l.literal as literal, l.value as value, r.value as number from pairs as l join numbers as r on l.literal = r.id;
let equal_numbers = select l.type as type, l.literal as literal, l.value as value from numbered as l join numbers as r on l.value = r.id and l.number = r.value;
let strings = select occurrence as id, value from "string-literal";
let stringed = select l.owner as owner, l.type as type, l.literal as literal, l.value as value, r.value as text from pairs as l join strings as r on l.literal = r.id;
let equal_strings = select l.type as type, l.literal as literal, l.value as value from stringed as l join strings as r on l.value = r.id and l.text = r.value;
let equal = union(left=equal_numbers, right=equal_strings);
let type_rows = select l.type as id, r.file as file, r.span as span from equal as l join "semantic-syntax" as r on l.type = r.id;
let value_rows = select l.value as id, r.file as file, r.span as span from equal as l join "semantic-syntax" as r on l.value = r.id;
let wrapped_types = parenthesized(candidates=type_rows);
let wrapped_values = parenthesized(candidates=value_rows);
let open_types = antijoin(left=equal, right=wrapped_types, left-on=["type"], right-on=["id"]);
let open = antijoin(left=open_types, right=wrapped_values, left-on=["value"], right-on=["id"]);
let found = select r.id as id, r.file as file, r.span as span from open as l join "semantic-syntax" as r on l.literal = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?prefer-as-const(?:,|$)");
emit violations subject file key(id);
