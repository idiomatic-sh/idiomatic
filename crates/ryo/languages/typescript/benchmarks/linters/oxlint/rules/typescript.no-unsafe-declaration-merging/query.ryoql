import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let declarations = select l.parent as declaration, r.id as id, r.file as file, r.span as span, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "id";
let classes = select l.declaration as id, l.id as ident, l.file as file, l.span as span, l.name as name from declarations as l join "semantic-syntax" as r on l.declaration = r.id where r.kind = "class-declaration" or r.kind = "class-expression";
let interfaces = select l.declaration as id, l.id as ident, l.file as file, l.span as span, l.name as name from declarations as l join "semantic-syntax" as r on l.declaration = r.id where r.kind = "ts-interface-declaration";
let scopes = select id from "semantic-syntax" where kind = "program" or kind = "block-statement" or kind = "static-block" or kind = "ts-module-declaration" or kind = "switch-statement" or kind = "for-statement" or kind = "for-in-statement" or kind = "for-of-statement" or kind = "catch-clause" or kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression" or kind = "class-declaration" or kind = "class-expression";
let class_rows = select id, file, span from classes;
let interface_rows = select id, file, span from interfaces;
let class_scopes = axis(from=class_rows, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let interface_scopes = axis(from=interface_rows, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let scoped_classes = select l.ident as ident, l.file as file, l.span as span, l.name as name, r.related as scope from classes as l join class_scopes as r on l.id = r.id;
let scoped_interfaces = select l.ident as ident, l.file as file, l.span as span, l.name as name, r.related as scope from interfaces as l join interface_scopes as r on l.id = r.id;
let merged_classes = select l.ident as ident, l.file as file, l.span as span, l.name as name, l.scope as scope from scoped_classes as l join scoped_interfaces as r on l.scope = r.scope and l.name = r.name;
let merged_interfaces = select l.ident as ident, l.file as file, l.span as span, l.name as name, l.scope as scope from scoped_interfaces as l join scoped_classes as r on l.scope = r.scope and l.name = r.name;
let merged = union(left=merged_classes, right=merged_interfaces);
let bounds = span-bounds(from=merged, span="span", start-output="begin", end-output="finish");
let later = select l.ident as ident from bounds as l join bounds as r on l.scope = r.scope and l.name = r.name where l.begin > r.begin;
let first = antijoin(left=bounds, right=later, left-on=["ident"], right-on=["ident"]);
let found = select ident as id, file, span from first;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unsafe-declaration-merging(?:,|$)");
emit violations subject file key(id);
