import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let promise_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "Promise";
let news = select id from "semantic-syntax" where kind = "new-expression";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join news as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let promise_news = select l.id as id from inner_callees as l join promise_names as r on l.inner = r.id;
let arguments = select l.parent as id, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join promise_news as r on l.parent = r.id where l.field = "arguments";
let later = select l.id as id, l.argument as argument from arguments as l join arguments as r on l.id = r.id where l.ordinal > r.ordinal;
let firsts = antijoin(left=arguments, right=later, left-on=["id", "argument"], right-on=["id", "argument"]);
let direct = select argument as executor from firsts;
let reached = select r.inner as executor from firsts as l join unwrapped as r on l.argument = r.outer;
let executors = union(left=direct, right=reached);
let functions = select l.executor as id from executors as l join "semantic-syntax" as r on l.executor = r.id where r.kind = "arrow-function-expression" or r.kind = "function-expression";
let async_tokens = select l.parent as owner, r.id as id, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and r.text = "async";
let found = select l.id as id, l.file as file, l.span as span from async_tokens as l join functions as r on l.owner = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-async-promise-executor(?:,|$)");
emit violations subject file key(id);
