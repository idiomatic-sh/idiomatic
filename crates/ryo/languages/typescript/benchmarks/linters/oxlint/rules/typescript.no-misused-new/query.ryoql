import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let interfaces = select l.parent as owner, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "id";
let interface_names = select l.owner as owner, l.name as name from interfaces as l join "semantic-syntax" as r on l.owner = r.id where r.kind = "ts-interface-declaration";
let class_names = select l.owner as owner, l.name as name from interfaces as l join "semantic-syntax" as r on l.owner = r.id where r.kind = "class-declaration";
let bodies = select parent as owner, child as body from "semantic-child" where field = "body";
let members = select l.owner as owner, r.child as member from bodies as l join "semantic-child" as r on l.body = r.parent where r.field = "body";
let return_types = select parent as member, child as annotation from "semantic-child" where field = "return-type";
let annotated = select parent as annotation, child as reference from "semantic-child" where field = "type-annotation";
let referenced = select l.parent as reference, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "type-name";
let annotation_names = select l.annotation as annotation, r.name as name from annotated as l join referenced as r on l.reference = r.reference;
let returned = select l.member as member, r.name as name from return_types as l join annotation_names as r on l.annotation = r.annotation;
let construct_signatures = select l.owner as owner, l.member as member from members as l join "semantic-syntax" as r on l.member = r.id where r.kind = "ts-construct-signature-declaration";
let self_constructing = select l.member as member, r.name as name from construct_signatures as l join interface_names as r on l.owner = r.owner;
let misused_signatures = select l.member as member from self_constructing as l join returned as r on l.member = r.member and l.name = r.name;
let new_keywords = select l.parent as member, r.id as id, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "keyword" and r.text = "new";
let signature_hits = select r.id as id, r.file as file, r.span as span from misused_signatures as l join new_keywords as r on l.member = r.member;
let keys = select l.parent as member, l.child as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "key";
let method_signatures = select l.owner as owner, l.member as member from members as l join "semantic-syntax" as r on l.member = r.id where r.kind = "ts-method-signature";
let interface_methods = select l.member as member from method_signatures as l join interface_names as r on l.owner = r.owner;
let constructor_keys = select l.id as id from keys as l join interface_methods as r on l.member = r.member where l.name = "constructor";
let constructor_hits = select r.id as id, r.file as file, r.span as span from constructor_keys as l join "semantic-syntax" as r on l.id = r.id;
let values = select parent as member, child as value from "semantic-child" where field = "value";
let bodiless = select l.member as member, l.value as value from values as l join "semantic-syntax" as r on l.value = r.id where r.kind = "ts-empty-body-function-expression";
let class_methods = select l.owner as owner, l.member as member from members as l join bodiless as r on l.member = r.member;
let new_methods = select l.owner as owner, l.member as member, r.id as key from class_methods as l join keys as r on l.member = r.member where r.name = "new";
let class_news = select l.member as member, l.key as key, r.name as name from new_methods as l join class_names as r on l.owner = r.owner;
let bodiless_returned = select l.member as member, r.name as name from bodiless as l join returned as r on l.value = r.member;
let misused_methods = select l.key as id from class_news as l join bodiless_returned as r on l.member = r.member and l.name = r.name;
let method_hits = select r.id as id, r.file as file, r.span as span from misused_methods as l join "semantic-syntax" as r on l.id = r.id;
let interface_hits = union(left=signature_hits, right=constructor_hits);
let found = union(left=interface_hits, right=method_hits);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-misused-new(?:,|$)");
emit violations subject file key(id);
