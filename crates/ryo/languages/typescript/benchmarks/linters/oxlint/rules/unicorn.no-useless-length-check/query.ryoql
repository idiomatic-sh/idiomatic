import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let chains = select id from "semantic-syntax" where kind = "chain-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let chain_unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join chains as r on l.parent = r.id where l.field = "expression";
let chain_unwrapped = closure(edges=chain_unwrapping, source="outer", destination="inner");
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let members = select id from "semantic-syntax" where kind = "member-expression";
let properties = select l.parent as member, l.child as property from "semantic-child" as l join members as r on l.parent = r.id where l.field = "property";
let static_properties = antijoin(left=properties, right=computed, left-on=["member"], right-on=["id"]);
let computed_properties = select l.member as member, l.property as property from properties as l join computed as r on l.member = r.id;
let static_names = select l.member as member, r.name as name from static_properties as l join names as r on l.property = r.id;
let string_names = select l.member as member, r.value as name from computed_properties as l join "string-literal" as r on l.property = r.occurrence;
let property_rows = select l.member as member, r.file as file, r.span as span from computed_properties as l join "semantic-syntax" as r on l.property = r.id;
let templates = select file, span, text from "semantic-syntax" where kind = "template" and matches(text, "^\x60(?:length|every|some)\x60$");
let template_names_raw = select l.member as member, r.text as text from property_rows as l join templates as r on l.file = r.file and l.span = r.span;
let template_names = replace(from=template_names_raw, text="text", pattern="\x60", replacement="", output="name");
let template_members = select member, name from template_names;
let named_a = union(left=static_names, right=string_names);
let member_names = union(left=named_a, right=template_members);
let objects = select l.parent as member, l.child as object from "semantic-child" as l join members as r on l.parent = r.id where l.field = "object";
let direct_objects = select member, object as inner from objects;
let reached_objects = select l.member as member, r.inner as inner from objects as l join unwrapped as r on l.object = r.outer;
let inner_objects = union(left=direct_objects, right=reached_objects);
let object_names = select l.member as member, r.name as array from inner_objects as l join names as r on l.inner = r.id;
let binaries = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "===" or r.text = "!==" or r.text = ">");
let binary_rows = select l.id as id, l.operator as operator from binaries as l join "semantic-syntax" as r on l.id = r.id where r.kind = "binary-expression";
let binary_lefts = select l.id as id, l.operator as operator, c.child as left from binary_rows as l join "semantic-child" as c on l.id = c.parent where c.field = "left";
let direct_lefts = select id, operator, left as inner from binary_lefts;
let reached_lefts = select l.id as id, l.operator as operator, r.inner as inner from binary_lefts as l join unwrapped as r on l.left = r.outer;
let inner_lefts = union(left=direct_lefts, right=reached_lefts);
let length_members = select member from member_names where name = "length";
let length_lefts = select l.id as id, l.operator as operator, l.inner as member from inner_lefts as l join length_members as r on l.inner = r.member;
let length_arrays = select l.id as id, l.operator as operator, r.array as array from length_lefts as l join object_names as r on l.member = r.member;
let zero_tokens = select file, span from "semantic-syntax" where kind = "numeric" and text = "0";
let zero_literals = select r.id as id, r.file as file, r.span as span from zero_tokens as l join "semantic-syntax" as r on l.file = r.file and l.span = r.span where r.kind = "literal";
let wrapped_zeros = parenthesized(candidates=zero_literals);
let bare_zeros = antijoin(left=zero_literals, right=wrapped_zeros, left-on=["id"], right-on=["id"]);
let zero_rights = select l.parent as id from "semantic-child" as l join bare_zeros as r on l.child = r.id where l.field = "right";
let checks = select l.id as id, l.operator as operator, l.array as array from length_arrays as l join zero_rights as r on l.id = r.id;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join chain_unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let method_members = select member, name from member_names where name = "every" or name = "some";
let callee_methods = select l.id as id, l.inner as member, r.name as method from inner_callees as l join method_members as r on l.inner = r.member;
let method_calls = select l.id as id, l.method as method, r.array as array from callee_methods as l join object_names as r on l.member = r.member;
let logical_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "&&" or r.text = "||");
let logicals = select l.id as id, l.operator as operator from logical_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "logical-expression";
let operands = select l.id as id, l.operator as operator, c.child as operand from logicals as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let same_edges = select l.id as outer, r.id as inner from operands as l join logicals as r on l.operand = r.id where l.operator = r.operator;
let reach = closure(edges=same_edges, source="outer", destination="inner");
let leaf_operands = antijoin(left=operands, right=same_edges, left-on=["id", "operand"], right-on=["outer", "inner"]);
let own_leaves = select id as owner, operator, operand as leaf from leaf_operands;
let deep_leaves = select l.outer as owner, r.operator as operator, r.operand as leaf from reach as l join leaf_operands as r on l.inner = r.id;
let leaves = union(left=own_leaves, right=deep_leaves);
let leaf_rows = select l.owner as owner, l.operator as operator, l.leaf as leaf, r.file as file, r.span as span from leaves as l join "semantic-syntax" as r on l.leaf = r.id;
let leaf_bounds = span-bounds(from=leaf_rows, span="span", start-output="begin", end-output="finish");
let ordered = select l.owner as owner, l.operator as operator, l.leaf as first, l.begin as first_begin, r.leaf as second, r.begin as second_begin from leaf_bounds as l join leaf_bounds as r on l.owner = r.owner where l.begin < r.begin;
let between = select l.owner as owner, l.first as first, l.second as second from ordered as l join leaf_bounds as r on l.owner = r.owner where r.begin > l.first_begin and r.begin < l.second_begin;
let adjacent = antijoin(left=ordered, right=between, left-on=["owner", "first", "second"], right-on=["owner", "first", "second"]);
let check_first = select l.owner as owner, l.operator as operator, l.first as check, l.second as call from adjacent as l join checks as r on l.first = r.id;
let check_second = select l.owner as owner, l.operator as operator, l.second as check, l.first as call from adjacent as l join checks as r on l.second = r.id;
let pairs = union(left=check_first, right=check_second);
let pair_checks = select l.owner as owner, l.operator as operator, l.check as check, l.call as call, r.operator as comparison, r.array as array from pairs as l join checks as r on l.check = r.id;
let matched = select l.owner as owner, l.operator as operator, l.check as check, l.comparison as comparison, r.method as method from pair_checks as l join method_calls as r on l.call = r.id and l.array = r.array;
let useless = select owner, check from matched where (operator = "||" and method = "every" and comparison = "===") or (operator = "&&" and method = "some" and (comparison = "!==" or comparison = ">"));
let owned = select l.check as id, l.owner as owner, r.file as file, r.span as span from useless as l join "semantic-syntax" as r on l.check = r.id;
let found = select id, file, span from owned;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-useless-length-check(?:,|$)");
let reported = select l.id as id, l.owner as owner, l.file as file, l.span as span from owned as l join violations as r on l.id = r.id;
emit reported subject file key(id, owner);
