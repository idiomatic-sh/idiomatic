import directives from "typescript/oxlint/eslint-directives";
let private_tokens = select file, span, text from "semantic-syntax" where kind = "private-identifier-token";
let privates = select l.id as id, l.file as file, l.span as span, r.text as name from "semantic-syntax" as l join private_tokens as r on l.file = r.file and l.span = r.span where l.kind = "private-identifier";
let bodies = select id from "semantic-syntax" where kind = "class-body";
let elements = select l.parent as body, l.child as element, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "body" and (r.kind = "property-definition" or r.kind = "method-definition");
let keys = select l.parent as element, r.id as key, r.file as file, r.span as span, r.name as name from "semantic-child" as l join privates as r on l.child = r.id where l.field = "key";
let declared = select l.body as body, l.element as element, l.kind as kind, r.key as key, r.file as file, r.span as span, r.name as name from elements as l join keys as r on l.element = r.element;
let values = select parent as element, child as value from "semantic-child" where field = "value";
let signatures = select l.element as element from values as l join "semantic-syntax" as r on l.value = r.id where r.kind = "ts-empty-body-function-expression";
let members = antijoin(left=declared, right=signatures, left-on=["element"], right-on=["element"]);
let reference_parents = select l.parent as owner, l.field as field, r.id as id, r.name as name from "semantic-child" as l join privates as r on l.child = r.id;
let field_references = select l.owner as access, l.id as id, l.name as name from reference_parents as l join "semantic-syntax" as r on l.owner = r.id where r.kind = "member-expression" and l.field = "property";
let in_references = select l.owner as access, l.id as id, l.name as name from reference_parents as l join "semantic-syntax" as r on l.owner = r.id where r.kind = "binary-expression" and l.field = "left";
let all_references = union(left=field_references, right=in_references);
let reference_rows = select l.id as id, r.file as file, r.span as span from all_references as l join privates as r on l.id = r.id;
let reference_bodies = axis(from=reference_rows, relation="semantic-child", direction=nearest-ancestor, domain=bodies);
let scoped_references = select l.access as access, l.name as name, r.related as body from all_references as l join reference_bodies as r on l.id = r.id;
let edges = select l.parent as outer, l.child as inner, l.field as field, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id;
let wrapper_edges = select inner, outer from edges where field = "expression" and (kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion");
let climb_edges = select inner, outer from edges where kind = "update-expression" or kind = "conditional-expression" or kind = "logical-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let object_properties = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "object-expression";
let plain_values = select inner from edges where kind = "return-statement" or kind = "call-expression" or kind = "new-expression" or kind = "binary-expression" or kind = "variable-declarator" or kind = "property-definition" or kind = "array-expression" or kind = "jsx-expression-container" or kind = "chain-expression" or kind = "member-expression" or kind = "template-literal" or kind = "unary-expression" or kind = "if-statement" or kind = "spread-element" or kind = "assignment-pattern" or kind = "switch-case" or kind = "switch-statement" or kind = "throw-statement" or kind = "while-statement" or kind = "do-while-statement" or kind = "await-expression" or kind = "sequence-expression" or (kind = "assignment-expression" and field = "right") or (kind = "arrow-function-expression" and field = "body");
let property_values = select l.inner as inner from edges as l join object_properties as r on l.outer = r.id where l.kind = "property";
let valued = union(left=plain_values, right=property_values);
let accesses = select access as id from field_references;
let climbed = closure(edges=climb_edges, source="inner", destination="outer");
let climbed_accesses = select l.id as access, r.outer as node from accesses as l join climbed as r on l.id = r.inner;
let own_accesses = select id as access, id as node from accesses;
let access_nodes = union(left=climbed_accesses, right=own_accesses);
let valued_reads = select l.access as access from access_nodes as l join valued as r on l.node = r.inner;
let wrapped = closure(edges=wrapper_edges, source="inner", destination="outer");
let wrapped_accesses = select l.id as access, r.outer as node from accesses as l join wrapped as r on l.id = r.inner;
let exposed_all = union(left=wrapped_accesses, right=own_accesses);
let exposed = antijoin(left=exposed_all, right=wrapper_edges, left-on=["node"], right-on=["inner"]);
let parents = select l.access as access, r.outer as owner, r.field as field, r.kind as kind from exposed as l join edges as r on l.node = r.inner;
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let compound_targets = select l.access as access, l.owner as owner from parents as l join operators as r on l.owner = r.id where l.kind = "assignment-expression" and l.field = "left" and r.operator != "=";
let compound_climbed = select l.access as access, r.outer as node from compound_targets as l join climbed as r on l.owner = r.inner;
let compound_own = select access, owner as node from compound_targets;
let compound_nodes = union(left=compound_climbed, right=compound_own);
let compound_reads = select l.access as access from compound_nodes as l join valued as r on l.node = r.inner;
let slot_reads = select access from parents where ((kind = "for-in-statement" or kind = "for-of-statement") and field = "right") or (kind = "conditional-expression" and field = "test") or (kind = "logical-expression" and field = "left");
let reads_a = union(left=valued_reads, right=compound_reads);
let reads = union(left=reads_a, right=slot_reads);
let read_references = select l.name as name, l.body as body from scoped_references as l join reads as r on l.access = r.access;
let any_references = select name, body from scoped_references;
let properties = select body, element, key, file, span, name from members where kind = "property-definition";
let methods = select body, element, key, file, span, name from members where kind = "method-definition";
let unread_properties = antijoin(left=properties, right=read_references, left-on=["body", "name"], right-on=["body", "name"]);
let unreferenced_methods = antijoin(left=methods, right=any_references, left-on=["body", "name"], right-on=["body", "name"]);
let unused = union(left=unread_properties, right=unreferenced_methods);
let found = select key as id, file, span from unused;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unused-private-class-members(?:,|$)");
emit violations subject file key(id);
