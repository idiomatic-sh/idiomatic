import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let boolean_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "Boolean";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let invocations = select id from "semantic-syntax" where kind = "call-expression" or kind = "new-expression";
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join invocations as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let boolean_invocations = select l.id as id from inner_callees as l join boolean_names as r on l.inner = r.id;
let boolean_calls = select l.id as id from boolean_invocations as l join "semantic-syntax" as r on l.id = r.id where r.kind = "call-expression";
let arguments = select l.parent as owner, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join boolean_invocations as r on l.parent = r.id where l.field = "arguments";
let later_arguments = select l.argument as argument from arguments as l join arguments as r on l.owner = r.owner where l.ordinal > r.ordinal;
let first_arguments = antijoin(left=arguments, right=later_arguments, left-on=["argument"], right-on=["argument"]);
let first_slots = select argument as id from first_arguments;
let tests = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "test" and (r.kind = "if-statement" or r.kind = "do-while-statement" or r.kind = "while-statement" or r.kind = "conditional-expression" or r.kind = "for-statement");
let nots = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.kind = "punctuator" and r.text = "!";
let negations = select l.id as id from nots as l join "semantic-syntax" as r on l.id = r.id where r.kind = "unary-expression";
let negated = select l.child as id from "semantic-child" as l join negations as r on l.parent = r.id where l.field = "argument";
let slots_a = union(left=first_slots, right=tests);
let slots = union(left=slots_a, right=negated);
let chains = select l.child as inner, l.parent as outer from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "chain-expression" and l.field = "expression";
let chained_slots = select l.inner as id from chains as l join slots as r on l.outer = r.id;
let boolean_slots = union(left=slots, right=chained_slots);
let flagged_calls = select l.id as id from boolean_calls as l join boolean_slots as r on l.id = r.id;
let doubles = select l.id as id from negations as l join negated as r on l.id = r.id;
let outer_negations = select l.parent as id from "semantic-child" as l join doubles as r on l.child = r.id where l.field = "argument";
let flagged_doubles = select l.id as id from outer_negations as l join slots as r on l.id = r.id;
let flagged = union(left=flagged_calls, right=flagged_doubles);
let found = select r.id as id, r.file as file, r.span as span from flagged as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-extra-boolean-cast(?:,|$)");
emit violations subject file key(id);
