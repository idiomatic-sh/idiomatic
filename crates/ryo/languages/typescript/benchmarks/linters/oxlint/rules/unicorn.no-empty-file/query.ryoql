import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let programs = select id, file, span from "semantic-syntax" where kind = "program";
let body = select l.parent as program, l.child as id, l.ordinal as ordinal from "semantic-child" as l join programs as r on l.parent = r.id where l.field = "body";
let body_rows = select l.program as program, l.id as id, l.ordinal as ordinal, r.kind as kind from body as l join "semantic-syntax" as r on l.id = r.id;
let statement_strings = select l.parent as id, r.id as expression, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "expression" and r.kind = "literal";
let string_tokens = select file, span from "semantic-syntax" where kind = "string";
let string_statements = select l.id as id, l.expression as expression, l.file as file, l.span as span from statement_strings as l join string_tokens as r on l.file = r.file and l.span = r.span;
let string_expressions = select expression as id, file, span from string_statements;
let wrapped_strings = parenthesized(candidates=string_expressions);
let bare_strings = antijoin(left=string_statements, right=wrapped_strings, left-on=["expression"], right-on=["id"]);
let prologue_shaped = select l.program as program, l.id as id, l.ordinal as ordinal from body_rows as l join bare_strings as r on l.id = r.id;
let other_statements = antijoin(left=body_rows, right=prologue_shaped, left-on=["id"], right-on=["id"]);
let interrupted = select l.id as id from prologue_shaped as l join other_statements as r on l.program = r.program where r.ordinal < l.ordinal;
let prologue = antijoin(left=prologue_shaped, right=interrupted, left-on=["id"], right-on=["id"]);
let counted = antijoin(left=body_rows, right=prologue, left-on=["id"], right-on=["id"]);
let top_filled = select program from counted where kind != "empty-statement" and kind != "block-statement";
let top_blocks = select program, id as block from counted where kind = "block-statement";
let block_children = select l.parent as block, l.child as id, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "body";
let block_edges = select l.block as outer, l.id as inner from block_children as l join "semantic-syntax" as r on l.block = r.id where r.kind = "block-statement" and l.kind = "block-statement";
let nested_blocks = closure(edges=block_edges, source="outer", destination="inner");
let deeper_blocks = select l.program as program, r.inner as block from top_blocks as l join nested_blocks as r on l.block = r.outer;
let blocks = union(left=top_blocks, right=deeper_blocks);
let block_filled = select l.program as program from blocks as l join block_children as r on l.block = r.block where r.kind != "empty-statement" and r.kind != "block-statement";
let filled = union(left=top_filled, right=block_filled);
let triple_slash = select file from "semantic-syntax" where kind = "line" and starts_with(text, "///");
let unfilled = antijoin(left=programs, right=filled, left-on=["id"], right-on=["program"]);
let empty = antijoin(left=unfilled, right=triple_slash, left-on=["file"], right-on=["file"]);
let sizes = span-bounds(from=empty, span="span", start-output="begin", end-output="finish");
let short = select id, file, span from sizes where finish <= 100;
let long = select id, file, span from sizes where finish > 100;
let heads = source-matches(from=long, span="span", pattern="\A(?s:.){0,100}", output="head");
let characters = source-matches(from=heads, span="head", pattern="(?s).", output="character");
let character_bounds = span-bounds(from=characters, span="character", start-output="cbegin", end-output="cfinish");
let cuts = select id, file, span, character from character_bounds where cfinish = 100;
let truncated = span-between(from=cuts, start="span", end="character", output="cut");
let truncated_rows = select id, file, cut as span from truncated;
let found = union(left=short, right=truncated_rows);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-empty-file(?:,|$)");
emit violations subject file key(id);
