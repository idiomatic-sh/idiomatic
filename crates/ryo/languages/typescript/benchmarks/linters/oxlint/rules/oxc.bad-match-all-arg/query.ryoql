import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constant_values from "typescript/oxlint/constant-values";
let reads = select reference, name, state, file from "binding-read";
let references = select reference, file from reads;
let values = constant_values(references=references);
let value_edges = select reference, value from values;
let followed = closure(edges=value_edges, source="reference", destination="value");
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let templates = select file, span, text from "semantic-syntax" where kind = "template";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let arguments = select parent as call, child as argument, ordinal from "semantic-child" where field = "arguments";
let earlier = select l.call as call, l.argument as argument from arguments as l join arguments as r on l.call = r.call where r.ordinal < l.ordinal;
let earlier_counts = group-count(from=earlier, keys=["call", "argument"], count="earlier");
let first_arguments = antijoin(left=arguments, right=earlier, left-on=["call", "argument"], right-on=["call", "argument"]);
let second_arguments = select l.call as call, l.argument as argument from arguments as l join earlier_counts as r on l.call = r.call and l.argument = r.argument where r.earlier = 1;
let callees = select l.parent as call, r.id as callee, r.kind as kind, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "callee";
let callee_rows = select callee as id, file, span from callees;
let wrapped_callees = parenthesized(candidates=callee_rows);
let bare_callees = antijoin(left=callees, right=wrapped_callees, left-on=["callee"], right-on=["id"]);
let literal_nodes = select id, file, span from "semantic-syntax" where kind = "literal";
let regex_tokens = select file, span from "semantic-syntax" where kind = "regular-expression" and matches(text, "/[dimsuvy]*$");
let literals = select l.id as id from literal_nodes as l join regex_tokens as r on l.file = r.file and l.span = r.span;
let constructors = select id from "semantic-syntax" where kind = "new-expression" or kind = "call-expression";
let plain_constructors = antijoin(left=constructors, right=optional, left-on=["id"], right-on=["id"]);
let constructor_callees = select l.call as call, l.callee as callee, l.kind as kind from bare_callees as l join plain_constructors as r on l.call = r.id;
let global_reads = select reference, name from reads where state = "builtin" or state = "unbound";
let named_constructors = select l.call as call from constructor_callees as l join global_reads as r on l.callee = r.reference where l.kind = "identifier" and r.name = "RegExp";
let member_constructors = select call, callee from constructor_callees where kind = "member-expression";
let member_objects = select l.call as call, l.callee as callee, r.child as object from member_constructors as l join "semantic-child" as r on l.callee = r.parent where r.field = "object";
let global_members = select l.call as call, l.callee as callee from member_objects as l join global_reads as r on l.object = r.reference where r.name = "globalThis" or r.name = "window" or r.name = "global";
let member_properties = select l.call as call, l.callee as callee, r.child as property from global_members as l join "semantic-child" as r on l.callee = r.parent where r.field = "property";
let static_members = antijoin(left=member_properties, right=computed, left-on=["callee"], right-on=["id"]);
let static_constructors = select l.call as call from static_members as l join names as r on l.property = r.id where r.name = "RegExp";
let computed_members = select l.call as call, l.property as property from member_properties as l join computed as r on l.callee = r.id;
let string_constructors = select l.call as call from computed_members as l join "string-literal" as r on l.property = r.occurrence where r.value = "RegExp";
let regexp_a = union(left=named_constructors, right=static_constructors);
let regexp_calls = union(left=regexp_a, right=string_constructors);
let flagged_arguments = select call, argument from second_arguments;
let flagless = antijoin(left=regexp_calls, right=flagged_arguments, left-on=["call"], right-on=["call"]);
let flag_arguments = select l.call as call, l.argument as argument from second_arguments as l join regexp_calls as r on l.call = r.call;
let string_flags = select l.call as call from flag_arguments as l join "string-literal" as r on l.argument = r.occurrence where matches(r.value, "^[dimsuvy]*$");
let flag_rows = select l.call as call, r.file as file, r.span as span from flag_arguments as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "template-literal";
let template_flags = select l.call as call from flag_rows as l join templates as r on l.file = r.file and l.span = r.span where matches(r.text, "^\x60[dimsuvy]*\x60$");
let constructed_a = union(left=flagless, right=string_flags);
let constructed_b = union(left=constructed_a, right=template_flags);
let constructed = select call as id from constructed_b;
let missing_global = union(left=literals, right=constructed);
let calls = select id from "semantic-syntax" where kind = "call-expression";
let method_callees = select l.call as call, l.callee as callee from bare_callees as l join calls as r on l.call = r.id where l.kind = "member-expression";
let method_properties = select l.call as call, l.callee as callee, r.child as property from method_callees as l join "semantic-child" as r on l.callee = r.parent where r.field = "property";
let static_methods = antijoin(left=method_properties, right=computed, left-on=["callee"], right-on=["id"]);
let static_named = select l.call as call, l.property as property from static_methods as l join names as r on l.property = r.id where r.name = "matchAll";
let computed_methods = select l.call as call, l.property as property from method_properties as l join computed as r on l.callee = r.id;
let string_named = select l.call as call, l.property as property from computed_methods as l join "string-literal" as r on l.property = r.occurrence where r.value = "matchAll";
let computed_method_rows = select l.call as call, l.property as property, r.file as file, r.span as span from computed_methods as l join "semantic-syntax" as r on l.property = r.id where r.kind = "template-literal";
let template_named = select l.call as call, l.property as property from computed_method_rows as l join templates as r on l.file = r.file and l.span = r.span where r.text = "\x60matchAll\x60";
let named_a = union(left=static_named, right=string_named);
let named = union(left=named_a, right=template_named);
let patterns = select l.call as call, l.property as property, r.argument as pattern from named as l join first_arguments as r on l.call = r.call;
let direct = select l.call as call, l.property as property from patterns as l join missing_global as r on l.pattern = r.id;
let reached = select l.call as call, l.property as property, r.value as value from patterns as l join followed as r on l.pattern = r.reference;
let indirect = select l.call as call, l.property as property from reached as l join missing_global as r on l.value = r.id;
let hits = union(left=direct, right=indirect);
let found = select r.id as id, r.file as file, r.span as span from hits as l join "semantic-syntax" as r on l.property = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?bad-match-all-arg(?:,|$)");
emit violations subject file key(id);
