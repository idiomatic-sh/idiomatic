import directives from "typescript/oxlint/eslint-directives";
let edges = select parent, child from "pattern-child";
let reach = closure(edges=edges, source="parent", destination="child");
let rows = select id, carrier, kind, text, value, file, span from "pattern-syntax";
let bounded = span-bounds(from=rows, span="span", start-output="begin", end-output="finish");
let groups = select id, carrier, file, span, begin, finish from bounded where kind = "capturing-group";
let earlier_groups = select l.id as id, l.carrier as carrier from groups as l join groups as r on l.carrier = r.carrier where r.begin <= l.begin;
let ranks = group-count(from=earlier_groups, keys=["id", "carrier"], count="rank");
let indexed = select id, carrier, file, span, begin, finish, value from bounded where kind = "indexed-reference";
let indexed_pairs = select l.id as bref, l.carrier as carrier, l.file as file, l.span as span, l.begin as bref_begin, l.finish as bref_finish, r.id as group from indexed as l join ranks as r on l.carrier = r.carrier and l.value = r.rank;
let named = select id, carrier, file, span, begin, finish from bounded where kind = "named-reference";
let reference_names = source-matches(from=named, span="span", pattern="\\k<(?P<name>[^>]+)>", output="written", capture="name", capture-output="name_span", capture-text-output="name");
let group_names = source-matches(from=groups, span="span", pattern="\A\(\?<(?P<name>[^>]+)>", output="written", capture="name", capture-output="name_span", capture-text-output="name");
let named_pairs = select l.id as bref, l.carrier as carrier, l.file as file, l.span as span, l.begin as bref_begin, l.finish as bref_finish, r.id as group from reference_names as l join group_names as r on l.carrier = r.carrier and l.name = r.name;
let resolved = union(left=indexed_pairs, right=named_pairs);
let pairs = select l.bref as bref, l.file as file, l.span as span, l.bref_begin as bref_begin, l.bref_finish as bref_finish, l.group as group, r.begin as group_begin, r.finish as group_finish from resolved as l join groups as r on l.group = r.id;
let nested = select l.bref as bref, l.group as group from pairs as l join reach as r on l.group = r.parent and l.bref = r.child;
let group_ancestors = select l.bref as bref, l.group as group, r.parent as ancestor from pairs as l join reach as r on l.group = r.child;
let bref_ancestors = select l.bref as bref, r.parent as ancestor from pairs as l join reach as r on l.bref = r.child;
let common = select l.bref as bref, l.group as group, l.ancestor as ancestor from group_ancestors as l join bref_ancestors as r on l.bref = r.bref and l.ancestor = r.ancestor;
let common_pairs = select l.bref as bref, l.group as group, l.ancestor as upper, r.ancestor as lower from common as l join common as r on l.bref = r.bref and l.group = r.group;
let uppers = select l.bref as bref, l.group as group, l.upper as ancestor from common_pairs as l join reach as r on l.upper = r.parent and l.lower = r.child;
let lowest = antijoin(left=common, right=uppers, left-on=["bref", "group", "ancestor"], right-on=["bref", "group", "ancestor"]);
let disjunctive = select l.bref as bref, l.group as group from lowest as l join "pattern-syntax" as r on l.ancestor = r.id where r.kind = "disjunction";
let lookarounds = select l.bref as bref, l.group as group, l.ancestor as ancestor, r.text as text from common as l join "pattern-syntax" as r on l.ancestor = r.id where r.kind = "look-around-assertion";
let lookaround_pairs = select l.bref as bref, l.group as group, l.ancestor as upper, r.ancestor as lower from lookarounds as l join lookarounds as r on l.bref = r.bref and l.group = r.group;
let outer_lookarounds = select l.bref as bref, l.group as group, l.upper as ancestor from lookaround_pairs as l join reach as r on l.upper = r.parent and l.lower = r.child;
let lowest_lookarounds = antijoin(left=lookarounds, right=outer_lookarounds, left-on=["bref", "group", "ancestor"], right-on=["bref", "group", "ancestor"]);
let behind = select bref, group from lowest_lookarounds where matches(text, "^\(\?<[=!]");
let behind_pairs = select l.bref as bref, l.group as group, l.bref_begin as bref_begin, l.group_finish as group_finish from pairs as l join behind as r on l.bref = r.bref and l.group = r.group;
let ahead_pairs = antijoin(left=pairs, right=behind, left-on=["bref", "group"], right-on=["bref", "group"]);
let forward = select bref, group from ahead_pairs where bref_finish <= group_begin;
let backward = select bref, group from behind_pairs where group_finish <= bref_begin;
let group_lookarounds = select l.bref as bref, l.group as group, l.ancestor as ancestor from group_ancestors as l join "pattern-syntax" as r on l.ancestor = r.id where r.kind = "look-around-assertion" and matches(r.text, "^\(\?<?!");
let negated = antijoin(left=group_lookarounds, right=bref_ancestors, left-on=["bref", "ancestor"], right-on=["bref", "ancestor"]);
let negated_pairs = select bref, group from negated;
let useless_1 = union(left=nested, right=disjunctive);
let useless_2 = union(left=useless_1, right=forward);
let useless_3 = union(left=useless_2, right=backward);
let useless = union(left=useless_3, right=negated_pairs);
let found_rows = select l.bref as id, l.file as file, l.span as span from pairs as l join useless as r on l.bref = r.bref and l.group = r.group;
let found = project(from=found_rows, columns=["id", "file", "span"]);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-useless-backreference(?:,|$)");
emit violations subject file key(id, span);
