import directives from "typescript/oxlint/eslint-directives";
let plain_declarators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "id" and r.kind = "identifier";
let function_inits = select l.child as function, l.parent as binding from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "init" and (r.kind = "function-expression" or r.kind = "arrow-function-expression");
let initialized = select l.function as function, l.binding as binding from function_inits as l join plain_declarators as r on l.binding = r.id;
let named_functions = select id as function, id as binding from "defines" where kind = "function" and (refinement = "function-declaration" or refinement = "function-expression");
let self_named = antijoin(left=named_functions, right=initialized, left-on=["function"], right-on=["function"]);
let functions = union(left=initialized, right=self_named);
let assignment_targets = select l.child as reference from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "assignment-expression" and l.field = "left";
let reassigned = select l.binding as binding from "binding-use" as l join assignment_targets as r on l.reference = r.reference;
let kept = antijoin(left=functions, right=reassigned, left-on=["binding"], right-on=["binding"]);
let parameters = select id, kind, refinement, name, ordinal, owner, file from "parameter";
let receivers = select owner from parameters where kind = "receiver";
let defaults = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "left" and r.kind = "identifier";
let identifier_parameters = select id, name, ordinal, owner, file from parameters where refinement = "identifier";
let default_parameters = select l.id as id, l.name as name, l.ordinal as ordinal, l.owner as owner, l.file as file from parameters as l join defaults as r on l.id = r.id where l.refinement = "assignment-pattern";
let plain_parameters = union(left=identifier_parameters, right=default_parameters);
let counted_parameters = antijoin(left=plain_parameters, right=receivers, left-on=["owner"], right-on=["owner"]);
let targets = select l.id as id, l.name as name, l.ordinal as ordinal, l.file as file, r.binding as function from counted_parameters as l join kept as r on l.owner = r.function;
let references = select l.id as id, l.name as name, l.ordinal as ordinal, l.function as function, r.reference as reference from targets as l join "binding-use" as r on l.id = r.binding;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let call_parents = select l.child as reference, l.parent as call from "semantic-child" as l join calls as r on l.parent = r.id;
let callees = select l.parent as call, r.binding as binding from "semantic-child" as l join "binding-use" as r on l.child = r.reference where l.field = "callee";
let in_calls = select l.id as id, l.name as name, l.ordinal as ordinal, l.function as function, l.reference as reference, r.call as call from references as l join call_parents as r on l.reference = r.reference;
let recursive = select l.id as id, l.name as name, l.ordinal as ordinal, l.reference as reference, l.call as call from in_calls as l join callees as r on l.call = r.call and l.function = r.binding;
let placed = select l.reference as reference from recursive as l join "call-argument" as r on l.call = r.call and l.ordinal = r.position where r.passes = "" or r.passes = l.name;
let strays = antijoin(left=references, right=placed, left-on=["reference"], right-on=["reference"]);
let referenced = select id, file from targets;
let used_parameters = select l.id as id, l.file as file from referenced as l join references as r on l.id = r.id;
let only_recursive = antijoin(left=used_parameters, right=strays, left-on=["id"], right-on=["id"]);
let names = select l.id as id, l.file as file, r.span as span from only_recursive as l join "defines" as r on l.id = r.id where r.kind = "parameter";
let name_bounds = span-bounds(from=names, span="span", start-output="begin", end-output="finish");
let tokens = select id, file, span from "semantic-syntax" where kind = "identifier-token";
let token_bounds = span-bounds(from=tokens, span="span", start-output="tbegin", end-output="tfinish");
let found = select l.id as id, l.file as file, r.span as span from name_bounds as l join token_bounds as r on l.file = r.file and l.begin = r.tbegin;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?only-used-in-recursion(?:,|$)");
emit violations subject file key(id);
