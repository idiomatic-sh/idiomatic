import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let chains = select id from "semantic-syntax" where kind = "chain-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let chain_unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join chains as r on l.parent = r.id where l.field = "expression";
let chain_unwrapped = closure(edges=chain_unwrapping, source="outer", destination="inner");
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join chain_unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let members = select l.id as id, l.inner as member from inner_callees as l join "semantic-syntax" as r on l.inner = r.id where r.kind = "member-expression";
let static_members = antijoin(left=members, right=computed, left-on=["member"], right-on=["id"]);
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let properties = select l.parent as member, r.id as property, r.file as file, r.span as span, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "property";
let remove_members = select l.id as id, r.property as property, r.file as file, r.span as span from static_members as l join properties as r on l.member = r.member where r.name = "removeEventListener";
let arguments = select l.parent as id, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join remove_members as r on l.parent = r.id where l.field = "arguments";
let preceding = select l.id as id, l.argument as argument, r.argument as earlier from arguments as l join arguments as r on l.id = r.id where r.ordinal < l.ordinal;
let preceding_counts = group-count(from=preceding, keys=["id", "argument"], count="earlier");
let seconds = select l.id as id, l.argument as argument from arguments as l join preceding_counts as r on l.id = r.id and l.argument = r.argument where r.earlier = 1;
let firsts = antijoin(left=arguments, right=preceding, left-on=["id", "argument"], right-on=["id", "argument"]);
let spread_firsts = select l.id as id from firsts as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "spread-element";
let listener_calls = antijoin(left=seconds, right=spread_firsts, left-on=["id"], right-on=["id"]);
let listeners = select l.id as id, r.id as listener, r.kind as kind, r.file as file, r.span as span from listener_calls as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "function-expression" or r.kind = "arrow-function-expression" or r.kind = "call-expression";
let listener_rows = select listener as id, file, span from listeners;
let wrapped = parenthesized(candidates=listener_rows);
let bare = antijoin(left=listeners, right=wrapped, left-on=["listener"], right-on=["id"]);
let functions = select id from bare where kind != "call-expression";
let bound_calls = select id, listener from bare where kind = "call-expression";
let bind_callees = select l.id as id, c.child as callee from bound_calls as l join "semantic-child" as c on l.listener = c.parent where c.field = "callee";
let direct_binds = select id, callee as inner from bind_callees;
let reached_binds = select l.id as id, r.inner as inner from bind_callees as l join chain_unwrapped as r on l.callee = r.outer;
let inner_binds = union(left=direct_binds, right=reached_binds);
let bind_members = select l.id as id, l.inner as member from inner_binds as l join "semantic-syntax" as r on l.inner = r.id where r.kind = "member-expression";
let static_binds = antijoin(left=bind_members, right=computed, left-on=["member"], right-on=["id"]);
let binds = select l.id as id from static_binds as l join properties as r on l.member = r.member where r.name = "bind";
let invalid = union(left=functions, right=binds);
let found = select r.property as id, r.file as file, r.span as span from invalid as l join remove_members as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-invalid-remove-event-listener(?:,|$)");
emit violations subject file key(id);
