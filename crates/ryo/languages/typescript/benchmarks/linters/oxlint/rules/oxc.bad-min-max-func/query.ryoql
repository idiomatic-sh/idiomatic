import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let members = select id from "semantic-syntax" where kind = "member-expression";
let properties = select l.parent as member, l.child as property from "semantic-child" as l join members as r on l.parent = r.id where l.field = "property";
let static_properties = antijoin(left=properties, right=computed, left-on=["member"], right-on=["id"]);
let computed_properties = select l.member as member, l.property as property from properties as l join computed as r on l.member = r.id;
let static_names = select l.member as member, r.name as name from static_properties as l join names as r on l.property = r.id;
let string_names = select l.member as member, r.value as name from computed_properties as l join "string-literal" as r on l.property = r.occurrence;
let property_rows = select l.member as member, r.file as file, r.span as span from computed_properties as l join "semantic-syntax" as r on l.property = r.id;
let templates = select file, span, text from "semantic-syntax" where kind = "template" and matches(text, "^\x60(?:min|max)\x60$");
let template_names_raw = select l.member as member, r.text as text from property_rows as l join templates as r on l.file = r.file and l.span = r.span;
let template_names = replace(from=template_names_raw, text="text", pattern="\x60", replacement="", output="name");
let template_members = select member, name from template_names;
let named_a = union(left=static_names, right=string_names);
let member_names = union(left=named_a, right=template_members);
let math_names = select id from names where name = "Math";
let objects = select l.parent as member, l.child as object from "semantic-child" as l join members as r on l.parent = r.id where l.field = "object";
let math_members = select l.member as member from objects as l join math_names as r on l.object = r.id;
let math_methods = select l.member as member, r.name as method from math_members as l join member_names as r on l.member = r.member where r.name = "min" or r.name = "max";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let callees = select l.parent as call, l.child as member from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "callee";
let call_methods = select l.call as call, r.method as method from callees as l join math_methods as r on l.member = r.member;
let arguments = select call, expression from "call-argument";
let numbers = select id, value, file, span from "numeric-literal" where kind = "float";
let number_rows = select id, file, span from numbers;
let wrapped_numbers = parenthesized(candidates=number_rows);
let bare_numbers = antijoin(left=numbers, right=wrapped_numbers, left-on=["id"], right-on=["id"]);
let call_numbers = select l.call as call, r.value as value from arguments as l join bare_numbers as r on l.expression = r.id;
let bounds = select l.call as call, l.method as method, r.value as value from call_methods as l join call_numbers as r on l.call = r.call;
let call_rows = select l.call as id, r.file as file, r.span as span from call_methods as l join "semantic-syntax" as r on l.call = r.id;
let wrapped_calls = parenthesized(candidates=call_rows);
let bare_calls = antijoin(left=call_methods, right=wrapped_calls, left-on=["call"], right-on=["id"]);
let nested = select l.call as outer, l.expression as inner from arguments as l join bare_calls as r on l.expression = r.call;
let outer_bounds = select l.outer as outer, l.inner as inner, r.method as outer_method, r.value as outer_value from nested as l join bounds as r on l.outer = r.call;
let pairs = select l.outer as outer, l.inner as inner, l.outer_method as outer_method, l.outer_value as outer_value, r.method as inner_method, r.value as inner_value from outer_bounds as l join bounds as r on l.inner = r.call;
let clamped = select outer, inner from pairs where (outer_method = "min" and inner_method = "max" and float_text_gte(inner_value, outer_value) and inner_value != outer_value) or (outer_method = "max" and inner_method = "min" and float_text_gte(outer_value, inner_value) and outer_value != inner_value);
let constant = project(from=clamped, columns=["outer", "inner"]);
let found = select l.outer as id, l.inner as inner, r.file as file, r.span as span from constant as l join "semantic-syntax" as r on l.outer = r.id;
let candidates = project(from=found, columns=["id", "file", "span"]);
let violations = directives(candidates=candidates, names="(?:^|,)(?:[^,]*/)?bad-min-max-func(?:,|$)");
let reported = select l.id as id, l.inner as inner, l.file as file, l.span as span from found as l join violations as r on l.id = r.id;
emit reported subject file key(id, inner);
