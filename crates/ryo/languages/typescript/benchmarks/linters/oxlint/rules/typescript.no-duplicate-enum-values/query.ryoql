import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let bodies = select id from "semantic-syntax" where kind = "ts-enum-body";
let members = select l.parent as body, l.child as member from "semantic-child" as l join bodies as r on l.parent = r.id where l.field = "members";
let initializers = select l.body as body, c.child as value from members as l join "semantic-child" as c on l.member = c.parent where c.field = "initializer";
let numbers = select id, value from "numeric-literal" where kind = "float";
let strings = select occurrence as id, value from "string-literal";
let numbered = select l.body as body, l.value as id, r.value as value from initializers as l join numbers as r on l.value = r.id;
let stringed = select l.body as body, l.value as id, r.value as value from initializers as l join strings as r on l.value = r.id;
let typed_numbers = extend(from=numbered, values={type: 1});
let typed_strings = extend(from=stringed, values={type: 2});
let valued = union(left=typed_numbers, right=typed_strings);
let rows = select l.body as body, l.id as id, l.value as value, l.type as type, r.file as file, r.span as span from valued as l join "semantic-syntax" as r on l.id = r.id;
let candidates = select id, file, span from rows;
let wrapped = parenthesized(candidates=candidates);
let bare = antijoin(left=rows, right=wrapped, left-on=["id"], right-on=["id"]);
let bounded = span-bounds(from=bare, span="span", start-output="begin", end-output="finish");
let later = select l.id as first, r.id as duplicate from bounded as l join bounded as r on l.body = r.body and l.type = r.type and l.value = r.value where l.begin < r.begin;
let preceded = select r.id as id from bounded as l join bounded as r on l.body = r.body and l.type = r.type and l.value = r.value where l.begin < r.begin;
let duplicates = antijoin(left=later, right=preceded, left-on=["first"], right-on=["id"]);
let found = select l.first as id, l.duplicate as duplicate, r.file as file, r.span as span from duplicates as l join "semantic-syntax" as r on l.first = r.id;
let firsts = project(from=found, columns=["id", "file", "span"]);
let violations = directives(candidates=firsts, names="(?:^|,)(?:[^,]*/)?no-duplicate-enum-values(?:,|$)");
let reported = select l.id as id, l.duplicate as duplicate, l.file as file, l.span as span from found as l join violations as r on l.id = r.id;
emit reported subject file key(id, duplicate);
