import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let binaries = select id, file, span from "semantic-syntax" where kind = "binary-expression";
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let equalities = select l.id as id, l.file as file, l.span as span from binaries as l join operators as r on l.id = r.id where r.operator = "==" or r.operator = "===" or r.operator = "!=" or r.operator = "!==";
let relations = select l.id as id, l.file as file, l.span as span from binaries as l join operators as r on l.id = r.id where r.operator = "<" or r.operator = "<=" or r.operator = ">" or r.operator = ">=";
let lefts = select parent as id, child as left from "semantic-child" where field = "left";
let left_equalities = select l.id as id, l.left as left from lefts as l join equalities as r on l.left = r.id;
let left_relations = select l.id as id, l.left as left from lefts as l join relations as r on l.left = r.id;
let equality_sequences = select l.id as id, r.left as left from equalities as l join left_equalities as r on l.id = r.id;
let relation_sequences = select l.id as id, r.left as left from relations as l join left_relations as r on l.id = r.id;
let sequences = union(left=equality_sequences, right=relation_sequences);
let left_rows = select r.id as id, r.file as file, r.span as span from sequences as l join "semantic-syntax" as r on l.left = r.id;
let wrapped_lefts = parenthesized(candidates=left_rows);
let bad = antijoin(left=sequences, right=wrapped_lefts, left-on=["left"], right-on=["id"]);
let bad_rows = select l.id as id, r.file as file, r.span as span from bad as l join "semantic-syntax" as r on l.id = r.id;
let bad_ids = select id from bad;
let bad_ancestors = axis(from=bad_rows, relation="semantic-child", direction=ancestor, domain=bad_ids);
let nodes = select id from "semantic-syntax" where kind != "whitespace";
let path_up = axis(from=bad_rows, relation="semantic-child", direction=ancestor, domain=nodes);
let path_proper = select related as node from path_up;
let path_self = select id as node from bad_rows;
let path_nodes = union(left=path_proper, right=path_self);
let path_rows = select r.id as id, r.file as file, r.span as span, r.kind as kind from path_nodes as l join "semantic-syntax" as r on l.node = r.id;
let path_candidates = select id, file, span from path_rows;
let wrapped_path = parenthesized(candidates=path_candidates);
let wrapped_ids = select id from wrapped_path;
let statement_ids = select id from path_rows where matches(kind, "(?:-statement|-declaration|^variable-declarator|^property-definition)$");
let boundaries = union(left=wrapped_ids, right=statement_ids);
let up_pairs = select id as bad, related as node from path_up;
let self_pairs = select id as bad, id as node from bad_rows;
let below = union(left=up_pairs, right=self_pairs);
let bad_boundaries = select l.bad as bad, l.node as node from below as l join boundaries as r on l.node = r.id;
let boundary_rows = select l.node as id, r.file as file, r.span as span from bad_boundaries as l join "semantic-syntax" as r on l.node = r.id;
let boundary_ancestors = axis(from=boundary_rows, relation="semantic-child", direction=ancestor, domain=bad_ids);
let blocked = select l.bad as id, r.related as related from bad_boundaries as l join boundary_ancestors as r on l.node = r.id;
let open_ancestors = antijoin(left=bad_ancestors, right=blocked, left-on=["id", "related"], right-on=["id", "related"]);
let reported = antijoin(left=bad, right=open_ancestors, left-on=["id"], right-on=["id"]);
let found = select r.id as id, r.file as file, r.span as span from reported as l join "semantic-syntax" as r on l.left = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?bad-comparison-sequence(?:,|$)");
emit violations subject file key(id);
