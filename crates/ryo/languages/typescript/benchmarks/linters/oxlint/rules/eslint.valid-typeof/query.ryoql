import directives from "typescript/oxlint/eslint-directives";
let typeof_operators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.text = "typeof";
let equality_operators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "==" or r.text = "===" or r.text = "!=" or r.text = "!==");
let comparisons = select l.id as id from equality_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "binary-expression";
let sides = select l.id as comparison, c.child as id, c.field as field from comparisons as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let typeof_sides = select l.comparison as comparison, l.field as field from sides as l join typeof_operators as r on l.id = r.id;
let other_left = select l.comparison as comparison, l.id as id from sides as l join typeof_sides as r on l.comparison = r.comparison where l.field = "left" and r.field = "right";
let other_right = select l.comparison as comparison, l.id as id from sides as l join typeof_sides as r on l.comparison = r.comparison where l.field = "right" and r.field = "left";
let others = union(left=other_left, right=other_right);
let strings = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "string";
let valid_strings = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "string" and matches(r.text, "^[\x22\x27](?:symbol|undefined|object|boolean|number|string|function|bigint)[\x22\x27]$");
let invalid_texts = antijoin(left=strings, right=valid_strings, left-on=["id"], right-on=["id"]);
let string_literals = select l.id as id from invalid_texts as l join "semantic-syntax" as r on l.id = r.id where r.kind = "literal";
let templates = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "template";
let valid_templates = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "template" and matches(r.text, "^\x60(?:symbol|undefined|object|boolean|number|string|function|bigint)\x60$");
let template_texts = antijoin(left=templates, right=valid_templates, left-on=["id"], right-on=["id"]);
let template_quasis = select l.parent as id from "semantic-child" as l join template_texts as r on l.child = r.id where l.field = "quasis";
let template_expressions = select parent as id from "semantic-child" where field = "expressions";
let plain_templates = antijoin(left=template_quasis, right=template_expressions, left-on=["id"], right-on=["id"]);
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let tokens = select file, span from "semantic-syntax" where kind = "identifier-token" and text = "undefined";
let undefined_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let invalid_strings = union(left=string_literals, right=plain_templates);
let invalid = union(left=invalid_strings, right=undefined_names);
let hits = select l.id as id from others as l join invalid as r on l.id = r.id;
let found = select r.id as id, r.file as file, r.span as span from hits as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?valid-typeof(?:,|$)");
emit violations subject file key(id);
