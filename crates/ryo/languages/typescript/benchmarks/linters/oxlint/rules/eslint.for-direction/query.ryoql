import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let loops = select id from "semantic-syntax" where kind = "for-statement";
let tests = select l.parent as loop, l.child as test from "semantic-child" as l join loops as r on l.parent = r.id where l.field = "test";
let updates = select l.parent as loop, l.child as update from "semantic-child" as l join loops as r on l.parent = r.id where l.field = "update";
let compared = select l.loop as loop, l.test as test, r.operator as operator from tests as l join operators as r on l.test = r.id where r.operator = "<" or r.operator = "<=" or r.operator = ">" or r.operator = ">=";
let side_names = select l.parent as id, l.field as side, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "left" or l.field = "right";
let counters = select l.loop as loop, l.test as test, r.name as name, l.operator as operator, r.side as side from compared as l join side_names as r on l.test = r.id;
let rising_left = select loop, test, name from counters where side = "left" and (operator = "<" or operator = "<=");
let rising_right = select loop, test, name from counters where side = "right" and (operator = ">" or operator = ">=");
let falling_left = select loop, test, name from counters where side = "left" and (operator = ">" or operator = ">=");
let falling_right = select loop, test, name from counters where side = "right" and (operator = "<" or operator = "<=");
let needs_rising = union(left=rising_left, right=rising_right);
let needs_falling = union(left=falling_left, right=falling_right);
let update_ops = select l.loop as loop, l.update as update, r.operator as operator from updates as l join operators as r on l.update = r.id;
let arguments = select l.parent as id, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "argument" or l.field = "left";
let stepped = select l.loop as loop, l.update as update, l.operator as operator, r.name as name from update_ops as l join arguments as r on l.update = r.id;
let incremented = select loop, name from stepped where operator = "++";
let decremented = select loop, name from stepped where operator = "--";
let added = select loop, update, name from stepped where operator = "+=";
let subtracted = select loop, update, name from stepped where operator = "-=";
let rights = select parent as update, child as amount from "semantic-child" where field = "right";
let numerals = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "numeric";
let positive_amounts = select l.update as update from rights as l join numerals as r on l.amount = r.id;
let negations = select id from operators where operator = "-";
let negated_amounts = select l.update as update, r.id as amount from rights as l join negations as r on l.amount = r.id;
let negated_arguments = select l.parent as id from "semantic-child" as l join numerals as r on l.child = r.id where l.field = "argument";
let negative_amounts = select l.update as update from negated_amounts as l join negated_arguments as r on l.amount = r.id;
let added_up = select l.loop as loop, l.name as name from added as l join positive_amounts as r on l.update = r.update;
let added_down = select l.loop as loop, l.name as name from added as l join negative_amounts as r on l.update = r.update;
let subtracted_down = select l.loop as loop, l.name as name from subtracted as l join positive_amounts as r on l.update = r.update;
let subtracted_up = select l.loop as loop, l.name as name from subtracted as l join negative_amounts as r on l.update = r.update;
let rises_steps = union(left=incremented, right=added_up);
let rises = union(left=rises_steps, right=subtracted_up);
let falls_steps = union(left=decremented, right=added_down);
let falls = union(left=falls_steps, right=subtracted_down);
let wrong_rising = select l.test as test from needs_rising as l join falls as r on l.loop = r.loop and l.name = r.name;
let wrong_falling = select l.test as test from needs_falling as l join rises as r on l.loop = r.loop and l.name = r.name;
let wrong = union(left=wrong_rising, right=wrong_falling);
let found = select r.id as id, r.file as file, r.span as span from wrong as l join "semantic-syntax" as r on l.test = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?for-direction(?:,|$)");
emit violations subject file key(id);
