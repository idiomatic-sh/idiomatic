import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let arguments_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "arguments";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let members = select id, file, span from "semantic-syntax" where kind = "member-expression";
let objects = select l.parent as id, l.child as object from "semantic-child" as l join members as r on l.parent = r.id where l.field = "object";
let direct_objects = select id, object as inner from objects;
let reached_objects = select l.id as id, r.inner as inner from objects as l join unwrapped as r on l.object = r.outer;
let inner_objects = union(left=direct_objects, right=reached_objects);
let on_arguments = select l.id as id from inner_objects as l join arguments_names as r on l.inner = r.id;
let properties = select l.parent as id, r.id as property, r.kind as kind, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "property";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let static_properties = antijoin(left=properties, right=computed, left-on=["id"], right-on=["id"]);
let computed_properties = select l.id as id, l.property as property, l.file as file, l.span as span from properties as l join computed as r on l.id = r.id;
let method_names = select file, span from "semantic-syntax" where kind = "identifier-token" and matches(text, "^(?:@@iterator|at|concat|copyWithin|entries|every|fill|filter|find|findIndex|findLast|findLastIndex|flat|flatMap|forEach|groupBy|includes|indexOf|join|keys|lastIndexOf|map|pop|push|reduce|reduceRight|reverse|shift|slice|some|sort|splice|toReversed|toSorted|toSpliced|unshift|values|with)$");
let static_methods = select l.id as id from static_properties as l join method_names as r on l.file = r.file and l.span = r.span where l.kind = "identifier";
let string_methods = select l.id as id from computed_properties as l join "string-literal" as r on l.property = r.occurrence where matches(r.value, "^(?:@@iterator|at|concat|copyWithin|entries|every|fill|filter|find|findIndex|findLast|findLastIndex|flat|flatMap|forEach|groupBy|includes|indexOf|join|keys|lastIndexOf|map|pop|push|reduce|reduceRight|reverse|shift|slice|some|sort|splice|toReversed|toSorted|toSpliced|unshift|values|with)$");
let template_names = select file, span from "semantic-syntax" where kind = "template" and matches(text, "^\x60(?:@@iterator|at|concat|copyWithin|entries|every|fill|filter|find|findIndex|findLast|findLastIndex|flat|flatMap|forEach|groupBy|includes|indexOf|join|keys|lastIndexOf|map|pop|push|reduce|reduceRight|reverse|shift|slice|some|sort|splice|toReversed|toSorted|toSpliced|unshift|values|with)\x60$");
let template_methods = select l.id as id from computed_properties as l join template_names as r on l.file = r.file and l.span = r.span;
let named_a = union(left=static_methods, right=string_methods);
let named = union(left=named_a, right=template_methods);
let array_members = select l.id as id from on_arguments as l join named as r on l.id = r.id;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let call_children = select l.child as id from "semantic-child" as l join calls as r on l.parent = r.id;
let called = select l.id as id from array_members as l join call_children as r on l.id = r.id;
let candidates = select l.id as id, l.file as file, l.span as span from members as l join called as r on l.id = r.id;
let wrapped = parenthesized(candidates=candidates);
let found = antijoin(left=candidates, right=wrapped, left-on=["id"], right-on=["id"]);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?bad-array-method-on-arguments(?:,|$)");
emit violations subject file key(id);
