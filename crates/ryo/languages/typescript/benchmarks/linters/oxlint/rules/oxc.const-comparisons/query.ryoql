import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let logical_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "||" or r.text = "&&");
let logicals = select l.id as id, l.operator as operator from logical_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "logical-expression";
let logical_sides = select l.id as id, l.operator as operator, c.child as operand, c.field as side from logicals as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let comparison_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "<" or r.text = "<=" or r.text = ">" or r.text = ">=" or r.text = "==" or r.text = "===" or r.text = "!=" or r.text = "!==");
let comparisons = select l.id as id, l.operator as operator from comparison_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "binary-expression";
let comparison_sides = select l.id as id, l.operator as operator, c.child as operand, c.field as side from comparisons as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let calls = select id from "semantic-syntax" where kind = "call-expression" or kind = "new-expression";
let shapes = select id, shape from "expression-shape";
let plain_shapes = antijoin(left=shapes, right=calls, left-on=["id"], right-on=["id"]);
let shaped_sides = select l.id as id, l.operator as operator, l.side as side, r.shape as shape from comparison_sides as l join plain_shapes as r on l.operand = r.id;
let left_shapes = select id, operator, shape from shaped_sides where side = "left";
let right_shapes = select id, shape from shaped_sides where side = "right";
let shaped = select l.id as id, l.operator as operator, l.shape as left_shape, r.shape as right_shape from left_shapes as l join right_shapes as r on l.id = r.id;
let self_compared = select id from shaped where left_shape = right_shape and (operator = "<" or operator = "<=" or operator = ">" or operator = ">=");
let self_rows = select l.id as id, l.id as logical, l.id as other, r.file as file, r.span as span from self_compared as l join "semantic-syntax" as r on l.id = r.id;
let self_findings = extend(from=self_rows, values={check: 4});
let left_operands = select id, operand from logical_sides where side = "left";
let right_operands = select id, operand from logical_sides where side = "right";
let left_operand_shapes = select l.id as id, l.operand as operand, r.shape as shape from left_operands as l join plain_shapes as r on l.operand = r.id;
let right_operand_shapes = select l.id as id, l.operand as operand, r.shape as shape from right_operands as l join plain_shapes as r on l.operand = r.id;
let identical = select l.id as logical, l.operand as id, r.operand as other from left_operand_shapes as l join right_operand_shapes as r on l.id = r.id where l.shape = r.shape;
let equalities = select id, operator, left_shape, right_shape from shaped where operator = "==" or operator = "===" or operator = "!=" or operator = "!==";
let left_equalities = select l.id as logical, l.operand as id, r.operator as operator, r.left_shape as left_shape, r.right_shape as right_shape from left_operands as l join equalities as r on l.operand = r.id;
let right_equalities = select l.id as logical, l.operand as id, r.operator as operator, r.left_shape as left_shape, r.right_shape as right_shape from right_operands as l join equalities as r on l.operand = r.id;
let equality_pairs = select l.logical as logical, l.id as id, l.operator as first, l.left_shape as first_left, l.right_shape as first_right, r.id as other, r.operator as second, r.left_shape as second_left, r.right_shape as second_right from left_equalities as l join right_equalities as r on l.logical = r.logical;
let negated_pairs = select logical, id, other, first_left, first_right, second_left, second_right from equality_pairs where (first = "===" and second = "!==") or (first = "!==" and second = "===") or (first = "==" and second = "!=") or (first = "!=" and second = "==");
let same_negations = select logical, id, other from negated_pairs where first_left = second_left and first_right = second_right;
let swapped_negations = select logical, id, other from negated_pairs where first_left = second_right and first_right = second_left;
let negation_union = union(left=same_negations, right=swapped_negations);
let negations = project(from=negation_union, columns=["logical", "id", "other"]);
let identical_checked = extend(from=identical, values={check: 2});
let negation_checked = extend(from=negations, values={check: 3});
let operand_labels = union(left=identical_checked, right=negation_checked);
let operand_rows = select l.id as id, r.file as file, r.span as span from operand_labels as l join "semantic-syntax" as r on l.id = r.id;
let wrapped_operands = parenthesized(candidates=operand_rows);
let outer_levels = select l.id as id, l.level as level from wrapped_operands as l join wrapped_operands as r on l.id = r.id where l.level < r.level;
let outermost = antijoin(left=wrapped_operands, right=outer_levels, left-on=["id", "level"], right-on=["id", "level"]);
let wrap_spans = select id, file, wrap as span from outermost;
let bare_operands = antijoin(left=operand_rows, right=wrapped_operands, left-on=["id"], right-on=["id"]);
let operand_spans = union(left=wrap_spans, right=bare_operands);
let operand_findings = select l.id as id, l.logical as logical, l.other as other, r.file as file, r.span as span, l.check as check from operand_labels as l join operand_spans as r on l.id = r.id;
let numbers = select id, value from "numeric-literal" where kind = "float";
let right_numbers = select l.id as id, l.operator as operator, r.value as value from comparison_sides as l join numbers as r on l.operand = r.id where l.side = "right";
let left_numbers = select l.id as id, l.operator as operator, r.value as value from comparison_sides as l join numbers as r on l.operand = r.id where l.side = "left";
let bounded_rights = select id, operator, value from right_numbers where operator = "<" or operator = "<=" or operator = ">" or operator = ">=";
let bounded_lefts_all = select id, operator, value from left_numbers where operator = "<" or operator = "<=" or operator = ">" or operator = ">=";
let bounded_lefts = antijoin(left=bounded_lefts_all, right=bounded_rights, left-on=["id"], right-on=["id"]);
let right_lt = select id, value from bounded_rights where operator = "<";
let right_le = select id, value from bounded_rights where operator = "<=";
let right_gt = select id, value from bounded_rights where operator = ">";
let right_ge = select id, value from bounded_rights where operator = ">=";
let left_lt = select id, value from bounded_lefts where operator = "<";
let left_le = select id, value from bounded_lefts where operator = "<=";
let left_gt = select id, value from bounded_lefts where operator = ">";
let left_ge = select id, value from bounded_lefts where operator = ">=";
let as_lt_a = extend(from=right_lt, values={op: "<"});
let as_le_a = extend(from=right_le, values={op: "<="});
let as_gt_a = extend(from=right_gt, values={op: ">"});
let as_ge_a = extend(from=right_ge, values={op: ">="});
let as_lt_b = extend(from=left_gt, values={op: "<"});
let as_le_b = extend(from=left_ge, values={op: "<="});
let as_gt_b = extend(from=left_lt, values={op: ">"});
let as_ge_b = extend(from=left_le, values={op: ">="});
let consts_a = union(left=as_lt_a, right=as_le_a);
let consts_b = union(left=consts_a, right=as_gt_a);
let consts_c = union(left=consts_b, right=as_ge_a);
let consts_d = union(left=consts_c, right=as_lt_b);
let consts_e = union(left=consts_d, right=as_le_b);
let consts_f = union(left=consts_e, right=as_gt_b);
let consts = union(left=consts_f, right=as_ge_b);
let reference_sides = select l.id as id, l.side as side, l.operand as operand from comparison_sides as l join consts as r on l.id = r.id;
let right_references = select l.id as id, l.operand as operand from reference_sides as l join bounded_rights as r on l.id = r.id where l.side = "left";
let left_references = select l.id as id, l.operand as operand from reference_sides as l join bounded_lefts as r on l.id = r.id where l.side = "right";
let references = union(left=right_references, right=left_references);
let reference_rows = select l.operand as id, r.file as file, r.span as span from references as l join "semantic-syntax" as r on l.operand = r.id;
let wrapped_references = parenthesized(candidates=reference_rows);
let open_references = antijoin(left=references, right=wrapped_references, left-on=["operand"], right-on=["id"]);
let reference_shapes = select l.id as id, r.shape as shape from open_references as l join plain_shapes as r on l.operand = r.id;
let and_logicals = select id from logicals where operator = "&&";
let and_sides = select l.id as id, l.operand as operand, l.side as side from logical_sides as l join and_logicals as r on l.id = r.id;
let and_edges = select l.id as outer, r.id as inner from and_sides as l join and_logicals as r on l.operand = r.id;
let and_reach = closure(edges=and_edges, source="outer", destination="inner");
let left_roots = select id, operand as root from and_sides where side = "left";
let own_children = select l.id as id, s.operand as leaf from left_roots as l join and_sides as s on l.root = s.id;
let reached = select l.id as id, r.inner as node from left_roots as l join and_reach as r on l.root = r.outer;
let deep_children = select l.id as id, s.operand as leaf from reached as l join and_sides as s on l.node = s.id;
let root_leaves = select id, root as leaf from left_roots;
let leaves_a = union(left=root_leaves, right=own_children);
let leaves = union(left=leaves_a, right=deep_children);
let left_consts = select l.id as logical, l.leaf as leaf, r.op as left_op, r.value as left_value from leaves as l join consts as r on l.leaf = r.id;
let right_consts = select l.id as logical, l.operand as right, r.op as right_op, r.value as right_value from and_sides as l join consts as r on l.operand = r.id where l.side = "right";
let pairs = select l.logical as logical, l.leaf as leaf, l.left_op as left_op, l.left_value as left_value, r.right as right, r.right_op as right_op, r.right_value as right_value from left_consts as l join right_consts as r on l.logical = r.logical;
let left_referenced = select l.logical as logical, l.leaf as leaf, l.right as right, r.shape as shape from pairs as l join reference_shapes as r on l.leaf = r.id;
let same_referenced = select l.logical as logical, l.leaf as leaf from left_referenced as l join reference_shapes as r on l.right = r.id where l.shape = r.shape;
let matched = select l.logical as logical, l.leaf as leaf, l.left_op as left_op, l.left_value as left_value, l.right as right, l.right_op as right_op, l.right_value as right_value from pairs as l join same_referenced as r on l.logical = r.logical and l.leaf = r.leaf;
let unmatched = antijoin(left=pairs, right=same_referenced, left-on=["logical", "leaf"], right-on=["logical", "leaf"]);
let corners = select logical, leaf from matched where left_value = right_value and (left_op = "<=" or left_op = ">=") and (right_op = "<=" or right_op = ">=");
let unmatched_leaves = select logical, leaf from unmatched;
let stoppers = union(left=unmatched_leaves, right=corners);
let pair_rows = select l.logical as logical, l.leaf as leaf, r.file as file, r.span as span from pairs as l join "semantic-syntax" as r on l.leaf = r.id;
let pair_bounds = span-bounds(from=pair_rows, span="span", start-output="begin", end-output="finish");
let stopper_bounds = select l.logical as logical, l.leaf as leaf, r.begin as begin from stoppers as l join pair_bounds as r on l.logical = r.logical and l.leaf = r.leaf;
let cut = select l.logical as logical, l.leaf as leaf from pair_bounds as l join stopper_bounds as r on l.logical = r.logical where r.begin <= l.begin;
let live = antijoin(left=matched, right=cut, left-on=["logical", "leaf"], right-on=["logical", "leaf"]);
let upper = select logical, leaf, left_op, left_value, right, right_op, right_value from live where (left_op = "<" or left_op = "<=") and (right_op = "<" or right_op = "<=");
let lower = select logical, leaf, left_op, left_value, right, right_op, right_value from live where (left_op = ">" or left_op = ">=") and (right_op = ">" or right_op = ">=");
let crossed = select logical, leaf, left_op, left_value, right, right_op, right_value from live where ((left_op = ">" or left_op = ">=") and (right_op = "<" or right_op = "<=") and ((float_text_gte(left_value, right_value) and left_value != right_value) or (left_value = right_value and (left_op = ">" or right_op = "<")))) or ((left_op = "<" or left_op = "<=") and (right_op = ">" or right_op = ">=") and ((float_text_gte(right_value, left_value) and left_value != right_value) or (left_value = right_value and (left_op = "<" or right_op = ">"))));
let upper_left_useless = select logical, leaf, right from upper where (float_text_gte(left_value, right_value) and left_value != right_value) or (left_value = right_value and left_op = "<=");
let upper_right_useless = select logical, leaf, right from upper where (float_text_gte(right_value, left_value) and left_value != right_value) or (left_value = right_value and left_op = "<");
let lower_left_useless = select logical, leaf, right from lower where (float_text_gte(right_value, left_value) and left_value != right_value) or (left_value = right_value and left_op = ">=");
let lower_right_useless = select logical, leaf, right from lower where (float_text_gte(left_value, right_value) and left_value != right_value) or (left_value = right_value and left_op = ">");
let left_useless = union(left=upper_left_useless, right=lower_left_useless);
let right_useless = union(left=upper_right_useless, right=lower_right_useless);
let left_useless_labels = select right as id, logical, leaf as other from left_useless;
let right_useless_labels = select leaf as id, logical, right as other from right_useless;
let impossible_labels = select leaf as id, logical, right as other from crossed;
let redundant_labels = union(left=left_useless_labels, right=right_useless_labels);
let redundant_checked = extend(from=redundant_labels, values={check: 1});
let impossible_checked = extend(from=impossible_labels, values={check: 0});
let constant_labels = union(left=redundant_checked, right=impossible_checked);
let constant_findings = select l.id as id, l.logical as logical, l.other as other, r.file as file, r.span as span, l.check as check from constant_labels as l join "semantic-syntax" as r on l.id = r.id;
let findings_a = union(left=constant_findings, right=operand_findings);
let self_ordered = select id, logical, other, file, span, check from self_findings;
let findings = union(left=findings_a, right=self_ordered);
let candidates = project(from=findings, columns=["id", "file", "span"]);
let violations = directives(candidates=candidates, names="(?:^|,)(?:[^,]*/)?const-comparisons(?:,|$)");
let reported = select l.id as id, l.logical as logical, l.other as other, l.check as check, l.file as file, l.span as span from findings as l join violations as r on l.id = r.id and l.span = r.span;
emit reported subject file key(id, logical, other, check);
