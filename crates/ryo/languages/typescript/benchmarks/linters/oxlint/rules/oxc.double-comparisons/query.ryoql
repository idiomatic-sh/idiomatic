import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let logical_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "||" or r.text = "&&");
let logicals = select l.id as id, l.operator as operator from logical_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "logical-expression";
let comparison_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "==" or r.text = "===" or r.text = "<" or r.text = ">" or r.text = "<=" or r.text = ">=");
let comparisons = select l.id as id, l.operator as operator from comparison_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "binary-expression";
let comparison_sides = select l.id as id, l.operator as operator, c.child as operand, c.field as side from comparisons as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let calls = select id from "semantic-syntax" where kind = "call-expression" or kind = "new-expression";
let plain_sides = antijoin(left=comparison_sides, right=calls, left-on=["operand"], right-on=["id"]);
let shaped_sides = select l.id as id, l.operator as operator, l.side as side, r.shape as shape from plain_sides as l join "expression-shape" as r on l.operand = r.id;
let left_shapes = select id, operator, shape from shaped_sides where side = "left";
let right_shapes = select id, shape from shaped_sides where side = "right";
let shaped = select l.id as id, l.operator as operator, l.shape as left_shape, r.shape as right_shape from left_shapes as l join right_shapes as r on l.id = r.id;
let logical_sides = select l.id as id, l.operator as operator, c.child as operand, c.field as side from logicals as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let side_rows = select l.operand as id, r.file as file, r.span as span from logical_sides as l join "semantic-syntax" as r on l.operand = r.id;
let wrapped_sides = parenthesized(candidates=side_rows);
let open_sides = antijoin(left=logical_sides, right=wrapped_sides, left-on=["operand"], right-on=["id"]);
let first_comparisons = select l.id as id, l.operator as logical, r.operator as first, r.left_shape as first_left, r.right_shape as first_right from open_sides as l join shaped as r on l.operand = r.id where l.side = "left";
let second_comparisons = select l.id as id, r.operator as second, r.left_shape as second_left, r.right_shape as second_right from open_sides as l join shaped as r on l.operand = r.id where l.side = "right";
let both = select l.id as id, l.logical as logical, l.first as first, l.first_left as first_left, l.first_right as first_right, r.second as second, r.second_left as second_left, r.second_right as second_right from first_comparisons as l join second_comparisons as r on l.id = r.id;
let same = select id, logical, first, second from both where first_left = second_left and first_right = second_right;
let swapped = select id, logical, first, second from both where first_left = second_right and first_right = second_left;
let same_hits = select id from same where (logical = "||" and (((first = "==" or first = "===") and (second = "<" or second = ">")) or ((first = "<" or first = ">") and (second = "==" or second = "===")) or (first = "<" and second = ">") or (first = ">" and second = "<"))) or (logical = "&&" and ((first = "<=" and second = ">=") or (first = ">=" and second = "<=")));
let swapped_hits = select id from swapped where (logical = "||" and (((first = "==" or first = "===") and (second = "<" or second = ">")) or ((first = "<" or first = ">") and (second = "==" or second = "===")) or (first = "<" and second = "<") or (first = ">" and second = ">"))) or (logical = "&&" and ((first = "<=" and second = "<=") or (first = ">=" and second = ">=")));
let hit_union = union(left=same_hits, right=swapped_hits);
let hits = project(from=hit_union, columns=["id"]);
let found = select r.id as id, r.file as file, r.span as span from hits as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?double-comparisons(?:,|$)");
emit violations subject file key(id);
