import directives from "typescript/oxlint/eslint-directives";
let classes = select id as class, carrier from "pattern-syntax" where kind = "character-class";
let members = select l.class as class, l.carrier as carrier, r.child as id, r.ordinal as ordinal from classes as l join "pattern-child" as r on l.class = r.parent;
let characters = select l.class as class, l.carrier as carrier, l.id as id, l.ordinal as ordinal, r.text as text, r.value as value, r.file as file, r.span as span from members as l join "pattern-syntax" as r on l.id = r.id where r.kind = "character";
let ordered = select l.class as class, l.id as left, r.id as right from members as l join members as r on l.class = r.class where r.ordinal > l.ordinal;
let spanned = select l.class as class, l.left as left, r.right as right from ordered as l join ordered as r on l.class = r.class and l.right = r.left;
let adjacent = antijoin(left=ordered, right=spanned, left-on=["class", "left", "right"], right-on=["class", "left", "right"]);
let lefts = select l.class as class, l.carrier as carrier, l.id as left, l.text as left_text, l.value as left_value, l.file as file, l.span as left_span, r.right as right from characters as l join adjacent as r on l.id = r.left and l.class = r.class;
let pairs = select l.class as class, l.carrier as carrier, l.left as left, l.left_text as left_text, l.left_value as left_value, l.file as file, l.left_span as left_span, l.right as right, r.text as right_text, r.value as right_value, r.span as right_span from lefts as l join characters as r on l.right = r.id;
let wide = select l.class as class, l.left as left, l.left_value as left_value, l.file as file, l.left_span as left_span, l.right as right, l.right_value as right_value, l.right_span as right_span from pairs as l join "pattern-parse" as r on l.carrier = r.carrier where matches(r.flags, "^[^uv]*$");
let surrogates = select left as id, file, left_span, right_span from wide where left_value >= 55296 and left_value <= 56319 and right_value >= 56320 and right_value <= 57343;
let marked_by_text = select left, file, left_span, right_span, left_text, left_value from pairs where matches(right_text, "^\p{M}$");
let marked_by_value = select left, file, left_span, right_span, left_text, left_value from pairs where (right_value >= 768 and right_value <= 879) or (right_value >= 6832 and right_value <= 6911) or (right_value >= 7616 and right_value <= 7679) or (right_value >= 8400 and right_value <= 8447) or (right_value >= 65056 and right_value <= 65071);
let marked = union(left=marked_by_text, right=marked_by_value);
let mark_texts = select left from marked where matches(left_text, "^\p{M}$");
let mark_values = select left from marked where (left_value >= 768 and left_value <= 879) or (left_value >= 6832 and left_value <= 6911) or (left_value >= 7616 and left_value <= 7679) or (left_value >= 8400 and left_value <= 8447) or (left_value >= 65056 and left_value <= 65071);
let mark_lefts = union(left=mark_texts, right=mark_values);
let combining_rows = antijoin(left=marked, right=mark_lefts, left-on=["left"], right-on=["left"]);
let combining = select left as id, file, left_span, right_span from combining_rows;
let modifiers = select left as id, file, left_span, right_span from pairs where right_value >= 127995 and right_value <= 127999;
let regional = select left as id, file, left_span, right_span from pairs where left_value >= 127462 and left_value <= 127487 and right_value >= 127462 and right_value <= 127487;
let joiners = select left, right, file, left_span from pairs where right_value = 8205;
let joined = select l.left as id, l.file as file, l.left_span as left_span, r.right_span as right_span from joiners as l join pairs as r on l.right = r.left;
let kinds_1 = union(left=surrogates, right=combining);
let kinds_2 = union(left=kinds_1, right=modifiers);
let kinds_3 = union(left=kinds_2, right=regional);
let sequences = union(left=kinds_3, right=joined);
let spans = span-between(from=sequences, start="left_span", end="right_span", output="span");
let found = select id, file, span from spans;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-misleading-character-class(?:,|$)");
emit violations subject file key(id, span);
