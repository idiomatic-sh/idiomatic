import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let uses = select reference, binding, file, span, context from "binding-use";
let reads = select reference, name, file from "binding-read";
let named = select l.reference as reference, l.binding as binding, r.name as name, l.file as file, l.span as span, l.context as context from uses as l join reads as r on l.reference = r.reference and l.file = r.file;
let imports = select id, name, file, refinement from "defines" where kind = "import";
let imported = select l.reference as reference, l.binding as binding, l.file as file, l.span as span, l.context as context, r.refinement as refinement from named as l join imports as r on l.binding = r.id and l.name = r.name and l.file = r.file;
let written = select reference as id, binding, file, span, span as at from imported where context = "write" or context = "read-write";
let spaces = select reference, binding, file, span from imported where refinement = "import-namespace-specifier";
let space_rows = select reference as id, file, span from spaces;
let space_wrapped = parenthesized(candidates=space_rows);
let bare = antijoin(left=spaces, right=space_wrapped, left-on=["reference"], right-on=["id"]);
let objects = select l.parent as member, r.reference as reference, r.binding as binding, r.file as file, r.span as at from "semantic-child" as l join bare as r on l.child = r.reference where l.field = "object";
let members = select l.member as member, l.binding as binding, l.file as file, l.at as at, r.span as span from objects as l join "semantic-syntax" as r on l.member = r.id where r.kind = "member-expression";
let member_parents = select l.member as member, l.binding as binding, l.file as file, l.at as at, l.span as span, c.parent as parent, c.field as field from members as l join "semantic-child" as c on l.member = c.child;
let parent_kinds = select l.member as member, l.binding as binding, l.file as file, l.at as at, l.span as span, l.parent as parent, l.field as field, r.kind as kind from member_parents as l join "semantic-syntax" as r on l.parent = r.id;
let direct_targets = select member as id, binding, file, span, at from parent_kinds where (kind = "assignment-expression" and field = "left") or (kind = "update-expression" and field = "argument") or (kind = "array-pattern" and field = "elements") or (kind = "rest-element" and field = "argument") or (kind = "assignment-pattern" and field = "left") or ((kind = "for-in-statement" or kind = "for-of-statement") and field = "left");
let property_values = select member, binding, file, at, span, parent from parent_kinds where kind = "property" and field = "value";
let pattern_properties = select l.child as property from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "object-pattern" and l.field = "properties";
let pattern_targets = select l.member as id, l.binding as binding, l.file as file, l.span as span, l.at as at from property_values as l join pattern_properties as r on l.parent = r.property;
let targets = union(left=direct_targets, right=pattern_targets);
let delete_operators = select l.parent as unary from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.kind = "keyword" and r.text = "delete";
let delete_arguments = select l.unary as unary, c.child as argument from delete_operators as l join "semantic-child" as c on l.unary = c.parent where c.field = "argument";
let chains = select l.parent as chain, l.child as member from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "chain-expression" and l.field = "expression";
let chained = select l.member as member, l.binding as binding, l.file as file, l.at as at, l.span as span, r.chain as argument from members as l join chains as r on l.member = r.member;
let unchained = select member, binding, file, at, span, member as argument from members;
let deletable = union(left=unchained, right=chained);
let deleted_all = select l.member as id, l.binding as binding, l.file as file, l.span as span, l.at as at, l.argument as argument from deletable as l join delete_arguments as r on l.argument = r.argument;
let argument_rows = select l.argument as id, l.file as file, r.span as span from deleted_all as l join "semantic-syntax" as r on l.argument = r.id;
let argument_wrapped = parenthesized(candidates=argument_rows);
let deleted_kept = antijoin(left=deleted_all, right=argument_wrapped, left-on=["argument"], right-on=["id"]);
let deleted = select id, binding, file, span, at from deleted_kept;
let callees = select parent as call, child as callee from "semantic-child" where field = "callee";
let callee_objects = select l.call as call, l.callee as callee, c.child as object from callees as l join "semantic-child" as c on l.callee = c.parent where c.field = "object";
let globals = select reference, name from "binding-read" where state = "builtin" and (name = "Object" or name = "Reflect");
let global_callees = select l.call as call, l.callee as callee, r.name as owner from callee_objects as l join globals as r on l.object = r.reference;
let properties = select l.parent as callee, l.child as property from "semantic-child" as l join global_callees as r on l.parent = r.callee where l.field = "property";
let computed = select l.parent as callee from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let property_names = select l.callee as callee, r.name as method from properties as l join names as r on l.property = r.id;
let static_names = antijoin(left=property_names, right=computed, left-on=["callee"], right-on=["callee"]);
let literal_names = select l.callee as callee, r.value as method from properties as l join "string-literal" as r on l.property = r.occurrence;
let computed_names = select l.callee as callee, l.method as method from literal_names as l join computed as r on l.callee = r.callee;
let methods = union(left=static_names, right=computed_names);
let mutators = select l.call as call, l.owner as owner, r.method as method from global_callees as l join methods as r on l.callee = r.callee;
let mutating = select call from mutators where (owner = "Object" and (method = "assign" or method = "defineProperty" or method = "defineProperties" or method = "freeze" or method = "setPrototypeOf")) or (owner = "Reflect" and (method = "defineProperty" or method = "deleteProperty" or method = "set" or method = "setPrototypeOf"));
let call_arguments = select l.parent as call, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join mutating as r on l.parent = r.call where l.field = "arguments";
let later_arguments = select l.call as call, l.argument as argument from call_arguments as l join call_arguments as r on l.call = r.call where l.ordinal > r.ordinal;
let first_arguments = antijoin(left=call_arguments, right=later_arguments, left-on=["call", "argument"], right-on=["call", "argument"]);
let mutated = select r.reference as id, r.binding as binding, r.file as file, r.span as span, r.span as at from first_arguments as l join bare as r on l.argument = r.reference;
let space_writes = union(left=targets, right=deleted);
let space_hits = union(left=space_writes, right=mutated);
let hits = union(left=written, right=space_hits);
let hit_bounds = span-bounds(from=hits, span="at", start-output="begin", end-output="finish");
let delete_bounds = span-bounds(from=deleted, span="at", start-output="dbegin", end-output="dfinish");
let stopped = select l.id as id, l.file as file from hit_bounds as l join delete_bounds as r on l.binding = r.binding and l.file = r.file where l.begin > r.dbegin;
let kept = antijoin(left=hits, right=stopped, left-on=["id", "file"], right-on=["id", "file"]);
let found = select id, file, span from kept;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-import-assign(?:,|$)");
emit violations subject file key(id);
