import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constness from "typescript/oxlint/constness";
let nodes = select id, file, span, kind from "semantic-syntax";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let declared_a = select file, name from "defines";
let declared_b = select file, name from "parameter";
let declared = union(left=declared_a, right=declared_b);
let global_names = antijoin(left=names, right=declared, left-on=["file", "name"], right-on=["file", "name"]);
let undefined_names = select id from names where name = "undefined";
let global_undefined = select id from global_names where name = "undefined";
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let children = select l.parent as parent, l.child as child, l.field as field, l.ordinal as ordinal, r.kind as kind from "semantic-child" as l join nodes as r on l.parent = r.id;
let operated = select l.parent as parent, l.child as child, l.field as field, l.kind as kind, r.operator as operator from children as l join operators as r on l.parent = r.id;
let literals = select id, file, span from "semantic-syntax" where kind = "literal";
let literal_tokens = select l.id as id, r.kind as kind, r.text as text from literals as l join "semantic-syntax" as r on l.file = r.file and l.span = r.span where r.kind = "boolean" or r.kind = "null" or r.kind = "numeric" or r.kind = "string" or r.kind = "regular-expression";
let null_literals = select id from literal_tokens where kind = "null";
let boolean_literals = select id from literal_tokens where kind = "boolean";
let regex_literals = select id from literal_tokens where kind = "regular-expression";
let unary_ops = select l.id as id, l.operator as operator from operators as l join nodes as r on l.id = r.id where r.kind = "unary-expression";
let voids = select id from unary_ops where operator = "void";
let nots = select id from unary_ops where operator = "!";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let callee_names = select l.parent as call, r.name as name from "semantic-child" as l join global_names as r on l.child = r.id where l.field = "callee";
let named_calls = select l.id as id, r.name as name from calls as l join callee_names as r on l.id = r.call;
let boolean_calls = select id from named_calls where name = "Boolean";
let call_arguments = select l.parent as parent, l.child as child, l.ordinal as ordinal from "semantic-child" as l join boolean_calls as r on l.parent = r.id where l.field = "arguments";
let later_arguments = select l.child as child from call_arguments as l join call_arguments as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first_arguments = antijoin(left=call_arguments, right=later_arguments, left-on=["child"], right-on=["child"]);
let not_arguments = select l.child as child from "semantic-child" as l join nots as r on l.parent = r.id where l.field = "argument";
let logicals = select parent as id, operator from operated where kind = "logical-expression" and field = "operator";
let short_lefts = select l.child as child, l.parent as parent from operated as l join logicals as r on l.parent = r.id where l.field = "left" and (r.operator = "||" or r.operator = "&&");
let first_children = select child from first_arguments;
let short_children = select child from short_lefts;
let constness_a = union(left=first_children, right=not_arguments);
let constness_ids = union(left=constness_a, right=short_children);
let constness_rows = select l.child as id, r.file as file, r.span as span from constness_ids as l join nodes as r on l.child = r.id;
let constant = constness(candidates=constness_rows);
let constant_ids = select id from constant;
let empty_boolean_calls = antijoin(left=boolean_calls, right=call_arguments, left-on=["id"], right-on=["parent"]);
let argued_boolean_calls = select l.parent as id from first_arguments as l join constant_ids as r on l.child = r.id;
let constant_boolean_calls = union(left=empty_boolean_calls, right=argued_boolean_calls);
let constant_nots = select l.parent as id from "semantic-child" as l join constant_ids as r on l.child = r.id where l.field = "argument";
let constant_not_nodes = select l.id as id from constant_nots as l join nots as r on l.id = r.id;
let short_hits = select l.parent as id from short_lefts as l join constant_ids as r on l.child = r.id;
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let wrap_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let coalesce_edges = select parent as outer, child as inner from operated where kind = "logical-expression" and operator = "??" and field = "right";
let assign_edges = select parent as outer, child as inner from operated where kind = "assignment-expression" and operator = "=" and field = "right";
let sequence_parts = select parent, child, ordinal from children where kind = "sequence-expression" and field = "expressions";
let earlier_parts = select l.child as child from sequence_parts as l join sequence_parts as r on l.parent = r.parent where l.ordinal < r.ordinal;
let last_parts = antijoin(left=sequence_parts, right=earlier_parts, left-on=["child"], right-on=["child"]);
let sequence_edges = select parent as outer, child as inner from last_parts;
let plain_edges = union(left=assign_edges, right=sequence_edges);
let nullish_a = union(left=wrap_edges, right=coalesce_edges);
let nullish_edges = union(left=nullish_a, right=plain_edges);
let nullish_reach = closure(edges=nullish_edges, source="outer", destination="inner");
let equality_ops = select parent as id, operator from operated where kind = "binary-expression" and field = "operator" and (operator = "==" or operator = "!=" or operator = "===" or operator = "!==");
let sides = select l.id as binary, l.operator as operator, c.child as side, c.field as field from equality_ops as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let others = select l.binary as binary, l.operator as operator, l.side as side, r.side as other from sides as l join sides as r on l.binary = r.binary where l.field != r.field;
let coalesce_lefts = select l.child as root, l.parent as owner from operated as l join logicals as r on l.parent = r.id where l.field = "left" and r.operator = "??";
let coalesce_roots = select root from coalesce_lefts;
let other_roots = select other as root from others;
let nullish_roots = union(left=coalesce_roots, right=other_roots);
let nullish_below = select l.root as root, r.inner as node from nullish_roots as l join nullish_reach as r on l.root = r.outer;
let nullish_selves = select root, root as node from nullish_roots;
let nullish_members = union(left=nullish_below, right=nullish_selves);
let nullish_leaves = antijoin(left=nullish_members, right=nullish_edges, left-on=["node"], right-on=["outer"]);
let coalescers = select parent as id from operated where kind = "logical-expression" and operator = "??" and field = "operator";
let coalescer_members = select l.root as root, l.node as coalescer from nullish_members as l join coalescers as r on l.node = r.id;
let guarded_leaves = select l.root as root, l.coalescer as coalescer, r.inner as node from coalescer_members as l join nullish_reach as r on l.coalescer = r.outer;
let guarded = select l.root as root, l.node as node from guarded_leaves as l join nullish_leaves as r on l.root = r.root and l.node = r.node;
let wrapped_leaves = select inner as node from wrap_edges;
let direct_guarded = antijoin(left=guarded, right=wrapped_leaves, left-on=["node"], right-on=["node"]);
let nullish_kinds = select l.root as root, l.node as node, r.kind as kind from nullish_leaves as l join nodes as r on l.node = r.id;
let kind_true = select root, node from nullish_kinds where kind = "object-expression" or kind = "array-expression" or kind = "arrow-function-expression" or kind = "function-expression" or kind = "class-expression" or kind = "new-expression" or kind = "template-literal" or kind = "update-expression" or kind = "binary-expression" or kind = "unary-expression" or kind = "literal";
let undefined_leaves = select l.root as root, l.node as node from nullish_leaves as l join undefined_names as r on l.node = r.id;
let typed_calls = select id from named_calls where name = "Boolean" or name = "String" or name = "Number";
let call_leaves = select l.root as root, l.node as node from nullish_leaves as l join typed_calls as r on l.node = r.id;
let assignment_ops = select parent as id, operator from operated where kind = "assignment-expression" and field = "operator";
let arithmetic_assignments = select id from assignment_ops where operator != "=" and operator != "&&=" and operator != "||=" and operator != "??=";
let assignment_kinds = select l.root as root, l.node as node from nullish_leaves as l join arithmetic_assignments as r on l.node = r.id;
let leaf_true_a = union(left=kind_true, right=undefined_leaves);
let leaf_true_b = union(left=leaf_true_a, right=call_leaves);
let leaf_true = union(left=leaf_true_b, right=assignment_kinds);
let nullish_values = union(left=null_literals, right=voids);
let nullish_value_nodes = union(left=nullish_values, right=undefined_names);
let guarded_nullish = select l.root as root, l.node as node from direct_guarded as l join nullish_value_nodes as r on l.node = r.id;
let constant_nullish_leaves = antijoin(left=leaf_true, right=guarded_nullish, left-on=["root", "node"], right-on=["root", "node"]);
let constant_nullish = select root as id from constant_nullish_leaves;
let coalesce_hits = select l.owner as id from coalesce_lefts as l join constant_nullish as r on l.root = r.id;
let side_rows = select l.side as id, r.file as file, r.span as span from sides as l join nodes as r on l.side = r.id;
let wrapped_sides = parenthesized(candidates=side_rows);
let wrapped_side_ids = select id from wrapped_sides;
let null_or_undefined = union(left=null_literals, right=undefined_names);
let bare_null_or_undefined = antijoin(left=null_or_undefined, right=wrapped_side_ids, left-on=["id"], right-on=["id"]);
let null_sides = select l.binary as binary, l.operator as operator, l.other as other from others as l join bare_null_or_undefined as r on l.side = r.id;
let nullish_compared = select l.binary as binary, l.other as other from null_sides as l join constant_nullish as r on l.other = r.id;
let bare_booleans = antijoin(left=boolean_literals, right=wrapped_side_ids, left-on=["id"], right-on=["id"]);
let static_a = union(left=bare_booleans, right=constant_boolean_calls);
let static_b = union(left=static_a, right=constant_not_nodes);
let static_booleans = antijoin(left=static_b, right=wrapped_side_ids, left-on=["id"], right-on=["id"]);
let boolean_sides = select l.binary as binary, l.operator as operator, l.other as other from others as l join static_booleans as r on l.side = r.id;
let comparison_roots = select other as root from boolean_sides;
let comparison_reach = closure(edges=plain_edges, source="outer", destination="inner");
let comparison_below = select l.root as root, r.inner as node from comparison_roots as l join comparison_reach as r on l.root = r.outer;
let comparison_selves = select root, root as node from comparison_roots;
let comparison_members = union(left=comparison_below, right=comparison_selves);
let comparison_leaves = antijoin(left=comparison_members, right=plain_edges, left-on=["node"], right-on=["outer"]);
let comparison_kinds = select l.root as root, l.node as node, r.kind as kind from comparison_leaves as l join nodes as r on l.node = r.id;
let elements = select l.parent as array, l.child as element, r.kind as kind from "semantic-child" as l join nodes as r on l.child = r.id where l.field = "elements";
let expression_elements = select array, element from elements where kind != "spread-element";
let element_counts = group-count(from=expression_elements, keys=["array"], count="elements");
let single_arrays = select array as id from element_counts where elements = 1;
let template_expressions = select parent as id from children where kind = "template-literal" and field = "expressions";
let loose_kinds = select root, node from comparison_kinds where kind = "object-expression" or kind = "class-expression" or kind = "arrow-function-expression" or kind = "function-expression" or kind = "literal";
let loose_arrays_all = select root, node from comparison_kinds where kind = "array-expression";
let loose_arrays = antijoin(left=loose_arrays_all, right=single_arrays, left-on=["node"], right-on=["id"]);
let loose_templates_all = select root, node from comparison_kinds where kind = "template-literal";
let loose_templates = antijoin(left=loose_templates_all, right=template_expressions, left-on=["node"], right-on=["id"]);
let loose_unary = select l.root as root, l.node as node from comparison_leaves as l join unary_ops as r on l.node = r.id where r.operator = "void" or r.operator = "typeof";
let constant_leaf_nots = select l.root as root, l.node as node from comparison_leaves as l join constant_not_nodes as r on l.node = r.id;
let constant_leaf_calls = select l.root as root, l.node as node from comparison_leaves as l join constant_boolean_calls as r on l.node = r.id;
let undefined_leaves_c = select l.root as root, l.node as node from comparison_leaves as l join undefined_names as r on l.node = r.id;
let loose_a = union(left=loose_kinds, right=loose_arrays);
let loose_b = union(left=loose_a, right=loose_templates);
let loose_c = union(left=loose_b, right=loose_unary);
let loose_d = union(left=loose_c, right=constant_leaf_nots);
let loose_e = union(left=loose_d, right=constant_leaf_calls);
let loose_true = union(left=loose_e, right=undefined_leaves_c);
let strict_kinds = select root, node from comparison_kinds where kind = "object-expression" or kind = "array-expression" or kind = "arrow-function-expression" or kind = "function-expression" or kind = "new-expression" or kind = "template-literal" or kind = "update-expression" or kind = "literal";
let strict_binaries = select l.root as root, l.node as node from comparison_leaves as l join operators as r on l.node = r.id where r.operator = "+" or r.operator = "-" or r.operator = "*" or r.operator = "/" or r.operator = "%" or r.operator = "**" or r.operator = "|" or r.operator = "&" or r.operator = "^" or r.operator = "<<" or r.operator = ">>" or r.operator = ">>>";
let strict_binary_nodes = select l.root as root, l.node as node from strict_binaries as l join nodes as r on l.node = r.id where r.kind = "binary-expression";
let strict_unary = select l.root as root, l.node as node from comparison_leaves as l join unary_ops as r on l.node = r.id where r.operator != "delete" and r.operator != "!";
let typed_value_calls = select id from named_calls where name = "String" or name = "Number";
let strict_typed_calls = select l.root as root, l.node as node from comparison_leaves as l join typed_value_calls as r on l.node = r.id;
let strict_assignments = select l.root as root, l.node as node from comparison_leaves as l join arithmetic_assignments as r on l.node = r.id;
let strict_a = union(left=strict_kinds, right=strict_binary_nodes);
let strict_b = union(left=strict_a, right=strict_unary);
let strict_c = union(left=strict_b, right=constant_leaf_nots);
let strict_d = union(left=strict_c, right=strict_typed_calls);
let strict_e = union(left=strict_d, right=constant_leaf_calls);
let strict_f = union(left=strict_e, right=strict_assignments);
let strict_true = union(left=strict_f, right=undefined_leaves_c);
let loose_roots = select root as id from loose_true;
let strict_roots = select root as id from strict_true;
let loose_compared = select l.binary as binary from boolean_sides as l join loose_roots as r on l.other = r.id where l.operator = "==" or l.operator = "!=";
let strict_compared = select l.binary as binary from boolean_sides as l join strict_roots as r on l.other = r.id where l.operator = "===" or l.operator = "!==";
let null_hits = select binary from nullish_compared;
let operand_a = union(left=null_hits, right=loose_compared);
let operand_hits = union(left=operand_a, right=strict_compared);
let conditionals = select id from "semantic-syntax" where kind = "conditional-expression";
let branch_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join conditionals as r on l.parent = r.id where l.field = "consequent" or l.field = "alternate";
let new_edges = union(left=plain_edges, right=branch_edges);
let new_reach = closure(edges=new_edges, source="outer", destination="inner");
let new_roots = select side as root from sides;
let new_below = select l.root as root, r.inner as node from new_roots as l join new_reach as r on l.root = r.outer;
let new_selves = select root, root as node from new_roots;
let new_members = union(left=new_below, right=new_selves);
let new_leaves = antijoin(left=new_members, right=new_edges, left-on=["node"], right-on=["outer"]);
let new_kinds = select l.root as root, l.node as node, r.kind as kind from new_leaves as l join nodes as r on l.node = r.id;
let fresh_kinds = select root, node from new_kinds where kind = "object-expression" or kind = "array-expression" or kind = "arrow-function-expression" or kind = "function-expression" or kind = "class-expression";
let fresh_regex = select l.root as root, l.node as node from new_leaves as l join regex_literals as r on l.node = r.id;
let constructors = select id, name from global_names where name = "AggregateError" or name = "Array" or name = "ArrayBuffer" or name = "Atomics" or name = "BigInt" or name = "BigInt64Array" or name = "BigUint64Array" or name = "Boolean" or name = "DataView" or name = "Date" or name = "Error" or name = "EvalError" or name = "FinalizationRegistry" or name = "Float16Array" or name = "Float32Array" or name = "Float64Array" or name = "Function" or name = "Infinity" or name = "Int16Array" or name = "Int32Array" or name = "Int8Array" or name = "Intl" or name = "Iterator" or name = "JSON" or name = "Map" or name = "Math" or name = "NaN" or name = "Number" or name = "Object" or name = "Promise" or name = "Proxy" or name = "RangeError" or name = "ReferenceError" or name = "Reflect" or name = "RegExp" or name = "Set" or name = "SharedArrayBuffer" or name = "String" or name = "Symbol" or name = "SyntaxError" or name = "TypeError" or name = "URIError" or name = "Uint16Array" or name = "Uint32Array" or name = "Uint8Array" or name = "Uint8ClampedArray" or name = "WeakMap" or name = "WeakRef" or name = "WeakSet" or name = "decodeURI" or name = "decodeURIComponent" or name = "encodeURI" or name = "encodeURIComponent" or name = "escape" or name = "eval" or name = "globalThis" or name = "isFinite" or name = "isNaN" or name = "parseFloat" or name = "parseInt" or name = "undefined" or name = "unescape";
let new_callees = select l.parent as id from "semantic-child" as l join constructors as r on l.child = r.id where l.field = "callee";
let global_news = select l.id as id from new_callees as l join nodes as r on l.id = r.id where r.kind = "new-expression";
let fresh_news = select l.root as root, l.node as node from new_leaves as l join global_news as r on l.node = r.id;
let fresh_a = union(left=fresh_kinds, right=fresh_regex);
let fresh = union(left=fresh_a, right=fresh_news);
let stale = antijoin(left=new_leaves, right=fresh, left-on=["root", "node"], right-on=["root", "node"]);
let fresh_roots = antijoin(left=new_roots, right=stale, left-on=["root"], right-on=["root"]);
let fresh_sides = select l.binary as binary, l.operator as operator, l.side as side from sides as l join fresh_roots as r on l.side = r.root;
let strict_new = select binary from fresh_sides where operator = "===" or operator = "!==";
let loose_fresh = select binary, side from fresh_sides where operator = "==" or operator = "!=";
let loose_fresh_counts = group-count(from=loose_fresh, keys=["binary"], count="fresh");
let loose_new = select binary from loose_fresh_counts where fresh = 2;
let relational_ops = select parent as id from operated where kind = "binary-expression" and field = "operator" and (operator = "<" or operator = ">" or operator = "<=" or operator = ">=");
let relational_sides = select l.id as binary, c.child as side from relational_ops as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let direct_sides = select binary, side, side as inner from relational_sides;
let wrap_reach = closure(edges=wrap_edges, source="outer", destination="inner");
let reached_sides = select l.binary as binary, l.side as side, r.inner as inner from relational_sides as l join wrap_reach as r on l.side = r.outer;
let inner_sides_all = union(left=direct_sides, right=reached_sides);
let inner_sides = antijoin(left=inner_sides_all, right=wrap_edges, left-on=["inner"], right-on=["outer"]);
let signed = select id from unary_ops where operator = "-" or operator = "+" or operator = "~";
let signed_arguments = select l.parent as id, l.child as argument from "semantic-child" as l join signed as r on l.parent = r.id where l.field = "argument";
let direct_arguments = select id, argument as inner from signed_arguments;
let reached_arguments = select l.id as id, r.inner as inner from signed_arguments as l join wrap_reach as r on l.argument = r.outer;
let argument_inners = union(left=direct_arguments, right=reached_arguments);
let literal_ids = select id from literals;
let signed_literals = select l.id as id from argument_inners as l join literal_ids as r on l.inner = r.id;
let plain_templates_all = select id from "semantic-syntax" where kind = "template-literal";
let plain_templates = antijoin(left=plain_templates_all, right=template_expressions, left-on=["id"], right-on=["id"]);
let static_literals_a = union(left=literal_ids, right=signed_literals);
let static_literals_b = union(left=static_literals_a, right=global_undefined);
let static_literals = union(left=static_literals_b, right=plain_templates);
let static_sides = select l.binary as binary, l.side as side from inner_sides as l join static_literals as r on l.inner = r.id;
let static_counts = group-count(from=static_sides, keys=["binary"], count="sides");
let relational_hits = select binary from static_counts where sides = 2;
let binary_a = union(left=operand_hits, right=strict_new);
let binary_b = union(left=binary_a, right=loose_new);
let binary_c = union(left=binary_b, right=relational_hits);
let binary_hits = select binary as id from binary_c;
let logical_a = union(left=short_hits, right=coalesce_hits);
let hits = union(left=logical_a, right=binary_hits);
let found = select r.id as id, r.file as file, r.span as span from hits as l join nodes as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-constant-binary-expression(?:,|$)");
emit violations subject file key(id);
