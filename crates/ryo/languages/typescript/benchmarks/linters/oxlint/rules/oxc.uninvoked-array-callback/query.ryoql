import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let array_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "Array";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let news = select id, file, span from "semantic-syntax" where kind = "new-expression";
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join news as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let array_news = select l.id as id from inner_callees as l join array_names as r on l.inner = r.id;
let new_arguments = select l.parent as id, l.child as argument from "semantic-child" as l join array_news as r on l.parent = r.id where l.field = "arguments";
let argument_counts = group-count(from=new_arguments, keys=["id"], count="arguments");
let single = select l.id as id, l.argument as argument from new_arguments as l join argument_counts as r on l.id = r.id where r.arguments = 1;
let numbers = select file, span from "semantic-syntax" where kind = "numeric" and matches(text, "[^n]$");
let numeric_arguments = select l.id as id, r.id as argument, r.file as file, r.span as span from single as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "literal";
let numeric_rows = select l.argument as id, l.file as file, l.span as span from numeric_arguments as l join numbers as r on l.file = r.file and l.span = r.span;
let wrapped_numbers = parenthesized(candidates=numeric_rows);
let bare_numbers = antijoin(left=numeric_rows, right=wrapped_numbers, left-on=["id"], right-on=["id"]);
let sized = select l.id as id from numeric_arguments as l join bare_numbers as r on l.argument = r.id;
let sized_rows = select l.id as id, r.file as file, r.span as span from sized as l join news as r on l.id = r.id;
let wrapped_news = parenthesized(candidates=sized_rows);
let bare_news = antijoin(left=sized_rows, right=wrapped_news, left-on=["id"], right-on=["id"]);
let members = select l.parent as member, l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "member-expression";
let receivers = select r.member as member from bare_news as l join members as r on l.id = r.id;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let call_children = select l.parent as call, l.child as id from "semantic-child" as l join calls as r on l.parent = r.id;
let member_rows = select l.member as id, r.file as file, r.span as span from receivers as l join "semantic-syntax" as r on l.member = r.id;
let wrapped_members = parenthesized(candidates=member_rows);
let bare_members = antijoin(left=receivers, right=wrapped_members, left-on=["member"], right-on=["id"]);
let called = select l.member as member, r.call as call from bare_members as l join call_children as r on l.member = r.id;
let call_arguments = select l.parent as call, l.child as argument, l.ordinal as ordinal from "semantic-child" as l join called as r on l.parent = r.call where l.field = "arguments";
let later = select l.call as call, l.argument as argument from call_arguments as l join call_arguments as r on l.call = r.call where l.ordinal > r.ordinal;
let firsts = antijoin(left=call_arguments, right=later, left-on=["call", "argument"], right-on=["call", "argument"]);
let callbacks = select l.call as call, r.id as id, r.file as file, r.span as span from firsts as l join "semantic-syntax" as r on l.argument = r.id where r.kind = "function-expression" or r.kind = "arrow-function-expression";
let callback_rows = select id, file, span from callbacks;
let wrapped_callbacks = parenthesized(candidates=callback_rows);
let bare_callbacks = antijoin(left=callbacks, right=wrapped_callbacks, left-on=["id"], right-on=["id"]);
let invoked = select l.member as member from called as l join bare_callbacks as r on l.call = r.call;
let properties = select l.child as id from "semantic-child" as l join invoked as r on l.parent = r.member where l.field = "property";
let found = select r.id as id, r.file as file, r.span as span from properties as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?uninvoked-array-callback(?:,|$)");
emit violations subject file key(id);
