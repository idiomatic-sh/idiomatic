import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let statements = select id, file, span from "semantic-syntax" where kind = "expression-statement";
let expressions = select l.parent as statement, l.child as expression from "semantic-child" as l join statements as r on l.parent = r.id where l.field = "expression";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-type-assertion" or kind = "ts-non-null-expression" or kind = "ts-instantiation-expression" or kind = "chain-expression";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let direct = select statement, expression as inner from expressions;
let reached = select l.statement as statement, r.inner as inner from expressions as l join unwrapped as r on l.expression = r.outer;
let candidates = union(left=direct, right=reached);
let innermost = antijoin(left=candidates, right=unwrapping, left-on=["inner"], right-on=["outer"]);
let unary_allowed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.kind = "keyword" and (r.text = "delete" or r.text = "void");
let unary = select id from "semantic-syntax" where kind = "unary-expression";
let disallowed_unary = antijoin(left=unary, right=unary_allowed, left-on=["id"], right-on=["id"]);
let disallowed_kinds = select id from "semantic-syntax" where kind = "literal" or kind = "sequence-expression" or kind = "function-expression" or kind = "array-expression" or kind = "member-expression" or kind = "meta-property" or kind = "object-expression" or kind = "template-literal" or kind = "arrow-function-expression" or kind = "class-expression" or kind = "binary-expression" or kind = "this-expression" or kind = "identifier" or kind = "conditional-expression" or kind = "logical-expression" or kind = "tagged-template-expression";
let disallowed = union(left=disallowed_kinds, right=disallowed_unary);
let unused = select l.statement as id from innermost as l join disallowed as r on l.inner = r.id;
let functions = select id from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression";
let function_bodies = select l.child as id from "semantic-child" as l join functions as r on l.parent = r.id where l.field = "body";
let other_containers = select id from "semantic-syntax" where kind = "program" or kind = "ts-module-block";
let containers = union(left=function_bodies, right=other_containers);
let contained = select l.parent as container, l.child as id, l.ordinal as ordinal from "semantic-child" as l join containers as r on l.parent = r.id where l.field = "body";
let string_tokens = select file, span from "semantic-syntax" where kind = "string";
let string_literals = select r.id as id, r.file as file, r.span as span from string_tokens as l join "semantic-syntax" as r on l.file = r.file and l.span = r.span where r.kind = "literal";
let wrapped_strings = parenthesized(candidates=string_literals);
let bare_strings = antijoin(left=string_literals, right=wrapped_strings, left-on=["id"], right-on=["id"]);
let string_statements = select l.statement as id from expressions as l join bare_strings as r on l.expression = r.id;
let shaped = select l.container as container, l.id as id, l.ordinal as ordinal from contained as l join string_statements as r on l.id = r.id;
let others = antijoin(left=contained, right=shaped, left-on=["id"], right-on=["id"]);
let interrupted = select l.id as id from shaped as l join others as r on l.container = r.container where r.ordinal < l.ordinal;
let prologue = antijoin(left=shaped, right=interrupted, left-on=["id"], right-on=["id"]);
let reported = antijoin(left=unused, right=prologue, left-on=["id"], right-on=["id"]);
let found = select r.id as id, r.file as file, r.span as span from reported as l join statements as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unused-expressions(?:,|$)");
emit violations subject file key(id);
