import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let restricted = select id from names where name = "undefined" or name = "NaN" or name = "Infinity" or name = "arguments" or name = "eval";
let declarators = select l.parent as owner, l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "id" and r.kind = "variable-declarator";
let initialized = select parent as owner from "semantic-child" where field = "init";
let undefined_names = select id from names where name = "undefined";
let bare_declarators = antijoin(left=declarators, right=initialized, left-on=["owner"], right-on=["owner"]);
let bare_undefined = select l.id as id from bare_declarators as l join undefined_names as r on l.id = r.id;
let declared = select id from declarators;
let named_owners = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "id" and (r.kind = "function-declaration" or r.kind = "function-expression" or r.kind = "class-declaration" or r.kind = "class-expression");
let parameters = select child as id from "semantic-child" where field = "params" or field = "param";
let locals = select child as id from "semantic-child" where field = "local";
let pattern_parts = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where (l.field = "elements" and r.kind = "array-pattern") or (l.field = "argument" and r.kind = "rest-element") or (l.field = "left" and r.kind = "assignment-pattern");
let pattern_properties = select l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "properties" and r.kind = "object-pattern";
let property_values = select l.child as id from "semantic-child" as l join pattern_properties as r on l.parent = r.id where l.field = "value";
let bindings_a = union(left=declared, right=named_owners);
let bindings_b = union(left=bindings_a, right=parameters);
let bindings_c = union(left=bindings_b, right=locals);
let bindings_d = union(left=bindings_c, right=pattern_parts);
let bindings = union(left=bindings_d, right=property_values);
let shadowing = select l.id as id from bindings as l join restricted as r on l.id = r.id;
let reported = antijoin(left=shadowing, right=bare_undefined, left-on=["id"], right-on=["id"]);
let found = select r.id as id, r.file as file, r.span as span from reported as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-shadow-restricted-names(?:,|$)");
emit violations subject file key(id);
