import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constant_values from "typescript/oxlint/constant-values";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let members = select id from "semantic-syntax" where kind = "member-expression";
let static_members = antijoin(left=members, right=computed, left-on=["id"], right-on=["id"]);
let plain_members = antijoin(left=static_members, right=optional, left-on=["id"], right-on=["id"]);
let member_properties = select l.parent as member, l.child as property from "semantic-child" as l join plain_members as r on l.parent = r.id where l.field = "property";
let lengths = select l.member as member, r.id as id, r.file as file, r.span as span from member_properties as l join names as r on l.property = r.id where r.name = "length";
let length_objects = select l.member as member, r.child as object from lengths as l join "semantic-child" as r on l.member = r.parent where r.field = "object";
let elements = select parent as array, child as element from "semantic-child" where field = "elements";
let element_counts = group-count(from=elements, keys=["array"], count="elements");
let single_elements = select l.array as array, l.element as element from elements as l join element_counts as r on l.array = r.array where r.elements = 1;
let spreads = select l.array as array, l.element as element from single_elements as l join "semantic-syntax" as r on l.element = r.id where r.kind = "spread-element";
let spread_operands = select l.array as source, r.child as operand from spreads as l join "semantic-child" as r on l.element = r.parent where r.field = "argument";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let call_callees = select l.parent as call, l.child as callee from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "callee";
let callee_members = select l.call as call, l.callee as callee from call_callees as l join plain_members as r on l.callee = r.id;
let array_objects = select l.call as call, l.callee as callee, c.child as object from callee_members as l join "semantic-child" as c on l.callee = c.parent where c.field = "object";
let array_callees = select l.call as call, l.callee as callee from array_objects as l join names as r on l.object = r.id where r.name = "Array";
let from_properties = select l.call as call, c.child as property from array_callees as l join "semantic-child" as c on l.callee = c.parent where c.field = "property";
let from_calls = select l.call as call from from_properties as l join names as r on l.property = r.id where r.name = "from";
let call_arguments = select parent as call, child as argument from "semantic-child" where field = "arguments";
let argument_counts = group-count(from=call_arguments, keys=["call"], count="arguments");
let single_arguments = select l.call as call, l.argument as argument from call_arguments as l join argument_counts as r on l.call = r.call where r.arguments = 1;
let from_arguments = select l.call as call, l.argument as argument from single_arguments as l join from_calls as r on l.call = r.call;
let argument_kinds = select l.call as call, l.argument as argument, r.kind as kind from from_arguments as l join "semantic-syntax" as r on l.argument = r.id;
let from_operands = select call as source, argument as operand from argument_kinds where kind != "spread-element";
let operands = union(left=spread_operands, right=from_operands);
let news = select id from "semantic-syntax" where kind = "new-expression";
let new_callees = select l.parent as id, l.child as callee from "semantic-child" as l join news as r on l.parent = r.id where l.field = "callee";
let set_news = select l.id as id from new_callees as l join names as r on l.callee = r.id where r.name = "Set";
let references = select reference, file from "binding-read";
let values = constant_values(references=references);
let set_values = select l.reference as reference, l.value as value from values as l join set_news as r on l.value = r.id where l.keyword = "const" and l.pattern = "identifier";
let set_value_rows = select l.reference as reference, l.value as id, r.file as file, r.span as span from set_values as l join "semantic-syntax" as r on l.value = r.id;
let value_candidates = select id, file, span from set_value_rows;
let wrapped_values = parenthesized(candidates=value_candidates);
let set_constants = antijoin(left=set_value_rows, right=wrapped_values, left-on=["id"], right-on=["id"]);
let constant_sets = select reference as id from set_constants;
let sets = union(left=set_news, right=constant_sets);
let set_operands = select l.source as source from operands as l join sets as r on l.operand = r.id;
let set_objects = select l.member as member from length_objects as l join set_operands as r on l.object = r.source;
let found = select l.id as id, l.file as file, l.span as span from lengths as l join set_objects as r on l.member = r.member;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?prefer-set-size(?:,|$)");
emit violations subject file key(id);
