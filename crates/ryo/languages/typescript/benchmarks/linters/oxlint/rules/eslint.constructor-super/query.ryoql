import directives from "typescript/oxlint/eslint-directives";
import constructors from "typescript/oxlint/control-flow";
import every_constructor from "typescript/oxlint/constructors";
import super_calls from "typescript/oxlint/super-calls";
let all_constructors = constructors();
let declared = every_constructor();
let declared_spans = select method, class, span from declared;
let declared_bounds = span-bounds(from=declared_spans, span="span", start-output="begin", end-output="finish");
let shadowed = select l.method as method from declared_bounds as l join declared_bounds as r on l.class = r.class where r.begin < l.begin;
let checked = antijoin(left=all_constructors, right=shadowed, left-on=["method"], right-on=["method"]);
let checked_files = project(from=checked, columns=["file"]);
let statements = select l.node as id, l.block as block, l.ordinal as ordinal, l.file as file from "flow-step" as l join checked_files as r on l.file = r.file;
let exits = select l.block as block, l.ordinal as ordinal, l."step-kind" as kind, l.file as file from "flow-step" as l join checked_files as r on l.file = r.file where l."step-kind" = "return" or l."step-kind" = "return-undefined" or l."step-kind" = "throw";
let after_exit = select l.id as id from statements as l join exits as r on l.block = r.block and l.file = r.file where r.ordinal < l.ordinal;
let before_exit = antijoin(left=statements, right=after_exit, left-on=["id"], right-on=["id"]);
let blocks = select l.block as block, l.reachable as reachable, l."implicit-return" as implicit, l.file as file from "flow-block" as l join checked_files as r on l.file = r.file;
let marked_blocks = select block, file from blocks where reachable = "true";
let open_statements = select l.id as id, l.block as block, l.file as file from before_exit as l join marked_blocks as r on l.block = r.block and l.file = r.file;
let expressions = select l.id as id, l.block as block, l.file as file, r.child as expression from open_statements as l join "semantic-child" as r on l.id = r.parent where r.field = "expression";
let super_calls_all = super_calls(scope=checked_files);
let super_calls_found = select call, span from super_calls_all;
let plain = select l.id as id, l.block as block, l.file as file, r.span as span from expressions as l join super_calls_found as r on l.expression = r.call;
let consequents = select l.id as id, l.block as block, l.file as file, r.child as branch from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "consequent";
let alternates = select l.id as id, l.block as block, l.file as file, r.child as branch from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "alternate";
let ternary_firsts = select l.id as id, l.block as block, l.file as file, r.span as span from consequents as l join super_calls_found as r on l.branch = r.call;
let ternary_seconds = select l.id as id, l.block as block, l.file as file, r.span as span from alternates as l join super_calls_found as r on l.branch = r.call;
let ternary_rest = antijoin(left=ternary_seconds, right=ternary_firsts, left-on=["id"], right-on=["id"]);
let ternaries = union(left=ternary_firsts, right=ternary_rest);
let operators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.text = "||";
let lefts = select l.id as id, l.block as block, l.file as file, r.child as side from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "left";
let rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, r.child as side from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "right";
let super_lefts = select l.id as id from lefts as l join super_calls_found as r on l.side = r.call;
let super_rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, r.span as span from rights as l join super_calls_found as r on l.side = r.call;
let either_rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, l.span as span from super_rights as l join super_lefts as r on l.id = r.id;
let disjunctions = select l.id as id, l.block as block, l.file as file, l.span as span from either_rights as l join operators as r on l.expression = r.id;
let direct = select l.id as id, l.block as block, l.file as file, r.span as span from open_statements as l join super_calls_found as r on l.id = r.call;
let stated = union(left=plain, right=direct);
let some_calls = union(left=stated, right=ternaries);
let calls = union(left=some_calls, right=disjunctions);
let scopes = select l.id as id from "semantic-syntax" as l join checked_files as r on l.file = r.file where l.kind = "function-declaration" or l.kind = "function-expression" or l.kind = "arrow-function-expression";
let owned = axis(from=calls, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let counted = select l.method as method, l.heritage as heritage, r.id as id, r.block as block, r.file as file, r.span as span from checked as l join owned as r on l.function = r.related;
let misplaced = select id, file, span from counted where heritage = "none" or heritage = "invalid";
let null_constructors = select method, function, file, span from checked where heritage = "null";
let null_calls = select id, file, span from counted where heritage = "null";
let null_called = select method from counted where heritage = "null";
let null_uncalled = antijoin(left=null_constructors, right=null_called, left-on=["method"], right-on=["method"]);
let null_bodies = select l.method as method, l.file as file, l.span as span, r.child as body from null_uncalled as l join "semantic-child" as r on l.function = r.parent where r.field = "body";
let null_files = project(from=null_constructors, columns=["file"]);
let null_nodes = select l.id as id, l.kind as kind from "semantic-syntax" as l join null_files as r on l.file = r.file;
let nesting = select l.parent as outer, l.child as inner from "semantic-child" as l join null_nodes as r on l.parent = r.id where (r.kind = "block-statement" and l.field = "body") or (r.kind = "if-statement" and (l.field = "consequent" or l.field = "alternate")) or (r.kind = "switch-statement" and l.field = "cases") or (r.kind = "switch-case" and l.field = "consequent") or (r.kind = "try-statement" and (l.field = "block" or l.field = "handler" or l.field = "finalizer")) or (r.kind = "catch-clause" and l.field = "body") or ((r.kind = "while-statement" or r.kind = "do-while-statement" or r.kind = "for-statement" or r.kind = "for-in-statement" or r.kind = "for-of-statement") and l.field = "body");
let nested = closure(edges=nesting, source="outer", destination="inner");
let returns = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "return-statement" and l.field = "argument";
let body_nested = select l.method as method, r.inner as inner from null_bodies as l join nested as r on l.body = r.outer;
let null_returning = select l.method as method from body_nested as l join returns as r on l.inner = r.id;
let null_missing = antijoin(left=null_bodies, right=null_returning, left-on=["method"], right-on=["method"]);
let null_reports = select method as id, file, span from null_missing;
let null_misplaced = union(left=null_calls, right=misplaced);
let valid_constructors = select method, block, file, span from checked where heritage = "valid";
let valid_called = select method from counted where heritage = "valid";
let valid_uncalled = antijoin(left=valid_constructors, right=valid_called, left-on=["method"], right-on=["method"]);
let uncalled_reports = select method as id, file, span from valid_uncalled;
let tracked = select l.method as method, l.block as start, l.file as file, l.span as span from valid_constructors as l join valid_called as r on l.method = r.method;
let block_calls = group-count(from=counted, keys=["file", "block"], count="calls");
let once_blocks = select block, file from block_calls where calls = 1;
let many_blocks = select block, file from block_calls where calls > 1;
let called_blocks = select block, file from block_calls;
let exit_blocks_stepped = select block, file from exits;
let exit_blocks_implicit = select block, file from blocks where implicit = "true";
let exit_blocks = union(left=exit_blocks_stepped, right=exit_blocks_implicit);
let accepting = select block, file from exits where kind = "return" or kind = "throw";
let passing_blocks = antijoin(left=marked_blocks, right=exit_blocks, left-on=["block", "file"], right-on=["block", "file"]);
let edges = select l.source as source, l.target as target, l."edge-kind" as kind, l.ordinal as place, l.file as file from "flow-edge" as l join passing_blocks as r on l.source = r.block and l.file = r.file;
let programs = select file from "semantic-syntax" where kind = "program";
let states_never = extend(from=programs, values={state: "never"});
let states_once = extend(from=programs, values={state: "once"});
let states_mixed = extend(from=programs, values={state: "mixed"});
let states_multiple = extend(from=programs, values={state: "multiple"});
let states_low = union(left=states_never, right=states_once);
let states_high = union(left=states_mixed, right=states_multiple);
let states = union(left=states_low, right=states_high);
let order_never = extend(from=programs, values={lower: "unreached", upper: "never"});
let order_once = extend(from=programs, values={lower: "unreached", upper: "once"});
let order_never_mixed = extend(from=programs, values={lower: "never", upper: "mixed"});
let order_once_mixed = extend(from=programs, values={lower: "once", upper: "mixed"});
let order_mixed_multiple = extend(from=programs, values={lower: "mixed", upper: "multiple"});
let order_least = union(left=order_never, right=order_once);
let order_middle = union(left=order_never_mixed, right=order_once_mixed);
let order_low = union(left=order_least, right=order_middle);
let lattice = union(left=order_low, right=order_mixed_multiple);
let ranks_never = extend(from=programs, values={state: "never", rank: 0});
let ranks_once = extend(from=programs, values={state: "once", rank: 1});
let ranks_mixed = extend(from=programs, values={state: "mixed", rank: 2});
let ranks_multiple = extend(from=programs, values={state: "multiple", rank: 3});
let ranks_low = union(left=ranks_never, right=ranks_once);
let ranks_high = union(left=ranks_mixed, right=ranks_multiple);
let ranks = union(left=ranks_low, right=ranks_high);
let free_blocks = antijoin(left=marked_blocks, right=called_blocks, left-on=["block", "file"], right-on=["block", "file"]);
let free_marks = extend(from=free_blocks, values={calls: "none"});
let once_marks = extend(from=once_blocks, values={calls: "one"});
let many_marks = extend(from=many_blocks, values={calls: "many"});
let some_marks = union(left=free_marks, right=once_marks);
let block_marks = union(left=some_marks, right=many_marks);
let kept_states = select file, state, state as passed from states;
let moved_none = extend(from=kept_states, values={calls: "none"});
let first_states = select file, state from states where state = "never";
let moved_first = extend(from=first_states, values={passed: "once", calls: "one"});
let repeat_states = select file, state from states where state != "never";
let moved_repeat = extend(from=repeat_states, values={passed: "multiple", calls: "one"});
let moved_many = extend(from=states, values={passed: "multiple", calls: "many"});
let moved_one = union(left=moved_first, right=moved_repeat);
let moved_some = union(left=moved_none, right=moved_one);
let moved = union(left=moved_some, right=moved_many);
let passes = select l.block as block, l.file as file, r.state as before, r.passed as passed from block_marks as l join moved as r on l.file = r.file and l.calls = r.calls;
let carried = select source, target, place, file from edges where kind = "jump" or kind = "normal" or kind = "join" or kind = "finalize";
let carried_moves = select l.source as source, l.target as target, l.place as place, r.before as before, r.passed as after, l.file as file from carried as l join passes as r on l.source = r.block and l.file = r.file;
let raised = select source, target, place, file from edges where kind = "error-explicit";
let raised_moves = select l.source as source, l.target as target, l.place as place, r.state as before, r.state as after, l.file as file from raised as l all-pairs join states as r on l.file = r.file;
let backs = select source, target, place, file from edges where kind = "backedge";
let back_states = select l.source as source, l.target as target, l.place as place, r.state as before, l.file as file from backs as l all-pairs join states as r on l.file = r.file;
let back_marked = extend(from=back_states, values={after: "unreached"});
let back_moves = select source, target, place, before, after, file from back_marked;
let live_exits = select l.block as block, l.file as file from exit_blocks as l join marked_blocks as r on l.block = r.block and l.file = r.file;
let exit_states = select l.block as source, l.block as target, r.state as before, l.file as file from live_exits as l all-pairs join states as r on l.file = r.file;
let exit_marked = extend(from=exit_states, values={place: 0, after: "unreached"});
let exit_moves = select source, target, place, before, after, file from exit_marked;
let flow_moves = union(left=carried_moves, right=raised_moves);
let walked_moves = union(left=flow_moves, right=back_moves);
let moves = union(left=walked_moves, right=exit_moves);
let start_blocks = select start as block, file from tracked;
let starts = extend(from=start_blocks, values={state: "never"});
let trace = worklist(from=starts, root="block", state="state", edges=moves, source="source", destination="target", order="place", before="before", after="after", lattice=lattice, lower="lower", upper="upper", keys=["file"], output="reached");
let traced = select l.method as method, r.source as source, r.target as target, r.place as place, r.before as before, r.reached as reached, r.file as file from tracked as l join trace as r on l.start = r.block and l.file = r.file;
let exit_pops = select l.method as method, l.source as block, l.before as before, l.file as file from traced as l join live_exits as r on l.source = r.block and l.target = r.block and l.file = r.file;
let exit_afters = select l.method as method, l.block as block, l.file as file, r.passed as after from exit_pops as l join passes as r on l.block = r.block and l.file = r.file and l.before = r.before;
let exit_never = select method, block, file from exit_afters where after = "never";
let exit_once = select method from exit_afters where after = "once";
let exit_mixed = select method from exit_afters where after = "mixed";
let exit_two = select method from exit_afters where after = "multiple";
let exit_unaccepted = antijoin(left=exit_never, right=accepting, left-on=["block", "file"], right-on=["block", "file"]);
let exit_missing_some = select method from exit_unaccepted;
let back_pops = select l.method as method, l.source as source, l.target as header, l.before as before, l.reached as reached, l.file as file from traced as l join backs as r on l.source = r.source and l.target = r.target and l.place = r.place and l.file = r.file;
let called_sources = select l.method as method from back_pops as l join called_blocks as r on l.source = r.block and l.file = r.file;
let called_headers = select l.method as method from back_pops as l join called_blocks as r on l.header = r.block and l.file = r.file;
let back_passed = select l.method as method, l.reached as reached, r.passed as passed, l.file as file from back_pops as l join passes as r on l.source = r.block and l.file = r.file and l.before = r.before;
let reached_ranks = select l.method as method, l.passed as passed, l.file as file, r.rank as low from back_passed as l join ranks as r on l.reached = r.state and l.file = r.file;
let grown = select l.method as method from reached_ranks as l join ranks as r on l.passed = r.state and l.file = r.file where l.low < r.rank;
let loops_called = union(left=called_sources, right=called_headers);
let looped = union(left=loops_called, right=grown);
let multiple = select method from exit_two;
let duplicated = union(left=multiple, right=looped);
let missing_paths = union(left=exit_mixed, right=exit_missing_some);
let missing = union(left=missing_paths, right=looped);
let exited = select method from exit_afters;
let failing_exits_once = union(left=exit_once, right=exit_mixed);
let failing_exits = union(left=failing_exits_once, right=exit_missing_some);
let failing_two = union(left=failing_exits, right=multiple);
let failing = union(left=failing_two, right=looped);
let all_exiting = antijoin(left=exited, right=failing, left-on=["method"], right-on=["method"]);
let flagged_methods = union(left=missing, right=all_exiting);
let flagged = select l.method as id, l.file as file, l.span as span from tracked as l join flagged_methods as r on l.method = r.method;
let resulting = union(left=exited, right=looped);
let unresolved = antijoin(left=tracked, right=resulting, left-on=["method"], right-on=["method"]);
let unresolved_methods = select method from unresolved;
let duplicating = union(left=duplicated, right=unresolved_methods);
let valid_calls = select l.method as method, l.id as id, l.file as file, l.span as span from counted as l join duplicating as r on l.method = r.method where l.heritage = "valid";
let call_bounds = span-bounds(from=valid_calls, span="span", start-output="begin", end-output="finish");
let later_calls = select l.id as id, l.file as file, l.span as span from call_bounds as l join call_bounds as r on l.method = r.method where r.begin < l.begin;
let some_reports = union(left=null_misplaced, right=null_reports);
let more_reports = union(left=some_reports, right=uncalled_reports);
let path_reports = union(left=more_reports, right=flagged);
let all_reports = union(left=path_reports, right=later_calls);
let found = project(from=all_reports, columns=["id", "file", "span"]);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?constructor-super(?:,|$)");
emit violations subject file key(id);
