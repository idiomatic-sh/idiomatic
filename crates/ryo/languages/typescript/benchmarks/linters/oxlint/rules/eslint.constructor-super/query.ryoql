import directives from "typescript/oxlint/eslint-directives";
import constructors from "typescript/oxlint/control-flow";
let all_constructors = constructors();
let class_bodies = select l.method as method, r.parent as body from all_constructors as l join "semantic-child" as r on l.method = r.child where r.field = "body";
let siblings = select l.method as method, r.child as sibling from class_bodies as l join "semantic-child" as r on l.body = r.parent where r.field = "body";
let sibling_values = select l.method as method, l.sibling as sibling, r.child as value from siblings as l join "semantic-child" as r on l.sibling = r.parent where r.field = "value";
let empty_values = select l.method as method, l.sibling as sibling from sibling_values as l join "semantic-syntax" as r on l.value = r.id where r.kind = "ts-empty-body-function-expression";
let sibling_keys = select l.method as method, l.sibling as sibling, r.child as key from empty_values as l join "semantic-child" as r on l.sibling = r.parent where r.field = "key";
let sibling_tokens = select l.method as method, l.sibling as sibling, r.child as token from sibling_keys as l join "semantic-child" as r on l.key = r.parent;
let constructor_siblings = select l.method as method, l.sibling as sibling from sibling_tokens as l join "semantic-syntax" as r on l.token = r.id where r.kind = "identifier-token" and r.text = "constructor";
let sibling_spans = select l.method as method, r.span as span from constructor_siblings as l join "semantic-syntax" as r on l.sibling = r.id;
let sibling_bounds = span-bounds(from=sibling_spans, span="span", start-output="begin", end-output="finish");
let method_spans = select method, span from all_constructors;
let method_bounds = span-bounds(from=method_spans, span="span", start-output="begin", end-output="finish");
let shadowed = select l.method as method from method_bounds as l join sibling_bounds as r on l.method = r.method where r.begin < l.begin;
let checked = antijoin(left=all_constructors, right=shadowed, left-on=["method"], right-on=["method"]);
let checked_files = project(from=checked, columns=["file"]);
let statements = select l.node as id, l.block as block, l.ordinal as ordinal, l.file as file from "flow-step" as l join checked_files as r on l.file = r.file;
let exits = select l.block as block, l.ordinal as ordinal, l."step-kind" as kind, l.file as file from "flow-step" as l join checked_files as r on l.file = r.file where l."step-kind" = "return" or l."step-kind" = "return-undefined" or l."step-kind" = "throw";
let after_exit = select l.id as id from statements as l join exits as r on l.block = r.block and l.file = r.file where r.ordinal < l.ordinal;
let before_exit = antijoin(left=statements, right=after_exit, left-on=["id"], right-on=["id"]);
let blocks = select l.block as block, l.reachable as reachable, l."implicit-return" as implicit, l.file as file from "flow-block" as l join checked_files as r on l.file = r.file;
let marked_blocks = select block, file from blocks where reachable = "true";
let open_statements = select l.id as id, l.block as block, l.file as file from before_exit as l join marked_blocks as r on l.block = r.block and l.file = r.file;
let expressions = select l.id as id, l.block as block, l.file as file, r.child as expression from open_statements as l join "semantic-child" as r on l.id = r.parent where r.field = "expression";
let callee_links = select l.parent as call from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "callee" and r.kind = "super";
let super_calls = select l.call as call, r.span as span from callee_links as l join "semantic-syntax" as r on l.call = r.id where r.kind = "call-expression";
let plain = select l.id as id, l.block as block, l.file as file, r.span as span from expressions as l join super_calls as r on l.expression = r.call;
let consequents = select l.id as id, l.block as block, l.file as file, r.child as branch from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "consequent";
let alternates = select l.id as id, l.block as block, l.file as file, r.child as branch from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "alternate";
let ternary_firsts = select l.id as id, l.block as block, l.file as file, r.span as span from consequents as l join super_calls as r on l.branch = r.call;
let ternary_seconds = select l.id as id, l.block as block, l.file as file, r.span as span from alternates as l join super_calls as r on l.branch = r.call;
let ternary_rest = antijoin(left=ternary_seconds, right=ternary_firsts, left-on=["id"], right-on=["id"]);
let ternaries = union(left=ternary_firsts, right=ternary_rest);
let operators = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and r.text = "||";
let lefts = select l.id as id, l.block as block, l.file as file, r.child as side from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "left";
let rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, r.child as side from expressions as l join "semantic-child" as r on l.expression = r.parent where r.field = "right";
let super_lefts = select l.id as id from lefts as l join super_calls as r on l.side = r.call;
let super_rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, r.span as span from rights as l join super_calls as r on l.side = r.call;
let either_rights = select l.id as id, l.block as block, l.file as file, l.expression as expression, l.span as span from super_rights as l join super_lefts as r on l.id = r.id;
let disjunctions = select l.id as id, l.block as block, l.file as file, l.span as span from either_rights as l join operators as r on l.expression = r.id;
let direct = select l.id as id, l.block as block, l.file as file, r.span as span from open_statements as l join super_calls as r on l.id = r.call;
let stated = union(left=plain, right=direct);
let some_calls = union(left=stated, right=ternaries);
let calls = union(left=some_calls, right=disjunctions);
let scopes = select id from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression";
let owned = axis(from=calls, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let counted = select l.method as method, l.heritage as heritage, r.id as id, r.block as block, r.file as file, r.span as span from checked as l join owned as r on l.function = r.related;
let misplaced = select id, file, span from counted where heritage = "none" or heritage = "invalid";
let null_constructors = select method, function, file, span from checked where heritage = "null";
let null_calls = select id, file, span from counted where heritage = "null";
let null_called = select method from counted where heritage = "null";
let null_uncalled = antijoin(left=null_constructors, right=null_called, left-on=["method"], right-on=["method"]);
let null_bodies = select l.method as method, l.file as file, l.span as span, r.child as body from null_uncalled as l join "semantic-child" as r on l.function = r.parent where r.field = "body";
let null_files = project(from=null_constructors, columns=["file"]);
let null_nodes = select l.id as id, l.kind as kind from "semantic-syntax" as l join null_files as r on l.file = r.file;
let nesting = select l.parent as outer, l.child as inner from "semantic-child" as l join null_nodes as r on l.parent = r.id where (r.kind = "block-statement" and l.field = "body") or (r.kind = "if-statement" and (l.field = "consequent" or l.field = "alternate")) or (r.kind = "switch-statement" and l.field = "cases") or (r.kind = "switch-case" and l.field = "consequent") or (r.kind = "try-statement" and (l.field = "block" or l.field = "handler" or l.field = "finalizer")) or (r.kind = "catch-clause" and l.field = "body") or ((r.kind = "while-statement" or r.kind = "do-while-statement" or r.kind = "for-statement" or r.kind = "for-in-statement" or r.kind = "for-of-statement") and l.field = "body");
let nested = closure(edges=nesting, source="outer", destination="inner");
let returns = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where r.kind = "return-statement" and l.field = "argument";
let returning = select l.outer as body from nested as l join returns as r on l.inner = r.id;
let null_returning = select l.method as method from null_bodies as l join returning as r on l.body = r.body;
let null_missing = antijoin(left=null_bodies, right=null_returning, left-on=["method"], right-on=["method"]);
let null_reports = select method as id, file, span from null_missing;
let null_misplaced = union(left=null_calls, right=misplaced);
let valid_constructors = select method, block, file, span from checked where heritage = "valid";
let valid_called = select method from counted where heritage = "valid";
let valid_uncalled = antijoin(left=valid_constructors, right=valid_called, left-on=["method"], right-on=["method"]);
let uncalled_reports = select method as id, file, span from valid_uncalled;
let tracked = select l.method as method, l.block as start, l.file as file, l.span as span from valid_constructors as l join valid_called as r on l.method = r.method;
let block_calls = group-count(from=counted, keys=["file", "block"], count="calls");
let once_blocks = select block, file from block_calls where calls = 1;
let many_blocks = select block, file from block_calls where calls > 1;
let called_blocks = select block, file from block_calls;
let exit_blocks_stepped = select block, file from exits;
let exit_blocks_implicit = select block, file from blocks where implicit = "true";
let exit_blocks = union(left=exit_blocks_stepped, right=exit_blocks_implicit);
let accepting = select block, file from exits where kind = "return" or kind = "throw";
let passing_blocks = antijoin(left=marked_blocks, right=exit_blocks, left-on=["block", "file"], right-on=["block", "file"]);
let edges = select l.source as source, l.target as target, l."edge-kind" as kind, l.file as file from "flow-edge" as l join passing_blocks as r on l.source = r.block and l.file = r.file;
let raised = select source, target, file from edges where kind = "error-explicit";
let carried = select source, target, file from edges where kind = "jump" or kind = "normal" or kind = "join" or kind = "finalize";
let carried_free = antijoin(left=carried, right=called_blocks, left-on=["source", "file"], right-on=["block", "file"]);
let carried_once = select l.source as source, l.target as target, l.file as file from carried as l join once_blocks as r on l.source = r.block and l.file = r.file;
let carried_many = select l.source as source, l.target as target, l.file as file from carried as l join many_blocks as r on l.source = r.block and l.file = r.file;
let carried_some = union(left=carried_once, right=carried_many);
let level_edges = union(left=raised, right=carried_free);
let level_reach = closure(edges=level_edges, source="source", destination="target", keys=["file"]);
let all_edges = union(left=raised, right=carried);
let all_reach = closure(edges=all_edges, source="source", destination="target", keys=["file"]);
let first_starts = select method, start as block, file from tracked;
let first_reached = select l.method as method, r.target as block, l.file as file from first_starts as l join level_reach as r on l.file = r.file and l.block = r.source;
let first_level = union(left=first_starts, right=first_reached);
let second_starts = select l.method as method, r.target as block, l.file as file from first_level as l join carried_once as r on l.block = r.source and l.file = r.file;
let second_reached = select l.method as method, r.target as block, l.file as file from second_starts as l join level_reach as r on l.file = r.file and l.block = r.source;
let second_level = union(left=second_starts, right=second_reached);
let third_from_first = select l.method as method, r.target as block, l.file as file from first_level as l join carried_many as r on l.block = r.source and l.file = r.file;
let third_from_second = select l.method as method, r.target as block, l.file as file from second_level as l join carried_some as r on l.block = r.source and l.file = r.file;
let third_starts = union(left=third_from_first, right=third_from_second);
let third_reached = select l.method as method, r.target as block, l.file as file from third_starts as l join all_reach as r on l.file = r.file and l.block = r.source;
let third_level = union(left=third_starts, right=third_reached);
let first_marked = extend(from=first_level, values={level: 0});
let second_marked = extend(from=second_level, values={level: 1});
let third_marked = extend(from=third_level, values={level: 2});
let low_levels = union(left=first_marked, right=second_marked);
let levels = union(left=low_levels, right=third_marked);
let marked_levels = select l.method as method, l.block as block, l.file as file, l.level as level from levels as l join marked_blocks as r on l.block = r.block and l.file = r.file;
let free_levels = antijoin(left=marked_levels, right=called_blocks, left-on=["block", "file"], right-on=["block", "file"]);
let once_levels = select l.method as method, l.block as block, l.file as file, l.level as level from marked_levels as l join once_blocks as r on l.block = r.block and l.file = r.file;
let many_levels = select l.method as method, l.block as block, l.file as file from marked_levels as l join many_blocks as r on l.block = r.block and l.file = r.file;
let after_free = select method, block, file, level as after from free_levels;
let after_once_low = select method, block, file from once_levels where level = 0;
let after_once_high = select method, block, file from once_levels where level > 0;
let after_once_one = extend(from=after_once_low, values={after: 1});
let after_twice = union(left=after_once_high, right=many_levels);
let after_two = extend(from=after_twice, values={after: 2});
let after_some = union(left=after_free, right=after_once_one);
let afters = union(left=after_some, right=after_two);
let exit_afters = select l.method as method, l.block as block, l.file as file, l.after as after from afters as l join exit_blocks as r on l.block = r.block and l.file = r.file;
let exit_zero = select method, block, file from exit_afters where after = 0;
let exit_one = select method, block, file from exit_afters where after = 1;
let exit_two = select method, block, file from exit_afters where after = 2;
let exit_low = antijoin(left=exit_zero, right=exit_two, left-on=["method", "block", "file"], right-on=["method", "block", "file"]);
let exit_mixed = select l.method as method from exit_low as l join exit_one as r on l.method = r.method and l.block = r.block and l.file = r.file;
let exit_only_zero = antijoin(left=exit_low, right=exit_one, left-on=["method", "block", "file"], right-on=["method", "block", "file"]);
let exit_unaccepted = antijoin(left=exit_only_zero, right=accepting, left-on=["block", "file"], right-on=["block", "file"]);
let exit_missing_some = select method from exit_unaccepted;
let header_levels = select l.method as method, l.block as block, r.target as header, l.file as file from levels as l join edges as r on l.block = r.source and l.file = r.file where r.kind = "backedge";
let back_edges = select l.method as method, l.block as block, l.header as header, l.file as file from header_levels as l join marked_blocks as r on l.block = r.block and l.file = r.file;
let called_sources = select l.method as method from back_edges as l join called_blocks as r on l.block = r.block and l.file = r.file;
let called_headers = select l.method as method from back_edges as l join called_blocks as r on l.header = r.block and l.file = r.file;
let header_states = select l.method as method, l.block as block, l.header as header, l.file as file, r.level as level from back_edges as l join levels as r on l.method = r.method and l.header = r.block and l.file = r.file;
let back_afters = select l.method as method, l.block as block, l.header as header, l.file as file, r.after as after from back_edges as l join afters as r on l.method = r.method and l.block = r.block and l.file = r.file;
let header_zero = select method, header, file from header_states where level = 0;
let header_one = select method, header, file from header_states where level = 1;
let header_two = select method, header, file from header_states where level = 2;
let header_never_base = antijoin(left=header_zero, right=header_one, left-on=["method", "header", "file"], right-on=["method", "header", "file"]);
let header_never = antijoin(left=header_never_base, right=header_two, left-on=["method", "header", "file"], right-on=["method", "header", "file"]);
let header_once_base = antijoin(left=header_one, right=header_zero, left-on=["method", "header", "file"], right-on=["method", "header", "file"]);
let header_once = antijoin(left=header_once_base, right=header_two, left-on=["method", "header", "file"], right-on=["method", "header", "file"]);
let header_mixed_base = select l.method as method, l.header as header, l.file as file from header_zero as l join header_one as r on l.method = r.method and l.header = r.header and l.file = r.file;
let header_mixed = antijoin(left=header_mixed_base, right=header_two, left-on=["method", "header", "file"], right-on=["method", "header", "file"]);
let back_raised = select method, header, file from back_afters where after > 0;
let back_two = select method, header, file from back_afters where after = 2;
let back_zero = select method, header, file from back_afters where after = 0;
let back_one = select method, header, file from back_afters where after = 1;
let back_mixed = select l.method as method, l.header as header, l.file as file from back_zero as l join back_one as r on l.method = r.method and l.header = r.header and l.file = r.file;
let back_grown = union(left=back_two, right=back_mixed);
let grown_never = select l.method as method from header_never as l join back_raised as r on l.method = r.method and l.header = r.header and l.file = r.file;
let grown_once = select l.method as method from header_once as l join back_grown as r on l.method = r.method and l.header = r.header and l.file = r.file;
let grown_mixed = select l.method as method from header_mixed as l join back_two as r on l.method = r.method and l.header = r.header and l.file = r.file;
let loops_called = union(left=called_sources, right=called_headers);
let loops_grown = union(left=grown_never, right=grown_once);
let loops_some = union(left=loops_called, right=loops_grown);
let looped = union(left=loops_some, right=grown_mixed);
let multiple = select method from exit_two;
let duplicated = union(left=multiple, right=looped);
let missing_paths = union(left=exit_mixed, right=exit_missing_some);
let missing = union(left=missing_paths, right=looped);
let exited = select method from exit_afters;
let failing_exits_mixed = select method from exit_one;
let failing_exits = union(left=failing_exits_mixed, right=exit_missing_some);
let failing_two = union(left=failing_exits, right=multiple);
let failing = union(left=failing_two, right=looped);
let all_exiting = antijoin(left=exited, right=failing, left-on=["method"], right-on=["method"]);
let flagged_methods = union(left=missing, right=all_exiting);
let flagged = select l.method as id, l.file as file, l.span as span from tracked as l join flagged_methods as r on l.method = r.method;
let resulting = union(left=exited, right=looped);
let unresolved = antijoin(left=tracked, right=resulting, left-on=["method"], right-on=["method"]);
let unresolved_methods = select method from unresolved;
let duplicating = union(left=duplicated, right=unresolved_methods);
let valid_calls = select l.method as method, l.id as id, l.file as file, l.span as span from counted as l join duplicating as r on l.method = r.method where l.heritage = "valid";
let call_bounds = span-bounds(from=valid_calls, span="span", start-output="begin", end-output="finish");
let later_calls = select l.id as id, l.file as file, l.span as span from call_bounds as l join call_bounds as r on l.method = r.method where r.begin < l.begin;
let some_reports = union(left=null_misplaced, right=null_reports);
let more_reports = union(left=some_reports, right=uncalled_reports);
let path_reports = union(left=more_reports, right=flagged);
let all_reports = union(left=path_reports, right=later_calls);
let found = project(from=all_reports, columns=["id", "file", "span"]);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?constructor-super(?:,|$)");
emit violations subject file key(id);
