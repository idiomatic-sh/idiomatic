import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import regexp_without_global from "typescript/oxlint/regexp-without-global";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let templates = select file, span, text from "semantic-syntax" where kind = "template";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let arguments = select parent as call, child as argument, ordinal from "semantic-child" where field = "arguments";
let earlier = select l.call as call, l.argument as argument from arguments as l join arguments as r on l.call = r.call where r.ordinal < l.ordinal;
let first_arguments = antijoin(left=arguments, right=earlier, left-on=["call", "argument"], right-on=["call", "argument"]);
let callees = select l.parent as call, r.id as callee, r.kind as kind, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "callee";
let callee_rows = select callee as id, file, span from callees;
let wrapped_callees = parenthesized(candidates=callee_rows);
let bare_callees = antijoin(left=callees, right=wrapped_callees, left-on=["callee"], right-on=["id"]);
let calls = select id from "semantic-syntax" where kind = "call-expression";
let method_callees = select l.call as call, l.callee as callee from bare_callees as l join calls as r on l.call = r.id where l.kind = "member-expression";
let method_properties = select l.call as call, l.callee as callee, r.child as property from method_callees as l join "semantic-child" as r on l.callee = r.parent where r.field = "property";
let static_methods = antijoin(left=method_properties, right=computed, left-on=["callee"], right-on=["id"]);
let static_named = select l.call as call, l.property as property from static_methods as l join names as r on l.property = r.id where r.name = "replaceAll";
let computed_methods = select l.call as call, l.property as property from method_properties as l join computed as r on l.callee = r.id;
let string_named = select l.call as call, l.property as property from computed_methods as l join "string-literal" as r on l.property = r.occurrence where r.value = "replaceAll";
let computed_method_rows = select l.call as call, l.property as property, r.file as file, r.span as span from computed_methods as l join "semantic-syntax" as r on l.property = r.id where r.kind = "template-literal";
let template_named = select l.call as call, l.property as property from computed_method_rows as l join templates as r on l.file = r.file and l.span = r.span where matches(r.text, "^\x60replaceAll\x60$");
let named_a = union(left=static_named, right=string_named);
let named = union(left=named_a, right=template_named);
let patterns = select l.property as property, r.argument as id from named as l join first_arguments as r on l.call = r.call;
let pattern_rows = select l.id as id, r.file as file from patterns as l join "semantic-syntax" as r on l.id = r.id;
let missing = regexp_without_global(patterns=pattern_rows);
let hits = select l.property as property from patterns as l join missing as r on l.id = r.id;
let found = select r.id as id, r.file as file, r.span as span from hits as l join "semantic-syntax" as r on l.property = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?bad-replace-all-arg(?:,|$)");
emit violations subject file key(id);
