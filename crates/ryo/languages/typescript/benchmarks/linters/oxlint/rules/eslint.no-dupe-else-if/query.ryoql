import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let ifs = select id, file, span from "semantic-syntax" where kind = "if-statement";
let if_bounds = span-bounds(from=ifs, span="span", start-output="begin", end-output="finish");
let alternates = select l.parent as outer, l.child as inner from "semantic-child" as l join ifs as r on l.parent = r.id where l.field = "alternate";
let else_ifs = select l.outer as outer, l.inner as inner from alternates as l join ifs as r on l.inner = r.id;
let chain = closure(edges=else_ifs, source="outer", destination="inner");
let tests = select l.parent as statement, l.child as test from "semantic-child" as l join ifs as r on l.parent = r.id where l.field = "test";
let logical_operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator" and (r.text = "||" or r.text = "&&");
let logicals = select l.id as id, l.operator as operator from logical_operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "logical-expression";
let logical_sides = select l.id as id, l.operator as operator, c.child as operand from logicals as l join "semantic-child" as c on l.id = c.parent where c.field = "left" or c.field = "right";
let or_logicals = select id from logicals where operator = "||";
let and_logicals = select id from logicals where operator = "&&";
let or_sides = select id, operand from logical_sides where operator = "||";
let and_sides = select id, operand from logical_sides where operator = "&&";
let or_edges = select l.id as outer, r.id as inner from or_sides as l join or_logicals as r on l.operand = r.id;
let and_edges = select l.id as outer, r.id as inner from and_sides as l join and_logicals as r on l.operand = r.id;
let or_reach = closure(edges=or_edges, source="outer", destination="inner");
let and_reach = closure(edges=and_edges, source="outer", destination="inner");
let or_leaf_sides = antijoin(left=or_sides, right=or_edges, left-on=["id", "operand"], right-on=["outer", "inner"]);
let and_leaf_sides = antijoin(left=and_sides, right=and_edges, left-on=["id", "operand"], right-on=["outer", "inner"]);
let or_own = select id as root, operand as leaf from or_leaf_sides;
let or_deep = select l.outer as root, r.operand as leaf from or_reach as l join or_leaf_sides as r on l.inner = r.id;
let or_split = union(left=or_own, right=or_deep);
let and_own = select id as root, operand as leaf from and_leaf_sides;
let and_deep = select l.outer as root, r.operand as leaf from and_reach as l join and_leaf_sides as r on l.inner = r.id;
let and_split = union(left=and_own, right=and_deep);
let test_nodes = select test as id from tests;
let and_test_leaves = select r.leaf as id from test_nodes as l join and_split as r on l.id = r.root;
let roots = union(left=test_nodes, right=and_test_leaves);
let or_root_parts = select l.id as root, r.leaf as part from roots as l join or_split as r on l.id = r.root;
let plain_roots = antijoin(left=roots, right=or_logicals, left-on=["id"], right-on=["id"]);
let plain_root_parts = select id as root, id as part from plain_roots;
let parts = union(left=or_root_parts, right=plain_root_parts);
let part_nodes = select part as id from parts;
let and_part_leaves = select l.id as part, r.leaf as leaf from part_nodes as l join and_split as r on l.id = r.root;
let plain_parts = antijoin(left=part_nodes, right=and_logicals, left-on=["id"], right-on=["id"]);
let plain_part_leaves = select id as part, id as leaf from plain_parts;
let part_leaves = union(left=and_part_leaves, right=plain_part_leaves);
let leaf_shapes_all = select l.part as part, r.shape as shape from part_leaves as l join "expression-shape" as r on l.leaf = r.id;
let leaf_shapes = project(from=leaf_shapes_all, columns=["part", "shape"]);
let later_tests = select l.inner as statement, r.test as test from chain as l join tests as r on l.inner = r.statement;
let later_statements = project(from=later_tests, columns=["statement", "test"]);
let own_candidates = select statement, test as candidate from later_statements;
let and_candidates = select l.statement as statement, r.leaf as candidate from later_statements as l join and_split as r on l.test = r.root;
let candidates = union(left=own_candidates, right=and_candidates);
let candidate_parts = select l.statement as statement, l.candidate as candidate, r.part as part from candidates as l join parts as r on l.candidate = r.root;
let earlier_tests = select l.outer as earlier, l.inner as statement, r.test as test from chain as l join tests as r on l.outer = r.statement;
let earlier_parts = select l.earlier as earlier, l.statement as statement, r.part as other from earlier_tests as l join parts as r on l.test = r.root;
let pairs = select l.statement as statement, l.candidate as candidate, l.part as part, r.earlier as earlier, r.other as other from candidate_parts as l join earlier_parts as r on l.statement = r.statement;
let pair_shapes = select l.statement as statement, l.candidate as candidate, l.part as part, l.earlier as earlier, l.other as other, r.shape as shape from pairs as l join leaf_shapes as r on l.part = r.part;
let shared = select l.statement as statement, l.candidate as candidate, l.part as part, l.earlier as earlier, l.other as other, l.shape as shape from pair_shapes as l join leaf_shapes as r on l.other = r.part and l.shape = r.shape;
let shared_counts = group-count(from=shared, keys=["statement", "candidate", "part", "earlier", "other"], distinct="shape", count="shared");
let other_sizes = group-count(from=leaf_shapes, keys=["part"], distinct="shape", count="size");
let covers = select l.statement as statement, l.candidate as candidate, l.part as part, l.earlier as earlier from shared_counts as l join other_sizes as r on l.other = r.part where l.shared = r.size;
let covered = project(from=covers, columns=["statement", "candidate", "part", "earlier"]);
let covered_bounds = select l.statement as statement, l.candidate as candidate, l.part as part, l.earlier as earlier, r.begin as begin from covered as l join if_bounds as r on l.earlier = r.id;
let superseded = select l.statement as statement, l.candidate as candidate, l.part as part, l.earlier as earlier from covered_bounds as l join covered_bounds as r on l.statement = r.statement and l.candidate = r.candidate and l.part = r.part where l.begin < r.begin;
let latest = antijoin(left=covered_bounds, right=superseded, left-on=["statement", "candidate", "part", "earlier"], right-on=["statement", "candidate", "part", "earlier"]);
let part_counts = group-count(from=candidate_parts, keys=["statement", "candidate"], distinct="part", count="parts");
let covered_counts = group-count(from=latest, keys=["statement", "candidate"], distinct="part", count="covered");
let complete = select l.statement as statement, l.candidate as candidate from part_counts as l join covered_counts as r on l.statement = r.statement and l.candidate = r.candidate where l.parts = r.covered;
let complete_latest = select l.statement as statement, l.candidate as candidate, l.earlier as earlier, l.begin as begin from latest as l join complete as r on l.statement = r.statement and l.candidate = r.candidate;
let not_reached = select l.statement as statement, l.candidate as candidate, l.earlier as earlier from complete_latest as l join complete_latest as r on l.statement = r.statement and l.candidate = r.candidate where l.begin > r.begin;
let reached = antijoin(left=complete_latest, right=not_reached, left-on=["statement", "candidate", "earlier"], right-on=["statement", "candidate", "earlier"]);
let not_first = select l.statement as statement, l.earlier as earlier from reached as l join reached as r on l.statement = r.statement where l.begin < r.begin;
let first_reached = antijoin(left=reached, right=not_first, left-on=["statement", "earlier"], right-on=["statement", "earlier"]);
let chosen = project(from=first_reached, columns=["statement", "earlier"]);
let labelled = select l.statement as statement, r.test as test from chosen as l join tests as r on l.earlier = r.statement;
let test_rows = select l.test as id, r.file as file, r.span as span from labelled as l join "semantic-syntax" as r on l.test = r.id;
let wrapped_tests = parenthesized(candidates=test_rows);
let inner_levels = select l.id as id, l.level as level from wrapped_tests as l join wrapped_tests as r on l.id = r.id where l.level < r.level;
let outermost = antijoin(left=wrapped_tests, right=inner_levels, left-on=["id", "level"], right-on=["id", "level"]);
let wrap_spans = select id, file, wrap as span from outermost;
let bare_tests = antijoin(left=test_rows, right=wrapped_tests, left-on=["id"], right-on=["id"]);
let test_spans = union(left=wrap_spans, right=bare_tests);
let found = select l.test as id, l.statement as statement, r.file as file, r.span as span from labelled as l join test_spans as r on l.test = r.id;
let firsts = project(from=found, columns=["id", "file", "span"]);
let violations = directives(candidates=firsts, names="(?:^|,)(?:[^,]*/)?no-dupe-else-if(?:,|$)");
let reported = select l.id as id, l.statement as statement, l.file as file, l.span as span from found as l join violations as r on l.id = r.id;
emit reported subject file key(id, statement);
