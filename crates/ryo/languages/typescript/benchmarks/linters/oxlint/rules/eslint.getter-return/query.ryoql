import directives from "typescript/oxlint/eslint-directives";
import javascript_files from "typescript/oxlint/javascript-files";
let files = javascript_files();
let nodes = select id, kind, file, span from "semantic-syntax";
let links = select parent, child, field from "semantic-child";
let marks = select l.parent as node, r.kind as kind, r.text as text from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "none";
let names = select l.parent as node, r.text as text from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token";
let computed = select node from marks where kind = "punctuator" and text = "[";
let functions = select id, file, span from nodes where kind = "function-expression" or kind = "arrow-function-expression";
let owned = select l.id as function, l.file as file, l.span as span, r.parent as owner from functions as l join links as r on l.id = r.child where r.field = "value";
let getter_marks = select node from marks where kind = "identifier-token" and text = "get";
let accessors = select l.function as function, l.file as file, l.span as span from owned as l join getter_marks as r on l.owner = r.node;
let owner_kinds = select l.function as function, l.file as file, l.span as span, l.owner as owner, r.kind as kind from owned as l join nodes as r on l.owner = r.id;
let property_owned = select function, file, span, owner from owner_kinds where kind = "property";
let property_keys = select l.function as function, l.file as file, l.span as span, l.owner as owner, r.child as key from property_owned as l join links as r on l.owner = r.parent where r.field = "key";
let plain_keys = antijoin(left=property_keys, right=computed, left-on=["owner"], right-on=["node"]);
let identifier_get = select l.function as function, l.file as file, l.span as span, l.owner as owner from plain_keys as l join names as r on l.key = r.node where r.text = "get";
let string_get = select l.function as function, l.file as file, l.span as span, l.owner as owner from property_keys as l join "string-literal" as r on l.key = r.occurrence where r.value = "get";
let get_keyed = union(left=identifier_get, right=string_get);
let get_objects = select l.function as function, l.file as file, l.span as span, r.parent as object from get_keyed as l join links as r on l.owner = r.child;
let near_calls = select l.function as function, l.file as file, l.span as span, r.parent as call from get_objects as l join links as r on l.object = r.child where r.field = "arguments";
let outer_properties = select l.function as function, l.file as file, l.span as span, r.parent as property from get_objects as l join links as r on l.object = r.child where r.field = "value";
let outer_objects = select l.function as function, l.file as file, l.span as span, r.parent as object from outer_properties as l join links as r on l.property = r.child;
let far_calls = select l.function as function, l.file as file, l.span as span, r.parent as call from outer_objects as l join links as r on l.object = r.child where r.field = "arguments";
let calls = union(left=near_calls, right=far_calls);
let callees = select l.function as function, l.file as file, l.span as span, r.child as callee from calls as l join links as r on l.call = r.parent where r.field = "callee";
let chained = select l.function as function, l.file as file, l.span as span, r.child as callee from callees as l join links as r on l.callee = r.parent where r.field = "expression";
let every_callee = union(left=callees, right=chained);
let members = select l.function as function, l.file as file, l.span as span, l.callee as member from every_callee as l join nodes as r on l.callee = r.id where r.kind = "member-expression";
let static_members = antijoin(left=members, right=computed, left-on=["member"], right-on=["node"]);
let objects = select l.parent as member, r.text as text from links as l join names as r on l.child = r.node where l.field = "object";
let properties = select l.parent as member, r.text as text from links as l join names as r on l.child = r.node where l.field = "property";
let receivers = select l.function as function, l.file as file, l.span as span, l.member as member, r.text as receiver from static_members as l join objects as r on l.member = r.member;
let methods = select l.function as function, l.file as file, l.span as span, l.receiver as receiver, r.text as method from receivers as l join properties as r on l.member = r.member;
let watched = select function, file, span from methods where (receiver = "Object" and (method = "defineProperty" or method = "create" or method = "defineProperties")) or (receiver = "Reflect" and method = "defineProperty");
let candidates_all = union(left=accessors, right=watched);
let candidates_js = select l.function as function, l.file as file, l.span as span from candidates_all as l join files as r on l.file = r.file;
let arrow_bodies = select l.parent as function, r.kind as kind from links as l join nodes as r on l.child = r.id where l.field = "body";
let arrows = select l.function as function from arrow_bodies as l join nodes as r on l.function = r.id where r.kind = "arrow-function-expression" and l.kind != "block-statement";
let candidates = antijoin(left=candidates_js, right=arrows, left-on=["function"], right-on=["function"]);
let starts = select l.function as function, l.file as file, l.span as span, r.block as block from candidates as l join "flow-member" as r on l.function = r.node and l.file = r.file;
let walked = select e.source as source, e.target as target, e.file as file from "flow-edge" as e where e."edge-kind" = "normal" or e."edge-kind" = "jump" or e."edge-kind" = "error-explicit";
let reach = closure(edges=walked, source="source", destination="target", keys=["file"]);
let reached_after = select l.function as function, l.file as file, l.span as span, r.target as block from starts as l join reach as r on l.block = r.source and l.file = r.file;
let reached = union(left=starts, right=reached_after);
let continuing = select e.source as block, e.file as file from "flow-edge" as e where e."edge-kind" = "normal" or e."edge-kind" = "jump" or e."edge-kind" = "backedge" or e."edge-kind" = "error-explicit";
let ends = antijoin(left=reached, right=continuing, left-on=["block", "file"], right-on=["block", "file"]);
let exits = select s.block as block, s.ordinal as ordinal, s."step-kind" as kind, s.file as file from "flow-step" as s where s."step-kind" = "return" or s."step-kind" = "return-undefined" or s."step-kind" = "throw";
let later = select l.block as block, l.ordinal as ordinal, l.file as file from exits as l join exits as r on l.block = r.block and l.file = r.file where l.ordinal > r.ordinal;
let first_exits = antijoin(left=exits, right=later, left-on=["block", "ordinal", "file"], right-on=["block", "ordinal", "file"]);
let returning = select block, file from first_exits where kind = "return" or kind = "throw";
let failing = antijoin(left=ends, right=returning, left-on=["block", "file"], right-on=["block", "file"]);
let found = project(from=failing, columns=["function", "file", "span"]);
let found_rows = select function as id, file, span from found;
let violations = directives(candidates=found_rows, names="(?:^|,)(?:[^,]*/)?getter-return(?:,|$)");
emit violations subject file key(id);
