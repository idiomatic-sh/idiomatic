import directives from "typescript/oxlint/eslint-directives";
let declared = select id, kind, refinement, name, owner, file, span from "defines" where (kind = "constant" or kind = "variable" or kind = "parameter" or kind = "function" or kind = "class" or kind = "import" or kind = "interface" or kind = "type-alias" or kind = "enum" or kind = "namespace" or kind = "type-parameter") and not glob_any(file, "**/*.d.ts") and not glob_any(file, "**/*.d.mts") and not glob_any(file, "**/*.d.cts") and not glob_any(file, "**/*.d.*.ts");
let expression_names = select id, name from declared where (kind = "function" and refinement = "function-expression") or (kind = "class" and refinement = "class-expression");
let symbols = antijoin(left=declared, right=expression_names, left-on=["id", "name"], right-on=["id", "name"]);
let nodes = select l.id as id, l.kind as kind, l.name as name, l.owner as owner, l.file as file, l.span as span, r.kind as node, r.span as whole from symbols as l join "semantic-syntax" as r on l.id = r.id;
let node_bounds = span-bounds(from=nodes, span="whole", start-output="dbegin", end-output="dfinish");
let edges = select l.parent as parent, l.child as child, l.field as field, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id;
let uses = select reference, binding, context, phase, file, span from "binding-use";
let reads = select reference, name from "binding-read";
let named = select l.reference as reference, l.binding as binding, r.name as name, l.context as context, l.phase as phase, l.file as file, l.span as span from uses as l join reads as r on l.reference = r.reference;
let use_bounds = span-bounds(from=named, span="span", start-output="begin", end-output="finish");
let callables = select id, name, dbegin, dfinish from node_bounds where kind = "function" or kind = "class";
let within_callables = select l.reference as reference from use_bounds as l join callables as r on l.binding = r.id and l.name = r.name where l.begin >= r.dbegin and l.finish <= r.dfinish;
let type_uses = select reference, binding, name, begin, finish from use_bounds where context = "type";
let within_declarations = select l.reference as reference from type_uses as l join node_bounds as r on l.binding = r.id and l.name = r.name where l.begin >= r.dbegin and l.finish <= r.dfinish;
let function_inits = select l.parent as id, r.span as whole from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "init" and (r.kind = "function-expression" or r.kind = "arrow-function-expression");
let init_bounds = span-bounds(from=function_inits, span="whole", start-output="ibegin", end-output="ifinish");
let within_inits = select l.reference as reference from use_bounds as l join init_bounds as r on l.binding = r.id where l.context != "type" and l.begin >= r.ibegin and l.finish <= r.ifinish;
let statements = select child as action, parent as statement from edges where kind = "expression-statement" and field = "expression";
let statement_scopes_domain = select id from "semantic-syntax" where kind = "for-statement" or kind = "for-in-statement" or kind = "for-of-statement" or kind = "while-statement" or kind = "do-while-statement" or kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression";
let loops = select id from "semantic-syntax" where kind = "for-statement" or kind = "for-in-statement" or kind = "for-of-statement" or kind = "while-statement" or kind = "do-while-statement";
let statement_rows = select statement as id from statements;
let statement_scopes = axis(from=statement_rows, relation="semantic-child", direction=nearest-ancestor, domain=statement_scopes_domain);
let looped = select l.id as id from statement_scopes as l join loops as r on l.related = r.id;
let discarded = antijoin(left=statements, right=looped, left-on=["statement"], right-on=["id"]);
let updated = select l.child as reference from edges as l join discarded as r on l.parent = r.action where l.kind = "update-expression" and l.field = "argument";
let operators = select l.parent as action, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let targets = select l.child as target, l.parent as action, r.operator as operator from edges as l join operators as r on l.parent = r.action where l.kind = "assignment-expression" and l.field = "left";
let discarded_targets = select l.target as target, l.action as action, l.operator as operator from targets as l join discarded as r on l.action = r.action;
let phase_domain = select id from "semantic-syntax" where kind = "program" or kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression" or kind = "ts-declare-function" or kind = "ts-empty-body-function-expression";
let declaration_rows = select id from symbols;
let declaration_phases = axis(from=declaration_rows, relation="semantic-child", direction=nearest-ancestor, domain=phase_domain);
let local_uses = select l.reference as reference, l.binding as binding, l.name as name, l.context as context from named as l join declaration_phases as r on l.binding = r.id and l.phase = r.related;
let compound = select target as reference from discarded_targets where operator != "=";
let compound_selves = select l.reference as reference from compound as l join local_uses as r on l.reference = r.reference;
let transparent = select child, parent from edges where kind = "binary-expression" or kind = "logical-expression" or kind = "unary-expression" or kind = "member-expression" or kind = "conditional-expression" or kind = "chain-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion" or kind = "ts-instantiation-expression" or kind = "await-expression" or kind = "template-literal" or kind = "tagged-template-expression" or kind = "array-expression" or kind = "object-expression" or kind = "property" or kind = "spread-element" or kind = "new-expression" or (kind = "call-expression" and field = "callee");
let climbs = closure(edges=transparent, source="child", destination="parent");
let plain_targets = select target, action from discarded_targets where operator = "=";
let rights = select l.child as node, l.parent as action from edges as l join plain_targets as r on l.parent = r.action where l.kind = "assignment-expression" and l.field = "right";
let local_reads = select reference, binding, name from local_uses where context = "value";
let read_climbs = select l.reference as reference, l.binding as binding, l.name as name, r.parent as node from local_reads as l join climbs as r on l.reference = r.child;
let read_selves = select reference, binding, name, reference as node from local_reads;
let read_nodes = union(left=read_climbs, right=read_selves);
let right_reads = select l.reference as reference, l.binding as binding, l.name as name, r.action as action from read_nodes as l join rights as r on l.node = r.node;
let assigned = select l.action as action, r.binding as binding, r.name as name from plain_targets as l join named as r on l.target = r.reference;
let assigned_selves = select l.reference as reference from right_reads as l join assigned as r on l.action = r.action and l.binding = r.binding and l.name = r.name;
let selves_a = union(left=within_callables, right=within_declarations);
let selves_b = union(left=selves_a, right=within_inits);
let selves_c = union(left=selves_b, right=updated);
let selves_d = union(left=selves_c, right=compound_selves);
let selves = union(left=selves_d, right=assigned_selves);
let counted = select reference, binding, name from named where context != "write";
let usages = antijoin(left=counted, right=selves, left-on=["reference"], right-on=["reference"]);
let used = select binding as id, name from usages;
let export_children = select child as id from edges where kind = "export-named-declaration" or kind = "export-default-declaration";
let exported_declarations = select l.child as id from edges as l join export_children as r on l.parent = r.id where l.kind = "variable-declaration";
let export_nodes = union(left=export_children, right=exported_declarations);
let exported = select l.owner as owner, l.name as name from symbols as l join export_nodes as r on l.id = r.id;
let unused = antijoin(left=nodes, right=used, left-on=["id", "name"], right-on=["id", "name"]);
let unexported = antijoin(left=unused, right=exported, left-on=["owner", "name"], right-on=["owner", "name"]);
let symbol_starts = span-bounds(from=symbols, span="span", start-output="sbegin", end-output="sfinish");
let later = select l.id as id, l.name as name from symbol_starts as l join symbol_starts as r on l.owner = r.owner and l.name = r.name where l.sbegin > r.sbegin and l.kind != "type-parameter" and r.kind != "type-parameter";
let firsts = antijoin(left=unexported, right=later, left-on=["id", "name"], right-on=["id", "name"]);
let tokens = select id, file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let declare_marks = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and r.text = "declare";
let modules = select id from "semantic-syntax" where kind = "ts-module-declaration";
let declare_modules = select l.id as id from modules as l join declare_marks as r on l.id = r.id;
let module_blocks = select parent as module, child as block from edges where kind = "ts-module-declaration" and field = "body";
let block_exports = select l.parent as block from edges as l join "semantic-syntax" as r on l.child = r.id where l.kind = "ts-module-block" and (r.kind = "export-named-declaration" or r.kind = "export-default-declaration" or r.kind = "export-all-declaration" or r.kind = "ts-export-assignment");
let exporting_modules = select l.module as id from module_blocks as l join block_exports as r on l.block = r.block;
let ambient_modules = antijoin(left=declare_modules, right=exporting_modules, left-on=["id"], right-on=["id"]);
let module_names = select l.parent as id, r.name as name from edges as l join names as r on l.child = r.id where l.kind = "ts-module-declaration";
let globals = select id from module_names where name = "global";
let declared_modules = union(left=ambient_modules, right=globals);
let first_rows = select id from firsts;
let in_declared_modules = axis(from=first_rows, relation="semantic-child", direction=ancestor, domain=declared_modules);
let in_globals = axis(from=first_rows, relation="semantic-child", direction=ancestor, domain=globals);
let named_ignored = select id, name from firsts where starts_with(name, "_") and node != "catch-clause" and node != "ts-declare-function";
let declared_classes = select l.id as id, l.name as name from firsts as l join declare_marks as r on l.id = r.id where l.node = "class-declaration";
let declared_functions = select l.id as id, l.name as name from firsts as l join declare_marks as r on l.id = r.id where l.node = "ts-declare-function";
let module_functions = select l.id as id, l.name as name from firsts as l join in_declared_modules as r on l.id = r.id where l.node = "ts-declare-function";
let module_types = select l.id as id, l.name as name from firsts as l join in_declared_modules as r on l.id = r.id where l.kind = "interface" or l.kind = "type-alias" or l.kind = "namespace";
let declared_namespaces = select l.id as id, l.name as name from firsts as l join declare_marks as r on l.id = r.id where l.kind = "namespace";
let inner_modules = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "ts-module-declaration";
let dotted_outer = select l.id as id, l.name as name from firsts as l join inner_modules as r on l.id = r.id where l.kind = "namespace";
let dotted_inner = select l.id as id, l.name as name from firsts as l join edges as r on l.id = r.child where l.kind = "namespace" and r.kind = "ts-module-declaration";
let inside_globals = select l.id as id, l.name as name from firsts as l join in_globals as r on l.id = r.id;
let global_names = select id, name from firsts where kind = "namespace" and name = "global";
let global_symbols = union(left=inside_globals, right=global_names);
let parameter_lists = select child as declaration, parent as list from edges where kind = "ts-type-parameter-declaration";
let interface_lists = select child as list, parent as interface from edges where kind = "ts-interface-declaration";
let interface_blocks = select child as interface, parent as block from edges where kind = "ts-module-block";
let ambient_blocks = select l.block as block from module_blocks as l join declare_marks as r on l.module = r.id;
let ambient_interfaces = select l.interface as interface from interface_blocks as l join ambient_blocks as r on l.block = r.block;
let ambient_lists = select l.list as list from interface_lists as l join ambient_interfaces as r on l.interface = r.interface;
let ambient_type_parameters = select l.declaration as id from parameter_lists as l join ambient_lists as r on l.list = r.list;
let merged_type_parameters = select l.id as id, l.name as name from firsts as l join ambient_type_parameters as r on l.id = r.id where l.kind = "type-parameter";
let loop_declarations = select child as declarator, parent as declaration from edges where kind = "variable-declaration" and field = "declarations";
let loop_lefts = select child as declaration, parent as loop from edges where (kind = "for-in-statement" or kind = "for-of-statement") and field = "left";
let loop_bodies = select l.child as body, l.parent as loop, r.kind as kind from edges as l join "semantic-syntax" as r on l.child = r.id where (l.kind = "for-in-statement" or l.kind = "for-of-statement") and l.field = "body";
let body_children = select l.parent as block, l.child as statement, l.ordinal as ordinal, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "body";
let blocks = select id from "semantic-syntax" where kind = "block-statement";
let block_statements = select l.block as block, l.statement as statement, l.ordinal as ordinal, l.kind as kind from body_children as l join blocks as r on l.block = r.id;
let later_statements = select l.block as block, l.statement as statement from block_statements as l join block_statements as r on l.block = r.block where l.ordinal > r.ordinal;
let first_statements = antijoin(left=block_statements, right=later_statements, left-on=["block", "statement"], right-on=["block", "statement"]);
let returning_blocks = select block from first_statements where kind = "return-statement";
let direct_returns = select loop from loop_bodies where kind = "return-statement";
let block_returns = select l.loop as loop from loop_bodies as l join returning_blocks as r on l.body = r.block;
let returning_loops = union(left=direct_returns, right=block_returns);
let returning_lefts = select l.declaration as declaration from loop_lefts as l join returning_loops as r on l.loop = r.loop;
let returning_declarators = select l.declarator as id from loop_declarations as l join returning_lefts as r on l.declaration = r.declaration;
let loop_variables = select l.id as id, l.name as name from firsts as l join returning_declarators as r on l.id = r.id;
let parameters = select id, kind, refinement, ordinal, owner from "parameter";
let signature_owners = select id from "semantic-syntax" where kind = "ts-declare-function" or kind = "ts-empty-body-function-expression";
let member_marks = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "identifier-token" and (r.text = "set" or r.text = "override");
let marked_members = select l.child as id from edges as l join member_marks as r on l.parent = r.id where (l.kind = "method-definition" or l.kind = "property") and l.field = "value";
let exempt_owners = union(left=signature_owners, right=marked_members);
let exempt_parameters = select l.id as id from parameters as l join exempt_owners as r on l.owner = r.id;
let modified_parameters = select id from parameters where refinement = "ts-parameter-property";
let pattern_defaults = select l.parent as id from edges as l join "semantic-syntax" as r on l.child = r.id where l.kind = "assignment-pattern" and l.field = "left" and (r.kind = "object-pattern" or r.kind = "array-pattern");
let plain_patterns = select id from parameters where refinement = "object-pattern" or refinement = "array-pattern" or refinement = "rest-element" or kind = "receiver";
let not_positional = union(left=plain_patterns, right=pattern_defaults);
let positional = antijoin(left=parameters, right=not_positional, left-on=["id"], right-on=["id"]);
let used_parameters = select l.id as id from parameters as l join used as r on l.id = r.id;
let keeping = union(left=used_parameters, right=modified_parameters);
let keepers = select l.owner as owner, l.ordinal as ordinal from parameters as l join keeping as r on l.id = r.id where l.refinement != "rest-element";
let covered = select l.id as id from positional as l join keepers as r on l.owner = r.owner where r.ordinal > l.ordinal;
let allowed_parameters_a = union(left=exempt_parameters, right=modified_parameters);
let allowed_parameters = union(left=allowed_parameters_a, right=covered);
let parameter_rows = select l.id as id, l.name as name from firsts as l join allowed_parameters as r on l.id = r.id where l.kind = "parameter";
let factories = select id, name from firsts where kind = "import" and (name = "React" or name = "h") and glob_any(file, "**/*.tsx");
let allowed_a = union(left=named_ignored, right=declared_classes);
let allowed_b = union(left=allowed_a, right=declared_functions);
let allowed_c = union(left=allowed_b, right=module_functions);
let allowed_d = union(left=allowed_c, right=module_types);
let allowed_e = union(left=allowed_d, right=declared_namespaces);
let allowed_f = union(left=allowed_e, right=dotted_outer);
let allowed_g = union(left=allowed_f, right=dotted_inner);
let allowed_h = union(left=allowed_g, right=global_symbols);
let allowed_i = union(left=allowed_h, right=merged_type_parameters);
let allowed_j = union(left=allowed_i, right=loop_variables);
let allowed_k = union(left=allowed_j, right=parameter_rows);
let allowed = union(left=allowed_k, right=factories);
let reported = antijoin(left=firsts, right=allowed, left-on=["id", "name"], right-on=["id", "name"]);
let reported_bounds = span-bounds(from=reported, span="span", start-output="begin", end-output="finish");
let token_bounds = span-bounds(from=tokens, span="span", start-output="tbegin", end-output="tfinish");
let found = select r.id as id, l.file as file, r.span as span from reported_bounds as l join token_bounds as r on l.file = r.file and l.begin = r.tbegin;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unused-vars(?:,|$)");
emit violations subject file key(id);
