import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let assignments = select l.id as id from operators as l join "semantic-syntax" as r on l.id = r.id where r.kind = "assignment-expression" and (l.operator = "=" or l.operator = "||=" or l.operator = "&&=" or l.operator = "??=");
let lefts = select l.id as assignment, c.child as id from assignments as l join "semantic-child" as c on l.id = c.parent where c.field = "left";
let rights = select l.id as assignment, c.child as id from assignments as l join "semantic-child" as c on l.id = c.parent where c.field = "right";
let left_names = select l.assignment as assignment, r.name as name from lefts as l join names as r on l.id = r.id;
let right_names = select l.assignment as assignment, l.id as id, r.name as name from rights as l join names as r on l.id = r.id;
let same_identifiers = select r.id as id from left_names as l join right_names as r on l.assignment = r.assignment and l.name = r.name;
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and (r.text = "[" or r.text = "?.");
let members = select id from "semantic-syntax" where kind = "member-expression";
let static_members = antijoin(left=members, right=computed, left-on=["id"], right-on=["id"]);
let thises = select id from "semantic-syntax" where kind = "this-expression";
let object_names = select l.parent as id, r.name as object from "semantic-child" as l join names as r on l.child = r.id where l.field = "object";
let object_thises = select l.parent as id from "semantic-child" as l join thises as r on l.child = r.id where l.field = "object";
let property_names = select l.parent as id, r.name as property from "semantic-child" as l join names as r on l.child = r.id where l.field = "property";
let named_paths = select l.id as id, l.object as object, r.property as property from object_names as l join property_names as r on l.id = r.id;
let this_paths = select l.id as id, r.property as property from object_thises as l join property_names as r on l.id = r.id;
let static_named = select l.id as id, l.object as object, l.property as property from named_paths as l join static_members as r on l.id = r.id;
let static_this = select l.id as id, l.property as property from this_paths as l join static_members as r on l.id = r.id;
let left_named = select l.assignment as assignment, r.object as object, r.property as property from lefts as l join static_named as r on l.id = r.id;
let right_named = select l.assignment as assignment, l.id as id, r.object as object, r.property as property from rights as l join static_named as r on l.id = r.id;
let same_named = select r.id as id from left_named as l join right_named as r on l.assignment = r.assignment and l.object = r.object and l.property = r.property;
let left_this = select l.assignment as assignment, r.property as property from lefts as l join static_this as r on l.id = r.id;
let right_this = select l.assignment as assignment, l.id as id, r.property as property from rights as l join static_this as r on l.id = r.id;
let same_this = select r.id as id from left_this as l join right_this as r on l.assignment = r.assignment and l.property = r.property;
let left_arrays = select l.assignment as assignment, l.id as array from lefts as l join "semantic-syntax" as r on l.id = r.id where r.kind = "array-pattern";
let right_arrays = select l.assignment as assignment, l.id as array from rights as l join "semantic-syntax" as r on l.id = r.id where r.kind = "array-expression";
let paired_arrays = select l.array as left_array, r.array as right_array from left_arrays as l join right_arrays as r on l.assignment = r.assignment;
let elements = select parent as array, child as id, ordinal from "semantic-child" where field = "elements";
let element_names = select l.array as array, l.id as id, l.ordinal as ordinal, r.name as name from elements as l join names as r on l.id = r.id;
let left_elements = select r.right_array as right_array, l.ordinal as ordinal, l.name as name from element_names as l join paired_arrays as r on l.array = r.left_array;
let same_elements = select r.id as id from left_elements as l join element_names as r on l.right_array = r.array and l.ordinal = r.ordinal and l.name = r.name;
let left_objects = select l.assignment as assignment, l.id as object from lefts as l join "semantic-syntax" as r on l.id = r.id where r.kind = "object-pattern";
let right_objects = select l.assignment as assignment, l.id as object from rights as l join "semantic-syntax" as r on l.id = r.id where r.kind = "object-expression";
let paired_objects = select l.object as left_object, r.object as right_object from left_objects as l join right_objects as r on l.assignment = r.assignment;
let properties = select parent as object, child as id from "semantic-child" where field = "properties";
let colons = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = ":";
let shorthand = antijoin(left=properties, right=colons, left-on=["id"], right-on=["id"]);
let key_names = select l.parent as property, r.name as name from "semantic-child" as l join names as r on l.child = r.id where l.field = "key";
let shorthand_named = select l.object as object, l.id as property, r.name as name from shorthand as l join key_names as r on l.id = r.property;
let left_shorthand = select r.right_object as right_object, l.name as name from shorthand_named as l join paired_objects as r on l.object = r.left_object;
let values = select parent as property, child as id from "semantic-child" where field = "value";
let right_shorthand = select l.object as object, l.name as name, r.id as id from shorthand_named as l join values as r on l.property = r.property;
let same_shorthand = select r.id as id from left_shorthand as l join right_shorthand as r on l.right_object = r.object and l.name = r.name;
let same_paths = union(left=same_named, right=same_this);
let same_values = union(left=same_identifiers, right=same_paths);
let same_destructured = union(left=same_elements, right=same_shorthand);
let same = union(left=same_values, right=same_destructured);
let found = select r.id as id, r.file as file, r.span as span from same as l join "semantic-syntax" as r on l.id = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-self-assign(?:,|$)");
emit violations subject file key(id);
