import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let wrapper_names = select l.id as id, l.file as file, l.span as span, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "BigInt" or r.text = "Boolean" or r.text = "Number" or r.text = "Object" or r.text = "String" or r.text = "Symbol";
let references = select id from "semantic-syntax" where kind = "ts-type-reference";
let reference_names_all = select l.parent as reference, r.id as id, r.file as file, r.span as span, r.name as name from "semantic-child" as l join wrapper_names as r on l.child = r.id where l.field = "type-name";
let wrapper_rows = select l.reference as reference, l.id as id, l.file as file, l.span as span, l.name as name from reference_names_all as l join references as r on l.reference = r.id;
let typed = select l.reference as reference, l.id as id, l.file as file, l.span as span from reference_names_all as l join references as r on l.reference = r.id;
let resolved = select occurrence from "resolves";
let unresolved_types = antijoin(left=typed, right=resolved, left-on=["reference"], right-on=["occurrence"]);
let conditionals = select id from "semantic-syntax" where kind = "ts-conditional-type";
let extends_types = select l.child as id, l.parent as conditional from "semantic-child" as l join conditionals as r on l.parent = r.id where l.field = "extends-type";
let true_types = select l.child as id, l.parent as conditional from "semantic-child" as l join conditionals as r on l.parent = r.id where l.field = "true-type";
let infers = select id, file, span from "semantic-syntax" where kind = "ts-infer-type";
let inferred_parameters = select l.parent as infer, l.child as parameter from "semantic-child" as l join infers as r on l.parent = r.id where l.field = "type-parameter";
let extends_ids = select id from extends_types;
let infer_scopes = axis(from=infers, relation="semantic-child", direction=ancestor, domain=extends_ids);
let scoped_infers = select l.id as infer, r.conditional as conditional from infer_scopes as l join extends_types as r on l.related = r.id;
let direct_infers = select l.id as infer, r.conditional as conditional from infers as l join extends_types as r on l.id = r.id;
let infer_conditionals = union(left=scoped_infers, right=direct_infers);
let parameter_rows = select l.infer as infer, r.id as id, r.file as file, r.span as span from inferred_parameters as l join "semantic-syntax" as r on l.parameter = r.id;
let parameter_names = select l.infer as infer, r.text as name from parameter_rows as l join tokens as r on l.file = r.file and l.span = r.span;
let inferred = select l.conditional as conditional, r.name as name from infer_conditionals as l join parameter_names as r on l.infer = r.infer;
let unresolved_rows = select reference as id, file, span from unresolved_types;
let true_ids = select id from true_types;
let reference_scopes = axis(from=unresolved_rows, relation="semantic-child", direction=ancestor, domain=true_ids);
let scoped_references = select l.id as reference, r.conditional as conditional from reference_scopes as l join true_types as r on l.related = r.id;
let direct_references = select l.id as reference, r.conditional as conditional from unresolved_rows as l join true_types as r on l.id = r.id;
let reference_conditionals = union(left=scoped_references, right=direct_references);
let reference_names = select l.reference as reference, l.conditional as conditional, r.name as name from reference_conditionals as l join wrapper_rows as r on l.reference = r.reference;
let infer_bound = select l.reference as reference from reference_names as l join inferred as r on l.conditional = r.conditional and l.name = r.name;
let free_types = antijoin(left=unresolved_types, right=infer_bound, left-on=["reference"], right-on=["reference"]);
let type_hits = select id, file, span from free_types;
let heritages = select id from "semantic-syntax" where kind = "ts-class-implements" or kind = "ts-interface-heritage";
let heritage_names = select l.parent as heritage, r.id as id, r.file as file, r.span as span, r.name as name from "semantic-child" as l join wrapper_names as r on l.child = r.id where l.field = "expression";
let inherited = select l.heritage as heritage, l.id as id, l.file as file, l.span as span, l.name as name from heritage_names as l join heritages as r on l.heritage = r.id;
let type_bindings = select owner, name from "defines" where kind = "class" or kind = "interface" or kind = "type" or kind = "type-alias" or kind = "type-parameter" or kind = "enum" or kind = "import";
let binding_owners = select owner as id from type_bindings;
let inherited_rows = select id, file, span from inherited;
let enclosing = axis(from=inherited_rows, relation="semantic-child", direction=ancestor, domain=binding_owners);
let enclosing_names = select l.id as id, l.related as owner, r.name as name from enclosing as l join inherited as r on l.id = r.id;
let bound = select l.id as id from enclosing_names as l join type_bindings as r on l.owner = r.owner and l.name = r.name;
let unbound = antijoin(left=inherited_rows, right=bound, left-on=["id"], right-on=["id"]);
let found = union(left=type_hits, right=unbound);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-wrapper-object-types(?:,|$)");
emit violations subject file key(id);
