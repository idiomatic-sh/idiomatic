import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constant_values from "typescript/oxlint/constant-values";
let reads = select reference, name, state, file from "binding-read";
let references = select reference, file from reads;
let values = constant_values(references=references);
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let identifier_values = select l.reference as reference, r.id as value, r.file as file, r.span as span from values as l join identifiers as r on l.value = r.id;
let value_rows = select value as id, file, span from identifier_values;
let wrapped_values = parenthesized(candidates=value_rows);
let aliases = antijoin(left=identifier_values, right=wrapped_values, left-on=["value"], right-on=["id"]);
let alias_edges = select reference, value from aliases;
let aliased = closure(edges=alias_edges, source="reference", destination="value");
let objects = select reference from reads where (state = "builtin" or state = "unbound") and (name = "Atomics" or name = "Intl" or name = "JSON" or name = "Math" or name = "Reflect");
let reached = select l.reference as reference from aliased as l join objects as r on l.value = r.reference;
let resolved = union(left=objects, right=reached);
let calls = select id, file, span from "semantic-syntax" where kind = "call-expression" or kind = "new-expression";
let call_callees = select l.parent as call, l.child as callee from "semantic-child" as l join calls as r on l.parent = r.id where l.field = "callee";
let callee_rows = select l.call as call, r.id as id, r.kind as kind, r.file as file, r.span as span from call_callees as l join "semantic-syntax" as r on l.callee = r.id;
let callee_candidates = select id, file, span from callee_rows;
let wrapped_callees = parenthesized(candidates=callee_candidates);
let bare_callees = antijoin(left=callee_rows, right=wrapped_callees, left-on=["id"], right-on=["id"]);
let identifier_hits = select l.call as call from bare_callees as l join resolved as r on l.id = r.reference where l.kind = "identifier";
let members = select call, id from bare_callees where kind = "member-expression";
let member_objects = select l.call as call, l.id as member, r.child as object from members as l join "semantic-child" as r on l.id = r.parent where r.field = "object";
let global_members = select l.call as call, l.member as member from member_objects as l join reads as r on l.object = r.reference where r.name = "globalThis";
let member_properties = select l.call as call, l.member as member, r.child as property from global_members as l join "semantic-child" as r on l.member = r.parent where r.field = "property";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let static_properties = antijoin(left=member_properties, right=computed, left-on=["member"], right-on=["id"]);
let static_rows = select l.call as call, r.file as file, r.span as span from static_properties as l join identifiers as r on l.property = r.id;
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let static_hits = select l.call as call from static_rows as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "Atomics" or r.text = "Intl" or r.text = "JSON" or r.text = "Math" or r.text = "Reflect";
let computed_properties = select l.call as call, l.property as property from member_properties as l join computed as r on l.member = r.id;
let string_hits = select l.call as call from computed_properties as l join "string-literal" as r on l.property = r.occurrence where r.value = "Atomics" or r.value = "Intl" or r.value = "JSON" or r.value = "Math" or r.value = "Reflect";
let computed_rows = select l.call as call, r.file as file, r.span as span from computed_properties as l join "semantic-syntax" as r on l.property = r.id where r.kind = "template-literal";
let templates = select file, span, text from "semantic-syntax" where kind = "template";
let template_hits = select l.call as call from computed_rows as l join templates as r on l.file = r.file and l.span = r.span where matches(r.text, "^\x60(?:Atomics|Intl|JSON|Math|Reflect)\x60$");
let named_a = union(left=identifier_hits, right=static_hits);
let named_b = union(left=named_a, right=string_hits);
let named = union(left=named_b, right=template_hits);
let found = select r.id as id, r.file as file, r.span as span from named as l join calls as r on l.call = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-obj-calls(?:,|$)");
emit violations subject file key(id);
