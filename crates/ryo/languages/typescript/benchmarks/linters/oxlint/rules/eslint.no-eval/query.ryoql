import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let eval_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "eval";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let callee_edges = select l.child as id from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "callee";
let callees = select r.id as id, r.file as file, r.span as span from callee_edges as l join "semantic-syntax" as r on l.id = r.id;
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let direct = select id as outer, id as inner from callees;
let reached = select l.id as outer, r.inner as inner from callees as l join unwrapped as r on l.id = r.outer;
let inner = union(left=direct, right=reached);
let eval_callees = select l.outer as id from inner as l join eval_names as r on l.inner = r.id;
let called = select l.id as id, l.file as file, l.span as span from callees as l join eval_callees as r on l.id = r.id;
let wraps = parenthesized(candidates=called);
let outer_wraps = select l.id as id, l.level as level from wraps as l join wraps as r on l.id = r.id where r.level > l.level;
let outermost = antijoin(left=wraps, right=outer_wraps, left-on=["id", "level"], right-on=["id", "level"]);
let wrapped_hits = select id, file, wrap as span from outermost;
let bare = antijoin(left=called, right=wraps, left-on=["id"], right-on=["id"]);
let found = union(left=bare, right=wrapped_hits);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-eval(?:,|$)");
emit violations subject file key(id);
