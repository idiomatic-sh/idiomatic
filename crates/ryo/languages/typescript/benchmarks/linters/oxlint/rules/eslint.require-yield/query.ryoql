import directives from "typescript/oxlint/eslint-directives";
let functions = select id, file, span from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression";
let scopes = select id from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression";
let stars = select l.parent as owner from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "*";
let own_stars = select l.id as id from functions as l join stars as r on l.id = r.owner;
let methods = select l.parent as owner, l.child as id from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "value" and (r.kind = "method-definition" or r.kind = "property");
let method_stars = select l.id as id from methods as l join stars as r on l.owner = r.owner;
let generator_ids = union(left=own_stars, right=method_stars);
let generators = select l.id as id, l.file as file, l.span as span from functions as l join generator_ids as r on l.id = r.id;
let bodies = select l.parent as id, l.child as body from "semantic-child" as l join generators as r on l.parent = r.id where l.field = "body";
let statements = select l.id as id from bodies as l join "semantic-child" as c on l.body = c.parent where c.field = "body";
let filled = select l.id as id, l.file as file, l.span as span from generators as l join statements as r on l.id = r.id;
let yields = select id from "semantic-syntax" where kind = "yield-expression";
let yield_owners = axis(from=yields, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let yielding = select related as id from yield_owners;
let missing = antijoin(left=filled, right=yielding, left-on=["id"], right-on=["id"]);
let names = select l.parent as id, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "id";
let named_hits = select r.id as id, r.file as file, r.span as span from missing as l join names as r on l.id = r.id;
let anonymous = antijoin(left=missing, right=names, left-on=["id"], right-on=["id"]);
let found = union(left=named_hits, right=anonymous);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?require-yield(?:,|$)");
emit violations subject file key(id);
