import directives from "typescript/oxlint/eslint-directives";
import parenthesized from "typescript/oxlint/parenthesized";
import constness from "typescript/oxlint/constness";
let owners = select id, kind from "semantic-syntax" where kind = "if-statement" or kind = "conditional-expression" or kind = "while-statement" or kind = "do-while-statement" or kind = "for-statement";
let tests = select l.parent as owner, r.kind as kind, l.child as id from "semantic-child" as l join owners as r on l.parent = r.id where l.field = "test";
let test_rows = select l.id as id, r.file as file, r.span as span from tests as l join "semantic-syntax" as r on l.id = r.id;
let constant = constness(candidates=test_rows);
let constant_tests = select l.owner as owner, l.kind as kind, l.id as id from tests as l join constant as r on l.id = r.id;
let wraps = parenthesized(candidates=test_rows);
let true_literals = select r.id as id from "semantic-syntax" as l join "semantic-syntax" as r on l.file = r.file and l.span = r.span where l.kind = "boolean" and l.text = "true" and r.kind = "literal";
let wrapped_ids = select id from wraps;
let bare_true = antijoin(left=true_literals, right=wrapped_ids, left-on=["id"], right-on=["id"]);
let while_true = select l.id as id from constant_tests as l join bare_true as r on l.id = r.id where l.kind = "while-statement";
let checked = antijoin(left=constant_tests, right=while_true, left-on=["id"], right-on=["id"]);
let loops = select owner as id, id as test from checked where kind = "while-statement" or kind = "do-while-statement" or kind = "for-statement";
let loop_rows = select l.id as id, l.test as test, r.file as file, r.span as span from loops as l join "semantic-syntax" as r on l.id = r.id;
let functions = select id from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression";
let loop_functions = axis(from=loop_rows, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let stars = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "*";
let own_generators = select l.id as id from functions as l join stars as r on l.id = r.id;
let method_values = select l.child as id, l.parent as method from "semantic-child" as l join "semantic-syntax" as r on l.parent = r.id where l.field = "value" and (r.kind = "method-definition" or r.kind = "property");
let method_generators = select l.id as id from method_values as l join stars as r on l.method = r.id;
let generators = union(left=own_generators, right=method_generators);
let generator_loops = select l.id as id, l.test as test, l.related as function from loop_functions as l join generators as r on l.related = r.id;
let yields = select id, file, span from "semantic-syntax" where kind = "yield-expression";
let scopes = select id from "semantic-syntax" where kind = "function-declaration" or kind = "function-expression" or kind = "arrow-function-expression";
let yield_scopes = axis(from=yields, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let loop_ids = select id from generator_loops;
let yield_loops = axis(from=yields, relation="semantic-child", direction=ancestor, domain=loop_ids);
let loop_yields = select l.related as loop, l.id as yield, r.related as function from yield_loops as l join yield_scopes as r on l.id = r.id;
let same_generator = select l.id as loop, l.test as test, r.yield as yield from generator_loops as l join loop_yields as r on l.id = r.loop and l.function = r.function;
let yield_rows = select l.loop as loop, l.test as test, r.span as span from same_generator as l join yields as r on l.yield = r.id;
let yield_bounds = span-bounds(from=yield_rows, span="span", start-output="begin", end-output="finish");
let test_bounds_rows = select l.loop as loop, l.begin as begin, r.span as test_span from yield_bounds as l join "semantic-syntax" as r on l.test = r.id;
let test_bounds = span-bounds(from=test_bounds_rows, span="test_span", start-output="tbegin", end-output="tfinish");
let fors = select id from "semantic-syntax" where kind = "for-statement";
let for_yields = select l.loop as loop from test_bounds as l join fors as r on l.loop = r.id where l.begin > l.tbegin;
let other_yields_all = select loop from yield_bounds;
let other_yields = antijoin(left=other_yields_all, right=fors, left-on=["loop"], right-on=["id"]);
let yielding = union(left=for_yields, right=other_yields);
let exempt = select l.test as id from generator_loops as l join yielding as r on l.id = r.loop;
let reported = antijoin(left=checked, right=exempt, left-on=["id"], right-on=["id"]);
let outer_wraps = select l.id as id, l.level as level from wraps as l join wraps as r on l.id = r.id where r.level > l.level;
let outermost = antijoin(left=wraps, right=outer_wraps, left-on=["id", "level"], right-on=["id", "level"]);
let wrapped_spans = select l.id as id, r.file as file, r.wrap as span from reported as l join outermost as r on l.id = r.id;
let bare_reported = antijoin(left=reported, right=outermost, left-on=["id"], right-on=["id"]);
let bare_spans = select l.id as id, r.file as file, r.span as span from bare_reported as l join test_rows as r on l.id = r.id;
let found = union(left=bare_spans, right=wrapped_spans);
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-constant-condition(?:,|$)");
emit violations subject file key(id);
