import directives from "typescript/oxlint/eslint-directives";
let dead = select block, file from "flow-block" where live = "false";
let dead_steps = select l.node as id from "flow-step" as l join dead as r on l.block = r.block and l.file = r.file where l."step-kind" in ["statement", "return", "return-undefined", "break", "break-labeled", "continue", "continue-labeled", "throw"];
let statements = select r.id as id, r.kind as kind, r.file as file, r.span as span from dead_steps as l join "semantic-syntax" as r on l.id = r.id where r.kind in ["block-statement", "break-statement", "continue-statement", "debugger-statement", "expression-statement", "labeled-statement", "return-statement", "switch-statement", "throw-statement", "try-statement", "with-statement", "if-statement", "variable-declaration", "export-default-declaration", "for-statement", "for-in-statement", "for-of-statement", "while-statement", "do-while-statement"];
let declarations = select id from statements where kind = "variable-declaration";
let declaration_parts = select l.id as id, c.child as child from declarations as l join "semantic-child" as c on l.id = c.parent;
let var_declarations = select l.id as id from declaration_parts as l join "semantic-syntax" as r on l.child = r.id where r.kind = "keyword" and r.text = "var";
let var_declarators = select l.id as id, d.child as declarator from var_declarations as l join "semantic-child" as d on l.id = d.parent where d.field = "declarations";
let initialized = select l.id as id from var_declarators as l join "semantic-child" as i on l.declarator = i.parent where i.field = "init";
let bare_vars = antijoin(left=var_declarations, right=initialized, left-on=["id"], right-on=["id"]);
let reportable = antijoin(left=statements, right=bare_vars, left-on=["id"], right-on=["id"]);
let reportable_ids = select id from reportable;
let reportable_files = project(from=reportable, columns=["file"]);
let cuts = select l.id as id from "semantic-syntax" as l join reportable_files as r on l.file = r.file where l.kind = "function-declaration" or l.kind = "function-expression" or l.kind = "arrow-function-expression" or l.kind = "static-block";
let stops = union(left=reportable_ids, right=cuts);
let nearest = axis(from=reportable, relation="semantic-child", direction=nearest-ancestor, domain=stops);
let covered = select l.id as id from nearest as l join reportable_ids as r on l.related = r.id;
let outermost = antijoin(left=reportable, right=covered, left-on=["id"], right-on=["id"]);
let found = select id, file, span from outermost;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unreachable(?:,|$)");
emit violations subject file key(id);
