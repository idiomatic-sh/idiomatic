import directives from "typescript/oxlint/eslint-directives";
let dead = select block, file from "flow-block" where live = "false";
let dead_steps = select l.node as id from "flow-step" as l join dead as r on l.block = r.block and l.file = r.file where l."step-kind" = "statement" or l."step-kind" = "return" or l."step-kind" = "return-undefined" or l."step-kind" = "break" or l."step-kind" = "break-labeled" or l."step-kind" = "continue" or l."step-kind" = "continue-labeled" or l."step-kind" = "throw";
let statements = select r.id as id, r.kind as kind, r.file as file, r.span as span from dead_steps as l join "semantic-syntax" as r on l.id = r.id where r.kind = "block-statement" or r.kind = "break-statement" or r.kind = "continue-statement" or r.kind = "debugger-statement" or r.kind = "expression-statement" or r.kind = "labeled-statement" or r.kind = "return-statement" or r.kind = "switch-statement" or r.kind = "throw-statement" or r.kind = "try-statement" or r.kind = "with-statement" or r.kind = "if-statement" or r.kind = "variable-declaration" or r.kind = "export-default-declaration" or r.kind = "for-statement" or r.kind = "for-in-statement" or r.kind = "for-of-statement" or r.kind = "while-statement" or r.kind = "do-while-statement";
let declarations = select id from statements where kind = "variable-declaration";
let declaration_parts = select l.id as id, c.child as child from declarations as l join "semantic-child" as c on l.id = c.parent;
let var_declarations = select l.id as id from declaration_parts as l join "semantic-syntax" as r on l.child = r.id where r.kind = "keyword" and r.text = "var";
let var_declarators = select l.id as id, d.child as declarator from var_declarations as l join "semantic-child" as d on l.id = d.parent where d.field = "declarations";
let initialized = select l.id as id from var_declarators as l join "semantic-child" as i on l.declarator = i.parent where i.field = "init";
let bare_vars = antijoin(left=var_declarations, right=initialized, left-on=["id"], right-on=["id"]);
let reportable = antijoin(left=statements, right=bare_vars, left-on=["id"], right-on=["id"]);
let dead_members = select l.node as id from "flow-member" as l join dead as r on l.block = r.block and l.file = r.file;
let dead_parents = select l.parent as parent, l.child as child from "semantic-child" as l join dead_members as r on l.parent = r.id;
let dead_edges = select l.parent as parent, l.child as child from dead_parents as l join dead_members as r on l.child = r.id;
let kinded_edges = select l.parent as parent, l.child as child, r.kind as kind from dead_edges as l join "semantic-syntax" as r on l.parent = r.id;
let inner_edges = select parent, child from kinded_edges where kind != "function-declaration" and kind != "function-expression" and kind != "arrow-function-expression" and kind != "static-block";
let descendants = closure(edges=inner_edges, source="parent", destination="child");
let covered = select l.child as id from descendants as l join reportable as r on l.parent = r.id;
let outermost = antijoin(left=reportable, right=covered, left-on=["id"], right-on=["id"]);
let found = select id, file, span from outermost;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-unreachable(?:,|$)");
emit violations subject file key(id);
