import directives from "typescript/oxlint/eslint-directives";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let promise_names = select l.id as id from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "Promise";
let method_names = select l.id as id, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span where r.text = "all" or r.text = "allSettled" or r.text = "any" or r.text = "race";
let wrappers = select id from "semantic-syntax" where kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join wrappers as r on l.parent = r.id where l.field = "expression";
let unwrapped = closure(edges=unwrapping, source="outer", destination="inner");
let chains = select id from "semantic-syntax" where kind = "chain-expression" or kind = "ts-as-expression" or kind = "ts-satisfies-expression" or kind = "ts-instantiation-expression" or kind = "ts-non-null-expression" or kind = "ts-type-assertion";
let chain_unwrapping = select l.parent as outer, l.child as inner from "semantic-child" as l join chains as r on l.parent = r.id where l.field = "expression";
let chain_unwrapped = closure(edges=chain_unwrapping, source="outer", destination="inner");
let optional = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "?.";
let computed = select l.parent as id from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "punctuator" and r.text = "[";
let calls = select id from "semantic-syntax" where kind = "call-expression";
let plain_calls = antijoin(left=calls, right=optional, left-on=["id"], right-on=["id"]);
let arguments = select l.parent as id, l.child as argument from "semantic-child" as l join plain_calls as r on l.parent = r.id where l.field = "arguments";
let counts = group-count(from=arguments, keys=["id"], count="arguments");
let single = select l.id as id, l.argument as argument from arguments as l join counts as r on l.id = r.id where r.arguments = 1;
let callees = select l.parent as id, l.child as callee from "semantic-child" as l join single as r on l.parent = r.id where l.field = "callee";
let direct_callees = select id, callee as inner from callees;
let reached_callees = select l.id as id, r.inner as inner from callees as l join chain_unwrapped as r on l.callee = r.outer;
let inner_callees = union(left=direct_callees, right=reached_callees);
let members = select l.id as id, l.inner as member from inner_callees as l join "semantic-syntax" as r on l.inner = r.id where r.kind = "member-expression";
let plain_members = antijoin(left=members, right=optional, left-on=["member"], right-on=["id"]);
let static_members = antijoin(left=plain_members, right=computed, left-on=["member"], right-on=["id"]);
let properties = select l.parent as member, r.name as name from "semantic-child" as l join method_names as r on l.child = r.id where l.field = "property";
let methods = select l.id as id, l.member as member from static_members as l join properties as r on l.member = r.member;
let objects = select l.parent as member, l.child as object from "semantic-child" as l join methods as r on l.parent = r.member where l.field = "object";
let direct_objects = select member, object as inner from objects;
let reached_objects = select l.member as member, r.inner as inner from objects as l join unwrapped as r on l.object = r.outer;
let inner_objects = union(left=direct_objects, right=reached_objects);
let promise_members = select l.member as member from inner_objects as l join promise_names as r on l.inner = r.id;
let promise_calls = select l.id as id from methods as l join promise_members as r on l.member = r.member;
let call_arrays = select l.argument as array from single as l join promise_calls as r on l.id = r.id;
let arrays = select l.array as array from call_arrays as l join "semantic-syntax" as r on l.array = r.id where r.kind = "array-expression";
let elements = select l.child as element from "semantic-child" as l join arrays as r on l.parent = r.array where l.field = "elements";
let awaits = select r.id as id from elements as l join "semantic-syntax" as r on l.element = r.id where r.kind = "await-expression";
let await_keywords = select l.parent as owner, r.id as id, r.file as file, r.span as span from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.text = "await" and (r.kind = "keyword" or r.kind = "identifier-token");
let found = select l.id as id, l.file as file, l.span as span from await_keywords as l join awaits as r on l.owner = r.id;
let violations = directives(candidates=found, names="(?:^|,)(?:[^,]*/)?no-await-in-promise-methods(?:,|$)");
emit violations subject file key(id);
