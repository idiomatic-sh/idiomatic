input candidates: relation<id: node, file: file, span: span>;
output relation<id: node, file: file, span: span, level: number, wrap: span>;
let parents = select l.parent as parent, r.id as id, r.file as file, r.span as span from "semantic-child" as l join candidates as r on l.child = r.id;
let parent_rows = select l.parent as parent, r.kind as kind from parents as l join "semantic-syntax" as r on l.parent = r.id;
let parent_children = select l.parent as parent, l.kind as kind, c.child as child, c.field as field from parent_rows as l join "semantic-child" as c on l.parent = c.parent;
let child_rows = select l.parent as parent, l.kind as kind, l.child as child, l.field as field, r.kind as child_kind, r.text as text, r.span as span from parent_children as l join "semantic-syntax" as r on l.child = r.id;
let child_bounds = span-bounds(from=child_rows, span="span", start-output="begin", end-output="finish");
let statement_opens = select parent, child, begin from child_bounds where child_kind = "punctuator" and text = "(" and (kind = "if-statement" or kind = "while-statement" or kind = "do-while-statement" or kind = "switch-statement" or kind = "with-statement" or kind = "for-statement" or kind = "for-in-statement" or kind = "for-of-statement" or kind = "catch-clause" or kind = "import-expression");
let callee_ends = select parent, finish from child_bounds where (kind = "call-expression" or kind = "new-expression") and (field = "callee" or field = "type-arguments");
let call_opens_all = select l.parent as parent, l.child as child, l.begin as begin from child_bounds as l join callee_ends as r on l.parent = r.parent where l.child_kind = "punctuator" and l.text = "(" and l.begin >= r.finish;
let call_opens = project(from=call_opens_all, columns=["parent", "child", "begin"]);
let syntax_opens_all = union(left=statement_opens, right=call_opens);
let later_opens = select l.parent as parent, l.child as child from syntax_opens_all as l join syntax_opens_all as r on l.parent = r.parent where l.begin > r.begin;
let syntax_opens = antijoin(left=syntax_opens_all, right=later_opens, left-on=["parent", "child"], right-on=["parent", "child"]);
let syntax_owners = select parent from syntax_opens;
let closes_all = select l.parent as parent, l.child as child, l.begin as begin from child_bounds as l join syntax_owners as r on l.parent = r.parent where l.child_kind = "punctuator" and l.text = ")";
let earlier_closes = select l.parent as parent, l.child as child from closes_all as l join closes_all as r on l.parent = r.parent where l.begin < r.begin;
let syntax_closes = antijoin(left=closes_all, right=earlier_closes, left-on=["parent", "child"], right-on=["parent", "child"]);
let syntax_open_ids = select child as id from syntax_opens;
let syntax_close_ids = select child as id from syntax_closes;
let syntax = union(left=syntax_open_ids, right=syntax_close_ids);
let siblings = select l.id as id, l.file as file, l.span as span, s.child as sibling from parents as l join "semantic-child" as s on l.parent = s.parent;
let sibling_rows = select l.id as id, l.file as file, l.span as span, l.sibling as sibling, r.kind as kind, r.text as text, r.span as other from siblings as l join "semantic-syntax" as r on l.sibling = r.id where r.kind != "whitespace" and r.kind != "line" and r.kind != "block";
let sibling_starts = span-bounds(from=sibling_rows, span="span", start-output="begin", end-output="finish");
let sibling_bounds = span-bounds(from=sibling_starts, span="other", start-output="obegin", end-output="ofinish");
let before = select id, file, span, sibling, kind, text, other, obegin, ofinish, begin from sibling_bounds where ofinish <= begin;
let after = select id, file, span, sibling, kind, text, other, obegin, ofinish, finish from sibling_bounds where obegin >= finish;
let open_tokens = select id, file, span, sibling, other, obegin, ofinish from before where kind = "punctuator" and text = "(";
let opens = antijoin(left=open_tokens, right=syntax, left-on=["sibling"], right-on=["id"]);
let open_others = antijoin(left=before, right=opens, left-on=["id", "sibling"], right-on=["id", "sibling"]);
let open_blockers = select id, obegin as bbegin from open_others;
let blocked_opens = select l.id as id, l.obegin as obegin from opens as l join open_blockers as r on l.id = r.id where r.bbegin >= l.ofinish;
let open_run = antijoin(left=opens, right=blocked_opens, left-on=["id", "obegin"], right-on=["id", "obegin"]);
let open_ranks = select l.id as id, l.file as file, l.span as span, l.other as opening, l.obegin as obegin, r.obegin as ranked from open_run as l join open_run as r on l.id = r.id where r.obegin >= l.obegin;
let open_levels = group-count(from=open_ranks, keys=["id", "file", "span", "opening"], count="level");
let close_tokens = select id, sibling, other, obegin, ofinish from after where kind = "punctuator" and text = ")";
let closes = antijoin(left=close_tokens, right=syntax, left-on=["sibling"], right-on=["id"]);
let close_others = antijoin(left=after, right=closes, left-on=["id", "sibling"], right-on=["id", "sibling"]);
let close_blockers = select id, ofinish as bfinish from close_others;
let blocked_closes = select l.id as id, l.obegin as obegin from closes as l join close_blockers as r on l.id = r.id where r.bfinish <= l.obegin;
let close_run = antijoin(left=closes, right=blocked_closes, left-on=["id", "obegin"], right-on=["id", "obegin"]);
let close_ranks = select l.id as id, l.other as closing, l.obegin as obegin, r.obegin as ranked from close_run as l join close_run as r on l.id = r.id where r.obegin <= l.obegin;
let close_levels = group-count(from=close_ranks, keys=["id", "closing"], count="level");
let paired = select l.id as id, l.file as file, l.span as span, l.level as level, l.opening as opening, r.closing as closing from open_levels as l join close_levels as r on l.id = r.id and l.level = r.level;
let spanned = span-between(from=paired, start="opening", end="closing", output="wrap");
let wrapped = select id, file, span, level, wrap from spanned;
return wrapped;
