input candidates: relation<id: node, file: file, span: span>;
output relation<id: node, file: file, span: span>;
let nodes = select id, file, kind from "semantic-syntax";
let tokens = select file, span, text from "semantic-syntax" where kind = "identifier-token";
let identifiers = select id, file, span from "semantic-syntax" where kind = "identifier";
let names = select l.id as id, l.file as file, r.text as name from identifiers as l join tokens as r on l.file = r.file and l.span = r.span;
let declared_a = select file, name from "defines";
let declared_b = select file, name from "parameter";
let declared = union(left=declared_a, right=declared_b);
let undefined_names = select id, file, name from names where name = "undefined";
let global_undefined = antijoin(left=undefined_names, right=declared, left-on=["file", "name"], right-on=["file", "name"]);
let boolean_names = select id, file, name from names where name = "Boolean";
let global_boolean = antijoin(left=boolean_names, right=declared, left-on=["file", "name"], right-on=["file", "name"]);
let children = select l.parent as parent, l.child as child, l.field as field, l.ordinal as ordinal, r.kind as kind from "semantic-child" as l join nodes as r on l.parent = r.id;
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let operated = select l.parent as parent, l.child as child, l.field as field, l.kind as kind, r.operator as operator from children as l join operators as r on l.parent = r.id;
let binary_edges = select parent, child from operated where kind = "binary-expression" and operator != "in" and (field = "left" or field = "right");
let not_edges = select parent, child from operated where kind = "unary-expression" and operator = "!" and field = "argument";
let typeof_edges = select parent, child from operated where kind = "unary-expression" and operator = "typeof" and field = "argument";
let unary_edges = select parent, child from operated where kind = "unary-expression" and operator != "!" and operator != "typeof" and operator != "void" and field = "argument";
let logical_edges = select parent, child, field, operator from operated where kind = "logical-expression" and (field = "left" or field = "right");
let assign_edges = select parent, child from operated where kind = "assignment-expression" and operator = "=" and field = "right";
let sequence_parts = select parent, child, ordinal from children where kind = "sequence-expression" and field = "expressions";
let earlier_parts = select l.child as child from sequence_parts as l join sequence_parts as r on l.parent = r.parent where l.ordinal < r.ordinal;
let last_parts = antijoin(left=sequence_parts, right=earlier_parts, left-on=["child"], right-on=["child"]);
let sequence_edges = select parent, child from last_parts;
let calls = select id from "semantic-syntax" where kind = "call-expression";
let call_callees = select l.parent as id, r.id as callee from "semantic-child" as l join global_boolean as r on l.child = r.id where l.field = "callee";
let boolean_calls = select l.id as id from calls as l join call_callees as r on l.id = r.id;
let call_arguments = select l.parent as parent, l.child as child, l.ordinal as ordinal from "semantic-child" as l join boolean_calls as r on l.parent = r.id where l.field = "arguments";
let later_arguments = select l.child as child from call_arguments as l join call_arguments as r on l.parent = r.parent where l.ordinal > r.ordinal;
let first_arguments = antijoin(left=call_arguments, right=later_arguments, left-on=["child"], right-on=["child"]);
let boolean_edges = select parent, child from first_arguments;
let array_edges = select parent, child from children where kind = "array-expression" and field = "elements";
let template_edges = select parent, child from children where kind = "template-literal" and field = "expressions";
let spread_edges = select parent, child from children where kind = "spread-element" and field = "argument";
let to_value_a = union(left=binary_edges, right=unary_edges);
let to_value_b = union(left=to_value_a, right=typeof_edges);
let to_value_c = union(left=to_value_b, right=array_edges);
let to_value = union(left=to_value_c, right=template_edges);
let to_boolean = union(left=not_edges, right=boolean_edges);
let logical_pairs = select parent, child from logical_edges;
let keep_a = union(left=logical_pairs, right=assign_edges);
let keep_b = union(left=keep_a, right=sequence_edges);
let keep = union(left=keep_b, right=spread_edges);
let setting = union(left=to_value, right=to_boolean);
let edges = union(left=keep, right=setting);
let candidate_rows = select id from candidates;
let reach = closure(edges=edges, source="parent", destination="child");
let below = select l.id as root, r.child as node from candidate_rows as l join reach as r on l.id = r.parent;
let selves = select id as root, id as node from candidates;
let members = union(left=below, right=selves);
let member_nodes = select node from members;
let local_reach = select l.parent as parent, l.child as child from reach as l join member_nodes as r on l.child = r.node;
let spans = select l.root as root, l.node as node, r.child as inner from members as l join local_reach as r on l.node = r.parent;
let self_spans = select root, node, node as inner from members;
let path_pairs = union(left=spans, right=self_spans);
let strict_paths = select root, node, inner from path_pairs where node != root;
let value_setters = select child as id from to_value;
let boolean_setters = select child as id from to_boolean;
let setters = union(left=value_setters, right=boolean_setters);
let setter_paths = select l.root as root, l.node as setter, l.inner as inner from strict_paths as l join setters as r on l.node = r.id;
let setter_pairs = select l.root as root, l.setter as upper, r.setter as lower, l.inner as inner from setter_paths as l join setter_paths as r on l.root = r.root and l.inner = r.inner where l.setter != r.setter;
let shadowed = select l.root as root, l.upper as setter, l.inner as inner from setter_pairs as l join reach as r on l.upper = r.parent and l.lower = r.child;
let nearest = antijoin(left=setter_paths, right=shadowed, left-on=["root", "setter", "inner"], right-on=["root", "setter", "inner"]);
let value_nodes = select l.root as root, l.inner as node from nearest as l join value_setters as r on l.setter = r.id;
let boolean_set_nodes = select l.root as root, l.inner as node from nearest as l join boolean_setters as r on l.setter = r.id;
let unset = antijoin(left=members, right=nearest, left-on=["root", "node"], right-on=["root", "inner"]);
let boolean_nodes = union(left=boolean_set_nodes, right=unset);
let literal_nodes = select id, file, span from "semantic-syntax" where kind = "literal";
let literal_tokens = select l.id as id, r.kind as kind, r.text as text from literal_nodes as l join "semantic-syntax" as r on l.file = r.file and l.span = r.span where r.kind = "boolean" or r.kind = "null" or r.kind = "numeric" or r.kind = "string" or r.kind = "regular-expression";
let falsy_literals = select id from literal_tokens where (kind = "boolean" and text = "false") or kind = "null" or (kind = "string" and (text = "\x22\x22" or text = "''")) or (kind = "numeric" and matches(text, "^(?:0[xXbBoO][0_]+|0[0_]*(?:\.[0_]*)?(?:[eE][+-]?[0-9_]+)?|\.[0_]+(?:[eE][+-]?[0-9_]+)?)n?$"));
let all_literals = select id from literal_tokens;
let truthy_literals = antijoin(left=all_literals, right=falsy_literals, left-on=["id"], right-on=["id"]);
let voids = select id from operators where operator = "void";
let and_leaves = union(left=falsy_literals, right=voids);
let and_edges_logical = select parent, child from operated where kind = "logical-expression" and operator = "&&" and (field = "left" or field = "right");
let and_edges_assign = select parent, child from operated where kind = "assignment-expression" and operator = "&&=" and field = "right";
let and_edges = union(left=and_edges_logical, right=and_edges_assign);
let or_edges_logical = select parent, child from operated where kind = "logical-expression" and operator = "||" and (field = "left" or field = "right");
let or_edges_assign = select parent, child from operated where kind = "assignment-expression" and operator = "||=" and field = "right";
let or_edges = union(left=or_edges_logical, right=or_edges_assign);
let and_reach = closure(edges=and_edges, source="parent", destination="child");
let or_reach = closure(edges=or_edges, source="parent", destination="child");
let and_reached = select l.parent as id from and_reach as l join and_leaves as r on l.child = r.id;
let or_reached = select l.parent as id from or_reach as l join truthy_literals as r on l.child = r.id;
let and_identities = union(left=and_leaves, right=and_reached);
let or_identities = union(left=truthy_literals, right=or_reached);
let and_identity_ops = extend(from=and_identities, values={op: 1});
let or_identity_ops = extend(from=or_identities, values={op: 2});
let identities = union(left=and_identity_ops, right=or_identity_ops);
let kinds = select l.root as root, l.node as node, r.kind as kind from members as l join nodes as r on l.node = r.id;
let handled = select root, node from kinds where kind = "object-expression" or kind = "function-expression" or kind = "arrow-function-expression" or kind = "class-expression" or kind = "literal" or kind = "array-expression" or kind = "template-literal" or kind = "unary-expression" or kind = "binary-expression" or kind = "logical-expression" or kind = "sequence-expression" or kind = "assignment-expression" or kind = "call-expression" or kind = "new-expression" or kind = "identifier" or kind = "spread-element";
let unhandled = antijoin(left=members, right=handled, left-on=["root", "node"], right-on=["root", "node"]);
let in_binaries = select l.root as root, l.node as node from kinds as l join operators as r on l.node = r.id where l.kind = "binary-expression" and r.operator = "in";
let other_calls_all = select root, node from kinds where kind = "call-expression";
let other_calls = antijoin(left=other_calls_all, right=boolean_calls, left-on=["node"], right-on=["id"]);
let other_identifiers_all = select root, node from kinds where kind = "identifier";
let other_identifiers = antijoin(left=other_identifiers_all, right=global_undefined, left-on=["node"], right-on=["id"]);
let value_news = select l.root as root, l.node as node from kinds as l join value_nodes as r on l.root = r.root and l.node = r.node where l.kind = "new-expression";
let assignments = select l.root as root, l.node as node, r.operator as operator from kinds as l join operators as r on l.node = r.id where l.kind = "assignment-expression";
let other_assignments = select root, node from assignments where operator != "=" and operator != "&&=" and operator != "||=";
let logical_assignments = select root, node, operator from assignments where operator = "&&=" or operator = "||=";
let value_logical_assignments = select l.root as root, l.node as node from logical_assignments as l join value_nodes as r on l.root = r.root and l.node = r.node;
let boolean_logical_assignments = select l.root as root, l.node as node, l.operator as operator from logical_assignments as l join boolean_nodes as r on l.root = r.root and l.node = r.node;
let assignment_rights = select l.root as root, l.node as node, l.operator as operator, c.child as right from boolean_logical_assignments as l join "semantic-child" as c on l.node = c.parent where c.field = "right";
let and_rights = select root, node, right from assignment_rights where operator = "&&=";
let or_rights = select root, node, right from assignment_rights where operator = "||=";
let and_kept = select l.root as root, l.node as node from and_rights as l join and_identities as r on l.right = r.id;
let or_kept = select l.root as root, l.node as node from or_rights as l join or_identities as r on l.right = r.id;
let and_witness = antijoin(left=and_rights, right=and_kept, left-on=["root", "node"], right-on=["root", "node"]);
let or_witness = antijoin(left=or_rights, right=or_kept, left-on=["root", "node"], right-on=["root", "node"]);
let and_witness_rows = select root, node from and_witness;
let or_witness_rows = select root, node from or_witness;
let witnesses_a = union(left=unhandled, right=in_binaries);
let witnesses_b = union(left=witnesses_a, right=other_calls);
let witnesses_c = union(left=witnesses_b, right=other_identifiers);
let witnesses_d = union(left=witnesses_c, right=value_news);
let witnesses_e = union(left=witnesses_d, right=other_assignments);
let witnesses_f = union(left=witnesses_e, right=value_logical_assignments);
let witnesses_g = union(left=witnesses_f, right=and_witness_rows);
let witnesses = union(left=witnesses_g, right=or_witness_rows);
let strict_members = select root, node from members where node != root;
let member_edges = select l.root as root, l.node as node, r.parent as parent from strict_members as l join edges as r on l.node = r.child;
let parent_value = select l.root as root, l.node as node, l.parent as parent from member_edges as l join value_nodes as r on l.root = r.root and l.parent = r.node;
let parent_boolean = select l.root as root, l.node as node, l.parent as parent from member_edges as l join boolean_nodes as r on l.root = r.root and l.parent = r.node;
let blocked_typeof = select l.root as root, l.node as node from parent_boolean as l join typeof_edges as r on l.parent = r.parent and l.node = r.child;
let blocked_array = select l.root as root, l.node as node from parent_boolean as l join array_edges as r on l.parent = r.parent and l.node = r.child;
let template_tokens = select id, file, span from "semantic-syntax" where kind = "template" and matches(text, "(?s)^[\x60}].+(?:\x60|\$\{)$");
let template_literals = select id from "semantic-syntax" where kind = "template-literal";
let token_owners = axis(from=template_tokens, relation="semantic-child", direction=nearest-ancestor, domain=template_literals);
let quoted_templates = select related as id from token_owners;
let blocked_template_edges = select l.parent as parent, l.child as child from template_edges as l join quoted_templates as r on l.parent = r.id;
let blocked_template = select l.root as root, l.node as node from parent_boolean as l join blocked_template_edges as r on l.parent = r.parent and l.node = r.child;
let siblings = select l.parent as parent, l.child as child, l.field as field, l.operator as operator, r.child as sibling from logical_edges as l join logical_edges as r on l.parent = r.parent where l.field != r.field;
let and_siblings = select l.parent as parent, l.child as child, l.field as field from siblings as l join and_identities as r on l.sibling = r.id where l.operator = "&&";
let or_siblings = select l.parent as parent, l.child as child, l.field as field from siblings as l join or_identities as r on l.sibling = r.id where l.operator = "||";
let identity_siblings = union(left=and_siblings, right=or_siblings);
let right_after_identity = select parent, child from identity_siblings where field = "right";
let blocked_logical_any = select l.root as root, l.node as node from member_edges as l join right_after_identity as r on l.parent = r.parent and l.node = r.child;
let left_before_identity = select parent, child from identity_siblings where field = "left";
let blocked_logical_boolean = select l.root as root, l.node as node from parent_boolean as l join left_before_identity as r on l.parent = r.parent and l.node = r.child;
let blocked_a = union(left=blocked_typeof, right=blocked_array);
let blocked_b = union(left=blocked_a, right=blocked_template);
let blocked_c = union(left=blocked_b, right=blocked_logical_any);
let blocked = union(left=blocked_c, right=blocked_logical_boolean);
let witness_paths = select l.root as root, l.node as witness, p.node as step from witnesses as l join path_pairs as p on l.root = p.root and l.node = p.inner;
let blocked_paths = select l.root as root, l.witness as witness from witness_paths as l join blocked as r on l.root = r.root and l.step = r.node;
let open_witnesses = antijoin(left=witnesses, right=blocked_paths, left-on=["root", "node"], right-on=["root", "witness"]);
let varying = select root as id from open_witnesses;
let constant = antijoin(left=candidates, right=varying, left-on=["id"], right-on=["id"]);
return constant;
