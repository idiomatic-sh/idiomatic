input candidates: relation<id: node, file: file, span: span>;
param names: string;
output relation<id: node, file: file, span: span>;
let directive_comments = select id, file, span, text from "comment" where matches(text, "^\s*(?:eslint|oxlint)-(?:disable-next-line|disable-line|disable|enable)(?:\s|$)");
let directive_heads = replace(from=directive_comments, text="text", pattern="^\s*(?:eslint|oxlint)-[a-z-]+", replacement="", output="tail");
let directive_bodies = replace(from=directive_heads, text="tail", pattern="(?s)--.*$", replacement="", output="body");
let directives = replace(from=directive_bodies, text="body", pattern="\s+", replacement="", output="list");
let named = select id, file, span, text, list from directives where list != "" and matches(list, $names);
let blanket = select id, file, span, text, list from directives where list = "";
let applying = union(left=named, right=blanket);
let candidate_starts = source-matches(from=candidates, span="span", pattern="\A", output="before");
let candidate_bounds = span-bounds(from=candidate_starts, span="span", start-output="begin", end-output="finish");
let next_line = select id, file, span from applying where matches(text, "^\s*(?:eslint|oxlint)-disable-next-line(?:\s|$)");
let next_line_ends = source-matches(from=next_line, span="span", pattern="\z", output="after");
let next_line_bounds = span-bounds(from=next_line_ends, span="span", start-output="dbegin", end-output="dfinish");
let next_line_pairs = select l.id as id, l.file as file, l.span as span, l.before as before, r.after as after from candidate_bounds as l join next_line_bounds as r on l.file = r.file where l.begin >= r.dfinish;
let next_line_gaps = span-between(from=next_line_pairs, start="after", end="before", output="gap");
let next_line_hits = source-matches(from=next_line_gaps, span="gap", pattern="\A[^\n]*\n[^\n]*\z", output="hit");
let next_line_suppressed = select id, file, span from next_line_hits;
let same_line = select id, file, span from applying where matches(text, "^\s*(?:eslint|oxlint)-disable-line(?:\s|$)");
let same_line_starts = source-matches(from=same_line, span="span", pattern="\A", output="dstart");
let same_line_ends = source-matches(from=same_line_starts, span="span", pattern="\z", output="after");
let same_line_bounds = span-bounds(from=same_line_ends, span="span", start-output="dbegin", end-output="dfinish");
let leading_pairs = select l.id as id, l.file as file, l.span as span, l.before as before, r.after as after from candidate_bounds as l join same_line_bounds as r on l.file = r.file where l.begin >= r.dfinish;
let leading_gaps = span-between(from=leading_pairs, start="after", end="before", output="gap");
let leading_hits = source-matches(from=leading_gaps, span="gap", pattern="\A[^\n]*\z", output="hit");
let leading_suppressed = select id, file, span from leading_hits;
let trailing_pairs = select l.id as id, l.file as file, l.span as span, l.before as before, r.dstart as dstart from candidate_bounds as l join same_line_bounds as r on l.file = r.file where l.begin < r.dbegin;
let trailing_gaps = span-between(from=trailing_pairs, start="before", end="dstart", output="gap");
let trailing_hits = source-matches(from=trailing_gaps, span="gap", pattern="\A[^\n]*\z", output="hit");
let trailing_suppressed = select id, file, span from trailing_hits;
let range_marks = span-bounds(from=directives, span="span", start-output="begin", end-output="finish");
let disable_marks = select id, file, begin, finish, list from range_marks where matches(text, "^\s*(?:eslint|oxlint)-disable(?:\s|$)");
let enable_marks = select id, file, begin, finish, list from range_marks where matches(text, "^\s*(?:eslint|oxlint)-enable(?:\s|$)");
let blanket_disables = select id, file, begin, finish from disable_marks where list = "";
let blanket_enables = select id, file, begin, finish from enable_marks where list = "";
let named_disables = select id, file, begin, finish from disable_marks where list != "" and matches(list, $names);
let named_enables = select id, file, begin, finish from enable_marks where list != "" and matches(list, $names);
let blanket_blocks = ordered-match(left=blanket_disables, right=blanket_enables, left-on=[file], right-on=[file], left-order="begin", right-order="begin", output={id:[left,id], file:[left,file], begin:[left,finish], last:[right,begin]});
let named_blocks = ordered-match(left=named_disables, right=named_enables, left-on=[file], right-on=[file], left-order="begin", right-order="begin", output={id:[left,id], file:[left,file], begin:[left,finish], last:[right,begin]});
let closed_blocks = union(left=blanket_blocks, right=named_blocks);
let all_disables = union(left=blanket_disables, right=named_disables);
let open_disables = antijoin(left=all_disables, right=closed_blocks, left-on=["id"], right-on=["id"]);
let open_starts = select id, file, finish as begin from open_disables;
let open_blocks = extend(from=open_starts, values={last: 4294967295});
let blocks = union(left=closed_blocks, right=open_blocks);
let block_hits = select l.id as id, l.file as file, l.span as span from candidate_bounds as l join blocks as r on l.file = r.file where l.begin >= r.begin and l.begin < r.last;
let line_suppressed = union(left=next_line_suppressed, right=leading_suppressed);
let near_suppressed = union(left=line_suppressed, right=trailing_suppressed);
let suppressed = union(left=near_suppressed, right=block_hits);
let kept = antijoin(left=candidates, right=suppressed, left-on=["id", "span"], right-on=["id", "span"]);
return kept;
