import constructors from "typescript/oxlint/constructors";
output relation<method: node, function: node, block: number, heritage: symbol, file: file, span: span>;
let every_constructor = constructors();
let classes = select method, value as function, class from every_constructor where bodied = "yes";
let blocks = select l.method as method, l.function as function, l.class as class, r.block as block from classes as l join "flow-member" as r on l.function = r.node;
let heritages = select l.class as class, r.child as heritage from blocks as l join "semantic-child" as r on l.class = r.parent where r.field = "super-class";
let heritage_tokens = select l.class as class, r.child as token from heritages as l join "semantic-child" as r on l.heritage = r.parent;
let null_classes = select l.class as class from heritage_tokens as l join "semantic-syntax" as r on l.token = r.id where r.kind = "null";
let heritage_nodes = select l.heritage as id, r.file as file from heritages as l join "semantic-syntax" as r on l.heritage = r.id;
let heritage_files = project(from=heritage_nodes, columns=["file"]);
let file_nodes = select l.id as id, l.kind as kind from "semantic-syntax" as l join heritage_files as r on l.file = r.file;
let operators = select l.parent as id, r.text as operator from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where l.field = "operator";
let expressions = select id, kind from file_nodes where kind = "assignment-expression" or kind = "logical-expression" or kind = "conditional-expression" or kind = "sequence-expression";
let operated = select l.id as id, l.kind as kind, r.operator as operator from expressions as l join operators as r on l.id = r.id;
let passing = select id from operated where (kind = "assignment-expression" and (operator = "=" or operator = "&&=")) or (kind = "logical-expression" and operator = "&&");
let passing_edges = select l.parent as outer, l.child as inner from "semantic-child" as l join passing as r on l.parent = r.id where l.field = "right";
let branches = select l.parent as outer, l.child as inner from "semantic-child" as l join expressions as r on l.parent = r.id where r.kind = "conditional-expression" and (l.field = "consequent" or l.field = "alternate");
let sequence_items = select l.parent as outer, l.child as inner, l.ordinal as ordinal from "semantic-child" as l join expressions as r on l.parent = r.id where r.kind = "sequence-expression" and l.field = "expressions";
let earlier_items = select l.outer as outer, l.inner as inner from sequence_items as l join sequence_items as r on l.outer = r.outer where l.ordinal < r.ordinal;
let last_items = select outer, inner from sequence_items;
let lasts = antijoin(left=last_items, right=earlier_items, left-on=["outer", "inner"], right-on=["outer", "inner"]);
let passed = union(left=passing_edges, right=branches);
let deciding_edges = union(left=passed, right=lasts);
let decided = closure(edges=deciding_edges, source="outer", destination="inner");
let heritage_selves = select heritage as outer, heritage as inner from heritages;
let heritage_reach = select l.heritage as outer, r.inner as inner from heritages as l join decided as r on l.heritage = r.outer;
let heritage_deciders = union(left=heritage_selves, right=heritage_reach);
let literal_kinds = select l.parent as id, r.kind as kind from "semantic-child" as l join "semantic-syntax" as r on l.child = r.id where r.kind = "numeric" or r.kind = "string" or r.kind = "boolean";
let literal_leaves = select l.id as id from literal_kinds as l join "semantic-syntax" as r on l.id = r.id where r.kind = "literal";
let binary_leaves = select id from file_nodes where kind = "binary-expression";
let compound_leaves = select id from operated where kind = "assignment-expression" and operator != "=" and operator != "&&=" and operator != "||=" and operator != "??=";
let deciding_nodes = select id from passing;
let deciding_branches = select id from expressions where kind = "conditional-expression" or kind = "sequence-expression";
let invalid_literals = union(left=literal_leaves, right=binary_leaves);
let invalid_leaves = union(left=invalid_literals, right=compound_leaves);
let not_leaves = union(left=deciding_nodes, right=deciding_branches);
let not_valid = union(left=invalid_leaves, right=not_leaves);
let valid_leaves = antijoin(left=heritage_deciders, right=not_valid, left-on=["inner"], right-on=["id"]);
let valid_heritages = select l.class as class from heritages as l join valid_leaves as r on l.heritage = r.outer;
let null_marks = extend(from=null_classes, values={heritage: "null"});
let valid_candidates = antijoin(left=valid_heritages, right=null_classes, left-on=["class"], right-on=["class"]);
let valid_marks = extend(from=valid_candidates, values={heritage: "valid"});
let marked = union(left=null_marks, right=valid_marks);
let heritage_classes = select class from heritages;
let invalid_classes = antijoin(left=heritage_classes, right=marked, left-on=["class"], right-on=["class"]);
let invalid_marks = extend(from=invalid_classes, values={heritage: "invalid"});
let extending = union(left=marked, right=invalid_marks);
let plain_classes = antijoin(left=blocks, right=heritages, left-on=["class"], right-on=["class"]);
let plain_class_ids = select class from plain_classes;
let plain_marks = extend(from=plain_class_ids, values={heritage: "none"});
let kinds = union(left=extending, right=plain_marks);
let kinded = select l.method as method, l.function as function, l.block as block, r.heritage as heritage from blocks as l join kinds as r on l.class = r.class;
let flowing = select l.method as method, l.function as function, l.block as block, l.heritage as heritage, r.file as file, r.span as span from kinded as l join every_constructor as r on l.method = r.method;
return flowing;
