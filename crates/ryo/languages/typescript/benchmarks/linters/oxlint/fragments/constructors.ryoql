output relation<method: node, value: node, class: node, bodied: symbol, file: file, span: span>;
let methods = select id as method, file, span from "semantic-syntax" where kind = "method-definition";
let method_parts = select l.method as method, c.child as part, c.field as field from methods as l join "semantic-child" as c on l.method = c.parent;
let part_kinds = select l.method as method, l.part as part, l.field as field, r.kind as kind, r.text as text from method_parts as l join "semantic-syntax" as r on l.part = r.id;
let identifier_keys = select method, part as key from part_kinds where field = "key" and kind = "identifier";
let key_tokens = select l.method as method, r.child as token from identifier_keys as l join "semantic-child" as r on l.key = r.parent;
let named_keys = select l.method as method from key_tokens as l join "semantic-syntax" as r on l.token = r.id where r.kind = "identifier-token" and r.text = "constructor";
let literal_keys = select method, part as key from part_kinds where field = "key" and kind = "literal";
let literal_tokens = select l.method as method, r.child as token from literal_keys as l join "semantic-child" as r on l.key = r.parent;
let quoted_keys = select l.method as method from literal_tokens as l join "semantic-syntax" as r on l.token = r.id where r.kind = "string" and matches(r.text, "^.constructor.$");
let keyed = union(left=named_keys, right=quoted_keys);
let modified = select method from part_kinds where (kind = "keyword" and text = "static") or (kind = "punctuator" and text = "[");
let constructor_methods = antijoin(left=keyed, right=modified, left-on=["method"], right-on=["method"]);
let written = select l.method as method, r.part as value from constructor_methods as l join part_kinds as r on l.method = r.method where r.field = "value" and r.kind = "function-expression";
let signatures = select l.method as method, r.part as value from constructor_methods as l join part_kinds as r on l.method = r.method where r.field = "value" and r.kind = "ts-empty-body-function-expression";
let written_marks = extend(from=written, values={bodied: "yes"});
let signature_marks = extend(from=signatures, values={bodied: "no"});
let values = union(left=written_marks, right=signature_marks);
let bodies = select l.method as method, l.value as value, l.bodied as bodied, r.parent as body from values as l join "semantic-child" as r on l.method = r.child where r.field = "body";
let classes = select l.method as method, l.value as value, l.bodied as bodied, r.parent as class from bodies as l join "semantic-child" as r on l.body = r.child where r.field = "body";
let constructors = select l.method as method, l.value as value, l.class as class, l.bodied as bodied, r.file as file, r.span as span from classes as l join methods as r on l.method = r.method;
return constructors;
