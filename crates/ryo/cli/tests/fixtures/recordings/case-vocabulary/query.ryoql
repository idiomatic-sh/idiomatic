let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let declarations = select * from tree-nodes where glob_any(kind, "{struct,enum,union,trait,trait-alias,type-alias}");
let declaration-children = select r."child" as "child", l."kind" as "kind", l."file" as "file", l."span" as "span" from declarations as l join "syntax-child" as r on l."id" = r."parent";
let names = select * from tree-nodes where kind = "name";
let declaration-names = select l."kind" as "kind", r."id" as "name", l."file" as "file", l."span" as "span" from declaration-children as l join names as r on l."child" = r."id";
let name-children = select r."child" as "child", l."kind" as "kind", l."file" as "file", l."span" as "span" from declaration-names as l join "syntax-child" as r on l."name" = r."parent";
let identifiers = select * from tree-tokens where kind = "ident";
let declared = select l."kind" as "kind", l."file" as "file", l."span" as "span", r."text" as "text" from name-children as l join identifiers as r on l."child" = r."id";
let harness = select * from declared where glob_any(text, "{Proof,Rejection}");
let harness-labelled = extend(from=harness, values={"what": "declares the retired Proof/Rejection harness: cargo-mutants proves the tests bite"});
let harness-findings = project(from=harness-labelled, columns=["file", "span", "kind", "text", "what"]);
let functions = select * from tree-nodes where kind = "fn";
let function-children = select r."child" as "child", l."id" as "function" from functions as l join "syntax-child" as r on l."id" = r."parent";
let attributes = select * from tree-nodes where kind = "attr";
let function-attributes = select l."function" as "function", r."id" as "id" from function-children as l join attributes as r on l."child" = r."id";
let attribute-starts = project(from=function-attributes, columns=["id"]);
let attribute-meta-edges = select l."id" as "attribute", r."child" as "child" from attribute-starts as l join "syntax-child" as r on l."id" = r."parent";
let metas = select * from tree-nodes where glob_any(kind, "*-meta");
let attribute-metas = select l."attribute" as "attribute", r."id" as "child" from attribute-meta-edges as l join metas as r on l."child" = r."id";
let attribute-path-edges = select l."attribute" as "attribute", r."child" as "child" from attribute-metas as l join "syntax-child" as r on l."child" = r."parent";
let attribute-paths = select * from tree-nodes where kind = "path";
let attribute-path-nodes = select l."attribute" as "attribute", r."id" as "child" from attribute-path-edges as l join attribute-paths as r on l."child" = r."id";
let attribute-segment-edges = select l."attribute" as "attribute", r."child" as "child" from attribute-path-nodes as l join "syntax-child" as r on l."child" = r."parent";
let attribute-segments = select * from tree-nodes where kind = "path-segment";
let attribute-segment-nodes = select l."attribute" as "attribute", r."id" as "child" from attribute-segment-edges as l join attribute-segments as r on l."child" = r."id";
let attribute-reference-edges = select l."attribute" as "attribute", r."child" as "child" from attribute-segment-nodes as l join "syntax-child" as r on l."child" = r."parent";
let name-references = select * from tree-nodes where kind = "name-ref";
let attribute-references = select l."attribute" as "attribute", r."id" as "child" from attribute-reference-edges as l join name-references as r on l."child" = r."id";
let attribute-reference-children = select l."attribute" as "attribute", r."child" as "child" from attribute-references as l join "syntax-child" as r on l."child" = r."parent";
let test-attribute-words = select * from identifiers where glob_any(text, "{test,rstest}");
let test-attributes = select l."attribute" as "attribute" from attribute-reference-children as l join test-attribute-words as r on l."child" = r."id";
let test-marked = select r."function" as "function" from test-attributes as l join function-attributes as r on l."attribute" = r."id";
let test-functions = project(from=test-marked, columns=["function"]);
let tests = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from functions as l join test-functions as r on l."id" = r."function";
let test-children = select r."child" as "child", l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from tests as l join "syntax-child" as r on l."id" = r."parent";
let test-names = select l."id" as "id", l."kind" as "kind", r."id" as "name", l."file" as "file", l."span" as "span" from test-children as l join names as r on l."child" = r."id";
let test-name-children = select r."child" as "child", l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from test-names as l join "syntax-child" as r on l."name" = r."parent";
let test-named = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", r."text" as "text" from test-name-children as l join identifiers as r on l."child" = r."id";
let two-words = select * from test-named where glob_any(text, "{{succeeds,r#succeeds,*_succeeds}_{refuses,refuses_*,*_refuses,*_refuses_*},{succeeds,r#succeeds,*_succeeds}_{fails,fails_*,*_fails,*_fails_*},{succeeds,r#succeeds,*_succeeds}_{rejects,rejects_*,*_rejects,*_rejects_*},{refuses,r#refuses,*_refuses}_{succeeds,succeeds_*,*_succeeds,*_succeeds_*},{refuses,r#refuses,*_refuses}_{fails,fails_*,*_fails,*_fails_*},{refuses,r#refuses,*_refuses}_{rejects,rejects_*,*_rejects,*_rejects_*},{fails,r#fails,*_fails}_{succeeds,succeeds_*,*_succeeds,*_succeeds_*},{fails,r#fails,*_fails}_{refuses,refuses_*,*_refuses,*_refuses_*},{fails,r#fails,*_fails}_{rejects,rejects_*,*_rejects,*_rejects_*},{rejects,r#rejects,*_rejects}_{succeeds,succeeds_*,*_succeeds,*_succeeds_*},{rejects,r#rejects,*_rejects}_{refuses,refuses_*,*_refuses,*_refuses_*},{rejects,r#rejects,*_rejects}_{fails,fails_*,*_fails,*_fails_*}}");
let two-words-labelled = extend(from=two-words, values={"what": "names more than one case word: a test names its case with one of succeeds, refuses, fails or rejects"});
let two-words-findings = project(from=two-words-labelled, columns=["file", "span", "kind", "text", "what"]);
let fails-words = select * from test-named where glob_any(text, "{fails,r#fails,fails_*,r#fails_*,*_fails,*_fails_*}");
let fails-shaped = select * from fails-words where glob_any(text, "{fails,r#fails,fails_when_[a-z0-9]*_fails,r#fails_when_[a-z0-9]*_fails,*_fails_when_[a-z0-9]*_fails}");
let fails-misshaped = antijoin(left=fails-words, right=fails-shaped, left-on=["file", "span"], right-on=["file", "span"]);
let fails-labelled = extend(from=fails-misshaped, values={"what": "uses `fails` outside `fails_when_<dependency>_fails`: `fails` names a dependency's error propagating"});
let fails-findings = project(from=fails-labelled, columns=["file", "span", "kind", "text", "what"]);
let refuses-words = select * from test-named where glob_any(text, "{refuses,r#refuses,refuses_*,r#refuses_*,*_refuses,*_refuses_*}");
let test-parts = axis(from=tests, relation="syntax-child", direction=descendant, domain=tree-nodes);
let impls = select * from tree-nodes where kind = "impl";
let test-impls = select r."id" as "node", l."id" as "test" from test-parts as l join impls as r on l."related" = r."id";
let impl-for-edges = select r."ordinal" as "before", r."child" as "child", l."node" as "impl", l."test" as "test" from test-impls as l join "syntax-child" as r on l."node" = r."parent";
let for-keywords = select * from tree-tokens where kind = "for-kw";
let impl-for-positions = select l."before" as "before", l."impl" as "impl", l."test" as "test" from impl-for-edges as l join for-keywords as r on l."child" = r."id";
let impl-type-edges = select l."before" as "before", r."child" as "child", r."ordinal" as "ordinal", l."test" as "test" from impl-for-positions as l join "syntax-child" as r on l."impl" = r."parent";
let impl-trait-edges = select * from impl-type-edges where ordinal < before;
let path-types = select * from tree-nodes where kind = "path-type";
let impl-types = select r."id" as "node", l."test" as "test" from impl-trait-edges as l join path-types as r on l."child" = r."id";
let impl-type-path-edges = select r."child" as "child", l."test" as "test" from impl-types as l join "syntax-child" as r on l."node" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let impl-type-paths = select r."id" as "node", l."test" as "test" from impl-type-path-edges as l join paths as r on l."child" = r."id";
let impl-segment-edges = select r."child" as "child", l."test" as "test" from impl-type-paths as l join "syntax-child" as r on l."node" = r."parent";
let path-segments = select * from tree-nodes where kind = "path-segment";
let impl-segments = select r."id" as "node", l."test" as "test" from impl-segment-edges as l join path-segments as r on l."child" = r."id";
let impl-reference-edges = select r."child" as "child", l."test" as "test" from impl-segments as l join "syntax-child" as r on l."node" = r."parent";
let impl-references = select r."id" as "node", l."test" as "test" from impl-reference-edges as l join name-references as r on l."child" = r."id";
let impl-word-edges = select r."child" as "child", l."test" as "test" from impl-references as l join "syntax-child" as r on l."node" = r."parent";
let port-words = select * from identifiers where glob_any(text, "{*Interface,*Item,*Port}");
let impl-ports = select r."id" as "node", l."test" as "test" from impl-word-edges as l join port-words as r on l."child" = r."id";
let port-implementing-tests = project(from=impl-ports, columns=["test"]);
let refuses-implementing = select l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from refuses-words as l join port-implementing-tests as r on l."id" = r."test";
let refuses-labelled = extend(from=refuses-implementing, values={"what": "implements a port in a `refuses` test: a weaker implementation the contract catches is a `rejects` case"});
let refuses-findings = project(from=refuses-labelled, columns=["file", "span", "kind", "text", "what"]);
let shape-findings = union(left=fails-findings, right=refuses-findings);
let name-findings = union(left=two-words-findings, right=shape-findings);
let findings = union(left=harness-findings, right=name-findings);
emit findings subject "file" key("span", "what");
