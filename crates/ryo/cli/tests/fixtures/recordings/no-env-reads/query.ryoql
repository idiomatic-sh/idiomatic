param exceptions: set<string>;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let references = project(from="reference", columns=["file", "span", "target"]);
let imports = project(from="static-import", columns=["file", "span", "target"]);
let mentions = union(left=references, right=imports);
let path-reads = select * from mentions where glob_any(target, "{std::env::var,std::env::var_os,std::env::vars,std::env::vars_os,env::var,env::var_os,env::vars,env::vars_os,std::env::[*],option_env,std::option_env,core::option_env}");
let idents = select * from tree-tokens where glob_any(text, "{option_env,var,vars,var_os,vars_os,env}");
let named-idents = select * from idents where kind = "ident";
let ident-parents = select r."parent" as "parent", l."file" as "file", l."span" as "span", l."text" as "target" from named-idents as l join "syntax-child" as r on l."id" = r."child";
let option-env-tokens = select * from ident-parents where target = "option_env";
let option-env = project(from=option-env-tokens, columns=["file", "span", "target"]);
let trees = select * from tree-nodes where kind = "token-tree";
let tree-idents = select l."parent" as "parent", l."file" as "file", l."span" as "span", l."target" as "target" from ident-parents as l join trees as r on l."parent" = r."id";
let tree-os-tokens = select * from tree-idents where glob_any(target, "{var_os,vars_os}");
let tree-os = project(from=tree-os-tokens, columns=["file", "span", "target"]);
let tree-vars = select * from tree-idents where glob_any(target, "{var,vars}");
let tree-env-tokens = select * from tree-idents where target = "env";
let tree-env = project(from=tree-env-tokens, columns=["parent"]);
let tree-var-env = select l."file" as "file", l."span" as "span", l."target" as "target" from tree-vars as l join tree-env as r on l."parent" = r."parent";
let macro-reads = union(left=tree-os, right=tree-var-env);
let token-reads = union(left=option-env, right=macro-reads);
let literals = project(from="string-literal", columns=["span", "value"]);
let admitted-literals = select * from literals where value in $exceptions;
let literal-nodes = select r."id" as "literal" from admitted-literals as l join tree-nodes as r on l."span" = r."span";
let literal-parents = select r."parent" as "list" from literal-nodes as l join "syntax-child" as r on l."literal" = r."child";
let arg-lists = select * from tree-nodes where kind = "arg-list";
let admitted-lists = select l."list" as "list" from literal-parents as l join arg-lists as r on l."list" = r."id";
let list-calls = select r."parent" as "call" from admitted-lists as l join "syntax-child" as r on l."list" = r."child";
let call-children = select r."child" as "callee" from list-calls as l join "syntax-child" as r on l."call" = r."parent";
let path-exprs = select * from tree-nodes where kind = "path-expr";
let callee-exprs = select l."callee" as "callee" from call-children as l join path-exprs as r on l."callee" = r."id";
let callee-children = select r."child" as "node" from callee-exprs as l join "syntax-child" as r on l."callee" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let admitted-paths = select r."span" as "span" from callee-children as l join paths as r on l."node" = r."id";
let named-reads = antijoin(left=path-reads, right=admitted-paths, left-on=["span"], right-on=["span"]);
let reads = union(left=named-reads, right=token-reads);
emit reads subject "file" key("span");
