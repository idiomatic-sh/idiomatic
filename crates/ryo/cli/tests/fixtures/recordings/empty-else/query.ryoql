let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let else-keywords = select * from tree-tokens where kind = "else-kw";
let else-positions = select r."ordinal" as "keyword", r."parent" as "owner" from else-keywords as l join "syntax-child" as r on l."id" = r."child";
let owner-children = select r."child" as "child", l."keyword" as "keyword", r."ordinal" as "position" from else-positions as l join "syntax-child" as r on l."owner" = r."parent";
let after-else = select * from owner-children where position > keyword;
let blocks = select * from tree-nodes where kind = "block-expr";
let else-blocks = select r."id" as "block", r."file" as "file", r."span" as "span" from after-else as l join blocks as r on l."child" = r."id";
let statement-lists = select r."child" as "list", l."file" as "file", l."span" as "span" from else-blocks as l join "syntax-child" as r on l."block" = r."parent";
let list-children = select r."child" as "child", l."list" as "list" from statement-lists as l join "syntax-child" as r on l."list" = r."parent";
let child-nodes = select l."list" as "list" from list-children as l join tree-nodes as r on l."child" = r."id";
let not-whitespace = select * from tree-tokens where kind != "whitespace";
let not-opening = select * from not-whitespace where kind != "l-curly";
let content-tokens = select * from not-opening where kind != "r-curly";
let child-tokens = select l."list" as "list" from list-children as l join content-tokens as r on l."child" = r."id";
let filled = union(left=child-nodes, right=child-tokens);
let empty = antijoin(left=statement-lists, right=filled, left-on=["list"], right-on=["list"]);
emit empty subject "file" key("span");
