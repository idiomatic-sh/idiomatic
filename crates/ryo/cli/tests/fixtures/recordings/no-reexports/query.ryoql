let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let imports = select * from tree-nodes where kind = "use";
let external-crates = select * from tree-nodes where kind = "extern-crate";
let bindings = union(left=imports, right=external-crates);
let aliases = select * from tree-nodes where kind = "type-alias";
let forwarding = union(left=bindings, right=aliases);
let forwarding-children = select r."child" as "child", l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from forwarding as l join "syntax-child" as r on l."id" = r."parent";
let visibility = select * from tree-nodes where kind = "visibility";
let visible-forwarding = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", r."id" as "visibility" from forwarding-children as l join visibility as r on l."child" = r."id";
let visible-imports = select * from visible-forwarding where kind = "use";
let token-edges = select r."kind" as "kind", l."parent" as "parent", r."text" as "text", r."id" as "token" from "syntax-child" as l join tree-tokens as r on l."child" = r."id";
let attributes = select * from tree-nodes where kind = "attr";
let forwarding-rows = project(from=visible-forwarding, columns=["file", "span", "kind"]);
let forwarding-described = extend(from=forwarding-rows, values={"problem": "declaration has explicit forwarding visibility"});
let metas = select * from tree-nodes where glob_any(kind, "{token-tree-meta,key-value-meta,path-meta}");
let meta-attributes = axis(from=metas, relation="syntax-child", direction=nearest-ancestor, domain=attributes);
let attribute-metas = select r."id" as "attribute", l."id" as "meta", r."file" as "file", r."span" as "span" from meta-attributes as l join attributes as r on l."related" = r."id";
let meta-path-edges = select l."attribute" as "attribute", r."child" as "child", l."meta" as "meta" from attribute-metas as l join "syntax-child" as r on l."meta" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let meta-paths = select l."attribute" as "attribute", l."meta" as "meta", r."id" as "path-node" from meta-path-edges as l join paths as r on l."child" = r."id";
let meta-path-segment-edges = select l."attribute" as "attribute", r."child" as "child", l."meta" as "meta" from meta-paths as l join "syntax-child" as r on l."path-node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let segment-name-ref-edges = select r."child" as "child", l."id" as "segment" from segments as l join "syntax-child" as r on l."id" = r."parent";
let name-refs = select * from tree-nodes where kind = "name-ref";
let segment-name-refs = select r."id" as "name-ref", l."segment" as "segment" from segment-name-ref-edges as l join name-refs as r on l."child" = r."id";
let segment-identifiers = select r."kind" as "kind", l."name-ref" as "name-ref", l."segment" as "segment", r."text" as "text", r."token" as "token" from segment-name-refs as l join token-edges as r on l."name-ref" = r."parent";
let attribute-names = select l."attribute" as "attribute", l."meta" as "meta", r."text" as "name" from meta-path-segment-edges as l join segment-identifiers as r on l."child" = r."segment";
let meta-tree-edges = select l."attribute" as "attribute", r."child" as "child", l."name" as "name" from attribute-names as l join "syntax-child" as r on l."meta" = r."parent";
let token-trees = select * from tree-nodes where kind = "token-tree";
let attribute-trees = select l."attribute" as "attribute", r."id" as "id", l."name" as "name" from meta-tree-edges as l join token-trees as r on l."child" = r."id";
let attribute-tree-roots = project(from=attribute-trees, columns=["id"]);
let attribute-owned-nodes = axis(from=tree-nodes, relation="syntax-child", direction=nearest-ancestor, domain=attribute-tree-roots);
let attribute-nested-tokens = select r."kind" as "kind", l."related" as "root", r."text" as "text", r."token" as "token" from attribute-owned-nodes as l join token-edges as r on l."id" = r."parent";
let attribute-root-tokens = select r."kind" as "kind", l."id" as "root", r."text" as "text", r."token" as "token" from attribute-tree-roots as l join token-edges as r on l."id" = r."parent";
let attribute-tree-tokens = union(left=attribute-nested-tokens, right=attribute-root-tokens);
let attribute-tokens = select r."attribute" as "attribute", r."name" as "name", l."text" as "text" from attribute-tree-tokens as l join attribute-trees as r on l."root" = r."id";
let pub-use-mentions = select * from attribute-tokens where glob_any(text, "{pub_use,restriction}");
let suppressing-mentions = select * from pub-use-mentions where glob_any(name, "{allow,expect}");
let suppressions = project(from=suppressing-mentions, columns=["attribute"]);
let visible-import-attribute-edges = select r."child" as "attribute" from visible-imports as l join "syntax-child" as r on l."id" = r."parent";
let stray-suppressions = antijoin(left=suppressions, right=visible-import-attribute-edges, left-on=["attribute"], right-on=["attribute"]);
let stray-rows = select r."file" as "file", r."span" as "span" from stray-suppressions as l join attributes as r on l."attribute" = r."id";
let stray-described = extend(from=stray-rows, values={"kind": "attribute", "problem": "suppresses `clippy::pub_use` outside an SDK surface"});
let declaration-and-suppression-findings = union(left=forwarding-described, right=stray-described);
let macro-definitions = select * from tree-nodes where glob_any(kind, "{macro-rules,macro-def}");
let macro-descendants = axis(from=macro-definitions, relation="syntax-child", direction=descendant, domain=token-trees);
let macro-trees = project(from=macro-descendants, columns=["related"]);
let macro-tree-children = select r."child" as "child", r."ordinal" as "ordinal", l."related" as "tree" from macro-trees as l join "syntax-child" as r on l."related" = r."parent";
let macro-tokens = select r."kind" as "kind", l."ordinal" as "ordinal", r."file" as "file", r."span" as "span", r."text" as "text", r."id" as "token", l."tree" as "tree" from macro-tree-children as l join tree-tokens as r on l."child" = r."id";
let macro-publics = select * from macro-tokens where kind = "pub-kw";
let macro-binding-keywords = select * from macro-tokens where glob_any(kind, "{type-kw,use-kw,extern-kw}");
let macro-keyword-pairs = select r."token" as "binding", r."ordinal" as "binding-ordinal", r."text" as "kind", r."file" as "file", l."token" as "public", l."ordinal" as "public-ordinal", r."span" as "span", l."tree" as "tree" from macro-publics as l join macro-binding-keywords as r on l."tree" = r."tree";
let macro-ordered-pairs = select * from macro-keyword-pairs where public-ordinal < binding-ordinal;
let macro-trivia = select * from macro-tokens where glob_any(kind, "{whitespace,comment}");
let macro-significant-tokens = antijoin(left=macro-tokens, right=macro-trivia, left-on=["token"], right-on=["token"]);
let macro-pair-candidates = select r."ordinal" as "between", l."binding" as "binding", l."binding-ordinal" as "binding-ordinal", l."public" as "public", l."public-ordinal" as "public-ordinal" from macro-ordered-pairs as l join macro-significant-tokens as r on l."tree" = r."tree";
let macro-pair-after-public = select * from macro-pair-candidates where between > public-ordinal;
let macro-pair-blockers = select * from macro-pair-after-public where between < binding-ordinal;
let macro-adjacent-pairs = antijoin(left=macro-ordered-pairs, right=macro-pair-blockers, left-on=["public", "binding"], right-on=["public", "binding"]);
let macro-rows = project(from=macro-adjacent-pairs, columns=["file", "span", "kind"]);
let macro-described = extend(from=macro-rows, values={"problem": "in a macro body beside `pub` forwards a name with explicit visibility"});
let findings = union(left=declaration-and-suppression-findings, right=macro-described);
emit findings subject "file" key("span");
