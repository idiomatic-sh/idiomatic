let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let cfg-metas = select * from tree-nodes where kind = "cfg-meta";
let atoms = select * from tree-nodes where kind = "cfg-atom";
let test-words = select * from tree-tokens where text = "test";
let test-atoms = axis(from=test-words, relation="syntax-child", direction=nearest-ancestor, domain=atoms);
let test-atom-parents = select r."parent" as "meta" from test-atoms as l join "syntax-child" as r on l."related" = r."child";
let cfg-test-metas = select l."meta" as "meta" from test-atom-parents as l join cfg-metas as r on l."meta" = r."id";
let cfg-test-attributes = select r."parent" as "attribute" from cfg-test-metas as l join "syntax-child" as r on l."meta" = r."child";
let test-items = select r."parent" as "id" from cfg-test-attributes as l join "syntax-child" as r on l."attribute" = r."child";
let written-kinds = select * from tree-nodes where glob_any(kind, "{path,use-tree}");
let test-code = axis(from=test-items, relation="syntax-child", direction=descendant, domain=written-kinds);
let test-written = select r."id" as "id", r."kind" as "kind", r."file" as "file", r."span" as "span" from test-code as l join written-kinds as r on l."related" = r."id";
let test-written-parents = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", r."parent" as "parent" from test-written as l join "syntax-child" as r on l."id" = r."child";
let inner = select l."id" as "id", l."parent" as "parent" from test-written-parents as l join tree-nodes as r on l."parent" = r."id" where l."kind" = "path" and r."kind" = "path";
let qualified = select l."parent" as "id" from inner as l;
let test-paths = select * from test-written-parents where kind = "path";
let outer-paths = antijoin(left=test-paths, right=inner, left-on=["id"], right-on=["id"]);
let written-paths = select l."file" as "source", l."span" as "span" from outer-paths as l join qualified as r on l."id" = r."id";
let use-lists = select * from tree-nodes where kind = "use-tree-list";
let grouping-uses = select r."parent" as "id" from use-lists as l join "syntax-child" as r on l."id" = r."child";
let test-use-trees = select * from test-written-parents where kind = "use-tree";
let test-use-leaves = antijoin(left=test-use-trees, right=grouping-uses, left-on=["id"], right-on=["id"]);
let test-uses = select l."file" as "source", l."span" as "span" from test-use-leaves as l;
let test-spans = union(left=written-paths, right=test-uses);
let written = select source, target, span from "source-dependency";
let compiled = antijoin(left=written, right=test-spans, left-on=["source", "span"], right-on=["source", "span"]);
let dependencies = project(from=compiled, columns=["source", "target"]);
let foreign = select * from dependencies where source != target;
let files = select * from tree-nodes where kind = "source-file";
let from-files = select r."id" as "from", l."target" as "target" from foreign as l join files as r on l."source" = r."file";
let edges = select l."from" as "from", r."id" as "to" from from-files as l join files as r on l."target" = r."file";
let cycles = cycles(edges=edges, source="from", destination="to");
let cyclic-files = select r."file" as "file", r."span" as "span" from cycles as l join files as r on l."from" = r."id";
emit cyclic-files subject "file" key("file");
