let listed-files = select l."path" as "file" from "filesystem.file" as l;
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let suffixed-tests = capture(from=listed-files, path="file", pattern="{*directory}/{name}_test.rs", captures=["directory", "name"]);
let modules = capture(from=listed-files, path="file", pattern="{*directory}/{name}.rs", captures=["directory", "name"]);
let suffixed-pairs = select r."file" as "module", l."file" as "test" from suffixed-tests as l join modules as r on l."directory" = r."directory" and l."name" = r."name";
let nested-tests = capture(from=listed-files, path="file", pattern="{*parent}/{name}/tests.rs", captures=["parent", "name"]);
let parent-modules = capture(from=listed-files, path="file", pattern="{*parent}/{name}.rs", captures=["parent", "name"]);
let file-module-pairs = select r."file" as "module", l."file" as "test" from nested-tests as l join parent-modules as r on l."parent" = r."parent" and l."name" = r."name";
let directory-tests = capture(from=listed-files, path="file", pattern="{*directory}/tests.rs", captures=["directory"]);
let directory-modules = capture(from=listed-files, path="file", pattern="{*directory}/mod.rs", captures=["directory"]);
let mod-pairs = select r."file" as "module", l."file" as "test" from directory-tests as l join directory-modules as r on l."directory" = r."directory";
let nested-pairs = union(left=file-module-pairs, right=mod-pairs);
let pairs = union(left=suffixed-pairs, right=nested-pairs);
let tests = project(from=pairs, columns=["test"]);
let declared = select * from "defines" where kind != "variable";
let unimported = select * from declared where kind != "import";
let items = select * from unimported where kind != "type-parameter";
let pair-items = select r."name" as "name", l."test" as "test" from pairs as l join items as r on l."module" = r."file";
let identifiers = select * from tree-tokens where kind = "ident";
let mentions = project(from=identifiers, columns=["file", "text"]);
let named = select l."test" as "test" from pair-items as l join mentions as r on l."test" = r."file" and l."name" = r."text";
let naming-nothing = antijoin(left=tests, right=named, left-on=["test"], right-on=["test"]);
emit naming-nothing subject "test" key("test");
