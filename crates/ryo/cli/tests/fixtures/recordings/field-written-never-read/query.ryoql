param trivial-derives: set<string>;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let record-fields = select * from tree-nodes where kind = "record-field";
let visibilities = select * from tree-nodes where kind = "visibility";
let visible-fields = axis(from=visibilities, relation="syntax-child", direction=parent, domain=record-fields);
let visible-field-ids = project(from=visible-fields, columns=["related"]);
let unmarked-fields = antijoin(left=record-fields, right=visible-field-ids, left-on=["id"], right-on=["related"]);
let field-owners = select * from tree-nodes where glob_any(kind, "{struct,variant,union}");
let fields-owned = axis(from=unmarked-fields, relation="syntax-child", direction=nearest-ancestor, domain=field-owners);
let field-owner-kinds = select l."id" as "id", r."kind" as "owner", l."file" as "file", l."span" as "span", l."related" as "struct" from fields-owned as l join tree-nodes as r on l."related" = r."id";
let struct-fields = select * from field-owner-kinds where owner = "struct";
let node-texts-edges = select r."kind" as "kind", l."parent" as "parent", r."text" as "text" from "syntax-child" as l join tree-tokens as r on l."child" = r."id";
let node-idents = select * from node-texts-edges where kind = "ident";
let node-ident-nodes = select r."id" as "id", l."text" as "text" from node-idents as l join tree-nodes as r on l."parent" = r."id";
let attributes = select * from tree-nodes where kind = "attr";
let attribute-idents = axis(from=node-ident-nodes, relation="syntax-child", direction=nearest-ancestor, domain=attributes);
let derive-attributes = select * from attribute-idents where text = "derive";
let derive-attribute-ids = project(from=derive-attributes, columns=["related"]);
let derived-names = select l."related" as "attribute", l."text" as "text" from attribute-idents as l join derive-attribute-ids as r on l."related" = r."related";
let reading-derives = select * from derived-names where text not in $trivial-derives;
let reading-structs = select r."parent" as "struct" from reading-derives as l join "syntax-child" as r on l."attribute" = r."child";
let judged-structs-fields = antijoin(left=struct-fields, right=reading-structs, left-on=["struct"], right-on=["struct"]);
let name-refs = select * from tree-nodes where kind = "name-ref";
let field-type-refs = axis(from=judged-structs-fields, relation="syntax-child", direction=descendant, domain=name-refs);
let field-type-names = select l."id" as "id", r."text" as "text" from field-type-refs as l join node-idents as r on l."related" = r."parent";
let marker-fields = select * from field-type-names where text = "PhantomData";
let private-fields = antijoin(left=judged-structs-fields, right=marker-fields, left-on=["id"], right-on=["id"]);
let names = select * from tree-nodes where kind = "name";
let field-names = axis(from=private-fields, relation="syntax-child", direction=child, domain=names);
let field-texts = select r."text" as "field", l."file" as "file", l."span" as "span" from field-names as l join node-idents as r on l."related" = r."parent";
let declared-nested = capture(from=field-texts, path="file", pattern="{*crate}/src/{*rest}", captures=["crate", "rest"]);
let declared-nested-rows = project(from=declared-nested, columns=["file", "span", "field", "crate"]);
let declared-root = capture(from=field-texts, path="file", pattern="src/{*rest}", captures=["rest"]);
let declared-root-crate = extend(from=declared-root, values={"crate": "."});
let declared-root-rows = project(from=declared-root-crate, columns=["file", "span", "field", "crate"]);
let declared = union(left=declared-nested-rows, right=declared-root-rows);
let literal-fields = select * from tree-nodes where kind = "record-expr-field";
let explicit-writes = axis(from=literal-fields, relation="syntax-child", direction=child, domain=name-refs);
let explicit-write-refs = project(from=explicit-writes, columns=["file", "related"]);
let path-expressions = select * from tree-nodes where kind = "path-expr";
let shorthand-values = axis(from=literal-fields, relation="syntax-child", direction=child, domain=path-expressions);
let shorthand-value-ids = select r."id" as "id", r."file" as "file", l."span" as "span" from shorthand-values as l join tree-nodes as r on l."related" = r."id";
let explicit-field-ids = project(from=explicit-writes, columns=["span"]);
let shorthand-only = antijoin(left=shorthand-value-ids, right=explicit-field-ids, left-on=["span"], right-on=["span"]);
let shorthand-writes = axis(from=shorthand-only, relation="syntax-child", direction=descendant, domain=name-refs);
let shorthand-write-refs = project(from=shorthand-writes, columns=["file", "related"]);
let write-refs = union(left=explicit-write-refs, right=shorthand-write-refs);
let writes = select r."text" as "field", l."file" as "file" from write-refs as l join node-idents as r on l."related" = r."parent";
let written-nested = capture(from=writes, path="file", pattern="{*crate}/src/{*rest}", captures=["crate", "rest"]);
let written-nested-rows = project(from=written-nested, columns=["crate", "field"]);
let written-root = capture(from=writes, path="file", pattern="src/{*rest}", captures=["rest"]);
let written-root-crate = extend(from=written-root, values={"crate": "."});
let written-root-rows = project(from=written-root-crate, columns=["crate", "field"]);
let written = union(left=written-nested-rows, right=written-root-rows);
let written-fields = select l."crate" as "crate", l."field" as "field", l."file" as "file", l."span" as "span" from declared as l join written as r on l."crate" = r."crate" and l."field" = r."field";
let field-accesses = select * from tree-nodes where kind = "field-expr";
let access-refs = axis(from=name-refs, relation="syntax-child", direction=parent, domain=field-accesses);
let access-ref-ids = project(from=access-refs, columns=["file", "id"]);
let pattern-fields = select * from tree-nodes where kind = "record-pat-field";
let pattern-names = select * from tree-nodes where glob_any(kind, "{name,name-ref}");
let pattern-refs = axis(from=pattern-fields, relation="syntax-child", direction=descendant, domain=pattern-names);
let pattern-ref-nodes = select r."id" as "id", r."file" as "file" from pattern-refs as l join tree-nodes as r on l."related" = r."id";
let read-refs = union(left=access-ref-ids, right=pattern-ref-nodes);
let syntax-reads = select r."text" as "field", l."file" as "file" from read-refs as l join node-idents as r on l."id" = r."parent";
let token-trees = select * from tree-nodes where kind = "token-tree";
let macro-reads = select r."text" as "field", l."file" as "file" from token-trees as l join node-idents as r on l."id" = r."parent";
let reads = union(left=syntax-reads, right=macro-reads);
let read-nested = capture(from=reads, path="file", pattern="{*crate}/src/{*rest}", captures=["crate", "rest"]);
let read-nested-rows = project(from=read-nested, columns=["crate", "field"]);
let read-root = capture(from=reads, path="file", pattern="src/{*rest}", captures=["rest"]);
let read-root-crate = extend(from=read-root, values={"crate": "."});
let read-root-rows = project(from=read-root-crate, columns=["crate", "field"]);
let read = union(left=read-nested-rows, right=read-root-rows);
let unread = antijoin(left=written-fields, right=read, left-on=["crate", "field"], right-on=["crate", "field"]);
emit unread subject "file" key("span");
