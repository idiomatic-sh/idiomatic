param max-features: integer;
let dependency-keys = select * from "entry" where glob_any(key, "{dependencies,dev-dependencies,build-dependencies}");
let dependency-tables = select r."id" as "table" from dependency-keys as l join "mapping" as r on l."occurrence" = r."owner";
let dependencies = select r."decoded" as "decoded", r."occurrence" as "dependency", r."key" as "name", r."file" as "file", r."span" as "span" from dependency-tables as l join "entry" as r on l."table" = r."owner";
let dependency-bodies = select r."id" as "body", l."dependency" as "dependency" from dependencies as l join "mapping" as r on l."dependency" = r."owner";
let body-entries = select r."decoded" as "decoded", l."dependency" as "dependency", r."occurrence" as "features", r."key" as "key" from dependency-bodies as l join "entry" as r on l."body" = r."owner";
let feature-lists = select * from body-entries where key = "features";
let features = select l."dependency" as "dependency", r."decoded" as "feature" from feature-lists as l join "sequence-element" as r on l."features" = r."owner";
let feature-counts = group-count(from=features, keys=["dependency"], count="features", distinct="feature");
let sprawling = select * from feature-counts where features > $max-features;
let sprawling-ids = project(from=sprawling, columns=["dependency"]);
let star-strings = select * from dependencies where decoded = "*";
let star-string-ids = project(from=star-strings, columns=["dependency"]);
let versions = select * from body-entries where key = "version";
let star-versions = select * from versions where decoded = "*";
let star-version-ids = project(from=star-versions, columns=["dependency"]);
let stars = union(left=star-string-ids, right=star-version-ids);
let flagged = union(left=sprawling-ids, right=stars);
let reported = select r."name" as "name", r."file" as "file", r."span" as "span" from flagged as l join dependencies as r on l."dependency" = r."dependency";
emit reported subject "file" key("span");
