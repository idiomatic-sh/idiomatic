let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let references = project(from="reference", columns=["file", "span", "target"]);
let imports = project(from="static-import", columns=["file", "span", "target"]);
let mentions = union(left=references, right=imports);
let files = select * from mentions where glob_any(target, "{std::fs,std::fs::*,tokio::fs,tokio::fs::*,fs::read,fs::read_to_string,fs::write,fs::copy,fs::rename,fs::remove_file,fs::remove_dir,fs::remove_dir_all,fs::create_dir,fs::create_dir_all,fs::read_dir,fs::metadata,fs::symlink_metadata,fs::canonicalize,fs::hard_link,fs::read_link,fs::set_permissions,fs::File,fs::File::*,fs::OpenOptions,fs::OpenOptions::*}");
let ambient = select * from mentions where glob_any(target, "{std::env::current_dir,std::env::set_current_dir,env::current_dir,env::set_current_dir,cap_std::ambient_authority,ambient_authority,*::ambient_authority,*open_ambient_dir,*Path::exists,*Path::try_exists,*Path::is_file,*Path::is_dir,*Path::is_symlink,*PathBuf::exists,*PathBuf::try_exists,*PathBuf::is_file,*PathBuf::is_dir,*PathBuf::is_symlink}");
let world = union(left=files, right=ambient);
let processes = select * from mentions where glob_any(target, "{std::process::Command,std::process::Command::*,process::Command,process::Command::*,std::process::exit,process::exit,std::process::abort,process::abort,tokio::process,tokio::process::*,std::net::TcpStream,std::net::TcpStream::*,std::net::TcpListener,std::net::TcpListener::*,std::net::UdpSocket,std::net::UdpSocket::*,net::TcpStream,net::TcpStream::*,net::TcpListener,net::TcpListener::*,net::UdpSocket,net::UdpSocket::*,tokio::net,tokio::net::*}");
let paths = union(left=world, right=processes);
let query-names = select * from tree-tokens where glob_any(text, "{exists,try_exists,is_file,is_dir,is_symlink}");
let query-idents = select * from query-names where kind = "ident";
let ident-parents = select r."parent" as "parent", l."file" as "file", l."span" as "span", l."text" as "target" from query-idents as l join "syntax-child" as r on l."id" = r."child";
let name-refs = select * from tree-nodes where kind = "name-ref";
let ident-names = select l."parent" as "name", l."file" as "file", l."span" as "span", l."target" as "target" from ident-parents as l join name-refs as r on l."parent" = r."id";
let name-parents = select r."parent" as "call", l."file" as "file", l."span" as "span", l."target" as "target" from ident-names as l join "syntax-child" as r on l."name" = r."child";
let method-calls = select * from tree-nodes where kind = "method-call-expr";
let named-calls = select l."call" as "call", l."file" as "file", l."span" as "span", l."target" as "target" from name-parents as l join method-calls as r on l."call" = r."id";
let call-children = select r."child" as "child", l."file" as "file", l."span" as "span", l."target" as "target" from named-calls as l join "syntax-child" as r on l."call" = r."parent";
let arg-lists = select * from tree-nodes where kind = "arg-list";
let call-arguments = select l."child" as "arguments", l."file" as "file", l."span" as "span", l."target" as "target" from call-children as l join arg-lists as r on l."child" = r."id";
let argument-children = select l."id" as "arguments", r."child" as "child" from arg-lists as l join "syntax-child" as r on l."id" = r."parent";
let argument-nodes = select l."arguments" as "arguments" from argument-children as l join tree-nodes as r on l."child" = r."id";
let empty-calls = antijoin(left=call-arguments, right=argument-nodes, left-on=["arguments"], right-on=["arguments"]);
let path-queries = project(from=empty-calls, columns=["file", "span", "target"]);
let reaches = union(left=paths, right=path-queries);
emit reaches subject "file" key("span");
