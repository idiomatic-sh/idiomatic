let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let items = select * from tree-nodes where glob_any(kind, "{struct,enum,trait,union,type-alias,type-param}");
let item-children = select r."child" as "child", l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from items as l join "syntax-child" as r on l."id" = r."parent";
let names = select * from tree-nodes where kind = "name";
let item-names = select l."id" as "id", l."kind" as "kind", r."id" as "name-node", l."file" as "file", l."span" as "span" from item-children as l join names as r on l."child" = r."id";
let name-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", r."child" as "token" from item-names as l join "syntax-child" as r on l."name-node" = r."parent";
let nominal = select l."id" as "id", l."kind" as "kind", r."text" as "name", l."file" as "file", l."span" as "span" from name-tokens as l join tree-tokens as r on l."token" = r."id";
let types = select * from nominal where glob_any(kind, "{struct,enum,trait}");
let declarations = capture(from=types, path="file", pattern="{*parent}/{crate}/src/{*rest}", captures=["parent", "crate", "rest"]);
let name-counts = group-count(from=nominal, keys=["name"], count="declarations", distinct="id");
let ambiguous = select * from name-counts where declarations > 1;
let unique = antijoin(left=declarations, right=ambiguous, left-on=["name"], right-on=["name"]);
let identifiers = select * from tree-tokens where kind = "ident";
let identifier-parents = select r."parent" as "parent", l."file" as "file", l."text" as "target" from identifiers as l join "syntax-child" as r on l."id" = r."child";
let name-refs = select * from tree-nodes where kind = "name-ref";
let mentions = select l."file" as "file", l."target" as "target" from identifier-parents as l join name-refs as r on l."parent" = r."id";
let uses = capture(from=mentions, path="file", pattern="{*parent}/{crate}/src/{*rest}", captures=["parent", "crate", "rest"]);
let home-uses = project(from=uses, columns=["target", "parent", "crate"]);
let unused-at-home = antijoin(left=unique, right=home-uses, left-on=["name", "parent", "crate"], right-on=["target", "parent", "crate"]);
let used-elsewhere = select l."kind" as "kind", l."name" as "name", l."file" as "file", l."span" as "span", r."file" as "user" from unused-at-home as l join uses as r on l."name" = r."target";
let users = group-count(from=used-elsewhere, keys=["file", "span", "name", "kind"], count="files", distinct="user");
emit users subject "file" key("span");
