let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let boxed = select * from "annotates" where glob_any(annotation, "*Box<dyn *Error*");
let annotation-nodes = select l."annotation" as "annotation", r."id" as "id", l."file" as "file", l."span" as "span" from boxed as l join tree-nodes as r on l."file" = r."file" and l."span" = r."span";
let test-tokens = select * from tree-tokens where text = "test";
let test-token-parents = select r."parent" as "id" from test-tokens as l join "syntax-child" as r on l."id" = r."child";
let attributes = select * from tree-nodes where kind = "attr";
let test-attributes = axis(from=test-token-parents, relation="syntax-child", direction=nearest-ancestor, domain=attributes);
let test-attribute-owners = select r."parent" as "item" from test-attributes as l join "syntax-child" as r on l."related" = r."child";
let test-item-ids = select r."id" as "id" from test-attribute-owners as l join tree-nodes as r on l."item" = r."id";
let in-tests = axis(from=annotation-nodes, relation="syntax-child", direction=ancestor, domain=test-item-ids);
let in-test-spans = project(from=in-tests, columns=["file", "span"]);
let production = antijoin(left=boxed, right=in-test-spans, left-on=["file", "span"], right-on=["file", "span"]);
let annotations = project(from=production, columns=["file", "span", "annotation"]);
emit annotations subject "file" key("span");
