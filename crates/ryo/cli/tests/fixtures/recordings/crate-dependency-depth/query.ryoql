param kinds: set<string>;
param max-reach: integer;
let analyzed-files = select l."path" as "file" from "analyzed-source" as l;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let counted = select * from "package-dependency" where kind in $kinds;
let dependencies = project(from=counted, columns=["source", "target"]);
let documents = select * from tree-nodes where kind = "toml";
let manifests = project(from=documents, columns=["id", "file", "span"]);
let from-manifests = select r."id" as "from", l."target" as "target" from dependencies as l join manifests as r on l."source" = r."file";
let edges = select l."from" as "from", r."id" as "to" from from-manifests as l join manifests as r on l."target" = r."file";
let reach = closure(edges=edges, source="from", destination="to");
let others = select * from reach where from != to;
let reach-counts = group-count(from=others, keys=["from"], count="reached", distinct="to");
let wide = select * from reach-counts where reached > $max-reach;
let members = select l."package" as "file" from "workspace-member" as l join analyzed-files as r on l."package" = r."file";
let member-manifests = select l."id" as "id", l."file" as "file", l."span" as "span" from manifests as l join members as r on l."file" = r."file";
let wide-members = select r."file" as "file", l."reached" as "reached", r."span" as "span" from wide as l join member-manifests as r on l."from" = r."id";
emit wide-members subject "file" key("file");
