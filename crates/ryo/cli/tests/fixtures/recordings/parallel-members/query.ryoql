param independent: set<string>;
param roles: set<string>;
let modules = capture(from="filesystem.file", path="path", pattern="{*parent}/{name}.rs", captures=["parent", "name"]);
let directories = capture(from="filesystem.file", path="path", pattern="{*parent}/{name}/{file}", captures=["parent", "name", "file"]);
let directory-names = project(from=directories, columns=["parent", "name"]);
let nested-members = select l."name" as "name", l."parent" as "parent", l."path" as "path" from modules as l join directory-names as r on l."parent" = r."parent" and l."name" = r."name";
let root-modules = capture(from="filesystem.file", path="path", pattern="{name}.rs", captures=["name"]);
let root-directories = capture(from="filesystem.file", path="path", pattern="{name}/{file}", captures=["name", "file"]);
let root-directory-names = project(from=root-directories, columns=["name"]);
let root-names = select l."name" as "name", l."path" as "path" from root-modules as l join root-directory-names as r on l."name" = r."name";
let root-members = extend(from=root-names, values={"parent": ""});
let members = union(left=nested-members, right=root-members);
let named-members = select * from members where name not in $roles;
let pairs = select r."parent" as "counterpart", l."name" as "name", r."path" as "other", l."parent" as "parent", l."path" as "path" from named-members as l join named-members as r on l."name" = r."name";
let distinct-pairs = select * from pairs where parent != counterpart;
let inner-directories = capture(from=named-members, path="path", pattern="{*above}/{directory}/{*below}", captures=["above", "directory", "below"]);
let inner-independent = select * from inner-directories where directory in $independent;
let inner-dependent = antijoin(left=named-members, right=inner-independent, left-on=["path"], right-on=["path"]);
let first-directories = capture(from=inner-dependent, path="path", pattern="{directory}/{*below}", captures=["directory", "below"]);
let first-independent = select * from first-directories where directory in $independent;
let dependent = antijoin(left=inner-dependent, right=first-independent, left-on=["path"], right-on=["path"]);
let left-dependent = select l."counterpart" as "counterpart", l."name" as "name", l."other" as "other", l."parent" as "parent", l."path" as "path" from distinct-pairs as l join dependent as r on l."path" = r."path";
let right-dependent = select l."counterpart" as "counterpart", l."name" as "name", l."other" as "other", l."parent" as "parent", l."path" as "path" from distinct-pairs as l join dependent as r on l."other" = r."path";
let dependent-pairs = union(left=left-dependent, right=right-dependent);
let shared-names = group-count(from=dependent-pairs, keys=["parent", "counterpart"], count="shared", distinct="name");
let split-parents = select * from shared-names where shared >= 3;
let split-members = select l."name" as "name", l."other" as "other", l."path" as "path" from dependent-pairs as l join split-parents as r on l."parent" = r."parent" and l."counterpart" = r."counterpart";
emit split-members subject "path" key("path", "other");
