let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let names = select * from tree-tokens where glob_any(text, "{unwrap,expect}");
let name-parents = select r."parent" as "name", l."text" as "text" from names as l join "syntax-child" as r on l."id" = r."child";
let name-calls = select r."parent" as "call", l."text" as "text" from name-parents as l join "syntax-child" as r on l."name" = r."child";
let calls = select * from tree-nodes where kind = "method-call-expr";
let method-calls = select r."id" as "id", r."file" as "file", r."span" as "span", l."text" as "text" from name-calls as l join calls as r on l."call" = r."id";
let test-tokens = select * from tree-tokens where text = "test";
let test-token-parents = select r."parent" as "id" from test-tokens as l join "syntax-child" as r on l."id" = r."child";
let attributes = select * from tree-nodes where kind = "attr";
let test-token-attributes = axis(from=test-token-parents, relation="syntax-child", direction=nearest-ancestor, domain=attributes);
let test-attribute-owners = select r."parent" as "item" from test-token-attributes as l join "syntax-child" as r on l."related" = r."child";
let test-items = select r."id" as "id" from test-attribute-owners as l join tree-nodes as r on l."item" = r."id";
let calls-in-tests = axis(from=method-calls, relation="syntax-child", direction=ancestor, domain=test-items);
let production-calls = antijoin(left=method-calls, right=calls-in-tests, left-on=["id"], right-on=["id"]);
emit production-calls subject "file" key("span");
