let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let enums = select * from tree-nodes where kind = "enum";
let enum-nodes = select l."id" as "node", l."file" as "file", l."span" as "span" from enums as l join enums as r on l."id" = r."id";
let enum-names-edges = select r."child" as "child", l."file" as "file", l."span" as "span" from enum-nodes as l join "syntax-child" as r on l."node" = r."parent";
let names = select * from tree-nodes where kind = "name";
let enum-names = select r."id" as "node", l."file" as "file", l."span" as "span" from enum-names-edges as l join names as r on l."child" = r."id";
let enum-name-tokens = select l."file" as "file", l."span" as "span", r."child" as "token" from enum-names as l join "syntax-child" as r on l."node" = r."parent";
let declared = select r."text" as "name", l."file" as "file", l."span" as "span" from enum-name-tokens as l join tree-tokens as r on l."token" = r."id";
let declarations = group-count(from=declared, keys=["name"], count="enums", distinct="span");
let ambiguous = select * from declarations where enums > 1;
let unique = antijoin(left=declared, right=ambiguous, left-on=["name"], right-on=["name"]);
let patterns = select * from tree-nodes where glob_any(kind, "{path-pat,tuple-struct-pat,record-pat}");
let pattern-owners = select * from tree-nodes where glob_any(kind, "{match-arm,let-stmt,let-expr,param,for-expr}");
let owned-patterns = axis(from=patterns, relation="syntax-child", direction=nearest-ancestor, domain=pattern-owners);
let arms = select * from tree-nodes where kind = "match-arm";
let arm-patterns = select l."id" as "node", l."file" as "user" from owned-patterns as l join arms as r on l."related" = r."id";
let variant-paths-edges = select r."child" as "child", l."user" as "user" from arm-patterns as l join "syntax-child" as r on l."node" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let variant-paths = select r."id" as "node", l."user" as "user" from variant-paths-edges as l join paths as r on l."child" = r."id";
let qualifiers-edges = select r."child" as "child", l."user" as "user" from variant-paths as l join "syntax-child" as r on l."node" = r."parent";
let qualifiers = select r."id" as "node", l."user" as "user" from qualifiers-edges as l join paths as r on l."child" = r."id";
let qualifier-segments-edges = select r."child" as "child", l."user" as "user" from qualifiers as l join "syntax-child" as r on l."node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let qualifier-segments = select r."id" as "node", l."user" as "user" from qualifier-segments-edges as l join segments as r on l."child" = r."id";
let qualifier-names-edges = select r."child" as "child", l."user" as "user" from qualifier-segments as l join "syntax-child" as r on l."node" = r."parent";
let name-references = select * from tree-nodes where kind = "name-ref";
let qualifier-names = select r."id" as "node", l."user" as "user" from qualifier-names-edges as l join name-references as r on l."child" = r."id";
let qualifier-tokens = select r."child" as "token", l."user" as "user" from qualifier-names as l join "syntax-child" as r on l."node" = r."parent";
let qualifier-texts = select r."text" as "name", l."user" as "user" from qualifier-tokens as l join tree-tokens as r on l."token" = r."id";
let uses = select l."name" as "name", l."file" as "file", l."span" as "span", r."user" as "user" from unique as l join qualifier-texts as r on l."name" = r."name";
let declared-in = capture(from=uses, path="file", pattern="{*directory}/{file}", captures=["directory", "file"]);
let user-directories = capture(from=declared-in, path="user", pattern="{*ancestor}/{*rest}", captures=["ancestor", "rest"]);
let inside = select * from user-directories where ancestor = directory;
let outside = antijoin(left=declared-in, right=inside, left-on=["file", "span", "user"], right-on=["file", "span", "user"]);
let users = group-count(from=outside, keys=["file", "span", "name"], count="files", distinct="user");
let scattered = select * from users where files >= 3;
let scattered-uses = select l."name" as "name", l."file" as "file", l."span" as "span", l."user" as "user" from outside as l join scattered as r on l."file" = r."file" and l."span" = r."span" and l."name" = r."name";
emit scattered-uses subject "file" key("span", "user");
