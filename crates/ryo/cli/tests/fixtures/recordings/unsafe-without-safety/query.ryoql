let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let keywords = select * from tree-tokens where kind = "unsafe-kw";
let keyword-owners = select r."parent" as "id" from keywords as l join "syntax-child" as r on l."id" = r."child";
let owner-nodes = select r."id" as "id", r."kind" as "kind", r."file" as "file", r."span" as "span" from keyword-owners as l join tree-nodes as r on l."id" = r."id";
let block-nodes = select * from owner-nodes where kind = "block-expr";
let blocks = extend(from=block-nodes, values={"what": "block"});
let impl-nodes = select * from owner-nodes where kind = "impl";
let impls = extend(from=impl-nodes, values={"what": "impl"});
let unsafe-nodes = union(left=blocks, right=impls);
let unsafes = project(from=unsafe-nodes, columns=["id", "file", "span", "what"]);
let selves = select l."id" as "id", l."file" as "file", r."id" as "related", l."span" as "span", l."what" as "what" from unsafes as l join tree-nodes as r on l."id" = r."id";
let ancestors = axis(from=unsafes, relation="syntax-child", direction=ancestor, domain=tree-nodes);
let holders = union(left=selves, right=ancestors);
let holder-positions = select l."related" as "holder", l."id" as "id", r."parent" as "list", r."ordinal" as "position" from holders as l join "syntax-child" as r on l."related" = r."child";
let comments = select * from tree-tokens where kind = "comment";
let safety-comments = select * from comments where glob_any(text, "*SAFETY:*");
let comment-positions = select l."id" as "comment", r."parent" as "list", r."ordinal" as "position" from safety-comments as l join "syntax-child" as r on l."id" = r."child";
let inside = select r."comment" as "comment", r."position" as "comment-position", l."holder" as "holder", l."id" as "id" from holder-positions as l join comment-positions as r on l."holder" = r."list";
let inside-children = select r."child" as "child", l."comment" as "comment", l."comment-position" as "comment-position", l."holder" as "holder", l."id" as "id", r."ordinal" as "position" from inside as l join "syntax-child" as r on l."holder" = r."parent";
let inside-nodes = select l."comment" as "comment", l."comment-position" as "comment-position", l."id" as "id", r."kind" as "kind", l."position" as "position" from inside-children as l join tree-nodes as r on l."child" = r."id";
let inside-non-attributes = select * from inside-nodes where kind != "attr";
let nodes-before = select * from inside-non-attributes where position < comment-position;
let leading = antijoin(left=inside, right=nodes-before, left-on=["id", "comment"], right-on=["id", "comment"]);
let items = select * from tree-nodes where glob_any(kind, "{fn,impl,const,static,struct,enum,union,trait,module,type-alias,macro-rules,let-stmt,expr-stmt,block-expr}");
let attached = select l."id" as "id" from leading as l join items as r on l."holder" = r."id";
let earlier-pairs = select r."comment" as "comment", r."position" as "comment-position", l."position" as "holder-position", l."id" as "id", l."list" as "list" from holder-positions as l join comment-positions as r on l."list" = r."list";
let earlier = select * from earlier-pairs where comment-position < holder-position;
let siblings = select l."comment" as "comment", l."comment-position" as "comment-position", l."holder-position" as "holder-position", l."id" as "id", r."ordinal" as "position", r."child" as "sibling" from earlier as l join "syntax-child" as r on l."list" = r."parent";
let node-siblings = select l."comment" as "comment", l."comment-position" as "comment-position", l."holder-position" as "holder-position", l."id" as "id", l."position" as "position" from siblings as l join tree-nodes as r on l."sibling" = r."id";
let after-comment = select * from node-siblings where position > comment-position;
let between = select * from after-comment where position < holder-position;
let direct = antijoin(left=earlier, right=between, left-on=["id", "comment"], right-on=["id", "comment"]);
let direct-ids = project(from=direct, columns=["id"]);
let documented = union(left=attached, right=direct-ids);
let undocumented = antijoin(left=unsafes, right=documented, left-on=["id"], right-on=["id"]);
emit undocumented subject "file" key("span");
