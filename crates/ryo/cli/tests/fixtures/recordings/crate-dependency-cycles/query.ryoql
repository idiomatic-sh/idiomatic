param kinds: set<string>;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let counted = select * from "package-dependency" where kind in $kinds;
let documents = select * from tree-nodes where kind = "toml";
let manifests = project(from=documents, columns=["id", "file", "span"]);
let from-manifests = select r."id" as "from", l."target" as "target" from counted as l join manifests as r on l."source" = r."file";
let edges = select l."from" as "from", r."id" as "to" from from-manifests as l join manifests as r on l."target" = r."file";
let cyclic = cycles(edges=edges, source="from", destination="to");
let on-cycle = project(from=cyclic, columns=["from"]);
let reported = select r."file" as "file", r."span" as "span" from on-cycle as l join manifests as r on l."from" = r."id";
emit reported subject "file" key("file");
