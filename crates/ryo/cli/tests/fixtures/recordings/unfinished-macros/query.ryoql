let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let names = select * from tree-tokens where glob_any(text, "{todo,unimplemented,dbg}");
let name-refs = select r."parent" as "node", l."text" as "text" from names as l join "syntax-child" as r on l."id" = r."child";
let segments = select r."parent" as "node", l."text" as "text" from name-refs as l join "syntax-child" as r on l."node" = r."child";
let paths = select r."parent" as "node", l."text" as "text" from segments as l join "syntax-child" as r on l."node" = r."child";
let owners = select r."parent" as "node", l."text" as "text" from paths as l join "syntax-child" as r on l."node" = r."child";
let macro-calls = select * from tree-nodes where kind = "macro-call";
let unfinished = select r."file" as "file", r."span" as "span", l."text" as "text" from owners as l join macro-calls as r on l."node" = r."id";
emit unfinished subject "file" key("span");
