let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let matches = select * from tree-nodes where kind = "match-expr";
let arm-lists = select r."child" as "list", l."id" as "match", l."file" as "file", l."span" as "span" from matches as l join "syntax-child" as r on l."id" = r."parent";
let arm-edges = select r."child" as "arm", l."match" as "match", l."file" as "file", l."span" as "span" from arm-lists as l join "syntax-child" as r on l."list" = r."parent";
let arm-nodes = select * from tree-nodes where kind = "match-arm";
let arms = select l."arm" as "arm", l."match" as "match", l."file" as "file", l."span" as "span" from arm-edges as l join arm-nodes as r on l."arm" = r."id";
let booleans = select * from tree-tokens where glob_any(kind, "{true-kw,false-kw}");
let boolean-literals = select r."parent" as "literal" from booleans as l join "syntax-child" as r on l."id" = r."child";
let boolean-patterns = select r."parent" as "pattern" from boolean-literals as l join "syntax-child" as r on l."literal" = r."child";
let literal-patterns = select * from tree-nodes where kind = "literal-pat";
let boolean-literal-patterns = select r."id" as "pattern" from boolean-patterns as l join literal-patterns as r on l."pattern" = r."id";
let boolean-arms = select r."parent" as "arm" from boolean-literal-patterns as l join "syntax-child" as r on l."pattern" = r."child";
let boolean-matches = select l."match" as "match", l."file" as "file", l."span" as "span" from arms as l join boolean-arms as r on l."arm" = r."arm";
let wildcards = select * from tree-nodes where kind = "wildcard-pat";
let wildcard-arms = select r."parent" as "arm" from wildcards as l join "syntax-child" as r on l."id" = r."child";
let simple-arms = union(left=boolean-arms, right=wildcard-arms);
let other-arms = antijoin(left=arms, right=simple-arms, left-on=["arm"], right-on=["arm"]);
let only-simple = antijoin(left=boolean-matches, right=other-arms, left-on=["match"], right-on=["match"]);
let arm-counts = group-count(from=arms, keys=["match"], count="arms");
let small = select * from arm-counts where arms <= 2;
let boolean-ifs = select l."file" as "file", l."span" as "span" from only-simple as l join small as r on l."match" = r."match";
emit boolean-ifs subject "file" key("span");
