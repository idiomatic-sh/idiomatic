let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let errors = select * from "defines" where glob_any(name, "*Error");
let enums = select * from errors where kind = "enum";
let names = select * from tree-nodes where kind = "name";
let enum-names = select l."name" as "enum", r."id" as "name" from enums as l join names as r on l."file" = r."file" and l."span" = r."span";
let enum-nodes = select l."enum" as "enum", r."parent" as "id" from enum-names as l join "syntax-child" as r on l."name" = r."child";
let variants = select * from tree-nodes where kind = "variant";
let enum-variants = axis(from=enum-nodes, relation="syntax-child", direction=descendant, domain=variants);
let variant-children = select r."child" as "child", l."enum" as "enum" from enum-variants as l join "syntax-child" as r on l."related" = r."parent";
let variant-names = select l."enum" as "enum", r."id" as "name", r."file" as "file", r."span" as "span" from variant-children as l join names as r on l."child" = r."id";
let variant-tokens = select l."enum" as "enum", l."file" as "file", l."span" as "span", r."child" as "token" from variant-names as l join "syntax-child" as r on l."name" = r."parent";
let declared = select l."enum" as "enum", l."file" as "file", l."span" as "span", r."text" as "variant" from variant-tokens as l join tree-tokens as r on l."token" = r."id";
let expressions = select * from tree-nodes where glob_any(kind, "{path-expr,record-expr}");
let expression-children = select r."child" as "child" from expressions as l join "syntax-child" as r on l."id" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let expression-paths = select r."id" as "file" from expression-children as l join paths as r on l."child" = r."id";
let path-children = select r."child" as "child", l."id" as "file" from paths as l join "syntax-child" as r on l."id" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let path-segments = select l."file" as "file", r."id" as "segment" from path-children as l join segments as r on l."child" = r."id";
let segment-children = select r."child" as "child", l."file" as "file" from path-segments as l join "syntax-child" as r on l."segment" = r."parent";
let name-refs = select * from tree-nodes where kind = "name-ref";
let segment-names = select r."id" as "name", l."file" as "file" from segment-children as l join name-refs as r on l."child" = r."id";
let name-children = select l."file" as "file", r."child" as "token" from segment-names as l join "syntax-child" as r on l."name" = r."parent";
let path-last = select l."file" as "file", r."text" as "text" from name-children as l join tree-tokens as r on l."token" = r."id";
let constructed-variants = select l."file" as "file", r."text" as "variant" from expression-paths as l join path-last as r on l."file" = r."file";
let qualifiers = select l."file" as "file", r."id" as "qualifier" from path-children as l join paths as r on l."child" = r."id";
let qualifier-texts = select l."file" as "file", r."text" as "qualifier" from qualifiers as l join path-last as r on l."qualifier" = r."file";
let constructions = select r."qualifier" as "qualifier", l."variant" as "variant" from constructed-variants as l join qualifier-texts as r on l."file" = r."file";
let named-constructions = project(from=constructions, columns=["qualifier", "variant"]);
let by-name = select l."file" as "file", l."span" as "span" from declared as l join named-constructions as r on l."enum" = r."qualifier" and l."variant" = r."variant";
let self-constructions = select * from named-constructions where qualifier = "Self";
let by-self = select l."file" as "file", l."span" as "span" from declared as l join self-constructions as r on l."variant" = r."variant";
let constructed = union(left=by-name, right=by-self);
let never-constructed = antijoin(left=declared, right=constructed, left-on=["file", "span"], right-on=["file", "span"]);
emit never-constructed subject "file" key("span");
