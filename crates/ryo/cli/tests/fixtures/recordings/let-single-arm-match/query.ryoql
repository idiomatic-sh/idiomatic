let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let lets = select * from tree-nodes where kind = "let-stmt";
let matches = select * from tree-nodes where kind = "match-expr";
let let-matches = axis(from=lets, relation="syntax-child", direction=child, domain=matches);
let arms = select * from tree-nodes where kind = "match-arm";
let arm-lists = select * from tree-nodes where kind = "match-arm-list";
let arm-parents = axis(from=arms, relation="syntax-child", direction=parent, domain=arm-lists);
let arm-counts = group-count(from=arm-parents, keys=["related"], count="arms", distinct="id");
let single-arm-lists = select * from arm-counts where arms = 1;
let list-owners = select r."parent" as "match" from single-arm-lists as l join "syntax-child" as r on l."related" = r."child";
let single-arm-lets = select l."file" as "file", l."span" as "span" from let-matches as l join list-owners as r on l."related" = r."match";
emit single-arm-lets subject "file" key("span");
