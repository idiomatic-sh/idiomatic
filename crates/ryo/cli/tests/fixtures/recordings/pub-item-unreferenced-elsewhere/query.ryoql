let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let declarations = select * from "defines" where kind != "variable";
let names = select * from tree-nodes where kind = "name";
let declaration-names = select l."kind" as "kind", l."name" as "name", r."id" as "node", l."file" as "file", l."span" as "span" from declarations as l join names as r on l."file" = r."file" and l."span" = r."span";
let declaration-items = select r."parent" as "item", l."kind" as "kind", l."name" as "name", l."file" as "file", l."span" as "span" from declaration-names as l join "syntax-child" as r on l."node" = r."child";
let visibilities = select * from tree-nodes where kind = "visibility";
let restrictions = select * from tree-nodes where kind = "visibility-inner";
let restricted = select l."parent" as "id" from "syntax-child" as l join restrictions as r on l."child" = r."id";
let public = antijoin(left=visibilities, right=restricted, left-on=["id"], right-on=["id"]);
let public-owners = select l."parent" as "item" from "syntax-child" as l join public as r on l."child" = r."id";
let public-declarations = select l."kind" as "kind", l."name" as "name", l."file" as "file", l."span" as "span" from declaration-items as l join public-owners as r on l."item" = r."item";
let identifiers = select * from tree-tokens where kind = "ident";
let mentions = project(from=identifiers, columns=["file", "text"]);
let named = select l."file" as "file", l."span" as "span", r."file" as "user" from public-declarations as l join mentions as r on l."name" = r."text";
let named-elsewhere = select * from named where user != file;
let unreferenced = antijoin(left=public-declarations, right=named-elsewhere, left-on=["file", "span"], right-on=["file", "span"]);
emit unreferenced subject "file" key("span");
