let imports = project(from="static-import", columns=["occurrence", "file", "span", "target"]);
let references = project(from="reference", columns=["occurrence", "file", "span", "target"]);
let mentions = union(left=imports, right=references);
let pools = select * from mentions where glob_any(target, "{std::thread,std::thread::[*],std::thread::scope,std::thread::spawn,std::thread::Builder,std::thread::Builder::*,std::thread::available_parallelism,rayon::ThreadPoolBuilder,rayon::ThreadPoolBuilder::*,rayon::ThreadPool::*,rayon::spawn,rayon::spawn_fifo,rayon::scope,rayon::scope_fifo,rayon::in_place_scope}");
emit pools subject "file" key("span");
