param layers: ListOfSets(String);
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let shipped = select * from "package-dependency" where kind != "dev";
let edges = project(from=shipped, columns=["source", "target"]);
let sources = capture(from=edges, path="source", pattern="{*parent}/{from}/Cargo.toml", captures=["parent", "from"]);
let targets = capture(from=sources, path="target", pattern="{*target-parent}/{to}/Cargo.toml", captures=["target-parent", "to"]);
let ranked-sources = rank(from=targets, column="from", sets=$layers, output="from-layer");
let ranked = rank(from=ranked-sources, column="to", sets=$layers, output="to-layer");
let upward = select * from ranked where to-layer < from-layer;
let documents = select * from tree-nodes where kind = "toml";
let manifests = project(from=documents, columns=["file", "span"]);
let located = select l."from" as "from", l."source" as "file", r."span" as "span", l."to" as "to" from upward as l join manifests as r on l."source" = r."file";
emit located subject "file" key("file", "to");
