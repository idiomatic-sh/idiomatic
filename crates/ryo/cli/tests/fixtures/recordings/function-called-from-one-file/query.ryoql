let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let function-names = group-count(from="function", keys=["name"], count="declarations", distinct="id");
let unique-names = select * from function-names where declarations < 2;
let unique-functions = select l."name" as "name", l."file" as "file", l."span" as "span" from "function" as l join unique-names as r on l."name" = r."name";
let callee-nodes = select * from tree-nodes where glob_any(kind, "{path,name-ref}");
let callees = select l."file" as "caller", r."kind" as "kind", r."id" as "node" from "static-call" as l join callee-nodes as r on l."file" = r."file" and l."span" = r."span";
let method-names = select * from callees where kind = "name-ref";
let method-name-refs = project(from=method-names, columns=["caller", "node"]);
let path-segments = select l."caller" as "caller", r."child" as "child" from callees as l join "syntax-child" as r on l."node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let last-segments = select l."caller" as "caller", r."id" as "segment" from path-segments as l join segments as r on l."child" = r."id";
let segment-children = select l."caller" as "caller", r."child" as "child" from last-segments as l join "syntax-child" as r on l."segment" = r."parent";
let name-refs = select * from tree-nodes where kind = "name-ref";
let segment-names = select l."caller" as "caller", r."id" as "node" from segment-children as l join name-refs as r on l."child" = r."id";
let path-name-refs = project(from=segment-names, columns=["caller", "node"]);
let called-name-refs = union(left=method-name-refs, right=path-name-refs);
let called-tokens = select l."caller" as "caller", r."child" as "token" from called-name-refs as l join "syntax-child" as r on l."node" = r."parent";
let called-names = select l."caller" as "caller", r."text" as "name" from called-tokens as l join tree-tokens as r on l."token" = r."id";
let calls = select r."caller" as "caller", l."name" as "name", l."file" as "file", l."span" as "span" from unique-functions as l join called-names as r on l."name" = r."name";
let foreign-calls = select * from calls where caller != file;
let caller-files = group-count(from=foreign-calls, keys=["file", "span", "name"], count="files", distinct="caller");
let one-caller = select * from caller-files where files <= 1;
let home-calls = select * from calls where caller = file;
let only-foreign = antijoin(left=one-caller, right=home-calls, left-on=["file", "span"], right-on=["file", "span"]);
let reported = select r."caller" as "caller", l."name" as "name", l."file" as "file", l."span" as "span" from only-foreign as l join foreign-calls as r on l."file" = r."file" and l."span" = r."span";
emit reported subject "file" key("span");
