param max-lines: integer;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let functions = select * from tree-nodes where kind = "fn";
let function-nodes = axis(from=functions, relation="syntax-child", direction=descendant, domain=tree-nodes);
let function-edges = select r."child" as "child", l."id" as "id", l."file" as "file", l."span" as "span" from function-nodes as l join "syntax-child" as r on l."related" = r."parent";
let line-breaks = select * from tree-tokens where glob_any(text, "*
*");
let function-breaks = select l."id" as "id", l."file" as "file", l."span" as "span", r."id" as "token" from function-edges as l join line-breaks as r on l."child" = r."id";
let counted = group-count(from=function-breaks, keys=["id", "file", "span"], count="lines", distinct="token");
let long = select * from counted where $max-lines < lines;
emit long subject "file" key("span");
