param min-tokens: integer;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let fn-nodes = select * from tree-nodes where kind = "fn";
let functions = select l."id" as "function", r."id" as "id", l."name" as "name", l."file" as "file", l."span" as "span" from "function" as l join fn-nodes as r on l."file" = r."file" and l."span" = r."span";
let function-nodes = axis(from=functions, relation="syntax-child", direction=descendant, domain=tree-nodes);
let function-token-edges = select r."child" as "child", l."function" as "function", l."name" as "name", l."file" as "file", l."span" as "span" from function-nodes as l join "syntax-child" as r on l."related" = r."parent";
let significant = select * from tree-tokens where kind != "whitespace";
let code-tokens = select * from significant where kind != "comment";
let function-tokens = select l."function" as "function", l."name" as "name", l."file" as "file", l."span" as "span", r."text" as "text", r."id" as "token" from function-token-edges as l join code-tokens as r on l."child" = r."id";
let token-counts = group-count(from=function-tokens, keys=["function", "file", "span", "name"], count="tokens", distinct="token");
let large = select * from token-counts where tokens >= $min-tokens;
let same-name = select l."function" as "function", l."name" as "name", r."function" as "other", r."file" as "other-path", l."file" as "file", l."span" as "span" from large as l join large as r on l."name" = r."name";
let pairs = select * from same-name where other-path != file;
let texts = project(from=function-tokens, columns=["function", "text"]);
let own-texts = select l."function" as "function", l."other" as "other", r."text" as "text" from pairs as l join texts as r on l."function" = r."function";
let own-only = antijoin(left=own-texts, right=texts, left-on=["other", "text"], right-on=["function", "text"]);
let own-mismatches = project(from=own-only, columns=["function", "other"]);
let other-texts = select l."function" as "function", l."other" as "other", r."text" as "text" from pairs as l join texts as r on l."other" = r."function";
let other-only = antijoin(left=other-texts, right=texts, left-on=["function", "text"], right-on=["function", "text"]);
let other-mismatches = project(from=other-only, columns=["function", "other"]);
let mismatches = union(left=own-mismatches, right=other-mismatches);
let copies = antijoin(left=pairs, right=mismatches, left-on=["function", "other"], right-on=["function", "other"]);
let copied-files = project(from=copies, columns=["file", "span", "name", "other-path"]);
emit copied-files subject "file" key("span", "other-path");
