param allowed: set<string>;
let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let stars = select * from tree-tokens where kind = "star";
let star-trees = select r."parent" as "tree" from stars as l join "syntax-child" as r on l."id" = r."child";
let use-trees = select * from tree-nodes where kind = "use-tree";
let globs = select r."id" as "id", r."file" as "file", r."span" as "span" from star-trees as l join use-trees as r on l."tree" = r."id";
let glob-edges = select r."child" as "child", l."file" as "file", l."span" as "span" from globs as l join "syntax-child" as r on l."id" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let glob-paths = select r."id" as "node", l."file" as "file", l."span" as "span" from glob-edges as l join paths as r on l."child" = r."id";
let path-edges = select r."child" as "child", l."file" as "file", l."span" as "span" from glob-paths as l join "syntax-child" as r on l."node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let last-segments = select r."id" as "node", l."file" as "file", l."span" as "span" from path-edges as l join segments as r on l."child" = r."id";
let segment-edges = select r."child" as "node", l."file" as "file", l."span" as "span" from last-segments as l join "syntax-child" as r on l."node" = r."parent";
let name-edges = select l."file" as "file", l."span" as "span", r."child" as "token" from segment-edges as l join "syntax-child" as r on l."node" = r."parent";
let modules = select r."text" as "module", l."file" as "file", l."span" as "span" from name-edges as l join tree-tokens as r on l."token" = r."id";
let disallowed = select * from modules where module not in $allowed;
emit disallowed subject "file" key("span");
