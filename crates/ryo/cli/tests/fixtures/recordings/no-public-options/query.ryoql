let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let fields = select * from tree-nodes where glob_any(kind, "{record-field,tuple-field}");
let visibilities = select * from tree-nodes where kind = "visibility";
let restrictions = select * from tree-nodes where kind = "visibility-inner";
let restricted = select l."parent" as "id" from "syntax-child" as l join restrictions as r on l."child" = r."id";
let public = antijoin(left=visibilities, right=restricted, left-on=["id"], right-on=["id"]);
let public-owners = select l."parent" as "id" from "syntax-child" as l join public as r on l."child" = r."id";
let public-fields = select l."id" as "id", l."file" as "file", l."span" as "span" from fields as l join public-owners as r on l."id" = r."id";
let listed-fields = select l."id" as "id", r."parent" as "list", l."file" as "file", l."span" as "span" from public-fields as l join "syntax-child" as r on l."id" = r."child";
let structs = select * from tree-nodes where kind = "struct";
let public-structs = select l."id" as "id" from structs as l join public-owners as r on l."id" = r."id";
let field-lists = select r."child" as "list" from public-structs as l join "syntax-child" as r on l."id" = r."parent";
let struct-fields = select l."id" as "id", l."file" as "file", l."span" as "span" from listed-fields as l join field-lists as r on l."list" = r."list";
let field-types = select l."id" as "id", l."file" as "file", l."span" as "span", r."child" as "type" from struct-fields as l join "syntax-child" as r on l."id" = r."parent";
let path-types = select * from tree-nodes where kind = "path-type";
let typed-fields = select l."id" as "id", l."file" as "file", l."span" as "span", l."type" as "type" from field-types as l join path-types as r on l."type" = r."id";
let type-paths = select l."id" as "id", r."child" as "node", l."file" as "file", l."span" as "span" from typed-fields as l join "syntax-child" as r on l."type" = r."parent";
let paths = select * from tree-nodes where kind = "path";
let whole-paths = select l."id" as "id", l."node" as "node", l."file" as "file", l."span" as "span" from type-paths as l join paths as r on l."node" = r."id";
let path-children = select l."id" as "id", r."child" as "node", l."file" as "file", l."span" as "span" from whole-paths as l join "syntax-child" as r on l."node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let last-segments = select l."id" as "id", l."node" as "node", l."file" as "file", l."span" as "span" from path-children as l join segments as r on l."node" = r."id";
let segment-children = select l."id" as "id", r."child" as "node", l."file" as "file", l."span" as "span" from last-segments as l join "syntax-child" as r on l."node" = r."parent";
let name-refs = select * from tree-nodes where kind = "name-ref";
let segment-names = select l."id" as "id", l."node" as "node", l."file" as "file", l."span" as "span" from segment-children as l join name-refs as r on l."node" = r."id";
let name-tokens = select l."id" as "id", l."file" as "file", l."span" as "span", r."child" as "token" from segment-names as l join "syntax-child" as r on l."node" = r."parent";
let name-texts = select l."id" as "id", l."file" as "file", l."span" as "span", r."text" as "text" from name-tokens as l join tree-tokens as r on l."token" = r."id";
let optional-fields = select * from name-texts where text = "Option";
emit optional-fields subject "file" key("span");
