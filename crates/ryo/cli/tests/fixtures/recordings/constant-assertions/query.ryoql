let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let names = select * from tree-tokens where glob_any(text, "{assert,debug_assert}");
let name-refs = select r."parent" as "node" from names as l join "syntax-child" as r on l."id" = r."child";
let segments = select r."parent" as "node" from name-refs as l join "syntax-child" as r on l."node" = r."child";
let paths = select r."parent" as "node" from segments as l join "syntax-child" as r on l."node" = r."child";
let owners = select r."parent" as "node" from paths as l join "syntax-child" as r on l."node" = r."child";
let macro-calls = select * from tree-nodes where kind = "macro-call";
let assertions = select r."id" as "id", r."file" as "file", r."span" as "span" from owners as l join macro-calls as r on l."node" = r."id";
let call-trees = select l."id" as "id", l."file" as "file", l."span" as "span", r."child" as "tree" from macro-calls as l join "syntax-child" as r on l."id" = r."parent";
let trees = select * from tree-nodes where kind = "token-tree";
let argument-trees = select l."id" as "id", l."file" as "file", l."span" as "span", l."tree" as "tree" from call-trees as l join trees as r on l."tree" = r."id";
let first-edges = select * from "syntax-child" where ordinal = 1;
let first-arguments = select l."id" as "id", l."file" as "file", l."span" as "span", r."child" as "token", l."tree" as "tree" from argument-trees as l join first-edges as r on l."tree" = r."parent";
let booleans = select * from tree-tokens where glob_any(kind, "{true-kw,false-kw}");
let boolean-starts = select l."id" as "id", l."file" as "file", l."span" as "span", l."tree" as "tree" from first-arguments as l join booleans as r on l."token" = r."id";
let second-edges = select * from "syntax-child" where ordinal = 2;
let second-arguments = select l."id" as "id", l."file" as "file", l."span" as "span", r."child" as "token" from boolean-starts as l join second-edges as r on l."tree" = r."parent";
let ends = select * from tree-tokens where glob_any(kind, "{r-paren,r-brack,r-curly,comma}");
let constant-calls = select l."id" as "id", l."file" as "file", l."span" as "span" from second-arguments as l join ends as r on l."token" = r."id";
let constant-assertions = intersection(left=assertions, right=constant-calls);
emit constant-assertions subject "file" key("span");
