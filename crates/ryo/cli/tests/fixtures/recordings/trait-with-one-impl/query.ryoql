let tree-nodes = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span" from "syntax-tree" as l where l."text" = "";
let tree-tokens = select l."id" as "id", l."kind" as "kind", l."file" as "file", l."span" as "span", l."text" as "text" from "syntax-tree" as l where l."text" != "";
let traits = select * from "defines" where kind = "trait";
let trait-names = group-count(from=traits, keys=["name"], count="declarations", distinct="id");
let unique-names = select * from trait-names where declarations = 1;
let unique-traits = select l."name" as "name", l."file" as "file", l."span" as "span" from traits as l join unique-names as r on l."name" = r."name";
let paths = select * from tree-nodes where kind = "path";
let contracts = select r."id" as "node", l."occurrence" as "occurrence" from "inherits" as l join paths as r on l."file" = r."file" and l."span" = r."span";
let contract-children = select r."child" as "child", l."occurrence" as "occurrence" from contracts as l join "syntax-child" as r on l."node" = r."parent";
let segments = select * from tree-nodes where kind = "path-segment";
let last-segments = select l."occurrence" as "occurrence", r."id" as "segment" from contract-children as l join segments as r on l."child" = r."id";
let segment-children = select r."child" as "child", l."occurrence" as "occurrence" from last-segments as l join "syntax-child" as r on l."segment" = r."parent";
let name-refs = select * from tree-nodes where kind = "name-ref";
let segment-names = select r."id" as "name", l."occurrence" as "occurrence" from segment-children as l join name-refs as r on l."child" = r."id";
let name-tokens = select l."occurrence" as "occurrence", r."child" as "token" from segment-names as l join "syntax-child" as r on l."name" = r."parent";
let implemented = select l."occurrence" as "occurrence", r."text" as "trait" from name-tokens as l join tree-tokens as r on l."token" = r."id";
let implementations = group-count(from=implemented, keys=["trait"], count="impls", distinct="occurrence");
let single = select * from implementations where impls = 1;
let single-implementation = select l."name" as "name", l."file" as "file", l."span" as "span" from unique-traits as l join single as r on l."name" = r."trait";
emit single-implementation subject "file" key("span");
