let native = select id, kind, text, file, span from "syntax-tree";
let semantic = select id, kind, text, file, span from "semantic-syntax";
let missing_nodes = antijoin(left=native, right=semantic, left-on=["id", "kind", "text", "file", "span"], right-on=["id", "kind", "text", "file", "span"]);
let native_edges = select parent, child, ordinal, field, file from "syntax-child";
let semantic_edges = select parent, child, ordinal, field, file from "semantic-child";
let missing_edges = antijoin(left=native_edges, right=semantic_edges, left-on=["parent", "child", "ordinal", "field", "file"], right-on=["parent", "child", "ordinal", "field", "file"]);
let lost_edges = select r.file as file, r.span as span from missing_edges as l join native as r on l.parent = r.id and l.file = r.file;
let lost_nodes = select file, span from missing_nodes;
let violations = union(left=lost_nodes, right=lost_edges);
emit violations subject file key(span);
