let roots = select root, host, context, mapping, file, span from "embedded-expression";
let nodes = select id, file, span from "semantic-syntax" where text = "";
let missing_roots = antijoin(left=roots, right=nodes, left-on=["root", "file", "span"], right-on=["id", "file", "span"]);
let native = select id, file from "syntax-tree";
let missing_hosts = antijoin(left=roots, right=native, left-on=["host", "file"], right-on=["id", "file"]);
let children = select parent, file from "semantic-child";
let childless = antijoin(left=roots, right=children, left-on=["root", "file"], right-on=["parent", "file"]);
let incorrect_metadata = select * from roots where context != "deferred-type-expression" or (mapping != "exact-content" and mapping != "whole-host");
let root_ranges = select l.root as root, l.host as host, l.file as file, l.span as span, r."start-byte" as begin, r."end-byte" as finish from roots as l join "source-location" as r on l.root = r.id and l.file = r.file;
let outside_hosts = select l.root as root, l.file as file, l.span as span from root_ranges as l join "source-location" as r on l.host = r.id and l.file = r.file where l.begin < r."start-byte" or l.finish > r."end-byte" or l.begin > l.finish;
let absent_roots = select root, file, span from missing_roots;
let absent_hosts = select root, file, span from missing_hosts;
let absent_children = select root, file, span from childless;
let bad_metadata = select root, file, span from incorrect_metadata;
let absent = union(left=absent_roots, right=absent_hosts);
let absent_structure = union(left=absent, right=absent_children);
let invalid = union(left=bad_metadata, right=outside_hosts);
let duplicate_spans = select l.root as root, l.file as file, l.span as span from roots as l join roots as r on l.file = r.file and l.span = r.span where l.root != r.root;
let invalid_identity = union(left=invalid, right=duplicate_spans);
let violations = union(left=absent_structure, right=invalid_identity);
emit violations subject file key(root, span);
