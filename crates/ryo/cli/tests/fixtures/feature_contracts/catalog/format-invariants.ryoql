let fields = select id, ordinal, file, span from "brace-format-field";
let parsed = select id, outcome, file from "brace-format-parse" where outcome = "parsed";
let missing_parses = antijoin(left=fields, right=parsed, left-on=["id", "file"], right-on=["id", "file"]);
let nested = select id, ordinal, "parent-ordinal" as parent, file, span from "brace-format-field" where context = "format-spec";
let parents = select id, ordinal, file from "brace-format-field" where context = "literal";
let missing_parents = antijoin(left=nested, right=parents, left-on=["id", "parent", "file"], right-on=["id", "ordinal", "file"]);
let invalid_order = select id, file, span from nested where parent >= ordinal;
let a = select id, file, span from missing_parses;
let b = select id, file, span from missing_parents;
let missing = union(left=a, right=b);
let violations = union(left=missing, right=invalid_order);
emit violations subject file key(id, span);
