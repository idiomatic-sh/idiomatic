+//! The store main's engine keeps over ruff with this branch's live rules, Rust and TOML linked: what `cli/tests/fixtures/measured.toml` records. Applied to a checkout of main by `measured.patch`; no part of this branch's suites.
+#[test]
+fn measure_on_main() {
+    let _beside = crate::beside();
+    let mut kept = Vec::new();
+    let mut dropped = Vec::new();
+    let mut rules = Vec::new();
+    let mut dirs: Vec<_> = std::fs::read_dir(crate::base::directory()).unwrap().map(|e| e.unwrap().path()).filter(|p| p.is_dir()).collect();
+    dirs.sort();
+    for path in dirs {
+        let name = path.file_name().unwrap().to_string_lossy().into_owned();
+        let at = path.clone();
+        match std::panic::catch_unwind(move || crate::base::recording_at(&at)) {
+            Err(panic) => {
+                let why = panic.downcast_ref::<String>().cloned().or_else(|| panic.downcast_ref::<&str>().map(|s| s.to_string())).unwrap_or_default();
+                dropped.push(format!("{name}: {}", why.lines().next().unwrap_or_default()));
+            }
+            Ok(recording) => match (&recording.pending, crate::base::does_not_run(&recording)) {
+                (crate::base::Pending::Missing, None) => {
+                    kept.push(name);
+                    rules.push(crate::base::rule_of(&recording));
+                }
+                (crate::base::Pending::Missing, Some(why)) => dropped.push(format!("{name}: {why}")),
+                (pending, _) => dropped.push(format!("{name}: {pending:?}")),
+            },
+        }
+    }
+    let copy = crate::ruff::ruff_copy();
+    let _cold = crate::counting::lint_counting(copy.path(), rules, crate::base::store_at(copy.path())).expect("the rules run");
+    let size = std::fs::metadata(copy.path().join(".ryo_cache/lint.store")).expect("the store").len();
+    eprintln!("MAIN-STORE {size}");
+    for each in &kept { eprintln!("MAIN-KEPT {each}"); }
+    for each in &dropped { eprintln!("MAIN-DROPPED {each}"); }
+}
