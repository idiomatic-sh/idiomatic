let declared = select * from "defines" where (glob_any(file, "crates/*/src/domain/**/*.rs") or glob_any(file, "crates/*/src/application/**/*.rs") or glob_any(file, "crates/*/src/inbound/**/*.rs") or glob_any(file, "crates/*/src/outbound/**/*.rs")) and not glob_any(file, "**/*_test.rs") and not glob_any(file, "**/*_test/**") and not glob_any(file, "**/test.rs") and not glob_any(file, "**/tests/**") and not glob_any(file, "**/fixtures/**") and not glob_any(file, "**/fixtures.rs") and kind = "function";
let located = capture(from=declared, path="file", pattern="crates/{crate}/src/{layer}/{*dir}/{stem}.rs", captures=["crate", "layer", "dir", "stem"]);
emit located subject file key(id);
