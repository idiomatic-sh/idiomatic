let declared = select * from "defines" where glob_any(file, "crates/*/src/**/*.rs") and not glob_any(file, "**/*_test.rs") and not glob_any(file, "**/*_test/**") and not glob_any(file, "**/test.rs") and not glob_any(file, "**/tests/**") and not glob_any(file, "**/fixtures/**") and not glob_any(file, "**/fixtures.rs") and (kind = "enum" or kind = "enum-member");
emit declared subject file key(id);
