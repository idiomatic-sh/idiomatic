let imports = select * from "static-import" where (glob_any(file, "crates/*/src/domain/**/*.rs") or glob_any(file, "crates/*/src/application/**/*.rs") or glob_any(file, "crates/*/src/inbound/**/*.rs") or glob_any(file, "crates/*/src/outbound/**/*.rs")) and not glob_any(file, "**/*_test.rs") and not glob_any(file, "**/*_test/**") and not glob_any(file, "**/test.rs") and not glob_any(file, "**/tests/**") and not glob_any(file, "**/fixtures/**") and not glob_any(file, "**/fixtures.rs") and glob_any(target, "ryo_*");
emit imports subject file key(occurrence);
