let declared = select * from "defines" where (glob_any(file, "crates/*/src/domain/**/*.rs") or glob_any(file, "crates/*/src/application/**/*.rs") or glob_any(file, "crates/*/src/inbound/**/*.rs") or glob_any(file, "crates/*/src/outbound/**/*.rs")) and not glob_any(file, "**/*_test.rs") and not glob_any(file, "**/*_test/**") and not glob_any(file, "**/test.rs") and not glob_any(file, "**/tests/**") and not glob_any(file, "**/fixtures/**") and not glob_any(file, "**/fixtures.rs") and (kind = "struct" or kind = "enum" or kind = "trait" or kind = "function" or kind = "type-alias");
let written = select * from "visibility" where (glob_any(file, "crates/*/src/domain/**/*.rs") or glob_any(file, "crates/*/src/application/**/*.rs") or glob_any(file, "crates/*/src/inbound/**/*.rs") or glob_any(file, "crates/*/src/outbound/**/*.rs")) and not glob_any(file, "**/*_test.rs") and not glob_any(file, "**/*_test/**") and not glob_any(file, "**/test.rs") and not glob_any(file, "**/tests/**") and not glob_any(file, "**/fixtures/**") and not glob_any(file, "**/fixtures.rs");
let public = select d.file as "file", d.name as "name", d.kind as "kind", d.id as "id", d.span as "span", v.text as "visibility" from declared as d join written as v on d.id = v.declaration;
let located = capture(from=public, path="file", pattern="crates/{crate}/src/{layer}/{*dir}/{stem}.rs", captures=["crate", "layer", "dir", "stem"]);
emit located subject file key(id);
