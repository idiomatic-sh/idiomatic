let edges = select * from "source-dependency" where (glob_any(source, "crates/*/src/domain/**/*.rs") or glob_any(source, "crates/*/src/application/**/*.rs") or glob_any(source, "crates/*/src/inbound/**/*.rs") or glob_any(source, "crates/*/src/outbound/**/*.rs")) and not glob_any(source, "**/*_test.rs") and not glob_any(source, "**/*_test/**") and not glob_any(source, "**/test.rs") and not glob_any(source, "**/tests/**") and not glob_any(source, "**/fixtures/**") and not glob_any(source, "**/fixtures.rs") and glob_any(target, "crates/*/src/**/*.rs");
emit edges subject source key(source, target, span);
