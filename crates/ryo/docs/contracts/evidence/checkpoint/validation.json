    "ownership_edges": {
      "source": "da1fe3eff3391b57d11353bf7aff6465b810d422",
      "command": [
        "ryo",
        "query",
        "run",
        "--root",
        "crates/ryo",
        "--text",
        "let nodes = select id, kind, file, span from \"syntax-tree\" where text = \"\" and glob_any(file, \"crates/execution/src/**\");\nlet paths = select * from nodes where kind = \"path\";\nlet visibility = select * from nodes where kind = \"visibility\";\nlet nested = axis(from=visibility, relation=\"syntax-child\", direction=descendant, domain=paths);\nlet restricted = select r.file as source, r.span as span from nested as l join paths as r on l.related = r.id;\nlet declared = select source, target, written, span from \"source-dependency\" where glob_any(source, \"crates/execution/src/**\");\nlet dependencies = antijoin(left=declared, right=restricted, left-on=[\"source\",\"span\"], right-on=[\"source\",\"span\"]);\nemit dependencies subject source key(source,target,written,span);\n",
        "--limit",
        "100000",
        "--format",
        "json"
      ],
      "exit": 0,
      "elapsed_seconds": 0.9452271461486816
