input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let imports = select id, file from nodes where kind = "import-from";
let alias_nodes = select id, file from nodes where kind = "alias";
let module_edges = select parent, child, file from "semantic-child" where field = "module";
let future_module_names = select id, file from "identifier" where name = "__future__";
let future_modules = select l.parent as id, l.file as file from module_edges as l join future_module_names as r on l.child = r.id and l.file = r.file;
let alias_name_edges = select l.id as alias, r.child as name, l.file as file from alias_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "name";
let annotation_names = select id, file from "identifier" where name = "annotations";
let aliases = select l.alias as id, l.file as file from alias_name_edges as l join annotation_names as r on l.name = r.id and l.file = r.file;
let import_owners = axis(from=aliases, relation="semantic-child", direction=nearest-ancestor, domain=imports);
let future_statements = select l.related as id, l.file as file from import_owners as l join future_modules as r on l.related = r.id and l.file = r.file;
let positions = select id, "start-byte" as start, file from "source-location";
let lazy_tokens = select id, file from "syntax-tree" where text = "lazy";
let lazy_positions = select l.id as id, r.start as start, l.file as file from lazy_tokens as l join positions as r on l.id = r.id and l.file = r.file;
let statement_positions = select l.id as id, r.start as start, l.file as file from future_statements as l join positions as r on l.id = r.id and l.file = r.file;
let lazy_futures = select l.id as id, l.file as file from statement_positions as l join lazy_positions as r on l.start = r.start and l.file = r.file;
let eager_futures = antijoin(left=future_statements, right=lazy_futures, left-on=["id", "file"], right-on=["id", "file"]);
let restoring_frames = select id, file from nodes where glob_any(kind, "{module,function-def,async-function-def,class-def,return,delete,assign,type-alias,aug-assign,ann-assign,for,async-for,while,if,with,async-with,match,raise,try,try-star,assert,import,import-from,global,nonlocal,expr,pass,break,continue,except-handler}");
let carriers = axis(from=eager_futures, relation="semantic-child", direction=nearest-ancestor, domain=restoring_frames);
let carrier_roots = select related as id, file from carriers;
let inside_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=carrier_roots);
let inside_carriers = select l.id as expression, r.id as future, l.file as file from inside_axes as l join carriers as r on l.related = r.related and l.file = r.file;
let future_points = select l.expression as expression, r.start as start, l.file as file from inside_carriers as l join positions as r on l.future = r.id and l.file = r.file;
let enabled = select l.expression as id, l.file as file from future_points as l join positions as r on l.expression = r.id and l.file = r.file where l.start < r.start;
return enabled;
