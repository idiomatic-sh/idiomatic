input pairs: relation<context: node, left: node, right: node, file: file>;
output relation<context: node, left: node, right: node, file: file>;
let nodes = select id, kind, text, file from "semantic-syntax";
let shapes = select id, shape, file from "expression-shape";
let all_edges = select parent, child, ordinal, field, file from "semantic-child";
let physical_edges = antijoin(left=all_edges, right=shapes, left-on=["parent", "file"], right-on=["id", "file"]);
let embedded = select host as parent, root as child, file from "embedded-expression";
let walk_edges = antijoin(left=physical_edges, right=embedded, left-on=["parent", "child", "file"], right-on=["parent", "child", "file"]);
let identity_edges = select id as parent, id as child, file from nodes;
let tree_edges = select parent, child, file from walk_edges;
let edges = union(left=tree_edges, right=identity_edges);
let paths = closure(edges=edges, source="parent", destination="child", keys=["file"]);
let left_roots = select left as root, file from pairs;
let right_roots = select right as root, file from pairs;
let roots = union(left=left_roots, right=right_roots);
let rooted_paths = select l.root as root, r.child as end, l.file as file from roots as l join paths as r on l.root = r.parent and l.file = r.file;
let intervals0 = select l.root as root, l.end as end, r.child as middle, l.file as file from rooted_paths as l join paths as r on l.root = r.parent and l.file = r.file;
let intervals = select l.root as root, l.end as end, l.middle as middle, l.file as file from intervals0 as l join paths as r on l.middle = r.parent and l.end = r.child and l.file = r.file;
let depths = group-count(from=intervals, keys=["root", "end", "file"], count="depth", distinct="middle");
let left_nodes = select l.context as context, l.left as left, l.right as right, r.end as left_node, r.depth as depth, l.file as file from pairs as l join depths as r on l.left = r.root and l.file = r.file;
let aligned_depths = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, r.end as right_node, l.file as file from left_nodes as l join depths as r on l.right = r.root and l.depth = r.depth and l.file = r.file;
let left_steps0 = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, r.middle as step, l.file as file from aligned_depths as l join intervals as r on l.left = r.root and l.left_node = r.end and l.file = r.file where r.middle != l.left;
let left_steps1 = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.step as step, r.ordinal as ordinal, r.field as field, l.file as file from left_steps0 as l join walk_edges as r on l.step = r.child and l.file = r.file;
let left_steps = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.step as step, l.ordinal as ordinal, l.field as field, r.depth as depth, l.file as file from left_steps1 as l join depths as r on l.left = r.root and l.step = r.end and l.file = r.file;
let right_steps0 = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, r.middle as step, l.file as file from aligned_depths as l join intervals as r on l.right = r.root and l.right_node = r.end and l.file = r.file where r.middle != l.right;
let right_steps1 = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.step as step, r.ordinal as ordinal, r.field as field, l.file as file from right_steps0 as l join walk_edges as r on l.step = r.child and l.file = r.file;
let right_steps = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.step as step, l.ordinal as ordinal, l.field as field, r.depth as depth, l.file as file from right_steps1 as l join depths as r on l.right = r.root and l.step = r.end and l.file = r.file;
let matching_steps = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.step as step, l.file as file from left_steps as l join right_steps as r on l.context = r.context and l.left = r.left and l.right = r.right and l.left_node = r.left_node and l.right_node = r.right_node and l.depth = r.depth and l.ordinal = r.ordinal and l.field = r.field and l.file = r.file;
let required_counts = group-count(from=left_steps, keys=["context", "left", "right", "left_node", "right_node", "file"], count="count", distinct="step");
let matched_counts = group-count(from=matching_steps, keys=["context", "left", "right", "left_node", "right_node", "file"], count="count", distinct="step");
let aligned_descendants = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.file as file from required_counts as l join matched_counts as r on l.context = r.context and l.left = r.left and l.right = r.right and l.left_node = r.left_node and l.right_node = r.right_node and l.count = r.count and l.file = r.file;
let aligned_roots = select context, left, right, left as left_node, right as right_node, file from pairs;
let aligned_nodes = union(left=aligned_roots, right=aligned_descendants);
let left_labels = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, r.kind as kind, r.text as text, l.file as file from aligned_nodes as l join nodes as r on l.left_node = r.id and l.file = r.file;
let equal_syntax = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.file as file from left_labels as l join nodes as r on l.right_node = r.id and l.kind = r.kind and l.text = r.text and l.file = r.file;
let syntax_only = antijoin(left=equal_syntax, right=shapes, left-on=["left_node", "file"], right-on=["id", "file"]);
let left_shapes = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, r.shape as shape, l.file as file from aligned_nodes as l join shapes as r on l.left_node = r.id and l.file = r.file;
let equal_expressions = select l.context as context, l.left as left, l.right as right, l.left_node as left_node, l.right_node as right_node, l.file as file from left_shapes as l join shapes as r on l.right_node = r.id and l.shape = r.shape and l.file = r.file;
let equal_nodes = union(left=syntax_only, right=equal_expressions);
let right_nodes = select l.context as context, l.left as left, l.right as right, r.end as right_node, l.file as file from pairs as l join depths as r on l.right = r.root and l.file = r.file;
let missing_left = antijoin(left=left_nodes, right=equal_nodes, left-on=["context", "left", "right", "left_node", "file"], right-on=["context", "left", "right", "left_node", "file"]);
let missing_right = antijoin(left=right_nodes, right=equal_nodes, left-on=["context", "left", "right", "right_node", "file"], right-on=["context", "left", "right", "right_node", "file"]);
let unequal_left = select context, left, right, file from missing_left;
let unequal_right = select context, left, right, file from missing_right;
let unequal = union(left=unequal_left, right=unequal_right);
let equal = antijoin(left=pairs, right=unequal, left-on=["context", "left", "right", "file"], right-on=["context", "left", "right", "file"]);
return equal;
