input checks: relation<check: node, scope: node, file: file>;
param module: string;
output relation<check: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let function_ancestors = axis(from=functions, relation="semantic-child", direction=ancestor, domain=functions);
let function_depths = group-count(from=function_ancestors, keys=["id","file"], count="depth", distinct="related");
let function_locations = select l.id as id, r."start-byte" as position, l.file as file from functions as l join "source-location" as r on l.id = r.id and l.file = r.file;
let nested_functions = select id, file from function_depths;
let outer_functions0 = antijoin(left=function_locations, right=nested_functions, left-on=["id","file"], right-on=["id","file"]);
let outer_functions1 = extend(from=outer_functions0, values={depth: 0});
let outer_functions = select id, position, depth, file from outer_functions1;
let nested_function_locations = select l.id as id, l.position as position, r.depth as depth, l.file as file from function_locations as l join function_depths as r on l.id = r.id and l.file = r.file;
let ordered_functions = union(left=outer_functions, right=nested_function_locations);
let check_nodes = select check as id, file from checks;
let candidate_actors = axis(from=check_nodes, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let scope_edges = select child as source, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges, source="source", destination="destination", keys=["file"]);
let own_actors = select l.check as check, l.scope as actor, l.file as file from checks as l join functions as r on l.scope = r.id and l.file = r.file;
let outer_actor_candidates = select l.check as check, l.scope as scope, r.related as actor, l.file as file from checks as l join candidate_actors as r on l.check = r.id and l.file = r.file;
let outer_actors = select l.check as check, l.actor as actor, l.file as file from outer_actor_candidates as l join scope_paths as r on l.scope = r.source and l.actor = r.destination and l.file = r.file;
let actors = union(left=own_actors, right=outer_actors);
let actor_order = select l.check as check, l.actor as actor, r.position as position, r.depth as depth, l.file as file from actors as l join ordered_functions as r on l.actor = r.id and l.file = r.file;
let seen_imports = select occurrence as id, file from "static-import" where target = $module or starts_with(target, concat($module,"."));
let import_actors = axis(from=seen_imports, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let function_imports = select l.id as id, r.related as actor, l.file as file from seen_imports as l join import_actors as r on l.id = r.id and l.file = r.file;
let initial_imports = antijoin(left=seen_imports, right=function_imports, left-on=["id","file"], right-on=["id","file"]);
let import_locations = select l.id as id, r."start-byte" as position, l.file as file from seen_imports as l join "source-location" as r on l.id = r.id and l.file = r.file;
let check_locations = select l.check as check, r."start-byte" as position, l.file as file from checks as l join "source-location" as r on l.check = r.id and l.file = r.file;
let initial_checks = antijoin(left=checks, right=actors, left-on=["check","file"], right-on=["check","file"]);
let initial_pairs = select l.check as check, r.id as import_id, l.file as file from initial_checks as l join initial_imports as r on l.file = r.file;
let initial_import_positions = select l.check as check, r.position as import_position, l.file as file from initial_pairs as l join import_locations as r on l.import_id = r.id and l.file = r.file;
let seen_initial = select l.check as check, l.file as file from initial_import_positions as l join check_locations as r on l.check = r.check and l.file = r.file where l.import_position < r.position;
let seen_before_functions = select l.check as check, l.file as file from actors as l join initial_imports as r on l.file = r.file;
let function_import_order = select l.id as id, l.actor as actor, r.position as actor_position, r.depth as depth, l.file as file from function_imports as l join ordered_functions as r on l.actor = r.id and l.file = r.file;
let seen_previous_functions = select l.check as check, l.file as file from actor_order as l join function_import_order as r on l.file = r.file where r.depth < l.depth or r.depth = l.depth and r.actor_position < l.position;
let own_import_pairs = select l.check as check, r.id as import_id, l.file as file from actors as l join function_imports as r on l.actor = r.actor and l.file = r.file;
let own_import_positions = select l.check as check, r.position as import_position, l.file as file from own_import_pairs as l join import_locations as r on l.import_id = r.id and l.file = r.file;
let seen_current_functions = select l.check as check, l.file as file from own_import_positions as l join check_locations as r on l.check = r.check and l.file = r.file where l.import_position < r.position;
let lambdas = select id, file from nodes where kind = "lambda";
let lambda_checks = select l.check as check, l.file as file from checks as l join lambdas as r on l.scope = r.id and l.file = r.file;
let seen_lambdas = select l.check as check, l.file as file from lambda_checks as l join seen_imports as r on l.file = r.file;
let seen0 = union(left=seen_initial, right=seen_before_functions);
let seen1 = union(left=seen0, right=seen_previous_functions);
let seen2 = union(left=seen1, right=seen_current_functions);
let result = union(left=seen2, right=seen_lambdas);
return result;
