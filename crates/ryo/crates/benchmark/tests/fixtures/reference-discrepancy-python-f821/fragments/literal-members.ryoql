output relation<root: node, member: node, file: file>;
let subscripts = select id, file from "semantic-syntax" where kind = "subscript";
let literal_names = select id, file from "qualified-name" where path = "typing.Literal" or path = "typing_extensions.Literal";
let values = select l.id as subscript, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let literals = select l.subscript as id, l.file as file from values as l join literal_names as r on l.value = r.id and l.file = r.file;
let slices = select l.id as literal, r.child as slice, l.file as file from literals as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from "semantic-syntax" where kind = "tuple";
let tuple_slices = select l.literal as literal, l.slice as slice, l.file as file from slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_members = select l.literal as literal, r.child as member, l.file as file from tuple_slices as l join "semantic-child" as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let scalar_slices = antijoin(left=slices, right=tuples, left-on=["slice", "file"], right-on=["id", "file"]);
let scalar_members = select literal, slice as member, file from scalar_slices;
let members = union(left=tuple_members, right=scalar_members);
let nesting_edges = select l.literal as parent_literal, l.member as child_literal, l.file as file from members as l join literals as r on l.member = r.id and l.file = r.file;
let roots = antijoin(left=literals, right=nesting_edges, left-on=["id", "file"], right-on=["child_literal", "file"]);
let nesting_paths = closure(edges=nesting_edges, source="parent_literal", destination="child_literal", keys=["file"]);
let root_nested_literals = select l.id as root, r.child_literal as literal, l.file as file from roots as l join nesting_paths as r on l.id = r.parent_literal and l.file = r.file;
let root_self_literals = select id as root, id as literal, file from roots;
let root_literals = union(left=root_nested_literals, right=root_self_literals);
let non_subscript_members = antijoin(left=members, right=subscripts, left-on=["member", "file"], right-on=["id", "file"]);
let leaves = select l.root as root, r.member as member, l.file as file from root_literals as l join non_subscript_members as r on l.literal = r.literal and l.file = r.file;
return leaves;
