output relation<root: node, member: node, file: file>;
let nodes = select id, kind, text, file from "semantic-syntax";
let subscripts = select id, file from nodes where kind = "subscript";
let values = select l.id as subscript, r.child as value, l.file as file from subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let union_names = select id, file from "qualified-name" where path = "typing.Union" or path = "typing_extensions.Union";
let union_subscripts = select l.subscript as id, l.file as file from values as l join union_names as r on l.value = r.id and l.file = r.file;
let slices = select l.id as union, r.child as slice, l.file as file from union_subscripts as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuples = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.union as union, l.slice as slice, l.file as file from slices as l join tuples as r on l.slice = r.id and l.file = r.file;
let tuple_members = select l.union as union, r.child as member, l.file as file from tuple_slices as l join "semantic-child" as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let scalar_slices = antijoin(left=slices, right=tuples, left-on=["slice", "file"], right-on=["id", "file"]);
let scalar_members = select union, slice as member, file from scalar_slices;
let typing_members = union(left=tuple_members, right=scalar_members);
let pipe_tokens = select id, file from nodes where text = "|";
let pipe_ops = select l.parent as id, l.file as file from "semantic-child" as l join pipe_tokens as r on l.child = r.id and l.file = r.file where l.field = "op";
let pipe_members = select l.id as union, r.child as member, l.file as file from pipe_ops as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "left" or r.field = "right";
let members = union(left=typing_members, right=pipe_members);
let unions = union(left=union_subscripts, right=pipe_ops);
let nesting_edges = select l.union as parent_union, l.member as child_union, l.file as file from members as l join unions as r on l.member = r.id and l.file = r.file;
let roots = antijoin(left=unions, right=nesting_edges, left-on=["id", "file"], right-on=["child_union", "file"]);
let nesting_paths = closure(edges=nesting_edges, source="parent_union", destination="child_union", keys=["file"]);
let nested_unions = select l.id as root, r.child_union as union, l.file as file from roots as l join nesting_paths as r on l.id = r.parent_union and l.file = r.file;
let self_unions = select id as root, id as union, file from roots;
let root_unions = union(left=nested_unions, right=self_unions);
let non_union_members = antijoin(left=members, right=unions, left-on=["member", "file"], right-on=["id", "file"]);
let leaves = select l.root as root, r.member as member, l.file as file from root_unions as l join non_union_members as r on l.union = r.union and l.file = r.file;
return leaves;
