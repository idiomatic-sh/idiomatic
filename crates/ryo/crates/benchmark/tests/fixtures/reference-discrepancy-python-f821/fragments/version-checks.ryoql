output relation<id: node, left: node, comparator: node, expected: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let ifs = select id, file from nodes where kind = "if" and matches(file, "[.]pyi$");
let tests = select r.child as id, l.file as file from ifs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "test";
let bools = select l.id as id, l.file as file from tests as l join nodes as r on l.id = r.id and l.file = r.file where r.kind = "bool-op";
let bool_values = select r.child as id, l.file as file from bools as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "values";
let direct_tests = union(left=tests, right=bool_values);
let comparisons = select l.id as id, l.file as file from direct_tests as l join nodes as r on l.id = r.id and l.file = r.file where r.kind = "compare";
let comparison_values = select l.id as id, r.child as comparator, l.file as file from comparisons as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "comparators";
let chained = select l.id as id, l.file as file from comparison_values as l join comparison_values as r on l.id = r.id and l.file = r.file where l.comparator != r.comparator;
let single_values = antijoin(left=comparison_values, right=chained, left-on=["id", "file"], right-on=["id", "file"]);
let left_edges = select parent, child, file from "semantic-child" where field = "left";
let version = select id, file from "qualified-name" where path = "sys.version_info";
let subscript = select id, file from "semantic-syntax" where kind = "subscript";
let subscript_bases = select parent as subscript, child as base, file from "semantic-child" where field = "value";
let version_subscript0 = select l.subscript as subscript, r.file as file from subscript_bases as l join version as r on l.base = r.id and l.file = r.file;
let version_subscript = select l.subscript as subscript, l.file as file from version_subscript0 as l join subscript as r on l.subscript = r.id and l.file = r.file;
let index_edges = select parent, child, file from "semantic-child" where field = "slice";
let indices = select l.parent as subscript, l.child as index, r.file as file from index_edges as l join version_subscript as r on l.parent = r.subscript;
let index_literals = select id, file, kind, zero from "literal-properties";
let index_integer_rows = select l.index as id, l.file as file, r.zero as zero from indices as l join index_literals as r on l.index = r.id and l.file = r.file where r.kind = "integer";
let zero_indices = select id, file from index_integer_rows where zero = "true";
let slice_indices = select l.index as id, l.file as file from indices as l join "semantic-syntax" as r on l.index = r.id and l.file = r.file where r.kind = "slice";
let upper_fields = select parent, child, file from "semantic-child" where field = "upper";
let upper_exprs = select l.id as slice, r.child as upper, l.file as file from slice_indices as l join upper_fields as r on l.id = r.parent and l.file = r.file;
let upper_locations = select l.slice as slice, l.file as file, r."start-byte" as start, r."end-byte" as end from upper_exprs as l join "source-location" as r on l.upper = r.id and l.file = r.file;
let upper_value_tokens = select id, file from "semantic-syntax" where matches(text, "(?i)^(?:1|0x(?:_?0)*_?1|0b(?:_?0)*_?1|0o(?:_?0)*_?1)$") or matches(text, "(?i)^(?:2|0x(?:_?0)*_?2|0b(?:_?0)*_?1_?0|0o(?:_?0)*_?2)$");
let upper_token_locations = select l.id as token, l.file as file, r."start-byte" as start, r."end-byte" as end from upper_value_tokens as l join "source-location" as r on l.id = r.id and l.file = r.file;
let valid_slice_uppers = select l.slice as id, l.file as file from upper_locations as l join upper_token_locations as r on l.start = r.start and l.end = r.end and l.file = r.file;
let lower_fields = select parent as slice, child, file from "semantic-child" where field = "lower";
let step_fields = select parent as slice, child, file from "semantic-child" where field = "step";
let slices_with_lower = select l.id as id, l.file as file from slice_indices as l join lower_fields as r on l.id = r.slice and l.file = r.file;
let slices_with_step = select l.id as id, l.file as file from slice_indices as l join step_fields as r on l.id = r.slice and l.file = r.file;
let invalid_slice_shape = union(left=slices_with_lower, right=slices_with_step);
let invalid_slice_uppers = antijoin(left=slice_indices, right=valid_slice_uppers, left-on=["id", "file"], right-on=["id", "file"]);
let invalid_slices = union(left=invalid_slice_shape, right=invalid_slice_uppers);
let index_slices = antijoin(left=slice_indices, right=invalid_slices, left-on=["id", "file"], right-on=["id", "file"]);
let valid_indices = union(left=zero_indices, right=index_slices);
let invalid_indices = antijoin(left=indices, right=valid_indices, left-on=["index", "file"], right-on=["id", "file"]);
let zero_subscripts = select l.subscript as id, l.file as file from indices as l join zero_indices as r on l.index = r.id and l.file = r.file;
let tuple_subscripts = select l.subscript as id, l.file as file from indices as l join index_slices as r on l.index = r.id and l.file = r.file;
let major_lefts = extend(from=zero_subscripts, values={expected: "major"});
let tuple_lefts = extend(from=tuple_subscripts, values={expected: "tuple"});
let plain_lefts = extend(from=version, values={expected: "tuple"});
let indexed_lefts0 = union(left=major_lefts, right=tuple_lefts);
let recognized_lefts = union(left=indexed_lefts0, right=plain_lefts);
let all_indexed = select subscript as id, file from version_subscript;
let invalid_lefts0 = antijoin(left=all_indexed, right=recognized_lefts, left-on=["id", "file"], right-on=["id", "file"]);
let invalid_lefts = extend(from=invalid_lefts0, values={expected: "invalid"});
let all_lefts = union(left=recognized_lefts, right=invalid_lefts);
let comparison_lefts = select l.parent as id, l.child as left, r.expected as expected, l.file as file from left_edges as l join all_lefts as r on l.child = r.id and l.file = r.file;
let result = select l.id as id, l.left as left, r.comparator as comparator, l.expected as expected, l.file as file from comparison_lefts as l join single_values as r on l.id = r.id and l.file = r.file;
return result;
