input expressions: relation<id: node, file: file>;
output relation<id: node, key: node, container: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let compares = select id, file from nodes where kind = "compare";
let compare_tests = select l.id as test, l.file as file from expressions as l join compares as r on l.id = r.id and l.file = r.file;
let comparators = select l.test as test, r.child as container, l.file as file from compare_tests as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "comparators";
let comparator_counts = group-count(from=comparators, keys=["test","file"], count="count", distinct="container");
let one_comparators = select l.test as test, l.container as container, l.file as file from comparators as l join comparator_counts as r on l.test = r.test and l.file = r.file where r.count = 1;
let keys = select l.test as test, l.container as container, r.child as key, l.file as file from one_comparators as l join "semantic-child" as r on l.test = r.parent and l.file = r.file where r.field = "left";
let key_ends = select l.test as test, l.container as container, l.key as key, r."end-byte" as start, l.file as file from keys as l join "source-location" as r on l.key = r.id and l.file = r.file;
let gaps = select l.test as test, l.container as container, l.key as key, l.start as start, r."start-byte" as end, l.file as file from key_ends as l join "source-location" as r on l.container = r.id and l.file = r.file;
let operator_tokens = select l.id as id, l.text as text, r."start-byte" as start, r."end-byte" as end, l.file as file from "syntax-tree" as l join "source-location" as r on l.id = r.id and l.file = r.file where l.text = "in" or l.text = "not";
let ins = select l.test as test, l.container as container, l.key as key, l.file as file from gaps as l join operator_tokens as r on l.file = r.file where r.text = "in" and r.start >= l.start and r.end <= l.end;
let not_ins = select l.test as test, l.file as file from gaps as l join operator_tokens as r on l.file = r.file where r.text = "not" and r.start >= l.start and r.end <= l.end;
let in_tests = antijoin(left=ins, right=not_ins, left-on=["test","file"], right-on=["test","file"]);
let result = select test as id, key, container, file from in_tests;
return result;
