output relation<occurrence: node, name: symbol, scope: node, ordinal: number, kind: symbol, file: file>;
let nodes = select id, kind, file, span from "semantic-syntax";
let classes = select id, file from nodes where kind = "class-def";
let attributes = select id, file from nodes where kind = "attribute";
let name_nodes = select id, file from nodes where kind = "name";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let scope_nodes_for_events = select child as id, file from "scope";
let redirect_events = select occurrence as id, name, ordinal, kind, file from "binding-event" where kind = "global" or kind = "nonlocal";
let redirect_owners = axis(from=redirect_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let redirect_namespaces = select id as occurrence, name, ordinal, kind, file, related as scope from redirect_owners;
let value_namespace_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "delete" or kind = "cleanup";
let stub_annotation_events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event" where kind = "annotation" and matches(file, "[.]pyi$");
let parameter_declarations = select id, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let annotation_prior_values = antijoin(left=value_namespace_events, right=parameter_declarations, left-on=["id", "file"], right-on=["id", "file"]);
let annotation_previous_events = union(left=annotation_prior_values, right=stub_annotation_events);
let delayed_annotations = select l.id as id, l.file as file from stub_annotation_events as l join annotation_previous_events as r on l.scope = r.scope and l.name = r.name and l.file = r.file where r.ordinal < l.ordinal;
let fresh_annotations = antijoin(left=stub_annotation_events, right=delayed_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let builtin_module_nodes = select id, file from nodes where kind = "module";
let builtin_annotation_names = select name, file from "implicit-symbol" as catalog where catalog.kind = "builtin" and (catalog."since-major" < 3 or catalog."since-major" = 3 and catalog."since-minor" <= 10);
let module_annotation_names = select l.id as id, l.name as name, l.file as file from fresh_annotations as l join builtin_module_nodes as r on l.scope = r.id and l.file = r.file;
let delayed_builtin_annotations = select l.id as id, l.file as file from module_annotation_names as l join builtin_annotation_names as r on l.name = r.name and l.file = r.file;
let real_annotations = antijoin(left=fresh_annotations, right=delayed_builtin_annotations, left-on=["id", "file"], right-on=["id", "file"]);
let all_raw_namespace_events = union(left=value_namespace_events, right=real_annotations);
let scope_body_roots = select l.id as scope, l.file as file, r.child as id from scope_nodes_for_events as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "body";
let type_function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_header_children = select l.id as owner, l.file as file, r.child as id from classes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_type_roots = select l.id as id, l.owner as owner, l.file as file from class_header_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "arg";
let parameter_annotation_roots = select r.child as id, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_type_owners = axis(from=parameter_annotation_roots,relation="semantic-child",direction=nearest-ancestor,domain=type_function_nodes);
let parameter_type_roots = select id, related as owner, file from parameter_type_owners;
let return_type_roots = select r.child as id, l.id as owner, l.file as file from type_function_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_type_roots = union(left=parameter_type_roots,right=return_type_roots);
let type_scope_roots = union(left=class_type_roots,right=function_type_roots);
let body_evaluation_roots = select id, scope as owner, file from scope_body_roots;
let evaluation_roots = union(left=body_evaluation_roots,right=type_scope_roots);
let nearest_evaluations = axis(from=all_raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=evaluation_roots);
let stub_type_roots = select id, file from type_scope_roots where matches(file, "\.pyi$");
let future_files = select file from "static-import" where target = "__future__.annotations";
let future_function_type_roots = select l.id as id, l.file as file from function_type_roots as l join future_files as r on l.file = r.file;
let deferred_type_roots = union(left=stub_type_roots, right=future_function_type_roots);
let active_initial_type_roots = antijoin(left=type_scope_roots, right=deferred_type_roots, left-on=["id", "file"], right-on=["id", "file"]);
let all_type_namespace_events = select l.id as id, l.file as file from nearest_evaluations as l join type_scope_roots as r on l.related = r.id and l.file = r.file;
let raw_namespace_events = antijoin(left=all_raw_namespace_events,right=all_type_namespace_events,left-on=["id","file"],right-on=["id","file"]);
let lexical_event_owners = axis(from=raw_namespace_events,relation="semantic-child",direction=nearest-ancestor,domain=scope_nodes_for_events);
let event_body_ancestors = axis(from=raw_namespace_events,relation="semantic-child",direction=ancestor,domain=scope_body_roots);
let ancestor_body_owners = select l.id as id, l.file as file, r.scope as scope from event_body_ancestors as l join scope_body_roots as r on l.related = r.id and l.file = r.file;
let self_body_owners = select l.id as id, l.file as file, r.scope as scope from raw_namespace_events as l join scope_body_roots as r on l.id = r.id and l.file = r.file;
let event_body_owners = union(left=ancestor_body_owners,right=self_body_owners);
let lexical_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from lexical_event_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let named_expressions = select id, file from nodes where kind = "named-expr";
let walrus_targets = select r.child as id, l.file as file from named_expressions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "target";
let walrus_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from raw_namespace_events as l join walrus_targets as r on l.id = r.id and l.file = r.file;
let non_comprehension_scopes = select id, file from nodes where kind = "module" or kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "lambda";
let walrus_lexical_owners = axis(from=walrus_events,relation="semantic-child",direction=nearest-ancestor,domain=non_comprehension_scopes);
let walrus_body_events = select l.id as id, l.name as name, l.scope as scope, l.ordinal as ordinal, l.kind as kind, l.file as file, l.related as related from walrus_lexical_owners as l join event_body_owners as r on l.id = r.id and l.related = r.scope and l.file = r.file;
let owned_namespace_events = union(left=lexical_body_events,right=walrus_body_events);
let redirected_namespace_events = select l.id as occurrence, l.name as name, l.related as scope, l.ordinal as ordinal, l.kind as kind, l.file as file from owned_namespace_events as l join redirect_namespaces as r on l.related = r.scope and l.name = r.name and l.file = r.file;
let normal_namespace_rows = antijoin(left=raw_namespace_events,right=redirected_namespace_events,left-on=["id","file"],right-on=["occurrence","file"]);
let normal_namespace_events = select id as occurrence, name, scope, ordinal, kind, file from normal_namespace_rows;
let corrected_namespace_events = union(left=normal_namespace_events,right=redirected_namespace_events);
let namespace_events = union(left=corrected_namespace_events,right=redirect_namespaces);
return namespace_events;
