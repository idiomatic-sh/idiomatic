import lookup_symbols from "python/ruff/lookup-symbol-events";
import deferred_types from "python/ruff/deferred-type-reads";
import seen_module from "python/ruff/seen-module-at-check";
import type_events from "python/ruff/checker-type-scope-events";
input checks: relation<check: node, root: node, scope: node, point: number, file: file>;
param builtin: string;
param typing: string;
param mode: string;
output relation<check: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let names = select id, file from nodes where kind = "name";
let attributes = select id, file from nodes where kind = "attribute";
let named_roots = select l.check as check, l.root as root, l.root as head, l.file as file from checks as l join names as r on l.root = r.id and l.file = r.file;
let attributed_roots = select l.check as check, l.root as root, l.file as file from checks as l join attributes as r on l.root = r.id and l.file = r.file;
let attribute_values = select l.check as check, l.root as root, r.child as head, l.file as file from attributed_roots as l join "semantic-child" as r on l.root = r.parent and l.file = r.file where r.field = "value";
let simple_attributes = select l.check as check, l.root as root, l.head as head, l.file as file from attribute_values as l join names as r on l.head = r.id and l.file = r.file;
let heads = union(left=named_roots, right=simple_attributes);
let head_labels = select l.check as check, l.root as root, l.head as head, r.name as name, l.file as file from heads as l join "identifier" as r on l.head = r.id and l.file = r.file;
let root_inputs = select root as id, file from checks;
let deferred_roots = deferred_types(expressions=root_inputs);
let deferred_head_checks = select l.check as check, l.file as file from heads as l join deferred_roots as r on l.root = r.id and l.file = r.file where $mode = "annotation";
let cached_root_paths0 = select l.check as check, l.root as root, r.path as path, l.file as file from heads as l join "qualified-name" as r on l.root = r.id and l.file = r.file where r.provenance = "builtin" or r.provenance = "import";
let unscoped_cached_root_paths = antijoin(left=cached_root_paths0, right=deferred_head_checks, left-on=["check","file"], right-on=["check","file"]);
let events = select occurrence as id, name, scope, ordinal, kind, file from "binding-event";
let file_points = select ordinal as point, file from events;
let lower_file_points = select l.point as point, l.file as file from file_points as l join file_points as r on l.file = r.file where l.point < r.point;
let final_file_points = antijoin(left=file_points, right=lower_file_points, left-on=["point","file"], right-on=["point","file"]);
let check_inputs = select check as id, file from checks;
let deferred_checks0 = deferred_types(expressions=check_inputs);
let potential_deferred_checks = select id as check, file from deferred_checks0;
let lambda_scopes = select id, file from nodes where kind = "lambda";
let lambda_body_checks = select l.check as check, l.file as file from checks as l join lambda_scopes as r on l.scope = r.id and l.file = r.file;
let deferred_checks = antijoin(left=potential_deferred_checks, right=lambda_body_checks, left-on=["check","file"], right-on=["check","file"]);
let scope_edges = select child as source, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges, source="source", destination="destination", keys=["file"]);
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "lambda";
let own_function_contexts = select l.check as check, l.file as file from checks as l join functions as r on l.scope = r.id and l.file = r.file;
let outer_scopes = select l.check as check, r.destination as scope, l.file as file from checks as l join scope_paths as r on l.scope = r.source and l.file = r.file;
let outer_function_contexts = select l.check as check, l.file as file from outer_scopes as l join functions as r on l.scope = r.id and l.file = r.file;
let function_contexts = union(left=own_function_contexts, right=outer_function_contexts);
let late_contexts = union(left=function_contexts, right=deferred_checks);
let early_checks = antijoin(left=checks, right=late_contexts, left-on=["check","file"], right-on=["check","file"]);
let early_contexts0 = select check as context, scope as initial_scope, point as point, point as header_point, file from early_checks;
let late_checks = select l.check as check, l.scope as scope, l.point as point, l.file as file from checks as l join late_contexts as r on l.check = r.check and l.file = r.file;
let late_points = select l.check as check, l.scope as scope, l.point as header_point, r.point as point, l.file as file from late_checks as l join final_file_points as r on l.file = r.file;
let ordinary_late_points = antijoin(left=late_points, right=deferred_checks, left-on=["check","file"], right-on=["check","file"]);
let late_contexts0 = select check as context, scope as initial_scope, point, header_point, file from ordinary_late_points;
let deferred_final_points = select l.check as context, l.scope as initial_scope, r.point as point, r.point as header_point, l.file as file from late_checks as l join final_file_points as r on l.file = r.file;
let deferred_contexts0 = select l.context as context, l.initial_scope as initial_scope, l.point as point, l.header_point as header_point, l.file as file from deferred_final_points as l join deferred_checks as r on l.context = r.check and l.file = r.file;
let contexts_a = union(left=early_contexts0, right=late_contexts0);
let contexts_b = union(left=contexts_a, right=deferred_contexts0);
let contexts_c = extend(from=contexts_b, values={stage: 3});
let contexts = select context, initial_scope, point, header_point, stage, file from contexts_c;
let head_inputs = select head as id, file from heads;
let current_bindings0 = lookup_symbols(ordered_contexts=contexts, expressions=head_inputs);
let current_bindings = select l.check as check, l.root as root, l.head as head, r.occurrence as occurrence, r.scope as scope, r.kind as kind, l.file as file from heads as l join current_bindings0 as r on l.check = r.context and l.head = r.expression and l.file = r.file;
let generic_owners = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "type-alias";
let parameters = select id, name, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_axes = axis(from=parameters, relation="semantic-child", direction=nearest-ancestor, domain=generic_owners);
let owned_parameters = select l.id as declaration, l.name as name, r.related as owner, l.file as file from parameters as l join parameter_axes as r on l.id = r.id and l.file = r.file;
let generic_outer_contexts = select l.check as check, l.scope as owner, l.file as file from outer_scopes as l join generic_owners as r on l.scope = r.id and l.file = r.file;
let generic_own_contexts = select l.check as check, l.scope as owner, l.file as file from checks as l join generic_owners as r on l.scope = r.id and l.file = r.file;
let visible_body_generics = union(left=generic_outer_contexts, right=generic_own_contexts);
let args = select id, file from nodes where kind = "arg";
let annotation_roots = select r.child as id, l.file as file from args as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let annotation_function_axes = axis(from=annotation_roots, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let parameter_type_roots = select id, related as owner, file from annotation_function_axes;
let return_roots = select r.child as id, l.id as owner, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let function_header_roots = union(left=parameter_type_roots, right=return_roots);
let class_nodes = select id, file from nodes where kind = "class-def";
let call_argument_nodes = select id, file from nodes where kind = "call-arguments";
let class_children = select r.child as id, l.id as owner, l.file as file from class_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file;
let class_header_roots = select l.id as id, l.owner as owner, l.file as file from class_children as l join call_argument_nodes as r on l.id = r.id and l.file = r.file;
let parameter_nodes = select id, file from nodes where kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let parameter_payloads0 = select r.child as id, l.id as parameter, l.file as file from parameter_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "bound" or r.field = "default-value";
let parameter_header_roots = select l.id as id, r.related as owner, l.file as file from parameter_payloads0 as l join parameter_axes as r on l.parameter = r.id and l.file = r.file;
let alias_nodes = select id, file from nodes where kind = "type-alias";
let alias_header_roots = select r.child as id, l.id as owner, l.file as file from alias_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "value";
let header_roots0 = union(left=function_header_roots, right=class_header_roots);
let header_roots1 = union(left=header_roots0, right=parameter_header_roots);
let header_roots = union(left=header_roots1, right=alias_header_roots);
let header_context_axes = axis(from=check_inputs, relation="semantic-child", direction=nearest-ancestor, domain=header_roots);
let header_contexts = select l.id as check, r.owner as owner, l.file as file from header_context_axes as l join header_roots as r on l.related = r.id and l.file = r.file;
let visible_generics = union(left=visible_body_generics, right=header_contexts);
let contextual_parameters = select l.check as check, r.name as name, r.owner as owner, l.file as file from visible_generics as l join owned_parameters as r on l.owner = r.owner and l.file = r.file;
let parameter_head_matches = select l.check as check, l.head as head, r.owner as owner, l.file as file from head_labels as l join contextual_parameters as r on l.check = r.check and l.name = r.name and l.file = r.file;
let bound_parameter_options = select l.check as check, l.head as head, l.owner as owner, r.scope as scope, l.file as file from parameter_head_matches as l join current_bindings as r on l.check = r.check and l.head = r.head and l.file = r.file;
let same_scope_values = select check, head, owner, file from bound_parameter_options where owner = scope;
let inner_scope_values = select l.check as check, l.head as head, l.owner as owner, l.file as file from bound_parameter_options as l join scope_paths as r on l.scope = r.source and l.owner = r.destination and l.file = r.file;
let shadowed_parameters = union(left=same_scope_values, right=inner_scope_values);
let visible_parameter_heads = antijoin(left=parameter_head_matches, right=shadowed_parameters, left-on=["check","head","owner","file"], right-on=["check","head","owner","file"]);
let parameter_barriers = select check, head, file from visible_parameter_heads;
let original_type_events = type_events();
let extra_header_roots0 = select l.id as id, l.owner as owner, r.parameter as local, l.file as file from parameter_header_roots as l join parameter_payloads0 as r on l.id = r.id and l.file = r.file;
let alias_extra_roots = select id, owner, owner as local, file from alias_header_roots;
let extra_header_roots = union(left=extra_header_roots0, right=alias_extra_roots);
let namespace_event_inputs = select id, name, scope, ordinal, kind, file from events where kind = "bind" or kind = "delete" or kind = "cleanup";
let extra_header_event_axes = axis(from=namespace_event_inputs, relation="semantic-child", direction=nearest-ancestor, domain=extra_header_roots);
let extra_header_event_scopes = select l.id as occurrence, r.owner as owner, r.local as local, l.file as file from extra_header_event_axes as l join extra_header_roots as r on l.related = r.id and l.file = r.file;
let extra_type_events = select l.id as occurrence, l.name as name, r.owner as owner, l.ordinal as ordinal, l.kind as kind, l.file as file from namespace_event_inputs as l join extra_header_event_scopes as r on l.id = r.occurrence and l.file = r.file where l.scope = r.owner or l.scope = r.local;
let all_type_events = union(left=original_type_events, right=extra_type_events);
let header_type_names = select l.check as check, l.head as head, r.occurrence as occurrence, r.ordinal as ordinal, l.file as file from head_labels as l join all_type_events as r on l.name = r.name and l.file = r.file;
let header_scoped_events = select l.check as check, l.head as head, l.occurrence as occurrence, l.ordinal as ordinal, l.file as file from header_type_names as l join header_contexts as r on l.check = r.check and l.file = r.file;
let header_event_owners = select l.check as check, l.head as head, l.occurrence as occurrence, l.ordinal as ordinal, r.owner as owner, l.file as file from header_scoped_events as l join all_type_events as r on l.occurrence = r.occurrence and l.file = r.file;
let actual_header_events = select l.check as check, l.head as head, l.occurrence as occurrence, l.ordinal as ordinal, l.file as file from header_event_owners as l join header_contexts as r on l.check = r.check and l.owner = r.owner and l.file = r.file;
let active_header_events = select l.check as check, l.head as head, l.file as file from actual_header_events as l join checks as r on l.check = r.check and l.file = r.file where l.ordinal <= r.point;
let type_barriers = union(left=parameter_barriers, right=active_header_events);
let unbound_heads = antijoin(left=heads, right=current_bindings, left-on=["check","head","file"], right-on=["check","head","file"]);
let non_type_heads = antijoin(left=unbound_heads, right=type_barriers, left-on=["check","head","file"], right-on=["check","head","file"]);
let implicit_candidates0 = select l.check as check, l.root as root, l.file as file from named_roots as l join non_type_heads as r on l.check = r.check and l.head = r.head and l.file = r.file;
let implicit_candidates = select l.check as check, l.file as file from implicit_candidates0 as l join "identifier" as r on l.root = r.id and l.file = r.file where concat("builtins.",r.name) = $builtin;
let seen_inputs = select check, scope, file from checks;
let seen_builtins0 = seen_module(checks=seen_inputs, module="builtins");
let builtin_import_files = select file from "static-import" where target = "builtins" or starts_with(target,"builtins.");
let seen_in_deferred = select l.check as check, l.file as file from deferred_checks as l join builtin_import_files as r on l.file = r.file;
let seen_builtins = union(left=seen_builtins0, right=seen_in_deferred);
let fast_builtin_matches = antijoin(left=implicit_candidates, right=seen_builtins, left-on=["check","file"], right-on=["check","file"]);
let original_reads = select l.head as head, r.scope as scope, r.ordinal as ordinal, l.file as file from heads as l join events as r on l.head = r.id and l.file = r.file where r.kind = "read";
let original_own_function_reads = select l.head as head, l.file as file from original_reads as l join functions as r on l.scope = r.id and l.file = r.file;
let original_outer_scopes = select l.head as head, r.destination as scope, l.file as file from original_reads as l join scope_paths as r on l.scope = r.source and l.file = r.file;
let original_outer_function_reads = select l.head as head, l.file as file from original_outer_scopes as l join functions as r on l.scope = r.id and l.file = r.file;
let original_function_reads = union(left=original_own_function_reads, right=original_outer_function_reads);
let original_head_inputs = select head as id, file from heads;
let originally_deferred0 = deferred_types(expressions=original_head_inputs);
let original_potential_deferred = select id as head, file from originally_deferred0;
let original_lambda_reads = select l.head as head, l.file as file from original_reads as l join lambda_scopes as r on l.scope = r.id and l.file = r.file;
let originally_deferred = antijoin(left=original_potential_deferred, right=original_lambda_reads, left-on=["head","file"], right-on=["head","file"]);
let original_late_reads = union(left=original_function_reads, right=originally_deferred);
let original_early_reads = antijoin(left=original_reads, right=original_late_reads, left-on=["head","file"], right-on=["head","file"]);
let original_early_contexts = select head as context, scope as initial_scope, ordinal as point, ordinal as header_point, file from original_early_reads;
let original_late0 = select l.head as head, l.scope as scope, l.ordinal as ordinal, r.point as point, l.file as file from original_reads as l join final_file_points as r on l.file = r.file;
let original_late1 = select l.head as head, l.scope as scope, l.ordinal as ordinal, l.point as point, l.file as file from original_late0 as l join original_late_reads as r on l.head = r.head and l.file = r.file;
let original_late_ordinary = antijoin(left=original_late1, right=originally_deferred, left-on=["head","file"], right-on=["head","file"]);
let original_late_contexts = select head as context, scope as initial_scope, point, ordinal as header_point, file from original_late_ordinary;
let original_deferred_contexts = select l.head as context, l.scope as initial_scope, l.point as point, l.point as header_point, l.file as file from original_late1 as l join originally_deferred as r on l.head = r.head and l.file = r.file;
let original_contexts0 = union(left=original_early_contexts, right=original_late_contexts);
let original_contexts1 = union(left=original_contexts0, right=original_deferred_contexts);
let original_contexts2 = extend(from=original_contexts1, values={stage: 3});
let original_contexts = select context, initial_scope, point, header_point, stage, file from original_contexts2;
let original_bindings0 = lookup_symbols(ordered_contexts=original_contexts, expressions=original_head_inputs);
let original_bindings = select context as head, expression, occurrence, kind, file from original_bindings0 where context = expression;
let original_unbound_reads = antijoin(left=original_reads, right=original_bindings, left-on=["head","file"], right-on=["head","file"]);
let original_parameter_uses = select l.reference as head, l.file as file from "binding-use" as l join parameters as r on l.binding = r.id and l.file = r.file;
let original_type_uses0 = select l.reference as head, r.ordinal as binding_point, l.file as file from "binding-use" as l join all_type_events as r on l.binding = r.occurrence and l.file = r.file;
let original_type_uses = select l.head as head, l.file as file from original_type_uses0 as l join original_reads as r on l.head = r.head and l.file = r.file where l.binding_point <= r.ordinal;
let original_header_axes = axis(from=original_head_inputs, relation="semantic-child", direction=nearest-ancestor, domain=header_roots);
let original_header_outer_owners = select l.id as head, r.owner as owner, l.file as file from original_header_axes as l join header_roots as r on l.related = r.id and l.file = r.file;
let original_header_self_owners = select l.id as head, r.owner as owner, l.file as file from original_head_inputs as l join header_roots as r on l.id = r.id and l.file = r.file;
let original_header_owners = union(left=original_header_outer_owners, right=original_header_self_owners);
let original_header_labels = select l.head as head, l.owner as owner, r.name as name, l.file as file from original_header_owners as l join "identifier" as r on l.head = r.id and l.file = r.file;
let original_header_parameters = select l.head as head, l.file as file from original_header_labels as l join owned_parameters as r on l.owner = r.owner and l.name = r.name and l.file = r.file;
let original_type_barriers0 = union(left=original_parameter_uses, right=original_type_uses);
let original_type_barriers = union(left=original_type_barriers0, right=original_header_parameters);
let original_implicit_reads = antijoin(left=original_unbound_reads, right=original_type_barriers, left-on=["head","file"], right-on=["head","file"]);
let original_implicit_heads = select l.check as check, l.root as root, l.file as file from named_roots as l join original_implicit_reads as r on l.head = r.head and l.file = r.file;
let original_implicit_builtin_heads = select l.check as check, l.file as file from original_implicit_heads as l join "identifier" as r on l.root = r.id and l.file = r.file where concat("builtins.",r.name) = $builtin;
let truly_cached_builtin_heads = antijoin(left=original_implicit_builtin_heads, right=deferred_head_checks, left-on=["check","file"], right-on=["check","file"]);
let cached_type_checks = select l.check as check, l.file as file from heads as l join original_type_barriers as r on l.head = r.head and l.file = r.file;
let cached_root_paths = antijoin(left=unscoped_cached_root_paths, right=cached_type_checks, left-on=["check","file"], right-on=["check","file"]);
let actual_cached_builtin_paths = select check, file from cached_root_paths where path = $builtin;
let cached_builtin_paths = union(left=actual_cached_builtin_paths, right=truly_cached_builtin_heads);

let slow_cached_builtins = select l.check as check, l.file as file from cached_builtin_paths as l join seen_builtins as r on l.check = r.check and l.file = r.file;
let cached_typing_paths = select check, file from cached_root_paths where path = concat("typing.",$typing) or path = concat("typing_extensions.",$typing) or path = concat("_typeshed.",$typing);
let cached_names = select reference as head, file from "binding-use";
let uncached_heads_base = antijoin(left=heads, right=cached_names, left-on=["head","file"], right-on=["head","file"]);
let native_cached_type_checks = antijoin(left=cached_type_checks, right=deferred_head_checks, left-on=["check","file"], right-on=["check","file"]);
let uncached_heads0 = antijoin(left=uncached_heads_base, right=native_cached_type_checks, left-on=["check","file"], right-on=["check","file"]);
let postponed_heads = select l.check as check, l.root as root, l.head as head, l.file as file from heads as l join deferred_head_checks as r on l.check = r.check and l.file = r.file;
let uncached_heads = union(left=uncached_heads0, right=postponed_heads);
let fresh_bindings0 = select l.check as check, l.root as root, l.head as head, r.occurrence as occurrence, r.kind as kind, l.file as file from uncached_heads as l join current_bindings as r on l.check = r.check and l.head = r.head and l.file = r.file;
let fresh_bindings = antijoin(left=fresh_bindings0, right=type_barriers, left-on=["check","head","file"], right-on=["check","head","file"]);
let import_paths = select l.check as check, l.root as root, l.head as head, l.occurrence as definition, r.target as path, l.file as file from fresh_bindings as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let direct_imports0 = select id, file from "defines" where kind = "import" and refinement = "import";
let asnames = select parent as id, file from "semantic-child" where field = "asname";
let direct_imports = antijoin(left=direct_imports0, right=asnames, left-on=["id","file"], right-on=["id","file"]);
let deep_modules = select l.check as check, l.root as root, l.head as head, l.path as path, l.file as file from import_paths as l join direct_imports as r on l.definition = r.id and l.file = r.file where starts_with(l.path,"typing.") or starts_with(l.path,"typing_extensions.") or starts_with(l.path,"_typeshed.") or starts_with(l.path,"builtins.");
let direct_name_imports0 = select l.check as check, l.root as root, l.head as head, l.path as path, l.file as file from import_paths as l join named_roots as r on l.check = r.check and l.root = r.root and l.file = r.file;
let direct_name_imports = antijoin(left=direct_name_imports0, right=deep_modules, left-on=["check","root","file"], right-on=["check","root","file"]);
let fresh_typing_names = select check, file from direct_name_imports where path = concat("typing.",$typing) or path = concat("typing_extensions.",$typing) or path = concat("_typeshed.",$typing);
let fresh_builtin_names0 = select check, file from direct_name_imports where path = $builtin;
let fresh_builtin_names = select l.check as check, l.file as file from fresh_builtin_names0 as l join seen_builtins as r on l.check = r.check and l.file = r.file;
let attribute_labels0 = select l.check as check, l.root as root, l.head as head, r.child as label, l.file as file from simple_attributes as l join "semantic-child" as r on l.root = r.parent and l.file = r.file where r.field = "attr";
let attribute_labels = select l.check as check, l.root as root, l.head as head, r.name as name, l.file as file from attribute_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let imported_attributes = select l.check as check, l.root as root, l.head as head, l.name as name, r.path as path, l.file as file from attribute_labels as l join import_paths as r on l.check = r.check and l.head = r.head and l.file = r.file;
let simple_typing_modules = select check, root, head, name, file from imported_attributes where path = "typing" or path = "typing_extensions" or path = "_typeshed";
let deep_typing_modules = select l.check as check, l.root as root, l.head as head, l.name as name, l.file as file from imported_attributes as l join deep_modules as r on l.check = r.check and l.head = r.head and l.file = r.file where starts_with(l.path,"typing.") or starts_with(l.path,"typing_extensions.") or starts_with(l.path,"_typeshed.");
let typing_module_attributes = union(left=simple_typing_modules, right=deep_typing_modules);
let fresh_typing_attributes = select check, file from typing_module_attributes where name = $typing;
let simple_builtin_modules = select check, root, head, name, file from imported_attributes where path = "builtins";
let deep_builtin_modules = select l.check as check, l.root as root, l.head as head, l.name as name, l.file as file from imported_attributes as l join deep_modules as r on l.check = r.check and l.head = r.head and l.file = r.file where starts_with(l.path,"builtins.");
let builtin_module_attributes = union(left=simple_builtin_modules, right=deep_builtin_modules);
let fresh_builtin_attributes0 = select check, file from builtin_module_attributes where concat("builtins.",name) = $builtin;
let fresh_builtin_attributes = select l.check as check, l.file as file from fresh_builtin_attributes0 as l join seen_builtins as r on l.check = r.check and l.file = r.file;
let fresh_implicit_candidates = select l.check as check, l.file as file from implicit_candidates as l join uncached_heads as r on l.check = r.check and l.file = r.file;
let slow_fresh_implicit = select l.check as check, l.file as file from fresh_implicit_candidates as l join seen_builtins as r on l.check = r.check and l.file = r.file;
let slow_builtins = union(left=slow_cached_builtins, right=slow_fresh_implicit);
let builtin_names0 = union(left=fast_builtin_matches, right=slow_builtins);
let builtin_names1 = union(left=builtin_names0, right=fresh_builtin_names);
let builtin_names2 = union(left=builtin_names1, right=fresh_builtin_attributes);
let typing_names0 = union(left=cached_typing_paths, right=fresh_typing_names);
let typing_names1 = union(left=typing_names0, right=fresh_typing_attributes);
let result = union(left=builtin_names2, right=typing_names1);
return result;
