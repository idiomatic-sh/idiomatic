import deferred_class_origins from "python/ruff/deferred-class-origins";
import qualified_origins from "python/ruff/qualified-origins";
input ordered_contexts: relation<context: node, initial_scope: node, point: number, file: file>;
input root_classes: relation<context: node, class: node, file: file>;
input modes: relation<context: node, mode: number, file: file>;
input resolved_base_edges: relation<context: node, child_class: node, base: node, parent_class: node, file: file>;
output relation<context: node, class: node, certainty: symbol, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let subscript_nodes = select id, file from nodes where kind = "subscript";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let class_bases = select declaration as class, occurrence as base, file from "inherits";
let name_nodes = select id, file from nodes where kind = "name";
let attribute_nodes = select id, file from nodes where kind = "attribute";
let origin_expressions = union(left=name_nodes, right=attribute_nodes);
let initial_mode_contexts = select l.context as context, l.initial_scope as initial_scope, l.point as point, l.point as header_point, l.file as file from ordered_contexts as l join modes as r on l.context = r.context and l.file = r.file where r.mode = 0 and matches(l.file, "\.pyi$");
let initial_origin_context_rows = extend(from=initial_mode_contexts, values={stage: 0});
let initial_origin_contexts = select context, initial_scope, point, header_point, stage, file from initial_origin_context_rows;
let initial_origins = qualified_origins(symbol_contexts=initial_origin_contexts, expressions=origin_expressions);
let late_mode_files = select file from modes where mode = 1 and matches(file, "\.pyi$");
let late_origin_expressions = select l.id as id, l.file as file from origin_expressions as l join late_mode_files as r on l.file = r.file;
let late_cached_origins = deferred_class_origins(expressions=late_origin_expressions);
let late_origins = select l.context as context, r.expression as expression, r.path as path, l.file as file from modes as l join late_cached_origins as r on l.file = r.file where l.mode = 1;
let contextual_origins = union(left=initial_origins, right=late_origins);
let original_origins = select id as expression, path, file from "qualified-name";
let stub_contexts = select * from ordered_contexts where matches(file, "\.pyi$");
let py_contexts = antijoin(left=ordered_contexts, right=stub_contexts, left-on=["context", "file"], right-on=["context", "file"]);
let cached_py_origins = select l.context as context, r.expression as expression, r.path as path, l.file as file from py_contexts as l join original_origins as r on l.file = r.file;
let all_origins = union(left=contextual_origins, right=cached_py_origins);
let metaclass_names = select context, expression as id, path, file from all_origins where path = "builtins.type" or path = "abc.ABCMeta" or path = "enum.EnumMeta" or path = "enum.EnumType";
let named_success_bases = select r.context as context, l.class as class, l.base as base, l.file as file from class_bases as l join metaclass_names as r on l.base = r.id and l.file = r.file;
let type_subscript_values = select l.id as subscript, r.child as value, l.file as file from subscript_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let builtin_type_subscripts = select r.context as context, l.subscript as base, l.file as file from type_subscript_values as l join metaclass_names as r on l.value = r.id and l.file = r.file where r.path = "builtins.type";
let subscript_success_bases = select r.context as context, l.class as class, l.base as base, l.file as file from class_bases as l join builtin_type_subscripts as r on l.base = r.base and l.file = r.file;
let call_nodes = select id, file from nodes where kind = "call";
let call_bases = select l.class as class, l.base as base, l.file as file from class_bases as l join call_nodes as r on l.base = r.id and l.file = r.file;
let call_base_functions = select l.class as class, l.base as base, r.child as func, l.file as file from call_bases as l join "semantic-child" as r on l.base = r.parent and l.file = r.file where r.field = "func";
let builtin_type_call_bases = select r.context as context, l.class as class, l.base as base, l.file as file from call_base_functions as l join metaclass_names as r on l.func = r.id and l.file = r.file where r.path = "builtins.type";
let call_argument_counts = group-count(from="call-argument", keys=["call", "file"], count="count", distinct="expression");
let call_success_bases = select l.context as context, l.class as class, l.base as base, l.file as file from builtin_type_call_bases as l join call_argument_counts as r on l.base = r.call and l.file = r.file where r.count = 1;
let direct_success_bases0 = union(left=named_success_bases, right=subscript_success_bases);
let direct_success_bases = union(left=direct_success_bases0, right=call_success_bases);
let direct_context_success_bases = select context, class, base, file from direct_success_bases;
let base_locations = select l.class as class, l.base as base, l.file as file, r."start-byte" as position from class_bases as l join "source-location" as r on l.base = r.id and l.file = r.file;
let contextual_base_locations = select l.context as context, r.class as source, r.base as base, r.position as position, l.file as file from ordered_contexts as l join base_locations as r on l.file = r.file;
let resolved_class_edges = select l.context as context, l.source as source, r.parent_class as destination, l.position as position, l.base as base, l.file as file from contextual_base_locations as l join resolved_base_edges as r on l.context = r.context and l.base = r.base and l.file = r.file;
let unresolved_base_locations = antijoin(left=contextual_base_locations, right=resolved_base_edges, left-on=["context", "base", "file"], right-on=["context", "base", "file"]);
let terminal_edges = select context, source, base as destination, position, base, file from unresolved_base_locations;
let class_edges = union(left=resolved_class_edges, right=terminal_edges);
let entry_edges = select l.context as context, l.context as source, r.destination as destination, r.position as position, r.base as base, l.file as file from root_classes as l join class_edges as r on l.context = r.context and l.class = r.source and l.file = r.file;
let all_edges = union(left=class_edges, right=entry_edges);
let edge_groups = group-count(from=all_edges, keys=["context", "source", "destination", "position", "base", "file"], count="count", distinct="base");
let traversal_edges = select context, source, destination, position, base, file from edge_groups;
let traversal_roots = select context as entry, context, file from ordered_contexts;
let visits = ordered-dfs(from=traversal_roots, root="entry", edges=traversal_edges, source="source", destination="destination", order="position", edge="base", keys=["context", "file"], output="visit");
let true_visits = select l.context as context, l.entry as entry, l.visit as visit, l.file as file from visits as l join direct_context_success_bases as r on l.context = r.context and l.base = r.base and l.file = r.file;
let later_true_visits = select l.context as context, l.visit as visit, l.file as file from true_visits as l join true_visits as r on l.context = r.context and l.file = r.file where r.visit < l.visit;
let first_true_visits = antijoin(left=true_visits, right=later_true_visits, left-on=["context", "visit", "file"], right-on=["context", "visit", "file"]);
let successful_class_rows = select l.context as context, r.class as class, l.file as file from first_true_visits as l join root_classes as r on l.context = r.context and l.file = r.file;
let successful_class_groups = group-count(from=successful_class_rows, keys=["context", "class", "file"], count="count", distinct="class");
let successful_classes = select context, class, file from successful_class_groups;
let called_visits = select l.context as context, l.visit as visit, l.file as file from visits as l join call_nodes as r on l.base = r.id and l.file = r.file;
let maybe_contexts = select l.context as context, l.file as file from called_visits as l join first_true_visits as r on l.context = r.context and l.file = r.file where l.visit <= r.visit;
let maybe_classes = select l.context as context, l.class as class, l.file as file from successful_classes as l join maybe_contexts as r on l.context = r.context and l.file = r.file;
let metaclasses = antijoin(left=successful_classes, right=maybe_classes, left-on=["context", "class", "file"], right-on=["context", "class", "file"]);
let classification_kinds = select id as class, kind, file from nodes where kind = "class-def";
let typed_yes_classes = select l.context as context, l.class as class, r.kind as kind, l.file as file from metaclasses as l join classification_kinds as r on l.class = r.class and l.file = r.file;
let labelled_yes_classes = replace(from=typed_yes_classes, text="kind", pattern="^class-def$", replacement="yes", output="certainty");
let yes_classes = select context, class, certainty, file from labelled_yes_classes;
let call_maybe_rows = select l.context as context, l.class as class, l.file as file from successful_classes as l join maybe_classes as r on l.context = r.context and l.class = r.class and l.file = r.file;
let function_nodes = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let statement_parents = select id, file from nodes where kind = "class-def" or kind = "function-def" or kind = "async-function-def" or kind = "if" or kind = "for" or kind = "async-for" or kind = "while" or kind = "with" or kind = "async-with" or kind = "try" or kind = "try-star" or kind = "match";
let nearest_statement_parents = axis(from=function_nodes, relation="semantic-child", direction=nearest-ancestor, domain=statement_parents);
let class_nodes = select id, file from nodes where kind = "class-def";
let direct_class_functions = select l.id as function, l.related as class, l.file as file from nearest_statement_parents as l join class_nodes as r on l.related = r.id and l.file = r.file;
let new_definitions = select id as function, file from "defines" where name = "__new__";
let new_functions = select l.function as function, l.class as class, l.file as file from direct_class_functions as l join new_definitions as r on l.function = r.function and l.file = r.file;
let new_arguments = select l.function as function, l.class as class, r.child as arguments, l.file as file from new_functions as l join "semantic-child" as r on l.function = r.parent and l.file = r.file where r.field = "args";
let wrappers = select parent as arguments, child as wrapper, ordinal, file from "semantic-child" where field = "args" or field = "posonlyargs" or field = "kwonlyargs";
let wrapper_counts = group-count(from=wrappers, keys=["arguments", "file"], count="count", distinct="wrapper");
let four_wrapper_new = select l.function as function, l.class as class, l.arguments as arguments, l.file as file from new_arguments as l join wrapper_counts as r on l.arguments = r.arguments and l.file = r.file where r.count = 4;
let kwargs = select parent as arguments, file from "semantic-child" where field = "kwarg";
let new_with_kwargs = select l.function as function, l.class as class, l.arguments as arguments, l.file as file from four_wrapper_new as l join kwargs as r on l.arguments = r.arguments and l.file = r.file;
let varargs = select parent as arguments, file from "semantic-child" where field = "vararg";
let eligible_new = antijoin(left=new_with_kwargs, right=varargs, left-on=["arguments", "file"], right-on=["arguments", "file"]);
let wrapper_pairs = select l.arguments as arguments, l.wrapper as earlier, r.wrapper as later, l.file as file from wrappers as l join wrappers as r on l.arguments = r.arguments and l.file = r.file where l.ordinal < r.ordinal;
let wrapper_positions = group-count(from=wrapper_pairs, keys=["arguments", "later", "file"], count="position", distinct="earlier");
let new_wrappers = select l.function as function, l.class as class, r.later as wrapper, r.position as position, l.file as file from eligible_new as l join wrapper_positions as r on l.arguments = r.arguments and l.file = r.file;
let new_parameters = select l.function as function, l.class as class, l.position as position, r.child as parameter, l.file as file from new_wrappers as l join "semantic-child" as r on l.wrapper = r.parent and l.file = r.file where r.field = "args" or r.field = "posonlyargs" or r.field = "kwonlyargs";
let new_annotations = select l.function as function, l.class as class, l.position as position, r.child as annotation, l.file as file from new_parameters as l join "semantic-child" as r on l.parameter = r.parent and l.file = r.file where r.field = "annotation";
let direct_annotations = select function, class, position, annotation as expression, file from new_annotations;
let mapped_annotations = select l.function as function, l.class as class, l.position as position, r.value as expression, l.file as file from new_annotations as l join type_subscript_values as r on l.annotation = r.subscript and l.file = r.file;
let annotation_expressions = union(left=direct_annotations, right=mapped_annotations);
let builtin_annotations = select l.function as function, l.class as class, l.position as position, r.path as path, l.file as file from annotation_expressions as l join "qualified-name" as r on l.expression = r.id and l.file = r.file;
let correct_new_annotations = select function, class, position, file from builtin_annotations where position = 1 and path = "builtins.str" or position = 2 and path = "builtins.tuple" or position = 3 and path = "builtins.dict";
let correct_new_counts = group-count(from=correct_new_annotations, keys=["function", "class", "file"], count="count", distinct="position");
let signature_classes = select class, file from correct_new_counts where count = 3;
let signature_classes_with_bases = select l.class as class, l.file as file from signature_classes as l join class_bases as r on l.class = r.class and l.file = r.file;
let contextual_signature_classes = select l.context as context, r.class as class, l.file as file from ordered_contexts as l join signature_classes_with_bases as r on l.file = r.file;
let signature_only_classes = antijoin(left=contextual_signature_classes, right=successful_classes, left-on=["context", "class", "file"], right-on=["context", "class", "file"]);
let all_maybe_rows = union(left=call_maybe_rows, right=signature_only_classes);
let typed_maybe_classes = select l.context as context, l.class as class, r.kind as kind, l.file as file from all_maybe_rows as l join classification_kinds as r on l.class = r.class and l.file = r.file;
let labelled_maybe_classes = replace(from=typed_maybe_classes, text="kind", pattern="^class-def$", replacement="maybe", output="certainty");
let all_maybe_classes = select context, class, certainty, file from labelled_maybe_classes;
let classifications = union(left=yes_classes, right=all_maybe_classes);
return classifications;
