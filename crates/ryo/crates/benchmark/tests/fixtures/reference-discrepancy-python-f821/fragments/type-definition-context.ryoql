input expressions: relation<id: node, file: file>;
output relation<id: node, file: file, kind: symbol>;
let nodes = select id, kind, file, span from "semantic-syntax";
let calls = select id, file, span from nodes where kind = "call";
let value_edges = select parent, child, file from "semantic-child" where field = "value";
let func_edges = select parent, child, file from "semantic-child" where field = "func";
let callee_nodes = select l.id as call, l.file as file, r.child as callee from calls as l join func_edges as r on l.id = r.parent and l.file = r.file;
let qualified_calls = select l.call as call, l.file as file, r.path as path from callee_nodes as l join "qualified-name" as r on l.callee = r.id and l.file = r.file;
let keyword_nodes = select id, file from nodes where kind = "keyword";
let keyword_values = select l.id as keyword, l.file as file, r.child as value from keyword_nodes as l join value_edges as r on l.id = r.parent and l.file = r.file;
let keyword_owners = axis(from=keyword_nodes, relation="semantic-child", direction=nearest-ancestor, domain=calls);
let named_keyword_edges = select parent, child, file from "semantic-child" where field = "arg";
let named_keyword_ids = select l.id as keyword, l.related as call, l.file as file, r.child as identifier from keyword_owners as l join named_keyword_edges as r on l.id = r.parent and l.file = r.file;
let keyword_names = select l.keyword as keyword, l.call as call, l.file as file, r.name as name from named_keyword_ids as l join "identifier" as r on l.identifier = r.id and l.file = r.file;
let named_keyword_values = select l.call as call, l.file as file, l.name as name, r.value as value from keyword_names as l join keyword_values as r on l.keyword = r.keyword and l.file = r.file;
let all_arguments = select call, file, expression as value, position from "call-argument";
let positional_arguments = antijoin(left=all_arguments, right=keyword_values, left-on=["value","file"], right-on=["value","file"]);
let positional_counts = group-count(from=positional_arguments, keys=["call","file"], count="count", distinct="value");
let single_arguments = select l.call as call, l.file as file, l.value as value from positional_arguments as l join positional_counts as r on l.call = r.call and l.file = r.file where r.count = 1;
let empty_calls = antijoin(left=calls, right=all_arguments, left-on=["id","file"], right-on=["call","file"]);
let integer_zero = select id, file from "literal-properties" where kind = "integer" and zero = "true";
let constants = select id, file from nodes where kind = "constant";
let plain_zero = select l.id as id, l.file as file from integer_zero as l join constants as r on l.id = r.id and l.file = r.file;
let starred_nodes = select id, file from nodes where kind = "starred";
let element_edges = select parent, child, file from "semantic-child" where field = "elts";
let children = select parent, child, field, ordinal, file from "semantic-child";
let annotations = select child as id, file from children where field = "annotation" or field = "returns";
let alias_names = select id, file from "qualified-name" where path = "typing.TypeAlias" or path = "typing_extensions.TypeAlias" or path = "_typeshed.TypeAlias";
let alias_owners = select l.parent as owner, l.file as file from children as l join alias_names as r on l.child = r.id and l.file = r.file where l.field = "annotation";
let alias_values = select r.child as id, l.file as file from alias_owners as l join children as r on l.owner = r.parent and l.file = r.file where r.field = "value";
let type_declarations = select id, file from nodes where kind = "type-alias" or kind = "type-var" or kind = "type-var-tuple" or kind = "param-spec";
let deferred_type_roots = select r.child as id, l.file as file from type_declarations as l join children as r on l.id = r.parent and l.file = r.file where r.field = "value" or r.field = "bound" or r.field = "default-value";
let embedded_roots = select root as id, file from "embedded-expression";
let generic_names = select id, file from "qualified-name" where matches(path, "^(?:builtins[.]dict|builtins[.]frozenset|builtins[.]list|builtins[.]set|builtins[.]tuple|builtins[.]type|collections[.]ChainMap|collections[.]Counter|collections[.]OrderedDict|collections[.]abc[.]AsyncGenerator|collections[.]abc[.]AsyncIterable|collections[.]abc[.]AsyncIterator|collections[.]abc[.]Awaitable|collections[.]abc[.]ByteString|collections[.]abc[.]Callable|collections[.]abc[.]Collection|collections[.]abc[.]Container|collections[.]abc[.]Coroutine|collections[.]abc[.]Generator|collections[.]abc[.]ItemsView|collections[.]abc[.]Iterable|collections[.]abc[.]Iterator|collections[.]abc[.]KeysView|collections[.]abc[.]Mapping|collections[.]abc[.]MappingView|collections[.]abc[.]MutableMapping|collections[.]abc[.]MutableSequence|collections[.]abc[.]MutableSet|collections[.]abc[.]Reversible|collections[.]abc[.]Sequence|collections[.]abc[.]Set|collections[.]abc[.]ValuesView|collections[.]defaultdict|collections[.]deque|contextlib[.]AbstractAsyncContextManager|contextlib[.]AbstractContextManager|re[.]Match|re[.]Pattern|typing[.]AbstractSet|typing[.]AsyncContextManager|typing[.]AsyncGenerator|typing[.]AsyncIterator|typing[.]Awaitable|typing[.]BinaryIO|typing[.]ByteString|typing[.]Callable|typing[.]ChainMap|typing[.]ClassVar|typing[.]Collection|typing[.]Concatenate|typing[.]Container|typing[.]ContextManager|typing[.]Coroutine|typing[.]Counter|typing[.]DefaultDict|typing[.]Deque|typing[.]Dict|typing[.]Final|typing[.]FrozenSet|typing[.]Generator|typing[.]Generic|typing[.]IO|typing[.]ItemsView|typing[.]Iterable|typing[.]Iterator|typing[.]KeysView|typing[.]List|typing[.]Mapping|typing[.]Match|typing[.]MutableMapping|typing[.]MutableSequence|typing[.]MutableSet|typing[.]Optional|typing[.]OrderedDict|typing[.]Pattern|typing[.]Reversible|typing[.]Sequence|typing[.]Set|typing[.]TextIO|typing[.]Tuple|typing[.]Type|typing[.]TypeGuard|typing[.]Union|typing[.]Unpack|typing[.]ValuesView|typing[.]io[.]BinaryIO|typing[.]io[.]IO|typing[.]io[.]TextIO|typing[.]re[.]Match|typing[.]re[.]Pattern|typing_extensions[.]AsyncContextManager|typing_extensions[.]AsyncGenerator|typing_extensions[.]AsyncIterable|typing_extensions[.]AsyncIterator|typing_extensions[.]Awaitable|typing_extensions[.]ChainMap|typing_extensions[.]ClassVar|typing_extensions[.]Concatenate|typing_extensions[.]ContextManager|typing_extensions[.]Coroutine|typing_extensions[.]Counter|typing_extensions[.]DefaultDict|typing_extensions[.]Deque|typing_extensions[.]Type|weakref[.]WeakKeyDictionary|weakref[.]WeakSet|weakref[.]WeakValueDictionary)$");
let subscripts = select id, file from nodes where kind = "subscript";
let subscript_values = select l.id as subscript, l.file as file, r.child as value from subscripts as l join value_edges as r on l.id = r.parent and l.file = r.file;
let generic_subscripts = select l.subscript as id, l.file as file from subscript_values as l join generic_names as r on l.value = r.id and l.file = r.file;
let target_roots = select child as id, file from children where field = "target" or field = "targets" or field = "optional-vars";
let target_subscripts_a = axis(from=target_roots, relation="semantic-child", direction=descendant, domain=subscripts);
let target_subscripts_b = select l.id as related, l.file as file from target_roots as l join subscripts as r on l.id = r.id and l.file = r.file;
let target_subscripts_aa = select related, file from target_subscripts_a;
let target_subscripts = union(left=target_subscripts_aa, right=target_subscripts_b);
let load_generics = antijoin(left=generic_subscripts, right=target_subscripts, left-on=["id","file"], right-on=["related","file"]);
let generic_slices = select r.child as id, l.file as file from load_generics as l join children as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let annotations_a = union(left=annotations, right=alias_values);
let annotations_b = union(left=deferred_type_roots, right=embedded_roots);
let annotations_all = union(left=annotations_a, right=annotations_b);
let base_type_roots = union(left=annotations_all, right=generic_slices);
let typed_callables = select call, path, file from qualified_calls where matches(path, "^(?:(?:typing|typing_extensions|_typeshed)[.](?:cast|NewType|TypeVar|TypeAliasType|NamedTuple|TypedDict)|mypy_extensions[.](?:Arg|DefaultArg|NamedArg|DefaultNamedArg|VarArg|KwArg)|builtins[.]bool)$");
let call_positional_predecessors = select l.call as call, l.file as file, l.value as value, r.value as prior from positional_arguments as l join positional_arguments as r on l.call = r.call and l.file = r.file where r.position < l.position;
let call_positional_ranks = group-count(from=call_positional_predecessors, keys=["call","file","value"], count="rank", distinct="prior");
let call_first_a = antijoin(left=positional_arguments, right=call_positional_ranks, left-on=["call","file","value"], right-on=["call","file","value"]);
let call_first_b = select call, file, value from call_first_a;
let call_first = extend(from=call_first_b, values={rank: 0});
let positional_ranked = union(left=call_first, right=call_positional_ranks);
let sourced_arguments = select l.call as call, l.file as file, l.value as value, l.position as position, r.path as path from all_arguments as l join typed_callables as r on l.call = r.call and l.file = r.file;
let ranked_arguments = select l.call as call, l.file as file, l.value as value, l.rank as rank, r.path as path from positional_ranked as l join typed_callables as r on l.call = r.call and l.file = r.file;
let named_arguments = select l.call as call, l.file as file, l.name as name, l.value as value, r.path as path from named_keyword_values as l join typed_callables as r on l.call = r.call and l.file = r.file;
let cast_types = select value as id, file from sourced_arguments where matches(path, "[.]cast$") and position = 0;
let second_types = select value as id, file from sourced_arguments where matches(path, "[.](?:NewType|TypeAliasType)$") and position = 1;
let constraint_types = select value as id, file from ranked_arguments where matches(path, "[.]TypeVar$") and rank > 0;
let keyword_types = select value as id, file from named_arguments where matches(path, "[.]cast$") and name = "typ" or matches(path, "[.]NewType$") and name = "tp" or matches(path, "[.]TypeAliasType$") and (name = "value" or name = "type_params") or matches(path, "[.]TypeVar$") and (name = "bound" or name = "default");
let mypy_types = select value as id, file from ranked_arguments where starts_with(path, "mypy_extensions.") and rank = 0;
let mypy_calls_with_positional = select call, file from ranked_arguments where starts_with(path, "mypy_extensions.");
let keyword_mypy_calls = antijoin(left=named_arguments, right=mypy_calls_with_positional, left-on=["call","file"], right-on=["call","file"]);
let keyword_mypy_types = select value as id, file from keyword_mypy_calls where starts_with(path, "mypy_extensions.") and name = "type";
let call_types_a = union(left=cast_types, right=second_types);
let call_types_b = union(left=constraint_types, right=keyword_types);
let call_types_c = union(left=mypy_types, right=keyword_mypy_types);
let call_types_d = union(left=call_types_a, right=call_types_b);
let basic_call_types = union(left=call_types_c, right=call_types_d);
let tuples_lists = select id, file from nodes where kind = "tuple" or kind = "list";
let tuple_elements = select l.id as owner, r.child as element, r.ordinal as ordinal, l.file as file from tuples_lists as l join children as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let tuple_counts = group-count(from=tuple_elements, keys=["owner","file"], count="count", distinct="element");
let tuple_pairs = select l.owner as owner, l.file as file, l.element as first, r.element as second from tuple_elements as l join tuple_elements as r on l.owner = r.owner and l.file = r.file where l.ordinal < r.ordinal;
let binary_tuples = select l.owner as owner, l.file as file, l.second as second from tuple_pairs as l join tuple_counts as r on l.owner = r.owner and l.file = r.file where r.count = 2;
let namedtuple_fields = select l.value as id, l.file as file from ranked_arguments as l join tuples_lists as r on l.value = r.id and l.file = r.file where matches(l.path, "[.]NamedTuple$") and l.rank > 0;
let namedtuple_pairs = select r.child as pair, l.file as file from namedtuple_fields as l join children as r on l.id = r.parent and l.file = r.file where r.field = "elts";
let namedtuple_types = select r.second as id, l.file as file from namedtuple_pairs as l join binary_tuples as r on l.pair = r.owner and l.file = r.file;
let namedtuple_keyword_types = select value as id, file from named_arguments where matches(path, "[.]NamedTuple$");
let dictionaries = select id, file from nodes where kind = "dict";
let dict_keys = select l.id as dictionary, r.child as id, r.ordinal as ordinal, l.file as file from dictionaries as l join children as r on l.id = r.parent and l.file = r.file where r.field = "keys";
let dict_values = select l.id as dictionary, r.child as id, r.ordinal as ordinal, l.file as file from dictionaries as l join children as r on l.id = r.parent and l.file = r.file where r.field = "values";
let keyed_values = ordered-match(left=dict_keys, right=dict_values, left-on=["dictionary","file"], right-on=["dictionary","file"], left-order="ordinal", right-order="ordinal", output={dictionary:[left,dictionary],id:[right,id],file:[left,file]});
let typeddict_dicts = select value as dictionary, file from ranked_arguments where matches(path, "[.]TypedDict$") and rank > 0;
let named_keyword_calls = select call, file, value from named_keyword_values;
let unpacked_keywords = antijoin(left=keyword_values, right=named_keyword_calls, left-on=["value","file"], right-on=["value","file"]);
let unpacked_keyword_calls = select l.value as value, l.file as file, r.related as call from unpacked_keywords as l join keyword_owners as r on l.keyword = r.id and l.file = r.file;
let unpacked_namedtuple_dicts = select l.value as dictionary, l.file as file from unpacked_keyword_calls as l join typed_callables as r on l.call = r.call and l.file = r.file where matches(r.path, "[.]NamedTuple$");
let field_dicts = union(left=typeddict_dicts, right=unpacked_namedtuple_dicts);
let dictionary_call_types = select r.id as id, l.file as file from field_dicts as l join keyed_values as r on l.dictionary = r.dictionary and l.file = r.file;
let typeddict_all_keywords = select l.value as id, l.file as file from named_arguments as l where matches(l.path, "[.]TypedDict$");
let typeddict_unpacked_types = select l.value as id, l.file as file from unpacked_keyword_calls as l join typed_callables as r on l.call = r.call and l.file = r.file where matches(r.path, "[.]TypedDict$");
let structural_types_a = union(left=namedtuple_types, right=namedtuple_keyword_types);
let structural_types_b = union(left=dictionary_call_types, right=typeddict_all_keywords);
let structural_types_c = union(left=structural_types_a, right=structural_types_b);
let structural_call_types = union(left=structural_types_c, right=typeddict_unpacked_types);
let call_type_roots = union(left=basic_call_types, right=structural_call_types);
let annotated_names = select id, file from "qualified-name" where path = "typing.Annotated" or path = "typing_extensions.Annotated";
let annotated_subscripts = select l.subscript as id, l.file as file from subscript_values as l join annotated_names as r on l.value = r.id and l.file = r.file;
let annotated_slices = select r.child as slice, l.file as file from annotated_subscripts as l join children as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let annotated_elements = select l.slice as slice, l.file as file, r.child as element, r.ordinal as ordinal from annotated_slices as l join children as r on l.slice = r.parent and l.file = r.file where r.field = "elts";
let later_metadata = select l.slice as slice, l.file as file, l.element as element from annotated_elements as l join annotated_elements as r on l.slice = r.slice and l.file = r.file where r.ordinal < l.ordinal;
let annotated_firsts = antijoin(left=annotated_elements, right=later_metadata, left-on=["slice","file","element"], right-on=["slice","file","element"]);
let annotated_types = select element as id, file from annotated_firsts;
let annotated_values = select element as id, file from later_metadata;
let typed_dict_names = select id, file from "qualified-name" where path = "typing.TypedDict" or path = "typing_extensions.TypedDict";
let typed_dict_subscripts_a = select l.subscript as id, l.file as file from subscript_values as l join typed_dict_names as r on l.value = r.id and l.file = r.file;
let typed_dict_subscripts = antijoin(left=typed_dict_subscripts_a, right=target_subscripts, left-on=["id","file"], right-on=["related","file"]);
let typed_dict_slices = select r.child as id, l.file as file from typed_dict_subscripts as l join children as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let typed_dict_value_roots_a = select r.child as id, l.file as file from typed_dict_slices as l join children as r on l.id = r.parent and l.file = r.file where r.field = "keys" or r.field = "values";
let typed_dict_value_roots = union(left=typed_dict_slices, right=typed_dict_value_roots_a);
let typed_dict_field_types = select r.id as id, l.file as file from typed_dict_slices as l join keyed_values as r on l.id = r.dictionary and l.file = r.file;
let all_types_a = union(left=base_type_roots, right=call_type_roots);
let all_types_b = union(left=all_types_a, right=annotated_types);
let all_types = union(left=all_types_b, right=typed_dict_field_types);
let bool_calls = select call, file from typed_callables where path = "builtins.bool";
let nonbool_arguments = antijoin(left=all_arguments, right=bool_calls, left-on=["call","file"], right-on=["call","file"]);
let argument_value_roots = select value as id, file from nonbool_arguments;
let all_value_roots_a = union(left=argument_value_roots, right=annotated_values);
let all_value_roots = union(left=all_value_roots_a, right=typed_dict_value_roots);
let value_roots = antijoin(left=all_value_roots, right=all_types, left-on=["id","file"], right-on=["id","file"]);
let skipped_unpacked = select l.value as id, l.file as file from unpacked_keyword_calls as l join typed_callables as r on l.call = r.call and l.file = r.file where matches(r.path, "[.](?:cast|NewType|TypeAliasType)$");
let bool_keyword_owners = select l.value as id, l.file as file, r.related as call from keyword_values as l join keyword_owners as r on l.keyword = r.id and l.file = r.file;
let skipped_bool_keywords = select l.id as id, l.file as file from bool_keyword_owners as l join bool_calls as r on l.call = r.call and l.file = r.file;
let skipped_roots = union(left=skipped_unpacked, right=skipped_bool_keywords);
let skipped_descendants = axis(from=skipped_roots, relation="semantic-child", direction=descendant, domain=expressions);
let skipped_nodes_a = select related as id, file from skipped_descendants;
let skipped_nodes = union(left=skipped_nodes_a, right=skipped_roots);
let visited = antijoin(left=expressions, right=skipped_nodes, left-on=["id","file"], right-on=["id","file"]);
let markers = union(left=all_types, right=value_roots);
let self_markers = select l.id as id, l.file as file from visited as l join markers as r on l.id = r.id and l.file = r.file;
let nested_candidates = antijoin(left=visited, right=self_markers, left-on=["id","file"], right-on=["id","file"]);
let nearest_markers = axis(from=nested_candidates, relation="semantic-child", direction=nearest-ancestor, domain=markers);
let typed_nested = select l.id as id, l.file as file from nearest_markers as l join all_types as r on l.related = r.id and l.file = r.file;
let typed_self = select l.id as id, l.file as file from visited as l join all_types as r on l.id = r.id and l.file = r.file;
let typed_ids = union(left=typed_nested, right=typed_self);
let value_ids = antijoin(left=visited, right=typed_ids, left-on=["id","file"], right-on=["id","file"]);
let typed_rows = extend(from=typed_ids, values={kind: "type"});
let value_rows = extend(from=value_ids, values={kind: "value"});
let result = union(left=typed_rows, right=value_rows);
return result;
