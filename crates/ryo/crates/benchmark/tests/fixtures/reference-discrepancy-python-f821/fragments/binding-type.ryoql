import type_match from "python/ruff/type-match-at-check";
import assigned_values from "python/ruff/assigned-values";
input references: relation<reference: node, file: file>;
param builtin: string;
param typing: string;
param atom: string;
output relation<reference: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let events = select occurrence as binding, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "annotation";
let namespace_history = select occurrence as binding, name, scope, ordinal, kind, file from "binding-event" where kind = "bind" or kind = "annotation" or kind = "delete" or kind = "cleanup" or kind = "global" or kind = "nonlocal";
let prior_bindings = select l.binding as binding, l.file as file from events as l join namespace_history as r on l.name = r.name and l.scope = r.scope and l.file = r.file where r.ordinal < l.ordinal;
let unique_bindings0 = antijoin(left=events, right=prior_bindings, left-on=["binding","file"], right-on=["binding","file"]);
let module_scopes = select id, file from nodes where kind = "module";
let module_bindings = select l.binding as binding, l.name as name, l.file as file from unique_bindings0 as l join module_scopes as r on l.scope = r.id and l.file = r.file;
let builtin_names = select name, file from "implicit-symbol" as q where q.kind = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10);
let shadowed_builtins = select l.binding as binding, l.file as file from module_bindings as l join builtin_names as r on l.name = r.name and l.file = r.file;
let unique_bindings = antijoin(left=unique_bindings0, right=shadowed_builtins, left-on=["binding","file"], right-on=["binding","file"]);
let uses0 = select l.reference as reference, l.file as file, r.binding as binding from references as l join "binding-use" as r on l.reference = r.reference and l.file = r.file;
let ordered_uses = select l.reference as reference, l.binding as binding, r.scope as scope, r.ordinal as ordinal, l.file as file from uses0 as l join events as r on l.binding = r.binding and l.file = r.file;
let earlier_uses = select l.reference as reference, l.binding as binding, l.file as file from ordered_uses as l join ordered_uses as r on l.reference = r.reference and l.scope = r.scope and l.file = r.file where l.ordinal < r.ordinal;
let uses = antijoin(left=uses0, right=earlier_uses, left-on=["reference","binding","file"], right-on=["reference","binding","file"]);
let single_uses = select l.reference as reference, l.file as file, l.binding as binding from uses as l join unique_bindings as r on l.binding = r.binding and l.file = r.file;
let values = select parent, child, file from "semantic-child" where field = "value";
let target_fields = select parent, child, file from "semantic-child" where field = "target" or field = "targets";
let initializers = assigned_values();
let initializer_bindings = select l.value as value, l.file as file, r.binding as binding from initializers as l join events as r on l.binding = r.binding and l.file = r.file;
let atoms = select id, file from "expression-type" where resolution = "atom" and type = $atom;
let atom_bindings = select l.binding as binding, l.file as file from initializer_bindings as l join atoms as r on l.value = r.id and l.file = r.file;
let calls = select id, file from nodes where kind = "call";
let functions = select parent, child, file from "semantic-child" where field = "func";
let call_functions = select l.id as call, l.file as file, r.child as function from calls as l join functions as r on l.id = r.parent and l.file = r.file;
let constructor_bindings = select l.binding as binding, l.value as call, r.function as annotation, l.file as file from initializer_bindings as l join call_functions as r on l.value = r.call and l.file = r.file;
let constructor_requests0 = select l.reference as check, r.annotation as root, l.file as file from single_uses as l join constructor_bindings as r on l.binding = r.binding and l.file = r.file;
let annotations = select parent as owner, child as annotation, file from "semantic-child" where field = "annotation" or field = "returns";
let subscripts = select id, file from nodes where kind = "subscript";
let unsubscripted_annotations = antijoin(left=annotations, right=subscripts, left-on=["annotation","file"], right-on=["id","file"]);
let subscript_annotations = select l.owner as owner, l.file as file, l.annotation as annotation from annotations as l join subscripts as r on l.annotation = r.id and l.file = r.file;
let annotation_bases = select l.owner as owner, l.file as file, r.child as annotation from subscript_annotations as l join values as r on l.annotation = r.parent and l.file = r.file;
let mapped_annotations = union(left=unsubscripted_annotations, right=annotation_bases);
let annotation_targets = select l.owner as owner, l.annotation as annotation, r.child as binding, l.file as file from mapped_annotations as l join target_fields as r on l.owner = r.parent and l.file = r.file;
let assigned_annotation_bindings = select l.binding as binding, l.annotation as annotation, l.file as file from annotation_targets as l join events as r on l.binding = r.binding and l.file = r.file;
let parameter_annotation_bindings = select l.owner as binding, l.annotation as annotation, l.file as file from mapped_annotations as l join events as r on l.owner = r.binding and l.file = r.file;
let function_names = select parent, child, file from "semantic-child" where field = "name";
let function_annotations = select l.annotation as annotation, r.child as name, l.file as file from mapped_annotations as l join function_names as r on l.owner = r.parent and l.file = r.file;
let function_annotation_bindings = select l.name as binding, l.annotation as annotation, l.file as file from function_annotations as l join events as r on l.name = r.binding and l.file = r.file;
let annotation_bindings0 = union(left=assigned_annotation_bindings, right=parameter_annotation_bindings);
let annotation_bindings = union(left=annotation_bindings0, right=function_annotation_bindings);
let annotation_requests0 = select l.reference as check, r.annotation as root, l.file as file from single_uses as l join annotation_bindings as r on l.binding = r.binding and l.file = r.file;
let scope_nodes = select child as id, file from "scope";
let reference_inputs = select reference as id, file from references;
let reference_scope_axes = axis(from=reference_inputs, relation="semantic-child", direction=nearest-ancestor, domain=scope_nodes);
let read_points = select occurrence as id, ordinal as point, file from "binding-event" where kind = "read";
let reference_contexts = select l.id as check, l.related as scope, r.point as point, l.file as file from reference_scope_axes as l join read_points as r on l.id = r.id and l.file = r.file;
let annotation_checks = select l.check as check, l.root as root, r.scope as scope, r.point as point, l.file as file from annotation_requests0 as l join reference_contexts as r on l.check = r.check and l.file = r.file;
let constructor_checks = select l.check as check, l.root as root, r.scope as scope, r.point as point, l.file as file from constructor_requests0 as l join reference_contexts as r on l.check = r.check and l.file = r.file;
let typed_annotations = type_match(checks=annotation_checks, builtin=$builtin, typing=$typing, mode="annotation");
let typed_constructors = type_match(checks=constructor_checks, builtin=$builtin, typing="__not_an_annotation__", mode="visited");
let atom_references = select l.reference as check, l.file as file from single_uses as l join atom_bindings as r on l.binding = r.binding and l.file = r.file;
let typed0 = union(left=typed_annotations, right=typed_constructors);
let typed = union(left=typed0, right=atom_references);
let result = select check as reference, file from typed;
return result;
