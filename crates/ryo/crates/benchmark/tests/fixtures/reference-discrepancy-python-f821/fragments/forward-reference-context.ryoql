import future_context from "python/ruff/future-annotation-context";
import lookup_attribute from "python/ruff/lookup-attribute";
input expressions: relation<id: node, file: file>;
output relation<id: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let functions = select id, file from nodes where kind = "function-def" or kind = "async-function-def";
let args = select id, file from nodes where kind = "arg";
let assignments = select id, file from nodes where kind = "ann-assign";
let owners = union(left=args, right=assignments);
let ordinary_roots = select r.child as id, l.file as file from owners as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let returns = select r.child as id, l.id as function, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "returns";
let return_roots = select id, file from returns;
let annotation_roots = union(left=ordinary_roots, right=return_roots);
let annotation_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=annotation_roots);
let annotation_nested = select id, file from annotation_axes;
let annotation_self = select l.id as id, l.file as file from expressions as l join annotation_roots as r on l.id = r.id and l.file = r.file;
let annotated = union(left=annotation_nested, right=annotation_self);
let future_annotations = future_context(expressions=annotated);
let stub_annotations = select id, file from annotated where matches(file,"[.]pyi$");
let future_types0 = union(left=future_annotations, right=stub_annotations);
let decorator_lists = select l.id as function, r.child as list, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "decorator-list";
let owned_decorators = select l.function as function, r.child as decorator, r.child as expression, l.file as file from decorator_lists as l join "semantic-child" as r on l.list = r.parent and l.file = r.file;
let interface_decorators = select l.function as function, l.file as file from owned_decorators as l join "qualified-name" as r on l.expression = r.id and l.file = r.file where r.path = "functools.singledispatch" or r.path = "functools.singledispatchmethod";
let attrs = select id, file from nodes where kind = "attribute";
let attribute_labels0 = select l.id as id, r.child as label, l.file as file from attrs as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "attr";
let register_attrs = select l.id as id, l.file as file from attribute_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file where r.name = "register";
let register_decorators = select l.decorator as decorator, l.expression as expression, l.function as function, l.file as file from owned_decorators as l join register_attrs as r on l.expression = r.id and l.file = r.file;
let receivers = select l.decorator as decorator, l.function as function, r.child as receiver, l.file as file from register_decorators as l join "semantic-child" as r on l.expression = r.parent and l.file = r.file where r.field = "value";
let decorator_inputs = select decorator as id, file from receivers;
let scopes = select child as id, file from "scope";
let function_scope_axes = axis(from=functions, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let receiver_namespaces = select l.decorator as context, l.receiver as expression, r.related as initial_scope, l.file as file from receivers as l join function_scope_axes as r on l.function = r.id and l.file = r.file;
let read_events = select occurrence as id, ordinal as point, file from "binding-event" where kind = "read";
let decorator_read_axes = axis(from=read_events, relation="semantic-child", direction=ancestor, domain=decorator_inputs);
let decorator_reads = select l.related as context, r.point as point, l.file as file from decorator_read_axes as l join read_events as r on l.id = r.id and l.file = r.file;
let earlier_decorator_reads = select l.context as context, l.point as point, l.file as file from decorator_reads as l join decorator_reads as r on l.context = r.context and l.file = r.file where l.point < r.point;
let decorator_points = antijoin(left=decorator_reads, right=earlier_decorator_reads, left-on=["context","point","file"], right-on=["context","point","file"]);
let receiver_contexts = select l.context as context, l.initial_scope as initial_scope, r.point as point, l.file as file from receiver_namespaces as l join decorator_points as r on l.context = r.context and l.file = r.file;
let receiver_inputs = select expression as id, file from receiver_namespaces;
let receiver_bindings = lookup_attribute(ordered_contexts=receiver_contexts, expressions=receiver_inputs);
let function_names = select l.id as function, r.child as name, l.file as file from functions as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "name";
let resolved_functions = select l.context as decorator, r.id as interface, l.file as file from receiver_bindings as l join functions as r on l.definition = r.id and l.file = r.file;
let registered_interfaces = select l.decorator as decorator, l.file as file from resolved_functions as l join interface_decorators as r on l.interface = r.function and l.file = r.file;
let implementations = select l.function as function, l.file as file from receivers as l join registered_interfaces as r on l.decorator = r.decorator and l.file = r.file;
let parameter_parents = select l.id as id, r.parent as parameters, l.file as file from args as l join "semantic-child" as r on l.id = r.child and l.file = r.file where r.field = "posonlyargs" or r.field = "args" or r.field = "kwonlyargs";
let parameter_function_axes = axis(from=parameter_parents, relation="semantic-child", direction=nearest-ancestor, domain=functions);
let parameter_annotations = select l.id as parameter, r.child as id, l.file as file from parameter_parents as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "annotation";
let parameter_roots = select l.id as id, r.related as function, l.file as file from parameter_annotations as l join parameter_function_axes as r on l.parameter = r.id and l.file = r.file;
let signature_roots = union(left=parameter_roots, right=returns);
let runtime_roots = select l.id as id, l.file as file from signature_roots as l join implementations as r on l.function = r.function and l.file = r.file;
let runtime_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=runtime_roots);
let runtime_nested = select id, file from runtime_axes;
let runtime_self = select l.id as id, l.file as file from expressions as l join runtime_roots as r on l.id = r.id and l.file = r.file;
let runtime_annotations = union(left=runtime_nested, right=runtime_self);
let future_types = antijoin(left=future_types0, right=runtime_annotations, left-on=["id","file"], right-on=["id","file"]);
let embedded_roots = select root as id, file from "embedded-expression";
let embedded_axes = axis(from=expressions, relation="semantic-child", direction=ancestor, domain=embedded_roots);
let embedded_nested = select id, file from embedded_axes;
let embedded_self = select l.id as id, l.file as file from expressions as l join embedded_roots as r on l.id = r.id and l.file = r.file;
let strings = union(left=embedded_nested, right=embedded_self);
let result = union(left=future_types, right=strings);
return result;
