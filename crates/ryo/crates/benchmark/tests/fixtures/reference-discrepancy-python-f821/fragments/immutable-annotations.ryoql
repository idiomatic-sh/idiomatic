let generic_subscripts = select check, id, file from base_paths where (path = "builtins.frozenset" or path = "builtins.tuple" or path = "builtins.frozendict" or path = "collections.abc.ByteString" or path = "collections.abc.Collection" or path = "collections.abc.Container" or path = "collections.abc.Iterable" or path = "collections.abc.Mapping" or path = "collections.abc.Reversible" or path = "collections.abc.Sequence" or path = "collections.abc.Set" or path = "typing.AbstractSet" or path = "typing.ByteString" or path = "typing.Callable" or path = "typing.Collection" or path = "typing.Container" or path = "typing.FrozenSet" or path = "typing.Iterable" or path = "typing.Literal" or path = "typing.Mapping" or path = "typing.Never" or path = "typing.NoReturn" or path = "typing.Reversible" or path = "typing.Sequence" or path = "typing.Tuple");
let optional_subscripts = select check, id, file from base_paths where path = "typing.Optional";
let union_subscripts = select check, id, file from base_paths where path = "typing.Union";
let annotated_subscripts = select check, id, file from base_paths where path = "typing.Annotated" or path = "typing_extensions.Annotated";
let slices = select l.id as id, r.child as slice, l.file as file from subscript_nodes as l join "semantic-child" as r on l.id = r.parent and l.file = r.file where r.field = "slice";
let tuple_nodes = select id, file from nodes where kind = "tuple";
let tuple_slices = select l.id as id, l.slice as slice, l.file as file from slices as l join tuple_nodes as r on l.slice = r.id and l.file = r.file;
let tuple_elements = select parent as tuple, child as element, ordinal, file from "semantic-child" where field = "elts";
let later_elements = select l.tuple as tuple, l.element as element, l.file as file from tuple_elements as l join tuple_elements as r on l.tuple = r.tuple and l.file = r.file where r.ordinal < l.ordinal;
let first_elements = antijoin(left=tuple_elements, right=later_elements, left-on=["tuple", "element", "file"], right-on=["tuple", "element", "file"]);
let optional_edges = select l.check as check, l.id as source, r.slice as destination, l.file as file from optional_subscripts as l join slices as r on l.id = r.id and l.file = r.file;
let valid_union_roots = select l.check as check, l.id as id, r.slice as slice, l.file as file from union_subscripts as l join tuple_slices as r on l.id = r.id and l.file = r.file;
let union_edges = select l.check as check, l.id as source, r.element as destination, l.file as file from valid_union_roots as l join tuple_elements as r on l.slice = r.tuple and l.file = r.file;
let annotated_tuples = select l.check as check, l.id as id, r.slice as slice, l.file as file from annotated_subscripts as l join tuple_slices as r on l.id = r.id and l.file = r.file;
let annotated_edges = select l.check as check, l.id as source, r.element as destination, l.file as file from annotated_tuples as l join first_elements as r on l.slice = r.tuple and l.file = r.file;
let binops = select id, file from "semantic-syntax" where kind = "bin-op";
let left_fields = select parent, child from "semantic-child" where field = "left";
let right_fields = select parent, child from "semantic-child" where field = "right";
let binop_lefts = select l.id as binop, l.file as file, r.child as child from binops as l join left_fields as r on l.id = r.parent;
let binop_rights = select l.id as binop, l.file as file, r.child as child from binops as l join right_fields as r on l.id = r.parent;
let binop_left_locations = select l.binop as binop, l.file as file, r."end-byte" as boundary from binop_lefts as l join "source-location" as r on l.child = r.id and l.file = r.file;
let binop_right_locations = select l.binop as binop, l.file as file, r."start-byte" as boundary from binop_rights as l join "source-location" as r on l.child = r.id and l.file = r.file;
let ordered_binop_operands = select l.binop as binop, l.file as file, l.boundary as left_end, r.boundary as right_start from binop_left_locations as l join binop_right_locations as r on l.binop = r.binop and l.file = r.file;
let pipe_tokens = select l.id as token, r.file as file, r."start-byte" as start, r."end-byte" as end from "syntax-tree" as l join "source-location" as r on l.id = r.id where l.text = "|";
let raw_bit_or_nodes = select l.binop as node, l.file as file from ordered_binop_operands as l join pipe_tokens as r on l.file = r.file where r.start >= l.left_end and r.end <= l.right_start;
let bit_or_nodes = select l.check as check, l.id as id, l.file as file from members as l join raw_bit_or_nodes as r on l.id = r.node and l.file = r.file;
let binary_sides = select parent, child, file from "semantic-child" where field = "left" or field = "right";
let binary_edges = select l.check as check, l.id as source, r.child as destination, l.file as file from bit_or_nodes as l join binary_sides as r on l.id = r.parent and l.file = r.file;
let edges0 = union(left=optional_edges, right=union_edges);
let edges1 = union(left=edges0, right=annotated_edges);
let edges = union(left=edges1, right=binary_edges);
let paths = closure(edges=edges, source="source", destination="destination", keys=["check", "file"]);
let nested_required = select l.check as check, r.destination as id, l.file as file from checks as l join paths as r on l.check = r.check and l.root = r.source and l.file = r.file;
let root_required = select check, root as id, file from checks;
let required = union(left=root_required, right=nested_required);
let none_nodes0 = select id, file from "literal-properties" where kind = "null";
let none_nodes = select l.check as check, l.id as id, l.file as file from members as l join none_nodes0 as r on l.id = r.id and l.file = r.file;
let union_roots = select check, id, file from valid_union_roots;
let annotated_roots = select check, source as id, file from annotated_edges;
let immutable0 = union(left=direct_non_generic_nodes, right=direct_generic_nodes);
let immutable1 = union(left=immutable0, right=generic_subscripts);
let immutable2 = union(left=immutable1, right=optional_subscripts);
let immutable3 = union(left=immutable2, right=union_roots);
let immutable4 = union(left=immutable3, right=annotated_roots);
let immutable5 = union(left=immutable4, right=bit_or_nodes);
let immutable = union(left=immutable5, right=none_nodes);
let bad_members = antijoin(left=required, right=immutable, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let check_keys = select check, file from checks;
let result = antijoin(left=check_keys, right=bad_members, left-on=["check", "file"], right-on=["check", "file"]);
return result;
