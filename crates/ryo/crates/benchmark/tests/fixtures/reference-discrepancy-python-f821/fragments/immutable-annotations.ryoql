import lookup_symbols from "python/ruff/lookup-symbol-events";
import deferred_types from "python/ruff/deferred-type-reads";
input checks: relation<check: node, root: node, scope: node, point: number, file: file>;
output relation<check: node, file: file>;
let nodes = select id, kind, file from "semantic-syntax";
let roots = select root as id, file from checks;
let root_axes = axis(from=nodes, relation="semantic-child", direction=ancestor, domain=roots);
let nested_members = select r.check as check, l.id as id, l.file as file from root_axes as l join checks as r on l.related = r.root and l.file = r.file;
let root_members = select check, root as id, file from checks;
let members = union(left=nested_members, right=root_members);
let name_nodes = select id, file from nodes where kind = "name";
let member_names = select l.check as check, l.id as id, l.file as file from members as l join name_nodes as r on l.id = r.id and l.file = r.file;
let expression_inputs = select id, file from members;
let deferred_visits = deferred_types(expressions=expression_inputs);
let cached_paths0 = select l.check as check, l.id as id, r.path as path, r.provenance as origin, l.file as file from members as l join "qualified-name" as r on l.id = r.id and l.file = r.file where r.provenance = "import" or r.provenance = "builtin" and (r."since-major" < 3 or r."since-major" = 3 and r."since-minor" <= 10);
let cached_paths = antijoin(left=cached_paths0, right=deferred_visits, left-on=["id", "file"], right-on=["id", "file"]);
let cached_uses = select reference as id, file from "binding-use";
let unresolved_names = antijoin(left=member_names, right=cached_uses, left-on=["id", "file"], right-on=["id", "file"]);
let postponed_names = select l.check as check, l.id as id, l.file as file from member_names as l join deferred_visits as r on l.id = r.id and l.file = r.file;
let fresh_names = union(left=unresolved_names, right=postponed_names);
let fresh_inputs = select id, file from fresh_names;
let lookup_contexts0 = select check as context, scope as initial_scope, point, point as header_point, file from checks;
let lookup_contexts1 = extend(from=lookup_contexts0, values={stage: 2});
let lookup_contexts = select context, initial_scope, point, header_point, stage, file from lookup_contexts1;
let raw_bindings = lookup_symbols(ordered_contexts=lookup_contexts, expressions=fresh_inputs);
let relevant_bindings = select l.check as check, l.id as id, r.occurrence as occurrence, r.scope as scope, r.kind as kind, l.file as file from fresh_names as l join raw_bindings as r on l.check = r.context and l.id = r.expression and l.file = r.file;
let argument_declarations = select id, name, owner as scope, file from "defines" where kind = "parameter";
let fresh_name_labels = select l.check as check, l.id as id, r.name as name, l.file as file from fresh_names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let scoped_name_labels = select l.check as check, l.id as id, l.name as name, r.scope as scope, l.file as file from fresh_name_labels as l join checks as r on l.check = r.check and l.file = r.file;
let argument_matches = select l.check as check, l.id as id, r.id as occurrence, l.scope as scope, l.file as file from scoped_name_labels as l join argument_declarations as r on l.scope = r.scope and l.name = r.name and l.file = r.file;
let argument_bindings0 = extend(from=argument_matches, values={kind: "bind"});
let argument_bindings = select check, id, occurrence, scope, kind, file from argument_bindings0;
let outer_bindings = antijoin(left=relevant_bindings, right=argument_matches, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let initial_bindings = union(left=outer_bindings, right=argument_bindings);
let generic_owners = select id, file from nodes where kind = "function-def" or kind = "async-function-def" or kind = "class-def" or kind = "type-alias";
let type_parameters = select id, name, file from "defines" where refinement = "type-var" or refinement = "type-var-tuple" or refinement = "param-spec";
let parameter_axes = axis(from=type_parameters, relation="semantic-child", direction=nearest-ancestor, domain=generic_owners);
let owned_parameters = select l.id as declaration, l.name as name, r.related as owner, l.file as file from type_parameters as l join parameter_axes as r on l.id = r.id and l.file = r.file;
let context_scopes = select scope as id, file from checks;
let generic_ancestor_axes = axis(from=context_scopes, relation="semantic-child", direction=ancestor, domain=generic_owners);
let ancestor_generics = select r.check as check, l.related as owner, l.file as file from generic_ancestor_axes as l join checks as r on l.id = r.scope and l.file = r.file;
let own_generics = select l.check as check, l.scope as owner, l.file as file from checks as l join generic_owners as r on l.scope = r.id and l.file = r.file;
let visible_generics = union(left=ancestor_generics, right=own_generics);
let contextual_parameters = select l.check as check, r.declaration as declaration, r.name as name, l.owner as owner, l.file as file from visible_generics as l join owned_parameters as r on l.owner = r.owner and l.file = r.file;
let parameter_name_matches = select l.check as check, l.id as id, r.declaration as occurrence, r.owner as owner, l.file as file from fresh_name_labels as l join contextual_parameters as r on l.check = r.check and l.name = r.name and l.file = r.file;
let scope_edges = select child as origin, parent as destination, file from "scope";
let scope_paths = closure(edges=scope_edges, source="origin", destination="destination", keys=["file"]);
let binding_scope_options = select l.check as check, l.id as id, l.occurrence as occurrence, l.scope as scope, l.file as file, r.owner as owner from initial_bindings as l join parameter_name_matches as r on l.check = r.check and l.id = r.id and l.file = r.file;
let same_scope_values = select check, id, owner, file from binding_scope_options where scope = owner;
let inner_scope_values = select l.check as check, l.id as id, l.owner as owner, l.file as file from binding_scope_options as l join scope_paths as r on l.scope = r.origin and l.owner = r.destination and l.file = r.file;
let shadowed_parameter_owners = union(left=same_scope_values, right=inner_scope_values);
let visible_parameter_matches = antijoin(left=parameter_name_matches, right=shadowed_parameter_owners, left-on=["check", "id", "owner", "file"], right-on=["check", "id", "owner", "file"]);
let shadowed_outer_values = select check, id, file from visible_parameter_matches;
let surviving_values = antijoin(left=initial_bindings, right=shadowed_outer_values, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let parameter_value_rows0 = select check, id, occurrence, owner as scope, file from visible_parameter_matches;
let parameter_value_rows1 = extend(from=parameter_value_rows0, values={kind: "bind"});
let parameter_value_rows = select check, id, occurrence, scope, kind, file from parameter_value_rows1;
let bindings = union(left=surviving_values, right=parameter_value_rows);
let imported_paths0 = select l.check as check, l.id as id, r.target as path, l.occurrence as definition, l.file as file from bindings as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let bare_import_definitions0 = select id, file from "defines" where kind = "import" and refinement = "import";
let import_asnames = select parent as id, file from "semantic-child" where field = "asname";
let bare_import_definitions = antijoin(left=bare_import_definitions0, right=import_asnames, left-on=["id", "file"], right-on=["id", "file"]);
let deep_import_paths = select l.check as check, l.id as id, l.path as path, l.file as file from imported_paths0 as l join bare_import_definitions as r on l.definition = r.id and l.file = r.file where starts_with(l.path, "collections.") or starts_with(l.path, "typing.") or starts_with(l.path, "typing_extensions.") or starts_with(l.path, "builtins.");
let imported_paths1 = select check, id, path, file from imported_paths0;
let direct_import_paths = antijoin(left=imported_paths1, right=deep_import_paths, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let module_0a = select check, id, file from deep_import_paths where starts_with(path, "collections.");
let module_0b = extend(from=module_0a, values={path: "collections"});
let imported_module_paths_0 = union(left=direct_import_paths, right=module_0b);
let module_1a = select check, id, file from deep_import_paths where starts_with(path, "typing.");
let module_1b = extend(from=module_1a, values={path: "typing"});
let imported_module_paths_1 = union(left=imported_module_paths_0, right=module_1b);
let module_2a = select check, id, file from deep_import_paths where starts_with(path, "typing_extensions.");
let module_2b = extend(from=module_2a, values={path: "typing_extensions"});
let imported_module_paths_2 = union(left=imported_module_paths_1, right=module_2b);
let module_3a = select check, id, file from deep_import_paths where starts_with(path, "builtins.");
let module_3b = extend(from=module_3a, values={path: "builtins"});
let imported_module_paths_3 = union(left=imported_module_paths_2, right=module_3b);
let import_origins0 = extend(from=imported_module_paths_3, values={origin: "import"});
let import_origins = select check, id, path, origin, file from import_origins0;
let unbound_names = antijoin(left=fresh_names, right=bindings, left-on=["check", "id", "file"], right-on=["check", "id", "file"]);
let builtin_catalog = select name, file from "implicit-symbol" as q where q.kind = "builtin" and (q."since-major" < 3 or q."since-major" = 3 and q."since-minor" <= 10);
let unbound_labels = select l.check as check, l.id as id, r.name as name, l.file as file from unbound_names as l join "identifier" as r on l.id = r.id and l.file = r.file;
let builtin_labels = select l.check as check, l.id as id, l.name as name, l.file as file from unbound_labels as l join builtin_catalog as r on l.name = r.name and l.file = r.file;
let builtin_0a = select check, id, file from builtin_labels where name = "bool";
let builtin_0b = extend(from=builtin_0a, values={path: "builtins.bool", origin: "builtin"});
let builtin_0c = select check, id, path, origin, file from builtin_0b;
