import forward_context from "python/ruff/forward-reference-context";
import lookup_symbols from "python/ruff/lookup-symbol-events";
import type_match from "python/ruff/type-match-at-check";
input expressions: relation<id: node, file: file>;
param member: string;
output relation<id: node, file: file>;
let scopes = select child as id, file from "scope";
let scope_axes = axis(from=expressions, relation="semantic-child", direction=nearest-ancestor, domain=scopes);
let scoped_inputs = select l.id as id, r.related as scope, l.file as file from expressions as l join scope_axes as r on l.id = r.id and l.file = r.file;
let events = select occurrence as id, ordinal as point, file from "binding-event";
let read_points = select occurrence as id, ordinal as point, file from "binding-event" where kind = "read";
let attr_values = select parent as id, child as head, file from "semantic-child" where field = "value";
let attribute_points = select l.id as id, r.point as point, l.file as file from attr_values as l join read_points as r on l.head = r.id and l.file = r.file;
let input_points = union(left=read_points, right=attribute_points);
let located_inputs = select l.id as id, l.scope as scope, r.point as point, l.file as file from scoped_inputs as l join input_points as r on l.id = r.id and l.file = r.file;
let unlocated_inputs = antijoin(left=scoped_inputs, right=input_points, left-on=["id","file"], right-on=["id","file"]);
let later_points = select l.point as point, l.file as file from events as l join events as r on l.file = r.file where l.point < r.point;
let final_points = antijoin(left=events, right=later_points, left-on=["point","file"], right-on=["point","file"]);
let pending_inputs = select l.id as id, l.scope as scope, r.point as point, l.file as file from unlocated_inputs as l join final_points as r on l.file = r.file;
let contexts = union(left=located_inputs, right=pending_inputs);
let checks = select id as check, id as root, scope, point, file from contexts;
let matches = type_match(checks=checks, builtin="__no_such_builtin__", typing=$member, mode="annotation");
let lexical_matches = select check as id, file from matches;
let forward_inputs = forward_context(expressions=expressions);
let modules = select id, file from "semantic-syntax" where kind = "module";
let forward_checks0 = select l.id as context, r.id as initial_scope, l.file as file from forward_inputs as l join modules as r on l.file = r.file;
let forward_checks1 = select l.context as context, l.initial_scope as initial_scope, r.point as point, r.point as header_point, l.file as file from forward_checks0 as l join final_points as r on l.file = r.file;
let forward_checks2 = extend(from=forward_checks1, values={stage: 0});
let forward_checks = select context, initial_scope, point, header_point, stage, file from forward_checks2;
let name_nodes = select id, file from "semantic-syntax" where kind = "name";
let forward_name_heads = select l.id as root, l.id as head, l.file as file from forward_inputs as l join name_nodes as r on l.id = r.id and l.file = r.file;
let forward_attr_values = select l.id as root, r.head as head, l.file as file from forward_inputs as l join attr_values as r on l.id = r.id and l.file = r.file;
let forward_attr_heads = select l.root as root, l.head as head, l.file as file from forward_attr_values as l join name_nodes as r on l.head = r.id and l.file = r.file;
let forward_heads = union(left=forward_name_heads, right=forward_attr_heads);
let forward_head_inputs = select head as id, file from forward_heads;
let forward_bindings0 = lookup_symbols(ordered_contexts=forward_checks, expressions=forward_head_inputs);
let forward_bindings = select l.context as id, l.expression as head, l.occurrence as occurrence, l.kind as kind, l.file as file from forward_bindings0 as l join forward_heads as r on l.context = r.root and l.expression = r.head and l.file = r.file;
let forward_imports = select l.id as id, l.head as head, l.occurrence as definition, r.target as path, l.file as file from forward_bindings as l join "static-import" as r on l.occurrence = r.occurrence and l.file = r.file where l.kind = "bind";
let module_overrides = select id, file from forward_bindings where kind = "bind";
let remaining_lexical = antijoin(left=lexical_matches, right=module_overrides, left-on=["id","file"], right-on=["id","file"]);
let direct_imports0 = select id, file from "defines" where kind = "import" and refinement = "import";
let aliased_imports = select parent as id, file from "semantic-child" where field = "asname";
let direct_imports = antijoin(left=direct_imports0, right=aliased_imports, left-on=["id","file"], right-on=["id","file"]);
let qualified_modules = select l.id as id, l.head as head, l.file as file from forward_imports as l join direct_imports as r on l.definition = r.id and l.file = r.file where starts_with(l.path,"typing.") or starts_with(l.path,"typing_extensions.") or starts_with(l.path,"_typeshed.");
let name_imports0 = select l.id as id, l.path as path, l.file as file from forward_imports as l join forward_name_heads as r on l.id = r.root and l.head = r.head and l.file = r.file;
let name_imports = antijoin(left=name_imports0, right=qualified_modules, left-on=["id","file"], right-on=["id","file"]);
let forward_name_matches = select id, file from name_imports where path = concat("typing.",$member) or path = concat("typing_extensions.",$member) or path = concat("_typeshed.",$member);
let attr_labels0 = select l.root as id, r.child as label, l.file as file from forward_attr_heads as l join "semantic-child" as r on l.root = r.parent and l.file = r.file where r.field = "attr";
let attr_labels = select l.id as id, r.name as name, l.file as file from attr_labels0 as l join "identifier" as r on l.label = r.id and l.file = r.file;
let attribute_imports = select l.id as id, l.head as head, l.path as path, r.name as name, l.file as file from forward_imports as l join attr_labels as r on l.id = r.id and l.file = r.file;
let module_attribute_matches = select id, file from attribute_imports where name = $member and (path = "typing" or path = "typing_extensions" or path = "_typeshed");
let qualified_attribute_matches = select l.id as id, l.file as file from attribute_imports as l join qualified_modules as r on l.id = r.id and l.head = r.head and l.file = r.file where l.name = $member;
let forward_matches = union(left=forward_name_matches, right=module_attribute_matches);
let forward_matches_all = union(left=forward_matches, right=qualified_attribute_matches);
let result = union(left=remaining_lexical, right=forward_matches_all);
return result;
