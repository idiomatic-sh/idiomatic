let functions = group-count(from="function", keys=[file,name], count="occurrences");
let requests = extend(from=functions, values={sequence: 1});
let replies = extend(from=functions, values={sequence: 2});
let a = ordered-match(left=requests, right=replies, left-on=[file,name], right-on=[file,name], left-order="sequence", right-order="sequence", output={file: [left,file], name: [right,name]}); emit a subject file key(name);
