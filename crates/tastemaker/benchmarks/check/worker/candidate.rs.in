// Compose the two benchmark entry points without consulting the reference answers.
// Project receipts go to stdout. Its file is also opened for reading after the
// project pass finishes, before the mixed reader writes its normal diagnostics.
fn main() {
    use serde_json::{Value, json};
    use sha2::{Digest, Sha256};
    use std::fs::File;
    use std::io::{BufRead, BufReader, BufWriter, Read, Write};

    let args: Vec<_> = std::env::args_os().skip(1).collect();
    let [manifest, project_output, destination] = args.as_slice() else {
        panic!("expected mixed manifest, stdout path and receipt path");
    };
    project_bench::replay();
    std::io::stdout().flush().expect("flush project receipts");
    let mut projects = BufReader::new(File::open(project_output).unwrap())
        .take(std::fs::metadata(project_output).unwrap().len())
        .lines();
    let work = BufReader::new(File::open(manifest).unwrap());
    let mut out = BufWriter::new(File::create(destination).unwrap());
    let scratch = tempfile::NamedTempFile::new().unwrap();
    for item in work.lines() {
        let entry: Value = serde_json::from_str(&item.unwrap()).unwrap();
        let mut result: Value = serde_json::from_str(&projects.next().unwrap().unwrap()).unwrap();
        assert_eq!(result["id"], entry["id"]);
        if result.get("refused").is_some() && entry["count"].as_u64().unwrap() > 0 {
            let readers = vec![
                ryo_css::linked(),
                ryo_go::linked(),
                ryo_html::linked(),
                ryo_json::linked(),
                ryo_markdown::linked(),
                ryo_toml::linked(),
                ryo_python::linked(),
                ryo_rust::linked(),
                ryo_typescript::linked(),
            ];
            let completed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
                mixed::run(
                    readers,
                    entry["pack"].as_str().unwrap(),
                    entry["request"].as_str().unwrap(),
                    scratch.path().to_str().unwrap(),
                )
            }));
            if matches!(completed, Ok(true)) {
                let bytes = std::fs::read(scratch.path()).unwrap();
                let rows = bytes
                    .split(|b| *b == b'\n')
                    .filter(|row| !row.is_empty())
                    .count();
                result = json!({"id":entry["id"], "rows":rows,"sha256":format!("{:x}",Sha256::digest(bytes))});
            }
        }
        writeln!(out, "{result}").unwrap();
    }
    assert!(projects.next().is_none());
    out.flush().unwrap();
}
