param libraries: set<string>;
param domain-libraries: set<string>;
param contracts: set<string>;
let nodes = select l."id" as "id", l."kind" as "kind" from "syntax-tree" as l where l."text" = "";
let edges = project(from="syntax-child", columns=["parent", "child", "field"]);
let written = project(from="reference", columns=["occurrence", "file", "span", "target"]);
let imports = project(from="static-import", columns=["occurrence", "file", "span", "binding", "target"]);
let heads = replace(from=written, text="target", pattern="::.*$", replacement="", output="head");
let through-imports = select l."occurrence" as "occurrence", l."file" as "file", l."span" as "span", l."target" as "target", r."target" as "origin" from heads as l join imports as r on l."file" = r."file" and l."head" = r."binding";
let as-written = select l."occurrence" as "occurrence", l."file" as "file", l."span" as "span", l."target" as "target", l."target" as "origin" from written as l;
let resolved-origins = union(left=as-written, right=through-imports);
let resolved = replace(from=resolved-origins, text="origin", pattern="$", replacement="::_", output="beneath");
let written-public = select l."declaration" as "id" from "visibility" as l where l."text" = "pub";
let public-kinds = select r."id" as "id", r."kind" as "kind" from written-public as l join nodes as r on l."id" = r."id";
let public-fields = select * from public-kinds where kind = "record-field" or kind = "tuple-field";
let public-items = select l."id" as "id" from public-kinds as l where l."kind" != "record-field" and l."kind" != "tuple-field";
let field-lists = select l."id" as "id", r."parent" as "list" from public-fields as l join edges as r on l."id" = r."child";
let field-owners = select l."id" as "id", r."parent" as "owner" from field-lists as l join edges as r on l."list" = r."child";
let reachable-fields = select l."id" as "id" from field-owners as l join public-items as r on l."owner" = r."id";
let public = union(left=public-items, right=reachable-fields);
let public-traits = select * from public-kinds where kind = "trait";
let public-trait-ids = project(from=public-traits, columns=["id"]);
let impls = select * from nodes where kind = "impl";
let trait-types = select l."id" as "impl", r."child" as "type" from impls as l join edges as r on l."id" = r."parent" where r."field" = "trait";
let trait-paths = select l."impl" as "impl", r."child" as "path" from trait-types as l join edges as r on l."type" = r."parent" where r."field" = "path";
let contract-paths = select * from resolved where glob_any(origin, $contracts) or glob_any(beneath, $contracts);
let contract-impls = select l."impl" as "id" from trait-paths as l join contract-paths as r on l."path" = r."occurrence";
let containers = union(left=public-trait-ids, right=contract-impls);
let member-lists = select r."child" as "list" from containers as l join edges as r on l."id" = r."parent" where r."field" = "assoc-item-list";
let members = select r."child" as "id" from member-lists as l join edges as r on l."list" = r."parent" where r."field" = "items";
let surface = union(left=public, right=members);
let roots = select r."child" as "id" from surface as l join edges as r on l."id" = r."parent" where glob_any(r."field", "{param-list,ret-type,generic-param-list,where-clause,ty,variant-list,type-bound-list}");
let below = axis(from=roots, relation="syntax-child", direction=descendant, domain=nodes);
let below-ids = select related as "id" from below;
let reached = union(left=roots, right=below-ids);
let crossing-paths = select l."file" as "file", l."span" as "span", l."target" as "target" from resolved as l join reached as r on l."occurrence" = r."id" where glob_any(l."origin", $libraries) or glob_any(l."beneath", $libraries) or glob_any(l."origin", $domain-libraries) or glob_any(l."beneath", $domain-libraries);
let reexports = select l."file" as "file", l."span" as "span", l."target" as "target" from imports as l join public as r on l."occurrence" = r."id";
let crossing-imports = select * from reexports where glob_any(target, $libraries) or glob_any(target, $domain-libraries);
let crossing = union(left=crossing-paths, right=crossing-imports);
emit crossing subject "file" key("span", "target");
